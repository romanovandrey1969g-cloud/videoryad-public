Dialogue: 0,0:00:00.04,0:00:03.00,Caption,,0,0,0,,В ЛОНДОНЕ ВНЕЗАПНО ОБНАРУЖИЛИ СТОЛ. НЕ ТОТ,
Dialogue: 0,0:00:03.11,0:00:05.88,Caption,,0,0,0,,НА КОТОРОМ РАСКЛАДЫВАЮТ НОВЫЕ САНКЦИИ И ОБЕЩАНИЯ
Dialogue: 0,0:00:05.88,0:00:10.76,Caption,,0,0,0,,КИЕВУ, А ПЕРЕГОВОРНЫЙ. ПЯТЬ ЛЕТ БРИТАНЦЫ БОДРО ПОДТАЛКИВАЛИ ЕВРОПУ К
Dialogue: 0,0:00:10.76,0:00:14.12,Caption,,0,0,0,,СЛЕДУЮЩЕЙ СТУПЕНЬКЕ, УВЕРЯЯ, ЧТО ЛЕСТНИЦА БЕСКОНЕЧНАЯ.
Dialogue: 0,0:00:14.67,0:00:16.44,Caption,,0,0,0,,И ТУТ КТО ТО ВСЁ ЖЕ ПОСМОТРЕЛ ВНИЗ.
Dialogue: 0,0:00:16.82,0:00:21.32,Caption,,0,0,0,,ОКАЗАЛОСЬ, ВЫСОКОВАТО. ТЕПЕРЬ БРИТАНИЯ ПРЕДЛАГАЕТ ЗАКАНЧИВАТЬ КОНФЛИКТ
Dialogue: 0,0:00:21.44,0:00:24.04,Caption,,0,0,0,,РАЗГОВОРОМ С МОСКВОЙ. ПРОЗРЕНИЕ ПОЛЕЗНОЕ,
Dialogue: 0,0:00:24.28,0:00:26.36,Caption,,0,0,0,,ХОТЯ НАСТУПИЛО ОНО АККУРАТ В ТОТ МОМЕНТ,
Dialogue: 0,0:00:26.60,0:00:29.00,Caption,,0,0,0,,КОГДА ПОСЛЕДСТВИЯ НАЧАЛИ ПРИМЕРЯТЬСЯ УЖЕ К САМОЙ
Dialogue: 0,0:00:29.00,0:00:32.04,Caption,,0,0,0,,БРИТАНИИ. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ТАКИЕ РАЗВОРОТЫ
Dialogue: 0,0:00:32.12,0:00:36.60,Caption,,0,0,0,,НАДО РАЗБИРАТЬ ВНИМАТЕЛЬНО, ПОТОМУ ЧТО БОЛЬШИЕ ГОСУДАРСТВА МЕНЯЮТ ТОН НЕ ОТ
Dialogue: 0,0:00:36.60,0:00:39.72,Caption,,0,0,0,,ВНЕЗАПНОГО ПРИСТУПА ДОБРОТЫ. ЕЩЁ НЕДАВНО ИЗ ЛОНДОНА
Dialogue: 0,0:00:39.72,0:00:43.24,Caption,,0,0,0,,ЗВУЧАЛ СОВСЕМ ДРУГОЙ НАБОР КОМАНД. ДАВИТЬ СИЛЬНЕЕ,
Dialogue: 0,0:00:43.39,0:00:45.96,Caption,,0,0,0,,ВООРУЖАТЬ БОЛЬШЕ, ГОТОВИТЬСЯ ДОЛЬШЕ,
Dialogue: 0,0:00:46.20,0:00:48.12,Caption,,0,0,0,,ЦЕНУ ДЛЯ РОССИИ ПОДНИМАТЬ ВЫШЕ.
Dialogue: 0,0:00:48.94,0:00:51.08,Caption,,0,0,0,,О ПЕРЕГОВОРАХ ВСПОМИНАЛИ РАЗВЕ ЧТО ЗАТЕМ,
Dialogue: 0,0:00:51.23,0:00:55.08,Caption,,0,0,0,,ЧТОБЫ ОБЪЯСНИТЬ, ПОЧЕМУ ДЛЯ НИХ ПОКА НЕ НАСТАЛО ВРЕМЯ. ТЕПЕРЬ
Dialogue: 0,0:00:55.16,0:00:59.48,Caption,,0,0,0,,ВРЕМЯ, ОКАЗЫВАЕТСЯ, НАСТАЛО. ДАЖЕ БРИТАНЦЫ ДОБРАЛИСЬ ДО МЫСЛИ,
Dialogue: 0,0:00:59.67,0:01:02.28,Caption,,0,0,0,,ЧТО ЛЮБОЙ КОНФЛИКТ ЗАКАНЧИВАЕТСЯ НЕ ТОРЖЕСТВЕННОЙ
Dialogue: 0,0:01:02.28,0:01:06.60,Caption,,0,0,0,,РЕЧЬЮ У МИКРОФОНА, А РАЗГОВОРОМ О КОНКРЕТНЫХ УСЛОВИЯХ. ПУТЬ БЫЛ ДОЛГИЙ.
Dialogue: 0,0:01:06.95,0:01:10.52,Caption,,0,0,0,,ВИДИМО, НАВИГАТОР ВСЁ ЭТО ВРЕМЯ СТРОИЛ МАРШРУТ ЧЕРЕЗ КИЕВ,
Dialogue: 0,0:01:10.67,0:01:15.48,Caption,,0,0,0,,ПАРИЖ И СКЛАД С РАКЕТАМИ. НЕЗАДОЛГО ДО ЭТОГО ЛОНДОНУ ПОНАДОБИЛАСЬ ПРЯМАЯ
Dialogue: 0,0:01:15.48,0:01:20.95,Caption,,0,0,0,,ВОЕННАЯ ЛИНИЯ С МОСКВОЙ. СПЕЦИАЛЬНАЯ СВЯЗЬ НА СЛУЧАЙ,
Dialogue: 0,0:01:21.22,0:01:23.83,Caption,,0,0,0,,ЕСЛИ ОЧЕРЕДНОЕ ПОВЫШЕНИЕ СТАВОК ВДРУГ ПРИВЕДЁТ К
Dialogue: 0,0:01:23.83,0:01:27.67,Caption,,0,0,0,,СИТУАЦИИ, В КОТОРОЙ НЕКОГДА БУДЕТ РАССЫЛАТЬ ЗАЯВЛЕНИЯ И
Dialogue: 0,0:01:27.67,0:01:30.63,Caption,,0,0,0,,СОГЛАСОВЫВАТЬ ФОРМУЛИРОВКИ. ПОЛУЧАЛАСЬ ЗАНЯТНАЯ
Dialogue: 0,0:01:30.63,0:01:33.83,Caption,,0,0,0,,СХЕМА. БРИТАНИЯ ПРОДОЛЖАЕТ ДЕЛАТЬ ВСЁ,
Dialogue: 0,0:01:33.99,0:01:38.23,Caption,,0,0,0,,ЧТО ДЕЛАЛА, НО ДЕРЖИТ ПОД РУКОЙ НОМЕР МОСКВЫ. ЕСЛИ СТАНЕТ
Dialogue: 0,0:01:38.23,0:01:41.11,Caption,,0,0,0,,СЛИШКОМ ЖАРКО, МОЖНО БЫСТРО ПОЗВОНИТЬ И ОБЪЯСНИТЬ,
Dialogue: 0,0:01:41.33,0:01:43.43,Caption,,0,0,0,,ЧТО НИКТО НИЧЕГО ТАКОГО НЕ ИМЕЛ В ВИДУ,
Dialogue: 0,0:01:43.67,0:01:46.71,Caption,,0,0,0,,А РАКЕТА ВООБЩЕ ЛЕТЕЛА ПО СВОИМ ДЕЛАМ. СНАЧАЛА
Dialogue: 0,0:01:46.71,0:01:49.03,Caption,,0,0,0,,ПОНАДОБИЛСЯ ТЕЛЕФОН. СЛЕДОМ ЗАГОВОРИЛИ О
Dialogue: 0,0:01:49.03,0:01:51.99,Caption,,0,0,0,,ПЕРЕГОВОРАХ. ТЕМП ХОРОШИЙ. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:01:52.23,0:01:56.55,Caption,,0,0,0,,И В ЛОНДОНЕ ДОГАДАЮТСЯ, ЧТО КРАСНАЯ ЛИНИЯ ОТЛИЧАЕТСЯ ОТ РЕЗИНКИ НА КАРТЕ.
Dialogue: 0,0:01:56.95,0:02:00.87,Caption,,0,0,0,,ЕЁ МОЖНО ДОЛГО ОТОДВИГАТЬ, ПОКА ОДНАЖДЫ ЗА НЕЙ НЕ ОКАЖЕТСЯ ОТВЕТ,
Dialogue: 0,0:02:01.14,0:02:03.27,Caption,,0,0,0,,КОТОРЫЙ НЕЛЬЗЯ ОТМЕНИТЬ СЛЕДУЮЩИМ ЗАЯВЛЕНИЕМ
Dialogue: 0,0:02:03.27,0:02:07.35,Caption,,0,0,0,,МИНИСТЕРСТВА. КОГДА РИСК СУЩЕСТВУЕТ ТОЛЬКО В ТЕЛЕВИЗИОННОЙ СТУДИИ,
Dialogue: 0,0:02:07.58,0:02:10.47,Caption,,0,0,0,,СМЕЛОСТЬ ДАЁТСЯ ЛЕГКО. КОГДА ОН ПОДХОДИТ К ТВОЕМУ
Dialogue: 0,0:02:10.47,0:02:12.79,Caption,,0,0,0,,ПОРОГУ, ГОЛОС СТАНОВИТСЯ ТИШЕ,
Dialogue: 0,0:02:13.03,0:02:15.91,Caption,,0,0,0,,А ТЕЛЕФОН С МОСКВОЙ НЕОЖИДАННО ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:02:15.99,0:02:18.63,Caption,,0,0,0,,ВАЖНЕЙШИЙ ПРЕДМЕТ ИНТЕРЬЕРА. ХОТЯ ПРИ НЫНЕШНЕЙ
Dialogue: 0,0:02:18.63,0:02:21.43,Caption,,0,0,0,,СКОРОСТИ ПРОЗРЕНИЯ ОДНОГО ТЕЛЕФОНА СКОРО МОЖЕТ
Dialogue: 0,0:02:21.43,0:02:24.47,Caption,,0,0,0,,ОКАЗАТЬСЯ МАЛО. РЯДОМ С АППАРАТОМ НЕПЛОХО БЫ СРАЗУ
Dialogue: 0,0:02:24.47,0:02:27.51,Caption,,0,0,0,,ПОСТАВИТЬ ДВЕРЬ В УБЕЖИЩЕ. ПРИ ЭТОМ БРИТАНИЯ ВОВСЕ
Dialogue: 0,0:02:27.51,0:02:29.67,Caption,,0,0,0,,НЕ СОБИРАЕТСЯ СВОРАЧИВАТЬ ПОДДЕРЖКУ УКРАИНЫ.
Dialogue: 0,0:02:31.94,0:02:34.58,Caption,,0,0,0,,ЛОНДОН УЖЕ ВЗЯЛ НА СЕБЯ ОБЯЗАТЕЛЬСТВА НА ДЕСЯТКИ
Dialogue: 0,0:02:34.58,0:02:38.82,Caption,,0,0,0,,МИЛЛИАРДОВ ФУНТОВ, ПРОДОЛЖАЕТ ГОТОВИТЬ УКРАИНСКИХ ВОЕННЫХ И ВМЕСТЕ С
Dialogue: 0,0:02:38.82,0:02:42.02,Caption,,0,0,0,,ПАРИЖЕМ ОБСУЖДАЕТ ГАРАНТИИ ПОСЛЕ ПРЕКРАЩЕНИЯ ОГНЯ,
Dialogue: 0,0:02:42.26,0:02:44.58,Caption,,0,0,0,,ВКЛЮЧАЯ ВОЗМОЖНОЕ ПРИСУТСТВИЕ ИНОСТРАННЫХ СИЛ.
Dialogue: 0,0:02:45.16,0:02:47.94,Caption,,0,0,0,,НИКАКОГО ГОЛУБЯ МИРА ИЗ БРИТАНСКОГО ЯСТРЕБА НЕ
Dialogue: 0,0:02:47.94,0:02:50.74,Caption,,0,0,0,,ПОЛУЧИЛОСЬ. ПРОСТО ЯСТРЕБ ВПЕРВЫЕ УТОЧНИЛ,
Dialogue: 0,0:02:50.90,0:02:53.78,Caption,,0,0,0,,ГДЕ ЗДЕСЬ АВАРИЙНЫЙ ВЫХОД И ОТКРЫВАЕТСЯ ЛИ ОН
Dialogue: 0,0:02:53.78,0:02:57.22,Caption,,0,0,0,,ИЗНУТРИ. ТАК ЗАПРЕТНОЕ СТАНОВИЛОСЬ ПРИВЫЧНЫМ. ТАК
Dialogue: 0,0:02:57.30,0:03:00.26,Caption,,0,0,0,,ОСТОРОЖНОСТЬ ПРЕВРАЩАЛАСЬ В ОТСТАЛОСТЬ. ТАК КАЖДАЯ
Dialogue: 0,0:03:00.26,0:03:02.42,Caption,,0,0,0,,НОВАЯ СТУПЕНЬКА ОБЪЯВЛЯЛАСЬ ПОСЛЕДНЕЙ,
Dialogue: 0,0:03:02.64,0:03:05.46,Caption,,0,0,0,,ПОКА ИЗ ТУМАНА НЕ ПОКАЗЫВАЛАСЬ СЛЕДУЮЩАЯ. ТЕПЕРЬ
Dialogue: 0,0:03:05.46,0:03:08.26,Caption,,0,0,0,,ОДИН ИЗ ГЛАВНЫХ СТОРОННИКОВ ЖЁСТКОЙ ЛИНИИ ПРОИЗНОСИТ
Dialogue: 0,0:03:08.34,0:03:12.18,Caption,,0,0,0,,ВСЛУХ ТО, ЧТО РАНЬШЕ ПРЕДЛАГАЛОСЬ НЕ ЗАМЕЧАТЬ. ФИНАЛ ВСЁ РАВНО
Dialogue: 0,0:03:12.26,0:03:17.62,Caption,,0,0,0,,ПРИДЁТСЯ ОБСУЖДАТЬ С РОССИЕЙ. СТАДИЮ ОТРИЦАНИЯ ЛОНДОН ПРОШЁЛ. НА ЭТО УШЛО ВСЕГО
Dialogue: 0,0:03:17.62,0:03:21.14,Caption,,0,0,0,,НЕСКОЛЬКО ЛЕТ И ГОРА ЧУЖИХ ДЕНЕГ. ПРИЧИНЫ БРИТАНСКОЙ
Dialogue: 0,0:03:21.14,0:03:23.70,Caption,,0,0,0,,ЗАДУМЧИВОСТИ ХОРОШО ВИДНЫ У БЕЛОРУССКИХ ГРАНИЦ.
Dialogue: 0,0:03:23.85,0:03:26.74,Caption,,0,0,0,,МИНИСТР ОБОРОНЫ БЕЛАРУСИ ВИКТОР ХРЕНИН ГОВОРИТ О
Dialogue: 0,0:03:26.74,0:03:29.62,Caption,,0,0,0,,РАСШИРЕНИИ ЕВРОПЕЙСКОЙ ВОЕННОЙ ИНФРАСТРУКТУРЫ И
Dialogue: 0,0:03:29.62,0:03:32.66,Caption,,0,0,0,,ПЕРЕСТРОЙКЕ ЛОГИСТИКИ РЯДОМ С РЕСПУБЛИКОЙ. ТАМ УЖЕ
Dialogue: 0,0:03:32.66,0:03:37.06,Caption,,0,0,0,,НЕ НАБОР ГРОЗНЫХ СЛОВ, КОТОРЫЕ ЖИВУТ ДО СЛЕДУЮЩЕГО ВЫПУСКА НОВОСТЕЙ. ТАМ
Dialogue: 0,0:03:37.22,0:03:40.26,Caption,,0,0,0,,АЭРОДРОМЫ, ХРАНИЛИЩА, КОМАНДНЫЕ ПУНКТЫ,
Dialogue: 0,0:03:40.42,0:03:44.26,Caption,,0,0,0,,ПОДГОТОВЛЕННЫЕ МАРШРУТЫ, УЧЕНИЯ И РАЗВЕДЫВАТЕЛЬНАЯ АКТИВНОСТЬ.
Dialogue: 0,0:03:46.55,0:03:51.59,Caption,,0,0,0,,ПОЛИТИК ЗАКОНЧИЛ ВЫСТУПЛЕНИЕ, ПОКИНУЛ ТРИБУНУ И ОТПРАВИЛСЯ ПО ДЕЛАМ. ВЗЛЁТНАЯ
Dialogue: 0,0:03:51.59,0:03:54.47,Caption,,0,0,0,,ПОЛОСА НИКУДА НЕ ОТПРАВИЛАСЬ. СКЛАД НЕ РАСТВОРИЛСЯ.
Dialogue: 0,0:03:54.93,0:03:57.43,Caption,,0,0,0,,КОМАНДНЫЙ ПУНКТ ТОЖЕ НЕ РЕШИЛ ВЗЯТЬ ВЫХОДНОЙ.
Dialogue: 0,0:03:57.99,0:04:00.79,Caption,,0,0,0,,МИНСК СЧИТАЕТ ПРОИСХОДЯЩЕЕ ПОДГОТОВКОЙ К ВОЕННОМУ
Dialogue: 0,0:04:00.79,0:04:03.91,Caption,,0,0,0,,ПРОТИВОСТОЯНИЮ. ЕВРОПЕЙСКИЕ ГОСУДАРСТВА ОТВЕЧАЮТ,
Dialogue: 0,0:04:04.15,0:04:06.95,Caption,,0,0,0,,ЧТО УКРЕПЛЯЮТ ВОСТОЧНОЕ НАПРАВЛЕНИЕ РАДИ ЗАЩИТЫ ОТ
Dialogue: 0,0:04:06.95,0:04:09.59,Caption,,0,0,0,,РОССИИ И БЕЛАРУСИ. МОЖНО ДАЖЕ НЕ ВМЕШИВАТЬСЯ.
Dialogue: 0,0:04:09.87,0:04:11.91,Caption,,0,0,0,,СИСТЕМА САМА ПРОИЗВОДИТ УГРОЗЫ,
Dialogue: 0,0:04:12.05,0:04:14.87,Caption,,0,0,0,,САМА НА НИХ РЕАГИРУЕТ И САМА ВЫПИСЫВАЕТ СЕБЕ
Dialogue: 0,0:04:14.87,0:04:16.39,Caption,,0,0,0,,БЛАГОДАРНОСТЬ ЗА БДИТЕЛЬНОСТЬ.
Dialogue: 0,0:04:17.01,0:04:21.27,Caption,,0,0,0,,ОСТАЁТСЯ НАДЕЯТЬСЯ, ЧТО ОДНАЖДЫ КАКОЙ НИБУДЬ ОСОБО ДЕЯТЕЛЬНЫЙ НАЧАЛЬНИК
Dialogue: 0,0:04:21.59,0:04:24.55,Caption,,0,0,0,,НЕ ЗАХОЧЕТ ПРОВЕРИТЬ ЭТУ КОНСТРУКЦИЮ В ДЕЛЕ. ПОТОМУ
Dialogue: 0,0:04:24.63,0:04:27.11,Caption,,0,0,0,,ЧТО УЧЕБНАЯ ТРЕВОГА ЗАКАНЧИВАЕТСЯ ПО КОМАНДЕ,
Dialogue: 0,0:04:27.43,0:04:29.91,Caption,,0,0,0,,А НАСТОЯЩАЯ УЖЕ НИКОГО НЕ СПРАШИВАЕТ. И КАК
Dialogue: 0,0:04:29.99,0:04:32.63,Caption,,0,0,0,,РАЗ ПОСРЕДИ ЭТОГО БОДРОГО ОБУСТРОЙСТВА БУДУЩЕГО
Dialogue: 0,0:04:32.63,0:04:35.19,Caption,,0,0,0,,ПРОТИВОСТОЯНИЯ ЛОНДОН ПРЕДЛАГАЕТ ПОГОВОРИТЬ.
Dialogue: 0,0:04:35.41,0:04:38.39,Caption,,0,0,0,,СОВПАДЕНИЕ, КОНЕЧНО, ИСКЛЮЧИТЕЛЬНО УДОБНОЕ.
Dialogue: 0,0:04:39.03,0:04:41.59,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ ЕЩЁ ОДНА ЕВРОПЕЙСКАЯ ВИТРИНА ДАЛА
Dialogue: 0,0:04:41.59,0:04:45.11,Caption,,0,0,0,,ТРЕЩИНУ. НАТО ОТКАЗАЛОСЬ ОТ САММИТА РУКОВОДИТЕЛЕЙ,
Dialogue: 0,0:04:45.43,0:04:47.75,Caption,,0,0,0,,КОТОРЫЙ ПЛАНИРОВАЛИ ПРОВЕСТИ В АЛБАНИИ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:04:47.75,0:04:50.23,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОМ ГОДУ. ОБЪЯСНЕНИЕ ПОДОБРАЛИ
Dialogue: 0,0:04:50.23,0:04:53.59,Caption,,0,0,0,,ПРИЛИЧНОЕ. ВСТРЕЧИ ХОТЯТ СДЕЛАТЬ ГИБКИМИ И СОБИРАТЬ
Dialogue: 0,0:04:53.59,0:04:56.31,Caption,,0,0,0,,ЛИДЕРОВ ТОГДА, КОГДА ПОЯВИТСЯ НЕОБХОДИМОСТЬ.
Dialogue: 0,0:04:58.60,0:05:01.15,Caption,,0,0,0,,БУДТО РАНЬШЕ ГЛАВЫ ГОСУДАРСТВ ПРИЕЗЖАЛИ НА САММИТЫ
Dialogue: 0,0:05:01.15,0:05:05.88,Caption,,0,0,0,,ПРОСТО ПОТОМУ, ЧТО ДОМА ЗАКОНЧИЛСЯ ЧАЙ. ЗВУЧИТ СПОКОЙНО. ОСОБЕННО
Dialogue: 0,0:05:05.96,0:05:08.36,Caption,,0,0,0,,ЕСЛИ НЕ СМОТРЕТЬ НА РАЗНОГЛАСИЯ ВНУТРИ АЛЬЯНСА.
Dialogue: 0,0:05:08.91,0:05:11.24,Caption,,0,0,0,,ОТМЕНУ СВЯЗЫВАЮТ СО СПОРАМИ ОБ УКРАИНЕ,
Dialogue: 0,0:05:11.39,0:05:14.83,Caption,,0,0,0,,ИРАНЕ И ОБОРОННЫХ РАСХОДАХ. НО ЛУЧШЕ ВСЕХ
Dialogue: 0,0:05:14.83,0:05:18.04,Caption,,0,0,0,,ФОРМУЛИРОВОК ПОЛОЖЕНИЕ ОПИСЫВАЕТ ОДНА ЦИФРА. ТОЛЬКО
Dialogue: 0,0:05:18.12,0:05:21.24,Caption,,0,0,0,,СЕМЬ ГОСУДАРСТВ ИЗ ТРИДЦАТИ ДВУХ ПОДДЕРЖАЛИ ИДЕЮ
Dialogue: 0,0:05:21.24,0:05:24.27,Caption,,0,0,0,,КАЖДЫЙ ГОД НАПРАВЛЯТЬ УКРАИНЕ ЧЕТВЕРТЬ ПРОЦЕНТА
Dialogue: 0,0:05:24.27,0:05:27.40,Caption,,0,0,0,,ВАЛОВОГО ВНУТРЕННЕГО ПРОДУКТА. СЕМЬ ГОСУДАРСТВ.
Dialogue: 0,0:05:27.72,0:05:30.12,Caption,,0,0,0,,ОСТАЛЬНЫЕ ДВАДЦАТЬ ПЯТЬ ВНЕЗАПНО НАШЛИ В СТОЛЕ
Dialogue: 0,0:05:30.12,0:05:34.12,Caption,,0,0,0,,КАЛЬКУЛЯТОР. ПОКА ТРЕБУЕТСЯ ВСТАТЬ ВОЗЛЕ ФЛАГОВ И ПРОИЗНЕСТИ РЕЧЬ
Dialogue: 0,0:05:34.20,0:05:38.12,Caption,,0,0,0,,О ЕДИНСТВЕ, СТРОЙ ВЫГЛЯДИТ БЕЗУПРЕЧНО. КОГДА КАЖДОМУ УЧАСТНИКУ
Dialogue: 0,0:05:38.12,0:05:40.76,Caption,,0,0,0,,ПРИНОСЯТ ЕГО ЧАСТЬ СЧЁТА, ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:05:40.92,0:05:43.24,Caption,,0,0,0,,ЧТО ПОЛОВИНА КОМПАНИИ УЖЕ ПОЕЛА ДОМА,
Dialogue: 0,0:05:43.44,0:05:45.32,Caption,,0,0,0,,ДРУГАЯ ЗАКАЗЫВАЛА ТОЛЬКО ВОДУ,
Dialogue: 0,0:05:45.55,0:05:48.36,Caption,,0,0,0,,А ТРЕТЬЯ ВООБЩЕ ПРОХОДИЛА МИМО. ВОТ ГДЕ ЛОЗУНГИ
Dialogue: 0,0:05:48.36,0:05:51.16,Caption,,0,0,0,,ВСТРЕЧАЮТСЯ С БУХГАЛТЕРИЕЙ. ВСТРЕЧА ПОЛУЧАЕТСЯ
Dialogue: 0,0:05:51.16,0:05:54.52,Caption,,0,0,0,,КОРОТКАЯ И КРАЙНЕ НЕВЕЖЛИВАЯ. ДЛЯ ЗЕЛЕНСКОГО ЭТО
Dialogue: 0,0:05:54.52,0:05:57.56,Caption,,0,0,0,,ОСОБЕННО НЕУДОБНО. ОН РАССЧИТЫВАЕТ СОБРАТЬ ОБЩУЮ
Dialogue: 0,0:05:57.56,0:06:00.20,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ ЛИНИЮ ПЕРЕД ВОЗМОЖНЫМ РАЗГОВОРОМ С
Dialogue: 0,0:06:00.28,0:06:03.24,Caption,,0,0,0,,РОССИЕЙ. В КОАЛИЦИИ ЖЕЛАЮЩИХ ЧИСЛЯТСЯ ТРИДЦАТЬ СЕМЬ
Dialogue: 0,0:06:03.24,0:06:05.24,Caption,,0,0,0,,СТРАН, КОТОРЫМ ПРЕДСТОИТ РЕШИТЬ,
Dialogue: 0,0:06:05.47,0:06:07.80,Caption,,0,0,0,,С КАКОЙ ПОЗИЦИЕЙ ЕВРОПА ПРИДЁТ К СТОЛУ.
Dialogue: 0,0:06:10.07,0:06:12.71,Caption,,0,0,0,,ТРИДЦАТЬ СЕМЬ ПРАВИТЕЛЬСТВ ВЫГЛЯДЯТ ВНУШИТЕЛЬНО,
Dialogue: 0,0:06:13.02,0:06:15.35,Caption,,0,0,0,,ПОКА ОТ НИХ НЕ ТРЕБУЕТСЯ СОГЛАСОВАТЬ ХОТЬ ЧТО
Dialogue: 0,0:06:15.43,0:06:17.83,Caption,,0,0,0,,НИБУДЬ КОНКРЕТНОЕ. ИМ НУЖНО ДОГОВОРИТЬСЯ О
Dialogue: 0,0:06:17.83,0:06:20.31,Caption,,0,0,0,,ТЕРРИТОРИЯХ, ЧЛЕНСТВЕ УКРАИНЫ В НАТО,
Dialogue: 0,0:06:20.54,0:06:22.71,Caption,,0,0,0,,ГАРАНТИЯХ, ИНОСТРАННЫХ ВОЙСКАХ,
Dialogue: 0,0:06:22.87,0:06:26.15,Caption,,0,0,0,,САНКЦИЯХ И ФИНАНСИРОВАНИИ. ЕСЛИ ВНУТРИ БЛОКА ИЗ
Dialogue: 0,0:06:26.15,0:06:28.95,Caption,,0,0,0,,ТРИДЦАТИ ДВУХ СТРАН ТОЛЬКО СЕМЬ СОГЛАСНЫ С ОДНИМ
Dialogue: 0,0:06:28.95,0:06:30.63,Caption,,0,0,0,,ПОНЯТНЫМ ПРЕДЛОЖЕНИЕМ О ДЕНЬГАХ,
Dialogue: 0,0:06:31.11,0:06:33.75,Caption,,0,0,0,,ТО ТРИДЦАТЬ СЕМЬ УЧАСТНИКОВ НАВЕРНЯКА РАЗБЕРУТСЯ СО
Dialogue: 0,0:06:33.83,0:06:36.23,Caption,,0,0,0,,ВСЕМ ОСТАЛЬНЫМ МОЛНИЕНОСНО. СОБЕРУТСЯ,
Dialogue: 0,0:06:36.39,0:06:40.95,Caption,,0,0,0,,ЗАКАЖУТ КОФЕ, РЕШАТ СУДЬБУ ЕВРОПЫ И ЕЩЁ УСПЕЮТ ОБСУДИТЬ ДЕСЕРТ.
Dialogue: 0,0:06:41.38,0:06:45.43,Caption,,0,0,0,,КИЕВУ, ОДНАКО, НУЖНА ИМЕННО БОЛЬШАЯ КОМПАНИЯ. ЧЕМ БОЛЬШЕ
Dialogue: 0,0:06:45.43,0:06:47.27,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СТОЛИЦ ОКАЖУТСЯ РЯДОМ,
Dialogue: 0,0:06:47.59,0:06:50.31,Caption,,0,0,0,,ТЕМ СЛОЖНЕЕ ВАШИНГТОНУ И МОСКВЕ ПРОВЕСТИ ОСНОВНОЙ
Dialogue: 0,0:06:50.31,0:06:54.47,Caption,,0,0,0,,РАЗГОВОР ВДВОЁМ, А ЗАТЕМ ПЕРЕДАТЬ УКРАИНЕ ГОТОВЫЕ УСЛОВИЯ ВМЕСТЕ С
Dialogue: 0,0:06:54.55,0:06:58.47,Caption,,0,0,0,,РУЧКОЙ. КИЕВ ТРЕБУЕТ СВОЁ МЕСТО. БРЮССЕЛЬ ТРЕБУЕТ СВОЁ.
Dialogue: 0,0:06:58.86,0:07:02.63,Caption,,0,0,0,,ПАРИЖ, ЛОНДОН И ДРУГИЕ СТОЛИЦЫ ТОЖЕ НЕ СОБИРАЮТСЯ НАБЛЮДАТЬ
Dialogue: 0,0:07:02.71,0:07:04.87,Caption,,0,0,0,,ИЗ КОРИДОРА. ЕСЛИ ТАК ПРОДОЛЖИТСЯ,
Dialogue: 0,0:07:05.18,0:07:07.11,Caption,,0,0,0,,ПЕРЕГОВОРЩИКАМ ПОНАДОБИТСЯ НЕ СТОЛ,
Dialogue: 0,0:07:07.34,0:07:10.23,Caption,,0,0,0,,А ПОСАДОЧНАЯ ПОЛОСА. КАЖДЫЙ ПРИВЕЗЁТ СОБСТВЕННЫЙ
Dialogue: 0,0:07:10.23,0:07:14.07,Caption,,0,0,0,,СТУЛ, ФЛАГ И СОВЕТ, КАК УСТУПАТЬ ДОЛЖЕН КТО НИБУДЬ ДРУГОЙ.
Dialogue: 0,0:07:14.62,0:07:17.35,Caption,,0,0,0,,НО КОЛИЧЕСТВО КРЕСЕЛ ЕЩЁ НЕ СОЗДАЁТ ОБЩЕЙ ПОЗИЦИИ.
Dialogue: 0,0:07:17.82,0:07:20.31,Caption,,0,0,0,,ДЛЯ ЭТОГО НУЖНО ХОТЯ БЫ ОДИНАКОВО ПОНИМАТЬ ЦЕЛЬ
Dialogue: 0,0:07:20.31,0:07:22.95,Caption,,0,0,0,,РАЗГОВОРА. А ЕВРОПА ПОНИМАЕТ ЕЁ ПО РАЗНОМУ.
Dialogue: 0,0:07:25.22,0:07:27.38,Caption,,0,0,0,,ЭММАНУЭЛЬ МАКРОН УБЕЖДАЕТ ФРАНЦУЗОВ,
Dialogue: 0,0:07:27.62,0:07:30.82,Caption,,0,0,0,,ЧТО ПОМОЩЬ УКРАИНЕ НАПРЯМУЮ СВЯЗАНА С БЕЗОПАСНОСТЬЮ
Dialogue: 0,0:07:30.82,0:07:35.06,Caption,,0,0,0,,ФРАНЦИИ. ПО ЕГО ЛОГИКЕ, ПОРАЖЕНИЕ КИЕВА ОСЛАБИТ ВСЮ ЕВРОПУ,
Dialogue: 0,0:07:35.22,0:07:37.94,Caption,,0,0,0,,ПОЭТОМУ ВОЕННУЮ ПОДДЕРЖКУ НЕОБХОДИМО ПРОДОЛЖАТЬ.
Dialogue: 0,0:07:38.74,0:07:41.14,Caption,,0,0,0,,РОБЕРТ ФИЦО ВИДИТ ПЕРЕД СОБОЙ ТУ ЖЕ КАРТУ,
Dialogue: 0,0:07:41.46,0:07:45.86,Caption,,0,0,0,,НО ЧИТАЕТ ЕЁ ИНАЧЕ. СЛОВАКИЯ ГОТОВА УЧАСТВОВАТЬ В ОБСУЖДЕНИИ МИРА,
Dialogue: 0,0:07:46.10,0:07:48.26,Caption,,0,0,0,,ОДНАКО НОВЫЙ ЕВРОПЕЙСКИЙ КРЕДИТ НА ВОЙНУ
Dialogue: 0,0:07:48.26,0:07:51.22,Caption,,0,0,0,,ПОДДЕРЖИВАТЬ НЕ НАМЕРЕНА. ОБА ПОЛИТИКА ПРОИЗНОСЯТ
Dialogue: 0,0:07:51.22,0:07:54.42,Caption,,0,0,0,,СЛОВО МИР. ОДИН ПРЕДЛАГАЕТ РАДИ НЕГО ВЫДЕЛИТЬ ЕЩЁ
Dialogue: 0,0:07:54.42,0:07:57.78,Caption,,0,0,0,,ДЕНЕГ НА ВООРУЖЕНИЕ. ВТОРОЙ ОТКАЗЫВАЕТСЯ ОПЛАЧИВАТЬ
Dialogue: 0,0:07:57.78,0:08:00.82,Caption,,0,0,0,,СЛЕДУЮЩИЙ СЧЁТ. ТАК ВЫГЛЯДИТ ЕВРОПЕЙСКОЕ СОГЛАСИЕ
Dialogue: 0,0:08:00.82,0:08:04.18,Caption,,0,0,0,,БЕЗ ПАРАДНОГО ОСВЕЩЕНИЯ И ОРКЕСТРА. МАКРОНУ ПРИ ЭТОМ
Dialogue: 0,0:08:04.18,0:08:06.10,Caption,,0,0,0,,ПРИХОДИТСЯ УБЕЖДАТЬ НЕ ТОЛЬКО СОСЕДЕЙ,
Dialogue: 0,0:08:06.33,0:08:08.90,Caption,,0,0,0,,НО И СОБСТВЕННУЮ СТРАНУ. ЕГО РАБОТУ ОДОБРЯЮТ
Dialogue: 0,0:08:08.98,0:08:10.82,Caption,,0,0,0,,ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ ФРАНЦУЗОВ,
Dialogue: 0,0:08:11.17,0:08:13.30,Caption,,0,0,0,,А ВОСЕМЬДЕСЯТ ТРИ ПРОЦЕНТА ОЦЕНИВАЮТ ЕЁ
Dialogue: 0,0:08:13.30,0:08:16.82,Caption,,0,0,0,,ОТРИЦАТЕЛЬНО. ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ. С ТАКИМ
Dialogue: 0,0:08:16.82,0:08:19.38,Caption,,0,0,0,,ЗАПАСОМ НАРОДНОЙ ЛЮБВИ МОЖНО СМЕЛО ОБЪЯСНЯТЬ
Dialogue: 0,0:08:19.38,0:08:22.18,Caption,,0,0,0,,КОНТИНЕНТУ, КАК ЕМУ ЖИТЬ. ГЛАВНОЕ,
Dialogue: 0,0:08:22.42,0:08:24.74,Caption,,0,0,0,,НЕ ЗАДЕРЖИВАТЬСЯ ВОЗЛЕ ИЗБИРАТЕЛЬНОГО УЧАСТКА.
Dialogue: 0,0:08:25.14,0:08:27.30,Caption,,0,0,0,,ФРАНЦУЗОВ СИЛЬНЕЕ ТРЕВОЖАТ ПОКУПАТЕЛЬНАЯ
Dialogue: 0,0:08:27.30,0:08:29.46,Caption,,0,0,0,,СПОСОБНОСТЬ, СОЦИАЛЬНАЯ СИСТЕМА,
Dialogue: 0,0:08:29.70,0:08:32.74,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЙ ДОЛГ И ДЕФИЦИТ БЮДЖЕТА. ЛЮДИ
Dialogue: 0,0:08:32.74,0:08:36.34,Caption,,0,0,0,,ОТКРЫВАЮТ СЧЕТА, ЗАГЛЯДЫВАЮТ В КОШЕЛЁК И ПЫТАЮТСЯ ПОНЯТЬ,
Dialogue: 0,0:08:36.59,0:08:38.74,Caption,,0,0,0,,ПОЧЕМУ ДЕНЕГ ОПЯТЬ ОСТАЛОСЬ МЕНЬШЕ.
Dialogue: 0,0:08:41.03,0:08:43.27,Caption,,0,0,0,,В ОТВЕТ ИМ ПРЕДЛАГАЮТ ПОЧУВСТВОВАТЬ МАСШТАБ
Dialogue: 0,0:08:43.27,0:08:45.83,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. МАСШТАБ ОНИ,
Dialogue: 0,0:08:45.98,0:08:50.07,Caption,,0,0,0,,ВОЗМОЖНО, ЧУВСТВУЮТ. ОСОБЕННО В МАГАЗИНЕ. МАКРОН МОЖЕТ СКОЛЬКО
Dialogue: 0,0:08:50.07,0:08:54.39,Caption,,0,0,0,,УГОДНО ПОВТОРЯТЬ, ЧТО НОВЫЕ РАСХОДЫ НЕОБХОДИМЫ. РЕЙТИНГ В ЧЕТЫРНАДЦАТЬ
Dialogue: 0,0:08:54.39,0:08:58.95,Caption,,0,0,0,,ПРОЦЕНТОВ ПОКАЗЫВАЕТ, НАСКОЛЬКО ПУБЛИКА ПРОНИКЛАСЬ ЭТИМ ОБЪЯСНЕНИЕМ. ЕЩЁ
Dialogue: 0,0:08:59.03,0:09:02.71,Caption,,0,0,0,,НЕМНОГО УСИЛИЙ, И СТОРОННИКОВ ПРЕЗИДЕНТА МОЖНО БУДЕТ СОБИРАТЬ В
Dialogue: 0,0:09:02.79,0:09:05.03,Caption,,0,0,0,,ОДНОМ ХОРОШЕМ РЕСТОРАНЕ. ПРАВДА,
Dialogue: 0,0:09:05.11,0:09:07.91,Caption,,0,0,0,,СЧЁТ СНОВА ПРИДЁТСЯ ДЕЛИТЬ. НА ЭТОМ ФОНЕ БЫВШИЙ
Dialogue: 0,0:09:07.91,0:09:10.71,Caption,,0,0,0,,КАНЦЛЕР ГЕРМАНИИ ОЛАФ ШОЛЬЦ НАПОМНИЛ ЕВРОПЕ
Dialogue: 0,0:09:10.71,0:09:13.83,Caption,,0,0,0,,НЕПРИЯТНУЮ ГЕОГРАФИЧЕСКУЮ ПОДРОБНОСТЬ. РОССИЯ НЕ
Dialogue: 0,0:09:13.83,0:09:17.03,Caption,,0,0,0,,ИСЧЕЗНЕТ. ОНА ОСТАЁТСЯ КРУПНОЙ ЯДЕРНОЙ ДЕРЖАВОЙ С
Dialogue: 0,0:09:17.03,0:09:18.87,Caption,,0,0,0,,СЕРЬЁЗНЫМИ ВООРУЖЁННЫМИ СИЛАМИ,
Dialogue: 0,0:09:19.19,0:09:22.23,Caption,,0,0,0,,ПОЭТОМУ БУДУЩУЮ БЕЗОПАСНОСТЬ КОНТИНЕНТА ВСЁ РАВНО
Dialogue: 0,0:09:22.23,0:09:25.35,Caption,,0,0,0,,ПРИДЁТСЯ ОБСУЖДАТЬ С ЕЁ УЧАСТИЕМ. ОТКРЫТИЕ ПОЧТИ
Dialogue: 0,0:09:25.35,0:09:28.71,Caption,,0,0,0,,НАУЧНОЕ. РОССИЮ НЕСКОЛЬКО ЛЕТ ПЫТАЛИСЬ ВЫТЕСНИТЬ ИЗ
Dialogue: 0,0:09:28.71,0:09:32.87,Caption,,0,0,0,,ЕВРОПЕЙСКИХ РАСЧЁТОВ, СЛОВНО ДОСТАТОЧНО НЕ ПОЗВАТЬ СТРАНУ НА ВСТРЕЧУ,
Dialogue: 0,0:09:33.03,0:09:35.11,Caption,,0,0,0,,И ОНА ПОСЛУШНО УБЕРЁТ ТЕРРИТОРИЮ,
Dialogue: 0,0:09:35.27,0:09:38.23,Caption,,0,0,0,,АРМИЮ И ЯДЕРНЫЙ АРСЕНАЛ КУДА НИБУДЬ ЗА ГОРИЗОНТ.
Dialogue: 0,0:09:38.71,0:09:41.99,Caption,,0,0,0,,НО КАРТА ПРОЯВИЛА ХАРАКТЕР. РОССИЯ ОСТАЛАСЬ ТАМ ЖЕ,
Dialogue: 0,0:09:42.09,0:09:44.95,Caption,,0,0,0,,ГДЕ БЫЛА. ТОЛЬКО ВОЕННЫХ ОБЪЕКТОВ ВОКРУГ СТАЛО
Dialogue: 0,0:09:44.95,0:09:50.15,Caption,,0,0,0,,БОЛЬШЕ, ДОВЕРИЯ МЕНЬШЕ, А ЦЕНА ЛЮБОЙ ОШИБКИ ВЫРОСЛА. ШОЛЬЦ ПРЕДЛАГАЕТ НЕ
Dialogue: 0,0:09:50.15,0:09:52.23,Caption,,0,0,0,,ОСОБУЮ СДЕЛКУ БЕРЛИНА С МОСКВОЙ,
Dialogue: 0,0:09:52.60,0:09:59.45,Caption,,0,0,0,,А ОБЩЕЕВРОПЕЙСКИЙ РАЗГОВОР. И ТУТ ВОЗНИКАЕТ СТАРЫЙ ВОПРОС КТО ИМЕННО БУДЕТ
Dialogue: 0,0:09:59.45,0:10:02.81,Caption,,0,0,0,,ГОВОРИТЬ ОТ ИМЕНИ ЕВРОПЫ? ВСЕ ВЫСТУПАЮТ ЗА ЕДИНСТВО,
Dialogue: 0,0:10:03.13,0:10:05.77,Caption,,0,0,0,,ПОКА ЕДИНСТВО НЕ ПРОСИТ НАЗВАТЬ СУММУ И ПОСТАВИТЬ
Dialogue: 0,0:10:05.85,0:10:08.81,Caption,,0,0,0,,ПОДПИСЬ. ШОЛЬЦ ЗАТРОНУЛ И ОТНОШЕНИЯ С ГЛОБАЛЬНЫМ
Dialogue: 0,0:10:08.89,0:10:11.93,Caption,,0,0,0,,ЮГОМ. ЕВРОПА СЛИШКОМ ДОЛГО ОБРАЩАЛАСЬ С ДРУГИМИ
Dialogue: 0,0:10:11.93,0:10:15.29,Caption,,0,0,0,,ГОСУДАРСТВАМИ ТАК, БУДТО РЕШЕНИЕ УЖЕ ПРИНЯТО В БРЮССЕЛЕ,
Dialogue: 0,0:10:15.61,0:10:17.85,Caption,,0,0,0,,А ОСТАЛЬНОМУ МИРУ ВЫДАЛИ НЕСКОЛЬКО МИНУТ ДЛЯ
Dialogue: 0,0:10:17.85,0:10:20.33,Caption,,0,0,0,,СОГЛАСИЯ. ЗАПАД НАЗНАЧИЛ ВИНОВАТОГО,
Dialogue: 0,0:10:20.58,0:10:23.53,Caption,,0,0,0,,ОПРЕДЕЛИЛ ПРАВИЛЬНУЮ СТОРОНУ И ПРИГОТОВИЛ МЕСТО ДЛЯ
Dialogue: 0,0:10:23.53,0:10:26.73,Caption,,0,0,0,,ПОДПИСИ. НО ИНДИЯ НЕ СПЕШИТ ПОДПИСЫВАТЬ. КИТАЙ
Dialogue: 0,0:10:26.73,0:10:29.61,Caption,,0,0,0,,РУКОВОДСТВУЕТСЯ СОБСТВЕННЫМИ ИНТЕРЕСАМИ. АФРИКАНСКИЕ
Dialogue: 0,0:10:29.61,0:10:32.33,Caption,,0,0,0,,ГОСУДАРСТВА ЗАДАЮТ НЕУДОБНЫЕ ВОПРОСЫ. СТРАНЫ
Dialogue: 0,0:10:32.33,0:10:35.21,Caption,,0,0,0,,БЛИЖНЕГО ВОСТОКА ТОЖЕ НЕ ГОТОВЫ МЕНЯТЬ СВОЮ ВЫГОДУ
Dialogue: 0,0:10:35.21,0:10:38.25,Caption,,0,0,0,,НА ЕВРОПЕЙСКОЕ ОДОБРЕНИЕ. ВЫЯСНИЛОСЬ УЖАСНОЕ. У
Dialogue: 0,0:10:38.33,0:10:41.21,Caption,,0,0,0,,ОГРОМНОЙ ЧАСТИ ПЛАНЕТЫ ИМЕЕТСЯ СОБСТВЕННОЕ МНЕНИЕ.
Dialogue: 0,0:10:41.43,0:10:44.01,Caption,,0,0,0,,ПРИЧЁМ НЕКОТОРЫЕ ПРАВИТЕЛЬСТВА НЕ МЕНЯЮТ ЕГО ДАЖЕ
Dialogue: 0,0:10:44.09,0:10:46.41,Caption,,0,0,0,,ПОСЛЕ ОЧЕНЬ СТРОГОГО ВЗГЛЯДА ИЗ БРЮССЕЛЯ.
Dialogue: 0,0:10:46.83,0:10:49.37,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ И ПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:10:49.68,0:10:52.41,Caption,,0,0,0,,ЧЕМ ЗАКОНЧИТСЯ ЭТО ЕВРОПЕЙСКОЕ СОБИРАНИЕ СТУЛЬЕВ.
Dialogue: 0,0:10:52.64,0:10:54.97,Caption,,0,0,0,,ПОТОМУ ЧТО ГЛАВНЫЙ СПОР УЖЕ ВЫШЕЛ ДАЛЕКО ЗА
Dialogue: 0,0:10:54.97,0:10:57.85,Caption,,0,0,0,,ПРЕДЕЛЫ УКРАИНЫ И ДОБРАЛСЯ ДО УСТРОЙСТВА ВСЕЙ
Dialogue: 0,0:10:57.85,0:11:00.89,Caption,,0,0,0,,БЕЗОПАСНОСТИ НА КОНТИНЕНТЕ. В ОБСУЖДАЕМОМ НАБОРЕ
Dialogue: 0,0:11:00.89,0:11:03.53,Caption,,0,0,0,,РОССИЙСКИХ УСЛОВИЙ ЗАТРАГИВАЕТСЯ ДАЖЕ БРИТАНСКИЙ
Dialogue: 0,0:11:03.53,0:11:07.56,Caption,,0,0,0,,ЯДЕРНЫЙ ПОТЕНЦИАЛ. КРОМЕ НЕГО,
Dialogue: 0,0:11:07.73,0:11:10.36,Caption,,0,0,0,,РЕЧЬ ИДЁТ О ВОЕННЫХ ОБЪЕКТАХ НАТО В ВОСТОЧНОЙ
Dialogue: 0,0:11:10.36,0:11:13.56,Caption,,0,0,0,,ЕВРОПЕ, ОТКАЗЕ УКРАИНЫ ОТ ВСТУПЛЕНИЯ В АЛЬЯНС,
Dialogue: 0,0:11:13.80,0:11:16.92,Caption,,0,0,0,,ПРИСУТСТВИИ ИНОСТРАННЫХ СИЛ И ПОСТАВКАХ ЗАПАДНОГО
Dialogue: 0,0:11:16.92,0:11:21.32,Caption,,0,0,0,,ВООРУЖЕНИЯ. МОСКВА СНОВА ВОЗВРАЩАЕТ К ВОПРОСУ О КОНФИГУРАЦИИ
Dialogue: 0,0:11:21.32,0:11:24.28,Caption,,0,0,0,,НАТО ДЕВЯНОСТО СЕДЬМОГО ГОДА. РОССИЙСКАЯ ПОЗИЦИЯ
Dialogue: 0,0:11:24.28,0:11:28.20,Caption,,0,0,0,,СТРОИТСЯ НА ТОМ, ЧТО УКРАИНСКИЙ КОНФЛИКТ НЕЛЬЗЯ ЗАКРЫТЬ ОКОНЧАТЕЛЬНО,
Dialogue: 0,0:11:28.44,0:11:30.68,Caption,,0,0,0,,СОХРАНИВ БЕЗ ИЗМЕНЕНИЙ ВСЮ СИСТЕМУ,
Dialogue: 0,0:11:30.84,0:11:33.40,Caption,,0,0,0,,КОТОРУЮ РОССИЯ ВОСПРИНИМАЕТ КАК ПРЯМУЮ УГРОЗУ.
Dialogue: 0,0:11:33.96,0:11:36.68,Caption,,0,0,0,,ИМЕННО ЗДЕСЬ ЗАКАНЧИВАЮТСЯ УДОБНЫЕ РАЗГОВОРЫ О МИРЕ
Dialogue: 0,0:11:36.68,0:11:42.36,Caption,,0,0,0,,ВООБЩЕ И НАЧИНАЮТСЯ УСЛОВИЯ, ОТ КОТОРЫХ У УЧАСТНИКОВ ПОРТИТСЯ НАСТРОЕНИЕ. НАТО НЕ
Dialogue: 0,0:11:42.36,0:11:44.84,Caption,,0,0,0,,НАМЕРЕНО ДОБРОВОЛЬНО УБИРАТЬ ИНФРАСТРУКТУРУ,
Dialogue: 0,0:11:45.06,0:11:47.88,Caption,,0,0,0,,КОТОРУЮ ГОДАМИ РАЗМЕЩАЛО НА ВОСТОЧНОМ НАПРАВЛЕНИИ.
Dialogue: 0,0:11:48.25,0:11:50.68,Caption,,0,0,0,,ДЛЯ РОССИИ ГАРАНТИЕЙ СЛУЖИТ СОКРАЩЕНИЕ ВОЕННОГО
Dialogue: 0,0:11:50.68,0:11:54.12,Caption,,0,0,0,,ПРИСУТСТВИЯ АЛЬЯНСА У ЕЁ ГРАНИЦ. ДЛЯ САМОГО АЛЬЯНСА
Dialogue: 0,0:11:54.43,0:11:56.92,Caption,,0,0,0,,ГАРАНТИЕЙ СЧИТАЕТСЯ ВОЗМОЖНОСТЬ ЭТО ПРИСУТСТВИЕ
Dialogue: 0,0:11:56.93,0:12:00.76,Caption,,0,0,0,,ОСТАВИТЬ И ПРИ НЕОБХОДИМОСТИ РАСШИРИТЬ. ОБЕ СТОРОНЫ
Dialogue: 0,0:12:00.76,0:12:03.64,Caption,,0,0,0,,УПОТРЕБЛЯЮТ СЛОВО БЕЗОПАСНОСТЬ. ТОЛЬКО КАЖДАЯ
Dialogue: 0,0:12:03.64,0:12:06.68,Caption,,0,0,0,,ПОДРАЗУМЕВАЕТ БЕЗОПАСНОСТЬ ОТ ДРУГОЙ СТОРОНЫ. МОЖНО
Dialogue: 0,0:12:06.68,0:12:11.16,Caption,,0,0,0,,ПРОВЕСТИ ДЕСЯТОК ВСТРЕЧ, СФОТОГРАФИРОВАТЬ РУКОПОЖАТИЯ И ВЫПУСТИТЬ ЗАЯВЛЕНИЕ О
Dialogue: 0,0:12:11.16,0:12:13.96,Caption,,0,0,0,,ПОЛЕЗНОЙ АТМОСФЕРЕ. НО ЗАТЕМ КТО ТО ОТКРОЕТ СПИСОК
Dialogue: 0,0:12:13.96,0:12:17.80,Caption,,0,0,0,,ТРЕБОВАНИЙ, И ПОЛЕЗНАЯ АТМОСФЕРА БЫСТРО ПОКИНЕТ ПОМЕЩЕНИЕ ЧЕРЕЗ
Dialogue: 0,0:12:17.88,0:12:21.00,Caption,,0,0,0,,ОКНО. РОССИЙСКАЯ ФОРМУЛА ДЛЯ НАТО ЗВУЧИТ ПРЕДЕЛЬНО
Dialogue: 0,0:12:21.00,0:12:25.13,Caption,,0,0,0,,ЖЁСТКО. НАЗВАНИЕ СОХРАНЯЙТЕ,
Dialogue: 0,0:12:25.30,0:12:27.69,Caption,,0,0,0,,ФОРМУ НОСИТЕ, ПАРАДЫ ПРОВОДИТЕ,
Dialogue: 0,0:12:27.91,0:12:31.13,Caption,,0,0,0,,БРОНЕТЕХНИКУ ПОКАЗЫВАЙТЕ ПУБЛИКЕ. А РАКЕТЫ,
Dialogue: 0,0:12:31.22,0:12:34.01,Caption,,0,0,0,,БАЗЫ И ПРОЧИЕ ВОЕННЫЕ ОБЪЕКТЫ ВОЗЛЕ РОССИЙСКИХ
Dialogue: 0,0:12:34.01,0:12:39.05,Caption,,0,0,0,,РУБЕЖЕЙ УБИРАЙТЕ. ОТВЕТ АЛЬЯНСА ТОЖЕ ПОМЕЩАЕТСЯ В ОДНО КОРОТКОЕ СЛОВО.
Dialogue: 0,0:12:39.42,0:12:42.81,Caption,,0,0,0,,НЕТ. НА ЭТОМ ВСЯ ТОРЖЕСТВЕННАЯ ЧАСТЬ ЗАКАНЧИВАЕТСЯ.
Dialogue: 0,0:12:43.21,0:12:45.53,Caption,,0,0,0,,ДАЖЕ ЕСЛИ СТОРОНЫ КОГДА НИБУДЬ ПРОДВИНУТСЯ ПО
Dialogue: 0,0:12:45.53,0:12:50.33,Caption,,0,0,0,,УКРАИНСКОМУ НАПРАВЛЕНИЮ, СПОР О ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ ОСТАНЕТСЯ ОТДЕЛЬНОЙ
Dialogue: 0,0:12:50.33,0:12:53.21,Caption,,0,0,0,,ОГРОМНОЙ ПРОБЛЕМОЙ. ЕГО НЕЛЬЗЯ ЗАКРЫТЬ ФОРМУЛИРОВКОЙ
Dialogue: 0,0:12:53.29,0:12:56.09,Caption,,0,0,0,,О ПРЕКРАЩЕНИИ ОГНЯ И СПРЯТАТЬ В НИЖНИЙ ЯЩИК.
Dialogue: 0,0:12:56.40,0:12:58.97,Caption,,0,0,0,,ПОЭТОМУ БРИТАНСКИЙ РАЗВОРОТ ТАК ПОКАЗАТЕЛЕН.
Dialogue: 0,0:12:59.53,0:13:03.69,Caption,,0,0,0,,ЛОНДОН ПОНИМАЕТ, ЧТО ОБСУЖДЕНИЕ КАСАЕТСЯ УЖЕ НЕ ТОЛЬКО ДОНБАССА И
Dialogue: 0,0:13:03.69,0:13:06.57,Caption,,0,0,0,,НЕ ТОЛЬКО ЛИНИИ СОПРИКОСНОВЕНИЯ. ТУТ ПЕРЕГОВОРЫ
Dialogue: 0,0:13:06.57,0:13:09.69,Caption,,0,0,0,,НАЧИНАЮТ ЗВУЧАТЬ ГОРАЗДО ПРИВЛЕКАТЕЛЬНЕЕ. ЗЕЛЕНСКИЙ,
Dialogue: 0,0:13:09.83,0:13:13.77,Caption,,0,0,0,,РАЗУМЕЕТСЯ, ОСТАНАВЛИВАТЬСЯ НЕ СОБИРАЕТСЯ. ОН СНОВА ПРЕДЛАГАЕТ
Dialogue: 0,0:13:13.77,0:13:16.97,Caption,,0,0,0,,ВЫНУДИТЬ РОССИЮ УСТУПИТЬ ПРИ ПОМОЩИ НОВЫХ САНКЦИЙ И
Dialogue: 0,0:13:16.97,0:13:20.41,Caption,,0,0,0,,АМЕРИКАНСКОГО ОРУЖИЯ. РЕЦЕПТ УДИВИТЕЛЬНО СВЕЖИЙ.
Dialogue: 0,0:13:20.79,0:13:24.09,Caption,,0,0,0,,ПОЧТИ НЕ ИСПОЛЬЗОВАННЫЙ. ЕВРОПА ПРИНИМАЛА ОДИН ПАКЕТ
Dialogue: 0,0:13:24.09,0:13:27.21,Caption,,0,0,0,,ОГРАНИЧЕНИЙ ЗА ДРУГИМ. ОРУЖИЕ ПОСТУПАЛО НА УКРАИНУ
Dialogue: 0,0:13:27.29,0:13:30.49,Caption,,0,0,0,,ГОДАМИ. ТЕПЕРЬ ПРЕДЛАГАЕТСЯ НАЙТИ ЕЩЁ ОДИН ОСОБЕННЫЙ
Dialogue: 0,0:13:30.49,0:13:33.85,Caption,,0,0,0,,ПАКЕТ, ПОСЛЕ КОТОРОГО МОСКВА ПОСМОТРИТ НА ПРЕДЫДУЩИЕ,
Dialogue: 0,0:13:34.11,0:13:37.21,Caption,,0,0,0,,УСТЫДИТСЯ СВОЕЙ НЕВНИМАТЕЛЬНОСТИ И НЕМЕДЛЕННО СТАНЕТ
Dialogue: 0,0:13:37.21,0:13:40.65,Caption,,0,0,0,,СГОВОРЧИВОЙ. В ДЕВЯНОСТО ПЯТОМ КВАРТАЛЕ ФАНТАЗИЯ
Dialogue: 0,0:13:40.65,0:13:46.12,Caption,,0,0,0,,РАБОТАЕТ БЕЗ ВЫХОДНЫХ. ЕСЛИ СОБСТВЕННЫЙ СЦЕНАРИЙ ЗАБУКСУЕТ,
Dialogue: 0,0:13:46.33,0:13:48.92,Caption,,0,0,0,,БРИТАНСКИЕ ПАРТНЁРЫ ВСЕГДА МОГУТ ПРИНЕСТИ СТАРУЮ
Dialogue: 0,0:13:48.92,0:13:51.08,Caption,,0,0,0,,ПАПКУ И НАПИСАТЬ НА НЕЙ СЛОВО НОВАЯ.
Dialogue: 0,0:13:51.79,0:13:54.44,Caption,,0,0,0,,НО ПОВЕДЕНИЕ ЗЕЛЕНСКОГО ВПОЛНЕ ОБЪЯСНИМО. ЕМУ
Dialogue: 0,0:13:54.44,0:13:56.92,Caption,,0,0,0,,ЖИЗНЕННО ВАЖНО ОСТАВАТЬСЯ ВНУТРИ ПЕРЕГОВОРНОЙ
Dialogue: 0,0:13:56.92,0:14:00.20,Caption,,0,0,0,,КОНСТРУКЦИИ. МОСКВА РАЗГОВАРИВАЕТ С ВАШИНГТОНОМ.
Dialogue: 0,0:14:00.44,0:14:03.48,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТРАНЫ СОБИРАЮТ КОАЛИЦИИ. ПРАВИТЕЛЬСТВА
Dialogue: 0,0:14:03.56,0:14:06.36,Caption,,0,0,0,,ПЕРЕСЧИТЫВАЮТ РАСХОДЫ. В ТАКОЙ ОБСТАНОВКЕ КИЕВ
Dialogue: 0,0:14:06.44,0:14:09.40,Caption,,0,0,0,,ДОЛЖЕН ПОСТОЯННО НАПОМИНАТЬ О СЕБЕ И ВЫДВИГАТЬ
Dialogue: 0,0:14:09.40,0:14:13.88,Caption,,0,0,0,,ОЧЕРЕДНОЕ УСЛОВИЕ, ТРЕБОВАНИЕ ИЛИ СПОСОБ ПРИНУДИТЬ РОССИЮ К УСТУПКАМ.
Dialogue: 0,0:14:14.52,0:14:16.76,Caption,,0,0,0,,ЕСЛИ ГЛАВНЫЕ РЕШЕНИЯ НАЧНУТ ПРИНИМАТЬ БЕЗ
Dialogue: 0,0:14:16.76,0:14:20.52,Caption,,0,0,0,,ЗЕЛЕНСКОГО, ОПАСНОСТЬ ДЛЯ НЕГО СТАНЕТ КУДА СЕРЬЁЗНЕЕ ЛЮБОГО
Dialogue: 0,0:14:20.52,0:14:23.48,Caption,,0,0,0,,НЕУДОБНОГО ВОПРОСА ПЕРЕД КАМЕРАМИ. ЗАКАНЧИВАТЬ
Dialogue: 0,0:14:23.48,0:14:26.36,Caption,,0,0,0,,КОНФЛИКТ ЕМУ НЕВЫГОДНО. ЭТО ПОНИМАЮТ УЖЕ НЕ ТОЛЬКО
Dialogue: 0,0:14:26.36,0:14:28.84,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА И СОВЕТНИКИ. ЭТО ЗНАЕТ ЛЮБАЯ
Dialogue: 0,0:14:28.84,0:14:33.32,Caption,,0,0,0,,ДОМОХОЗЯЙКА В ТВЕРИ, ОДЕССЕ ИЛИ ИЗМАИЛЕ. ПОЭТОМУ ЖДАТЬ,
Dialogue: 0,0:14:33.48,0:14:36.44,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКИЙ ОДНАЖДЫ САМ ПРЕДЛОЖИТ БЫСТРО ЗАКРЫТЬ
Dialogue: 0,0:14:36.44,0:14:40.60,Caption,,0,0,0,,ВСЮ ИСТОРИЮ, БЕССМЫСЛЕННО. ОН БУДЕТ ИСКАТЬ ЛЮБУЮ НОВУЮ ОПОРУ.
Dialogue: 0,0:14:40.89,0:14:46.36,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ, АМЕРИКАНСКУЮ, САНКЦИОННУЮ ИЛИ ВОЕННУЮ. НАЗВАНИЕ НЕ ИМЕЕТ ЗНАЧЕНИЯ.
Dialogue: 0,0:14:46.68,0:14:49.56,Caption,,0,0,0,,ЗНАЧЕНИЕ ИМЕЕТ ОДНО В ЦЕНТРЕ ЭТОЙ СХЕМЫ ДОЛЖНО
Dialogue: 0,0:14:49.56,0:14:54.12,Caption,,0,0,0,,ОСТАВАТЬСЯ МЕСТО ДЛЯ НЕГО. ОДНАКО ОБСТАНОВКА ИЗМЕНИЛАСЬ. БРИТАНИЯ УЖЕ
Dialogue: 0,0:14:54.12,0:14:59.04,Caption,,0,0,0,,ПРОИЗНОСИТ СЛОВО ПЕРЕГОВОРЫ. ШОЛЬЦ ПРИЗНАЁТ,
Dialogue: 0,0:14:59.28,0:15:02.16,Caption,,0,0,0,,ЧТО ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ НЕЛЬЗЯ ПОСТРОИТЬ БЕЗ
Dialogue: 0,0:15:02.16,0:15:05.60,Caption,,0,0,0,,РАЗГОВОРА С РОССИЕЙ. ФИЦО НЕ ХОЧЕТ УЧАСТВОВАТЬ В
Dialogue: 0,0:15:05.60,0:15:08.48,Caption,,0,0,0,,ОЧЕРЕДНОМ ВОЕННОМ КРЕДИТЕ. БЕЛАРУСЬ УКАЗЫВАЕТ НА
Dialogue: 0,0:15:08.48,0:15:12.48,Caption,,0,0,0,,АЭРОДРОМЫ, ХРАНИЛИЩА И РАСТУЩУЮ АКТИВНОСТЬ ВОЗЛЕ СВОИХ ГРАНИЦ.
Dialogue: 0,0:15:12.94,0:15:16.00,Caption,,0,0,0,,МОСКВА ПЕРЕВОДИТ СПОР С УКРАИНЫ НА УСТРОЙСТВО ВСЕЙ
Dialogue: 0,0:15:16.00,0:15:18.88,Caption,,0,0,0,,ЕВРОПЫ. МИР ОТ ЭТОГО НЕ НАСТУПИЛ. ДО НЕГО
Dialogue: 0,0:15:18.96,0:15:23.04,Caption,,0,0,0,,ЕЩЁ ДАЛЕКО. НО ДЕЛАТЬ ВИД, БУДТО БОЛЬШОГО РАЗГОВОРА МОЖНО ИЗБЕЖАТЬ,
Dialogue: 0,0:15:23.35,0:15:26.64,Caption,,0,0,0,,СТАНОВИТСЯ ВСЁ СЛОЖНЕЕ. СНАЧАЛА ЕВРОПЕЙЦЫ УВЕРЯЛИ,
Dialogue: 0,0:15:26.94,0:15:29.68,Caption,,0,0,0,,ЧТО ОБСУЖДАТЬ С МОСКВОЙ НЕЧЕГО. ПОТОМ БРИТАНЦАМ
Dialogue: 0,0:15:29.68,0:15:31.60,Caption,,0,0,0,,ПОНАДОБИЛАСЬ СРОЧНАЯ ЛИНИЯ СВЯЗИ.
Dialogue: 0,0:15:32.23,0:15:34.72,Caption,,0,0,0,,ТЕПЕРЬ ЛОНДОН УЖЕ ПРЕДЛАГАЕТ ЗАВЕРШАТЬ КОНФЛИКТ
Dialogue: 0,0:15:34.72,0:15:37.68,Caption,,0,0,0,,ПЕРЕГОВОРАМИ. СЛЕДУЮЩЕЕ ОТКРЫТИЕ БУДЕТ САМЫМ
Dialogue: 0,0:15:37.68,0:15:41.44,Caption,,0,0,0,,БОЛЕЗНЕННЫМ. ЗА СТОЛОМ МАЛО ПРОИЗНОСИТЬ ТРЕБОВАНИЯ. ИНОГДА
Dialogue: 0,0:15:41.44,0:15:44.32,Caption,,0,0,0,,ПРИХОДИТСЯ ОТКАЗЫВАТЬСЯ ОТ ЧАСТИ СОБСТВЕННЫХ. А
Dialogue: 0,0:15:44.32,0:15:47.28,Caption,,0,0,0,,ЖЕЛАЮЩИХ УЧАСТВОВАТЬ ВО ВСТРЕЧЕ ПОКА ЗАМЕТНО БОЛЬШЕ,
Dialogue: 0,0:15:47.52,0:15:50.56,Caption,,0,0,0,,ЧЕМ ЖЕЛАЮЩИХ ЧЕМ ЛИБО ЖЕРТВОВАТЬ. ВОТ ТАМ И
Dialogue: 0,0:15:50.56,0:15:52.32,Caption,,0,0,0,,НАЧНЁТСЯ ГЛАВНОЕ ПРЕДСТАВЛЕНИЕ,
Dialogue: 0,0:15:52.56,0:15:55.60,Caption,,0,0,0,,КОГДА КАЖДЫЙ ПРИВЕЗЁТ ПЕРЕЧЕНЬ ЧУЖИХ УСТУПОК И НИ
Dialogue: 0,0:15:55.60,0:15:59.20,Caption,,0,0,0,,ОДНОЙ СВОЕЙ. ПОД КОНЕЦ БОРИС ДЖОНСОН РЕШИЛ НАПОМНИТЬ,
Dialogue: 0,0:15:59.44,0:16:01.84,Caption,,0,0,0,,КАК В ДВЕ ТЫСЯЧИ СЕМНАДЦАТОМ ГОДУ ВСТРЕЧАЛСЯ В
Dialogue: 0,0:16:01.84,0:16:04.56,Caption,,0,0,0,,МОСКВЕ С СЕРГЕЕМ ЛАВРОВЫМ. ДЖОНСОН УВЕРЯЕТ,
Dialogue: 0,0:16:04.81,0:16:07.52,Caption,,0,0,0,,ЧТО ВОЗЛЕ РАСКАЛЁННОГО КАМИНА ЕГО ЗАСТАВЛЯЛИ ПИТЬ
Dialogue: 0,0:16:07.52,0:16:11.56,Caption,,0,0,0,,МНОГО ВОДКИ. ЕМУ БЫЛО ТЯЖЕЛО,
Dialogue: 0,0:16:11.72,0:16:14.36,Caption,,0,0,0,,ВСТРЕЧА НЕ ДАЛА РЕЗУЛЬТАТА, А ВОСПОМИНАНИЯ,
Dialogue: 0,0:16:14.60,0:16:17.32,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, СОХРАНИЛИСЬ ОСОБЕННО ЯРКИЕ.
Dialogue: 0,0:16:18.06,0:16:21.16,Caption,,0,0,0,,МАРИЯ ЗАХАРОВА ИЗЛОЖИЛА ДРУГУЮ ВЕРСИЮ. НИКТО
Dialogue: 0,0:16:21.16,0:16:24.20,Caption,,0,0,0,,БРИТАНСКОГО ГОСТЯ НЕ ПРИНУЖДАЛ. ДЖОНСОН САМ ПРОСИЛ
Dialogue: 0,0:16:24.28,0:16:27.96,Caption,,0,0,0,,НАЛИВАТЬ ЕМУ СНОВА И СНОВА. ЗАТЕМ ПРИЕХАЛА ЛИЗ ТРАСС,
Dialogue: 0,0:16:28.19,0:16:31.48,Caption,,0,0,0,,И УРОВЕНЬ СЕРЬЁЗНОСТИ ОТНОШЕНИЙ ПОДНЯЛСЯ ЕЩЁ ВЫШЕ,
Dialogue: 0,0:16:31.72,0:16:35.32,Caption,,0,0,0,,ХОТЯ КАЗАЛОСЬ, ЧТО ДАЛЬШЕ УЖЕ НЕКУДА. ОДИН БЫВШИЙ БРИТАНСКИЙ
Dialogue: 0,0:16:35.32,0:16:37.24,Caption,,0,0,0,,РУКОВОДИТЕЛЬ СПУСТЯ ГОДЫ ЖАЛУЕТСЯ,
Dialogue: 0,0:16:37.48,0:16:40.28,Caption,,0,0,0,,ЧТО ЕГО ПОИЛИ. РОССИЙСКАЯ СТОРОНА ОТВЕЧАЕТ,
Dialogue: 0,0:16:40.51,0:16:42.52,Caption,,0,0,0,,ЧТО УДЕРЖИВАТЬ ЕГО КАК РАЗ НИКТО НЕ МОГ.
Dialogue: 0,0:16:43.03,0:16:45.80,Caption,,0,0,0,,ИМЕННО ТАКИЕ ЛЮДИ ДОЛГО ОБЪЯСНЯЛИ ВСЕЙ ЕВРОПЕ,
Dialogue: 0,0:16:46.11,0:16:49.48,Caption,,0,0,0,,КАК ПРАВИЛЬНО ВЫСТРАИВАТЬ ОТНОШЕНИЯ С МОСКВОЙ. ВОТ С
Dialogue: 0,0:16:49.48,0:16:52.60,Caption,,0,0,0,,ТАКИМИ ЧУДАКАМИ И ПРИХОДИТСЯ ИМЕТЬ ДЕЛО. НО ДВИЖЕНИЕ
Dialogue: 0,0:16:52.68,0:16:55.16,Caption,,0,0,0,,ВСЁ ЖЕ ЕСТЬ. РАНЬШЕ ЗА СТОЛОМ ВЫЯСНЯЛИ,
Dialogue: 0,0:16:55.40,0:16:58.04,Caption,,0,0,0,,КТО КОМУ НАЛИЛ. ТЕПЕРЬ НАКОНЕЦ ВСПОМНИЛИ,
Dialogue: 0,0:16:58.19,0:17:00.44,Caption,,0,0,0,,ЧТО ЗА НИМ ИНОГДА ЕЩЁ И ДОГОВАРИВАЮТСЯ.
