Dialogue: 0,0:00:00.11,0:00:02.44,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СНОВА ДЕМОНСТРИРУЕТ УДИВИТЕЛЬНУЮ
Dialogue: 0,0:00:02.44,0:00:05.24,Caption,,0,0,0,,УВЕРЕННОСТЬ И ПУБЛИЧНО ЗАДЕВАЕТ ДОНАЛЬДА ТРАМПА,
Dialogue: 0,0:00:05.54,0:00:08.12,Caption,,0,0,0,,ХОТЯ ПРЕДЫДУЩИЙ ТАКОЙ СЛУЧАЙ ЗАКОНЧИЛСЯ ДЛЯ КИЕВА
Dialogue: 0,0:00:08.12,0:00:10.84,Caption,,0,0,0,,ПЛОХО. ТЕПЕРЬ УКРАИНСКИЙ ПРЕЗИДЕНТ ВЫСТУПИЛ В
Dialogue: 0,0:00:10.84,0:00:15.48,Caption,,0,0,0,,ДАТСКОМ ПАРЛАМЕНТЕ, ПРОШЁЛСЯ ПО АМЕРИКАНСКИМ ПРЕТЕНЗИЯМ НА ГРЕНЛАНДИЮ И
Dialogue: 0,0:00:15.56,0:00:18.44,Caption,,0,0,0,,ЯВНО РАССЧИТЫВАЛ ПОРАДОВАТЬ ЕВРОПЕЙСКИЙ ЗАЛ. ЭТА
Dialogue: 0,0:00:18.44,0:00:20.52,Caption,,0,0,0,,КОЛКОСТЬ ВЫЗЫВАЕТ ВОПРОСЫ С ЧЕГО,
Dialogue: 0,0:00:20.66,0:00:22.68,Caption,,0,0,0,,СОБСТВЕННО, ЗЕЛЕНСКИЙ СЧИТАЕТ,
Dialogue: 0,0:00:23.00,0:00:25.64,Caption,,0,0,0,,ЧТО ПРЕЖНИЕ ПОСЛЕДСТВИЯ МОЖНО СПИСАТЬ И НОВЫЕ
Dialogue: 0,0:00:25.64,0:00:27.48,Caption,,0,0,0,,ЗАЯВЛЕНИЯ ОСТАНУТСЯ БЕЗ ОТВЕТА?
Dialogue: 0,0:00:27.73,0:00:33.00,Caption,,0,0,0,,ОДНАКО, ВИДИМО, ОН УВЕРЕН, ЧТО ПОЛИТИКА ВАШИНГТОНА НЕ ЗАВИСИТ ОТ НАСТРОЕНИЯ
Dialogue: 0,0:00:33.08,0:00:38.97,Caption,,0,0,0,,ОДНОГО ЧЕЛОВЕКА. ЗЕЛЕНСКИЙ ЗАДЕЛ ТРАМПА С ТОЙ САМОУВЕРЕННОЙ УЛЫБКОЙ,
Dialogue: 0,0:00:39.16,0:00:41.53,Caption,,0,0,0,,КОТОРАЯ ОЗНАЧАЕТ ЗАЛ СЕЙЧАС ЗАСМЕЁТСЯ,
Dialogue: 0,0:00:41.77,0:00:44.57,Caption,,0,0,0,,А ОСТАЛЬНОЕ КАК НИБУДЬ УЛАДИТСЯ. НО ТРАМП НЕ
Dialogue: 0,0:00:44.65,0:00:47.05,Caption,,0,0,0,,ДАТСКИЙ ДЕПУТАТ, А ПРЕЗИДЕНТ ГОСУДАРСТВА,
Dialogue: 0,0:00:47.22,0:00:49.61,Caption,,0,0,0,,ОТ КОТОРОГО ЗАВИСЯТ ОРУЖИЕ, СВЯЗЬ,
Dialogue: 0,0:00:49.69,0:00:53.37,Caption,,0,0,0,,ДЕНЬГИ И МЕСТО КИЕВА ЗА СТОЛОМ ПЕРЕГОВОРОВ. СТАРЫЕ
Dialogue: 0,0:00:53.45,0:00:55.29,Caption,,0,0,0,,ОБИДЫ ОН ТОЖЕ ЗАБЫВАЕТ НЕОХОТНО.
Dialogue: 0,0:00:57.56,0:01:00.60,Caption,,0,0,0,,АМЕРИКАНСКАЯ РЕАКЦИЯ ПОСЛЕДОВАЛА БЫСТРО. КОНГРЕССМЕН
Dialogue: 0,0:01:00.60,0:01:03.40,Caption,,0,0,0,,ГРЕГ СТЬЮБЕ ОТВЕТИЛ ЗЕЛЕНСКОМУ ПРЕДЕЛЬНО РЕЗКО.
Dialogue: 0,0:01:03.75,0:01:08.12,Caption,,0,0,0,,ЗАТЕМ ЮРИЙ УШАКОВ СООБЩИЛ, ЧТО ВО ВРЕМЯ РАЗГОВОРА ВЛАДИМИРА ПУТИНА СО СТИВОМ
Dialogue: 0,0:01:08.20,0:01:11.24,Caption,,0,0,0,,УИТКОФФОМ И ДЖАРЕДОМ КУШНЕРОМ ОБСУЖДАЛИСЬ ПОВЕДЕНИЕ
Dialogue: 0,0:01:11.24,0:01:14.04,Caption,,0,0,0,,ЗЕЛЕНСКОГО И ЕГО НАСМЕШЛИВЫЕ "ПРИВЕТЫ" ТРАМПУ.
Dialogue: 0,0:01:14.36,0:01:16.76,Caption,,0,0,0,,РЕПЛИКА ПРЕДНАЗНАЧАЛАСЬ ЕВРОПЕЙСКОМУ ЗАЛУ,
Dialogue: 0,0:01:17.01,0:01:21.08,Caption,,0,0,0,,А ОБСУЖДАТЬ ЕЁ СТАЛИ ЛЮДИ, ЗАНЯТЫЕ ВАРИАНТАМИ ЗАВЕРШЕНИЯ КОНФЛИКТА.
Dialogue: 0,0:01:23.37,0:01:25.77,Caption,,0,0,0,,ВНИМАНИЕ ЗЕЛЕНСКИЙ ПОЛУЧИЛ СРАЗУ В НЕСКОЛЬКИХ
Dialogue: 0,0:01:25.77,0:01:27.93,Caption,,0,0,0,,СТОЛИЦАХ. ТЕПЕРЬ ОСТАЛОСЬ УЗНАТЬ,
Dialogue: 0,0:01:28.15,0:01:30.65,Caption,,0,0,0,,ЧТО ПРИЛОЖАТ К ЭТОМУ ВНИМАНИЮ НЕДОВОЛЬСТВО,
Dialogue: 0,0:01:30.89,0:01:33.05,Caption,,0,0,0,,НОВОЕ УСЛОВИЕ ИЛИ ПРЕДЛОЖЕНИЕ,
Dialogue: 0,0:01:33.37,0:01:36.01,Caption,,0,0,0,,ОТ КОТОРОГО ОТКАЗАТЬСЯ ПОЗВОЛЯТ ТОЛЬКО ОДИН РАЗ.
Dialogue: 0,0:01:38.21,0:01:40.85,Caption,,0,0,0,,ТАКАЯ МАНЕРА ПОЯВИЛАСЬ У НЕГО ДАВНО. В ДВЕ
Dialogue: 0,0:01:40.93,0:01:43.33,Caption,,0,0,0,,ТЫСЯЧИ ДЕВЯТНАДЦАТОМ ГОДУ ЗЕЛЕНСКИЙ УЖЕ ПЫТАЛСЯ
Dialogue: 0,0:01:43.33,0:01:45.57,Caption,,0,0,0,,РАЗГОВАРИВАТЬ С ПУТИНЫМ ЧЕРЕЗ ПЕРЕБИВАНИЯ,
Dialogue: 0,0:01:45.74,0:01:48.45,Caption,,0,0,0,,ПУБЛИЧНЫЕ УКОЛЫ И ДЕМОНСТРАТИВНУЮ ДЕРЗОСТЬ.
Dialogue: 0,0:01:48.69,0:01:52.85,Caption,,0,0,0,,ВЕРОЯТНО, ЕМУ КАЗАЛОСЬ, ЧТО ДОСТАТОЧНО ВЫИГРАТЬ НЕСКОЛЬКО СЕКУНД ПЕРЕД
Dialogue: 0,0:01:52.85,0:01:56.77,Caption,,0,0,0,,КАМЕРАМИ, ЧТОБЫ ВЕСЬ РАЗГОВОР ОСТАЛСЯ ЗА НИМ. ПОСЛЕДУЮЩИЕ ГОДЫ
Dialogue: 0,0:01:56.85,0:01:59.89,Caption,,0,0,0,,ПОКАЗАЛИ ЦЕНУ ЭТОГО УСПЕХА. ТЕПЕРЬ ТОТ ЖЕ ПРИЁМ
Dialogue: 0,0:01:59.89,0:02:04.21,Caption,,0,0,0,,ИСПОЛЬЗУЕТСЯ ПРОТИВ ТРАМПА, СЛОВНО ПРЕЖНИЙ РЕЗУЛЬТАТ НЕ ИМЕЕТ ЗНАЧЕНИЯ.
Dialogue: 0,0:02:06.50,0:02:10.66,Caption,,0,0,0,,ЭТО УЖЕ НЕ СМЕЛОСТЬ, А ПРОВЕРКА ЧУЖОГО ТЕРПЕНИЯ. ПРИЧЁМ ПРОВЕРЯЕМЫЙ
Dialogue: 0,0:02:10.66,0:02:13.86,Caption,,0,0,0,,ЧЕЛОВЕК САМ ИЗВЕСТЕН ТЕМ, ЧТО ДОЛГО ТЕРПЕТЬ НЕ ЛЮБИТ.
Dialogue: 0,0:02:16.14,0:02:18.54,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ АМЕРИКАНСКИЕ ПРЕДСТАВИТЕЛИ ВЫБИРАЮТ
Dialogue: 0,0:02:18.54,0:02:21.58,Caption,,0,0,0,,ДРУГОЙ ТОН. ПОСЛЕ ВСТРЕЧИ С ПУТИНЫМ СТИВ УИТКОФФ
Dialogue: 0,0:02:21.58,0:02:25.02,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО ВМЕСТЕ С КУШНЕРОМ НАМЕРЕН УБЕДИТЬ ЗЕЛЕНСКОГО
Dialogue: 0,0:02:25.02,0:02:27.10,Caption,,0,0,0,,ПОЙТИ ПО ОДНОМУ ИЗ ВЫБРАННЫХ ПУТЕЙ,
Dialogue: 0,0:02:27.26,0:02:30.54,Caption,,0,0,0,,ВЕДУЩИХ К ЗАВЕРШЕНИЮ КОНФЛИКТА. КИЕВУ НЕ ПРЕДЛАГАЮТ
Dialogue: 0,0:02:30.62,0:02:33.26,Caption,,0,0,0,,ПРИДУМАТЬ СОБСТВЕННЫЙ ВАРИАНТ. ЕМУ СООБЩАЮТ,
Dialogue: 0,0:02:33.42,0:02:35.90,Caption,,0,0,0,,ЧТО ВАРИАНТЫ УЖЕ ОТОБРАНЫ И ОСТАЛОСЬ ПРОЯВИТЬ
Dialogue: 0,0:02:35.90,0:02:40.81,Caption,,0,0,0,,РАЗУМНОСТЬ. МОЖНО ПРЕДСТАВИТЬ ДОЛГУЮ БЕСЕДУ,
Dialogue: 0,0:02:41.05,0:02:43.93,Caption,,0,0,0,,ПОИСК КОМПРОМИССА И ДОБРОВОЛЬНУЮ ПОДПИСЬ ЗЕЛЕНСКОГО
Dialogue: 0,0:02:43.93,0:02:46.97,Caption,,0,0,0,,ПОД СОГЛАШЕНИЕМ. НО В БОЛЬШОЙ ПОЛИТИКЕ УБЕЖДЕНИЕ
Dialogue: 0,0:02:46.97,0:02:51.45,Caption,,0,0,0,,ОБЫЧНО СТАНОВИТСЯ СЕРЬЁЗНЫМ, КОГДА ЛАСКОВЫХ СЛОВ ОКАЗЫВАЕТСЯ НЕДОСТАТОЧНО.
Dialogue: 0,0:02:53.73,0:02:55.65,Caption,,0,0,0,,ЗЕЛЕНСКИЙ НЕОДНОКРАТНО ПОКАЗЫВАЛ,
Dialogue: 0,0:02:55.89,0:02:57.97,Caption,,0,0,0,,ЧТО УСТУПАТЬ ДОБРОВОЛЬНО НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:02:58.27,0:03:01.41,Caption,,0,0,0,,СЛЕДОВАТЕЛЬНО, АМЕРИКАНЦЫ ПРИВЕЗУТ НЕ ТОЛЬКО СОВЕТЫ,
Dialogue: 0,0:03:01.65,0:03:04.77,Caption,,0,0,0,,НО И ПЕРЕЧЕНЬ КОНКРЕТНЫХ РЕШЕНИЙ. ВАШИНГТОН МОЖЕТ
Dialogue: 0,0:03:04.77,0:03:10.45,Caption,,0,0,0,,ВЛИЯТЬ НА ПОСТАВКИ, СВЯЗЬ, ФИНАНСИРОВАНИЕ И РЕШЕНИЯ КОНГРЕССА. ОТКАЗ КИЕВА В
Dialogue: 0,0:03:10.53,0:03:12.53,Caption,,0,0,0,,КАЖДОМ СЛУЧАЕ БУДЕТ ИМЕТЬ ПОСЛЕДСТВИЯ.
Dialogue: 0,0:03:14.81,0:03:17.37,Caption,,0,0,0,,ПОДПИШИСЬ, ЕСЛИ ТАКИЕ РАЗБОРЫ ТЕБЕ НУЖНЫ.
Dialogue: 0,0:03:19.64,0:03:22.28,Caption,,0,0,0,,КОРРУПЦИОННЫЕ ИСТОРИИ ВОКРУГ УКРАИНСКОЙ ВЛАСТИ ТОЖЕ
Dialogue: 0,0:03:22.28,0:03:25.64,Caption,,0,0,0,,НИКУДА НЕ ИСЧЕЗЛИ. НАБУ ПРОДОЛЖАЕТ РАБОТУ. ИМЯ
Dialogue: 0,0:03:25.72,0:03:28.52,Caption,,0,0,0,,МИНДИЧА ДАВНО ЗВУЧИТ ВО ВНУТРЕННИХ РАЗБОРКАХ. НЕ
Dialogue: 0,0:03:28.52,0:03:31.40,Caption,,0,0,0,,ЗАБЫТЫ И ЗАКУПОЧНЫЕ СКАНДАЛЫ МИНИСТЕРСТВА ОБОРОНЫ,
Dialogue: 0,0:03:31.56,0:03:33.64,Caption,,0,0,0,,ВКЛЮЧАЯ ИСТОРИЮ С ЯЙЦАМИ ПО ЦЕНЕ,
Dialogue: 0,0:03:33.87,0:03:36.20,Caption,,0,0,0,,ВЫЗЫВАВШЕЙ ВОПРОСЫ ДАЖЕ У ПРИВЫЧНОЙ КО ВСЕМУ
Dialogue: 0,0:03:36.20,0:03:42.96,Caption,,0,0,0,,УКРАИНСКОЙ ПУБЛИКИ. СТОИМОСТЬ ЯИЦ ЗДЕСЬ ВТОРИЧНА. ВАЖНЕЕ ЧИСЛО УЯЗВИМЫХ
Dialogue: 0,0:03:43.04,0:03:46.16,Caption,,0,0,0,,МЕСТ У КИЕВСКОЙ КОМАНДЫ. ЕСЛИ ОДНО РАССЛЕДОВАНИЕ НЕ
Dialogue: 0,0:03:46.16,0:03:51.20,Caption,,0,0,0,,ПРОИЗВЕДЁТ ВПЕЧАТЛЕНИЯ, РЯДОМ НАЙДЁТСЯ ДРУГОЕ. ВАШИНГТОН ЗНАЕТ ОБ ЭТИХ ДЕЛАХ
Dialogue: 0,0:03:51.28,0:03:53.44,Caption,,0,0,0,,И ПРИ НЕОБХОДИМОСТИ МОЖЕТ НАПОМНИТЬ О НИХ В
Dialogue: 0,0:03:53.44,0:03:59.72,Caption,,0,0,0,,САМЫЙ НЕУДОБНЫЙ МОМЕНТ. ЕСТЬ ЕЩЁ ЗАВИСИМОСТЬ ОТ АМЕРИКАНСКИХ ТЕХНОЛОГИЙ.
Dialogue: 0,0:03:59.88,0:04:02.76,Caption,,0,0,0,,УКРАИНА СООБЩИЛА ОБ ОГРАНИЧЕНИЯХ СКОРОСТИ STARSHIELD
Dialogue: 0,0:04:02.84,0:04:04.60,Caption,,0,0,0,,ВОЗЛЕ ЛИНИИ ФРОНТА И НА ТЕРРИТОРИЯХ,
Dialogue: 0,0:04:04.84,0:04:07.64,Caption,,0,0,0,,КОНТРОЛИРУЕМЫХ РОССИЕЙ. ЗЕЛЕНСКИЙ ПРИЗНАЛ,
Dialogue: 0,0:04:07.80,0:04:10.36,Caption,,0,0,0,,ЧТО ЭТО МЕШАЕТ РАБОТЕ УКРАИНСКИХ ПЕРЕХВАТЧИКОВ.
Dialogue: 0,0:04:10.75,0:04:13.32,Caption,,0,0,0,,УКРАИНА ИСПОЛЬЗУЕТ СИСТЕМУ И НЕСЁТ ПОСЛЕДСТВИЯ
Dialogue: 0,0:04:13.32,0:04:16.52,Caption,,0,0,0,,ОГРАНИЧЕНИЙ, НО НАСТРОЙКИ МЕНЯЮТ ДАЛЕКО ЗА ОКЕАНОМ.
Dialogue: 0,0:04:18.78,0:04:21.34,Caption,,0,0,0,,ТАК ВЫГЛЯДИТ РЕАЛЬНОЕ СООТНОШЕНИЕ ВОЗМОЖНОСТЕЙ.
Dialogue: 0,0:04:21.65,0:04:24.06,Caption,,0,0,0,,ЗЕЛЕНСКИЙ РАСПОЛАГАЕТ МИКРОФОНОМ И КОЛКИМИ
Dialogue: 0,0:04:24.06,0:04:27.18,Caption,,0,0,0,,РЕПЛИКАМИ. АМЕРИКАНСКАЯ СТОРОНА КОНТРОЛИРУЕТ ВАЖНУЮ
Dialogue: 0,0:04:27.18,0:04:31.10,Caption,,0,0,0,,СВЯЗЬ, ПОСТАВКИ И УСЛОВИЯ ДАЛЬНЕЙШЕЙ ПОДДЕРЖКИ. ФОРМАЛЬНО
Dialogue: 0,0:04:31.10,0:04:34.54,Caption,,0,0,0,,ЭТО ПЕРЕГОВОРЫ, НО ВОЗМОЖНОСТИ СТОРОН ЯВНО НЕРАВНЫ.
Dialogue: 0,0:04:36.83,0:04:39.56,Caption,,0,0,0,,И ВСЁ ЖЕ УКРАИНСКИЙ ПРЕЗИДЕНТ ДЕРЖИТСЯ ВЫЗЫВАЮЩЕ.
Dialogue: 0,0:04:39.86,0:04:44.68,Caption,,0,0,0,,ЗНАЧИТ, У НЕГО ЕСТЬ РАСЧЁТ, ПОЗВОЛЯЮЩИЙ СЧИТАТЬ АМЕРИКАНСКОЕ ДАВЛЕНИЕ ВРЕМЕННЫМ.
Dialogue: 0,0:04:46.94,0:04:49.58,Caption,,0,0,0,,ОСНОВАНИЕ ДЛЯ ТАКОГО РАСЧЁТА ПОЯВИЛОСЬ. НА
Dialogue: 0,0:04:49.58,0:04:52.22,Caption,,0,0,0,,ПРОМЕЖУТОЧНЫХ ВЫБОРАХ ДЕМОКРАТЫ ПОЛУЧИЛИ БОЛЬШИНСТВО
Dialogue: 0,0:04:52.22,0:04:56.86,Caption,,0,0,0,,И В ПАЛАТЕ ПРЕДСТАВИТЕЛЕЙ, И В СЕНАТЕ. ОБНОВЛЁННЫЙ КОНГРЕСС НАЧНЁТ РАБОТУ В
Dialogue: 0,0:04:56.86,0:04:59.50,Caption,,0,0,0,,ЯНВАРЕ. ЗЕЛЕНСКИЙ МОЖЕТ ВОСПРИНИМАТЬ ЭТО КАК
Dialogue: 0,0:04:59.50,0:05:02.38,Caption,,0,0,0,,ПРИБЛИЖАЮЩУЮСЯ ПОМОЩЬ ПЕРЕЖИТЬ ОСТАВШЕЕСЯ ВРЕМЯ,
Dialogue: 0,0:05:02.70,0:05:05.42,Caption,,0,0,0,,НЕ СОГЛАСИТЬСЯ НА УСЛОВИЯ ТРАМПА И ДОЖДАТЬСЯ,
Dialogue: 0,0:05:05.63,0:05:07.90,Caption,,0,0,0,,КОГДА ВНУТРЕННЯЯ БОРЬБА В СОЕДИНЁННЫХ ШТАТАХ
Dialogue: 0,0:05:07.95,0:05:14.18,Caption,,0,0,0,,ОСЛОЖНИТ РАБОТУ БЕЛОГО ДОМА. ЗАМЫСЕЛ ПОНЯТЕН ПРОДЕРЖАТЬСЯ ДО ЯНВАРЯ И
Dialogue: 0,0:05:14.26,0:05:16.66,Caption,,0,0,0,,РАССЧИТЫВАТЬ НА ДЕМОКРАТОВ. ПРОБЛЕМА В ТОМ,
Dialogue: 0,0:05:16.90,0:05:19.62,Caption,,0,0,0,,ЧТО ДО ЯНВАРЯ БЕЛЫЙ ДОМ СПОСОБЕН ПРИНЯТЬ МНОЖЕСТВО
Dialogue: 0,0:05:19.62,0:05:22.66,Caption,,0,0,0,,РЕШЕНИЙ. ПРЕЗИДЕНТСКИЕ ПОЛНОМОЧИЯ СОХРАНЯЮТСЯ,
Dialogue: 0,0:05:23.06,0:05:25.38,Caption,,0,0,0,,ЛЮДИ ТРАМПА ПРОДОЛЖАЮТ КОНТАКТЫ С МОСКВОЙ,
Dialogue: 0,0:05:25.62,0:05:28.42,Caption,,0,0,0,,А ВОЕННАЯ И ТЕХНОЛОГИЧЕСКАЯ ЗАВИСИМОСТЬ КИЕВА НИКУДА
Dialogue: 0,0:05:28.42,0:05:31.38,Caption,,0,0,0,,НЕ ИСЧЕЗЛА. ПОКА ЗЕЛЕНСКИЙ СЧИТАЕТ НЕДЕЛИ,
Dialogue: 0,0:05:31.62,0:05:34.02,Caption,,0,0,0,,ВАШИНГТОН МОЖЕТ ОЦЕНИВАТЬ ДРУГИХ КАНДИДАТОВ.
Dialogue: 0,0:05:36.29,0:05:38.93,Caption,,0,0,0,,И ЗДЕСЬ РЯДОМ С ГРОМКИМИ ЗАЯВЛЕНИЯМИ УКРАИНСКОГО
Dialogue: 0,0:05:39.01,0:05:43.41,Caption,,0,0,0,,ПРЕЗИДЕНТА ПОЯВЛЯЕТСЯ ФИГУРА, КОТОРУЮ ЕЩЁ НЕДАВНО ПОЧТИ НИКТО НЕ ВКЛЮЧАЛ В
Dialogue: 0,0:05:43.49,0:05:45.65,Caption,,0,0,0,,ПОДОБНЫЕ РАСЧЁТЫ ДМИТРИЙ ЛУБИНЕЦ.
Dialogue: 0,0:05:47.84,0:05:51.84,Caption,,0,0,0,,НЕ ВАЛЕРИЙ ЗАЛУЖНЫЙ, ДАВНО ПОЛУЧИВШИЙ РЕПУТАЦИЮ ВОЗМОЖНОГО СОПЕРНИКА
Dialogue: 0,0:05:51.84,0:05:54.00,Caption,,0,0,0,,ЗЕЛЕНСКОГО. НЕ КИРИЛЛ БУДАНОВ,
Dialogue: 0,0:05:54.15,0:05:57.20,Caption,,0,0,0,,СВЯЗАННЫЙ СО СПЕЦСЛУЖБАМИ. НЕ ДАВИД АРАХАМИЯ,
Dialogue: 0,0:05:57.35,0:06:00.40,Caption,,0,0,0,,СЛИШКОМ ТЕСНО ОТНОСЯЩИЙСЯ К НЫНЕШНЕЙ ВЛАСТИ. НА
Dialogue: 0,0:06:00.40,0:06:02.80,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ УРОВЕНЬ ВЫВОДЯТ ОМБУДСМЕНА,
Dialogue: 0,0:06:02.96,0:06:04.80,Caption,,0,0,0,,ЧЬЯ РАБОТА СВЯЗАНА С ПЛЕННЫМИ,
Dialogue: 0,0:06:04.88,0:06:08.88,Caption,,0,0,0,,ДЕТЬМИ, ОБМЕНАМИ, ВОЗВРАЩЕНИЕМ ЛЮДЕЙ И ЗАЩИТОЙ ИХ ПРАВ.
Dialogue: 0,0:06:11.16,0:06:13.72,Caption,,0,0,0,,НА ФОНЕ УКРАИНСКИХ ТЯЖЕЛОВЕСОВ ЛУБИНЕЦ ЗАМЕТНО
Dialogue: 0,0:06:13.72,0:06:19.48,Caption,,0,0,0,,ОТЛИЧАЕТСЯ. ЗАЛУЖНЫЙ, БУДАНОВ И АРАХАМИЯ НЕПОСРЕДСТВЕННО СВЯЗАНЫ С АРМИЕЙ,
Dialogue: 0,0:06:19.56,0:06:22.20,Caption,,0,0,0,,СИЛОВЫМИ СТРУКТУРАМИ ИЛИ РУКОВОДСТВОМ СТРАНЫ.
Dialogue: 0,0:06:22.58,0:06:27.16,Caption,,0,0,0,,ЛУБИНЕЦ ГОВОРИТ О ЛЮДЯХ, КОТОРЫХ НУЖНО ВЕРНУТЬ ДОМОЙ. ИМЕННО ЭТА РАЗНИЦА
Dialogue: 0,0:06:27.16,0:06:30.68,Caption,,0,0,0,,ДЕЛАЕТ ЕГО УДОБНЫМ ДЛЯ ТЕХ, КТО ХОЧЕТ ПОКАЗАТЬ СМЕНУ КУРСА.
Dialogue: 0,0:06:32.87,0:06:35.75,Caption,,0,0,0,,ПЯТОГО НОЯБРЯ МЕЛАНИЯ ТРАМП ВСТРЕТИЛАСЬ В БЕЛОМ ДОМЕ
Dialogue: 0,0:06:35.75,0:06:37.91,Caption,,0,0,0,,С ПРЕДСТАВИТЕЛЯМИ РОССИИ И УКРАИНЫ ПОСЛЕ
Dialogue: 0,0:06:37.99,0:06:40.47,Caption,,0,0,0,,ГУМАНИТАРНОЙ МИССИИ. ОТ УКРАИНСКОЙ СТОРОНЫ
Dialogue: 0,0:06:40.47,0:06:43.91,Caption,,0,0,0,,ПРИСУТСТВОВАЛИ АРАХАМИЯ И ЛУБИНЕЦ. ОДНАКО ОТДЕЛЬНЫЕ
Dialogue: 0,0:06:43.91,0:06:46.87,Caption,,0,0,0,,СЛОВА БЛАГОДАРНОСТИ ПЕРВАЯ ЛЕДИ АДРЕСОВАЛА ИМЕННО
Dialogue: 0,0:06:46.87,0:06:49.59,Caption,,0,0,0,,ЛУБИНЦУ, ОТМЕТИВ ЕГО МУЖЕСТВО И СЕРДЦЕ,
Dialogue: 0,0:06:49.83,0:06:56.34,Caption,,0,0,0,,С КОТОРЫМ ОН СЛУЖИТ ЛЮДЯМ. ЛУБИНЕЦ НЕ СВЯЗАН В ГЛАЗАХ ПУБЛИКИ С НАСТУПЛЕНИЕМ,
Dialogue: 0,0:06:56.42,0:07:00.10,Caption,,0,0,0,,МОБИЛИЗАЦИЕЙ ИЛИ РАБОТОЙ СПЕЦСЛУЖБ. ЕГО ТЕМЫ ДРУГИЕ
Dialogue: 0,0:07:00.18,0:07:02.74,Caption,,0,0,0,,ОБМЕН ПЛЕННЫМИ, ВОЗВРАЩЕНИЕ ДЕТЕЙ,
Dialogue: 0,0:07:02.90,0:07:06.10,Caption,,0,0,0,,ПОМОЩЬ ЛЮДЯМ И ГУМАНИТАРНЫЕ ДОГОВОРЁННОСТИ. ПОСЛЕ
Dialogue: 0,0:07:06.10,0:07:08.66,Caption,,0,0,0,,НЕСКОЛЬКИХ ЛЕТ ТРЕБОВАНИЙ ПРОДОЛЖАТЬ БОРЬБУ ТАКОЙ
Dialogue: 0,0:07:08.74,0:07:11.06,Caption,,0,0,0,,ЧЕЛОВЕК ПОЗВОЛЯЕТ ГОВОРИТЬ О ПЕРЕХОДЕ К РЕШЕНИЮ
Dialogue: 0,0:07:11.06,0:07:17.26,Caption,,0,0,0,,ПОСЛЕДСТВИЙ КОНФЛИКТА. ЗАЛУЖНЫЙ СЛИШКОМ ТЕСНО СВЯЗАН С АРМИЕЙ И ВСЕМ
Dialogue: 0,0:07:17.26,0:07:20.14,Caption,,0,0,0,,ПЕРИОДОМ БОЕВЫХ ДЕЙСТВИЙ. БУДАНОВ ОТВЕЧАЕТ ЗА
Dialogue: 0,0:07:20.14,0:07:23.42,Caption,,0,0,0,,РАЗВЕДКУ И СИЛОВЫЕ ОПЕРАЦИИ. АРАХАМИЯ ПРИНАДЛЕЖИТ
Dialogue: 0,0:07:23.42,0:07:25.50,Caption,,0,0,0,,ДЕЙСТВУЮЩЕЙ СИСТЕМЕ НАСТОЛЬКО ЯВНО,
Dialogue: 0,0:07:25.73,0:07:28.38,Caption,,0,0,0,,ЧТО ПРЕДСТАВИТЬ ЕГО НАЧАЛОМ НОВОГО ЭТАПА БУДЕТ
Dialogue: 0,0:07:28.38,0:07:33.85,Caption,,0,0,0,,ТРУДНО. ДЛЯ ПЕРЕХОДНОГО ПЕРИОДА ЭТО ПОЧТИ ИДЕАЛЬНАЯ РОЛЬ.
Dialogue: 0,0:07:36.11,0:07:39.87,Caption,,0,0,0,,ЭТО НЕ ОЗНАЧАЕТ, ЧТО ЛУБИНЕЦ ДОЛЖЕН САМ ВЕСТИ ТОРГ ПО ТЕРРИТОРИЯМ,
Dialogue: 0,0:07:40.03,0:07:43.23,Caption,,0,0,0,,ГАРАНТИЯМ И САНКЦИЯМ. ДЛЯ ТАКИХ ПЕРЕГОВОРОВ НАЙДУТСЯ
Dialogue: 0,0:07:43.23,0:07:47.63,Caption,,0,0,0,,СПЕЦИАЛИСТЫ, СПОСОБНЫЕ СПОРИТЬ О КАЖДОЙ ФОРМУЛИРОВКЕ. ОМБУДСМЕН
Dialogue: 0,0:07:47.63,0:07:50.11,Caption,,0,0,0,,МОЖЕТ ПОНАДОБИТЬСЯ ДЛЯ ДРУГОГО ЧЕРЕЗ НЕГО СМЕНУ
Dialogue: 0,0:07:50.19,0:07:52.67,Caption,,0,0,0,,КУРСА ПРОЩЕ ОБЪЯСНИТЬ НАСЕЛЕНИЮ И ВНЕШНИМ
Dialogue: 0,0:07:52.67,0:07:58.32,Caption,,0,0,0,,УЧАСТНИКАМ. МОСКВА МНОГО ЛЕТ ГОВОРИТ О "ДЕНАЦИФИКАЦИИ" И
Dialogue: 0,0:07:58.32,0:08:01.28,Caption,,0,0,0,,НЕОБХОДИМОСТИ ИЗМЕНИТЬ УКРАИНСКИЙ КУРС. ОДНОГО
Dialogue: 0,0:08:01.28,0:08:03.68,Caption,,0,0,0,,СОГЛАШЕНИЯ ДЛЯ ДЕМОНСТРАЦИИ ТАКОГО ПОВОРОТА
Dialogue: 0,0:08:03.68,0:08:06.32,Caption,,0,0,0,,НЕДОСТАТОЧНО. НУЖЕН НОВЫЙ РУКОВОДИТЕЛЬ,
Dialogue: 0,0:08:06.56,0:08:08.88,Caption,,0,0,0,,КОТОРЫЙ НЕ СВЯЗАН В ГЛАЗАХ ПУБЛИКИ С ПРЕЖНЕЙ
Dialogue: 0,0:08:08.88,0:08:14.43,Caption,,0,0,0,,ВОЕННОЙ ЛИНИЕЙ. ПОЭТОМУ ЕГО ПОЯВЛЕНИЕ В БЕЛОМ ДОМЕ ОСОБЕННО
Dialogue: 0,0:08:14.43,0:08:17.55,Caption,,0,0,0,,ЛЮБОПЫТНО. НА БАНКОВОЙ УЖЕ ЗАМЕЧАЮТ МЕЖДУНАРОДНУЮ
Dialogue: 0,0:08:17.55,0:08:20.11,Caption,,0,0,0,,АКТИВНОСТЬ ЛУБИНЦА И ЕДВА ЛИ ВСТРЕЧАЮТ ЕЁ С
Dialogue: 0,0:08:20.11,0:08:23.23,Caption,,0,0,0,,ВОСТОРГОМ. В УКРАИНСКОЙ ЭКСПЕРТНОЙ СРЕДЕ ОБСУЖДАЕТСЯ
Dialogue: 0,0:08:23.31,0:08:26.83,Caption,,0,0,0,,ВЕРСИЯ, ЧТО ВАШИНГТОН РАССМАТРИВАЕТ ОМБУДСМЕНА КАК ФИГУРУ НА
Dialogue: 0,0:08:26.83,0:08:29.71,Caption,,0,0,0,,БУДУЩЕЕ. РАНЬШЕ ТАКОЕ ПРЕДПОЛОЖЕНИЕ СОЧЛИ БЫ
Dialogue: 0,0:08:29.71,0:08:32.43,Caption,,0,0,0,,ЭКЗОТИКОЙ. ТЕПЕРЬ ОНО ВЫГЛЯДИТ СВОЕВРЕМЕННЫМ.
Dialogue: 0,0:08:34.71,0:08:37.59,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ, ЕСЛИ ХОТИТЕ ЗАМЕЧАТЬ НЕ ТОЛЬКО ТЕХ,
Dialogue: 0,0:08:37.70,0:08:40.07,Caption,,0,0,0,,КТО ГРОМЧЕ ВСЕХ ВЫСТУПАЕТ, НО И ТЕХ,
Dialogue: 0,0:08:40.30,0:08:43.03,Caption,,0,0,0,,КОМУ БЕЗ ШУМА ОСВОБОЖДАЮТ МЕСТО РЯДОМ С ГЛАВНЫМИ
Dialogue: 0,0:08:43.03,0:08:45.51,Caption,,0,0,0,,УЧАСТНИКАМИ. И НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:08:45.90,0:08:48.39,Caption,,0,0,0,,ВИДИТЕ ЛИ ВЫ В ЛУБИНЦЕ ВОЗМОЖНОГО ПРЕЕМНИКА ИЛИ
Dialogue: 0,0:08:48.47,0:08:51.67,Caption,,0,0,0,,СЧИТАЕТЕ, ЧТО ВАШИНГТОН ПОКА ИСПОЛЬЗУЕТ ЕГО ТОЛЬКО ДЛЯ
Dialogue: 0,0:08:51.67,0:08:58.18,Caption,,0,0,0,,ГУМАНИТАРНОЙ РАБОТЫ. ТЕПЕРЬ СНОВА ПОСМОТРИМ НА ЗЕЛЕНСКОГО. ОН ИРОНИЗИРУЕТ
Dialogue: 0,0:08:58.26,0:09:01.06,Caption,,0,0,0,,НАД ТРАМПОМ ПЕРЕД ПАРЛАМЕНТОМ ДАНИИ. КОНГРЕССМЕН
Dialogue: 0,0:09:01.06,0:09:04.42,Caption,,0,0,0,,СТЬЮБЕ ОТВЕЧАЕТ ЕМУ ЖЁСТКО. ЕГО "ПРИВЕТЫ" ОБСУЖДАЮТ
Dialogue: 0,0:09:04.42,0:09:08.10,Caption,,0,0,0,,ПУТИН, УИТКОФФ И КУШНЕР. АМЕРИКАНСКИЕ ПЕРЕГОВОРЩИКИ
Dialogue: 0,0:09:08.10,0:09:10.42,Caption,,0,0,0,,СОБИРАЮТСЯ УБЕЖДАТЬ КИЕВ ПРИНЯТЬ ОДИН ИЗ УЖЕ
Dialogue: 0,0:09:10.42,0:09:13.22,Caption,,0,0,0,,ВЫБРАННЫХ ВАРИАНТОВ. ОДНОВРЕМЕННО МЕЛАНИЯ ТРАМП
Dialogue: 0,0:09:13.22,0:09:16.18,Caption,,0,0,0,,ПУБЛИЧНО ВЫДЕЛЯЕТ ЛУБИНЦА И ПОМОГАЕТ ЕМУ ВЫЙТИ НА
Dialogue: 0,0:09:16.18,0:09:22.22,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ УРОВЕНЬ. ЗЕЛЕНСКИЙ РАССЧИТЫВАЕТ ВЫДЕРЖАТЬ ДАВЛЕНИЕ ДО ЯНВАРЯ
Dialogue: 0,0:09:22.22,0:09:24.86,Caption,,0,0,0,,И ПОЛУЧИТЬ ПОДДЕРЖКУ ДЕМОКРАТИЧЕСКОГО БОЛЬШИНСТВА.
Dialogue: 0,0:09:25.34,0:09:29.34,Caption,,0,0,0,,НО РЯДОМ УЖЕ ЕСТЬ ЧЕЛОВЕК, КОТОРОГО НЕ ТРЕБУЕТСЯ ПРЕВРАЩАТЬ В СТОРОННИКА
Dialogue: 0,0:09:29.34,0:09:32.22,Caption,,0,0,0,,МИРНОГО ПЕРЕХОДА. ЭТО СЛЕДУЕТ ИЗ ЕГО ДОЛЖНОСТИ И
Dialogue: 0,0:09:32.22,0:09:35.26,Caption,,0,0,0,,ПРЕЖНЕЙ РАБОТЫ. ОН ГОВОРИТ НЕ О ПОБЕДНЫХ ПЛАНАХ,
Dialogue: 0,0:09:35.58,0:09:38.38,Caption,,0,0,0,,А О ВОЗВРАЩЕНИИ ЛЮДЕЙ И ЗАНИМАЕТСЯ ПОСЛЕДСТВИЯМИ
Dialogue: 0,0:09:38.38,0:09:43.85,Caption,,0,0,0,,КОНФЛИКТА. ОТСЮДА ВОЗНИКАЕТ ГЛАВНЫЙ ВОПРОС ДЕЙСТВИТЕЛЬНО ЛИ
Dialogue: 0,0:09:43.85,0:09:46.57,Caption,,0,0,0,,ВАШИНГТОНУ НЕОБХОДИМО ДОБИВАТЬСЯ СОГЛАСИЯ ИМЕННО
Dialogue: 0,0:09:46.57,0:09:52.53,Caption,,0,0,0,,ЗЕЛЕНСКОГО? ПЕРЕГОВОРЫ МОГУТ ПРОДОЛЖАТЬСЯ ДОЛГО. СТОРОНЫ БУДУТ
Dialogue: 0,0:09:52.53,0:09:54.93,Caption,,0,0,0,,СПОРИТЬ О ТЕРРИТОРИЯХ, БЕЗОПАСНОСТИ,
Dialogue: 0,0:09:55.02,0:09:59.57,Caption,,0,0,0,,САНКЦИЯХ, ГАРАНТИЯХ И ПОРЯДКЕ ИСПОЛНЕНИЯ СОГЛАШЕНИЯ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:09:59.57,0:10:02.45,Caption,,0,0,0,,СПОСОБЕН ОТВЕРГАТЬ ФОРМУЛИРОВКИ И ТРЕБОВАТЬ НОВЫХ
Dialogue: 0,0:10:02.45,0:10:05.41,Caption,,0,0,0,,УСЛОВИЙ. НО ЕСЛИ СОЕДИНЁННЫМ ШТАТАМ ПОТРЕБУЕТСЯ
Dialogue: 0,0:10:05.49,0:10:09.57,Caption,,0,0,0,,ЗАВЕРШИТЬ ПРЕЖНИЙ КУРС, СДЕЛАТЬ ЭТО ЧЕРЕЗ ДРУГОГО ЧЕЛОВЕКА МОЖЕТ ОКАЗАТЬСЯ
Dialogue: 0,0:10:09.57,0:10:12.37,Caption,,0,0,0,,ПРОЩЕ, ЧЕМ МЕСЯЦАМИ ПЕРЕУБЕЖДАТЬ ЗЕЛЕНСКОГО.
Dialogue: 0,0:10:14.65,0:10:17.29,Caption,,0,0,0,,ТОГДА СЕГОДНЯШНЯЯ БРАВАДА БУДЕТ ВЫГЛЯДЕТЬ СОВСЕМ НЕ
Dialogue: 0,0:10:17.29,0:10:20.57,Caption,,0,0,0,,ТАК, КАК РАССЧИТЫВАЕТ КИЕВ. ЗЕЛЕНСКОМУ КАЖЕТСЯ,
Dialogue: 0,0:10:20.73,0:10:24.17,Caption,,0,0,0,,ЧТО ОН СОПРОТИВЛЯЕТСЯ ДАВЛЕНИЮ И ВЫИГРЫВАЕТ ВРЕМЯ. В
Dialogue: 0,0:10:24.17,0:10:27.93,Caption,,0,0,0,,ВАШИНГТОНЕ МОГУТ РЕШИТЬ, ЧТО ОСТАВШЕЕСЯ ВРЕМЯ НУЖНО ИСПОЛЬЗОВАТЬ ДЛЯ
Dialogue: 0,0:10:27.93,0:10:30.73,Caption,,0,0,0,,ПОДГОТОВКИ ПРЕЕМНИКА. ОДИН ЧЕЛОВЕК СПОРИТ О
Dialogue: 0,0:10:30.73,0:10:32.41,Caption,,0,0,0,,СОДЕРЖАНИИ БУДУЩЕГО ДОКУМЕНТА,
Dialogue: 0,0:10:32.66,0:10:35.29,Caption,,0,0,0,,ПОКА ДРУГОГО ЗНАКОМЯТ С ВНЕШНИМИ УЧАСТНИКАМИ И
Dialogue: 0,0:10:35.29,0:10:41.90,Caption,,0,0,0,,ГОТОВЯТ К РЕШАЮЩЕМУ МОМЕНТУ. АМЕРИКАНЦАМ ПРИ ЭТОМ НЕ НУЖЕН НОВЫЙ ПОЛКОВОДЕЦ ИЛИ
Dialogue: 0,0:10:41.90,0:10:46.70,Caption,,0,0,0,,ЕЩЁ ОДИН РУКОВОДИТЕЛЬ, ОБЕЩАЮЩИЙ ПРОДОЛЖИТЬ ПРЕЖНИЙ КУРС. ТАКАЯ КАНДИДАТУРА
Dialogue: 0,0:10:46.78,0:10:49.90,Caption,,0,0,0,,ЛИШЬ ВЫЗОВЕТ НОВЫЕ СПОРЫ. ИМ УДОБНЕЕ СПОКОЙНЫЙ
Dialogue: 0,0:10:49.90,0:10:52.86,Caption,,0,0,0,,ОМБУДСМЕН, КОТОРОГО МОЖНО ПРЕДСТАВИТЬ КАК СТОРОННИКА
Dialogue: 0,0:10:52.86,0:10:56.86,Caption,,0,0,0,,ПРИМИРЕНИЯ, ВОЗВРАЩЕНИЯ ПЛЕННЫХ И ВОССТАНОВЛЕНИЯ НОРМАЛЬНОЙ
Dialogue: 0,0:10:56.94,0:11:02.25,Caption,,0,0,0,,ЖИЗНИ. ТАКОЙ ЧЕЛОВЕК УЖЕ ПОЯВИЛСЯ В БЕЛОМ ДОМЕ. ЕГО
Dialogue: 0,0:11:02.33,0:11:05.13,Caption,,0,0,0,,ОТДЕЛЬНО ОТМЕТИЛА МЕЛАНИЯ ТРАМП. ЕГО ИМЯ СТАЛО
Dialogue: 0,0:11:05.13,0:11:09.85,Caption,,0,0,0,,ЗВУЧАТЬ СРЕДИ ТЕХ, КТО ОБСУЖДАЕТ БУДУЩЕЕ УКРАИНЫ. И ЧЕМ ЧАЩЕ ЗЕЛЕНСКИЙ
Dialogue: 0,0:11:09.85,0:11:12.25,Caption,,0,0,0,,ИСПЫТЫВАЕТ ТЕРПЕНИЕ АМЕРИКАНСКОГО ПРЕЗИДЕНТА,
Dialogue: 0,0:11:12.50,0:11:15.05,Caption,,0,0,0,,ТЕМ СЕРЬЁЗНЕЕ ВЫГЛЯДИТ ЭТОТ ЗАПАСНОЙ ВАРИАНТ.
Dialogue: 0,0:11:17.32,0:11:20.20,Caption,,0,0,0,,ПОЭТОМУ ЗНАЧЕНИЕ ИМЕЕТ УЖЕ НЕ ТОЛЬКО ЛИЧНАЯ РЕАКЦИЯ
Dialogue: 0,0:11:20.28,0:11:23.32,Caption,,0,0,0,,ТРАМПА НА КОЛКОСТИ ИЗ КОПЕНГАГЕНА. ЕГО НЕДОВОЛЬСТВО
Dialogue: 0,0:11:23.32,0:11:26.68,Caption,,0,0,0,,НЕПРИЯТНО ДЛЯ ЗЕЛЕНСКОГО, НО ГОРАЗДО ОПАСНЕЕ МОМЕНТ,
Dialogue: 0,0:11:26.98,0:11:29.24,Caption,,0,0,0,,КОГДА В ВАШИНГТОНЕ ПЕРЕСТАНУТ ПЫТАТЬСЯ ЕГО
Dialogue: 0,0:11:29.24,0:11:31.80,Caption,,0,0,0,,ПЕРЕУБЕЖДАТЬ И РЕШАТ ЗАМЕНИТЬ ТОГО,
Dialogue: 0,0:11:31.96,0:11:38.48,Caption,,0,0,0,,КТО ДОЛЖЕН ПОСТАВИТЬ ПОДПИСЬ. ТОГДА ЗЕЛЕНСКИЙ СМОЖЕТ НАЗЫВАТЬ ПРЕДЛОЖЕННЫЕ УСЛОВИЯ
Dialogue: 0,0:11:38.48,0:11:43.04,Caption,,0,0,0,,КАПИТУЛЯЦИЕЙ, ПРЕДАТЕЛЬСТВОМ ИЛИ ЧУЖИМ СЦЕНАРИЕМ. ЕГО МНЕНИЕ
Dialogue: 0,0:11:43.12,0:11:46.00,Caption,,0,0,0,,ОСТАНЕТСЯ ГРОМКИМ, НО ПЕРЕСТАНЕТ БЫТЬ РЕШАЮЩИМ.
Dialogue: 0,0:11:48.27,0:11:50.35,Caption,,0,0,0,,А ДОКУМЕНТ ПЕРЕДАДУТ ДМИТРИЮ ЛУБИНЦУ,
Dialogue: 0,0:11:50.59,0:11:52.59,Caption,,0,0,0,,ЧЕЛОВЕКУ С ГУМАНИТАРНОЙ БИОГРАФИЕЙ,
Dialogue: 0,0:11:52.76,0:11:55.79,Caption,,0,0,0,,БЛАГОДАРНОСТЬЮ ОТ МЕЛАНИИ ТРАМП И ГОРАЗДО МЕНЬШЕЙ
Dialogue: 0,0:11:55.79,0:11:59.71,Caption,,0,0,0,,ПОТРЕБНОСТЬЮ ШУТИТЬ НАД ТЕМИ, КТО ОПРЕДЕЛЯЕТ УСЛОВИЯ СОГЛАШЕНИЯ.
