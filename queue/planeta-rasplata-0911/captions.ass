Dialogue: 0,0:00:00.12,0:00:03.16,Caption,,0,0,0,,СЧЁТ ВСЁ ТАКИ ПРИНЕСЛИ. ПОКА ЕВРОПЕЙСКИЕ НАЧАЛЬНИКИ
Dialogue: 0,0:00:03.24,0:00:05.80,Caption,,0,0,0,,ПРОИЗНОСИЛИ РЕЧИ О ПРАВИЛЬНОМ КУРСЕ И ПРОСИЛИ
Dialogue: 0,0:00:05.88,0:00:07.64,Caption,,0,0,0,,ГРАЖДАН ПОТЕРПЕТЬ ЕЩЁ НЕМНОГО,
Dialogue: 0,0:00:07.95,0:00:10.68,Caption,,0,0,0,,ОФИЦИАНТ УЖЕ ПОСТАВИЛ ПАПКУ НА СТОЛ. ВНУТРИ
Dialogue: 0,0:00:10.68,0:00:13.32,Caption,,0,0,0,,ОТОПЛЕНИЕ, ПЕНСИИ, ЖИЛЬЁ,
Dialogue: 0,0:00:13.56,0:00:17.40,Caption,,0,0,0,,РЕЙТИНГИ, ПОТЕРЯННЫЕ АКТИВЫ И ОЧЕНЬ КРУПНАЯ СУММА ЗА
Dialogue: 0,0:00:17.40,0:00:20.12,Caption,,0,0,0,,ПОЛИТИЧЕСКИЕ РЕШЕНИЯ. САМОЕ ЗАБАВНОЕ,
Dialogue: 0,0:00:20.28,0:00:24.52,Caption,,0,0,0,,ЧТО ЗАКАЗЫВАЛИ ОДНИ, А КОШЕЛЁК ПОЧЕМУ ТО ИЩУТ У ДРУГИХ. ПАРТНЁРЫ
Dialogue: 0,0:00:24.52,0:00:27.32,Caption,,0,0,0,,ПО ЕВРАЗИЙСКОМУ ЭКОНОМИЧЕСКОМУ СОЮЗУ РАССЧИТАЛИ
Dialogue: 0,0:00:27.32,0:00:30.36,Caption,,0,0,0,,ВОЗМОЖНЫЕ ПОСЛЕДСТВИЯ АРМЯНСКОГО ВЫХОДА. СОГЛАСНО
Dialogue: 0,0:00:30.36,0:00:33.88,Caption,,0,0,0,,ЭТИМ РАСЧЁТАМ, ГАЗ ДЛЯ СТРАНЫ МОЖЕТ ПОДОРОЖАТЬ ПРИМЕРНО НА
Dialogue: 0,0:00:33.88,0:00:36.92,Caption,,0,0,0,,ШЕСТЬДЕСЯТ ДЕВЯТЬ ПРОЦЕНТОВ. В ТЯЖЁЛОМ СЦЕНАРИИ
Dialogue: 0,0:00:37.21,0:00:40.04,Caption,,0,0,0,,ВАЛОВОЙ ВНУТРЕННИЙ ПРОДУКТ ПОТЕРЯЕТ ПЯТНАДЦАТЬ ЦЕЛЫХ
Dialogue: 0,0:00:40.12,0:00:43.32,Caption,,0,0,0,,ШЕСТЬ ДЕСЯТЫХ ПРОЦЕНТА. БОЛЬШЕ ПЯТНАДЦАТИ ПРОЦЕНТОВ
Dialogue: 0,0:00:43.32,0:00:46.28,Caption,,0,0,0,,ЭКОНОМИКИ НЕЛЬЗЯ СПРЯТАТЬ В ПРИМЕЧАНИИ МЕЛКИМ
Dialogue: 0,0:00:46.28,0:00:48.84,Caption,,0,0,0,,ШРИФТОМ. ТАКОЙ КУСОК ЗАМЕТИТ ДАЖЕ ЧЕЛОВЕК,
Dialogue: 0,0:00:49.08,0:00:51.80,Caption,,0,0,0,,КОТОРЫЙ ВООБЩЕ НЕ ИНТЕРЕСУЕТСЯ ПОЛИТИКОЙ. ДОСТАТОЧНО
Dialogue: 0,0:00:51.80,0:00:54.68,Caption,,0,0,0,,ОТКРЫТЬ КОШЕЛЁК. НИКОЛ ПАШИНЯН С РАСЧЁТАМИ НЕ
Dialogue: 0,0:00:54.68,0:00:57.80,Caption,,0,0,0,,СОГЛАСИЛСЯ. МОЖНО ПРЕДСТАВИТЬ ДРУГУЮ МЕТОДИКУ,
Dialogue: 0,0:00:58.04,0:01:02.44,Caption,,0,0,0,,ЗАКАЗАТЬ НОВЫЙ ДОКЛАД, НАРИСОВАТЬ БОЛЕЕ БОДРЫЙ ГРАФИК И ПОСТАВИТЬ ЗЕЛЁНУЮ
Dialogue: 0,0:01:02.44,0:01:06.84,Caption,,0,0,0,,СТРЕЛКУ ВВЕРХ. ГРАФИКИ ВООБЩЕ ОЧЕНЬ ВОСПИТАННЫЕ. ОНИ РАСТУТ ТУДА,
Dialogue: 0,0:01:07.00,0:01:10.28,Caption,,0,0,0,,КУДА ПОПРОСИТ ЗАКАЗЧИК. ОДНАКО ВЫБОР АРМЕНИИ ОТ
Dialogue: 0,0:01:10.28,0:01:16.32,Caption,,0,0,0,,ЭТОГО НЕ ИСЧЕЗАЕТ. ПАШИНЯН ГОВОРИЛ О ВОЗМОЖНОЙ ЗАЯВКЕ НА ВСТУПЛЕНИЕ В
Dialogue: 0,0:01:16.32,0:01:18.96,Caption,,0,0,0,,ЕВРОСОЮЗ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ИЛИ ДВЕ
Dialogue: 0,0:01:19.04,0:01:21.92,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМ ГОДУ. ПРИ ЭТОМ ОН ПРИЗНАЁТ,
Dialogue: 0,0:01:22.16,0:01:25.36,Caption,,0,0,0,,ЧТО ОДНОВРЕМЕННОЕ ЧЛЕНСТВО В ЕВРОСОЮЗЕ И ЕВРАЗИЙСКОМ
Dialogue: 0,0:01:25.44,0:01:28.72,Caption,,0,0,0,,ЭКОНОМИЧЕСКОМ СОЮЗЕ НЕВОЗМОЖНО. В КАКОЙ ТО МОМЕНТ
Dialogue: 0,0:01:28.80,0:01:31.76,Caption,,0,0,0,,АРМЕНИИ ПРИДЁТСЯ ВЫБРАТЬ ОДНУ СИСТЕМУ. И ЗДЕСЬ
Dialogue: 0,0:01:31.84,0:01:33.76,Caption,,0,0,0,,ХОЧЕТСЯ СПРОСИТЬ НИКОЛ ВОВАЕВИЧА,
Dialogue: 0,0:01:34.00,0:01:37.60,Caption,,0,0,0,,ВИДЕЛ ЛИ ОН ОЧЕРЕДЬ У ЕВРОПЕЙСКОЙ ДВЕРИ. ТУРЦИЯ
Dialogue: 0,0:01:37.60,0:01:40.40,Caption,,0,0,0,,ПОДАЛА ЗАЯВКУ В ЕВРОПЕЙСКОЕ СООБЩЕСТВО ЕЩЁ В ТЫСЯЧА
Dialogue: 0,0:01:40.48,0:01:42.96,Caption,,0,0,0,,ДЕВЯТЬСОТ ВОСЕМЬДЕСЯТ СЕДЬМОМ ГОДУ. В ТЫСЯЧА
Dialogue: 0,0:01:43.04,0:01:45.28,Caption,,0,0,0,,ДЕВЯТЬСОТ ДЕВЯНОСТО ДЕВЯТОМ ОНА ПОЛУЧИЛА СТАТУС
Dialogue: 0,0:01:45.28,0:01:48.08,Caption,,0,0,0,,КАНДИДАТА. ПЕРЕГОВОРЫ О ВСТУПЛЕНИИ НАЧАЛИСЬ В ДВЕ
Dialogue: 0,0:01:48.16,0:01:51.36,Caption,,0,0,0,,ТЫСЯЧИ ПЯТОМ ГОДУ. СЕЙЧАС ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОЙ
Dialogue: 0,0:01:51.44,0:01:54.48,Caption,,0,0,0,,ГОД, А ТУРЦИЯ ВСЁ ЕЩЁ ЖДЁТ. ЗА ЭТО ВРЕМЯ
Dialogue: 0,0:01:54.48,0:01:57.12,Caption,,0,0,0,,ЧЕЛОВЕК УСПЕЛ БЫ РОДИТЬСЯ, ОКОНЧИТЬ ШКОЛУ,
Dialogue: 0,0:01:57.28,0:01:59.76,Caption,,0,0,0,,ПОЛУЧИТЬ ПРОФЕССИЮ, СОЗДАТЬ СЕМЬЮ,
Dialogue: 0,0:02:00.00,0:02:02.48,Caption,,0,0,0,,ВЫРАСТИТЬ ДЕТЕЙ И НАЧАТЬ ОБЪЯСНЯТЬ ИМ,
Dialogue: 0,0:02:02.72,0:02:06.00,Caption,,0,0,0,,ЧТО ЕВРОПЕЙСКАЯ ОЧЕРЕДЬ ДВИЖЕТСЯ. ПРОСТО ЕЁ ДВИЖЕНИЕ
Dialogue: 0,0:02:06.08,0:02:09.20,Caption,,0,0,0,,НАДО ИЗМЕРЯТЬ НЕ ГОДАМИ, А ГЕОЛОГИЧЕСКИМИ ЭПОХАМИ.
Dialogue: 0,0:02:09.91,0:02:12.80,Caption,,0,0,0,,ВОЗЛЕ АРМЕНИИ НАХОДИТСЯ ГРУЗИЯ. У НЕЁ ТОЖЕ БЫЛ
Dialogue: 0,0:02:12.80,0:02:15.92,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ МАРШРУТ. ЗАТЕМ ОТНОШЕНИЯ С БРЮССЕЛЕМ
Dialogue: 0,0:02:16.00,0:02:19.44,Caption,,0,0,0,,РЕЗКО ИСПОРТИЛИСЬ, СТОРОНЫ ПЕРЕШЛИ К ВЗАИМНЫМ ОБВИНЕНИЯМ,
Dialogue: 0,0:02:19.71,0:02:22.96,Caption,,0,0,0,,А ДВИЖЕНИЕ ФАКТИЧЕСКИ ОСТАНОВИЛОСЬ. ЕСТЬ И УКРАИНА,
Dialogue: 0,0:02:23.20,0:02:28.16,Caption,,0,0,0,,КОТОРАЯ НАГЛЯДНО ПОКАЗАЛА, ЧТО СЛОВО "ЕВРОИНТЕГРАЦИЯ" НЕ ЯВЛЯЕТСЯ ВОЛШЕБНОЙ
Dialogue: 0,0:02:28.16,0:02:31.80,Caption,,0,0,0,,КНОПКОЙ. НАЖАЛ СЕГОДНЯ,
Dialogue: 0,0:02:32.16,0:02:34.52,Caption,,0,0,0,,А ЗАВТРА ПРОСНУЛСЯ В НОВОЙ ЖИЗНИ С ЕВРОПЕЙСКОЙ
Dialogue: 0,0:02:34.52,0:02:38.76,Caption,,0,0,0,,ЗАРПЛАТОЙ, ДЕШЁВЫМ ГАЗОМ И КЛЮЧАМИ ОТ КВАРТИРЫ. ТАКОЙ КНОПКИ
Dialogue: 0,0:02:38.84,0:02:40.93,Caption,,0,0,0,,В КОМПЛЕКТЕ НЕ ВЫДАЮТ. ЗНАЧИТ,
Dialogue: 0,0:02:41.08,0:02:43.72,Caption,,0,0,0,,ОН ПОНИМАЕТ РИСКИ И ВСЁ РАВНО ПРОДОЛЖАЕТ КУРС.
Dialogue: 0,0:02:44.07,0:02:46.92,Caption,,0,0,0,,ПОЧЕМУ ПОЛИТИЧЕСКОЕ РУКОВОДСТВО ГОТОВО ПРИНЯТЬ
Dialogue: 0,0:02:46.93,0:02:49.88,Caption,,0,0,0,,ОГРОМНУЮ ЦЕНУ УЖЕ СЕЙЧАС РАДИ РЕЗУЛЬТАТА,
Dialogue: 0,0:02:50.20,0:02:52.12,Caption,,0,0,0,,У КОТОРОГО НЕТ НИ ТОЧНОГО СРОКА,
Dialogue: 0,0:02:52.29,0:02:55.64,Caption,,0,0,0,,НИ ГАРАНТИИ? КАКАЯ ПРИЧИНА ЗАСТАВЛЯЕТ ИДТИ ПО МАРШРУТУ,
Dialogue: 0,0:02:55.88,0:02:58.60,Caption,,0,0,0,,КОГДА ПРЕДУПРЕЖДАЮЩИЕ ЗНАКИ СТОЯТ ЧЕРЕЗ КАЖДЫЕ СТО
Dialogue: 0,0:02:58.60,0:03:02.44,Caption,,0,0,0,,МЕТРОВ? И ЕЩЁ ВАЖНЕЕ ДРУГОЕ. ПАШИНЯН ПРИНИМАЕТ ЭТО РЕШЕНИЕ
Dialogue: 0,0:03:02.44,0:03:05.88,Caption,,0,0,0,,САМОСТОЯТЕЛЬНО ИЛИ НА ВЫБОР АРМЕНИИ ВЛИЯЕТ СИЛА,
Dialogue: 0,0:03:06.04,0:03:07.72,Caption,,0,0,0,,КОТОРУЮ ГРАЖДАНАМ НЕ ПОКАЗЫВАЮТ?
Dialogue: 0,0:03:08.17,0:03:10.44,Caption,,0,0,0,,ОТВЕТ НАДО ИСКАТЬ НЕ В ПРАЗДНИЧНЫХ СЛОВАХ О
Dialogue: 0,0:03:10.44,0:03:13.56,Caption,,0,0,0,,ЕВРОПЕЙСКОМ БУДУЩЕМ. КРАСИВОЕ БУДУЩЕЕ ВООБЩЕ УДОБНЫЙ
Dialogue: 0,0:03:13.56,0:03:15.96,Caption,,0,0,0,,ТОВАР. ЕГО МОЖНО ОБЕЩАТЬ СКОЛЬКО УГОДНО,
Dialogue: 0,0:03:16.20,0:03:18.60,Caption,,0,0,0,,ПОТОМУ ЧТО СКЛАД ДЛЯ НЕГО НЕ НУЖЕН. ИСКАТЬ
Dialogue: 0,0:03:18.68,0:03:22.60,Caption,,0,0,0,,СЛЕДУЕТ ПРИЧИНУ, ПО КОТОРОЙ ВЛАСТЬ ГОТОВА ПОСТАВИТЬ ПОД РИСК ГАЗ,
Dialogue: 0,0:03:22.69,0:03:26.12,Caption,,0,0,0,,ТОРГОВЛЮ И ОГРОМНУЮ ДОЛЮ ЭКОНОМИКИ РАДИ ОБЕЩАНИЯ,
Dialogue: 0,0:03:26.28,0:03:29.40,Caption,,0,0,0,,КОТОРОЕ НЕ ВЫДАЁТСЯ ПО РАСПИСАНИЮ. ПОДПИСЫВАЙТЕСЬ,
Dialogue: 0,0:03:29.55,0:03:32.44,Caption,,0,0,0,,ЕСЛИ ВАМ НУЖНЫ ТАКИЕ РАЗБОРЫ БЕЗ ДИПЛОМАТИЧЕСКОГО
Dialogue: 0,0:03:32.44,0:03:34.52,Caption,,0,0,0,,СИРОПА. ЗДЕСЬ ПРОВЕРЯЮТ СЧЕТА,
Dialogue: 0,0:03:34.77,0:03:37.08,Caption,,0,0,0,,КОТОРЫЕ ПОЛИТИКИ ПРЕДПОЧИТАЮТ ПОДАВАТЬ БЕЗ
Dialogue: 0,0:03:37.08,0:03:39.88,Caption,,0,0,0,,РАСШИФРОВКИ. ЕВРОПЕЙСКИЕ ГРАЖДАНЕ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:03:39.96,0:03:42.84,Caption,,0,0,0,,ПОЛУЧАЮТ СВОЙ СЧЁТ. МОЛОДОМУ ЧЕЛОВЕКУ ВСЁ ТРУДНЕЕ
Dialogue: 0,0:03:42.92,0:03:49.19,Caption,,0,0,0,,КУПИТЬ СОБСТВЕННОЕ ЖИЛЬЁ. КВАРТИРА ПРЕВРАЩАЕТСЯ ИЗ НОРМАЛЬНОЙ ЖИЗНЕННОЙ ЦЕЛИ В
Dialogue: 0,0:03:49.19,0:03:51.67,Caption,,0,0,0,,МУЗЕЙНЫЙ ЭКСПОНАТ. СМОТРЕТЬ МОЖНО,
Dialogue: 0,0:03:51.77,0:03:56.39,Caption,,0,0,0,,ТРОГАТЬ НЕЛЬЗЯ, ИПОТЕЧНЫЙ ПЛАТЁЖ ЛУЧШЕ НЕ ПУГАТЬ. ДЕСЯТКИ МИЛЛИОНОВ
Dialogue: 0,0:03:56.47,0:03:58.63,Caption,,0,0,0,,ЛЮДЕЙ СЧИТАЮТ РАСХОДЫ НА ЭЛЕКТРИЧЕСТВО,
Dialogue: 0,0:03:58.87,0:04:03.19,Caption,,0,0,0,,ОТОПЛЕНИЕ И ПРОДУКТЫ, ДНИ ДО ЗАРПЛАТЫ И КАКУЮ КОМНАТУ СЕГОДНЯ МОЖНО
Dialogue: 0,0:04:03.27,0:04:06.15,Caption,,0,0,0,,НЕ ГРЕТЬ. ПОКА ЕВРОПЕЙСКИЕ КАБИНЕТЫ СЧИТАЮТ
Dialogue: 0,0:04:06.15,0:04:10.31,Caption,,0,0,0,,МИЛЛИАРДЫ, ГРАЖДАНИН СЧИТАЕТ БАТАРЕИ. У КАЖДОГО СВОЯ БОЛЬШАЯ
Dialogue: 0,0:04:10.31,0:04:13.35,Caption,,0,0,0,,ПОЛИТИКА. В ГЕРМАНИИ ДЕПУТАТ БУНДЕСТАГА МАРКУС
Dialogue: 0,0:04:13.35,0:04:16.15,Caption,,0,0,0,,ФРОНМАЙЕР ИЗ АДГ ЗАДАЛ МИНИСТРУ ИНОСТРАННЫХ ДЕЛ
Dialogue: 0,0:04:16.15,0:04:20.55,Caption,,0,0,0,,ЙОХАННУ ВАДЕФУЛЮ ВОПРОС, КОТОРЫЙ МОГ БЫ ЗАДАТЬ ЛЮБОЙ ЧЕЛОВЕК ВОЗЛЕ ХОЛОДНОГО
Dialogue: 0,0:04:20.55,0:04:24.47,Caption,,0,0,0,,РАДИАТОРА. ГЕРМАНИЯ ВЫДЕЛЯЕТ ЕЩЁ ДВЕСТИ МИЛЛИОНОВ ЕВРО ТАК
Dialogue: 0,0:04:24.47,0:04:26.63,Caption,,0,0,0,,НАЗЫВАЕМОЙ ЗИМНЕЙ ПОМОЩИ ЗЕЛЕНСКОМУ,
Dialogue: 0,0:04:26.80,0:04:30.07,Caption,,0,0,0,,ПРИЕХАВШЕМУ В БЕРЛИН. А КОГДА ЗИМНЯЯ ПОМОЩЬ ПОЯВИТСЯ
Dialogue: 0,0:04:30.07,0:04:32.95,Caption,,0,0,0,,ДЛЯ ГРАЖДАН САМОЙ ГЕРМАНИИ? ФРОНМАЙЕР НАПОМНИЛ,
Dialogue: 0,0:04:33.19,0:04:36.15,Caption,,0,0,0,,ЧТО ДО ПЯТИ МИЛЛИОНОВ НЕМЦЕВ ЭТОЙ ЗИМОЙ СНОВА
Dialogue: 0,0:04:36.23,0:04:38.95,Caption,,0,0,0,,МОГУТ ЭКОНОМИТЬ НА ОТОПЛЕНИИ. ВОПРОС НЕ ТРЕБОВАЛ
Dialogue: 0,0:04:38.95,0:04:41.59,Caption,,0,0,0,,ЗАСЕДАНИЯ ФИЛОСОФСКОГО ОБЩЕСТВА. ЕСТЬ ЛЮДИ,
Dialogue: 0,0:04:41.71,0:04:44.63,Caption,,0,0,0,,КОТОРЫМ ХОЛОДНО. ЧТО СДЕЛАЕТ ДЛЯ НИХ ГОСУДАРСТВО?
Dialogue: 0,0:04:45.15,0:04:49.43,Caption,,0,0,0,,ВАДЕФУЛЬ ОТВЕТИЛ, ЧТО ФРОНМАЙЕР СЛИШКОМ УВЛЕКАЕТСЯ ВНЕШНЕЙ ПОЛИТИКОЙ В
Dialogue: 0,0:04:49.43,0:04:52.71,Caption,,0,0,0,,УЩЕРБ ИНТЕРЕСАМ ГЕРМАНИИ. А СОПОСТАВЛЕНИЕ ПОМОЩИ
Dialogue: 0,0:04:52.71,0:04:55.75,Caption,,0,0,0,,НЕМЦАМ С ПОМОЩЬЮ УКРАИНЕ МИНИСТР НАЗВАЛ ПОЧТИ
Dialogue: 0,0:04:55.75,0:04:58.47,Caption,,0,0,0,,ПОЩЁЧИНОЙ ЛЮДЯМ, СТРАДАЮЩИМ ОТ КОНФЛИКТА.
Dialogue: 0,0:05:00.73,0:05:03.38,Caption,,0,0,0,,ТО ЕСТЬ ДЕПУТАТ СПРОСИЛ ПРО НЕМЕЦКИЕ ДОМА,
Dialogue: 0,0:05:03.69,0:05:07.94,Caption,,0,0,0,,А ВЫЯСНИЛОСЬ, ЧТО ОН ПЛОХО ПОНИМАЕТ ИНТЕРЕСЫ ГЕРМАНИИ. ВИДИМО,
Dialogue: 0,0:05:08.27,0:05:10.66,Caption,,0,0,0,,ПРАВИЛЬНО ПОНИМАТЬ ЭТИ ИНТЕРЕСЫ МОЖНО ТОЛЬКО В
Dialogue: 0,0:05:10.74,0:05:13.54,Caption,,0,0,0,,ТЁПЛОМ КАБИНЕТЕ. ВОЗЛЕ ХОЛОДНОЙ БАТАРЕИ
Dialogue: 0,0:05:13.78,0:05:17.14,Caption,,0,0,0,,ГЕОПОЛИТИЧЕСКОЕ ЗРЕНИЕ ЗАМЕТНО ПОРТИТСЯ. КОГДА НЕМЕЦ
Dialogue: 0,0:05:17.14,0:05:20.42,Caption,,0,0,0,,СПРАШИВАЕТ, ПОЧЕМУ ЕМУ ПРИХОДИТСЯ ЭКОНОМИТЬ НА ТЕПЛЕ,
Dialogue: 0,0:05:20.72,0:05:23.30,Caption,,0,0,0,,ОН ВЕДЁТ СЕБЯ ПОДОЗРИТЕЛЬНО. КОГДА ПРАВИТЕЛЬСТВО
Dialogue: 0,0:05:23.30,0:05:25.86,Caption,,0,0,0,,ОТПРАВЛЯЕТ ОЧЕРЕДНУЮ СУММУ ЗА ПРЕДЕЛЫ СТРАНЫ,
Dialogue: 0,0:05:26.17,0:05:29.46,Caption,,0,0,0,,ОНО ПРОЯВЛЯЕТ ГОСУДАРСТВЕННУЮ МУДРОСТЬ. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:05:29.67,0:05:32.66,Caption,,0,0,0,,И К КАЖДОМУ РАДИАТОРУ ПРИСТАВЯТ ЧИНОВНИКА. ОН БУДЕТ
Dialogue: 0,0:05:32.66,0:05:36.26,Caption,,0,0,0,,СЛЕДИТЬ, ЧТОБЫ ГРАЖДАНИН МЁРЗ СОЛИДАРНО И БЕЗ НЕПРАВИЛЬНЫХ
Dialogue: 0,0:05:36.26,0:05:38.98,Caption,,0,0,0,,ВОПРОСОВ. ПРИ ЭТОМ ЕВРОПЕЙСКАЯ КОМИССИЯ ОБЪЯВЛЯЕТ
Dialogue: 0,0:05:38.98,0:05:42.18,Caption,,0,0,0,,НОВЫЙ ПАКЕТ ПОМОЩИ УКРАИНЕ НА ЧЕТЫРЕ МИЛЛИАРДА
Dialogue: 0,0:05:42.18,0:05:45.46,Caption,,0,0,0,,ТРИСТА ШЕСТЬДЕСЯТ МИЛЛИОНОВ ЕВРО. ГЕРМАНИЯ ОТДЕЛЬНО
Dialogue: 0,0:05:45.46,0:05:48.42,Caption,,0,0,0,,ВЫДЕЛЯЕТ ДВЕСТИ МИЛЛИОНОВ НА УКРАИНСКУЮ ЭНЕРГЕТИКУ.
Dialogue: 0,0:05:48.95,0:05:51.54,Caption,,0,0,0,,ОБЩИЙ ОБЪЁМ НЕМЕЦКОЙ ПОМОЩИ УКРАИНЕ С НАЧАЛА
Dialogue: 0,0:05:51.54,0:05:53.70,Caption,,0,0,0,,КОНФЛИКТА, ПО ПРИВЕДЁННОЙ ОЦЕНКЕ,
Dialogue: 0,0:05:53.92,0:05:57.38,Caption,,0,0,0,,ДОСТИГ ПРИМЕРНО СТА МИЛЛИАРДОВ ЕВРО. СТО МИЛЛИАРДОВ.
Dialogue: 0,0:05:57.77,0:06:02.50,Caption,,0,0,0,,ЧТОБЫ МАСШТАБ БЫЛ ПОНЯТНЕЕ, ЭТО СТО ТЫСЯЧ РАЗ ПО МИЛЛИОНУ ЕВРО. РЕЧЬ
Dialogue: 0,0:06:02.58,0:06:05.62,Caption,,0,0,0,,НЕ О ТОМ, ЧТОБЫ РАЗДЕЛИТЬ ВСЮ СУММУ НА КОНВЕРТЫ И РАЗДАТЬ
Dialogue: 0,0:06:05.62,0:06:09.22,Caption,,0,0,0,,НАСЕЛЕНИЮ. БЮДЖЕТ УСТРОЕН СЛОЖНЕЕ. НО ЕГО СЛОЖНОСТЬ
Dialogue: 0,0:06:09.30,0:06:11.86,Caption,,0,0,0,,ПОЧЕМУ ТО ЗАВИСИТ ОТ АДРЕСАТА. ДЛЯ БОЛЬШОЙ
Dialogue: 0,0:06:11.86,0:06:14.74,Caption,,0,0,0,,ПОЛИТИЧЕСКОЙ ЦЕЛИ МИЛЛИАРДЫ НАХОДЯТСЯ БЫСТРО.
Dialogue: 0,0:06:17.02,0:06:19.98,Caption,,0,0,0,,ДЛЯ НОВОГО ПАКЕТА ОТКРЫВАЕТСЯ НОВАЯ СТРОКА. ДЛЯ
Dialogue: 0,0:06:19.98,0:06:22.38,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНОЙ ПРОГРАММЫ ПОЯВЛЯЕТСЯ ОБОСНОВАНИЕ.
Dialogue: 0,0:06:22.93,0:06:24.86,Caption,,0,0,0,,ДЕНЬГИ ВЫХОДЯТ ИЗ КАБИНЕТА БОДРО,
Dialogue: 0,0:06:25.09,0:06:28.62,Caption,,0,0,0,,ПОЧТИ СТРОЕВЫМ ШАГОМ. КОГДА СОБСТВЕННЫЙ ГРАЖДАНИН СПРАШИВАЕТ ПРО
Dialogue: 0,0:06:28.70,0:06:32.54,Caption,,0,0,0,,ОТОПЛЕНИЕ, БЮДЖЕТ ПРЕВРАЩАЕТСЯ В ЗАГАДОЧНЫЙ ДРЕВНИЙ МАНУСКРИПТ.
Dialogue: 0,0:06:32.86,0:06:34.94,Caption,,0,0,0,,НАЧИНАЮТСЯ РАЗГОВОРЫ ОБ ОТВЕТСТВЕННОСТИ,
Dialogue: 0,0:06:35.11,0:06:38.22,Caption,,0,0,0,,ОГРАНИЧЕННЫХ ВОЗМОЖНОСТЯХ И НЕОБХОДИМОСТИ ПЕРЕЖИТЬ
Dialogue: 0,0:06:38.22,0:06:40.70,Caption,,0,0,0,,ТРУДНЫЙ ПЕРИОД. МИЛЛИАРДЫ ГОСУДАРСТВО ВИДИТ
Dialogue: 0,0:06:40.70,0:06:43.74,Caption,,0,0,0,,ПРЕКРАСНО. ЗАМЁРЗШЕГО ЧЕЛОВЕКА ОНО ЗАМЕЧАЕТ ХУЖЕ.
Dialogue: 0,0:06:44.25,0:06:47.26,Caption,,0,0,0,,ТЕПЕРЬ ЕВРОПЕЙСКИЕ ВЛАСТИ ДОБРАЛИСЬ И ДО ПЕНСИЙ. В
Dialogue: 0,0:06:47.26,0:06:49.58,Caption,,0,0,0,,ВЕЛИКОБРИТАНИИ ПРЕДЛАГАЮТ С ДВЕ ТЫСЯЧИ ТРИДЦАТОГО
Dialogue: 0,0:06:49.58,0:06:52.54,Caption,,0,0,0,,ГОДА ИЗМЕНИТЬ ПОРЯДОК ИНДЕКСАЦИИ И УБРАТЬ ИЗ НЕГО
Dialogue: 0,0:06:52.54,0:06:55.58,Caption,,0,0,0,,ПОКАЗАТЕЛЬ РОСТА ЗАРПЛАТ. РУМЫНИЯ ЗАМОРОЗИЛА
Dialogue: 0,0:06:55.58,0:06:58.78,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЕ ПЕНСИИ НА ДВА ГОДА. ЧЕХИЯ СОКРАТИЛА
Dialogue: 0,0:06:58.78,0:07:01.58,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНУЮ ИНДЕКСАЦИЮ. ВО ФРАНЦИИ ОБСУЖДАЛИ
Dialogue: 0,0:07:01.58,0:07:04.14,Caption,,0,0,0,,ОГРАНИЧЕНИЕ ИНДЕКСАЦИИ ДЛЯ ПЕНСИОНЕРОВ,
Dialogue: 0,0:07:04.18,0:07:07.18,Caption,,0,0,0,,ПОЛУЧАЮЩИХ ДО ТЫСЯЧИ ДВУХСОТ ШЕСТИДЕСЯТИ ЕВРО В
Dialogue: 0,0:07:07.18,0:07:11.42,Caption,,0,0,0,,МЕСЯЦ. В СЛОВАКИИ ХОТЯТ ЖЁСТЧЕ СВЯЗАТЬ ПЕНСИОННЫЙ ВОЗРАСТ С
Dialogue: 0,0:07:11.42,0:07:14.94,Caption,,0,0,0,,ОЖИДАЕМОЙ ПРОДОЛЖИТЕЛЬНОСТЬЮ ЖИЗНИ. НАЗВАНИЯ РАЗНЫЕ,
Dialogue: 0,0:07:15.10,0:07:18.38,Caption,,0,0,0,,МЕХАНИЗМ ОДИН. ГОСУДАРСТВО ОТКРЫВАЕТ КАЛЬКУЛЯТОР И
Dialogue: 0,0:07:18.46,0:07:20.54,Caption,,0,0,0,,СМОТРИТ, НЕЛЬЗЯ ЛИ СДЕЛАТЬ ТАК,
Dialogue: 0,0:07:20.70,0:07:23.66,Caption,,0,0,0,,ЧТОБЫ ЧЕЛОВЕК ЖИЛ ДОЛЬШЕ, РАБОТАЛ ДОЛЬШЕ,
Dialogue: 0,0:07:23.90,0:07:27.10,Caption,,0,0,0,,А ПОЛУЧАЛ КАК НИБУДЬ ПОКОРОЧЕ. ВСЮ ЖИЗНЬ ГРАЖДАНИНУ
Dialogue: 0,0:07:27.10,0:07:29.82,Caption,,0,0,0,,ОБЪЯСНЯЛИ ПОНЯТНУЮ СДЕЛКУ. ТЫ РАБОТАЕШЬ,
Dialogue: 0,0:07:29.98,0:07:32.14,Caption,,0,0,0,,ПЛАТИШЬ НАЛОГИ И ПОДДЕРЖИВАЕШЬ СИСТЕМУ.
Dialogue: 0,0:07:34.42,0:07:39.62,Caption,,0,0,0,,ПОТОМ СИСТЕМА ПОДДЕРЖИТ ТЕБЯ. ПОТОМ НАСТУПИЛО. СИСТЕМА ПРИШЛА С КАЛЬКУЛЯТОРОМ,
Dialogue: 0,0:07:39.85,0:07:44.42,Caption,,0,0,0,,ПРИСЕЛА РЯДОМ И СООБЩИЛА, ЧТО ВРЕМЕНА ИЗМЕНИЛИСЬ. ПЕНСИОНЕРУ ПРЕДЛОЖАТ
Dialogue: 0,0:07:44.42,0:07:47.78,Caption,,0,0,0,,ПРОЯВИТЬ ГИБКОСТЬ. В СЕМЬДЕСЯТ ЛЕТ САМОЕ ВРЕМЯ
Dialogue: 0,0:07:47.78,0:07:52.10,Caption,,0,0,0,,ОСВОИТЬ НОВУЮ ПРОФЕССИЮ, ЗАПУСТИТЬ СТАРТАП И ПЕРЕСТАТЬ ЗАВИСЕТЬ ОТ
Dialogue: 0,0:07:52.10,0:07:56.74,Caption,,0,0,0,,ГОСУДАРСТВА. ГЛАВНОЕ, НЕ ЗАБЫТЬ ПОСТАВИТЬ БУДИЛЬНИК НА УТРЕННЮЮ СМЕНУ.
Dialogue: 0,0:07:56.98,0:08:00.10,Caption,,0,0,0,,ОБЪЯВЛЕНИЕ О РАБОТЕ УЖЕ МОЖНО ПИСАТЬ. ТРЕБУЕТСЯ
Dialogue: 0,0:08:00.10,0:08:03.06,Caption,,0,0,0,,СОТРУДНИК СТАРШЕ СЕМИДЕСЯТИ ЛЕТ. ОПЫТ НЕ МЕНЕЕ
Dialogue: 0,0:08:03.14,0:08:06.02,Caption,,0,0,0,,СОРОКА ПЯТИ ЛЕТ. ЖЕЛАТЕЛЬНЫ КРЕПКОЕ ЗДОРОВЬЕ,
Dialogue: 0,0:08:06.24,0:08:09.14,Caption,,0,0,0,,ОТСУТСТВИЕ ПРЕТЕНЗИЙ И СПОСОБНОСТЬ СПОКОЙНО СЛУШАТЬ
Dialogue: 0,0:08:09.14,0:08:13.94,Caption,,0,0,0,,ЛЕКЦИИ О ДЕФИЦИТЕ БЮДЖЕТА. ПЕНСИЯ ПРЕДОСТАВЛЯЕТСЯ В ВИДЕ ДОБРОГО ПОЖЕЛАНИЯ.
Dialogue: 0,0:08:14.17,0:08:17.54,Caption,,0,0,0,,ПЕНСИОНЕР ДЛЯ ТАКОЙ ЭКОНОМИИ УДОБНЕЕ ВСЕХ. МОЛОДОЙ
Dialogue: 0,0:08:17.54,0:08:20.10,Caption,,0,0,0,,ЧЕЛОВЕК МОЖЕТ УЕХАТЬ, СМЕНИТЬ РАБОТУ,
Dialogue: 0,0:08:20.19,0:08:22.90,Caption,,0,0,0,,НАЙТИ ДОПОЛНИТЕЛЬНЫЙ ДОХОД ИЛИ НАЧАТЬ ЗАНОВО.
Dialogue: 0,0:08:23.11,0:08:25.94,Caption,,0,0,0,,ЧЕЛОВЕК ПРЕКЛОННОГО ВОЗРАСТА НЕ СОБЕРЁТ ЧЕМОДАН ТАК
Dialogue: 0,0:08:26.02,0:08:29.22,Caption,,0,0,0,,ЛЕГКО. ОН УЖЕ ОТДАЛ СИСТЕМЕ ДЕСЯТИЛЕТИЯ И ТЕПЕРЬ
Dialogue: 0,0:08:29.30,0:08:32.58,Caption,,0,0,0,,ПОЛУЧАЕТ ОБНОВЛЁННЫЕ УСЛОВИЯ ДОГОВОРА. ПОДПИСЬ ЕГО
Dialogue: 0,0:08:32.58,0:08:36.58,Caption,,0,0,0,,ТАМ, РАЗУМЕЕТСЯ, НЕ ТРЕБУЕТСЯ. ЭТО ПРОИСХОДИТ НЕ В ОДНОЙ СТРАНЕ.
Dialogue: 0,0:08:36.92,0:08:41.70,Caption,,0,0,0,,МЕТОДЫ ОТЛИЧАЮТСЯ, НО НАПРАВЛЕНИЕ ОБЩЕЕ. ЕВРОПЕЙСКИЕ ПРАВИТЕЛЬСТВА ИЩУТ
Dialogue: 0,0:08:41.70,0:08:43.78,Caption,,0,0,0,,СПОСОБЫ СНИЗИТЬ БЮДЖЕТНУЮ НАГРУЗКУ,
Dialogue: 0,0:08:44.01,0:08:46.10,Caption,,0,0,0,,И СОЦИАЛЬНЫЕ РАСХОДЫ БОЛЬШЕ НЕ ВЫГЛЯДЯТ
Dialogue: 0,0:08:46.10,0:08:48.98,Caption,,0,0,0,,НЕПРИКОСНОВЕННЫМИ. СНАЧАЛА ДОРОЖАЮТ ПРОДУКТЫ И
Dialogue: 0,0:08:48.98,0:08:55.10,Caption,,0,0,0,,ЭНЕРГИЯ. ЗАТЕМ ЖИЛЬЁ УЕЗЖАЕТ ОТ МОЛОДЁЖИ ЗА ГОРИЗОНТ. ПОТОМ
Dialogue: 0,0:08:55.17,0:08:58.38,Caption,,0,0,0,,ЛЮДИ НАЧИНАЮТ ЭКОНОМИТЬ НА ОТОПЛЕНИИ. СЛЕДОМ ВЛАСТИ
Dialogue: 0,0:08:58.38,0:09:01.66,Caption,,0,0,0,,РАЗГЛЯДЫВАЮТ ПЕНСИИ. РАСПЛАТА РЕДКО ПРИХОДИТ ПОД
Dialogue: 0,0:09:01.74,0:09:04.93,Caption,,0,0,0,,ЗВУКИ СИРЕНЫ. ЧАЩЕ ОНА ТИХО ПРОЛЕЗАЕТ В ПОЧТОВЫЙ
Dialogue: 0,0:09:04.93,0:09:08.46,Caption,,0,0,0,,ЯЩИК. СЕГОДНЯ ЭТО КВИТАНЦИЯ. ЗАВТРА НОВАЯ
Dialogue: 0,0:09:08.46,0:09:12.22,Caption,,0,0,0,,ИНДЕКСАЦИЯ. ПОСЛЕЗАВТРА ПЕНСИОННЫЙ ВОЗРАСТ. А ЗАТЕМ
Dialogue: 0,0:09:12.22,0:09:16.22,Caption,,0,0,0,,ВАМ ОБЪЯСНЯТ, ЧТО ВСЁ ДЕЛАЕТСЯ РАДИ ВАШЕГО БУДУЩЕГО. ПРАВДА,
Dialogue: 0,0:09:16.46,0:09:19.17,Caption,,0,0,0,,ДО ЭТОГО БУДУЩЕГО ЕЩЁ ЖЕЛАТЕЛЬНО ДОЖИТЬ. ПОКА
Dialogue: 0,0:09:19.17,0:09:21.98,Caption,,0,0,0,,АРМЕНИИ ПРЕДЛАГАЮТ ЗАПЛАТИТЬ ЗА БУДУЩУЮ ПЕРСПЕКТИВУ,
Dialogue: 0,0:09:22.26,0:09:25.42,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ БИЗНЕС ОБНАРУЖИВАЕТ СВОЮ ВЕРСИЮ РАСПЛАТЫ
Dialogue: 0,0:09:25.50,0:09:28.38,Caption,,0,0,0,,В РОССИИ. ПЕРЕДАЧА АКТИВОВ ИНОСТРАННЫХ КОМПАНИЙ ПОД
Dialogue: 0,0:09:28.46,0:09:31.42,Caption,,0,0,0,,ВРЕМЕННОЕ УПРАВЛЕНИЕ УСКОРИЛАСЬ. ОДНОЙ ИЗ ПОСЛЕДНИХ
Dialogue: 0,0:09:31.50,0:09:34.70,Caption,,0,0,0,,СТАЛА ЯПОНСКАЯ JAPAN TOBACCO INTERNATIONAL. ДОЛИ
Dialogue: 0,0:09:34.70,0:09:37.26,Caption,,0,0,0,,СРАЗУ В ЧЕТЫРЁХ КОМПАНИЯХ ПЕРЕХОДЯТ ПОД КОНТРОЛЬ
Dialogue: 0,0:09:37.34,0:09:39.66,Caption,,0,0,0,,РОССИЙСКОЙ СТРУКТУРЫ. КОМПАНИЯ КРУПНАЯ,
Dialogue: 0,0:09:39.97,0:09:42.54,Caption,,0,0,0,,А ЕЁ МАРКИ ИЗВЕСТНЫ ВСЕМУ МИРУ. WINSTON,
Dialogue: 0,0:09:42.66,0:09:47.74,Caption,,0,0,0,,CAMEL, AMERICAN SPIRIT, BENSON AND HEDGES. РАНЕЕ ПОД ВРЕМЕННОЕ УПРАВЛЕНИЕ
Dialogue: 0,0:09:47.74,0:09:50.29,Caption,,0,0,0,,УЖЕ ПОПАДАЛИ АКТИВЫ NESTL?, METRO,
Dialogue: 0,0:09:50.46,0:09:53.74,Caption,,0,0,0,,AUCHAN И ДРУГИХ ИНОСТРАННЫХ КОМПАНИЙ. ПРЕДСТАВИТЕЛИ
Dialogue: 0,0:09:53.74,0:09:56.54,Caption,,0,0,0,,ЕВРОПЕЙСКОГО БИЗНЕСА, КОТОРЫХ ЦИТИРУЕТ LE MONDE,
Dialogue: 0,0:09:56.78,0:10:00.29,Caption,,0,0,0,,ГОВОРЯТ, ЧТО ЗА ДВА ПОСЛЕДНИХ МЕСЯЦА ПРОЦЕСС ЗАМЕТНО
Dialogue: 0,0:10:00.29,0:10:03.42,Caption,,0,0,0,,УСКОРИЛСЯ. ОДИН ИЗ БИЗНЕСМЕНОВ ОПИСАЛ СИТУАЦИЮ
Dialogue: 0,0:10:03.50,0:10:05.98,Caption,,0,0,0,,ОСОБЕННО ВЫРАЗИТЕЛЬНО. ИХ ЗОВУТ ВОЗВРАЩАТЬСЯ В
Dialogue: 0,0:10:05.98,0:10:09.26,Caption,,0,0,0,,РОССИЮ, НО ОДНОВРЕМЕННО ПРИСТАВЛЯЮТ НОЖ К ГОРЛУ.
Dialogue: 0,0:10:11.54,0:10:14.18,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОЧЕНЬ СОВРЕМЕННОЕ ПРИГЛАШЕНИЕ. НА
Dialogue: 0,0:10:14.18,0:10:16.58,Caption,,0,0,0,,ПАРАДНОМ ВХОДЕ УЛЫБАЮТСЯ И ГОВОРЯТ О НОВЫХ
Dialogue: 0,0:10:16.58,0:10:20.02,Caption,,0,0,0,,ВОЗМОЖНОСТЯХ. НА СЛУЖЕБНОМ ВХОДЕ УЖЕ МЕНЯЮТ ЗАМОК.
Dialogue: 0,0:10:20.58,0:10:22.58,Caption,,0,0,0,,КИРИЛЛ ДМИТРИЕВ ВСТРЕЧАЕТСЯ С ПРЕДСТАВИТЕЛЯМИ
Dialogue: 0,0:10:22.58,0:10:25.30,Caption,,0,0,0,,ИНОСТРАННОГО БИЗНЕСА И ОБСУЖДАЕТ СОТРУДНИЧЕСТВО,
Dialogue: 0,0:10:25.45,0:10:29.14,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ И БУДУЩИЕ ПРОЕКТЫ. КОМПАНИИ СЛУШАЮТ,
Dialogue: 0,0:10:29.30,0:10:32.34,Caption,,0,0,0,,КИВАЮТ И ПОГЛЯДЫВАЮТ НА СВОИ РОССИЙСКИЕ АКТИВЫ.
Dialogue: 0,0:10:32.77,0:10:35.30,Caption,,0,0,0,,ПОТОМУ ЧТО ВЕРНУТЬСЯ МОЖНО. ТОЛЬКО НЕ ОБЯЗАТЕЛЬНО В
Dialogue: 0,0:10:35.38,0:10:38.82,Caption,,0,0,0,,КАЧЕСТВЕ ВЛАДЕЛЬЦА. ПРИЕХАЛ. ПОЗДОРОВАЛСЯ. УВЕРЕННО
Dialogue: 0,0:10:38.90,0:10:41.54,Caption,,0,0,0,,ПОШЁЛ К ЛИФТУ. ЕГО ОСТАНОВИЛИ ВЫ К КОМУ?
Dialogue: 0,0:10:41.90,0:10:46.10,Caption,,0,0,0,,В СВОЮ КОМПАНИЮ. А ВЫ КТО? ВЛАДЕЛЕЦ. ОЧЕНЬ ПРИЯТНО,
Dialogue: 0,0:10:46.26,0:10:49.86,Caption,,0,0,0,,ОСТАВЬТЕ НОМЕР ТЕЛЕФОНА, РУКОВОДСТВО СВЯЖЕТСЯ ПРИ НАЛИЧИИ ИНТЕРЕСА.
Dialogue: 0,0:10:50.89,0:10:53.54,Caption,,0,0,0,,ЗАПАДНЫЕ КОМПАНИИ НАДЕЯЛИСЬ ОТДЕЛИТЬ ПОЛИТИКУ ОТ
Dialogue: 0,0:10:53.54,0:10:56.74,Caption,,0,0,0,,СОБСТВЕННОСТИ. ОДНИ УШЛИ, ДРУГИЕ ОСТАЛИСЬ,
Dialogue: 0,0:10:57.07,0:11:01.06,Caption,,0,0,0,,ТРЕТЬИ ПРОДАЛИ БИЗНЕС, ЧЕТВЁРТЫЕ РЕШИЛИ ПЕРЕЖДАТЬ. ИМ КАЗАЛОСЬ,
Dialogue: 0,0:11:01.30,0:11:03.70,Caption,,0,0,0,,ЧТО ОТНОШЕНИЯ КОГДА НИБУДЬ НАЛАДЯТСЯ,
Dialogue: 0,0:11:03.94,0:11:08.58,Caption,,0,0,0,,А ЗАВОДЫ, МАГАЗИНЫ И ДОЛИ ДОЖДУТСЯ ХОЗЯЕВ. НО БОЛЬШАЯ ПОЛИТИКА
Dialogue: 0,0:11:08.66,0:11:11.14,Caption,,0,0,0,,НЕ ЛЮБИТ ОСТАВАТЬСЯ В ТЕЛЕВИЗОРЕ. СНАЧАЛА ОНА
Dialogue: 0,0:11:11.22,0:11:12.90,Caption,,0,0,0,,ПРИХОДИТ В ПЕРЕГОВОРНЫЕ КАБИНЕТЫ,
Dialogue: 0,0:11:13.14,0:11:17.38,Caption,,0,0,0,,ПОТОМ В БУХГАЛТЕРИЮ, А ЗАТЕМ ПРОСИТ КЛЮЧИ ОТ ПРЕДПРИЯТИЯ. И ОБЫЧНО
Dialogue: 0,0:11:17.41,0:11:21.30,Caption,,0,0,0,,НЕ ДЛЯ ТОГО, ЧТОБЫ ПОЛИТЬ ЦВЕТЫ. ОСОБЕННО ПОКАЗАТЕЛЕН ЯПОНСКИЙ
Dialogue: 0,0:11:21.30,0:11:24.58,Caption,,0,0,0,,СЛУЧАЙ. ОТНОШЕНИЯ РОССИИ И ЯПОНИИ УХУДШАЛИСЬ.
Dialogue: 0,0:11:24.78,0:11:26.90,Caption,,0,0,0,,ПОЯВИЛАСЬ ИНФОРМАЦИЯ О ПЕРЕДАЧЕ ЯПОНИЕЙ
Dialogue: 0,0:11:26.90,0:11:33.58,Caption,,0,0,0,,БЕСПИЛОТНИКОВ УКРАИНЕ. МОСКВА ПРЕДУПРЕДИЛА О ЖЁСТКОМ ОТВЕТЕ. ПОСЛЕ ЭТОГО
Dialogue: 0,0:11:33.66,0:11:36.70,Caption,,0,0,0,,КРУПНАЯ ЯПОНСКАЯ КОМПАНИЯ ЛИШАЕТСЯ КОНТРОЛЯ НАД
Dialogue: 0,0:11:36.78,0:11:39.82,Caption,,0,0,0,,РОССИЙСКИМИ АКТИВАМИ. ЮРИСТЫ МОГУТ ДОЛГО ОБСУЖДАТЬ
Dialogue: 0,0:11:39.90,0:11:42.62,Caption,,0,0,0,,ФОРМУЛИРОВКУ ВРЕМЕННОГО УПРАВЛЕНИЯ. ДЛЯ БИЗНЕСА
Dialogue: 0,0:11:42.62,0:11:44.94,Caption,,0,0,0,,ПЕРЕВОД ПРОЩЕ. ГЕОПОЛИТИКА ДОБРАЛАСЬ ДО
Dialogue: 0,0:11:44.94,0:11:48.14,Caption,,0,0,0,,СОБСТВЕННОСТИ. СЛОВО "ВРЕМЕННО" ЗДЕСЬ УСПОКАИВАЕТ
Dialogue: 0,0:11:48.22,0:11:51.50,Caption,,0,0,0,,ПРИМЕРНО ТАК ЖЕ, КАК ФРАЗА СТОМАТОЛОГА "СЕЙЧАС БУДЕТ НЕМНОГО
Dialogue: 0,0:11:51.50,0:11:54.30,Caption,,0,0,0,,НЕПРИЯТНО". ПЛАТЯТ НЕ ТОЛЬКО ГРАЖДАНЕ ГОСУДАРСТВ,
Dialogue: 0,0:11:54.46,0:11:57.50,Caption,,0,0,0,,ПРОВОДЯЩИХ ОПРЕДЕЛЁННЫЙ КУРС. ПЛАТЯТ КОМПАНИИ,
Dialogue: 0,0:11:57.66,0:12:00.38,Caption,,0,0,0,,КОТОРЫЕ РАССЧИТЫВАЛИ УСИДЕТЬ МЕЖДУ ПОЛИТИКОЙ И
Dialogue: 0,0:12:00.38,0:12:04.30,Caption,,0,0,0,,ПРИБЫЛЬЮ. ОКАЗАЛОСЬ, ЧТО У ЭТОГО СТУЛА УБРАЛИ ОДНУ НОЖКУ,
Dialogue: 0,0:12:04.54,0:12:09.26,Caption,,0,0,0,,ПОКА ОНИ СПОРИЛИ О ПРОГНОЗАХ. НО САМЫЙ ДОРОГОЙ ПОЛИТИЧЕСКИЙ АТТРАКЦИОН СЕЙЧАС
Dialogue: 0,0:12:09.26,0:12:11.66,Caption,,0,0,0,,МОЖЕТ ГОТОВИТЬСЯ ДЛЯ АРМЕНИИ. ЛУЧШЕ ВСЕГО
Dialogue: 0,0:12:11.66,0:12:14.54,Caption,,0,0,0,,ПРОИСХОДЯЩЕЕ ВИДНО ПО ОДНОЙ ПРОСТОЙ НЕМЕЦКОЙ ЦИФРЕ.
Dialogue: 0,0:12:14.93,0:12:17.50,Caption,,0,0,0,,РАБОТОЙ КАНЦЛЕРА ФРИДРИХА МЕРЦА НЕДОВОЛЬНЫ
Dialogue: 0,0:12:17.50,0:12:20.22,Caption,,0,0,0,,ВОСЕМЬДЕСЯТ ДВА ПРОЦЕНТА ОПРОШЕННЫХ. ДОВОЛЬНЫ
Dialogue: 0,0:12:20.22,0:12:22.86,Caption,,0,0,0,,ТРИНАДЦАТЬ ПРОЦЕНТОВ. ПРЕДСТАВЬТЕ АВТОБУС,
Dialogue: 0,0:12:23.10,0:12:25.58,Caption,,0,0,0,,В КОТОРОМ СТО ПАССАЖИРОВ. ТРИНАДЦАТЬ ГОВОРЯТ
Dialogue: 0,0:12:25.58,0:12:29.42,Caption,,0,0,0,,ВОДИТЕЛЮ, ЧТО ОН МОЛОДЕЦ. ВОСЕМЬДЕСЯТ ДВА ТРЕБУЮТ ОСТАНОВИТЬ,
Dialogue: 0,0:12:29.63,0:12:32.46,Caption,,0,0,0,,ПОТОМУ ЧТО АВТОБУС ЕДЕТ СОВСЕМ НЕ ТУДА. ВОДИТЕЛЬ
Dialogue: 0,0:12:32.54,0:12:34.30,Caption,,0,0,0,,ПОПРАВЛЯЕТ ЗЕРКАЛО И ОТВЕЧАЕТ,
Dialogue: 0,0:12:34.64,0:12:37.26,Caption,,0,0,0,,ЧТО МАРШРУТ УТВЕРЖДЁН, ДВЕРИ ЗАКРЫТЫ,
Dialogue: 0,0:12:37.61,0:12:40.38,Caption,,0,0,0,,А МНЕНИЕ ПАССАЖИРОВ БУДЕТ ИЗУЧЕНО ПОСЛЕ ПРИБЫТИЯ В
Dialogue: 0,0:12:40.46,0:12:43.58,Caption,,0,0,0,,ОВРАГ. ГЕРМАНИЯ ЯВЛЯЕТСЯ ПАРЛАМЕНТСКОЙ РЕСПУБЛИКОЙ.
Dialogue: 0,0:12:45.85,0:12:48.73,Caption,,0,0,0,,ОДИН ПЛОХОЙ ОПРОС НЕ СНИМАЕТ КАНЦЛЕРА С ДОЛЖНОСТИ.
Dialogue: 0,0:12:48.96,0:12:53.93,Caption,,0,0,0,,ЕСТЬ КОАЛИЦИЯ, ПАРЛАМЕНТ, ПРОЦЕДУРЫ И ВЫБОРЫ. НА БУМАГЕ ВСЁ АККУРАТНО,
Dialogue: 0,0:12:54.14,0:12:58.65,Caption,,0,0,0,,ПЕЧАТЬ СТОИТ РОВНО, ПАПКА ПОДШИТА. ТОЛЬКО ДЕМОКРАТИЯ ВСЁ РАВНО ОЗНАЧАЕТ
Dialogue: 0,0:12:58.65,0:13:01.37,Caption,,0,0,0,,ВЛАСТЬ НАРОДА. И ЕСЛИ ПОДАВЛЯЮЩЕЕ БОЛЬШИНСТВО
Dialogue: 0,0:13:01.37,0:13:03.77,Caption,,0,0,0,,ОПРОШЕННЫХ НЕ УСТРАИВАЕТ РУКОВОДИТЕЛЬ СТРАНЫ,
Dialogue: 0,0:13:04.07,0:13:08.97,Caption,,0,0,0,,А НАПРАВЛЕНИЕ НЕ МЕНЯЕТСЯ, ВОЗНИКАЕТ НЕУДОБНЫЙ ВОПРОС. ГДЕ ИМЕННО НАХОДИТСЯ ЭТА
Dialogue: 0,0:13:09.05,0:13:12.01,Caption,,0,0,0,,ВЛАСТЬ НАРОДА? В БЮЛЛЕТЕНЕ? В ПРЕДВЫБОРНОЙ РЕЧИ?
Dialogue: 0,0:13:12.30,0:13:14.17,Caption,,0,0,0,,ИЛИ ЕЁ БЕРЕЖНО ХРАНЯТ В СЕЙФЕ,
Dialogue: 0,0:13:14.33,0:13:16.25,Caption,,0,0,0,,ЧТОБЫ ГРАЖДАНЕ СЛУЧАЙНО НЕ ВОСПОЛЬЗОВАЛИСЬ?
Dialogue: 0,0:13:16.61,0:13:19.61,Caption,,0,0,0,,С ПАРТИЙНЫМИ РЕЙТИНГАМИ КАРТИНА ЕЩЁ ВЕСЕЛЕЕ. АДГ
Dialogue: 0,0:13:19.69,0:13:22.73,Caption,,0,0,0,,ПОЛУЧАЕТ ДВАДЦАТЬ ДЕВЯТЬ ПРОЦЕНТОВ. БЛОК ХДС И ХСС
Dialogue: 0,0:13:22.85,0:13:25.77,Caption,,0,0,0,,ВО ГЛАВЕ С МЕРЦЕМ ПОЛУЧАЕТ ДЕВЯТНАДЦАТЬ. СОЦИАЛ
Dialogue: 0,0:13:25.85,0:13:28.57,Caption,,0,0,0,,ДЕМОКРАТЫ НАБИРАЮТ ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ. АДГ
Dialogue: 0,0:13:28.57,0:13:31.13,Caption,,0,0,0,,ОПЕРЕЖАЕТ БЛОК КАНЦЛЕРА НА ДЕСЯТЬ ПРОЦЕНТНЫХ
Dialogue: 0,0:13:31.13,0:13:34.25,Caption,,0,0,0,,ПУНКТОВ. ОДНАКО ВОКРУГ ПАРТИИ ВЫСТРОЕН ПОЛИТИЧЕСКИЙ
Dialogue: 0,0:13:34.33,0:13:37.69,Caption,,0,0,0,,БАРЬЕР. ГОЛОСОВАТЬ ЗА НЕЁ РАЗРЕШЕНО. ВЫВОДИТЬ ЕЁ НА
Dialogue: 0,0:13:37.77,0:13:40.57,Caption,,0,0,0,,ПЕРВОЕ МЕСТО В ОПРОСАХ ТОЖЕ РАЗРЕШЕНО. ДАЖЕ
Dialogue: 0,0:13:40.57,0:13:42.97,Caption,,0,0,0,,СЕРДИТЬСЯ НА СТАРЫЕ ПАРТИИ МОЖНО СОВЕРШЕННО
Dialogue: 0,0:13:42.97,0:13:45.13,Caption,,0,0,0,,СВОБОДНО. НЕЛЬЗЯ ТОЛЬКО ДОБИТЬСЯ,
Dialogue: 0,0:13:45.36,0:13:46.97,Caption,,0,0,0,,ЧТОБЫ ЭТОТ ВЫБОР ДОШЁЛ ДО ВЛАСТИ.
Dialogue: 0,0:13:47.59,0:13:50.65,Caption,,0,0,0,,ОЧЕНЬ УДОБНАЯ КОНСТРУКЦИЯ. ГРАЖДАНИНУ ТОРЖЕСТВЕННО
Dialogue: 0,0:13:50.73,0:13:53.21,Caption,,0,0,0,,ВРУЧАЮТ РУЛЬ, ФОТОГРАФИРУЮТ ДЛЯ ОТЧЁТА,
Dialogue: 0,0:13:53.45,0:13:56.25,Caption,,0,0,0,,А РУЛЕВАЯ КОЛОНКА ЗАРАНЕЕ ОТСОЕДИНЕНА. КРУТИТЕ
Dialogue: 0,0:13:56.33,0:14:01.09,Caption,,0,0,0,,СКОЛЬКО ХОТИТЕ. МАШИНА ВСЁ РАВНО ПОЕДЕТ ТУДА,
Dialogue: 0,0:14:01.28,0:14:04.13,Caption,,0,0,0,,КУДА РЕШИЛИ ЛЮДИ НА ПЕРЕДНЕМ СИДЕНЬЕ. ПОДПИШИСЬ,
Dialogue: 0,0:14:04.45,0:14:06.53,Caption,,0,0,0,,ЕСЛИ ХОЧЕШЬ ВИДЕТЬ ТАКИЕ СЧЕТА ЦЕЛИКОМ,
Dialogue: 0,0:14:06.77,0:14:08.13,Caption,,0,0,0,,А НЕ В ПЕРЕСКАЗЕ ПРЕСС СЛУЖБЫ.
Dialogue: 0,0:14:08.91,0:14:11.01,Caption,,0,0,0,,ПРОБЛЕМА УЖЕ НЕ В ОДНОМ МЕРЦЕ. СЕГОДНЯ В
Dialogue: 0,0:14:11.01,0:14:15.57,Caption,,0,0,0,,КАБИНЕТЕ НАХОДИТСЯ ОН, ЗАВТРА ТАМ БУДЕТ ДРУГАЯ ФАМИЛИЯ. ОПАСНОСТЬ
Dialogue: 0,0:14:15.57,0:14:19.25,Caption,,0,0,0,,НАЧИНАЕТСЯ ТОГДА, КОГДА ЧЕЛОВЕК ПЕРЕСТАЁТ ЗЛИТЬСЯ НА КОНКРЕТНОГО
Dialogue: 0,0:14:19.25,0:14:23.73,Caption,,0,0,0,,КАНЦЛЕРА И ПОДОЗРЕВАЕТ, ЧТО ВЕСЬ МЕХАНИЗМ УСТРОЕН КАК АВТОМАТ С КОФЕ.
Dialogue: 0,0:14:24.12,0:14:27.41,Caption,,0,0,0,,МОНЕТУ ОН ПРИНИМАЕТ ИСПРАВНО, КНОПКА НАЖИМАЕТСЯ,
Dialogue: 0,0:14:27.60,0:14:31.01,Caption,,0,0,0,,ЛАМПОЧКА ГОРИТ, А СТАКАН ПОЧЕМУ ТО ОСТАЁТСЯ ПУСТЫМ.
Dialogue: 0,0:14:31.71,0:14:34.45,Caption,,0,0,0,,ИЗБИРАТЕЛЬ МОЖЕТ ПРОГОЛОСОВАТЬ ЕЩЁ РАЗ. МОЖЕТ
Dialogue: 0,0:14:34.53,0:14:37.41,Caption,,0,0,0,,ПРИВЕСТИ ДРУЗЕЙ. МОЖЕТ ПОСТАВИТЬ ГАЛОЧКУ ОСОБЕННО
Dialogue: 0,0:14:37.41,0:14:40.21,Caption,,0,0,0,,РЕШИТЕЛЬНО. МОЖЕТ ДАЖЕ ВЗЯТЬ РУЧКУ ПОТОЛЩЕ.
Dialogue: 0,0:14:40.80,0:14:42.93,Caption,,0,0,0,,НО ЕСЛИ ЕГО ВЫБОР КАЖДЫЙ РАЗ УПИРАЕТСЯ В
Dialogue: 0,0:14:42.93,0:14:45.41,Caption,,0,0,0,,СТЕНУ, ОН УЖЕ СПРАШИВАЕТ НЕ О ТОМ,
Dialogue: 0,0:14:45.65,0:14:48.05,Caption,,0,0,0,,КАКАЯ ПАРТИЯ ЛУЧШЕ. ОН СПРАШИВАЕТ,
Dialogue: 0,0:14:48.20,0:14:50.85,Caption,,0,0,0,,СПОСОБЕН ЛИ ЕГО ГОЛОС ВООБЩЕ ЧТО НИБУДЬ ИЗМЕНИТЬ.
Dialogue: 0,0:14:51.28,0:14:54.45,Caption,,0,0,0,,ТАКИЕ ВОПРОСЫ ПОЯВЛЯЮТСЯ НЕ ОТ ХОРОШЕЙ ЖИЗНИ. А
Dialogue: 0,0:14:54.45,0:14:58.13,Caption,,0,0,0,,ОБЫЧНАЯ ЖИЗНЬ В ЕВРОПЕ СТАНОВИТСЯ ВСЁ ДОРОЖЕ. ОБЩЕЕ
Dialogue: 0,0:14:58.13,0:15:00.77,Caption,,0,0,0,,ЗДЕСЬ НЕ ТОЛЬКО В ДЕНЬГАХ. ГЛАВНОЕ В ТОМ,
Dialogue: 0,0:15:01.01,0:15:03.49,Caption,,0,0,0,,ЧТО РОСТ ЦЕНЫ НЕ ЗАСТАВЛЯЕТ ВЛАСТЬ МЕНЯТЬ
Dialogue: 0,0:15:03.49,0:15:07.09,Caption,,0,0,0,,НАПРАВЛЕНИЕ. РАСХОДЫ УВЕЛИЧИВАЮТСЯ. РЕЙТИНГИ ПАДАЮТ.
Dialogue: 0,0:15:07.37,0:15:10.53,Caption,,0,0,0,,НЕДОВОЛЬНЫХ СТАНОВИТСЯ БОЛЬШЕ. СОЦИАЛЬНЫЕ ГАРАНТИИ
Dialogue: 0,0:15:10.59,0:15:13.97,Caption,,0,0,0,,СОКРАЩАЮТСЯ. КОМПАНИИ ТЕРЯЮТ КОНТРОЛЬ НАД АКТИВАМИ.
Dialogue: 0,0:15:14.28,0:15:16.77,Caption,,0,0,0,,ЭКОНОМИЧЕСКИЕ ПРЕДУПРЕЖДЕНИЯ СТАНОВЯТСЯ ГРОМЧЕ.
Dialogue: 0,0:15:19.06,0:15:20.98,Caption,,0,0,0,,А ПОЛИТИК СМОТРИТ НА ВСЁ ЭТО И ГОВОРИТ,
Dialogue: 0,0:15:21.21,0:15:24.34,Caption,,0,0,0,,ЧТО ТЕПЕРЬ ОСОБЕННО ВАЖНО НЕ СВОРАЧИВАТЬ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:15:24.34,0:15:27.62,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ СИСТЕМА. ЕСЛИ КУРС ПРИНОСИТ УСПЕХ,
Dialogue: 0,0:15:27.78,0:15:31.14,Caption,,0,0,0,,ЗНАЧИТ, ОН ПРАВИЛЬНЫЙ. ЕСЛИ КУРС ПРИНОСИТ ПРОБЛЕМЫ,
Dialogue: 0,0:15:31.29,0:15:33.62,Caption,,0,0,0,,ЗНАЧИТ, НАДО ПРОДОЛЖАТЬ ЕЩЁ РЕШИТЕЛЬНЕЕ.
Dialogue: 0,0:15:34.17,0:15:36.66,Caption,,0,0,0,,ОШИБИТЬСЯ В ТАКОЙ КОНСТРУКЦИИ НЕВОЗМОЖНО. МОЖНО
Dialogue: 0,0:15:36.66,0:15:39.62,Caption,,0,0,0,,ТОЛЬКО НЕДОСТАТОЧНО БЫСТРО ДВИГАТЬСЯ К СЛЕДУЮЩЕМУ
Dialogue: 0,0:15:39.62,0:15:42.34,Caption,,0,0,0,,СЧЁТУ. ИМЕННО ПОЭТОМУ ВОСЕМЬДЕСЯТ ДВА ПРОЦЕНТА
Dialogue: 0,0:15:42.42,0:15:45.06,Caption,,0,0,0,,НЕДОВОЛЬНЫХ МЕРЦЕМ ЯВЛЯЮТСЯ НЕ ПРОСТО ПЛОХИМ
Dialogue: 0,0:15:45.06,0:15:48.02,Caption,,0,0,0,,РЕЙТИНГОМ КАНЦЛЕРА. ЭТО ПРОВЕРКА ВСЕЙ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:15:48.02,0:15:50.50,Caption,,0,0,0,,СИСТЕМЫ. СКОЛЬКО НЕДОВОЛЬНЫХ ТРЕБУЕТСЯ,
Dialogue: 0,0:15:50.74,0:15:53.14,Caption,,0,0,0,,ЧТОБЫ НАПРАВЛЕНИЕ ИЗМЕНИЛОСЬ? ДЕВЯНОСТО ПРОЦЕНТОВ?
Dialogue: 0,0:15:53.27,0:15:56.98,Caption,,0,0,0,,ДЕВЯНОСТО ДЕВЯТЬ? ИЛИ ДОСТАТОЧНО ОДНОГО ДОВОЛЬНОГО ЧЕЛОВЕКА,
Dialogue: 0,0:15:57.27,0:15:59.46,Caption,,0,0,0,,ЕСЛИ ЕГО КАБИНЕТ РАСПОЛОЖЕН ВЫШЕ ОСТАЛЬНЫХ?
Dialogue: 0,0:15:59.76,0:16:01.94,Caption,,0,0,0,,ЕСЛИ ГОЛОСОВАНИЕ МЕНЯЕТ ФАМИЛИИ,
Dialogue: 0,0:16:02.10,0:16:05.86,Caption,,0,0,0,,НО НЕ МЕНЯЕТ КУРС, ГРАЖДАНИН ПОСТЕПЕННО ПЕРЕСТАЁТ ЖДАТЬ СЛЕДУЮЩЕГО
Dialogue: 0,0:16:05.86,0:16:10.26,Caption,,0,0,0,,БЮЛЛЕТЕНЯ. ОН ПОНИМАЕТ, ЧТО ЕМУ РАЗРЕШЕНО ВЫБИРАТЬ ОБСЛУЖИВАЮЩИЙ ПЕРСОНАЛ,
Dialogue: 0,0:16:10.48,0:16:13.38,Caption,,0,0,0,,А МЕНЮ УЖЕ УТВЕРЖДЕНО. ПОДПИШИТЕСЬ И НАПИШИТЕ В
Dialogue: 0,0:16:13.38,0:16:17.06,Caption,,0,0,0,,КОММЕНТАРИЯХ, СПОСОБЕН ЛИ СЕГОДНЯ ГОЛОС ГРАЖДАНИНА РЕАЛЬНО
Dialogue: 0,0:16:17.16,0:16:20.18,Caption,,0,0,0,,ИЗМЕНИТЬ ПОЛИТИЧЕСКИЙ КУРС. ВОТ ТОГДА РАСПЛАТА
Dialogue: 0,0:16:20.18,0:16:23.46,Caption,,0,0,0,,СТАНОВИТСЯ ПО НАСТОЯЩЕМУ ЖЁСТКОЙ. МЕРЦ КОГДА НИБУДЬ
Dialogue: 0,0:16:23.54,0:16:26.98,Caption,,0,0,0,,ПОКИНЕТ СВОЙ ПОСТ. ПАШИНЯН ТОЖЕ УЙДЁТ. УРСУЛА ФОН
Dialogue: 0,0:16:27.06,0:16:29.30,Caption,,0,0,0,,ДЕР ЛЯЙЕН НЕ ОСТАНЕТСЯ В КАБИНЕТЕ НАВСЕГДА.
Dialogue: 0,0:16:31.57,0:16:34.45,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА МЕНЯЮТСЯ, КОАЛИЦИИ РАСПАДАЮТСЯ,
Dialogue: 0,0:16:34.69,0:16:36.61,Caption,,0,0,0,,МИНИСТРЫ СКЛАДЫВАЮТ ПОЛНОМОЧИЯ,
Dialogue: 0,0:16:36.85,0:16:40.77,Caption,,0,0,0,,ПАРТИИ ТЕРЯЮТ ПОПУЛЯРНОСТЬ. НО ЕСЛИ ЧЕЛОВЕК ОДНАЖДЫ РЕШИТ,
Dialogue: 0,0:16:40.93,0:16:42.61,Caption,,0,0,0,,ЧТО ЕГО ГОЛОС НИЧЕГО НЕ ЗНАЧИТ,
Dialogue: 0,0:16:42.92,0:16:48.45,Caption,,0,0,0,,ЗАМЕНИТЬ КАНЦЛЕРА БУДЕТ МАЛО. ПРИДЁТСЯ ВОЗВРАЩАТЬ ДОВЕРИЕ К САМОМУ МЕХАНИЗМУ. А
Dialogue: 0,0:16:48.45,0:16:51.17,Caption,,0,0,0,,ДОВЕРИЕ НЕ ПОКУПАЕТСЯ НОВЫМ ПАКЕТОМ ПОМОЩИ,
Dialogue: 0,0:16:51.49,0:16:54.53,Caption,,0,0,0,,НЕ ПРИНИМАЕТСЯ ПОСТАНОВЛЕНИЕМ И НЕ ПОЯВЛЯЕТСЯ ПОСЛЕ
Dialogue: 0,0:16:54.53,0:16:57.73,Caption,,0,0,0,,КРАСИВОЙ РЕЧИ. ЕГО ДОЛГО СОБИРАЮТ И ОЧЕНЬ БЫСТРО
Dialogue: 0,0:16:57.73,0:17:01.33,Caption,,0,0,0,,ТРАТЯТ. ПОЭТОМУ НЫНЕШНИЙ СЧЁТ ВЫСТАВЛЕН НЕ ЗА ОДНУ
Dialogue: 0,0:17:01.41,0:17:04.29,Caption,,0,0,0,,ОШИБКУ И НЕ ЗА ОДНО РЕШЕНИЕ. ОН ВЫСТАВЛЕН
Dialogue: 0,0:17:04.37,0:17:08.13,Caption,,0,0,0,,ЗА СПОСОБ УПРАВЛЕНИЯ, ПРИ КОТОРОМ ГРАЖДАНИН ОПЛАЧИВАЕТ КУРС,
Dialogue: 0,0:17:08.42,0:17:11.49,Caption,,0,0,0,,НО НЕ МОЖЕТ ЕГО ИЗМЕНИТЬ. ЗАКАЗЫ ДЕЛАЛА ВЛАСТЬ.
Dialogue: 0,0:17:11.89,0:17:13.97,Caption,,0,0,0,,А РАСПЛАЧИВАТЬСЯ СНОВА ПОЗВАЛИ НАРОД.
