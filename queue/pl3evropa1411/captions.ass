Dialogue: 0,0:00:00.12,0:00:04.04,Caption,,0,0,0,,МИР ЕЩЁ НЕ НАСТУПИЛ, ЗАТО ЖЕЛАЮЩИХ ОКАЗАТЬСЯ РЯДОМ С ПЕРЕГОВОРАМИ УЖЕ
Dialogue: 0,0:00:04.04,0:00:07.00,Caption,,0,0,0,,СТОЛЬКО, БУДТО ТАМ РАЗДАЮТ НЕ ТРУДНЫЙ КОМПРОМИСС,
Dialogue: 0,0:00:07.16,0:00:09.64,Caption,,0,0,0,,А МЕСТА В ПЕРВОМ РЯДУ. МОСКВА,
Dialogue: 0,0:00:09.72,0:00:13.88,Caption,,0,0,0,,КИЕВ, ВАШИНГТОН И ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОДНОВРЕМЕННО ПРИШЛИ
Dialogue: 0,0:00:13.96,0:00:16.28,Caption,,0,0,0,,В ДВИЖЕНИЕ. В ЕВРОПЕ СРОЧНО РЕШАЮТ,
Dialogue: 0,0:00:16.47,0:00:19.16,Caption,,0,0,0,,КОГО ОТПРАВИТЬ ЗА ОБЩИЙ СТОЛ. КИЕВ В ОДНОЙ
Dialogue: 0,0:00:19.16,0:00:23.72,Caption,,0,0,0,,ФРАЗЕ ЗАМЕЧАЕТ ПРОДВИЖЕНИЕ, А В СЛЕДУЮЩЕЙ СОВЕТУЕТ НЕ ЖДАТЬ БЫСТРОГО ФИНАЛА.
Dialogue: 0,0:00:24.03,0:00:27.40,Caption,,0,0,0,,ПОХОЖЕ, РАЗГОВОР СТАЛ СЕРЬЁЗНЫМ. ВОПРОС ЛИШЬ В ТОМ,
Dialogue: 0,0:00:27.66,0:00:30.44,Caption,,0,0,0,,НАЧАЛИ ЛИ СТОРОНЫ ИСКАТЬ РЕШЕНИЕ ИЛИ КАЖДАЯ ПРОСТО
Dialogue: 0,0:00:30.44,0:00:34.12,Caption,,0,0,0,,БОИТСЯ, ЧТО РЕШЕНИЕ ПРИМУТ БЕЗ НЕЁ. ПОДПИШИТЕСЬ НА КАНАЛ.
Dialogue: 0,0:00:34.45,0:00:37.16,Caption,,0,0,0,,САМОЕ ЛЮБОПЫТНОЕ СЕЙЧАС СКРЫВАЕТСЯ НЕ В ОБЕЩАНИЯХ
Dialogue: 0,0:00:37.16,0:00:41.88,Caption,,0,0,0,,МИРА, А В ТОМ, КТО ВНЕЗАПНО ЗАСОБИРАЛСЯ ЕГО ОБСУЖДАТЬ И С КАКИМИ
Dialogue: 0,0:00:41.88,0:00:45.08,Caption,,0,0,0,,ПОЛНОМОЧИЯМИ. ЕВРОПЕЙСКУЮ АКТИВНОСТЬ НЕЛЬЗЯ СЧИТАТЬ
Dialogue: 0,0:00:45.08,0:00:48.04,Caption,,0,0,0,,ОБЫЧНЫМ ШУМОМ ПЕРЕД ОЧЕРЕДНЫМ САММИТОМ. СОВСЕМ
Dialogue: 0,0:00:48.04,0:00:50.84,Caption,,0,0,0,,НЕДАВНО САМА ИДЕЯ РАЗГОВОРА С МОСКВОЙ ВЫЗЫВАЛА У
Dialogue: 0,0:00:50.84,0:00:53.64,Caption,,0,0,0,,МНОГИХ ЕВРОПЕЙСКИХ РУКОВОДИТЕЛЕЙ ВЫРАЖЕНИЕ ЛИЦА,
Dialogue: 0,0:00:53.94,0:00:56.44,Caption,,0,0,0,,БУДТО ИМ ПРЕДЛОЖИЛИ ЛИЧНО ОПЛАТИТЬ ВЕСЬ БАНКЕТ.
Dialogue: 0,0:00:56.83,0:00:58.84,Caption,,0,0,0,,СНАЧАЛА СЛЕДОВАЛ РАССКАЗ О ПРИНЦИПАХ,
Dialogue: 0,0:00:59.08,0:01:03.88,Caption,,0,0,0,,ЗАТЕМ О НЕПОДХОДЯЩЕМ МОМЕНТЕ, ПОТОМ О НЕОБХОДИМОСТИ ПРИНЯТЬ ЕЩЁ ОДНО СУРОВОЕ
Dialogue: 0,0:01:03.88,0:01:06.52,Caption,,0,0,0,,РЕШЕНИЕ. НА РАЗГОВОР ВРЕМЕНИ НЕ ОСТАВАЛОСЬ,
Dialogue: 0,0:01:06.80,0:01:08.76,Caption,,0,0,0,,ПОТОМУ ЧТО ВСЕ БЫЛИ ЗАНЯТЫ ОБЪЯСНЕНИЕМ,
Dialogue: 0,0:01:08.98,0:01:15.35,Caption,,0,0,0,,ПОЧЕМУ РАЗГОВАРИВАТЬ НЕЛЬЗЯ. ПРЕЗИДЕНТ ФИНЛЯНДИИ ГОВОРИТ О ВОЗМОЖНЫХ ПЕРЕГОВОРАХ
Dialogue: 0,0:01:15.43,0:01:18.47,Caption,,0,0,0,,С УЧАСТИЕМ РОССИИ, СОЕДИНЁННЫХ ШТАТОВ И ЕВРОПЫ.
Dialogue: 0,0:01:19.18,0:01:21.27,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ПРЕДСТАВИТЕЛЕЙ ХОТЯТ ПРИВЛЕЧЬ К
Dialogue: 0,0:01:21.27,0:01:24.55,Caption,,0,0,0,,СЛЕДУЮЩЕМУ ЭТАПУ. ЗЕЛЕНСКИЙ ОБЩАЕТСЯ С УИТКОФФОМ И
Dialogue: 0,0:01:24.63,0:01:27.83,Caption,,0,0,0,,КУШНЕРОМ. В КАЧЕСТВЕ ПЛОЩАДОК ПОЯВЛЯЮТСЯ ЭМИРАТЫ И
Dialogue: 0,0:01:27.83,0:01:32.55,Caption,,0,0,0,,ШВЕЙЦАРИЯ. МЕХАНИЗМ, КОТОРЫЙ ДОЛГО СЧИТАЛСЯ НАМЕРТВО ЗАКЛИНИВШИМ,
Dialogue: 0,0:01:32.79,0:01:36.15,Caption,,0,0,0,,НАКОНЕЦ ИЗДАЛ ХОТЯ БЫ ОДИН РАБОЧИЙ ЗВУК. ЕВРОПА
Dialogue: 0,0:01:36.15,0:01:38.87,Caption,,0,0,0,,УСЛЫШАЛА ЕГО ПЕРВОЙ И ТУТ ЖЕ НАЧАЛА ВЫЯСНЯТЬ,
Dialogue: 0,0:01:39.12,0:01:42.39,Caption,,0,0,0,,КОМУ ПОЛОЖЕНО СТОЯТЬ У РЫЧАГА. ОТСЮДА И СОРЕВНОВАНИЕ
Dialogue: 0,0:01:42.47,0:01:44.95,Caption,,0,0,0,,ЗА РОЛЬ ГЛАВНОГО ЕВРОПЕЙСКОГО ПРЕДСТАВИТЕЛЯ.
Dialogue: 0,0:01:45.59,0:01:48.23,Caption,,0,0,0,,МАКРОН ПРИЗЫВАЕТ ЕВРОСОЮЗ СОГЛАСОВАТЬ ОБЩУЮ
Dialogue: 0,0:01:48.31,0:01:50.87,Caption,,0,0,0,,СТРАТЕГИЮ. ЗАОДНО ОН СОВЕРШЕННО НЕ СКРЫВАЕТ,
Dialogue: 0,0:01:51.16,0:01:53.99,Caption,,0,0,0,,ЧТО ВИДИТ СЕБЯ ПОДХОДЯЩИМ ГОЛОСОМ ВСЕЙ ЕВРОПЫ.
Dialogue: 0,0:01:54.36,0:01:57.03,Caption,,0,0,0,,АМБИЦИЯ СОЛИДНАЯ. ДОМАШНИЕ РЕЗУЛЬТАТЫ,
Dialogue: 0,0:01:57.19,0:02:00.87,Caption,,0,0,0,,ПРАВДА, СЛЕГКА ПОРТЯТ ТОРЖЕСТВЕННУЮ КАРТИНУ. ПО НОЯБРЬСКОМУ
Dialogue: 0,0:02:00.87,0:02:03.75,Caption,,0,0,0,,ОПРОСУ ELABE ФРАНЦУЗСКОМУ ПРЕЗИДЕНТУ ДОВЕРЯЮТ
Dialogue: 0,0:02:03.75,0:02:06.63,Caption,,0,0,0,,ТРИНАДЦАТЬ ПРОЦЕНТОВ ГРАЖДАН. ИССЛЕДОВАНИЕ VERIAN
Dialogue: 0,0:02:06.63,0:02:09.59,Caption,,0,0,0,,ДАЁТ ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ. БОЛЕЕ ВОСЬМИДЕСЯТИ
Dialogue: 0,0:02:09.67,0:02:11.99,Caption,,0,0,0,,ПРОЦЕНТОВ ОПРОШЕННЫХ В ОБОИХ СЛУЧАЯХ ЕМУ НЕ
Dialogue: 0,0:02:11.99,0:02:15.51,Caption,,0,0,0,,ДОВЕРЯЮТ. ТО ЕСТЬ НА РОДИНЕ МАКРОН УБЕЖДАЕТ ПРИМЕРНО
Dialogue: 0,0:02:15.51,0:02:18.55,Caption,,0,0,0,,ОДНОГО ФРАНЦУЗА ИЗ СЕМИ. ЗАТО ПРЕДСТАВЛЯТЬ
Dialogue: 0,0:02:18.55,0:02:21.11,Caption,,0,0,0,,СОБИРАЕТСЯ ЦЕЛЫЙ КОНТИНЕНТ. ЭММАНУЭЛЬ,
Dialogue: 0,0:02:21.27,0:02:24.55,Caption,,0,0,0,,МОЖЕТ, ДЛЯ РАЗМИНКИ СТОИЛО БЫ УГОВОРИТЬ ХОТЯ БЫ ФРАНЦИЮ?
Dialogue: 0,0:02:26.82,0:02:28.90,Caption,,0,0,0,,С ТАКИМИ ЦИФРАМИ ТРУДНО ИЗОБРАЖАТЬ ДАЖЕ
Dialogue: 0,0:02:28.91,0:02:33.62,Caption,,0,0,0,,ОБЩЕНАЦИОНАЛЬНОЕ СОГЛАСИЕ, НЕ ГОВОРЯ УЖЕ О СОГЛАСИИ ЕВРОПЕЙСКОМ. И ДЕЛО
Dialogue: 0,0:02:33.70,0:02:35.86,Caption,,0,0,0,,ЗДЕСЬ ШИРЕ ОДНОГО ФРАНЦУЗСКОГО ПРЕЗИДЕНТА.
Dialogue: 0,0:02:36.57,0:02:39.38,Caption,,0,0,0,,МНОГИЕ РУКОВОДИТЕЛИ ЕВРОПЫ ДАВНО РАСТЕРЯЛИ ДОВЕРИЕ
Dialogue: 0,0:02:39.38,0:02:41.54,Caption,,0,0,0,,ЗНАЧИТЕЛЬНОЙ ЧАСТИ СОБСТВЕННЫХ ИЗБИРАТЕЛЕЙ,
Dialogue: 0,0:02:41.87,0:02:44.02,Caption,,0,0,0,,НО ГОТОВЫ ЕХАТЬ К МОСКВЕ С РАССКАЗОМ О
Dialogue: 0,0:02:44.10,0:02:47.86,Caption,,0,0,0,,ВОЛЕ ВСЕГО ЕВРОСОЮЗА. ВОЗНИКАЕТ НЕЛОВКИЙ ВОПРОС. КТО
Dialogue: 0,0:02:47.86,0:02:52.18,Caption,,0,0,0,,ПОРУЧИЛ ИМ ВЫРАЖАТЬ ЭТУ ВОЛЮ, ЕСЛИ ДОМА ИХ САМИХ СЛУШАЮТ ЧЕРЕЗ РАЗ?
Dialogue: 0,0:02:52.60,0:02:54.98,Caption,,0,0,0,,ТЕМ БОЛЕЕ ЕДИНОГО ОТВЕТА У ЕВРОПЫ ПОКА НЕТ
Dialogue: 0,0:02:54.98,0:02:56.98,Caption,,0,0,0,,ДАЖЕ НА ВОПРОС О ФАМИЛИИ ПРЕДСТАВИТЕЛЯ.
Dialogue: 0,0:02:57.72,0:03:01.06,Caption,,0,0,0,,ОДНИ ГОСУДАРСТВА ПОДДЕРЖИВАЮТ АНТОНИУ КОШТУ. ДРУГИЕ
Dialogue: 0,0:03:01.06,0:03:03.78,Caption,,0,0,0,,ПРЕДПОЧИТАЮТ ОТДЕЛЬНОЕ УЧАСТИЕ ФРАНЦИИ И ГЕРМАНИИ.
Dialogue: 0,0:03:04.26,0:03:07.06,Caption,,0,0,0,,ТРЕТЬИМ ПОДХОДИТ КАЯ КАЛЛАС. ОДНО МЕСТО,
Dialogue: 0,0:03:07.21,0:03:10.26,Caption,,0,0,0,,ТРИ ГРУППЫ ПРЕТЕНДЕНТОВ И ДВАДЦАТЬ СЕМЬ НАБОРОВ
Dialogue: 0,0:03:10.26,0:03:13.14,Caption,,0,0,0,,ИНТЕРЕСОВ. КРЕСЛО ЕЩЁ НЕ ПРИДВИНУЛИ К СТОЛУ,
Dialogue: 0,0:03:13.38,0:03:16.02,Caption,,0,0,0,,А ВОЗЛЕ НЕГО УЖЕ МОЖНО ВЫДАВАТЬ НОМЕРКИ. ПРИ
Dialogue: 0,0:03:16.10,0:03:18.50,Caption,,0,0,0,,ЭТОМ ЕВРОПЕЙСКИЕ ДИПЛОМАТЫ САМИ ПРИЗНАЮТ,
Dialogue: 0,0:03:18.74,0:03:21.30,Caption,,0,0,0,,ЧТО ПРЕЖНЯЯ ПОЗИЦИЯ КАЛЛАС МОЖЕТ СДЕЛАТЬ ЕЁ
Dialogue: 0,0:03:21.30,0:03:24.26,Caption,,0,0,0,,НЕУДОБНЫМ СОБЕСЕДНИКОМ ДЛЯ МОСКВЫ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:03:24.26,0:03:27.30,Caption,,0,0,0,,ЗАНЯТНАЯ ПОСЛЕДОВАТЕЛЬНОСТЬ. ЧТОБЫ ВЕСТИ РАЗГОВОР С
Dialogue: 0,0:03:27.30,0:03:30.66,Caption,,0,0,0,,РОССИЕЙ, ЕВРОСОЮЗУ СПЕРВА ПРИДЁТСЯ ПРОВЕСТИ ПЕРЕГОВОРЫ С
Dialogue: 0,0:03:30.66,0:03:33.62,Caption,,0,0,0,,САМИМ СОБОЙ. ПРИЧЁМ ДОГОВОРИТЬСЯ НУЖНО НЕ ТОЛЬКО О
Dialogue: 0,0:03:33.62,0:03:37.38,Caption,,0,0,0,,ЧЕЛОВЕКЕ, НО И О СОДЕРЖАНИИ ЕГО МАНДАТА. НАЦИОНАЛЬНЫЕ
Dialogue: 0,0:03:37.38,0:03:39.38,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА НИКУДА НЕ ИСЧЕЗЛИ.
Dialogue: 0,0:03:41.66,0:03:44.22,Caption,,0,0,0,,У КАЖДОГО СВОИ ИЗБИРАТЕЛИ, РАСХОДЫ,
Dialogue: 0,0:03:44.34,0:03:47.42,Caption,,0,0,0,,ОТРАСЛИ, ОБЯЗАТЕЛЬСТВА И ПРЕДЕЛ ТЕРПЕНИЯ.
Dialogue: 0,0:03:47.98,0:03:51.18,Caption,,0,0,0,,ОДНИ ГОТОВЫ ПРОДОЛЖАТЬ НЫНЕШНИЙ КУРС ДОЛГО. ДРУГИЕ
Dialogue: 0,0:03:51.18,0:03:54.30,Caption,,0,0,0,,УЖЕ ПОДСЧИТЫВАЮТ ЦЕНУ. ТРЕТЬИ ХОТЯТ ИЗМЕНИТЬ
Dialogue: 0,0:03:54.30,0:03:58.38,Caption,,0,0,0,,НАПРАВЛЕНИЕ, НО НЕ ЖЕЛАЮТ ПЕРВЫМИ ПРИЗНАВАТЬ ЭТО ВСЛУХ. КТО
Dialogue: 0,0:03:58.46,0:04:01.18,Caption,,0,0,0,,ТОГДА ПОЛУЧИТ СЛОВО? КОШТА? КАЛЛАС?
Dialogue: 0,0:04:01.32,0:04:04.94,Caption,,0,0,0,,МАКРОН? ИЛИ ПАРИЖ С БЕРЛИНОМ ПРИДУТ ВДВОЁМ И ОБЪЯВЯТ,
Dialogue: 0,0:04:05.18,0:04:07.02,Caption,,0,0,0,,ЧТО ОСТАЛЬНЫЕ МЫСЛЕННО ПРИСУТСТВУЮТ?
Dialogue: 0,0:04:07.32,0:04:11.58,Caption,,0,0,0,,ЕЩЁ СЛОЖНЕЕ ПОНЯТЬ, ЧТО ИМЕННО ВЫБРАННЫЙ ПРЕДСТАВИТЕЛЬ ВПРАВЕ БУДЕТ
Dialogue: 0,0:04:11.66,0:04:15.10,Caption,,0,0,0,,ОБЕЩАТЬ. ТАБЛИЧКА С ФАМИЛИЕЙ НЕ ПРЕВРАЩАЕТ ДВАДЦАТЬ
Dialogue: 0,0:04:15.18,0:04:17.82,Caption,,0,0,0,,СЕМЬ РАЗНЫХ ПРАВИТЕЛЬСТВ В ОДНУ КОМАНДУ. МОЖНО
Dialogue: 0,0:04:17.82,0:04:19.82,Caption,,0,0,0,,ПРОИЗНЕСТИ РЕЧЬ ОТ ИМЕНИ ЕВРОПЫ,
Dialogue: 0,0:04:20.06,0:04:21.98,Caption,,0,0,0,,НО ИСПОЛНИТЬ ЕЁ ПРИДЁТСЯ СТРАНАМ,
Dialogue: 0,0:04:22.30,0:04:25.10,Caption,,0,0,0,,КОТОРЫЕ ЗАРАНЕЕ НЕ ДОГОВОРИЛИСЬ ДАЖЕ О САМОЙ РЕЧИ.
Dialogue: 0,0:04:25.40,0:04:27.98,Caption,,0,0,0,,МОСКВА ЭТУ СЛАБОСТЬ ЗАМЕЧАЕТ. НА ВСТРЕЧЕ В АБУ
Dialogue: 0,0:04:28.06,0:04:30.38,Caption,,0,0,0,,ДАБИ РОССИЙСКАЯ СТОРОНА НЕ ЗАХОТЕЛА ПРОВОДИТЬ
Dialogue: 0,0:04:30.38,0:04:33.34,Caption,,0,0,0,,ОТДЕЛЬНЫЕ КОНТАКТЫ С ПРЕДСТАВИТЕЛЯМИ ЕВРОПЫ И НАТО.
Dialogue: 0,0:04:33.74,0:04:36.46,Caption,,0,0,0,,ВОПРОС БЫЛ ПОСТАВЛЕН БЕЗ УКРАШЕНИЙ. КОГО ВЫ
Dialogue: 0,0:04:36.46,0:04:40.78,Caption,,0,0,0,,ПРЕДСТАВЛЯЕТЕ, НА КАКИХ ОСНОВАНИЯХ УЧАСТВУЕТЕ И ЧТО ПРИНЕСЛИ КРОМЕ
Dialogue: 0,0:04:40.78,0:04:45.74,Caption,,0,0,0,,ЖЕЛАНИЯ ПРИСУТСТВОВАТЬ? И ВОТ ТУТ ЕВРОПЕЙСКАЯ КОНСТРУКЦИЯ НАЧИНАЕТ СКРИПЕТЬ
Dialogue: 0,0:04:45.82,0:04:48.46,Caption,,0,0,0,,ОСОБЕННО ГРОМКО. ЕВРОСОЮЗ ТРЕБУЕТ МЕСТА В
Dialogue: 0,0:04:48.46,0:04:52.94,Caption,,0,0,0,,ОБСУЖДЕНИИ, НО ОДНОВРЕМЕННО ПЫТАЕТСЯ ВЫСТАВИТЬ УСЛОВИЯ ЕЩЁ ДО
Dialogue: 0,0:04:52.94,0:04:54.70,Caption,,0,0,0,,НАЧАЛА ПОЛНОЦЕННОГО РАЗГОВОРА.
Dialogue: 0,0:04:56.98,0:04:59.86,Caption,,0,0,0,,КАЛЛАС ПРЕДЛАГАЕТ СПЕРВА ДОБИТЬСЯ ПРЕКРАЩЕНИЯ ОГНЯ,
Dialogue: 0,0:05:00.09,0:05:02.18,Caption,,0,0,0,,А УЖЕ ПОТОМ ПЕРЕХОДИТЬ К ОСТАЛЬНЫМ ТЕМАМ.
Dialogue: 0,0:05:02.73,0:05:05.62,Caption,,0,0,0,,РОССИЯ НАСТАИВАЕТ НА ОБСУЖДЕНИИ ОБЩЕЙ СИСТЕМЫ
Dialogue: 0,0:05:05.62,0:05:08.90,Caption,,0,0,0,,БЕЗОПАСНОСТИ. КИЕВ ВЫДВИГАЕТ СОБСТВЕННЫЕ ТРЕБОВАНИЯ.
Dialogue: 0,0:05:09.21,0:05:12.10,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ СТАРАЮТСЯ УСАДИТЬ ВСЕХ В ОДНОМ
Dialogue: 0,0:05:12.10,0:05:15.38,Caption,,0,0,0,,ПОМЕЩЕНИИ, ПОКА УЧАСТНИКИ НЕ РАЗОШЛИСЬ СПОРИТЬ ПО СОСЕДНИМ
Dialogue: 0,0:05:15.38,0:05:17.78,Caption,,0,0,0,,КОРИДОРАМ. КАЖДЫЙ ПРИШЁЛ ДОГОВАРИВАТЬСЯ,
Dialogue: 0,0:05:17.86,0:05:20.02,Caption,,0,0,0,,ПРЕДВАРИТЕЛЬНО СОСТАВИВ ПЕРЕЧЕНЬ УСТУПОК,
Dialogue: 0,0:05:20.18,0:05:23.30,Caption,,0,0,0,,КОТОРЫЕ ОБЯЗАНЫ СДЕЛАТЬ ВСЕ ОСТАЛЬНЫЕ. ОЧЕНЬ УДОБНЫЙ
Dialogue: 0,0:05:23.30,0:05:25.94,Caption,,0,0,0,,СПОСОБ НАЧАТЬ ПРИМИРЕНИЕ. ОСТАЁТСЯ ТОЛЬКО НАЙТИ
Dialogue: 0,0:05:25.94,0:05:30.18,Caption,,0,0,0,,СТОРОНУ, СОГЛАСНУЮ ПЕРВОЙ ПРИЗНАТЬ СЕБЯ НЕПРАВОЙ. ОДНАКО
Dialogue: 0,0:05:30.18,0:05:33.78,Caption,,0,0,0,,ЗНАЧЕНИЕ САМОЙ ВСТРЕЧИ ОТ ЭТОГО НЕ ИСЧЕЗАЕТ. ПОСЛЕ
Dialogue: 0,0:05:33.86,0:05:36.90,Caption,,0,0,0,,АБУ ДАБИ ЗЕЛЕНСКИЙ ГОВОРИТ О ПРОДВИЖЕНИИ. ПОДГОТОВКА
Dialogue: 0,0:05:36.90,0:05:39.62,Caption,,0,0,0,,СЛЕДУЮЩЕГО РАУНДА ПРОДОЛЖАЕТСЯ. АМЕРИКАНСКИЕ
Dialogue: 0,0:05:39.62,0:05:42.02,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ ПОДДЕРЖИВАЮТ КОНТАКТЫ С РАЗНЫМИ
Dialogue: 0,0:05:42.02,0:05:45.22,Caption,,0,0,0,,СТОРОНАМИ. ЕВРОПУ ПОСТЕПЕННО ПОДВОДЯТ К УЧАСТИЮ.
Dialogue: 0,0:05:45.61,0:05:48.42,Caption,,0,0,0,,РАЗГОВОР ДЕЙСТВИТЕЛЬНО НАЧАЛСЯ. ТЕПЕРЬ ТРЕБУЕТСЯ
Dialogue: 0,0:05:48.42,0:05:51.14,Caption,,0,0,0,,ВЫЯСНИТЬ, КАКОЙ ИМЕННО РАЗГОВОР НАЧАЛСЯ,
Dialogue: 0,0:05:51.38,0:05:54.10,Caption,,0,0,0,,ПОТОМУ ЧТО УЧАСТНИКИ ВКЛАДЫВАЮТ В НЕГО СОВЕРШЕННО
Dialogue: 0,0:05:54.10,0:05:56.98,Caption,,0,0,0,,РАЗНЫЙ МАСШТАБ. ЗЕЛЕНСКИЙ СООБЩАЕТ О ПРОГРЕССЕ,
Dialogue: 0,0:05:57.12,0:06:01.30,Caption,,0,0,0,,НО ОДНОВРЕМЕННО СОМНЕВАЕТСЯ, ЧТО УКРАИНСКОЕ УРЕГУЛИРОВАНИЕ ДОЛЖНО ВКЛЮЧАТЬ
Dialogue: 0,0:06:01.38,0:06:04.42,Caption,,0,0,0,,ОБСУЖДЕНИЕ НОВОЙ СИСТЕМЫ БЕЗОПАСНОСТИ МЕЖДУ РОССИЕЙ
Dialogue: 0,0:06:04.50,0:06:07.78,Caption,,0,0,0,,И ЕВРОПОЙ. ДЛЯ МОСКВЫ ТАКАЯ СИСТЕМА ЯВЛЯЕТСЯ ОДНОЙ
Dialogue: 0,0:06:07.86,0:06:13.48,Caption,,0,0,0,,ИЗ ЦЕНТРАЛЬНЫХ ТЕМ. КИЕВ ХОЧЕТ ОБСУЖДАТЬ ПРЕКРАЩЕНИЕ УДАРОВ,
Dialogue: 0,0:06:13.72,0:06:16.84,Caption,,0,0,0,,ВОЗМОЖНОЕ ПЕРЕМИРИЕ И КОНКРЕТНЫЕ УСЛОВИЯ ВОКРУГ
Dialogue: 0,0:06:16.84,0:06:20.20,Caption,,0,0,0,,УКРАИНЫ. РОССИЯ СТАВИТ ВОПРОС ШИРЕ И ГОВОРИТ О
Dialogue: 0,0:06:20.20,0:06:23.16,Caption,,0,0,0,,ПРАВИЛАХ БЕЗОПАСНОСТИ НА ВСЁМ КОНТИНЕНТЕ ПОСЛЕ
Dialogue: 0,0:06:23.24,0:06:24.84,Caption,,0,0,0,,ЗАВЕРШЕНИЯ НЫНЕШНЕГО КОНФЛИКТА.
Dialogue: 0,0:06:25.48,0:06:28.12,Caption,,0,0,0,,ОДНА СТОРОНА ПРИНЕСЛА СПИСОК СРОЧНЫХ ВОПРОСОВ.
Dialogue: 0,0:06:28.52,0:06:31.32,Caption,,0,0,0,,ДРУГАЯ ПРЕДЛАГАЕТ ПЕРЕДЕЛАТЬ ВСЮ СХЕМУ ОТНОШЕНИЙ.
Dialogue: 0,0:06:31.78,0:06:34.92,Caption,,0,0,0,,НЕУДИВИТЕЛЬНО, ЧТО УЧАСТНИКИ СМОТРЯТ НА ОДИН СТОЛ,
Dialogue: 0,0:06:35.24,0:06:37.80,Caption,,0,0,0,,А ВИДЯТ НА НЁМ РАЗНЫЕ ДОКУМЕНТЫ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:06:37.80,0:06:41.64,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО МОСКВА НЕ ЖЕЛАЕТ ОБСУЖДАТЬ ОГРАНИЧЕНИЯ УДАРОВ И
Dialogue: 0,0:06:41.64,0:06:44.12,Caption,,0,0,0,,СПОСОБЫ УМЕНЬШИТЬ ПОСЛЕДСТВИЯ БОЕВЫХ ДЕЙСТВИЙ.
Dialogue: 0,0:06:44.60,0:06:47.08,Caption,,0,0,0,,РОССИЯ ВНОВЬ ВОЗВРАЩАЕТ РАЗГОВОР К НАТО И
Dialogue: 0,0:06:47.08,0:06:50.60,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. ПОЭТОМУ СЛОВО "ПРОГРЕСС"
Dialogue: 0,0:06:50.83,0:06:53.72,Caption,,0,0,0,,САМО ПО СЕБЕ ПОЧТИ НИЧЕГО НЕ ОБЪЯСНЯЕТ. СТОРОНЫ
Dialogue: 0,0:06:53.72,0:06:58.20,Caption,,0,0,0,,НАЧАЛИ РЕГУЛЯРНО ОБЩАТЬСЯ? ДА. ОНИ ПРИБЛИЗИЛИСЬ К СОГЛАСИЮ ПО ОСНОВНЫМ
Dialogue: 0,0:06:58.20,0:07:01.96,Caption,,0,0,0,,ТРЕБОВАНИЯМ? ПОКА ТАКОГО ВЫВОДА СДЕЛАТЬ НЕЛЬЗЯ. ДЛЯ ЕВРОПЫ ЭТО
Dialogue: 0,0:07:02.04,0:07:04.68,Caption,,0,0,0,,СОЗДАЁТ ОТДЕЛЬНУЮ ПРОБЛЕМУ. МАКРОН ЗАЯВЛЯЕТ,
Dialogue: 0,0:07:04.92,0:07:07.24,Caption,,0,0,0,,ЧТО ГЛАВНАЯ ПОДДЕРЖКА УКРАИНЫ ТЕПЕРЬ ИДЁТ ОТ
Dialogue: 0,0:07:07.24,0:07:10.12,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ГОСУДАРСТВ И ОСТАЛЬНЫХ СТРАН КОАЛИЦИИ,
Dialogue: 0,0:07:10.49,0:07:12.92,Caption,,0,0,0,,ПОСКОЛЬКУ ПРЕЖНЕГО АМЕРИКАНСКОГО УЧАСТИЯ УЖЕ НЕТ.
Dialogue: 0,0:07:13.55,0:07:16.44,Caption,,0,0,0,,ЕСЛИ ЕВРОПА ОПЛАЧИВАЕТ ВСЁ БОЛЬШУЮ ДОЛЮ УКРАИНСКИХ
Dialogue: 0,0:07:16.52,0:07:20.52,Caption,,0,0,0,,РАСХОДОВ, ЕЁ ТРЕБОВАНИЕ ПОЛУЧИТЬ МЕСТО ЗА СТОЛОМ ПОНЯТНО. ТОТ,
Dialogue: 0,0:07:20.61,0:07:23.56,Caption,,0,0,0,,КОМУ ПРИНОСЯТ СЧЁТ, ОБЫЧНО ХОЧЕТ ХОТЯ БЫ ЗНАТЬ,
Dialogue: 0,0:07:23.80,0:07:30.24,Caption,,0,0,0,,ЧТО ИМЕННО ЗАКАЗАЛИ. НО РАЗМЕР ПЛАТЕЖЕЙ НЕ РАВЕН РАЗМЕРУ ВЛИЯНИЯ.
Dialogue: 0,0:07:30.71,0:07:35.28,Caption,,0,0,0,,ВАШИНГТОН ХОРОШО ПОНИМАЕТ, ГДЕ ПРОХОДИТ ЭТА ГРАНИЦА. АМЕРИКАНЦЫ НАПРЯМУЮ
Dialogue: 0,0:07:35.36,0:07:38.24,Caption,,0,0,0,,ОБЩАЮТСЯ С МОСКВОЙ, ОТДЕЛЬНО РАБОТАЮТ С КИЕВОМ,
Dialogue: 0,0:07:38.40,0:07:41.36,Caption,,0,0,0,,ПРИНИМАЮТ ЕВРОПЕЙЦЕВ И ПЕРЕМЕЩАЮТ ПРЕДЛОЖЕНИЯ МЕЖДУ
Dialogue: 0,0:07:41.36,0:07:44.24,Caption,,0,0,0,,УЧАСТНИКАМИ. ЕВРОСОЮЗ ТЕМ ВРЕМЕНЕМ ПРОДОЛЖАЕТ
Dialogue: 0,0:07:44.24,0:07:48.48,Caption,,0,0,0,,ВЫБИРАТЬ ЧЕЛОВЕКА, КОТОРЫЙ КОГДА НИБУДЬ ОЗВУЧИТ ЕГО ОБЩУЮ ПОЗИЦИЮ,
Dialogue: 0,0:07:48.71,0:07:50.96,Caption,,0,0,0,,ЕСЛИ ОБЩАЯ ПОЗИЦИЯ К ТОМУ ВРЕМЕНИ ПОЯВИТСЯ.
Dialogue: 0,0:07:51.30,0:07:54.48,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ВАМ ИНТЕРЕСНЫ РЕАЛЬНЫЕ РЫЧАГИ,
Dialogue: 0,0:07:54.79,0:07:57.76,Caption,,0,0,0,,А НЕ ЕЖЕДНЕВНАЯ СМЕНА ГРОМКИХ ЗАЯВЛЕНИЙ. И НАПИШИТЕ
Dialogue: 0,0:07:57.84,0:08:01.76,Caption,,0,0,0,,В КОММЕНТАРИЯХ, КТО ВООБЩЕ СПОСОБЕН ПРЕДСТАВЛЯТЬ ЕВРОПУ ПРИ ТАКОМ
Dialogue: 0,0:08:01.76,0:08:07.04,Caption,,0,0,0,,КОЛИЧЕСТВЕ ПРОТИВОРЕЧИЙ. ВНУТРИ ЕВРОСОЮЗА СОГЛАСИЯ НЕ ПРИБАВЛЯЕТСЯ. ФИЦО
Dialogue: 0,0:08:07.04,0:08:10.40,Caption,,0,0,0,,РАССКАЗЫВАЕТ, ЧТО РАЗГОВОР С УКРАИНСКИМ ПРЕМЬЕРОМ О ВОЙНЕ И
Dialogue: 0,0:08:10.40,0:08:13.68,Caption,,0,0,0,,ВОЗМОЖНОМ ЗАВЕРШЕНИИ КОНФЛИКТА БУКВАЛЬНО ЕГО ПОТРЯС.
Dialogue: 0,0:08:13.95,0:08:17.84,Caption,,0,0,0,,ОН ЖЕ ВСПОМИНАЕТ, КАК КАНЦЛЕР ГЕРМАНИИ МЕРЦ КРИЧАЛ НА НЕГО ИЗ
Dialogue: 0,0:08:17.92,0:08:21.04,Caption,,0,0,0,,ЗА БЛОКИРОВКИ САНКЦИЙ ПРОТИВ РОССИИ. ВОТ ВАМ
Dialogue: 0,0:08:21.04,0:08:23.68,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ ЕДИНОДУШИЕ В НАТУРАЛЬНУЮ ВЕЛИЧИНУ.
Dialogue: 0,0:08:24.07,0:08:26.56,Caption,,0,0,0,,СНАЧАЛА РУКОВОДИТЕЛИ СТРАН ПОВЫШАЮТ ДРУГ НА ДРУГА
Dialogue: 0,0:08:26.56,0:08:30.16,Caption,,0,0,0,,ГОЛОС ИЗ ЗА ГОЛОСОВАНИЯ, А ЗАТЕМ ВЫБИРАЮТ ПОСЛАННИКА,
Dialogue: 0,0:08:30.40,0:08:32.96,Caption,,0,0,0,,КОТОРЫЙ ДОЛЖЕН ПРИЕХАТЬ К РОССИИ И УВЕРЕННО
Dialogue: 0,0:08:32.96,0:08:36.08,Caption,,0,0,0,,ПРОИЗНЕСТИ "МЫ РЕШИЛИ". КТО ИМЕННО РЕШИЛ?
Dialogue: 0,0:08:36.63,0:08:39.60,Caption,,0,0,0,,СЛОВАКИЯ ОЦЕНИВАЕТ СИТУАЦИЮ ОДНИМ ОБРАЗОМ. ГЕРМАНИЯ
Dialogue: 0,0:08:39.68,0:08:42.56,Caption,,0,0,0,,ДРУГИМ. ФРАНЦИЯ ДОБАВЛЯЕТ СОБСТВЕННЫЕ РАСЧЁТЫ.
Dialogue: 0,0:08:44.84,0:08:47.88,Caption,,0,0,0,,ПРИБАЛТИЙСКИЕ СТРАНЫ ТРЕБУЮТ СВОЕГО КУРСА. ОБЩИЙ
Dialogue: 0,0:08:47.88,0:08:50.60,Caption,,0,0,0,,ЗНАМЕНАТЕЛЬ ПОКА ПОЛУЧАЕТСЯ РАЗВЕ ЧТО НА ИТОГОВОЙ
Dialogue: 0,0:08:50.60,0:08:54.04,Caption,,0,0,0,,ФОТОГРАФИИ, ГДЕ ВСЕМ ХВАТАЕТ МЕСТА И НИКТО НЕ ОБЯЗАН
Dialogue: 0,0:08:54.04,0:08:57.08,Caption,,0,0,0,,ОТВЕЧАТЬ НА НЕУДОБНЫЙ ВОПРОС. ФИЦО СЧИТАЕТ,
Dialogue: 0,0:08:57.27,0:09:00.12,Caption,,0,0,0,,ЧТО НЕКОТОРЫЕ СИЛЫ ЗАИНТЕРЕСОВАНЫ В ПРОДОЛЖЕНИИ
Dialogue: 0,0:09:00.12,0:09:03.32,Caption,,0,0,0,,КОНФЛИКТА РАДИ ДЕНЕГ И ВЛИЯНИЯ. ЭТО ЕГО ОЦЕНКА.
Dialogue: 0,0:09:03.48,0:09:06.28,Caption,,0,0,0,,НО САМ ФАКТ ПОДОБНЫХ ОБВИНЕНИЙ МЕЖДУ ЕВРОПЕЙСКИМИ
Dialogue: 0,0:09:06.28,0:09:09.40,Caption,,0,0,0,,РУКОВОДИТЕЛЯМИ ПОКАЗЫВАЕТ СОСТОЯНИЕ ЕВРОСОЮЗА
Dialogue: 0,0:09:09.40,0:09:12.60,Caption,,0,0,0,,ТОЧНЕЕ, ЧЕМ ДЕСЯТОК ЗАЯВЛЕНИЙ О ПОЛНОМ ЕДИНСТВЕ.
Dialogue: 0,0:09:13.16,0:09:15.40,Caption,,0,0,0,,ПОЭТОМУ СПОР О ПЕРЕГОВОРЩИКЕ СТАЛ ТАКИМ
Dialogue: 0,0:09:15.40,0:09:18.20,Caption,,0,0,0,,ОЖЕСТОЧЁННЫМ. А ПРЕДСТАВЛЕНИЯ БЕРЛИНА,
Dialogue: 0,0:09:18.36,0:09:22.12,Caption,,0,0,0,,ПАРИЖА, БРАТИСЛАВЫ И ТАЛЛИНА ОБ ЭТИХ ИНТЕРЕСАХ ЗАМЕТНО
Dialogue: 0,0:09:22.12,0:09:25.56,Caption,,0,0,0,,РАСХОДЯТСЯ. ТОТ, КТО ЗАЙМЁТ МЕСТО ЗА СТОЛОМ,
Dialogue: 0,0:09:25.80,0:09:28.84,Caption,,0,0,0,,СМОЖЕТ ВЫДАТЬ СОБСТВЕННЫЙ ПРИОРИТЕТ ЗА ОБЩИЙ. ТЕПЕРЬ
Dialogue: 0,0:09:28.84,0:09:31.88,Caption,,0,0,0,,ПОНЯТНО, ПОЧЕМУ ДОБРОВОЛЬЦЕВ НЕОЖИДАННО ТАК МНОГО.
Dialogue: 0,0:09:32.66,0:09:35.24,Caption,,0,0,0,,КИЕВ ТЕМ ВРЕМЕНЕМ ПОКАЗЫВАЕТ СРАЗУ ДВЕ ВЕРСИИ
Dialogue: 0,0:09:35.24,0:09:37.32,Caption,,0,0,0,,БУДУЩЕГО. ПО ВЕРСИИ ЗЕЛЕНСКОГО,
Dialogue: 0,0:09:37.48,0:09:39.80,Caption,,0,0,0,,В ПЕРЕГОВОРАХ ЕСТЬ ПРОДВИЖЕНИЕ. ПО ВЕРСИИ
Dialogue: 0,0:09:39.80,0:09:41.96,Caption,,0,0,0,,ЗАМЕСТИТЕЛЯ ГЛАВЫ ЕГО ОФИСА ВЕРЕЩУК,
Dialogue: 0,0:09:42.33,0:09:45.00,Caption,,0,0,0,,УКРАИНЦАМ НЕ СЛЕДУЕТ ЖДАТЬ СКОРОГО МИРА. ОНА
Dialogue: 0,0:09:45.00,0:09:47.56,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ О РОСТЕ РОССИЙСКОГО ПРОИЗВОДСТВА РАКЕТ
Dialogue: 0,0:09:47.56,0:09:51.24,Caption,,0,0,0,,И БЕСПИЛОТНИКОВ, ПОВРЕЖДЁННОЙ ИНФРАСТРУКТУРЕ И ТЯЖЁЛОЙ ЗИМЕ.
Dialogue: 0,0:09:51.50,0:09:53.56,Caption,,0,0,0,,НАСЕЛЕНИЮ СОВЕТУЮТ ЗАПАСАТЬ ВОДУ,
Dialogue: 0,0:09:53.80,0:09:56.52,Caption,,0,0,0,,ГОТОВИТЬСЯ К ПЕРЕБОЯМ И НЕ РАССЧИТЫВАТЬ НА БЫСТРЫЙ
Dialogue: 0,0:09:56.52,0:09:59.69,Caption,,0,0,0,,ИСХОД. ЗНАЧИТ,
Dialogue: 0,0:09:59.84,0:10:01.77,Caption,,0,0,0,,ЗА СТОЛОМ ФИКСИРУЮТ ПРОДВИЖЕНИЕ,
Dialogue: 0,0:10:01.99,0:10:05.61,Caption,,0,0,0,,А ДОМА ПРОВЕРЯЮТ, ХВАТИТ ЛИ ЗАПАСОВ НА ПРОДОЛЖЕНИЕ КОНФЛИКТА.
Dialogue: 0,0:10:05.98,0:10:10.33,Caption,,0,0,0,,ПРОТИВОРЕЧИЯ ТУТ НЕТ. РУКОВОДСТВО ВЕДЁТ ПЕРЕГОВОРЫ И ОДНОВРЕМЕННО ИСХОДИТ
Dialogue: 0,0:10:10.33,0:10:14.73,Caption,,0,0,0,,ИЗ ХУДШЕГО СЦЕНАРИЯ. БЫЛО БЫ СТРАННО ЗАКРЫТЬ СКЛАДЫ СРАЗУ ПОСЛЕ ПЕРВОЙ
Dialogue: 0,0:10:14.73,0:10:17.69,Caption,,0,0,0,,ОБНАДЁЖИВАЮЩЕЙ ВСТРЕЧИ. ТОЛЬКО ОБЫЧНОМУ ЧЕЛОВЕКУ ОТ
Dialogue: 0,0:10:17.69,0:10:20.81,Caption,,0,0,0,,ТАКОЙ ПРЕДУСМОТРИТЕЛЬНОСТИ НЕ ТЕПЛЕЕ. ЕМУ СООБЩАЮТ,
Dialogue: 0,0:10:21.04,0:10:25.45,Caption,,0,0,0,,ЧТО ПРОЦЕСС ИДЁТ ХОРОШО, А ЗАТЕМ ПРЕДЛАГАЮТ НАПОЛНИТЬ КАНИСТРЫ И
Dialogue: 0,0:10:25.45,0:10:27.45,Caption,,0,0,0,,ПРИГОТОВИТЬСЯ К НОВОЙ ТЯЖЁЛОЙ ЗИМЕ.
Dialogue: 0,0:10:28.13,0:10:30.57,Caption,,0,0,0,,ОЧЕНЬ УБЕДИТЕЛЬНЫЙ ПЕРЕВОД СЛОВА "ПРОГРЕСС" НА
Dialogue: 0,0:10:30.57,0:10:34.01,Caption,,0,0,0,,БЫТОВОЙ ЯЗЫК. СЛЕДОМ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНО ЗАЯВЛЕНИЕ.
Dialogue: 0,0:10:34.31,0:10:37.45,Caption,,0,0,0,,ДЕПУТАТ ВЕРХОВНОЙ РАДЫ ЧЕРНЕВ ОТВОДИТ РОССИИ ПОЛТОРА
Dialogue: 0,0:10:37.45,0:10:40.49,Caption,,0,0,0,,МЕСЯЦА НА ЗАВЕРШЕНИЕ КОНФЛИКТА НА ПРИЕМЛЕМЫХ
Dialogue: 0,0:10:40.49,0:10:43.21,Caption,,0,0,0,,УСЛОВИЯХ. ПОСЛЕ ЭТОГО, ПО ЕГО РАСЧЁТУ,
Dialogue: 0,0:10:43.45,0:10:46.09,Caption,,0,0,0,,ДЕМОКРАТЫ В СОЕДИНЁННЫХ ШТАТАХ ОБЕСПЕЧАТ УКРАИНЕ
Dialogue: 0,0:10:46.09,0:10:49.93,Caption,,0,0,0,,НОВУЮ ПОМОЩЬ, А МОСКВА СТОЛКНЁТСЯ С ДОПОЛНИТЕЛЬНЫМИ САНКЦИЯМИ.
Dialogue: 0,0:10:50.22,0:10:53.45,Caption,,0,0,0,,ВЫХОДИТ, РЯДОМ С ПЕРЕГОВОРАМИ РАБОТАЕТ ВТОРОЙ ОТСЧЁТ,
Dialogue: 0,0:10:53.61,0:10:56.17,Caption,,0,0,0,,СВЯЗАННЫЙ УЖЕ С АМЕРИКАНСКОЙ ВНУТРЕННЕЙ БОРЬБОЙ.
Dialogue: 0,0:10:56.66,0:10:58.81,Caption,,0,0,0,,ЧАСТЬ УКРАИНСКОЙ СТРАТЕГИИ СОСТОИТ В ТОМ,
Dialogue: 0,0:10:59.13,0:11:02.33,Caption,,0,0,0,,ЧТОБЫ ПЕРЕЖДАТЬ НЫНЕШНИЙ МОМЕНТ И ДОЖДАТЬСЯ БОЛЕЕ
Dialogue: 0,0:11:02.33,0:11:04.97,Caption,,0,0,0,,ВЫГОДНОГО ПОЛОЖЕНИЯ В ВАШИНГТОНЕ. НЕ ПРИНИМАТЬ
Dialogue: 0,0:11:04.97,0:11:09.85,Caption,,0,0,0,,ДОСТУПНЫЕ УСЛОВИЯ СЕЙЧАС, А ТЯНУТЬ ВРЕМЯ ДО ПОЯВЛЕНИЯ НОВОГО ПАКЕТА ПОМОЩИ
Dialogue: 0,0:11:10.09,0:11:12.73,Caption,,0,0,0,,И ОЧЕРЕДНОГО ДАВЛЕНИЯ НА РОССИЮ. ЗВУЧИТ БОДРО.
Dialogue: 0,0:11:15.02,0:11:18.62,Caption,,0,0,0,,ПРАВДА, КАЛЕНДАРЬ ИМЕЕТСЯ НЕ ТОЛЬКО У КИЕВА. ЕСЛИ УКРАИНСКИЕ
Dialogue: 0,0:11:18.62,0:11:22.38,Caption,,0,0,0,,ВЛАСТИ УВЕРЕНЫ, ЧТО ЧЕРЕЗ ПОЛТОРА МЕСЯЦА ИХ ПОЗИЦИИ УЛУЧШАТСЯ,
Dialogue: 0,0:11:22.70,0:11:25.58,Caption,,0,0,0,,МОСКВА ТОЖЕ СПОСОБНА ПРОСЧИТАТЬ ЭТОТ СРОК И
Dialogue: 0,0:11:25.58,0:11:28.38,Caption,,0,0,0,,ИСПОЛЬЗОВАТЬ ЕГО В СВОИХ ИНТЕРЕСАХ. РОССИЯ НЕ
Dialogue: 0,0:11:28.38,0:11:30.94,Caption,,0,0,0,,ОБЯЗАНА СИДЕТЬ С СЕКУНДОМЕРОМ И ПОКОРНО ЖДАТЬ,
Dialogue: 0,0:11:31.11,0:11:33.82,Caption,,0,0,0,,КОГДА СОПЕРНИКУ СТАНЕТ УДОБНЕЕ. КРОМЕ ТОГО,
Dialogue: 0,0:11:34.06,0:11:36.94,Caption,,0,0,0,,САНКЦИОННОЕ ДАВЛЕНИЕ ПРОДОЛЖАЕТСЯ УЖЕ МНОГО ЛЕТ.
Dialogue: 0,0:11:37.16,0:11:40.06,Caption,,0,0,0,,ОБЕЩАНИЕ ДОБАВИТЬ ЕЩЁ ОДИН ПАКЕТ ЕДВА ЛИ ДЕЙСТВУЕТ
Dialogue: 0,0:11:40.14,0:11:42.94,Caption,,0,0,0,,НА КРЕМЛЬ КАК СЕКРЕТНАЯ КНОПКА. ТАМ НЕ ХЛОПНУТ
Dialogue: 0,0:11:43.02,0:11:45.02,Caption,,0,0,0,,СЕБЯ ПО ЛБУ СО СЛОВАМИ "А ВОТ ЕЩЁ
Dialogue: 0,0:11:45.02,0:11:47.42,Caption,,0,0,0,,ОДНИ ОГРАНИЧЕНИЯ МЫ СОВСЕМ НЕ ПРЕДУСМОТРЕЛИ".
Dialogue: 0,0:11:48.01,0:11:50.14,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО НА УКРАИНЕ ПРОДВИГАЮТ МЫСЛЬ,
Dialogue: 0,0:11:50.46,0:11:52.46,Caption,,0,0,0,,ЧТО МИР СЕГОДНЯ НУЖНЕЕ РОССИИ,
Dialogue: 0,0:11:52.64,0:11:55.50,Caption,,0,0,0,,ЧЕМ САМОМУ КИЕВУ. ДЛЯ ПЕРЕГОВОРОВ ТАКАЯ ПОЗИЦИЯ
Dialogue: 0,0:11:55.58,0:11:57.90,Caption,,0,0,0,,ВЫГОДНА. ЕСЛИ ТОРОПИТСЯ ПРОТИВНИК,
Dialogue: 0,0:11:58.15,0:12:02.70,Caption,,0,0,0,,МОЖНО ПОДНИМАТЬ ТРЕБОВАНИЯ, ОТКЛАДЫВАТЬ РЕШЕНИЯ И ЖДАТЬ ПЕРЕМЕН В СОЕДИНЁННЫХ
Dialogue: 0,0:12:02.70,0:12:05.50,Caption,,0,0,0,,ШТАТАХ. НО ТОГДА ПРИХОДИТСЯ ПОСМОТРЕТЬ НА ПОЛОЖЕНИЕ
Dialogue: 0,0:12:05.50,0:12:07.50,Caption,,0,0,0,,УКРАИНЫ БЕЗ УДОБНОГО ОСВЕЩЕНИЯ.
Dialogue: 0,0:12:08.30,0:12:11.10,Caption,,0,0,0,,ВЕРЕЩУК ПРЕДУПРЕЖДАЕТ О СЛОЖНОЙ ЗИМЕ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:12:11.10,0:12:13.58,Caption,,0,0,0,,ТРЕБУЕТ ВОЗВРАЩЕНИЯ МУЖЧИН МОБИЛИЗАЦИОННОГО
Dialogue: 0,0:12:13.58,0:12:16.86,Caption,,0,0,0,,ВОЗРАСТА. ЭНЕРГЕТИЧЕСКАЯ И ДРУГАЯ ИНФРАСТРУКТУРА
Dialogue: 0,0:12:16.86,0:12:19.90,Caption,,0,0,0,,ПОВРЕЖДЕНА. СТРАНЕ ПОСТОЯННО НУЖНЫ ЛЮДИ,
Dialogue: 0,0:12:19.98,0:12:23.10,Caption,,0,0,0,,СРЕДСТВА И ВООРУЖЕНИЯ. НА ТАКОМ ФОНЕ УВЕРЯТЬ
Dialogue: 0,0:12:23.11,0:12:26.78,Caption,,0,0,0,,ОБЩЕСТВО, ЧТО ВРЕМЯ НАНОСИТ УЩЕРБ ИСКЛЮЧИТЕЛЬНО РОССИИ,
Dialogue: 0,0:12:27.00,0:12:31.78,Caption,,0,0,0,,ДОВОЛЬНО СМЕЛО. ЧАСЫ ТИКАЮТ ПО ОБЕ СТОРОНЫ,
Dialogue: 0,0:12:31.94,0:12:34.66,Caption,,0,0,0,,ПРОСТО КАЖДЫЙ УЧАСТНИК СТАРАЕТСЯ ПОДНЕСТИ К КАМЕРЕ
Dialogue: 0,0:12:34.66,0:12:37.94,Caption,,0,0,0,,ЧУЖОЙ ЦИФЕРБЛАТ. ОСОБЕННО НАГЛЯДНО ЭТО ПРОЯВИЛОСЬ В
Dialogue: 0,0:12:37.94,0:12:39.62,Caption,,0,0,0,,ИСТОРИИ С УКРАИНСКИМИ МУЖЧИНАМИ,
Dialogue: 0,0:12:39.86,0:12:44.10,Caption,,0,0,0,,НАХОДЯЩИМИСЯ В ЕВРОПЕ. ЗЕЛЕНСКИЙ ПРИЗЫВАЕТ ГРАЖДАН МОБИЛИЗАЦИОННОГО
Dialogue: 0,0:12:44.10,0:12:47.38,Caption,,0,0,0,,ВОЗРАСТА ВЕРНУТЬСЯ НА УКРАИНУ. ПРЕМЬЕР ИРЛАНДИИ
Dialogue: 0,0:12:47.38,0:12:50.66,Caption,,0,0,0,,ОТВЕЧАЕТ, ЧТО ЕГО СТРАНА НЕ СТАНЕТ ОТПРАВЛЯТЬ ИХ ОБРАТНО
Dialogue: 0,0:12:50.66,0:12:54.18,Caption,,0,0,0,,ПРИНУДИТЕЛЬНО. УКРАИНЕ ТРЕБУЮТСЯ ЛЮДИ. ИРЛАНДИЯ
Dialogue: 0,0:12:54.18,0:12:57.30,Caption,,0,0,0,,НАПОМИНАЕТ О СОБСТВЕННЫХ ЗАКОНАХ И ОТКАЗЫВАЕТСЯ
Dialogue: 0,0:12:57.30,0:12:59.94,Caption,,0,0,0,,ПРЕВРАЩАТЬ АЭРОПОРТ В ПУНКТ ВЫДАЧИ ГРАЖДАН ПО
Dialogue: 0,0:12:59.94,0:13:03.06,Caption,,0,0,0,,ТРЕБОВАНИЮ КИЕВА. РЕАЛЬНАЯ ЕВРОПА СОСТОИТ НЕ ИЗ
Dialogue: 0,0:13:03.06,0:13:05.54,Caption,,0,0,0,,ОДНОЙ ФАМИЛИИ И НЕ ИЗ ОДНОГО КАБИНЕТА В
Dialogue: 0,0:13:05.54,0:13:08.90,Caption,,0,0,0,,БРЮССЕЛЕ. ЭТО ДВАДЦАТЬ СЕМЬ ГОСУДАРСТВ С РАЗНЫМИ
Dialogue: 0,0:13:08.90,0:13:12.98,Caption,,0,0,0,,ЗАКОНАМИ, ИНТЕРЕСАМИ, СТРАХАМИ И ПРЕДЕЛАМИ ДОПУСТИМОГО.
Dialogue: 0,0:13:13.53,0:13:16.26,Caption,,0,0,0,,ТЕПЕРЬ ОТ ЭТОЙ КОНСТРУКЦИИ ХОТЯТ ПОЛУЧИТЬ ОДИН ГОЛОС
Dialogue: 0,0:13:16.26,0:13:19.38,Caption,,0,0,0,,НА ПЕРЕГОВОРАХ. РАБОТА ПОЧТИ ЮВЕЛИРНАЯ. ТОЛЬКО
Dialogue: 0,0:13:19.38,0:13:22.58,Caption,,0,0,0,,ДЕТАЛИ ВСЁ ВРЕМЯ СПОРЯТ, КТО ИЗ НИХ ЗДЕСЬ МЕХАНИЗМ,
Dialogue: 0,0:13:22.72,0:13:25.06,Caption,,0,0,0,,А КТО МАСТЕР. И ВСЁ ЖЕ ЗА ИРОНИЕЙ
Dialogue: 0,0:13:25.06,0:13:27.70,Caption,,0,0,0,,НЕЛЬЗЯ ПОТЕРЯТЬ ГЛАВНЫЙ РЕЗУЛЬТАТ. ОТНОШЕНИЕ К
Dialogue: 0,0:13:27.70,0:13:30.50,Caption,,0,0,0,,ПЕРЕГОВОРАМ ДЕЙСТВИТЕЛЬНО ИЗМЕНИЛОСЬ. ЕВРОПЕЙСКИЕ
Dialogue: 0,0:13:30.50,0:13:32.82,Caption,,0,0,0,,РУКОВОДИТЕЛИ БОЛЬШЕ НЕ ОГРАНИЧИВАЮТСЯ СПОРОМ О
Dialogue: 0,0:13:32.82,0:13:35.30,Caption,,0,0,0,,ДОПУСТИМОСТИ КОНТАКТОВ С МОСКВОЙ. ТЕПЕРЬ ОНИ
Dialogue: 0,0:13:35.30,0:13:39.46,Caption,,0,0,0,,ВЫЯСНЯЮТ, КТО ИМЕННО БУДЕТ ЭТИ КОНТАКТЫ ВЕСТИ. ОБСУЖДАЕТСЯ
Dialogue: 0,0:13:39.46,0:13:45.41,Caption,,0,0,0,,СЛЕДУЮЩИЙ РАУНД. АМЕРИКАНСКИЕ ПОСРЕДНИКИ ЕЗДЯТ МЕЖДУ РОССИЙСКОЙ,
Dialogue: 0,0:13:45.49,0:13:48.45,Caption,,0,0,0,,УКРАИНСКОЙ И ЕВРОПЕЙСКОЙ СТОРОНАМИ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:13:48.45,0:13:51.41,Caption,,0,0,0,,ПРИЗНАЁТ НАЛИЧИЕ ПРОДВИЖЕНИЯ. МОСКВА ПРОДОЛЖАЕТ
Dialogue: 0,0:13:51.41,0:13:54.45,Caption,,0,0,0,,ВЫДВИГАТЬ ТРЕБОВАНИЯ ПО БЕЗОПАСНОСТИ. ДАЖЕ БОРЬБА
Dialogue: 0,0:13:54.53,0:13:57.65,Caption,,0,0,0,,ЕВРОПЕЙЦЕВ ЗА ПРАВО УЧАСТВОВАТЬ ГОВОРИТ О МНОГОМ. ЗА
Dialogue: 0,0:13:57.65,0:14:00.61,Caption,,0,0,0,,БЕСПОЛЕЗНОЕ МЕСТО ОБЫЧНО ТАК НЕ ТОЛКАЮТСЯ. ЕСЛИ
Dialogue: 0,0:14:00.61,0:14:02.69,Caption,,0,0,0,,КАНДИДАТОВ ВНЕЗАПНО СТАЛО ТЕСНО,
Dialogue: 0,0:14:02.93,0:14:05.33,Caption,,0,0,0,,ЗНАЧИТ РЕШЕНИЯ ТАМ ДЕЙСТВИТЕЛЬНО МОГУТ ИМЕТЬ
Dialogue: 0,0:14:05.33,0:14:08.21,Caption,,0,0,0,,ЗНАЧЕНИЕ. НО СОБРАТЬ УЧАСТНИКОВ В ОДНОЙ КОМНАТЕ
Dialogue: 0,0:14:08.21,0:14:10.93,Caption,,0,0,0,,ЛЕГЧЕ, ЧЕМ ЗАСТАВИТЬ ИХ ОТВЕЧАТЬ НА ОДИН И ТОТ
Dialogue: 0,0:14:11.01,0:14:14.85,Caption,,0,0,0,,ЖЕ ВОПРОС. КИЕВ СОСРЕДОТОЧЕН НА СОБСТВЕННЫХ УСЛОВИЯХ И
Dialogue: 0,0:14:14.85,0:14:18.05,Caption,,0,0,0,,БЛИЖАЙШИХ ВОЕННЫХ РИСКАХ. РОССИЯ ТРЕБУЕТ МЕНЯТЬ
Dialogue: 0,0:14:18.13,0:14:21.17,Caption,,0,0,0,,ОБЩИЕ ПРАВИЛА БЕЗОПАСНОСТИ. ЕВРОПЕЙСКИЕ ГОСУДАРСТВА
Dialogue: 0,0:14:21.17,0:14:24.29,Caption,,0,0,0,,РАСХОДЯТСЯ МЕЖДУ СОБОЙ. СОЕДИНЁННЫЕ ШТАТЫ ПЫТАЮТСЯ
Dialogue: 0,0:14:24.29,0:14:26.93,Caption,,0,0,0,,СОБРАТЬ ИЗ ЭТИХ ПОЗИЦИЙ ХОТЬ КАКУЮ ТО РАБОЧУЮ
Dialogue: 0,0:14:26.93,0:14:29.97,Caption,,0,0,0,,КОМБИНАЦИЮ. ПОЭТОМУ ГЛАВНЫМ СОБЫТИЕМ ПОСЛЕДНИХ ДНЕЙ
Dialogue: 0,0:14:30.05,0:14:33.01,Caption,,0,0,0,,СТАЛ НЕ ОБЪЯВЛЕННЫЙ ПРОРЫВ И НЕ ОЧЕРЕДНАЯ
Dialogue: 0,0:14:33.01,0:14:35.81,Caption,,0,0,0,,ТОРЖЕСТВЕННАЯ ФРАЗА О БЛИЗКОМ МИРЕ. ГЛАВНОЕ В
Dialogue: 0,0:14:35.89,0:14:39.17,Caption,,0,0,0,,ДРУГОМ. УЧАСТНИКИ ПЕРЕСТАЛИ СТОЯТЬ НА МЕСТЕ. ТЕПЕРЬ
Dialogue: 0,0:14:39.17,0:14:42.93,Caption,,0,0,0,,ПРЕДСТОИТ ПОНЯТЬ, ИДУТ ЛИ ОНИ К СОГЛАШЕНИЮ ИЛИ ПРОСТО СПЕШАТ
Dialogue: 0,0:14:42.93,0:14:45.49,Caption,,0,0,0,,ЗАНЯТЬ СТУЛ, ПОКА НА НЁМ НЕ УСТРОИЛСЯ СОСЕД.
