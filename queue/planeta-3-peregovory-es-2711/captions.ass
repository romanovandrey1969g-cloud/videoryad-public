Dialogue: 0,0:00:00.12,0:00:02.44,Caption,,0,0,0,,ИНТЕРЕСНО, В ВАШИНГТОНЕ УЖЕ ПОНЯЛИ,
Dialogue: 0,0:00:02.56,0:00:04.76,Caption,,0,0,0,,КАКУЮ УСЛУГУ САМИ СЕБЕ ОКАЗАЛИ,
Dialogue: 0,0:00:04.99,0:00:06.76,Caption,,0,0,0,,КОГДА ПОЗВАЛИ ЕВРОПУ К ПЕРЕГОВОРАМ?
Dialogue: 0,0:00:07.22,0:00:10.34,Caption,,0,0,0,,НАВЕРНОЕ, РАССЧИТЫВАЛИ ПОЛУЧИТЬ ПОМОЩНИКОВ. А
Dialogue: 0,0:00:10.34,0:00:13.72,Caption,,0,0,0,,ПОЛУЧИЛИ ЕЩЁ ОДНУ СТОРОНУ, КОТОРОЙ СНАЧАЛА НАДО ОБЪЯСНИТЬ,
Dialogue: 0,0:00:13.98,0:00:16.00,Caption,,0,0,0,,ЧТО ПРИГЛАШЕНИЕ ЗА СТОЛ НЕ ОЗНАЧАЕТ
Dialogue: 0,0:00:16.00,0:00:17.96,Caption,,0,0,0,,ПРАВО НЕМЕДЛЕННО ПЕРЕДВИНУТЬ СТОЛ,
Dialogue: 0,0:00:18.12,0:00:20.29,Caption,,0,0,0,,ЗАМЕНИТЬ МЕНЮ И ВЫСТАВИТЬ ХОЗЯИНУ
Dialogue: 0,0:00:20.29,0:00:22.89,Caption,,0,0,0,,СЧЁТ. ПРИЧЁМ ЕВРОПЕЙСКОЙ ГОЛОВНОЙ БОЛЬЮ СПИСОК
Dialogue: 0,0:00:22.89,0:00:26.04,Caption,,0,0,0,,АМЕРИКАНСКИХ ЗАБОТ ТОЛЬКО НАЧИНАЕТСЯ. ЕСЛИ ВАМ НРАВЯТСЯ
Dialogue: 0,0:00:26.04,0:00:28.89,Caption,,0,0,0,,РАЗБОРЫ, ГДЕ ЗА ОФИЦИАЛЬНЫМИ ФРАЗАМИ ИЩУТ
Dialogue: 0,0:00:28.89,0:00:31.08,Caption,,0,0,0,,ИНТЕРЕСЫ, РЫЧАГИ И ПОСЛЕДСТВИЯ,
Dialogue: 0,0:00:31.28,0:00:34.44,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ ЗАЯВЛЕНИЯ УЧАСТНИКОВ РАСХОДЯТСЯ С
Dialogue: 0,0:00:34.44,0:00:36.44,Caption,,0,0,0,,ЛОГИКОЙ ПРОИСХОДЯЩЕГО ТАК ДАЛЕКО,
Dialogue: 0,0:00:36.76,0:00:38.53,Caption,,0,0,0,,ЧТО МЕЖДУ НИМИ УЖЕ ВПОРУ ЗАПУСКАТЬ
Dialogue: 0,0:00:38.53,0:00:41.83,Caption,,0,0,0,,ОТДЕЛЬНЫЙ АВТОБУС. УРСУЛА ФОН ДЕР ЛЯЙЕН ЗАРАНЕЕ
Dialogue: 0,0:00:41.83,0:00:45.40,Caption,,0,0,0,,СООБЩИЛА МОСКВЕ, КАКИМ ДОЛЖЕН БЫТЬ ВСТУПИТЕЛЬНЫЙ ВЗНОС
Dialogue: 0,0:00:45.40,0:00:47.74,Caption,,0,0,0,,ЗА ПРАВО СЧИТАТЬСЯ СЕРЬЁЗНЫМ УЧАСТНИКОМ
Dialogue: 0,0:00:47.74,0:00:50.38,Caption,,0,0,0,,ПЕРЕГОВОРОВ. РОССИЯ ДОЛЖНА ПРЕКРАТИТЬ УДАРЫ ПО
Dialogue: 0,0:00:50.38,0:00:52.91,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКОЙ ИНФРАСТРУКТУРЕ НА ВСЮ ЗИМУ И
Dialogue: 0,0:00:52.91,0:00:55.55,Caption,,0,0,0,,ГАРАНТИРОВАТЬ БЕЗОПАСНЫЙ ПРОХОД ПРОДОВОЛЬСТВЕННЫХ
Dialogue: 0,0:00:55.55,0:00:58.36,Caption,,0,0,0,,СУДОВ ЧЕРЕЗ ЧЁРНОЕ МОРЕ. ЛИШЬ ПОСЛЕ ЭТОГО,
Dialogue: 0,0:00:58.52,0:01:01.50,Caption,,0,0,0,,ПО ЕЁ ЛОГИКЕ, МОЖНО БУДЕТ ОБСУЖДАТЬ СЕРЬЁЗНОСТЬ
Dialogue: 0,0:01:01.50,0:01:04.59,Caption,,0,0,0,,РОССИЙСКИХ НАМЕРЕНИЙ. УДОБНО УСТРОЕНО. СНАЧАЛА
Dialogue: 0,0:01:04.59,0:01:08.37,Caption,,0,0,0,,ИСПОЛНЯЕТЕ ТРЕБОВАНИЯ, ЗАТЕМ ПОЛУЧАЕТЕ ВОЗМОЖНОСТЬ ПОГОВОРИТЬ
Dialogue: 0,0:01:08.37,0:01:10.28,Caption,,0,0,0,,С ТЕМИ, КТО ЭТИ ТРЕБОВАНИЯ ПРИДУМАЛ.
Dialogue: 0,0:01:12.56,0:01:14.73,Caption,,0,0,0,,ОСТАЛОСЬ ТОЛЬКО ВЫДАТЬ МОСКВЕ ТАЛОНЧИК
Dialogue: 0,0:01:14.73,0:01:17.04,Caption,,0,0,0,,И ПОПРОСИТЬ НЕ ЗАНИМАТЬ ОЧЕРЕДЬ ПОВТОРНО.
Dialogue: 0,0:01:17.74,0:01:21.84,Caption,,0,0,0,,НО КТО СКАЗАЛ ФОН ДЕР ЛЯЙЕН, ЧТО РОССИЯ ВООБЩЕ ДОБИВАЕТСЯ РАЗГОВОРА
Dialogue: 0,0:01:21.84,0:01:24.72,Caption,,0,0,0,,ИМЕННО С НЕЙ? СНАЧАЛА НЕПЛОХО БЫЛО БЫ ВЫЯСНИТЬ,
Dialogue: 0,0:01:25.04,0:01:27.01,Caption,,0,0,0,,СПОСОБНА ЛИ ЕВРОКОМИССИЯ ПРЕДЛОЖИТЬ
Dialogue: 0,0:01:27.01,0:01:30.32,Caption,,0,0,0,,ЧТО НИБУДЬ КРОМЕ СПИСКА ПРЕДВАРИТЕЛЬНЫХ УСЛОВИЙ. ПОТОМУ
Dialogue: 0,0:01:30.32,0:01:34.09,Caption,,0,0,0,,ЧТО СПИСОК УЖЕ ЕСТЬ, А ПРЕДМЕТА РАЗГОВОРА ПОКА НЕ ВИДНО.
Dialogue: 0,0:01:34.09,0:01:37.26,Caption,,0,0,0,,ЛАВРОВ ОПИСЫВАЕТ ПОДХОД МОСКВЫ ИНАЧЕ. РОССИЯ ХОЧЕТ
Dialogue: 0,0:01:37.26,0:01:40.64,Caption,,0,0,0,,ЗАРАНЕЕ ПОНЯТЬ, КАКУЮ ФУНКЦИЮ ЕВРОПА СОБИРАЕТСЯ
Dialogue: 0,0:01:40.64,0:01:43.83,Caption,,0,0,0,,ВЫПОЛНЯТЬ И С КАКОЙ ПОЗИЦИЕЙ НАМЕРЕНА ПОЯВИТЬСЯ НА
Dialogue: 0,0:01:43.83,0:01:46.78,Caption,,0,0,0,,ПЕРЕГОВОРАХ. ЭТО НЕ СПОР О РАССАДКЕ И НЕ КАПРИЗ
Dialogue: 0,0:01:46.78,0:01:50.08,Caption,,0,0,0,,ПРОТОКОЛЬНОЙ СЛУЖБЫ. МОСКВА, ПО СЛОВАМ ЛАВРОВА,
Dialogue: 0,0:01:50.37,0:01:52.40,Caption,,0,0,0,,ПЕРЕГОВОРОВ С ЕВРОКОМИССИЕЙ ПО УКРАИНЕ
Dialogue: 0,0:01:52.40,0:01:55.01,Caption,,0,0,0,,ВООБЩЕ НЕ ПРОВОДИЛА. ЗАТО ПРЕДСТАВИТЕЛЬНАЯ
Dialogue: 0,0:01:55.01,0:01:57.28,Caption,,0,0,0,,ГРУППА УЖЕ СФОРМИРОВАЛАСЬ ФРАНЦИЯ,
Dialogue: 0,0:01:57.40,0:02:00.00,Caption,,0,0,0,,ГЕРМАНИЯ, БРИТАНИЯ, ИТАЛИЯ,
Dialogue: 0,0:02:00.16,0:02:03.60,Caption,,0,0,0,,ПОЛЬША, ЕВРОСОЮЗ И НАТО. ЛАВРОВ ЗАМЕТИЛ,
Dialogue: 0,0:02:03.76,0:02:06.15,Caption,,0,0,0,,ЧТО ВМЕСТО ПЯТЁРКИ ПОЛУЧИЛАСЬ ЦЕЛАЯ
Dialogue: 0,0:02:06.15,0:02:08.68,Caption,,0,0,0,,СЕМЁРКА. СЕМЬ УЧАСТНИКОВ ЕЩЁ НЕ ДОБРАЛИСЬ ДО
Dialogue: 0,0:02:08.68,0:02:11.42,Caption,,0,0,0,,СТУЛЬЕВ, ЗАТО ДОМАШНЕЕ ЗАДАНИЕ РОССИИ УЖЕ
Dialogue: 0,0:02:11.42,0:02:14.67,Caption,,0,0,0,,ПРОВЕРИЛИ КРАСНОЙ РУЧКОЙ. ВЫСШИЙ КЛАСС. ПЕРСПЕКТИВУ
Dialogue: 0,0:02:14.67,0:02:17.78,Caption,,0,0,0,,ТАКОГО УЧАСТИЯ ЛАВРОВ ОБРИСОВАЛ БЕЗ РЕВЕРАНСОВ.
Dialogue: 0,0:02:17.78,0:02:20.26,Caption,,0,0,0,,ЕВРОПА ПРИДЁТ И НЕМЕДЛЕННО ПОЛОЖИТ НОГИ НА
Dialogue: 0,0:02:20.26,0:02:22.64,Caption,,0,0,0,,ПЕРЕГОВОРНЫЙ СТОЛ. ОСОБЕННО ЗАНЯТНО,
Dialogue: 0,0:02:22.80,0:02:24.56,Caption,,0,0,0,,ЧТО ЕВРОПЕЙЦАМ ПРЕДЛАГАЛИ СНАЧАЛА
Dialogue: 0,0:02:24.56,0:02:29.64,Caption,,0,0,0,,ПРОСТО ИЗЛОЖИТЬ СВОЮ ПОЗИЦИЮ. УШАКОВ УТВЕРЖДАЕТ,
Dialogue: 0,0:02:29.88,0:02:32.34,Caption,,0,0,0,,ЧТО ПРЯМОГО ОТКАЗА МОСКВА НЕ УСЛЫШАЛА.
Dialogue: 0,0:02:32.34,0:02:34.36,Caption,,0,0,0,,ПУБЛИЧНЫЕ ЗАЯВЛЕНИЯ ЗВУЧАТ ОДНИ,
Dialogue: 0,0:02:34.70,0:02:36.34,Caption,,0,0,0,,А ПО ТЕЛЕФОНУ И ДРУГИМ КАНАЛАМ
Dialogue: 0,0:02:36.34,0:02:39.67,Caption,,0,0,0,,ПОСТУПАЮТ КАКИЕ ТО ИНЫЕ СИГНАЛЫ. ВОЗМОЖНОСТЬ ПРИЕХАТЬ
Dialogue: 0,0:02:39.67,0:02:42.50,Caption,,0,0,0,,И ОБЪЯСНИТЬСЯ ПО ПРЕЖНЕМУ СОХРАНЯЕТСЯ. ИНЫМИ
Dialogue: 0,0:02:42.50,0:02:44.60,Caption,,0,0,0,,СЛОВАМИ, ОТ ЕВРОПЫ ХОТЯТ УСЛЫШАТЬ,
Dialogue: 0,0:02:44.76,0:02:47.36,Caption,,0,0,0,,ЧЕГО ИМЕННО ОНА ДОБИВАЕТСЯ. В ОТВЕТ
Dialogue: 0,0:02:47.36,0:02:49.57,Caption,,0,0,0,,ЕВРОПА ПРЕДЛАГАЕТ НИЧЕГО ЗАРАНЕЕ НЕ
Dialogue: 0,0:02:49.57,0:02:52.73,Caption,,0,0,0,,ОБЪЯСНЯТЬ, СРАЗУ ПОЛУЧИТЬ МЕСТО В ПЕРЕГОВОРНОМ
Dialogue: 0,0:02:52.73,0:02:55.31,Caption,,0,0,0,,ФОРМАТЕ И ПОПУТНО ЗАСТАВИТЬ РОССИЮ ВЫПОЛНИТЬ
Dialogue: 0,0:02:55.31,0:02:59.38,Caption,,0,0,0,,НАБОР УСЛОВИЙ. РАЗГОВОР МЕЧТЫ. ОДИН УЧАСТНИК ЗАДАЁТ
Dialogue: 0,0:02:59.38,0:03:02.03,Caption,,0,0,0,,ВОПРОС, ВТОРОЙ ПРИНОСИТ ЕМУ ЭКЗАМЕНАЦИОННЫЙ
Dialogue: 0,0:03:02.03,0:03:05.29,Caption,,0,0,0,,БИЛЕТ. РЯБКОВ ВЫСКАЗАЛСЯ НЕ МЕНЕЕ ПРЯМО.
Dialogue: 0,0:03:05.29,0:03:07.80,Caption,,0,0,0,,КОНТАКТЫ РОССИИ, США И УКРАИНЫ,
Dialogue: 0,0:03:08.04,0:03:10.91,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, НЕ ПРЕКРАТИЛИСЬ. МОСКВА ГОТОВА
Dialogue: 0,0:03:10.91,0:03:14.86,Caption,,0,0,0,,ПРОДОЛЖАТЬ РАБОТУ В ФОРМАТЕ, КОТОРЫЙ УЖЕ ПРИМЕНЯЛСЯ В АБУ ДАБИ.
Dialogue: 0,0:03:14.86,0:03:17.74,Caption,,0,0,0,,ТОЛЬКО ДАТЫ СЛЕДУЮЩЕГО РАУНДА ПОКА НЕТ. ОТДЕЛЬНО
Dialogue: 0,0:03:17.74,0:03:20.27,Caption,,0,0,0,,РЯБКОВ ПРОШЁЛСЯ ПО ЕВРОПЕЙСКОЙ ЗАЯВКЕ НАЧАВ С
Dialogue: 0,0:03:20.27,0:03:23.82,Caption,,0,0,0,,УЛЬТИМАТИВНЫХ УСЛОВИЙ, ЕВРОПА САМА СВОДИТ К НУЛЮ ШАНС НА
Dialogue: 0,0:03:23.82,0:03:26.77,Caption,,0,0,0,,НОРМАЛЬНЫЙ ДИАЛОГ. КОНТАКТЫ МОСКВЫ И ВАШИНГТОНА
Dialogue: 0,0:03:26.77,0:03:29.52,Caption,,0,0,0,,ПО ВЗАИМНЫМ РАЗДРАЖИТЕЛЯМ ПРИ ЭТОМ ПРОДОЛЖАТСЯ ДО
Dialogue: 0,0:03:29.52,0:03:32.74,Caption,,0,0,0,,КОНЦА ГОДА. ВОТ И ВСЯ ХИТРАЯ КОНСТРУКЦИЯ. ЕВРОПА
Dialogue: 0,0:03:32.74,0:03:35.24,Caption,,0,0,0,,ДОБИВАЛАСЬ ДОСТУПА К ПРОЦЕССУ. КУШНЕР,
Dialogue: 0,0:03:35.34,0:03:37.80,Caption,,0,0,0,,ПОХОЖЕ, ПОМОГ ПРИОТКРЫТЬ ДЛЯ НЕЁ ДВЕРЬ.
Dialogue: 0,0:03:40.07,0:03:43.19,Caption,,0,0,0,,ТЕПЕРЬ ЕМУ ПРИХОДИТСЯ ДУМАТЬ, КАК УПРАВИТЬСЯ С ГОСТЯМИ,
Dialogue: 0,0:03:43.43,0:03:45.43,Caption,,0,0,0,,КОТОРЫЕ СТОЯТ НА ЛЕСТНИЧНОЙ ПЛОЩАДКЕ,
Dialogue: 0,0:03:45.67,0:03:47.67,Caption,,0,0,0,,НО УЖЕ ТРЕБУЮТ ПЕРЕСТАВИТЬ ДИВАН И
Dialogue: 0,0:03:47.67,0:03:50.55,Caption,,0,0,0,,ПОМЕНЯТЬ ЗАМКИ. И ДЕЛО ВОВСЕ НЕ В ОДНОЙ ФОН ДЕР
Dialogue: 0,0:03:50.55,0:03:53.27,Caption,,0,0,0,,ЛЯЙЕН. ЕВРОПЕЙСКИЕ СТОЛИЦЫ НЕ СОБИРАЮТСЯ
Dialogue: 0,0:03:53.27,0:03:55.07,Caption,,0,0,0,,РАССМАТРИВАТЬ УКРАИНСКИЙ ВОПРОС
Dialogue: 0,0:03:55.07,0:03:58.42,Caption,,0,0,0,,ОТДЕЛЬНО ОТ БУДУЩЕГО ВСЕЙ СИСТЕМЫ БЕЗОПАСНОСТИ В ЕВРОПЕ.
Dialogue: 0,0:03:58.42,0:04:00.23,Caption,,0,0,0,,МОСКВА ТОЖЕ СВЯЗЫВАЕТ ЭТИ ТЕМЫ,
Dialogue: 0,0:04:00.53,0:04:02.49,Caption,,0,0,0,,ПОЭТОМУ И ТРЕБУЕТ ЗАРАНЕЕ ОБОЗНАЧИТЬ
Dialogue: 0,0:04:02.49,0:04:04.15,Caption,,0,0,0,,СОДЕРЖАНИЕ ВОЗМОЖНОГО РАЗГОВОРА.
Dialogue: 0,0:04:04.74,0:04:06.92,Caption,,0,0,0,,НО СВЯЗЬ ТЕМ ЕЩЁ НЕ СОЗДАЁТ ОБЩЕЙ
Dialogue: 0,0:04:06.92,0:04:10.10,Caption,,0,0,0,,ПОВЕСТКИ. РОССИЯ ПРЕДЛАГАЕТ ОБСУЖДАТЬ УСТРОЙСТВО
Dialogue: 0,0:04:10.10,0:04:12.95,Caption,,0,0,0,,БЕЗОПАСНОСТИ, А ЕВРОПЕЙЦЫ НАЧИНАЮТ С ТРЕБОВАНИЙ,
Dialogue: 0,0:04:13.17,0:04:15.91,Caption,,0,0,0,,КОТОРЫЕ ДРУГАЯ СТОРОНА ДОЛЖНА ИСПОЛНИТЬ ДО НАЧАЛА
Dialogue: 0,0:04:15.91,0:04:18.44,Caption,,0,0,0,,ОБСУЖДЕНИЯ. ТАКАЯ СХЕМА НЕ ПРИБЛИЖАЕТ
Dialogue: 0,0:04:18.44,0:04:21.55,Caption,,0,0,0,,СДЕЛКУ. ОНА АККУРАТНО СТАВИТ НА ДОРОГЕ ЕЩЁ ОДИН
Dialogue: 0,0:04:21.55,0:04:24.58,Caption,,0,0,0,,ШЛАГБАУМ. ДАЛЬШЕ РАЗГОВОР СТАНОВИТСЯ ЗНАЧИТЕЛЬНО
Dialogue: 0,0:04:24.58,0:04:27.70,Caption,,0,0,0,,СЕРЬЁЗНЕЕ. ЛУКАШЕНКО ЗАГОВОРИЛ УЖЕ НЕ О ФОРМУЛИРОВКАХ В
Dialogue: 0,0:04:27.70,0:04:30.68,Caption,,0,0,0,,ЗАЯВЛЕНИЯХ, А О РАКЕТАХ И ВОЗМОЖНОМ ВЫВОДЕ
Dialogue: 0,0:04:30.68,0:04:32.63,Caption,,0,0,0,,ВООРУЖЕНИЙ. ЕМУ ЗАДАЛИ ВОПРОС,
Dialogue: 0,0:04:32.87,0:04:34.71,Caption,,0,0,0,,СОГЛАСИТСЯ ЛИ БЕЛОРУССИЯ ВЫВЕСТИ
Dialogue: 0,0:04:34.71,0:04:38.09,Caption,,0,0,0,,РОССИЙСКОЕ ОРУЖИЕ, ЕСЛИ ЗАПАД ОБЯЗУЕТСЯ НЕ РАЗМЕЩАТЬ
Dialogue: 0,0:04:38.09,0:04:41.33,Caption,,0,0,0,,РАКЕТЫ И ЯДЕРНЫЕ СРЕДСТВА ВОЗЛЕ РОССИЙСКИХ ГРАНИЦ.
Dialogue: 0,0:04:41.33,0:04:44.38,Caption,,0,0,0,,ЛУКАШЕНКО НЕ СТАЛ ОТБРАСЫВАТЬ ТАКОЙ ВАРИАНТ. ПО ЕГО
Dialogue: 0,0:04:44.38,0:04:47.19,Caption,,0,0,0,,СЛОВАМ, ГЛАВНЫМ РЕЗУЛЬТАТОМ ДОЛЖЕН БЫТЬ МИР,
Dialogue: 0,0:04:47.51,0:04:51.97,Caption,,0,0,0,,А КОНКРЕТНЫЕ ТИПЫ ВООРУЖЕНИЙ, МЕСТА РАЗМЕЩЕНИЯ И ПОРЯДОК ВЫВОДА
Dialogue: 0,0:04:51.97,0:04:54.31,Caption,,0,0,0,,МОГУТ СТАТЬ ЧАСТЬЮ БУДУЩЕГО РЕШЕНИЯ.
Dialogue: 0,0:04:56.50,0:04:58.37,Caption,,0,0,0,,В БЕЛОРУССИИ ТЕМ ВРЕМЕНЕМ УЖЕ НЕСЁТ
Dialogue: 0,0:04:58.37,0:05:02.15,Caption,,0,0,0,,БОЕВОЕ ДЕЖУРСТВО ОРЕШНИК, СПОСОБНЫЙ ПОЛУЧИТЬ ЯДЕРНУЮ БОЕВУЮ
Dialogue: 0,0:05:02.15,0:05:05.42,Caption,,0,0,0,,ЧАСТЬ. ТАМ ЖЕ НАХОДЯТСЯ КОМПЛЕКСЫ ИСКАНДЕР М С
Dialogue: 0,0:05:05.42,0:05:09.24,Caption,,0,0,0,,ПОХОЖИМИ ВОЗМОЖНОСТЯМИ. ПОЭТОМУ РАЗГОВОР ВЫХОДИТ ДАЛЕКО ЗА
Dialogue: 0,0:05:09.24,0:05:12.21,Caption,,0,0,0,,ПРЕДЕЛЫ ТОРЖЕСТВЕННЫХ РЕЧЕЙ О МИРЕ. РЕЧЬ ИДЁТ
Dialogue: 0,0:05:12.21,0:05:15.94,Caption,,0,0,0,,О НАСТОЯЩИХ РАКЕТАХ, КОНКРЕТНЫХ РАССТОЯНИЯХ И ТЕРРИТОРИИ,
Dialogue: 0,0:05:16.10,0:05:19.99,Caption,,0,0,0,,С КОТОРОЙ ИХ, ВОЗМОЖНО, ПРИДЁТСЯ УБИРАТЬ. И ЗДЕСЬ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:05:19.99,0:05:22.47,Caption,,0,0,0,,ВОПРОС КУДА ВАЖНЕЕ ОЧЕРЕДНОГО ВЫСТУПЛЕНИЯ
Dialogue: 0,0:05:22.47,0:05:24.98,Caption,,0,0,0,,ЕВРОПЕЙСКОГО ЧИНОВНИКА. ПРЕДПОЛОЖИМ,
Dialogue: 0,0:05:25.10,0:05:27.53,Caption,,0,0,0,,СОГЛАШЕНИЕ ДОСТИГНУТО. РОССИЯ ВЫВОДИТ
Dialogue: 0,0:05:27.53,0:05:31.41,Caption,,0,0,0,,ЧАСТЬ ВООРУЖЕНИЙ, ЗАПАД ОБЕЩАЕТ НЕ ДВИГАТЬ СВОИ СИСТЕМЫ
Dialogue: 0,0:05:31.41,0:05:33.67,Caption,,0,0,0,,БЛИЖЕ. ЧТО УДЕРЖИТ ЭТУ КОНСТРУКЦИЮ ЧЕРЕЗ
Dialogue: 0,0:05:33.67,0:05:36.58,Caption,,0,0,0,,НЕСКОЛЬКО ЛЕТ? НОВОЕ ПРАВИТЕЛЬСТВО ЛЕГКО ОБЪЯВИТ,
Dialogue: 0,0:05:36.80,0:05:38.90,Caption,,0,0,0,,ЧТО ПРЕЖНИЕ ОБЯЗАТЕЛЬСТВА ПРИНИМАЛИ
Dialogue: 0,0:05:38.90,0:05:41.14,Caption,,0,0,0,,ДРУГИЕ ЛЮДИ, ОБСТАНОВКА ИЗМЕНИЛАСЬ,
Dialogue: 0,0:05:41.30,0:05:43.01,Caption,,0,0,0,,А СТАРУЮ ПОДПИСЬ ВООБЩЕ НАШЛИ В
Dialogue: 0,0:05:43.01,0:05:46.43,Caption,,0,0,0,,ДАЛЬНЕМ ЯЩИКЕ. ГЛАВНАЯ ТРУДНОСТЬ БОЛЬШОЙ СДЕЛКИ НЕ В
Dialogue: 0,0:05:46.43,0:05:48.63,Caption,,0,0,0,,ТОМ, ЧТОБЫ СОБРАТЬ УЧАСТНИКОВ ВОЗЛЕ
Dialogue: 0,0:05:48.63,0:05:51.14,Caption,,0,0,0,,КРАСИВОЙ ПАПКИ. НУЖНО СОЗДАТЬ УСЛОВИЯ,
Dialogue: 0,0:05:51.30,0:05:53.34,Caption,,0,0,0,,ПРИ КОТОРЫХ НАРУШЕНИЕ СОГЛАШЕНИЯ
Dialogue: 0,0:05:53.34,0:05:56.81,Caption,,0,0,0,,ОКАЖЕТСЯ ХУЖЕ ЕГО СОБЛЮДЕНИЯ. НА ЭТОМ ФОНЕ СЛОВА КУШНЕРА
Dialogue: 0,0:05:56.81,0:06:00.50,Caption,,0,0,0,,ЗВУЧАТ СОВСЕМ НЕ ТАК, КАК МОГЛИ БЫ ЗВУЧАТЬ ЕЩЁ НЕДАВНО. ОН
Dialogue: 0,0:06:00.50,0:06:02.74,Caption,,0,0,0,,НАЗЫВАЕТ ПРОИСХОДЯЩЕЕ ПРОКСИ ВОЙНОЙ,
Dialogue: 0,0:06:02.98,0:06:05.02,Caption,,0,0,0,,ГДЕ ЕВРОПА СНАБЖАЕТ И ФИНАНСИРУЕТ
Dialogue: 0,0:06:05.02,0:06:06.90,Caption,,0,0,0,,УКРАИНУ ДЛЯ ПРОТИВОСТОЯНИЯ РОССИИ.
Dialogue: 0,0:06:09.18,0:06:12.62,Caption,,0,0,0,,ПО ЕГО ОЦЕНКЕ, ОДНОЙ НЕБОЛЬШОЙ ОШИБКИ ДОСТАТОЧНО,
Dialogue: 0,0:06:12.70,0:06:14.65,Caption,,0,0,0,,ЧТОБЫ КОНФЛИКТ ПЕРЕШЁЛ НА ГОРАЗДО
Dialogue: 0,0:06:14.65,0:06:18.38,Caption,,0,0,0,,БОЛЕЕ ОПАСНЫЙ УРОВЕНЬ. ОДНОВРЕМЕННО КУШНЕР УТВЕРЖДАЕТ,
Dialogue: 0,0:06:18.65,0:06:21.06,Caption,,0,0,0,,ЧТО ПУТИН ЗАВЕРЯЛ АМЕРИКАНСКУЮ СТОРОНУ
Dialogue: 0,0:06:21.06,0:06:23.82,Caption,,0,0,0,,В ОТСУТСТВИИ НАМЕРЕНИЯ ПРИМЕНИТЬ ЯДЕРНОЕ ОРУЖИЕ.
Dialogue: 0,0:06:24.44,0:06:26.77,Caption,,0,0,0,,ЭТИ ДВА ТЕЗИСА НЕЛЬЗЯ РАССМАТРИВАТЬ ПО
Dialogue: 0,0:06:26.77,0:06:29.53,Caption,,0,0,0,,ОТДЕЛЬНОСТИ. ОБЫЧНЫЕ ВООРУЖЕНИЯ ПРОДОЛЖАЮТ
Dialogue: 0,0:06:29.53,0:06:34.16,Caption,,0,0,0,,НАРАЩИВАТЬ, СТАВКИ ПОДНИМАЮТ, А ЯДЕРНУЮ ЧАСТЬ ПЫТАЮТСЯ УДЕРЖАТЬ ХОТЯ
Dialogue: 0,0:06:34.16,0:06:36.73,Caption,,0,0,0,,БЫ ВНУТРИ КАКИХ ТО ГРАНИЦ. ИМЕННО ЗДЕСЬ
Dialogue: 0,0:06:36.73,0:06:39.27,Caption,,0,0,0,,ПРОЯВЛЯЕТСЯ ПРАКТИЧЕСКИЙ СМЫСЛ ЯДЕРНОГО
Dialogue: 0,0:06:39.27,0:06:43.20,Caption,,0,0,0,,СДЕРЖИВАНИЯ. ОН НЕ ТРЕБУЕТ, ЧТОБЫ УЧАСТНИКИ ВНЕЗАПНО ПРОНИКЛИСЬ
Dialogue: 0,0:06:43.20,0:06:46.06,Caption,,0,0,0,,ВЗАИМНЫМ ДОВЕРИЕМ И НАЧАЛИ ВЕРИТЬ ОБЕЩАНИЯМ,
Dialogue: 0,0:06:46.22,0:06:48.35,Caption,,0,0,0,,КАК ДЕТИ ЗАПИСКЕ ОТ ДЕДА МОРОЗА. ОН
Dialogue: 0,0:06:48.35,0:06:52.76,Caption,,0,0,0,,ТРЕБУЕТ ТАКОЙ ЦЕНЫ НАРУШЕНИЯ, ПОСЛЕ КОТОРОЙ ЖЕЛАНИЕ ПРОВЕРИТЬ ЧУЖОЕ
Dialogue: 0,0:06:52.76,0:06:54.66,Caption,,0,0,0,,ТЕРПЕНИЕ СТАНОВИТСЯ СЛИШКОМ ДОРОГИМ
Dialogue: 0,0:06:54.66,0:06:57.99,Caption,,0,0,0,,УДОВОЛЬСТВИЕМ. ДОБРАЯ ВОЛЯ В ОТНОШЕНИЯХ КРУПНЫХ
Dialogue: 0,0:06:57.99,0:07:01.06,Caption,,0,0,0,,ДЕРЖАВ ОБЫЧНО РАБОТАЕТ РОВНО ДО ПЕРВОЙ СЕРЬЁЗНОЙ
Dialogue: 0,0:07:01.06,0:07:04.02,Caption,,0,0,0,,ВЫГОДЫ. ИРАН УЖЕ ПОКАЗЫВАЛ ЭТУ ЛОГИКУ. ВОЕННЫЕ
Dialogue: 0,0:07:04.02,0:07:06.46,Caption,,0,0,0,,ВОЗМОЖНОСТИ ИРАНА И США НЕСРАВНИМЫ,
Dialogue: 0,0:07:06.78,0:07:08.64,Caption,,0,0,0,,НО ТЕГЕРАН ВОЗДЕЙСТВОВАЛ НЕ ТОЛЬКО
Dialogue: 0,0:07:08.64,0:07:11.58,Caption,,0,0,0,,РАКЕТАМИ ДАВЛЕНИЕ ШЛО ЧЕРЕЗ ИНФОРМАЦИОННУЮ ПОВЕСТКУ,
Dialogue: 0,0:07:11.74,0:07:14.40,Caption,,0,0,0,,РЫНКИ И РАСТУЩУЮ СТОИМОСТЬ КОНФЛИКТА.
Dialogue: 0,0:07:14.40,0:07:17.66,Caption,,0,0,0,,С ПОТЕНЦИАЛОМ ВЕСТИ БОРЬБУ НИКТО НЕ СПОРИЛ. СПОРИЛИ,
Dialogue: 0,0:07:17.90,0:07:20.16,Caption,,0,0,0,,СТОИТ ЛИ ПРОДОЛЖЕНИЕ ТЕХ РАСХОДОВ И
Dialogue: 0,0:07:20.16,0:07:22.54,Caption,,0,0,0,,РИСКОВ, КОТОРЫЕ ОН НАЧИНАЕТ ПРИНОСИТЬ.
Dialogue: 0,0:07:24.83,0:07:26.61,Caption,,0,0,0,,БУДУЩАЯ ДОГОВОРЁННОСТЬ ПО УКРАИНЕ
Dialogue: 0,0:07:26.61,0:07:29.71,Caption,,0,0,0,,СТОЛКНЁТСЯ С ТЕМ ЖЕ ИСПЫТАНИЕМ. ПОДПИСЬ НА БУМАГЕ НЕ
Dialogue: 0,0:07:29.71,0:07:32.21,Caption,,0,0,0,,УМЕЕТ ЗАЩИЩАТЬСЯ. ЗАЩИЩАЕТ ЕЁ ЗАРАНЕЕ
Dialogue: 0,0:07:32.21,0:07:35.76,Caption,,0,0,0,,ВСТРОЕННАЯ СИСТЕМА ПОСЛЕДСТВИЙ. КОГДА ЗА НАРУШЕНИЕ НИЧЕГО
Dialogue: 0,0:07:35.76,0:07:38.27,Caption,,0,0,0,,НЕ СЛЕДУЕТ, ПЕРЕД НАМИ НЕ СОГЛАШЕНИЕ,
Dialogue: 0,0:07:38.45,0:07:41.31,Caption,,0,0,0,,А ВЕЖЛИВАЯ ПРОСЬБА ВЕСТИ СЕБЯ ПРИЛИЧНО. КОГДА
Dialogue: 0,0:07:41.31,0:07:43.15,Caption,,0,0,0,,НАРУШИТЕЛЬ САМ ПОЛУЧАЕТ УЩЕРБ,
Dialogue: 0,0:07:43.48,0:07:46.86,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ГАРАНТИЯ, КОТОРУЮ УЖЕ ТРУДНО УБРАТЬ В АРХИВ
Dialogue: 0,0:07:46.86,0:07:49.17,Caption,,0,0,0,,ВМЕСТЕ СО СТАРЫМ ПРАВИТЕЛЬСТВОМ. ЕСЛИ ТАКОЙ
Dialogue: 0,0:07:49.17,0:07:51.87,Caption,,0,0,0,,РАЗБОР ВАМ ПОЛЕЗНЕЕ ОЧЕРЕДНОЙ ПОДБОРКИ ЗАЯВЛЕНИЙ,
Dialogue: 0,0:07:51.99,0:07:54.27,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ДАЛЬШЕ НАЧИНАЕТСЯ ЧАСТЬ,
Dialogue: 0,0:07:54.51,0:07:56.65,Caption,,0,0,0,,КОТОРУЮ УЧАСТНИКАМ ОСОБЕННО НЕУДОБНО
Dialogue: 0,0:07:56.65,0:07:59.23,Caption,,0,0,0,,ПРОИЗНОСИТЬ ВСЛУХ. ПОКА ЕВРОПА ПЕРЕЧИСЛЯЕТ
Dialogue: 0,0:07:59.23,0:08:02.84,Caption,,0,0,0,,ТРЕБОВАНИЯ К РОССИИ, НА УКРАИНЕ УЖЕ ПРИЗНАЮТ ОТСУТСТВИЕ
Dialogue: 0,0:08:02.84,0:08:05.83,Caption,,0,0,0,,СОБСТВЕННОГО ПОНЯТНОГО МАРШРУТА. ДМИТРИЙ РАЗУМКОВ
Dialogue: 0,0:08:05.83,0:08:08.59,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО У СТРАНЫ НЕТ НИ СЦЕНАРИЯ МИРА,
Dialogue: 0,0:08:08.83,0:08:11.07,Caption,,0,0,0,,НИ СЦЕНАРИЯ ВОЙНЫ. ОН ЖЕ СПРОСИЛ,
Dialogue: 0,0:08:11.39,0:08:13.63,Caption,,0,0,0,,КУДА ИСЧЕЗ ВЕЛИКИЙ ПЛАН ВОЗВРАЩЕНИЯ К
Dialogue: 0,0:08:13.63,0:08:16.11,Caption,,0,0,0,,ГРАНИЦАМ ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО ПЕРВОГО
Dialogue: 0,0:08:16.11,0:08:19.67,Caption,,0,0,0,,ГОДА. ПО МНЕНИЮ РАЗУМКОВА, ПРИ НЫНЕШНИХ ОБСТОЯТЕЛЬСТВАХ ВЕРНУТЬ
Dialogue: 0,0:08:19.67,0:08:23.68,Caption,,0,0,0,,ЭТИ ТЕРРИТОРИИ НЕВОЗМОЖНО, КАКИМ БЫ СИЛЬНЫМ НИ БЫЛО ЖЕЛАНИЕ. И
Dialogue: 0,0:08:23.68,0:08:25.31,Caption,,0,0,0,,ЭТО ГОВОРИТ НЕ РОССИЙСКИЙ МИНИСТР,
Dialogue: 0,0:08:25.55,0:08:29.19,Caption,,0,0,0,,А УКРАИНСКИЙ ДЕПУТАТ. РЯДОМ С ЭТОЙ ОЦЕНКОЙ СТОЯТ СЛОВА
Dialogue: 0,0:08:29.19,0:08:31.47,Caption,,0,0,0,,КУШНЕРА О РАБОТЕ АМЕРИКАНСКИХ ПОСРЕДНИКОВ.
Dialogue: 0,0:08:33.74,0:08:36.29,Caption,,0,0,0,,ОН РАССКАЗЫВАЕТ С ФЕВРАЛЯ ПО СЕНТЯБРЬ
Dialogue: 0,0:08:36.29,0:08:38.85,Caption,,0,0,0,,США ПОСТОЯННО ОБЩАЛИСЬ СО ВСЕМИ УЧАСТНИКАМИ
Dialogue: 0,0:08:38.85,0:08:41.39,Caption,,0,0,0,,КОНФЛИКТА, НО ГИБКОСТИ НЕ НАШЛИ НИ У ОДНОЙ
Dialogue: 0,0:08:41.39,0:08:44.14,Caption,,0,0,0,,СТОРОНЫ. ЗНАЧИТ, УДОБНАЯ ФОРМУЛА,
Dialogue: 0,0:08:44.30,0:08:46.63,Caption,,0,0,0,,СОГЛАСНО КОТОРОЙ МИРА НЕ ХОЧЕТ КТО ТО
Dialogue: 0,0:08:46.63,0:08:49.21,Caption,,0,0,0,,ОДИН, НЕ ОБЪЯСНЯЕТ РЕАЛЬНУЮ КАРТИНУ.
Dialogue: 0,0:08:49.21,0:08:52.06,Caption,,0,0,0,,ВАШИНГТОН УПЁРСЯ СРАЗУ В НЕСКОЛЬКО ПРЕПЯТСТВИЙ.
Dialogue: 0,0:08:52.06,0:08:55.03,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЙ ВОПРОС. ГАРАНТИИ БЕЗОПАСНОСТИ.
Dialogue: 0,0:08:55.03,0:08:58.53,Caption,,0,0,0,,НЕЖЕЛАНИЕ ИДТИ НА КОМПРОМИСС. ПОСЛЕ ТАКОЙ ДИАГНОСТИКИ
Dialogue: 0,0:08:58.53,0:09:01.94,Caption,,0,0,0,,ОСТАЁТСЯ ГЛАВНЫЙ ПРАКТИЧЕСКИЙ ВОПРОС. ЧТО АМЕРИКАНЦЫ
Dialogue: 0,0:09:01.94,0:09:05.42,Caption,,0,0,0,,СОБИРАЮТСЯ ДЕЛАТЬ СО СТЕНАМИ, КОТОРЫЕ САМИ УЖЕ НАЩУПАЛИ?
Dialogue: 0,0:09:06.05,0:09:07.84,Caption,,0,0,0,,ХОДИТЬ ВОКРУГ НИХ С БЛОКНОТОМ МОЖНО
Dialogue: 0,0:09:07.84,0:09:10.52,Caption,,0,0,0,,ЕЩЁ МНОГО ЛЕТ. СТЕНА ОТ КАЧЕСТВЕННЫХ ЗАМЕТОК
Dialogue: 0,0:09:10.52,0:09:13.94,Caption,,0,0,0,,НИЖЕ НЕ СТАНЕТ. КУШНЕР СООБЩИЛ ЕЩЁ ОДНУ ПОКАЗАТЕЛЬНУЮ
Dialogue: 0,0:09:13.94,0:09:17.34,Caption,,0,0,0,,ПОДРОБНОСТЬ. ТРАМП ПОДДЕРЖАЛ ПРОВЕДЕНИЕ ВЫБОРОВ НА
Dialogue: 0,0:09:17.34,0:09:21.35,Caption,,0,0,0,,УКРАИНЕ. ПО ЕГО СЛОВАМ, ЭТО ПРОИЗОШЛО ПОСЛЕ ПУБЛИЧНОЙ КРИТИКИ
Dialogue: 0,0:09:21.35,0:09:25.18,Caption,,0,0,0,,ТРАМПА СО СТОРОНЫ ЗЕЛЕНСКОГО. КУШНЕР ОСТОРОЖНО НАПОМНИЛ,
Dialogue: 0,0:09:25.42,0:09:27.62,Caption,,0,0,0,,ЧТО АМЕРИКАНСКИЙ ПРЕЗИДЕНТ ОТВЕЧАЕТ НА
Dialogue: 0,0:09:27.62,0:09:30.61,Caption,,0,0,0,,ЛИЧНЫЕ ВЫПАДЫ ВЕСЬМА ЖЁСТКО. В ПЕРЕВОДЕ НА ПРОСТОЙ
Dialogue: 0,0:09:30.61,0:09:34.44,Caption,,0,0,0,,ЯЗЫК ЭТО ОЗНАЧАЕТ, ЧТО ЗЕЛЕНСКИЙ РЕШИЛ ПОДЁРГАТЬ ТИГРА ЗА
Dialogue: 0,0:09:34.44,0:09:37.02,Caption,,0,0,0,,УСЫ, А ТИГР ОКАЗАЛСЯ НЕ ДЕКОРАТИВНЫМ.
Dialogue: 0,0:09:37.57,0:09:39.46,Caption,,0,0,0,,НО ЛИЧНЫЕ ОТНОШЕНИЯ ЗДЕСЬ ТОЛЬКО
Dialogue: 0,0:09:39.46,0:09:42.32,Caption,,0,0,0,,ВЕРХНИЙ СЛОЙ. ВЫБОРЫ ЭТО ВПОЛНЕ КОНКРЕТНЫЙ
Dialogue: 0,0:09:42.32,0:09:45.30,Caption,,0,0,0,,ИНСТРУМЕНТ, КОТОРЫЙ ПОЗВОЛЯЕТ СМЕНИТЬ В КИЕВЕ
Dialogue: 0,0:09:45.30,0:09:50.65,Caption,,0,0,0,,ЛЮДЕЙ, МЕШАЮЩИХ СДЕЛКЕ. ЕСЛИ В ВАШИНГТОНЕ РЕШИЛИ,
Dialogue: 0,0:09:50.81,0:09:52.69,Caption,,0,0,0,,ЧТО ДЕЙСТВУЮЩАЯ УКРАИНСКАЯ ВЛАСТЬ
Dialogue: 0,0:09:52.69,0:09:55.96,Caption,,0,0,0,,ПРЕПЯТСТВУЕТ СДЕЛКЕ, ТЕМА ВЫБОРОВ ПРЕВРАЩАЕТСЯ ИЗ
Dialogue: 0,0:09:55.96,0:10:00.22,Caption,,0,0,0,,РИТУАЛЬНОГО РАЗГОВОРА О ДЕМОКРАТИЧЕСКИХ ЦЕННОСТЯХ В ИНСТРУМЕНТ
Dialogue: 0,0:10:00.22,0:10:02.49,Caption,,0,0,0,,ДАВЛЕНИЯ. И ЕСТЬ ЕЩЁ ОДНА ВАЖНАЯ ДЕТАЛЬ.
Dialogue: 0,0:10:03.05,0:10:05.35,Caption,,0,0,0,,ВО ВРЕМЯ ОБЩЕНИЯ С АМЕРИКАНЦАМИ ПУТИН
Dialogue: 0,0:10:05.35,0:10:07.99,Caption,,0,0,0,,ОБСУЖДАЛ ПОВЕДЕНИЕ ЗЕЛЕНСКОГО ПО ОТНОШЕНИЮ К
Dialogue: 0,0:10:07.99,0:10:10.89,Caption,,0,0,0,,ТРАМПУ. ПРИ ЭТОМ САМОГО ПУТИНА КУШНЕР ХАРАКТЕРИЗУЕТ
Dialogue: 0,0:10:10.89,0:10:13.50,Caption,,0,0,0,,ПОЧТИ С ВОСХИЩЕНИЕМ ВЫДАЮЩИЙСЯ ПОЛИТИК И
Dialogue: 0,0:10:13.50,0:10:16.41,Caption,,0,0,0,,ИСТОРИЧЕСКАЯ ФИГУРА, ТЩАТЕЛЬНАЯ ПОДГОТОВКА,
Dialogue: 0,0:10:16.57,0:10:20.37,Caption,,0,0,0,,ЯСНОСТЬ ВЗГЛЯДОВ. С ЭТОЙ ОЦЕНКОЙ МОЖНО СОГЛАШАТЬСЯ ИЛИ
Dialogue: 0,0:10:20.37,0:10:23.04,Caption,,0,0,0,,СПОРИТЬ, НО ДЛЯ ПЕРЕГОВОРОВ СУЩЕСТВЕННЕЕ
Dialogue: 0,0:10:23.04,0:10:26.44,Caption,,0,0,0,,ДРУГОЕ. АМЕРИКАНСКАЯ КОМАНДА УЖЕ СФОРМИРОВАЛА ПРЕДСТАВЛЕНИЕ
Dialogue: 0,0:10:26.44,0:10:29.38,Caption,,0,0,0,,О ЛЮДЯХ, СИДЯЩИХ ПО РАЗНЫЕ СТОРОНЫ ПРОЦЕССА.
Dialogue: 0,0:10:29.38,0:10:32.09,Caption,,0,0,0,,ОНА ПОНИМАЕТ, КТО ПРИХОДИТ ПОДГОТОВЛЕННЫМ,
Dialogue: 0,0:10:32.25,0:10:35.37,Caption,,0,0,0,,КТО ВЫПОЛНЯЕТ ОБЕЩАННОЕ, КТО МЕНЯЕТ ПОЗИЦИЮ,
Dialogue: 0,0:10:35.53,0:10:37.66,Caption,,0,0,0,,А КТО ПРЕВРАЩАЕТ КАЖДУЮ ВСТРЕЧУ В
Dialogue: 0,0:10:37.66,0:10:41.34,Caption,,0,0,0,,НОВЫЙ СЮРПРИЗ. ПОЭТОМУ ВОПРОС ТЕПЕРЬ АДРЕСОВАН САМОМУ
Dialogue: 0,0:10:41.34,0:10:44.34,Caption,,0,0,0,,ВАШИНГТОНУ. КАКИЕ ДЕЙСТВИЯ ПОСЛЕДУЮТ ЗА ЭТИМИ
Dialogue: 0,0:10:44.34,0:10:46.95,Caption,,0,0,0,,ВЫВОДАМИ, КРОМЕ ПУБЛИЧНЫХ УКОЛОВ В АДРЕС
Dialogue: 0,0:10:46.95,0:10:50.18,Caption,,0,0,0,,ЗЕЛЕНСКОГО? САМАЯ ПОКАЗАТЕЛЬНАЯ ИСТОРИЯ ОСТАЁТСЯ
Dialogue: 0,0:10:50.18,0:10:53.26,Caption,,0,0,0,,НАПОСЛЕДОК. КУШНЕР И ЛУКАШЕНКО ПОЧТИ ОДНОВРЕМЕННО
Dialogue: 0,0:10:53.26,0:10:56.80,Caption,,0,0,0,,ЗАГОВОРИЛИ О МОМЕНТЕ, КОГДА ПЕРЕГОВОРЫ УЖЕ ПРИБЛИЗИЛИСЬ К
Dialogue: 0,0:10:56.80,0:11:01.64,Caption,,0,0,0,,СОВЕРШЕННО ИНОМУ РЕЗУЛЬТАТУ. ПО СЛОВАМ КУШНЕРА,
Dialogue: 0,0:11:01.77,0:11:03.83,Caption,,0,0,0,,ПРИМЕРНО В НОЯБРЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:11:03.83,0:11:06.74,Caption,,0,0,0,,ПЯТОГО ГОДА АМЕРИКАНСКОЙ СТОРОНЕ УДАЛОСЬ ДОБИТЬСЯ
Dialogue: 0,0:11:06.74,0:11:09.80,Caption,,0,0,0,,ЗАМЕТНОГО ПРОДВИЖЕНИЯ. ЗАТЕМ, КАК ОН РАССКАЗЫВАЕТ,
Dialogue: 0,0:11:10.04,0:11:13.32,Caption,,0,0,0,,В КОНЦЕ ДЕКАБРЯ УКРАИНСКИЕ БЕСПИЛОТНИКИ АТАКОВАЛИ
Dialogue: 0,0:11:13.32,0:11:15.59,Caption,,0,0,0,,РЕЗИДЕНЦИЮ ПУТИНА. ПОСЛЕ ЭТОГО
Dialogue: 0,0:11:15.59,0:11:19.81,Caption,,0,0,0,,ЭПИЗОДА, ПО ОЦЕНКЕ КУШНЕРА, РОССИЙСКИЙ ПРЕЗИДЕНТ ОТСТУПИЛ ОТ
Dialogue: 0,0:11:19.81,0:11:23.71,Caption,,0,0,0,,ДОСТИГНУТОЙ ТОЧКИ В ПЕРЕГОВОРАХ. ВЕРСИЯ ЛУКАШЕНКО ЗВУЧИТ
Dialogue: 0,0:11:23.71,0:11:26.04,Caption,,0,0,0,,ЕЩЁ КОНКРЕТНЕЕ. ОН УТВЕРЖДАЕТ,
Dialogue: 0,0:11:26.16,0:11:27.88,Caption,,0,0,0,,ЧТО СТОРОНЫ ОБСУЖДАЛИ СОЗДАНИЕ
Dialogue: 0,0:11:27.88,0:11:31.32,Caption,,0,0,0,,ДЕМИЛИТАРИЗОВАННОЙ ЗОНЫ И ПРЕКРАЩЕНИЕ БОЕВЫХ ДЕЙСТВИЙ.
Dialogue: 0,0:11:31.32,0:11:35.01,Caption,,0,0,0,,ОСТАНОВИТЬ ИХ, ПО ЕГО СЛОВАМ, МОГЛИ ПО СУЩЕСТВУЮЩЕЙ ЛИНИИ
Dialogue: 0,0:11:35.01,0:11:38.31,Caption,,0,0,0,,СОПРИКОСНОВЕНИЯ. ДАЛЬШЕ ПРЕДПОЛАГАЛОСЬ ПРОДОЛЖИТЬ
Dialogue: 0,0:11:38.31,0:11:40.48,Caption,,0,0,0,,ПЕРЕГОВОРЫ О БУДУЩЕЙ ГРАНИЦЕ И СПОСОБЕ
Dialogue: 0,0:11:40.48,0:11:42.76,Caption,,0,0,0,,ОКОНЧАТЕЛЬНОГО ОФОРМЛЕНИЯ УРЕГУЛИРОВАНИЯ.
Dialogue: 0,0:11:43.32,0:11:45.32,Caption,,0,0,0,,ТО ЕСТЬ ОБСУЖДАЛОСЬ НЕ ПОЖЕЛАНИЕ КОГДА
Dialogue: 0,0:11:45.32,0:11:48.83,Caption,,0,0,0,,НИБУДЬ ЗАКОНЧИТЬ ВОЙНУ, А ПОНЯТНАЯ ПОСЛЕДОВАТЕЛЬНОСТЬ
Dialogue: 0,0:11:48.83,0:11:52.04,Caption,,0,0,0,,ДЕЙСТВИЙ. СНАЧАЛА ПРЕКРАЩАЕТСЯ ОГОНЬ. ПОТОМ СТОРОНЫ
Dialogue: 0,0:11:52.04,0:11:55.42,Caption,,0,0,0,,РАЗВОДЯТ СИЛЫ. ЗАТЕМ ПЕРЕХОДЯТ К СПОРУ О ГРАНИЦЕ И
Dialogue: 0,0:11:55.42,0:11:57.88,Caption,,0,0,0,,ОКОНЧАТЕЛЬНЫХ УСЛОВИЯХ. ПОСЛЕ ЭТОГО,
Dialogue: 0,0:11:58.11,0:12:02.33,Caption,,0,0,0,,СОГЛАСНО РАССКАЗУ ЛУКАШЕНКО, НАНОСИТСЯ УДАР ПО РЕЗИДЕНЦИИ ПУТИНА.
Dialogue: 0,0:12:02.33,0:12:05.45,Caption,,0,0,0,,ЛУКАШЕНКО ГОВОРИТ, ЧТО РОССИЙСКИЙ ПРЕЗИДЕНТ ВОСПРИНЯЛ
Dialogue: 0,0:12:05.45,0:12:08.77,Caption,,0,0,0,,СЛУЧИВШЕЕСЯ КАК ДОКАЗАТЕЛЬСТВО НЕВОЗМОЖНОСТИ ДОВЕРЯТЬ
Dialogue: 0,0:12:08.77,0:12:11.67,Caption,,0,0,0,,КИЕВУ И ЗАПАДНЫМ СТРАНАМ. САМ ЛУКАШЕНКО ТАКЖЕ
Dialogue: 0,0:12:11.67,0:12:14.52,Caption,,0,0,0,,СЧИТАЕТ, ЧТО ЗЕЛЕНСКИЙ НЕ ПОШЁЛ БЫ НА ТАКОЙ ШАГ
Dialogue: 0,0:12:14.52,0:12:16.84,Caption,,0,0,0,,БЕЗ СОГЛАСИЯ ЕВРОПЫ. ЭТО ЕГО ОЦЕНКА.
Dialogue: 0,0:12:19.12,0:12:21.04,Caption,,0,0,0,,НО СОВПАДЕНИЕ В РАССКАЗАХ ЛУКАШЕНКО И
Dialogue: 0,0:12:21.04,0:12:24.17,Caption,,0,0,0,,КУШНЕРА ТРУДНО НЕ ЗАМЕТИТЬ. ОБА СВЯЗЫВАЮТ ТОТ ЭПИЗОД
Dialogue: 0,0:12:24.17,0:12:25.92,Caption,,0,0,0,,С ДВИЖЕНИЕМ ПЕРЕГОВОРОВ НАЗАД,
Dialogue: 0,0:12:26.32,0:12:28.88,Caption,,0,0,0,,КОГДА ДО ЭТОГО УЖЕ НАМЕТИЛСЯ ПРАКТИЧЕСКИЙ КОНТУР
Dialogue: 0,0:12:28.88,0:12:30.88,Caption,,0,0,0,,ОСТАНОВКИ БОЕВЫХ ДЕЙСТВИЙ. ТЕПЕРЬ
Dialogue: 0,0:12:30.88,0:12:34.04,Caption,,0,0,0,,ПОСМОТРИМ НА СЛЕДУЮЩИЙ ВИТОК. В ЦЕНТРЕ ВНИМАНИЯ
Dialogue: 0,0:12:34.04,0:12:37.28,Caption,,0,0,0,,СНОВА ОКАЗАЛСЯ КРЫМСКИЙ МОСТ. ГЛАВА НИДЕРЛАНДСКОЙ
Dialogue: 0,0:12:37.28,0:12:40.73,Caption,,0,0,0,,КОМПАНИИ DESTINUS АЛЕКСАНДР ДАНИЛЮК СООБЩИЛ В АТАКЕ
Dialogue: 0,0:12:40.73,0:12:43.88,Caption,,0,0,0,,УЧАСТВОВАЛИ ДЕВЯТЬ КРЫЛАТЫХ РАКЕТ RUTA И УДАРНЫЕ
Dialogue: 0,0:12:43.88,0:12:46.56,Caption,,0,0,0,,БЕСПИЛОТНИКИ. КОМПАНИЯ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:12:46.72,0:12:51.15,Caption,,0,0,0,,ГОРДИТСЯ СВОИМ ВКЛАДОМ. ДАЛЬШЕ ДЕТАЛЬ СЕРЬЁЗНЕЕ НИДЕРЛАНДСКАЯ
Dialogue: 0,0:12:51.15,0:12:54.80,Caption,,0,0,0,,ГАЗЕТА NRC НАПИСАЛА, ЧТО СОТРУДНИКИ DESTINUS МОГЛИ ПОМОГАТЬ
Dialogue: 0,0:12:54.80,0:12:57.37,Caption,,0,0,0,,УКРАИНСКИМ ВОЕННЫМ ЗАПУСКАТЬ БЕСПИЛОТНИКИ И
Dialogue: 0,0:12:57.37,0:13:00.32,Caption,,0,0,0,,УПРАВЛЯТЬ ИМИ. РОССИЙСКОЕ ПОСОЛЬСТВО В ГААГЕ
Dialogue: 0,0:13:00.32,0:13:03.61,Caption,,0,0,0,,ПОТРЕБОВАЛО ОБЪЯСНЕНИЙ ОТ ВЛАСТЕЙ НИДЕРЛАНДОВ. ПОЭТОМУ
Dialogue: 0,0:13:03.61,0:13:06.16,Caption,,0,0,0,,ОБСУЖДАЕТСЯ УЖЕ НЕ ТОЛЬКО ПРОИСХОЖДЕНИЕ РАКЕТ,
Dialogue: 0,0:13:06.49,0:13:08.39,Caption,,0,0,0,,НО И ПРЯМОЕ УЧАСТИЕ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:13:08.39,0:13:11.36,Caption,,0,0,0,,КОМПАНИИ В САМОЙ ОПЕРАЦИИ. МОЯ ВЕРСИЯ ПРОСТА.
Dialogue: 0,0:13:11.92,0:13:13.68,Caption,,0,0,0,,ЕДВА ПЕРЕГОВОРЫ НАЧИНАЮТ ОБРЕТАТЬ
Dialogue: 0,0:13:13.68,0:13:17.12,Caption,,0,0,0,,ФОРМУ И ПОЯВЛЯЕТСЯ ТОЧКА, ОТ КОТОРОЙ МОЖНО ДВИГАТЬСЯ ДАЛЬШЕ,
Dialogue: 0,0:13:17.36,0:13:21.11,Caption,,0,0,0,,ПРОИСХОДИТ НОВЫЙ ЭПИЗОД, ПОВЫШАЮЩИЙ СТАВКИ И УНИЧТОЖАЮЩИЙ
Dialogue: 0,0:13:21.11,0:13:24.31,Caption,,0,0,0,,НАКОПЛЕННОЕ ДОВЕРИЕ. СНАЧАЛА РЕЗИДЕНЦИЯ ПУТИНА.
Dialogue: 0,0:13:24.31,0:13:27.79,Caption,,0,0,0,,ТЕПЕРЬ КРЫМСКИЙ МОСТ. МОЯ ОЦЕНКА ЗДЕСЬ ЖЁСТКАЯ.
Dialogue: 0,0:13:27.79,0:13:30.40,Caption,,0,0,0,,КРЕАТИВНОСТИ У ДЕВЯНОСТО ПЯТОГО КВАРТАЛА,
Dialogue: 0,0:13:30.49,0:13:32.24,Caption,,0,0,0,,ВОТ ЭТОЙ КРОВАВОЙ КРЕАТИВНОСТИ,
Dialogue: 0,0:13:32.41,0:13:37.77,Caption,,0,0,0,,НЕ ОТНЯТЬ. НО ВАШИНГТОНУ ТОГДА ПРИДЁТСЯ ПРИНЯТЬ
Dialogue: 0,0:13:37.77,0:13:40.58,Caption,,0,0,0,,РЕШЕНИЕ. ЕСЛИ АМЕРИКАНЦЫ СЧИТАЮТ ТАКИЕ ДЕЙСТВИЯ
Dialogue: 0,0:13:40.58,0:13:44.41,Caption,,0,0,0,,ПОМЕХОЙ ПЕРЕГОВОРАМ, ОДНИХ ИНТЕРВЬЮ МАЛО. ДОЛЖЕН ПОЯВИТЬСЯ
Dialogue: 0,0:13:44.41,0:13:47.53,Caption,,0,0,0,,МЕХАНИЗМ, СПОСОБНЫЙ ИЗМЕНИТЬ ПОВЕДЕНИЕ. ИНАЧЕ
Dialogue: 0,0:13:47.53,0:13:50.36,Caption,,0,0,0,,СХЕМА БУДЕТ ПОВТОРЯТЬСЯ БЕСКОНЕЧНО СБЛИЖЕНИЕ,
Dialogue: 0,0:13:50.52,0:13:54.60,Caption,,0,0,0,,СРЫВ, ВОЗВРАТ К СТОЛУ, И НОВЫЙ СРЫВ РОВНО В ТОТ МОМЕНТ,
Dialogue: 0,0:13:54.83,0:13:56.98,Caption,,0,0,0,,КОГДА ЗАБРЕЗЖИЛ ШАНС. РАЗ ЗА РАЗОМ
Dialogue: 0,0:13:56.98,0:13:59.72,Caption,,0,0,0,,ТОЧКОЙ ОБВАЛА СТАНОВИТСЯ ИМЕННО ТА МИНУТА,
Dialogue: 0,0:13:59.88,0:14:02.07,Caption,,0,0,0,,КОГДА ДЕЛО ПОЧТИ СДВИНУЛОСЬ С МЕСТА.
Dialogue: 0,0:14:02.07,0:14:04.70,Caption,,0,0,0,,ПОЭТОМУ ВОПРОС СЕЙЧАС ДАЖЕ НЕ В ДАТЕ СЛЕДУЮЩЕГО
Dialogue: 0,0:14:04.70,0:14:08.36,Caption,,0,0,0,,РАУНДА. ВОПРОС В ТОМ, КАКОЙ МИР ЗДЕСЬ ТАК И НЕ СОСТОЯЛСЯ,
Dialogue: 0,0:14:08.64,0:14:12.42,Caption,,0,0,0,,И ЧТО ДОЛЖНО ИЗМЕНИТЬСЯ, ЧТОБЫ ЕГО НЕ ТЕРЯЛИ ЗАНОВО ПРИ КАЖДОМ
Dialogue: 0,0:14:12.42,0:14:15.34,Caption,,0,0,0,,ПОВОРОТЕ. БЕЗ ОТВЕТА НА ЭТО ПЕРЕГОВОРЫ РИСКУЮТ
Dialogue: 0,0:14:15.34,0:14:18.16,Caption,,0,0,0,,НАВСЕГДА ОСТАТЬСЯ РЕПЕТИЦИЕЙ ОДНОГО И ТОГО ЖЕ
Dialogue: 0,0:14:18.16,0:14:18.68,Caption,,0,0,0,,ПРОВАЛА.
