Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,КОГДА ГОСУДАРСТВО ГОТОВИТ СВОИ РЕЕСТРЫ К ЭВАКУАЦИИ
Dialogue: 0,0:00:02.84,0:00:06.44,Caption,,0,0,0,,ЗА ГРАНИЦУ, А ЕГО РУКОВОДИТЕЛИ ПРОДОЛЖАЮТ ПОВЫШАТЬ СТАВКИ В
Dialogue: 0,0:00:06.44,0:00:10.68,Caption,,0,0,0,,СПОРЕ С ЯДЕРНОЙ ДЕРЖАВОЙ, ВОЗНИКАЕТ ДОВОЛЬНО НЕЛОВКИЙ ВОПРОС. ОНИ
Dialogue: 0,0:00:10.68,0:00:13.24,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО РАССЧИТЫВАЮТ ПОБЕДИТЬ ИЛИ ПРОСТО
Dialogue: 0,0:00:13.24,0:00:16.60,Caption,,0,0,0,,УВЕРЕНЫ, ЧТО ГОРЕТЬ ПЕРВЫМИ НАЗНАЧАТ КОГО НИБУДЬ ДРУГОГО?
Dialogue: 0,0:00:16.99,0:00:19.80,Caption,,0,0,0,,МАСШТАБ СТРАНЫ ЗДЕСЬ ИМЕЕТ ЗНАЧЕНИЕ. У БОЛЬШОЙ
Dialogue: 0,0:00:19.80,0:00:22.44,Caption,,0,0,0,,ДЕРЖАВЫ ПОСЛЕ СТРАШНОГО УДАРА ОСТАНЕТСЯ ХОТЯ БЫ
Dialogue: 0,0:00:22.44,0:00:25.08,Caption,,0,0,0,,ТЕРРИТОРИЯ. У МАЛЕНЬКОЙ МОЖЕТ НЕ ОСТАТЬСЯ САМОЙ
Dialogue: 0,0:00:25.08,0:00:29.80,Caption,,0,0,0,,СТРАНЫ. НА КАРТЕ БУДЕТ ДЫРА, А В АРХИВЕ СОХРАНИТСЯ ПРЕКРАСНО СОСТАВЛЕННОЕ
Dialogue: 0,0:00:29.80,0:00:32.04,Caption,,0,0,0,,ЗАЯВЛЕНИЕ О НЕСГИБАЕМОЙ РЕШИМОСТИ.
Dialogue: 0,0:00:34.31,0:00:36.87,Caption,,0,0,0,,НАЧИНАТЬ ЭТУ ИСТОРИЮ НАДО С ФРАНЦИИ. ГЛАВА
Dialogue: 0,0:00:36.87,0:00:40.15,Caption,,0,0,0,,ФРАНЦУЗСКОГО МИДА ЖАН НОЭЛЬ БАРРО ПУБЛИЧНО ПРИЗНАЛ,
Dialogue: 0,0:00:40.31,0:00:42.87,Caption,,0,0,0,,ЧТО ФРАНЦУЗСКИЕ ВОЕННЫЕ СПЕЦИАЛИСТЫ НАХОДЯТСЯ НА
Dialogue: 0,0:00:42.87,0:00:46.39,Caption,,0,0,0,,УКРАИНЕ. ОНИ ОБУЧАЮТ УКРАИНСКИХ ВОЕННОСЛУЖАЩИХ И
Dialogue: 0,0:00:46.39,0:00:49.67,Caption,,0,0,0,,ПОМОГАЮТ ОБСЛУЖИВАТЬ ТЕХНИКУ. ЭТО УЖЕ НЕ ПЕРЕСКАЗ
Dialogue: 0,0:00:49.67,0:00:52.15,Caption,,0,0,0,,АНОНИМНОГО ИСТОЧНИКА И НЕ УТЕЧКА ИЗ ЗАКРЫТОГО
Dialogue: 0,0:00:52.15,0:00:55.27,Caption,,0,0,0,,КАБИНЕТА. О ПРИСУТСТВИИ ГОВОРИТ МИНИСТР СТРАНЫ,
Dialogue: 0,0:00:55.50,0:01:00.44,Caption,,0,0,0,,ЧЬИ ЛЮДИ ТАМ РАБОТАЮТ. ПАРИЖ ПРИ ЭТОМ НАСТАИВАЕТ,
Dialogue: 0,0:01:00.60,0:01:03.00,Caption,,0,0,0,,ЧТО УЧАСТНИКОМ КОНФЛИКТА ФРАНЦИЯ НЕ СТАЛА.
Dialogue: 0,0:01:03.24,0:01:05.96,Caption,,0,0,0,,СПЕЦИАЛИСТОВ МАЛО, ОТ ФРОНТА ОНИ ДАЛЕКО,
Dialogue: 0,0:01:06.11,0:01:09.00,Caption,,0,0,0,,ОРУЖИЕ САМИ НЕ ПРИМЕНЯЮТ. ПОЛУЧАЕТСЯ ЗАНЯТНАЯ
Dialogue: 0,0:01:09.00,0:01:11.64,Caption,,0,0,0,,ФОРМУЛА. ВОЕННЫЙ ОДНОЙ СТРАНЫ НАХОДИТСЯ НА
Dialogue: 0,0:01:11.72,0:01:13.56,Caption,,0,0,0,,ТЕРРИТОРИИ ДРУГОЙ ВОЮЮЩЕЙ СТРАНЫ,
Dialogue: 0,0:01:13.88,0:01:16.68,Caption,,0,0,0,,ГОТОВИТ ЕЁ АРМИЮ И ОБСЛУЖИВАЕТ ЕЁ ТЕХНИКУ,
Dialogue: 0,0:01:16.92,0:01:19.48,Caption,,0,0,0,,ОДНАКО ПЕРВАЯ СТРАНА ЯКОБЫ СТОИТ В СТОРОНЕ.
Dialogue: 0,0:01:19.85,0:01:23.00,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ БУХГАЛТЕРИЯ ОСВОИЛА НОВЫЙ ТАЛАНТ. ТЕПЕРЬ
Dialogue: 0,0:01:23.08,0:01:25.08,Caption,,0,0,0,,ОНА СЧИТАЕТ НЕ ТОЛЬКО ДЕНЬГИ БЕЗ ДЕНЕГ,
Dialogue: 0,0:01:25.32,0:01:32.07,Caption,,0,0,0,,НО И УЧАСТИЕ БЕЗ УЧАСТИЯ. САМО ПРИСУТСТВИЕ ФРАНЦУЗОВ ТАЙНОЙ ДАВНО НЕ БЫЛО.
Dialogue: 0,0:01:32.39,0:01:35.19,Caption,,0,0,0,,ФРАНЦУЗСКОЕ РАДИО РАССКАЗЫВАЛО О МИССИИ ВОЛИА,
Dialogue: 0,0:01:35.35,0:01:37.99,Caption,,0,0,0,,ДЕЙСТВУЮЩЕЙ С ЛЕТА, И О НЕБОЛЬШИХ ГРУППАХ,
Dialogue: 0,0:01:38.22,0:01:41.27,Caption,,0,0,0,,КОТОРЫЕ ПРИЕЗЖАЮТ ДЛЯ КОРОТКИХ ЗАДАНИЙ. СООБЩАЛОСЬ
Dialogue: 0,0:01:41.27,0:01:44.31,Caption,,0,0,0,,ТАКЖЕ, ЧТО ФРАНЦУЗСКИХ ДЕПУТАТОВ О РАЗВЁРТЫВАНИИ ЭТОЙ
Dialogue: 0,0:01:44.31,0:01:49.19,Caption,,0,0,0,,РАБОТЫ НЕ УВЕДОМИЛИ. ВИДИМО, ПАРЛАМЕНТУ ОСТАВИЛИ БОЛЕЕ ВАЖНУЮ ОБЯЗАННОСТЬ УЗНАТЬ
Dialogue: 0,0:01:49.27,0:01:52.31,Caption,,0,0,0,,ОБО ВСЁМ ПОЗЖЕ И ВЫРАЗИТЬ ГЛУБОКУЮ ОСВЕДОМЛЁННОСТЬ
Dialogue: 0,0:01:52.39,0:01:58.60,Caption,,0,0,0,,ЗАДНИМ ЧИСЛОМ. ЕЩЁ ОДНИМ МАРШРУТОМ СЛУЖИЛА ОФИЦИАЛЬНАЯ МИССИЯ ГЕРФО
Dialogue: 0,0:01:58.68,0:02:01.40,Caption,,0,0,0,,В ПОЛЬШЕ. ЧЕРЕЗ НЕЁ ОБЕСПЕЧИВАЛОСЬ ФРАНЦУЗСКОЕ
Dialogue: 0,0:02:01.40,0:02:04.60,Caption,,0,0,0,,ВОЕННОЕ ПРИСУТСТВИЕ НА УКРАИНЕ. ПОЭТОМУ СЕНСАЦИЯ
Dialogue: 0,0:02:04.60,0:02:07.40,Caption,,0,0,0,,ЗАКЛЮЧАЕТСЯ НЕ В ПОЯВЛЕНИИ ФРАНЦУЗСКИХ СПЕЦИАЛИСТОВ.
Dialogue: 0,0:02:07.72,0:02:10.28,Caption,,0,0,0,,ОНИ ТАМ НЕ МАТЕРИАЛИЗОВАЛИСЬ ПОСЛЕ СЛОВ БАРРО.
Dialogue: 0,0:02:10.82,0:02:13.96,Caption,,0,0,0,,ИЗМЕНИЛАСЬ СТЕПЕНЬ СТЕСНЕНИЯ. РАНЬШЕ ВОКРУГ ТЕМЫ
Dialogue: 0,0:02:14.04,0:02:16.44,Caption,,0,0,0,,ХОДИЛИ МЕЛКИМИ ШАГАМИ И СТАРАЛИСЬ НЕ НАСТУПИТЬ НА
Dialogue: 0,0:02:16.44,0:02:19.48,Caption,,0,0,0,,СОБСТВЕННЫЕ ОБЪЯСНЕНИЯ. ТЕПЕРЬ МИНИСТР СПОКОЙНО
Dialogue: 0,0:02:19.48,0:02:24.12,Caption,,0,0,0,,ПОДТВЕРЖДАЕТ ФАКТ, А СПОР СВОДИТСЯ К ПОДБОРУ УДОБНОГО НАЗВАНИЯ. ЕСЛИ
Dialogue: 0,0:02:24.12,0:02:26.35,Caption,,0,0,0,,ПРАВИЛЬНО НАЗВАТЬ УЧАСТИЕ, ОНО,
Dialogue: 0,0:02:26.45,0:02:30.44,Caption,,0,0,0,,ВЕРОЯТНО, ПЕРЕСТАЁТ БЫТЬ УЧАСТИЕМ. ОЧЕНЬ ПОЛЕЗНАЯ ТЕХНИКА,
Dialogue: 0,0:02:30.68,0:02:33.32,Caption,,0,0,0,,ОСОБЕННО ДЛЯ ТЕХ, КТО УЖЕ ЗАШЁЛ В КОМНАТУ,
Dialogue: 0,0:02:33.50,0:02:35.96,Caption,,0,0,0,,НО ПРОДОЛЖАЕТ УВЕРЯТЬ, ЧТО ОСТАЛСЯ В КОРИДОРЕ.
Dialogue: 0,0:02:38.24,0:02:41.12,Caption,,0,0,0,,ЗАЯВЛЕНИЕ БАРРО СТАЛО ОЧЕРЕДНЫМ ОБОРОТОМ ДАВНО
Dialogue: 0,0:02:41.12,0:02:44.00,Caption,,0,0,0,,РАСКРУЧИВАЕМОЙ СПИРАЛИ. ЕВРОПА НЕ ВНЕЗАПНО
Dialogue: 0,0:02:44.00,0:02:46.56,Caption,,0,0,0,,ПРОСНУЛАСЬ И РЕШИЛА ГОТОВИТЬСЯ К СТОЛКНОВЕНИЮ С
Dialogue: 0,0:02:46.56,0:02:49.36,Caption,,0,0,0,,РОССИЕЙ. УЧЕНИЯ, ПЕРЕБРОСКА СИЛ,
Dialogue: 0,0:02:49.57,0:02:51.60,Caption,,0,0,0,,УКРЕПЛЕНИЕ ВОСТОЧНОГО НАПРАВЛЕНИЯ,
Dialogue: 0,0:02:51.84,0:02:54.72,Caption,,0,0,0,,РАЗГОВОРЫ О КОНТИНГЕНТАХ, ПОЛЬСКИЙ УЧАСТОК,
Dialogue: 0,0:02:54.89,0:02:57.92,Caption,,0,0,0,,ЯДЕРНАЯ ТЕМА И ФРАНЦУЗСКИЕ СПЕЦИАЛИСТЫ СКЛАДЫВАЛИСЬ
Dialogue: 0,0:02:57.92,0:03:00.24,Caption,,0,0,0,,ПОСТЕПЕННО. ПРОСТО ОЧЕРЕДНОЙ ЭЛЕМЕНТ,
Dialogue: 0,0:03:00.47,0:03:02.56,Caption,,0,0,0,,КОТОРЫЙ ПРЕЖДЕ ПРЯТАЛИ ЗА ФОРМУЛИРОВКАМИ,
Dialogue: 0,0:03:02.79,0:03:04.72,Caption,,0,0,0,,ТЕПЕРЬ РАЗРЕШИЛИ ПРОИЗНОСИТЬ ВСЛУХ.
Dialogue: 0,0:03:06.92,0:03:08.76,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН РАЗБОР ТОГО,
Dialogue: 0,0:03:08.87,0:03:11.56,Caption,,0,0,0,,КАК ОТДЕЛЬНЫЕ РЕШЕНИЯ СКЛАДЫВАЮТСЯ В ОБЩИЙ КУРС,
Dialogue: 0,0:03:11.72,0:03:14.68,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ ЗАЯВЛЕНИЯ МИНИСТРОВ ПОЛЕЗНО
Dialogue: 0,0:03:14.68,0:03:16.76,Caption,,0,0,0,,ЧИТАТЬ ВМЕСТЕ С ГОСУДАРСТВЕННЫМИ ПЛАНАМИ,
Dialogue: 0,0:03:17.00,0:03:19.24,Caption,,0,0,0,,ПОТОМУ ЧТО ПЛАНЫ ОБЫЧНО ЧЕСТНЕЕ РЕЧЕЙ.
Dialogue: 0,0:03:21.45,0:03:24.41,Caption,,0,0,0,,ЭСТОНИЯ ГОТОВИТ ВАЖНЕЙШИЕ ЦИФРОВЫЕ СЛУЖБЫ К РАБОТЕ
Dialogue: 0,0:03:24.41,0:03:27.13,Caption,,0,0,0,,ИЗ ДРУГИХ СТРАН. РЕЧЬ НЕ О ЗАПАСНОМ ПОЧТОВОМ
Dialogue: 0,0:03:27.13,0:03:29.45,Caption,,0,0,0,,ЯЩИКЕ И НЕ О КОПИИ САЙТА ДЛЯ ТУРИСТОВ.
Dialogue: 0,0:03:29.84,0:03:32.49,Caption,,0,0,0,,ЗА РУБЕЖОМ ХОТЯТ ОБЕСПЕЧИТЬ СОХРАННОСТЬ РЕЕСТРОВ
Dialogue: 0,0:03:32.49,0:03:37.53,Caption,,0,0,0,,НАСЕЛЕНИЯ, ЗЕМЛИ, НЕДВИЖИМОСТИ И ДРУГИХ КЛЮЧЕВЫХ БАЗ. ОНИ ДОЛЖНЫ
Dialogue: 0,0:03:37.61,0:03:41.77,Caption,,0,0,0,,ПРОДОЛЖАТЬ РАБОТУ, ЕСЛИ ВНУТРЕННИЕ ЦЕНТРЫ ОБРАБОТКИ ДАННЫХ УНИЧТОЖАТ
Dialogue: 0,0:03:41.93,0:03:44.33,Caption,,0,0,0,,ИЛИ ВЛАСТИ ПОТЕРЯЮТ КОНТРОЛЬ НАД ТЕРРИТОРИЕЙ.
Dialogue: 0,0:03:46.52,0:03:49.24,Caption,,0,0,0,,ТАЛЛИН РАССМАТРИВАЕТ УЖЕ НЕ ТОЛЬКО ОБОРОНУ ГРАНИЦЫ.
Dialogue: 0,0:03:49.55,0:03:53.72,Caption,,0,0,0,,ОН ЗАРАНЕЕ ДУМАЕТ, КАК СОХРАНИТЬ ГОСУДАРСТВЕННЫЕ ФУНКЦИИ ПОСЛЕ УТРАТЫ
Dialogue: 0,0:03:53.72,0:03:56.36,Caption,,0,0,0,,ВОЗМОЖНОСТИ НОРМАЛЬНО УПРАВЛЯТЬ СОБСТВЕННОЙ ЗЕМЛЁЙ.
Dialogue: 0,0:03:56.60,0:03:59.48,Caption,,0,0,0,,ЭТО СОВСЕМ ДРУГОЙ УРОВЕНЬ ПОДГОТОВКИ. НА ТРИБУНЕ
Dialogue: 0,0:03:59.56,0:04:01.80,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО РАССКАЗЫВАТЬ О СТОЙКОСТИ,
Dialogue: 0,0:04:02.09,0:04:05.00,Caption,,0,0,0,,НО РЕЗЕРВНАЯ АДМИНИСТРАЦИЯ ЗА РУБЕЖОМ СООБЩАЕТ КУДА
Dialogue: 0,0:04:05.08,0:04:09.64,Caption,,0,0,0,,БОЛЬШЕ. ОНА ПОКАЗЫВАЕТ, КАКОЙ ИСХОД ВЛАСТИ СЧИТАЮТ ДОСТАТОЧНО РЕАЛЬНЫМ,
Dialogue: 0,0:04:09.89,0:04:11.80,Caption,,0,0,0,,ЧТОБЫ ТРАТИТЬ НА НЕГО СИЛЫ И ДЕНЬГИ.
Dialogue: 0,0:04:14.08,0:04:18.00,Caption,,0,0,0,,ЭСТОНИЯ, ЛАТВИЯ И ЛИТВА РАСПОЛОЖЕНЫ НЕ В ЗРИТЕЛЬНОМ ЗАЛЕ.
Dialogue: 0,0:04:18.40,0:04:21.60,Caption,,0,0,0,,ПРИ ПРЯМОМ СТОЛКНОВЕНИИ РОССИИ И НАТО ОНИ ОКАЖУТСЯ
Dialogue: 0,0:04:21.68,0:04:25.76,Caption,,0,0,0,,В ПЕРВОМ РЯДУ, ПРИЧЁМ БИЛЕТЫ ИМ ДОСТАЛИСЬ БЕЗ ПРАВА ПЕРЕСЕСТЬ. ИХ
Dialogue: 0,0:04:25.76,0:04:28.32,Caption,,0,0,0,,РУКОВОДИТЕЛИ ЗНАЮТ ГЕОГРАФИЮ НЕ ХУЖЕ ОСТАЛЬНЫХ.
Dialogue: 0,0:04:28.72,0:04:31.60,Caption,,0,0,0,,ЭСТОНСКИЕ ПЛАНЫ ПО ПЕРЕНОСУ УПРАВЛЕНИЯ ДОКАЗЫВАЮТ,
Dialogue: 0,0:04:31.81,0:04:34.16,Caption,,0,0,0,,ЧТО ЦЕНУ ВОЗМОЖНОЙ ВОЙНЫ ТАМ ПОНИМАЮТ БЕЗ
Dialogue: 0,0:04:34.16,0:04:38.99,Caption,,0,0,0,,ПЕРЕВОДЧИКА. ПОЧЕМУ ЖЕ КУРС ОСТАЁТСЯ ПРЕЖНИМ?
Dialogue: 0,0:04:39.42,0:04:41.31,Caption,,0,0,0,,ЗАЧЕМ ПРОДОЛЖАТЬ ВЕСТИ СЕБЯ ТАК,
Dialogue: 0,0:04:41.71,0:04:43.87,Caption,,0,0,0,,БУДТО ГДЕ ТО НА СКЛАДЕ ХРАНЯТСЯ ЕЩЁ ТРИ
Dialogue: 0,0:04:43.87,0:04:48.51,Caption,,0,0,0,,ЗАПАСНЫЕ ЭСТОНИИ, ПАРА ЛАТВИЙ И НОВАЯ ЛИТВА В ЗАВОДСКОЙ УПАКОВКЕ?
Dialogue: 0,0:04:48.81,0:04:50.99,Caption,,0,0,0,,ПРИ БОЛЬШОЙ ВОЙНЕ РЕЧЬ ПОЙДЁТ НЕ О НЕПРИЯТНОЙ
Dialogue: 0,0:04:50.99,0:04:55.31,Caption,,0,0,0,,СТАТИСТИКЕ, ПАДЕНИИ ЭКОНОМИКИ ИЛИ СМЕНЕ КАБИНЕТА. СТРАНЫ МОЖЕТ
Dialogue: 0,0:04:55.31,0:04:58.43,Caption,,0,0,0,,ПРОСТО НЕ СТАТЬ. НА ЕЁ МЕСТЕ ОСТАНЕТСЯ ТЕРРИТОРИЯ,
Dialogue: 0,0:04:58.67,0:05:01.23,Caption,,0,0,0,,КОТОРУЮ УЖЕ НЕКОМУ БУДЕТ АДМИНИСТРИРОВАТЬ ДАЖЕ С
Dialogue: 0,0:05:01.23,0:05:07.34,Caption,,0,0,0,,САМОГО ЗАЩИЩЁННОГО СЕРВЕРА. ТАКАЯ СМЕЛОСТЬ НЕ ОПИРАЕТСЯ НА СОБСТВЕННЫЕ
Dialogue: 0,0:05:07.42,0:05:10.30,Caption,,0,0,0,,ВОЗМОЖНОСТИ ПРИБАЛТИЙСКИХ ГОСУДАРСТВ. ОНА ДЕРЖИТСЯ
Dialogue: 0,0:05:10.30,0:05:13.82,Caption,,0,0,0,,НА УБЕЖДЕНИИ, ЧТО В РЕШАЮЩИЙ МОМЕНТ ЗА НИХ ВСТУПЯТСЯ ОСТАЛЬНЫЕ
Dialogue: 0,0:05:13.82,0:05:17.02,Caption,,0,0,0,,ЧЛЕНЫ НАТО. НО СОЮЗНЫЙ ДОГОВОР НЕ УМЕЕТ МЕНЯТЬ
Dialogue: 0,0:05:17.02,0:05:20.22,Caption,,0,0,0,,ГЕОГРАФИЮ. ТАЛЛИН НЕЛЬЗЯ ПЕРЕДВИНУТЬ К ЛА МАНШУ,
Dialogue: 0,0:05:20.46,0:05:24.94,Caption,,0,0,0,,РИГУ НЕ СПРЯЧЕШЬ ЗА АЛЬПАМИ, А ВИЛЬНЮС НЕ ОТПРАВИШЬ ПЕРЕЖДАТЬ КОНФЛИКТ НА БЕРЕГ
Dialogue: 0,0:05:24.94,0:05:27.90,Caption,,0,0,0,,АТЛАНТИКИ. ПЯТАЯ СТАТЬЯ МОЖЕТ ЗАПУСТИТЬ ВОЕННЫЕ
Dialogue: 0,0:05:27.90,0:05:31.34,Caption,,0,0,0,,РЕШЕНИЯ, НО НЕ ВЫДАЁТ НОВЫМ ЧЛЕНАМ ЗАПАСНОЙ МАТЕРИК.
Dialogue: 0,0:05:33.62,0:05:36.10,Caption,,0,0,0,,НА ЭТОМ ФОНЕ ОСОБЕННО ПОКАЗАТЕЛЬНО НАПАДЕНИЕ НА
Dialogue: 0,0:05:36.10,0:05:40.98,Caption,,0,0,0,,ПРЕДПРИЯТИЕ THREOD SYSTEMS, ВЫПУСКАЮЩЕЕ БЕСПИЛОТНИКИ. БЫЛА ПРЕДПРИНЯТА ПОПЫТКА
Dialogue: 0,0:05:40.98,0:05:45.30,Caption,,0,0,0,,УСТРОИТЬ ВЗРЫВ И ПОДЖОГ, ПОДОЗРЕВАЕМЫХ ЗАДЕРЖАЛИ. ЭСТОНСКАЯ СЛУЖБА
Dialogue: 0,0:05:45.30,0:05:47.86,Caption,,0,0,0,,БЕЗОПАСНОСТИ СВЯЗАЛА СЛУЧИВШЕЕСЯ С РОССИЙСКИМИ
Dialogue: 0,0:05:47.86,0:05:52.10,Caption,,0,0,0,,СПЕЦСЛУЖБАМИ И ЗАЯВИЛА, ЧТО ИНТЕРЕС К ОБОРОННОЙ ОТРАСЛИ НЕ ОГРАНИЧИВАЕТСЯ
Dialogue: 0,0:05:52.10,0:05:54.66,Caption,,0,0,0,,ОДНОЙ КОМПАНИЕЙ. ПО ОЦЕНКЕ КОНТРРАЗВЕДКИ,
Dialogue: 0,0:05:54.90,0:05:57.22,Caption,,0,0,0,,ВНИМАНИЕ МОГУТ ПРИВЛЕКАТЬ ПРИМЕРНО ДЕСЯТЬ
Dialogue: 0,0:05:57.22,0:06:03.02,Caption,,0,0,0,,ПРЕДПРИЯТИЙ. ПРЕМЬЕР КРИСТЕН МИХАЛ ПОСЛЕ ЭТОГО ПОРУЧИЛ ГОТОВИТЬСЯ
Dialogue: 0,0:06:03.10,0:06:06.14,Caption,,0,0,0,,К ЗАКРЫТИЮ СУХОПУТНЫХ ПЕРЕХОДОВ С РОССИЕЙ. МЕРА
Dialogue: 0,0:06:06.22,0:06:10.14,Caption,,0,0,0,,ВЫГЛЯДИТ РЕШИТЕЛЬНОЙ, ПОКА В РАЗГОВОР НЕ ВХОДИТ ПРЕЗИДЕНТ ЭСТОНИИ ЮЛЛЕ
Dialogue: 0,0:06:10.14,0:06:15.10,Caption,,0,0,0,,МАДИЗЕ. ОНА ПРЯМО ЗАМЕТИЛА, ЧТО ЗАКРЫТИЕ ГРАНИЦЫ НЕ ПРЕДОТВРАТИЛО БЫ НАПАДЕНИЯ
Dialogue: 0,0:06:15.18,0:06:17.82,Caption,,0,0,0,,НА THREOD SYSTEMS И ДРУГИЕ ОБОРОННЫЕ ОБЪЕКТЫ.
Dialogue: 0,0:06:20.10,0:06:22.82,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ПРЕКРАСНАЯ КОНСТРУКЦИЯ. ПРАВИТЕЛЬСТВО
Dialogue: 0,0:06:22.90,0:06:24.98,Caption,,0,0,0,,ОТВЕЧАЕТ НА КОНКРЕТНУЮ УГРОЗУ МЕРОЙ,
Dialogue: 0,0:06:25.14,0:06:27.46,Caption,,0,0,0,,КОТОРАЯ, ПО СЛОВАМ ГЛАВЫ ГОСУДАРСТВА,
Dialogue: 0,0:06:27.62,0:06:30.82,Caption,,0,0,0,,КОНКРЕТНУЮ УГРОЗУ НЕ ОСТАНОВИТ. ЗАТО ОНА ПРЕКРАСНО
Dialogue: 0,0:06:30.90,0:06:33.22,Caption,,0,0,0,,ОСТАНОВИТ ЛЮДЕЙ, ЕЗДЯЩИХ К ДЕТЯМ,
Dialogue: 0,0:06:33.38,0:06:36.58,Caption,,0,0,0,,РОДИТЕЛЯМ И ДРУГИМ РОДСТВЕННИКАМ. ДЛЯ ТЕЛЕВИЗИОННОГО
Dialogue: 0,0:06:36.58,0:06:39.62,Caption,,0,0,0,,ВЫСТУПЛЕНИЯ РЕШЕНИЕ ПОДХОДИТ ОТЛИЧНО. ДЛЯ БОРЬБЫ С
Dialogue: 0,0:06:39.62,0:06:42.42,Caption,,0,0,0,,ОПИСАННЫМ МЕХАНИЗМОМ НАПАДЕНИЯ ОНО НАПОМИНАЕТ
Dialogue: 0,0:06:42.42,0:06:44.90,Caption,,0,0,0,,БОЛЬШОЙ ЗАМОК, ПОВЕШЕННЫЙ НЕ НА ТУ ДВЕРЬ.
Dialogue: 0,0:06:47.11,0:06:50.31,Caption,,0,0,0,,ЛИТВА ТОЖЕ ДОПУСКАЕТ ЗАКРЫТИЕ ГРАНИЦЫ С РОССИЕЙ. ОБ
Dialogue: 0,0:06:50.39,0:06:53.27,Caption,,0,0,0,,ЭТОМ ГОВОРИЛ ПРЕЗИДЕНТ ГИТАНАС НАУСЕДА. ОДНАКО У
Dialogue: 0,0:06:53.35,0:06:55.43,Caption,,0,0,0,,ЛИТВЫ ЕСТЬ КАЛИНИНГРАД И ОБЯЗАТЕЛЬСТВА,
Dialogue: 0,0:06:55.53,0:06:58.31,Caption,,0,0,0,,СВЯЗАННЫЕ С ТРАНЗИТОМ. ПОЭТОМУ ЭФФЕКТНЫЙ ЖЕСТ
Dialogue: 0,0:06:58.31,0:07:00.07,Caption,,0,0,0,,НЕМЕДЛЕННО ОБРАСТАЕТ ВОПРОСАМИ,
Dialogue: 0,0:07:00.31,0:07:03.51,Caption,,0,0,0,,КОТОРЫЕ НЕ ПОМЕЩАЮТСЯ В КОРОТКУЮ РЕЧЬ. ЗА ШЛАГБАУМОМ
Dialogue: 0,0:07:03.51,0:07:08.55,Caption,,0,0,0,,НИКУДА НЕ ИСЧЕЗАЮТ МАРШРУТЫ, ДОГОВОРЁННОСТИ И РОССИЙСКИЙ РЕГИОН. ГРАНИЦУ НЕЛЬЗЯ
Dialogue: 0,0:07:08.63,0:07:11.59,Caption,,0,0,0,,ПРОСТО ЗАДЁРНУТЬ, КАК ШТОРУ, А ПОТОМ УДИВИТЬСЯ,
Dialogue: 0,0:07:11.74,0:07:13.75,Caption,,0,0,0,,ЧТО ЗА ОКНОМ ВСЁ ОСТАЛОСЬ НА МЕСТЕ.
Dialogue: 0,0:07:16.02,0:07:18.58,Caption,,0,0,0,,КАЛИНИНГРАДСКОЕ НАПРАВЛЕНИЕ УСИЛИВАЕТ И ПОЛЬША.
Dialogue: 0,0:07:18.90,0:07:21.78,Caption,,0,0,0,,ПОЛЬСКАЯ ГАЗЕТА RZECZPOSPOLITA СООБЩИЛА О ЯКОБЫ
Dialogue: 0,0:07:21.78,0:07:24.66,Caption,,0,0,0,,ГОТОВИВШЕЙСЯ РОССИЙСКОЙ ОПЕРАЦИИ ПОД ЧУЖИМ ФЛАГОМ.
Dialogue: 0,0:07:24.99,0:07:28.98,Caption,,0,0,0,,ПО ИЗЛОЖЕННОЙ ВЕРСИИ, УЧАСТНИКИ ДОЛЖНЫ БЫЛИ ВЫДАТЬ СЕБЯ ЗА УКРАИНСКИХ
Dialogue: 0,0:07:28.98,0:07:32.42,Caption,,0,0,0,,ДИВЕРСАНТОВ, ПЕРЕСЕЧЬ ГРАНИЦУ И СОЗДАТЬ ПОВОД ДЛЯ КРУПНОЙ
Dialogue: 0,0:07:32.42,0:07:35.70,Caption,,0,0,0,,ЭСКАЛАЦИИ. ИСТОЧНИКИ ИЗДАНИЯ ГОВОРИЛИ О РАСЧЁТЕ НА
Dialogue: 0,0:07:35.70,0:07:38.66,Caption,,0,0,0,,МНОЖЕСТВО ЖЕРТВ И О НАМЕРЕНИИ ПОДОРВАТЬ ПОЛЬСКУЮ
Dialogue: 0,0:07:38.66,0:07:43.59,Caption,,0,0,0,,ПОДДЕРЖКУ УКРАИНЫ. ПОЛЬСКИЕ СЛУЖБЫ УТВЕРЖДАЮТ,
Dialogue: 0,0:07:43.71,0:07:46.63,Caption,,0,0,0,,ЧТО ЗАМЫСЕЛ СОРВАЛИ. РАССКАЗ ПРИ ЭТОМ ПОЛУЧИЛСЯ
Dialogue: 0,0:07:46.63,0:07:49.83,Caption,,0,0,0,,УДИВИТЕЛЬНО ПОДРОБНЫМ ТАМ, ГДЕ ОПИСЫВАЮТСЯ ЦЕЛЬ,
Dialogue: 0,0:07:49.99,0:07:53.51,Caption,,0,0,0,,ЛЕГЕНДА ИСПОЛНИТЕЛЕЙ И ОЖИДАЕМЫЙ РЕЗУЛЬТАТ. КОГДА
Dialogue: 0,0:07:53.59,0:07:55.67,Caption,,0,0,0,,ДЕЛО ДОХОДИТ ДО СПОСОБА ПРЕСЕЧЕНИЯ,
Dialogue: 0,0:07:55.83,0:07:57.91,Caption,,0,0,0,,ЗАДЕРЖАННЫХ ЛЮДЕЙ И НАЙДЕННЫХ СРЕДСТВ,
Dialogue: 0,0:07:58.21,0:08:01.03,Caption,,0,0,0,,ПОДРОБНОСТЕЙ СТАНОВИТСЯ ЗАМЕТНО МЕНЬШЕ. ИСТОРИЯ
Dialogue: 0,0:08:01.03,0:08:03.27,Caption,,0,0,0,,ЗНАЕТ, ЧЕГО ХОТЕЛИ ДИВЕРСАНТЫ,
Dialogue: 0,0:08:03.43,0:08:05.99,Caption,,0,0,0,,КЕМ ДОЛЖНЫ БЫЛИ ПРИТВОРИТЬСЯ И КАКОЙ ЭФФЕКТ
Dialogue: 0,0:08:05.99,0:08:09.11,Caption,,0,0,0,,ПЛАНИРОВАЛИ, НО СКРОМНИЧАЕТ ИМЕННО В ТОЙ ЧАСТИ,
Dialogue: 0,0:08:09.34,0:08:11.91,Caption,,0,0,0,,ГДЕ ОБЫЧНО ПОЯВЛЯЮТСЯ НАРУЧНИКИ И ВЕЩЕСТВЕННЫЕ
Dialogue: 0,0:08:11.91,0:08:17.14,Caption,,0,0,0,,ДОКАЗАТЕЛЬСТВА. ПОЛЬША ДЕЙСТВИТЕЛЬНО УКРЕПЛЯЕТ ГРАНИЦУ С
Dialogue: 0,0:08:17.14,0:08:20.02,Caption,,0,0,0,,КАЛИНИНГРАДОМ И ОДНОВРЕМЕННО ПОДДЕРЖИВАЕТ УКРАИНУ.
Dialogue: 0,0:08:20.26,0:08:23.14,Caption,,0,0,0,,ПРИБАЛТИЙСКИЕ СТРАНЫ ОБСУЖДАЮТ ПЕРЕКРЫТИЕ ПЕРЕХОДОВ.
Dialogue: 0,0:08:23.46,0:08:26.42,Caption,,0,0,0,,ФРАНЦИЯ БОЛЬШЕ НЕ СКРЫВАЕТ СВОИХ СПЕЦИАЛИСТОВ. ЭТО
Dialogue: 0,0:08:26.42,0:08:30.58,Caption,,0,0,0,,НЕ РАЗНЫЕ ПЬЕСЫ, СЛУЧАЙНО ПОСТАВЛЕННЫЕ В СОСЕДНИХ ЗАЛАХ. ПЕРЕД НАМИ
Dialogue: 0,0:08:30.66,0:08:35.54,Caption,,0,0,0,,ОДНО НАРАЩИВАНИЕ НАПРЯЖЕНИЯ, ПРОСТО КАЖДЫЙ УЧАСТНИК ОТВЕЧАЕТ ЗА СВОЙ УЧАСТОК И
Dialogue: 0,0:08:35.54,0:08:37.54,Caption,,0,0,0,,СТАРАЕТСЯ ВЫГЛЯДЕТЬ САМЫМ РЕШИТЕЛЬНЫМ.
Dialogue: 0,0:08:39.83,0:08:41.75,Caption,,0,0,0,,ПОТОМ К РЕШИМОСТИ ПОДХОДИТ КАССИР,
Dialogue: 0,0:08:41.98,0:08:45.03,Caption,,0,0,0,,И ВЫРАЖЕНИЯ ЛИЦ МЕНЯЮТСЯ. МАРК РЮТТЕ ПРИЗНАЛ,
Dialogue: 0,0:08:45.19,0:08:48.07,Caption,,0,0,0,,ЧТО ДО СОГЛАСОВАННОГО ОБЪЁМА ВОЕННОЙ ПОМОЩИ УКРАИНЕ
Dialogue: 0,0:08:48.07,0:08:51.19,Caption,,0,0,0,,В СЕМЬДЕСЯТ МИЛЛИАРДОВ ДОЛЛАРОВ СОЮЗНИКАМ НЕДОСТАЁТ
Dialogue: 0,0:08:51.19,0:08:53.83,Caption,,0,0,0,,НЕСКОЛЬКИХ МИЛЛИАРДОВ. ЗАКУПКИ АМЕРИКАНСКОГО
Dialogue: 0,0:08:53.91,0:08:56.31,Caption,,0,0,0,,ВООРУЖЕНИЯ НА ЕВРОПЕЙСКИЕ И КАНАДСКИЕ ДЕНЬГИ
Dialogue: 0,0:08:56.31,0:08:59.27,Caption,,0,0,0,,СОСТАВИЛИ ОКОЛО ДЕСЯТИ МИЛЛИАРДОВ. ПРЕЖДЕ ЗВУЧАЛ
Dialogue: 0,0:08:59.27,0:09:01.83,Caption,,0,0,0,,ОРИЕНТИР ОТ ДВЕНАДЦАТИ ДО ПЯТНАДЦАТИ МИЛЛИАРДОВ,
Dialogue: 0,0:09:02.07,0:09:06.63,Caption,,0,0,0,,ОДНАКО РЮТТЕ ОБЪЯСНИЛ, ЧТО ФАКТИЧЕСКАЯ ПОТРЕБНОСТЬ ОКАЗАЛАСЬ НИЖЕ. С ОБЩЕЙ
Dialogue: 0,0:09:06.71,0:09:09.59,Caption,,0,0,0,,ЦЕЛЬЮ ТАКОГО УДОБНОГО ОБЪЯСНЕНИЯ НЕТ. СЕМЬДЕСЯТ
Dialogue: 0,0:09:09.59,0:09:12.79,Caption,,0,0,0,,МИЛЛИАРДОВ СОГЛАСОВАЛИ, НО ВСЮ СУММУ ПОКА НЕ СОБРАЛИ.
Dialogue: 0,0:09:15.07,0:09:17.95,Caption,,0,0,0,,ВОЕННЫХ СПЕЦИАЛИСТОВ ОТПРАВИЛИ. ЗАКРЫТИЕ ГРАНИЦ
Dialogue: 0,0:09:17.95,0:09:21.14,Caption,,0,0,0,,ОБСУЖДАЮТ. ГОСУДАРСТВЕННЫЕ РЕЕСТРЫ ГОТОВЯТ К ЖИЗНИ
Dialogue: 0,0:09:21.14,0:09:23.95,Caption,,0,0,0,,ЗА РУБЕЖОМ. КОГДА ТРЕБУЕТСЯ ОПЛАТИТЬ УЖЕ ПРИНЯТОЕ
Dialogue: 0,0:09:23.95,0:09:27.71,Caption,,0,0,0,,РЕШЕНИЕ, В ОБЩЕЙ КАССЕ ОБНАРУЖИВАЕТСЯ АККУРАТНАЯ НЕДОСТАЧА.
Dialogue: 0,0:09:28.10,0:09:31.14,Caption,,0,0,0,,ВИДИМО, ВОИНСТВЕННОСТЬ ПРИНИМАЮТ БЕЗ ПРЕДВАРИТЕЛЬНОГО
Dialogue: 0,0:09:31.14,0:09:33.71,Caption,,0,0,0,,ВЗНОСА, А СЧЁТ ПРИХОДИТ НЕМНОГО ПОЗЖЕ.
Dialogue: 0,0:09:35.99,0:09:38.39,Caption,,0,0,0,,ИМЕННО ЗДЕСЬ ЕВРОПЕЙСКАЯ ЛИНИЯ УПИРАЕТСЯ В
Dialogue: 0,0:09:38.39,0:09:41.19,Caption,,0,0,0,,АМЕРИКАНСКУЮ. ЕВРОПА ПОВЫШАЕТ СТАВКИ,
Dialogue: 0,0:09:41.51,0:09:43.99,Caption,,0,0,0,,НО ЗНАЧИТЕЛЬНАЯ ЧАСТЬ ОРУЖИЯ, ДЕНЕГ,
Dialogue: 0,0:09:44.07,0:09:46.63,Caption,,0,0,0,,ТЕХНОЛОГИЙ И ГАРАНТИЙ ВСЁ РАВНО ЗАВИСИТ ОТ
Dialogue: 0,0:09:46.63,0:09:49.91,Caption,,0,0,0,,ВАШИНГТОНА. А В ВАШИНГТОНЕ ПРЕЖНИЕ СОЮЗНИКИ УЖЕ
Dialogue: 0,0:09:49.91,0:09:54.39,Caption,,0,0,0,,РАЗБИРАЮТ СТАРЫЕ ОТНОШЕНИЯ, ВЫСТАВЛЯЮТ ДРУГ ДРУГУ СЧЕТА ЗА БЛАГОДАРНОСТЬ И
Dialogue: 0,0:09:54.39,0:09:57.11,Caption,,0,0,0,,ГОТОВЯТ НОВЫЕ УСЛОВИЯ. ЕСЛИ ПРИБАЛТИЙСКИЕ
Dialogue: 0,0:09:57.11,0:10:00.87,Caption,,0,0,0,,РУКОВОДИТЕЛИ УВЕРЕНЫ, ЧТО ОСТАЛЬНЫЕ ОБЯЗАТЕЛЬНО ВСТУПЯТ В ДРАКУ,
Dialogue: 0,0:10:01.11,0:10:04.63,Caption,,0,0,0,,ИМ ПОЛЕЗНО ПОСЛУШАТЬ, КАК ЭТИ ОСТАЛЬНЫЕ РАЗГОВАРИВАЮТ О ТЕХ,
Dialogue: 0,0:10:04.95,0:10:07.75,Caption,,0,0,0,,КОГО ЕЩЁ НЕДАВНО НАЗЫВАЛИ БЕЗУСЛОВНЫМИ ПАРТНЁРАМИ.
Dialogue: 0,0:10:10.03,0:10:12.83,Caption,,0,0,0,,ДЖО БАЙДЕН В МЕМУАРАХ ОПИСАЛ ВЛАДИМИРА ЗЕЛЕНСКОГО
Dialogue: 0,0:10:12.91,0:10:16.51,Caption,,0,0,0,,КАК КАПРИЗНОГО, УПРЯМОГО И НЕ НАСТОЛЬКО БЛАГОДАРНОГО,
Dialogue: 0,0:10:16.59,0:10:19.47,Caption,,0,0,0,,НАСКОЛЬКО ОЖИДАЛ БЫВШИЙ ПРЕЗИДЕНТ США. ЗА
Dialogue: 0,0:10:19.55,0:10:21.63,Caption,,0,0,0,,ОФИЦИАЛЬНЫМИ РЕЧАМИ, ОКАЗЫВАЕТСЯ,
Dialogue: 0,0:10:21.79,0:10:24.03,Caption,,0,0,0,,ВСЁ ЭТО ВРЕМЯ РАБОТАЛ НЕВИДИМЫЙ СЧЁТЧИК
Dialogue: 0,0:10:24.03,0:10:26.91,Caption,,0,0,0,,ПРИЗНАТЕЛЬНОСТИ. ВАШИНГТОН ОТПРАВЛЯЛ ДЕНЬГИ,
Dialogue: 0,0:10:26.99,0:10:29.15,Caption,,0,0,0,,ОРУЖИЕ И ПОЛИТИЧЕСКУЮ ПОДДЕРЖКУ,
Dialogue: 0,0:10:29.39,0:10:32.83,Caption,,0,0,0,,А ЗАТЕМ ПРОВЕРЯЛ, ДОСТАТОЧНО ЛИ ТЕПЛО ПОЛУЧАТЕЛЬ ПОБЛАГОДАРИЛ
Dialogue: 0,0:10:32.83,0:10:35.55,Caption,,0,0,0,,ОТПРАВИТЕЛЯ. ПОКАЗАНИЯ ПРИБОРА БАЙДЕНУ ЯВНО НЕ
Dialogue: 0,0:10:35.63,0:10:41.28,Caption,,0,0,0,,ПОНРАВИЛИСЬ. ГОРАЗДО ВАЖНЕЕ ДРУГОЕ ПРИЗНАНИЕ. ПОСЛЕ ПОБЕДЫ
Dialogue: 0,0:10:41.28,0:10:44.48,Caption,,0,0,0,,ДОНАЛЬДА ТРАМПА ЕГО КОМАНДА ПРОСИЛА РАЗРЕШИТЬ ПРЯМЫЕ
Dialogue: 0,0:10:44.48,0:10:47.52,Caption,,0,0,0,,КОНТАКТЫ С ВЛАДИМИРОМ ПУТИНЫМ ЕЩЁ ДО ВСТУПЛЕНИЯ
Dialogue: 0,0:10:47.52,0:10:50.56,Caption,,0,0,0,,НОВОГО ПРЕЗИДЕНТА В ДОЛЖНОСТЬ. БАЙДЕН ОТКАЗАЛ,
Dialogue: 0,0:10:50.72,0:10:53.92,Caption,,0,0,0,,ПОТОМУ ЧТО СЧИТАЛ БУДУЩИЙ ПОДХОД ТРАМПА КАПИТУЛЯЦИЕЙ
Dialogue: 0,0:10:53.92,0:10:57.12,Caption,,0,0,0,,ЗА СЧЁТ УКРАИНЫ. УХОДЯЩАЯ АДМИНИСТРАЦИЯ НЕ ПРОСТО НЕ
Dialogue: 0,0:10:57.12,0:11:00.24,Caption,,0,0,0,,СОГЛАШАЛАСЬ С ПРЕЕМНИКАМИ. ОНА ЗАДЕРЖАЛА НАЧАЛО ИХ
Dialogue: 0,0:11:00.24,0:11:03.52,Caption,,0,0,0,,ЛИНИИ, НАСКОЛЬКО МОГЛА. ПЕРЕДАЧА ВЛАСТИ ВЫГЛЯДЕЛА КАК
Dialogue: 0,0:11:03.60,0:11:08.56,Caption,,0,0,0,,ПЕРЕДАЧА АВТОМОБИЛЯ ЧЕЛОВЕКУ, КОТОРОМУ ПРЕЖНИЙ ВОДИТЕЛЬ НА ПРОЩАНИЕ ЗАБРАЛ КЛЮЧИ И
Dialogue: 0,0:11:08.56,0:11:10.96,Caption,,0,0,0,,ОБЪЯСНИЛ, ЧТО ТАК БУДЕТ БЕЗОПАСНЕЕ.
Dialogue: 0,0:11:13.24,0:11:16.04,Caption,,0,0,0,,ПОСЛЕ ПРИХОДА КОМАНДЫ ТРАМПА ОТНОШЕНИЕ СТАЛО ЕЩЁ
Dialogue: 0,0:11:16.04,0:11:19.40,Caption,,0,0,0,,ЖЁСТЧЕ. THE ATLANTIC ОПИСЫВАЛ ОБСТАНОВКУ В ПЕНТАГОНЕ
Dialogue: 0,0:11:19.48,0:11:21.96,Caption,,0,0,0,,ПОСЛЕ ПУБЛИЧНОЙ ПЕРЕПАЛКИ ТРАМПА И ЗЕЛЕНСКОГО В
Dialogue: 0,0:11:22.04,0:11:24.76,Caption,,0,0,0,,БЕЛОМ ДОМЕ. ПО СЛОВАМ УКРАИНСКОГО ЧИНОВНИКА,
Dialogue: 0,0:11:24.92,0:11:27.72,Caption,,0,0,0,,ПИТ ХЕГСЕТ НЕ ЖЕЛАЛ ДАЖЕ СЛЫШАТЬ СЛОВО УКРАИНА.
Dialogue: 0,0:11:28.10,0:11:31.00,Caption,,0,0,0,,АМЕРИКАНСКИЙ ОФИЦЕР ВСПОМИНАЛ ПРЕЗРИТЕЛЬНЫЕ УСМЕШКИ,
Dialogue: 0,0:11:31.16,0:11:34.28,Caption,,0,0,0,,КОТОРЫМИ ВСТРЕЧАЛИ ЭТУ ТЕМУ. КИЕВ В ГЛАЗАХ НОВОЙ
Dialogue: 0,0:11:34.28,0:11:37.32,Caption,,0,0,0,,КОМАНДЫ ПРЕВРАТИЛСЯ ИЗ СОЮЗНИКА В ПРОСИТЕЛЯ.
Dialogue: 0,0:11:39.60,0:11:41.84,Caption,,0,0,0,,ПРИ БАЙДЕНЕ ЗЕЛЕНСКОМУ ПРЕДЪЯВЛЯЛИ СЧЁТ ЗА
Dialogue: 0,0:11:41.84,0:11:44.48,Caption,,0,0,0,,НЕДОСТАТОЧНУЮ БЛАГОДАРНОСТЬ. ПРИ ТРАМПЕ ЕМУ
Dialogue: 0,0:11:44.48,0:11:48.00,Caption,,0,0,0,,ПОКАЗАЛИ, У КОГО ЛЕЖАТ КАРТЫ И КТО УСТАНАВЛИВАЕТ ЦЕНУ
Dialogue: 0,0:11:48.00,0:11:51.52,Caption,,0,0,0,,СЛЕДУЮЩЕЙ ПАРТИИ. ПУТЬ ОТ ОБЕЩАНИЙ ПОМОГАТЬ СТОЛЬКО,
Dialogue: 0,0:11:51.70,0:11:55.84,Caption,,0,0,0,,СКОЛЬКО ПОТРЕБУЕТСЯ, ДО РАЗДРАЖЁННОГО ВОПРОСА О ЦЕЛИ ОЧЕРЕДНОГО ВИЗИТА
Dialogue: 0,0:11:55.84,0:11:58.08,Caption,,0,0,0,,ОКАЗАЛСЯ КОРОЧЕ, ЧЕМ РЕКЛАМИРОВАЛИ.
Dialogue: 0,0:12:00.37,0:12:02.77,Caption,,0,0,0,,ТА ЖЕ ПЕРЕМЕНА ВИДНА В ЕВРОПЕЙСКОМ РАЗГОВОРЕ О
Dialogue: 0,0:12:02.77,0:12:05.97,Caption,,0,0,0,,БЕЗОПАСНОСТИ. КАЯ КАЛЛАС РАССУЖДАЕТ О НЫНЕШНЕМ
Dialogue: 0,0:12:05.97,0:12:09.97,Caption,,0,0,0,,КРИЗИСЕ ТАК, БУДТО ИСХОДНАЯ ТОЧКА ПОЯВИЛАСЬ ПОСЛЕ НАЧАЛА БОЕВЫХ
Dialogue: 0,0:12:09.97,0:12:12.85,Caption,,0,0,0,,ДЕЙСТВИЙ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОМ ГОДУ. ОДНАКО
Dialogue: 0,0:12:12.93,0:12:15.65,Caption,,0,0,0,,В КОНЦЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА МОСКВА
Dialogue: 0,0:12:15.65,0:12:17.97,Caption,,0,0,0,,ПРЕДСТАВИЛА ПРЕДЛОЖЕНИЯ ПО НОВОЙ СИСТЕМЕ
Dialogue: 0,0:12:17.97,0:12:21.17,Caption,,0,0,0,,БЕЗОПАСНОСТИ В ЕВРОПЕ. ИХ ОТВЕРГЛИ. ИРЛАНДСКИЙ
Dialogue: 0,0:12:21.17,0:12:24.53,Caption,,0,0,0,,ЖУРНАЛИСТ ЧЕЙ БОУЗ СОПОСТАВИЛ ТОТ ПАКЕТ С НЫНЕШНИМИ
Dialogue: 0,0:12:24.61,0:12:26.93,Caption,,0,0,0,,РОССИЙСКИМИ ТРЕБОВАНИЯМИ И ПРИШЁЛ К ВЫВОДУ,
Dialogue: 0,0:12:27.17,0:12:29.81,Caption,,0,0,0,,ЧТО ПРЕЖНЯЯ ВОЗМОЖНОСТЬ БОЛЕЕ МЯГКОГО СОГЛАШЕНИЯ
Dialogue: 0,0:12:29.81,0:12:32.77,Caption,,0,0,0,,БЫЛА УПУЩЕНА, А СЛЕДУЮЩИЙ РАЗГОВОР СТАЛ ДОРОЖЕ.
Dialogue: 0,0:12:35.06,0:12:37.06,Caption,,0,0,0,,ЕВРОПА ВПРАВЕ НЕ ПРИНИМАТЬ УСЛОВИЯ,
Dialogue: 0,0:12:37.22,0:12:39.86,Caption,,0,0,0,,КОТОРЫЕ ЕЁ НЕ УСТРАИВАЮТ. НО ОТКАЗ САМ ПО
Dialogue: 0,0:12:39.86,0:12:42.82,Caption,,0,0,0,,СЕБЕ НЕ ЯВЛЯЕТСЯ СТРАТЕГИЕЙ НА ВСЕ ВРЕМЕНА. ЧТО
Dialogue: 0,0:12:42.82,0:12:45.22,Caption,,0,0,0,,ИДЁТ СЛЕДОМ? НОВЫЙ ПАКЕТ САНКЦИЙ,
Dialogue: 0,0:12:45.38,0:12:49.78,Caption,,0,0,0,,ЕЩЁ ОДИН ГОД ДАВЛЕНИЯ, ОЧЕРЕДНОЕ ЗАЯВЛЕНИЕ О НЕПОДХОДЯЩЕМ МОМЕНТЕ ДЛЯ
Dialogue: 0,0:12:49.78,0:12:53.94,Caption,,0,0,0,,ПЕРЕГОВОРОВ? МАЛЕНЬКИЕ ГОСУДАРСТВА СНОВА ГОВОРЯТ ГРОМЧЕ БОЛЬШИХ,
Dialogue: 0,0:12:54.23,0:12:56.82,Caption,,0,0,0,,ХОТЯ СТАРЫЙ ВОПРОС О КОЛИЧЕСТВЕ ДИВИЗИЙ ТАК И
Dialogue: 0,0:12:56.82,0:13:03.41,Caption,,0,0,0,,НЕ ПОЛУЧИЛ НОВОГО ОТВЕТА. ЗА НЕСКОЛЬКО ЛЕТ ВРЕМЯ САМО СТАЛО ЧАСТЬЮ ЦЕНЫ.
Dialogue: 0,0:13:03.81,0:13:06.45,Caption,,0,0,0,,ВМЕСТО ПРЕЖНЕГО ПРОЕКТА ДОГОВОРЁННОСТЕЙ ЕВРОПА
Dialogue: 0,0:13:06.45,0:13:11.01,Caption,,0,0,0,,ПОЛУЧИЛА ВОЙНУ, РАСТУЩИЕ АРМИИ У ГРАНИЦ И БОЛЕЕ ТЯЖЁЛЫЕ УСЛОВИЯ
Dialogue: 0,0:13:11.01,0:13:13.97,Caption,,0,0,0,,ВОЗМОЖНОГО ТОРГА. ТЕПЕРЬ ТЕ ЖЕ СТОЛИЦЫ ГОТОВЯТ
Dialogue: 0,0:13:14.05,0:13:17.01,Caption,,0,0,0,,ЦИФРОВОЕ УПРАВЛЕНИЕ ИЗ ДРУГИХ СТРАН И РАССЧИТЫВАЮТ,
Dialogue: 0,0:13:17.17,0:13:20.45,Caption,,0,0,0,,ЧТО ВАШИНГТОН ОСТАНЕТСЯ ПРЕЖНИМ. НО ВАШИНГТОН УЖЕ НЕ
Dialogue: 0,0:13:20.45,0:13:22.53,Caption,,0,0,0,,ПРЕЖНИЙ ДАЖЕ ПО СОБСТВЕННЫМ МЕМУАРАМ.
Dialogue: 0,0:13:24.72,0:13:27.04,Caption,,0,0,0,,ИЛОН МАСК ДОБАВИЛ В ЭТОТ СПОР ЕЩЁ ОДНУ
Dialogue: 0,0:13:27.04,0:13:30.16,Caption,,0,0,0,,НЕУДОБНУЮ ГЛАВУ. ОН НАЗВАЛ РОССИЮ АГРЕССОРОМ,
Dialogue: 0,0:13:30.48,0:13:32.56,Caption,,0,0,0,,А МАЙДАН ДВЕ ТЫСЯЧИ ЧЕТЫРНАДЦАТОГО ГОДА
Dialogue: 0,0:13:32.56,0:13:34.96,Caption,,0,0,0,,ОХАРАКТЕРИЗОВАЛ КАК ГОСУДАРСТВЕННЫЙ ПЕРЕВОРОТ,
Dialogue: 0,0:13:35.20,0:13:38.24,Caption,,0,0,0,,ОРГАНИЗОВАННЫЙ СОЕДИНЁННЫМИ ШТАТАМИ РАДИ СВЕРЖЕНИЯ
Dialogue: 0,0:13:38.24,0:13:41.12,Caption,,0,0,0,,ДЕМОКРАТИЧЕСКИ ИЗБРАННОГО ПРОРОССИЙСКОГО ПРЕЗИДЕНТА.
Dialogue: 0,0:13:41.52,0:13:43.92,Caption,,0,0,0,,ТАКОЕ ОБВИНЕНИЕ ЗВУЧИТ НЕ ИЗ УСТ РОССИЙСКОГО
Dialogue: 0,0:13:43.92,0:13:47.28,Caption,,0,0,0,,ЧИНОВНИКА, А ОТ ОДНОГО ИЗ САМЫХ ИЗВЕСТНЫХ ПРЕДПРИНИМАТЕЛЕЙ
Dialogue: 0,0:13:47.28,0:13:52.43,Caption,,0,0,0,,АМЕРИКИ. В КОНЦЕ ДВЕ ТЫСЯЧИ ТРИНАДЦАТОГО ГОДА ПОМОЩНИК
Dialogue: 0,0:13:52.43,0:13:55.31,Caption,,0,0,0,,ГОСУДАРСТВЕННОГО СЕКРЕТАРЯ ВИКТОРИЯ НУЛАНД ПРИЕЗЖАЛА
Dialogue: 0,0:13:55.31,0:13:58.43,Caption,,0,0,0,,НА МАЙДАН И РАЗДАВАЛА УЧАСТНИКАМ ЕДУ. В ИСТОРИЮ
Dialogue: 0,0:13:58.51,0:14:01.23,Caption,,0,0,0,,ВОШЛИ ПЕЧЕНЬЯ, ХОТЯ НУЛАНД ЗАТЕМ УТОЧНЯЛА,
Dialogue: 0,0:14:01.33,0:14:04.11,Caption,,0,0,0,,ЧТО РЕЧЬ ШЛА О БУТЕРБРОДАХ. ТУДА ПРИЕЗЖАЛИ ГЛАВА
Dialogue: 0,0:14:04.11,0:14:07.23,Caption,,0,0,0,,ВНЕШНЕПОЛИТИЧЕСКОЙ СЛУЖБЫ ЕВРОСОЮЗА КЭТРИН ЭШТОН,
Dialogue: 0,0:14:07.34,0:14:10.75,Caption,,0,0,0,,КАЯ КАЛЛАС И МИНИСТР ИНОСТРАННЫХ ДЕЛ ГЕРМАНИИ ГИДО
Dialogue: 0,0:14:10.75,0:14:14.03,Caption,,0,0,0,,ВЕСТЕРВЕЛЛЕ. ПОСЛЕДНИЙ ПОЯВЛЯЛСЯ НА ПЛОЩАДИ ВМЕСТЕ С
Dialogue: 0,0:14:14.03,0:14:17.07,Caption,,0,0,0,,УКРАИНСКИМИ ОППОЗИЦИОНЕРАМИ. АМЕРИКАНСКИЕ СЕНАТОРЫ
Dialogue: 0,0:14:17.07,0:14:19.63,Caption,,0,0,0,,ДЖОН МАККЕЙН И КРИС МЁРФИ ВЫСТУПАЛИ ПЕРЕД
Dialogue: 0,0:14:19.63,0:14:25.59,Caption,,0,0,0,,ПРОТЕСТУЮЩИМИ. ПРЕДСТАВЬТЕ ЗЕРКАЛЬНУЮ КАРТИНУ. В ПАРИЖЕ ИДУТ
Dialogue: 0,0:14:25.59,0:14:28.55,Caption,,0,0,0,,МАССОВЫЕ ВЫСТУПЛЕНИЯ ПРОТИВ ПРАВИТЕЛЬСТВА. СЕРГЕЙ
Dialogue: 0,0:14:28.55,0:14:30.87,Caption,,0,0,0,,РЯБКОВ ПРИЕЗЖАЕТ НА ПЛОЩАДЬ С БУТЕРБРОДАМИ.
Dialogue: 0,0:14:31.19,0:14:33.59,Caption,,0,0,0,,РОССИЙСКИЕ ПРЕДСТАВИТЕЛИ ШАГАЮТ РЯДОМ С ЛИДЕРАМИ
Dialogue: 0,0:14:33.59,0:14:37.59,Caption,,0,0,0,,ФРАНЦУЗСКОЙ ОППОЗИЦИИ, А СЕНАТОРЫ ИЗ МОСКВЫ ПОДНИМАЮТСЯ НА СЦЕНУ И
Dialogue: 0,0:14:37.59,0:14:40.47,Caption,,0,0,0,,ОБЕЩАЮТ ПОДДЕРЖКУ. ФРАНЦУЗСКИЕ ВЛАСТИ ВРЯД ЛИ
Dialogue: 0,0:14:40.55,0:14:43.03,Caption,,0,0,0,,НАЗВАЛИ БЫ ЭТО ГАСТРОНОМИЧЕСКОЙ МИССИЕЙ ДРУЖБЫ.
Dialogue: 0,0:14:43.22,0:14:45.51,Caption,,0,0,0,,СЛОВО ВМЕШАТЕЛЬСТВО ПРОЗВУЧАЛО БЫ РАНЬШЕ,
Dialogue: 0,0:14:45.66,0:14:47.51,Caption,,0,0,0,,ЧЕМ РАЗВЕРНУЛИ ПЕРВУЮ САЛФЕТКУ.
Dialogue: 0,0:14:49.77,0:14:52.41,Caption,,0,0,0,,ПОЭТОМУ ЗАЯВЛЕНИЕ МАСКА БЬЁТ НЕ ТОЛЬКО ТЯЖЕСТЬЮ
Dialogue: 0,0:14:52.41,0:14:55.21,Caption,,0,0,0,,ОБВИНЕНИЯ. ОНО ПРОВЕРЯЕТ ЗАПАДНОЕ ПРАВИЛО НА
Dialogue: 0,0:14:55.21,0:14:58.33,Caption,,0,0,0,,СИММЕТРИЮ. ЕСЛИ ПРИСУТСТВИЕ ИНОСТРАННОГО ЧИНОВНИКА
Dialogue: 0,0:14:58.33,0:15:00.81,Caption,,0,0,0,,СРЕДИ ПРОТЕСТУЮЩИХ ЯВЛЯЕТСЯ ВМЕШАТЕЛЬСТВОМ,
Dialogue: 0,0:15:01.05,0:15:03.69,Caption,,0,0,0,,ОЦЕНКА НЕ ДОЛЖНА ЗАВИСЕТЬ ОТ ЦВЕТА ЕГО ПАСПОРТА.
Dialogue: 0,0:15:04.09,0:15:06.81,Caption,,0,0,0,,ЕСЛИ ЖЕ ОДНИМ РАЗРЕШЕНО ПОДДЕРЖИВАТЬ ДЕМОКРАТИЮ НА
Dialogue: 0,0:15:06.89,0:15:10.65,Caption,,0,0,0,,ЧУЖОЙ ПЛОЩАДИ, А ДРУГИМ ЗАПРЕЩЕНО ДАЖЕ СМОТРЕТЬ В ЕЁ СТОРОНУ,
Dialogue: 0,0:15:10.89,0:15:12.97,Caption,,0,0,0,,ЗНАЧИТ ПРАВИЛО ЗАМЕНИЛИ ПРИВИЛЕГИЕЙ.
Dialogue: 0,0:15:15.24,0:15:18.12,Caption,,0,0,0,,МАСК ПРОДОЛЖИЛ СПОР УЖЕ ВОКРУГ СПУТНИКОВОЙ СВЯЗИ.
Dialogue: 0,0:15:18.52,0:15:20.76,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ОБВИНЯЛ АМЕРИКАНСКУЮ СТОРОНУ В
Dialogue: 0,0:15:20.76,0:15:25.64,Caption,,0,0,0,,ОГРАНИЧЕНИЯХ. МАСК ОТВЕТИЛ, ЧТО УКРАИНСКИЙ ПРЕЗИДЕНТ НЕ ВСЕГДА ГОВОРИТ ПРАВДУ,
Dialogue: 0,0:15:25.88,0:15:29.40,Caption,,0,0,0,,И РАЗДЕЛИЛ КОММЕРЧЕСКИЙ STARLINK КОМПАНИИ SPACEX И
Dialogue: 0,0:15:29.40,0:15:32.76,Caption,,0,0,0,,ВОЕННЫЙ STARSHIELD, КОТОРЫМ УПРАВЛЯЕТ ПРАВИТЕЛЬСТВО США.
Dialogue: 0,0:15:35.04,0:15:38.08,Caption,,0,0,0,,ДЛЯ КИЕВА ЭТО КРАЙНЕ НЕПРИЯТНАЯ ЗАВИСИМОСТЬ. МАСК
Dialogue: 0,0:15:38.08,0:15:41.52,Caption,,0,0,0,,НАПОМИНАЕТ, ЧТО ЕГО КОМПАНИЯ ОБЕСПЕЧИЛА УКРАИНУ СВЯЗЬЮ В
Dialogue: 0,0:15:41.52,0:15:45.52,Caption,,0,0,0,,КРИТИЧЕСКИЙ МОМЕНТ, И ОДНОВРЕМЕННО ЗАПРЕЩАЕТ ПРЕВРАЩАТЬ КОММЕРЧЕСКУЮ
Dialogue: 0,0:15:45.52,0:15:47.68,Caption,,0,0,0,,СИСТЕМУ В СРЕДСТВО НАСТУПАТЕЛЬНЫХ УДАРОВ
Dialogue: 0,0:15:47.68,0:15:49.92,Caption,,0,0,0,,БЕСПИЛОТНИКАМИ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:15:50.15,0:15:52.48,Caption,,0,0,0,,БЕЗ STARLINK УКРАИНСКИЙ ФРОНТ МОГ ВООБЩЕ
Dialogue: 0,0:15:52.48,0:15:55.44,Caption,,0,0,0,,РАЗВАЛИТЬСЯ. ЭТО НЕ СПОР ДВУХ ЗРИТЕЛЕЙ НА ТРИБУНЕ.
Dialogue: 0,0:15:55.82,0:15:58.32,Caption,,0,0,0,,ОДИН ИЗ СПОРЩИКОВ КОНТРОЛИРУЕТ ТЕХНОЛОГИЮ,
Dialogue: 0,0:15:58.49,0:16:01.44,Caption,,0,0,0,,КОТОРУЮ СЧИТАЕТ НЕОБХОДИМОЙ ДЛЯ УСТОЙЧИВОСТИ АРМИИ
Dialogue: 0,0:16:01.44,0:16:06.91,Caption,,0,0,0,,ДРУГОГО. ЗЕЛЕНСКИЙ УЖЕ НЕ ВПЕРВЫЕ РАЗГОВАРИВАЕТ С НЕОБХОДИМЫМ
Dialogue: 0,0:16:06.91,0:16:10.83,Caption,,0,0,0,,ПАРТНЁРОМ ТАК, СЛОВНО НУЖДА СУЩЕСТВУЕТ ИСКЛЮЧИТЕЛЬНО У ПАРТНЁРА.
Dialogue: 0,0:16:11.15,0:16:13.87,Caption,,0,0,0,,БАЙДЕНУ НЕ ХВАТИЛО БЛАГОДАРНОСТИ. С ТРАМПОМ
Dialogue: 0,0:16:13.87,0:16:17.23,Caption,,0,0,0,,ПРОИЗОШЛА ПУБЛИЧНАЯ ССОРА. МАСК ТЕПЕРЬ НАПОМИНАЕТ,
Dialogue: 0,0:16:17.31,0:16:20.59,Caption,,0,0,0,,ЧЬЯ СИСТЕМА ДЕРЖИТ СВЯЗЬ. КИЕВ МОЖЕТ СПОРИТЬ О
Dialogue: 0,0:16:20.59,0:16:23.31,Caption,,0,0,0,,ГРАНИЦАХ ДОПУСТИМОГО ПРИМЕНЕНИЯ СКОЛЬКО УГОДНО,
Dialogue: 0,0:16:23.55,0:16:25.79,Caption,,0,0,0,,НО КНОПКА ВСЁ РАВНО НАХОДИТСЯ НЕ В КИЕВЕ.
Dialogue: 0,0:16:28.07,0:16:31.27,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ВАМ ИНТЕРЕСНА МЕХАНИКА ЗАВИСИМОСТИ,
Dialogue: 0,0:16:31.51,0:16:34.55,Caption,,0,0,0,,А НЕ ТОРЖЕСТВЕННЫЕ СЛОВА О ВЕЧНОЙ ДРУЖБЕ. ОСОБЕННО
Dialogue: 0,0:16:34.55,0:16:38.71,Caption,,0,0,0,,ЗАНЯТНО ОНА ВЫГЛЯДИТ ТАМ, ГДЕ ГРОМКИЕ ПРИНЦИПЫ ВСТРЕЧАЮТСЯ С БАНКОВСКИМ
Dialogue: 0,0:16:38.71,0:16:44.35,Caption,,0,0,0,,ПЕРЕВОДОМ. ПОКА ЕВРОПЕЙСКИЕ ЧИНОВНИКИ ОТЧИТЫВАЮТСЯ О ДАВЛЕНИИ
Dialogue: 0,0:16:44.43,0:16:48.99,Caption,,0,0,0,,НА РОССИЙСКИЕ КАПИТАЛЫ, DEUTSCHE BANK ОКАЗАЛСЯ В КРАЙНЕ НЕУДОБНОМ ПОЛОЖЕНИИ.
Dialogue: 0,0:16:49.39,0:16:52.19,Caption,,0,0,0,,ТЕЛЕКАНАЛ ZDF ПОЛУЧИЛ БОЛЬШОЙ МАССИВ ВНУТРЕННИХ
Dialogue: 0,0:16:52.19,0:16:54.11,Caption,,0,0,0,,ДОКУМЕНТОВ, ИЗ КОТОРЫХ СЛЕДУЕТ,
Dialogue: 0,0:16:54.27,0:16:57.47,Caption,,0,0,0,,ЧТО БАНК ГОДАМИ ОБСЛУЖИВАЛ КЛИЕНТОВ ВЫСОКОГО РИСКА,
Dialogue: 0,0:16:57.68,0:16:59.39,Caption,,0,0,0,,ВКЛЮЧАЯ РОССИЙСКИХ МИЛЛИАРДЕРОВ,
Dialogue: 0,0:16:59.63,0:17:02.51,Caption,,0,0,0,,НЕСМОТРЯ НА СОБСТВЕННЫЕ ПРЕДУПРЕЖДЕНИЯ И САНКЦИОННЫЕ
Dialogue: 0,0:17:02.51,0:17:08.30,Caption,,0,0,0,,ОПАСЕНИЯ. ЧАСТЬ КЛИЕНТОВ ПЕРЕВОДИЛИ В ПОДРАЗДЕЛЕНИЯ ШВЕЙЦАРИИ
Dialogue: 0,0:17:08.30,0:17:11.18,Caption,,0,0,0,,И ЛЮКСЕМБУРГА. В ДОКУМЕНТАХ УПОМИНАЮТСЯ ОЛЕГ
Dialogue: 0,0:17:11.18,0:17:15.50,Caption,,0,0,0,,ДЕРИПАСКА, ГЕННАДИЙ ТИМЧЕНКО И СУЛЕЙМАН КЕРИМОВ. ОДИН ЭПИЗОД
Dialogue: 0,0:17:15.50,0:17:18.22,Caption,,0,0,0,,КАСАЛСЯ ПЕРЕВОДА ПРИМЕРНО ОДНОГО МИЛЛИАРДА СТА
Dialogue: 0,0:17:18.22,0:17:21.34,Caption,,0,0,0,,МИЛЛИОНОВ ЕВРО, ПРЕДПОЛОЖИТЕЛЬНО В ИНТЕРЕСАХ КЕРИМОВА.
Dialogue: 0,0:17:23.55,0:17:25.88,Caption,,0,0,0,,ПОСЛЕ ЭТОГО РАЗГОВОРЫ О ДВАДЦАТЬ ПЯТОМ,
Dialogue: 0,0:17:25.96,0:17:28.76,Caption,,0,0,0,,ТРИДЦАТЬ ПЯТОМ ИЛИ ТРИСТА ДВАДЦАТЬ ПЯТОМ ПАКЕТЕ
Dialogue: 0,0:17:28.76,0:17:32.12,Caption,,0,0,0,,САНКЦИЙ ЗВУЧАТ ОСОБЕННО БОДРО. ЧИНОВНИКИ ЗАКРЫВАЮТ
Dialogue: 0,0:17:32.12,0:17:35.96,Caption,,0,0,0,,ДОСТУП, БАНКИ ИЗУЧАЮТ КОМИССИЮ И ЮРИДИЧЕСКУЮ СХЕМУ,
Dialogue: 0,0:17:36.26,0:17:38.84,Caption,,0,0,0,,А ЗАТЕМ ГДЕ НИБУДЬ МЕЖДУ ГЕРМАНИЕЙ И ЛЮКСЕМБУРГОМ
Dialogue: 0,0:17:38.84,0:17:41.40,Caption,,0,0,0,,ОБНАРУЖИВАЕТСЯ ВПОЛНЕ ИСПРАВНАЯ БОКОВАЯ ДВЕРЬ.
Dialogue: 0,0:17:41.62,0:17:43.80,Caption,,0,0,0,,ЕВРОПЕЙСКИХ РЫЧАГОВ СТАНОВИТСЯ МЕНЬШЕ,
Dialogue: 0,0:17:44.12,0:17:46.76,Caption,,0,0,0,,ИНТЕРЕС К ЗАМОРОЖЕННЫМ РОССИЙСКИМ АКТИВАМ РАСТЁТ,
Dialogue: 0,0:17:47.08,0:17:49.64,Caption,,0,0,0,,НО ДВИЖЕНИЕ РЕАЛЬНЫХ ДЕНЕГ ЖИВЁТ ПО ПРАВИЛАМ,
Dialogue: 0,0:17:49.80,0:17:52.28,Caption,,0,0,0,,КОТОРЫЕ ПРЕСС КОНФЕРЕНЦИЯ НЕ ВСЕГДА ЗАМЕЧАЕТ.
Dialogue: 0,0:17:54.48,0:17:57.20,Caption,,0,0,0,,В ВАШИНГТОНЕ ТЕМ ВРЕМЕНЕМ ГОТОВЯТ СЛЕДУЮЩУЮ СМЕНУ
Dialogue: 0,0:17:57.20,0:18:00.48,Caption,,0,0,0,,ДЕКОРАЦИЙ. ДЖЕЙ ДИ ВЭНС В ДВЕ ТЫСЯЧИ ШЕСТНАДЦАТОМ
Dialogue: 0,0:18:00.56,0:18:02.32,Caption,,0,0,0,,ГОДУ НАЗЫВАЛ ТРАМПА МОШЕННИКОМ,
Dialogue: 0,0:18:02.56,0:18:04.80,Caption,,0,0,0,,ОБВИНЯЛ ЕГО В РАВНОДУШИИ К ПРОСТЫМ ЛЮДЯМ И
Dialogue: 0,0:18:04.88,0:18:07.92,Caption,,0,0,0,,ГОВОРИЛ, ЧТО ТОТ ВЕДЁТ БЕЛЫЙ РАБОЧИЙ КЛАСС В ОЧЕНЬ
Dialogue: 0,0:18:07.92,0:18:10.96,Caption,,0,0,0,,ТЁМНОЕ МЕСТО. ЗАТЕМ ВЭНС СТАЛ СЕНАТОРОМ,
Dialogue: 0,0:18:11.12,0:18:13.68,Caption,,0,0,0,,ЗАМЕСТИТЕЛЕМ ПРЕЗИДЕНТА И ОДНИМ ИЗ ГЛАВНЫХ
Dialogue: 0,0:18:13.68,0:18:15.76,Caption,,0,0,0,,ПРЕТЕНДЕНТОВ НА НАСЛЕДСТВО ТРАМПИЗМА.
Dialogue: 0,0:18:17.97,0:18:20.45,Caption,,0,0,0,,ПОСЛЕ ПОРАЖЕНИЯ РЕСПУБЛИКАНЦЕВ НА ПРОМЕЖУТОЧНЫХ
Dialogue: 0,0:18:20.45,0:18:23.25,Caption,,0,0,0,,ВЫБОРАХ ВЭНС ОТДЕЛЬНО РАБОТАЕТ С ЧАСТЬЮ ДВИЖЕНИЯ
Dialogue: 0,0:18:23.25,0:18:25.73,Caption,,0,0,0,,MAGA, НЕДОВОЛЬНОЙ ВНЕШНЕЙ ПОЛИТИКОЙ,
Dialogue: 0,0:18:25.89,0:18:30.13,Caption,,0,0,0,,ИРАНОМ, РАСХОДАМИ И БЕСКОНЕЧНЫМИ ВОЙНАМИ. ЕГО БИОГРАФИЯ
Dialogue: 0,0:18:30.13,0:18:33.01,Caption,,0,0,0,,ПОДХОДИТ ДЛЯ ТАКОЙ ЗАДАЧИ ПОЧТИ НЕПРИЛИЧНО ХОРОШО.
Dialogue: 0,0:18:33.34,0:18:35.81,Caption,,0,0,0,,БЫВШИМ ПРОТИВНИКАМ ТРАМПА ОН МОЖЕТ НАПОМНИТЬ,
Dialogue: 0,0:18:35.97,0:18:39.09,Caption,,0,0,0,,ЧТО КОГДА ТО ДУМАЛ ТАК ЖЕ. СТОРОННИКАМ ТРАМПА
Dialogue: 0,0:18:39.09,0:18:42.53,Caption,,0,0,0,,ПОКАЖЕТ ГОДЫ ВЕРНОЙ СЛУЖБЫ РЯДОМ С ЛИДЕРОМ. УДОБНАЯ
Dialogue: 0,0:18:42.53,0:18:44.61,Caption,,0,0,0,,ОБУВЬ, ПОДОШВА С ОБЕИХ СТОРОН.
Dialogue: 0,0:18:46.81,0:18:49.93,Caption,,0,0,0,,ВОЗМОЖЕН И БОЛЕЕ РАСЧЁТЛИВЫЙ МЕХАНИЗМ. ТРАМП БЕРЁТ
Dialogue: 0,0:18:49.93,0:18:52.65,Caption,,0,0,0,,ПРЕЖНЕГО КРИТИКА, ДЕЛАЕТ ЕГО СОЮЗНИКОМ,
Dialogue: 0,0:18:52.81,0:18:56.01,Caption,,0,0,0,,ЗАТЕМ НАСЛЕДНИКОМ. КОГДА РАЗДРАЖЕНИЕ ПРОТИВ ХОЗЯИНА
Dialogue: 0,0:18:56.01,0:19:00.57,Caption,,0,0,0,,СТАНОВИТСЯ СЛИШКОМ СИЛЬНЫМ, НАСЛЕДНИК ПОЛУЧАЕТ ВОЗМОЖНОСТЬ НЕМНОГО ОТСТУПИТЬ.
Dialogue: 0,0:19:00.92,0:19:04.01,Caption,,0,0,0,,САМ ТРАМП УХОДИТ, ЕГО ДВИЖЕНИЕ СОХРАНЯЕТСЯ,
Dialogue: 0,0:19:04.41,0:19:07.53,Caption,,0,0,0,,А СТАРЫЕ ВЫПАДЫ ВЭНСА ПЕРЕСТАЮТ БЫТЬ КОМПРОМАТОМ И
Dialogue: 0,0:19:07.53,0:19:10.17,Caption,,0,0,0,,ПРЕВРАЩАЮТСЯ В ПРОПУСК К ТОЙ ЧАСТИ ПАРТИИ,
Dialogue: 0,0:19:10.41,0:19:12.57,Caption,,0,0,0,,КОТОРАЯ НЕ ХОЧЕТ ЕЩЁ ОДНОГО ТРАМПА,
Dialogue: 0,0:19:12.73,0:19:15.21,Caption,,0,0,0,,НО СОГЛАСНА ОСТАВИТЬ ПОЧТИ ВСЁ ОСТАЛЬНОЕ.
Dialogue: 0,0:19:17.47,0:19:20.84,Caption,,0,0,0,,БАЙДЕН УЖЕ РАСПРЕДЕЛЯЕТ РОЛИ В ПРОШЛОМ. ТРАМП МЕНЯЕТ
Dialogue: 0,0:19:20.92,0:19:24.04,Caption,,0,0,0,,ПРАВИЛА НАСТОЯЩЕГО. МАСК ОБОЗНАЧАЕТ ПРЕДЕЛЫ СВОЕЙ
Dialogue: 0,0:19:24.04,0:19:27.23,Caption,,0,0,0,,ПОМОЩИ. ЕВРОПА УСИЛИВАЕТ ВОСТОЧНОЕ НАПРАВЛЕНИЕ,
Dialogue: 0,0:19:27.39,0:19:31.16,Caption,,0,0,0,,СПОРИТ О БЕЗОПАСНОСТИ И ИЩЕТ ДЕНЬГИ. ВЭНС ЗАРАНЕЕ
Dialogue: 0,0:19:31.16,0:19:33.47,Caption,,0,0,0,,СОБИРАЕТ КОАЛИЦИЮ ДЛЯ СЛЕДУЮЩЕГО ЭТАПА.
Dialogue: 0,0:19:35.76,0:19:38.80,Caption,,0,0,0,,ДЛЯ УКРАИНЫ И ВОСТОЧНЫХ ЧЛЕНОВ НАТО ВЫВОД НЕПРИЯТЕН.
Dialogue: 0,0:19:39.12,0:19:41.76,Caption,,0,0,0,,ИХ БЕЗОПАСНОСТЬ ВСЁ СИЛЬНЕЕ ЗАВИСИТ ОТ ЛЮДЕЙ,
Dialogue: 0,0:19:41.92,0:19:43.92,Caption,,0,0,0,,КОТОРЫЕ САМИ ПЕРЕПИСЫВАЮТ СОЮЗЫ,
Dialogue: 0,0:19:44.16,0:19:47.04,Caption,,0,0,0,,МЕНЯЮТ ИНТЕРЕСЫ И ГОТОВЯТСЯ К НОВОЙ БОРЬБЕ ЗА
Dialogue: 0,0:19:47.04,0:19:50.16,Caption,,0,0,0,,ВЛАСТЬ. ФРАНЦИЯ ПРИЗНАЁТ ПРИСУТСТВИЕ СПЕЦИАЛИСТОВ,
Dialogue: 0,0:19:50.40,0:19:53.36,Caption,,0,0,0,,ПРИБАЛТИЙСКИЕ СТРАНЫ РАССЧИТЫВАЮТ НА ОБЩУЮ ЗАЩИТУ,
Dialogue: 0,0:19:53.52,0:19:55.76,Caption,,0,0,0,,А АМЕРИКАНСКИЕ РУКОВОДИТЕЛИ УЖЕ СПОРЯТ,
Dialogue: 0,0:19:56.00,0:20:00.08,Caption,,0,0,0,,КОМУ КИЕВ ОБЯЗАН, КТО СЛИШКОМ МАЛО БЛАГОДАРИЛ И КОМУ РАЗРЕШЕНО
Dialogue: 0,0:20:00.08,0:20:06.51,Caption,,0,0,0,,НАЖИМАТЬ НА КНОПКУ СВЯЗИ. БЫВШИЙ СОЮЗНИК ОЧЕНЬ БЫСТРО СТАНОВИТСЯ ПРОСИТЕЛЕМ.
Dialogue: 0,0:20:06.83,0:20:09.71,Caption,,0,0,0,,БЫВШИЙ КРИТИК БЕЗ ТРУДА ПРЕВРАЩАЕТСЯ В НАСЛЕДНИКА.
Dialogue: 0,0:20:10.03,0:20:12.67,Caption,,0,0,0,,БАНКОВСКИЙ ЗАПРЕТ НАХОДИТ ЛЮКСЕМБУРГСКУЮ ДВЕРЬ,
Dialogue: 0,0:20:12.92,0:20:16.03,Caption,,0,0,0,,А УЧАСТИЕ В ВОЙНЕ ПОЛУЧАЕТ НОВОЕ НАЗВАНИЕ И
Dialogue: 0,0:20:16.03,0:20:18.99,Caption,,0,0,0,,ПЕРЕСТАЁТ СЧИТАТЬСЯ УЧАСТИЕМ. НЕ МЕНЯЕТСЯ ТОЛЬКО
Dialogue: 0,0:20:18.99,0:20:21.39,Caption,,0,0,0,,ГЕОГРАФИЯ. ОНА НЕ ЧИТАЕТ МЕМУАРЫ,
Dialogue: 0,0:20:21.71,0:20:24.19,Caption,,0,0,0,,НЕ ПЕРЕОБУВАЕТСЯ ПЕРЕД ВЫБОРАМИ И НЕ ПЕРЕВОДИТ
Dialogue: 0,0:20:24.19,0:20:26.03,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЕ РЕЕСТРЫ В ОБЛАКО.
Dialogue: 0,0:20:28.32,0:20:31.12,Caption,,0,0,0,,ПОЭТОМУ ПРИБАЛТИЙСКИМ РУКОВОДИТЕЛЯМ СТОИТ ЕЩЁ РАЗ
Dialogue: 0,0:20:31.12,0:20:34.56,Caption,,0,0,0,,ПОСМОТРЕТЬ НЕ НА ОБЕЩАНИЯ, А НА КАРТУ И ПОВЕДЕНИЕ ТЕХ,
Dialogue: 0,0:20:34.80,0:20:37.68,Caption,,0,0,0,,КТО ЭТИ ОБЕЩАНИЯ РАЗДАЁТ. ЕСЛИ ВЫ УЖЕ ГОТОВИТЕ
Dialogue: 0,0:20:37.76,0:20:39.84,Caption,,0,0,0,,ГОСУДАРСТВО К УПРАВЛЕНИЮ ИЗ ДРУГОЙ СТРАНЫ,
Dialogue: 0,0:20:40.23,0:20:43.12,Caption,,0,0,0,,ВЫ ОТЛИЧНО ПОНИМАЕТЕ МАСШТАБ БЕДЫ. ПОВЫШАТЬ ПОСЛЕ
Dialogue: 0,0:20:43.12,0:20:45.76,Caption,,0,0,0,,ЭТОГО СТАВКИ В РАСЧЁТЕ НА ЧУЖУЮ ВЕЧНУЮ ВЕРНОСТЬ
Dialogue: 0,0:20:46.06,0:20:48.64,Caption,,0,0,0,,ЗНАЧИТ ПОРУЧАТЬ СОБСТВЕННОЕ ВЫЖИВАНИЕ ЛЮДЯМ,
Dialogue: 0,0:20:48.85,0:20:52.00,Caption,,0,0,0,,КОТОРЫЕ УЖЕ ПИШУТ СЛЕДУЮЩУЮ ВЕРСИЮ ПРОШЛОГО БЕЗ ВАС.
Dialogue: 0,0:20:52.29,0:20:54.88,Caption,,0,0,0,,В БОЛЬШОЙ ВОЙНЕ БЛИЖЕ ВСЕХ К УДАРУ ОКАЖУТСЯ
Dialogue: 0,0:20:54.88,0:20:58.40,Caption,,0,0,0,,НЕ АВТОРЫ КРАСИВЫХ ГАРАНТИЙ. ПЕРВЫМИ ЕГО ПОЛУЧАТ ТЕ,
Dialogue: 0,0:20:58.56,0:21:00.48,Caption,,0,0,0,,КОГО НЕВОЗМОЖНО ПЕРЕДВИНУТЬ ПОДАЛЬШЕ.
