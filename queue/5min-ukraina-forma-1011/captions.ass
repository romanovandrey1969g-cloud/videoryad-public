Dialogue: 0,0:00:00.12,0:00:03.16,Caption,,0,0,0,,ТРАМП СКАЗАЛ ВРОДЕ БЫ ПРОСТУЮ ВЕЩЬ. ПОСЛЕ СОГЛАШЕНИЯ
Dialogue: 0,0:00:03.16,0:00:06.20,Caption,,0,0,0,,УКРАИНА БУДЕТ НЕМНОГО ДРУГОЙ ФОРМЫ. ХОРОШЕЕ СЛОВО,
Dialogue: 0,0:00:06.28,0:00:09.16,Caption,,0,0,0,,УДОБНОЕ. ГЛАВНОЕ, НИКТО НЕ ОБЪЯСНИЛ,
Dialogue: 0,0:00:09.32,0:00:12.28,Caption,,0,0,0,,КАКОЙ ИМЕННО ФОРМЫ И ЧТО КОНКРЕТНО ТАМ СОБИРАЮТСЯ
Dialogue: 0,0:00:12.36,0:00:14.84,Caption,,0,0,0,,МЕНЯТЬ. А ВЕДЬ ГОСУДАРСТВО ЭТО НЕ ПЛАСТИЛИН,
Dialogue: 0,0:00:14.93,0:00:17.16,Caption,,0,0,0,,ЧТОБЫ ПРОСТО ЧУТЬ ПОДПРАВИТЬ УГОЛОК И ПОСТАВИТЬ
Dialogue: 0,0:00:17.24,0:00:19.48,Caption,,0,0,0,,ОБРАТНО НА ПОЛКУ. ТАК ЧТО ЖЕ ТРАМП УЖЕ
Dialogue: 0,0:00:19.56,0:00:23.24,Caption,,0,0,0,,ЗНАЕТ ТАКОГО, ЧТО УКРАИНА У НЕГО ЗАРАНЕЕ ПОЛУЧАЕТСЯ ДРУГОЙ?
Dialogue: 0,0:00:23.46,0:00:25.56,Caption,,0,0,0,,И ВЕДЬ ФРАЗА НА САМОМ ДЕЛЕ ОЧЕНЬ СТРАННАЯ.
Dialogue: 0,0:00:25.88,0:00:30.04,Caption,,0,0,0,,ТРАМПА СПРАШИВАЮТ, ОСТАНЕТСЯ ЛИ УКРАИНА СВОБОДНОЙ И НЕЗАВИСИМОЙ. И
Dialogue: 0,0:00:30.12,0:00:32.44,Caption,,0,0,0,,ВМЕСТО ПРОСТОГО ОТВЕТА ДА, КОНЕЧНО,
Dialogue: 0,0:00:32.52,0:00:35.56,Caption,,0,0,0,,ОСТАНЕТСЯ, ОН ГОВОРИТ, ЧТО ВСЁ ЗАКОНЧИТСЯ,
Dialogue: 0,0:00:35.68,0:00:39.72,Caption,,0,0,0,,СОГЛАШЕНИЕ БУДЕТ, А УКРАИНА В ИТОГЕ ОКАЖЕТСЯ НЕМНОГО ДРУГОЙ ФОРМЫ.
Dialogue: 0,0:00:40.15,0:00:42.36,Caption,,0,0,0,,КАКОЙ ФОРМЫ, ДОНАЛЬД? ГЕОГРАФИЧЕСКОЙ?
Dialogue: 0,0:00:42.52,0:00:45.24,Caption,,0,0,0,,ПОЛИТИЧЕСКОЙ? ВОЕННОЙ? ИЛИ СРАЗУ ВСЕЙ?
Dialogue: 0,0:00:45.46,0:00:47.80,Caption,,0,0,0,,ВОТ ЗДЕСЬ УЖЕ СТАНОВИТСЯ ИНТЕРЕСНО. ЕСЛИ ВАМ
Dialogue: 0,0:00:47.88,0:00:51.32,Caption,,0,0,0,,НРАВЯТСЯ ТАКИЕ РАЗБОРЫ, ГДЕ МЫ НЕ ПРОСТО ПЕРЕСКАЗЫВАЕМ ЗАГОЛОВКИ,
Dialogue: 0,0:00:51.41,0:00:55.32,Caption,,0,0,0,,А ПЫТАЕМСЯ ПОНЯТЬ, ЗАЧЕМ ЛЮДИ ГОВОРЯТ ИМЕННО ТАКИЕ СЛОВА,
Dialogue: 0,0:00:55.40,0:00:58.36,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ НАЧИНАЕТСЯ ОЧЕНЬ
Dialogue: 0,0:00:58.36,0:01:01.56,Caption,,0,0,0,,ЛЮБОПЫТНАЯ ИСТОРИЯ. НА ПОВЕРХНОСТИ ВСЕМ ПРОЩЕ ВСЕГО
Dialogue: 0,0:01:01.56,0:01:04.92,Caption,,0,0,0,,РЕШИТЬ, ЧТО ТРАМП ГОВОРИТ О КАРТЕ. НУ ДРУГОЙ ФОРМЫ
Dialogue: 0,0:01:05.00,0:01:09.72,Caption,,0,0,0,,И ДРУГОЙ ФОРМЫ. ЗНАЧИТ, ГРАНИЦЫ БУДУТ ДРУГИМИ. ЛОГИКА ПОНЯТНАЯ. НО ПОЧЕМУ
Dialogue: 0,0:01:09.72,0:01:12.12,Caption,,0,0,0,,ТОГДА ОН ВООБЩЕ ОТВЕЧАЕТ ЭТОЙ ФРАЗОЙ НА ВОПРОС
Dialogue: 0,0:01:12.12,0:01:13.96,Caption,,0,0,0,,О СВОБОДНОЙ И НЕЗАВИСИМОЙ УКРАИНЕ?
Dialogue: 0,0:01:16.24,0:01:19.28,Caption,,0,0,0,,ГРАНИЦЫ ЭТО ТОЛЬКО ОДИН КУСОК ГОСУДАРСТВА. ЕСТЬ ЕЩЁ
Dialogue: 0,0:01:19.28,0:01:22.56,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ СИСТЕМА. ЕСТЬ ВНЕШНЕПОЛИТИЧЕСКИЙ КУРС.
Dialogue: 0,0:01:22.80,0:01:26.56,Caption,,0,0,0,,ЕСТЬ АРМИЯ. ЕСТЬ ВОЕННАЯ ИНФРАСТРУКТУРА. ЕСТЬ ВОПРОС
Dialogue: 0,0:01:26.64,0:01:29.84,Caption,,0,0,0,,НАТО. ЕСТЬ ВОПРОС ВООРУЖЕНИЙ. ЕСТЬ ВОПРОС О ТОМ,
Dialogue: 0,0:01:30.08,0:01:32.88,Caption,,0,0,0,,КТО И ЧТО ПОСЛЕ СОГЛАШЕНИЯ СМОЖЕТ РАЗМЕЩАТЬ НА
Dialogue: 0,0:01:32.88,0:01:35.76,Caption,,0,0,0,,УКРАИНСКОЙ ТЕРРИТОРИИ. И ЕСЛИ ВСЁ ЭТО ПОЛОЖИТЬ РЯДОМ
Dialogue: 0,0:01:35.76,0:01:38.56,Caption,,0,0,0,,С ТЕМ, ЧТО ПРОИСХОДИТ СЕЙЧАС ВОКРУГ ПЕРЕГОВОРОВ,
Dialogue: 0,0:01:38.96,0:01:41.60,Caption,,0,0,0,,СЛОВА ТРАМПА НАЧИНАЮТ ЗВУЧАТЬ НАМНОГО ИНТЕРЕСНЕЕ,
Dialogue: 0,0:01:41.66,0:01:44.32,Caption,,0,0,0,,ЧЕМ ПРОСТО РАЗГОВОР О ЛИНИИ НА КАРТЕ. ПОТОМУ
Dialogue: 0,0:01:44.40,0:01:46.24,Caption,,0,0,0,,ЧТО РОССИЯ ВСЕ ЭТИ ГОДЫ ВЕДЬ ГОВОРИЛА НЕ
Dialogue: 0,0:01:46.24,0:01:49.44,Caption,,0,0,0,,ТОЛЬКО О ТЕРРИТОРИЯХ. МОСКВА ПОСТОЯННО ВОЗВРАЩАЛАСЬ
Dialogue: 0,0:01:49.44,0:01:53.76,Caption,,0,0,0,,К ТОМУ, ЧТО ОНА НАЗЫВАЕТ ПЕРВОПРИЧИНАМИ КОНФЛИКТА. К НАТО. К
Dialogue: 0,0:01:53.76,0:01:56.64,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЕ. К РАКЕТАМ. К ГАРАНТИЯМ
Dialogue: 0,0:01:56.64,0:02:01.20,Caption,,0,0,0,,БЕЗОПАСНОСТИ. К ТОМУ, ЧТО ВООБЩЕ БУДЕТ НАХОДИТЬСЯ ВОЗЛЕ РОССИЙСКИХ ГРАНИЦ.
Dialogue: 0,0:02:01.36,0:02:05.68,Caption,,0,0,0,,А ТЕПЕРЬ СМОТРИМ, КОГО РОССИЯ ОТПРАВЛЯЕТ НА НОВЫЙ РАУНД ПЕРЕГОВОРОВ. И
Dialogue: 0,0:02:05.76,0:02:07.44,Caption,,0,0,0,,ВОТ ЗДЕСЬ ПОЯВЛЯЕТСЯ СЕРГЕЙ РЯБКОВ.
Dialogue: 0,0:02:07.99,0:02:10.88,Caption,,0,0,0,,НЕ ПРОСТО ОЧЕРЕДНОЙ ЧЕЛОВЕК С ПАПКОЙ. НЕ ДИПЛОМАТ,
Dialogue: 0,0:02:11.00,0:02:12.80,Caption,,0,0,0,,КОТОРОГО ПОСАДИЛИ В САМОЛЁТ ПОТОМУ,
Dialogue: 0,0:02:12.96,0:02:15.68,Caption,,0,0,0,,ЧТО СВОБОДНОЕ МЕСТО ОСТАВАЛОСЬ. РЯБКОВ ЭТО
Dialogue: 0,0:02:15.68,0:02:18.64,Caption,,0,0,0,,ЗАМЕСТИТЕЛЬ МИНИСТРА ИНОСТРАННЫХ ДЕЛ. ОН ЗАНИМАЕТСЯ
Dialogue: 0,0:02:18.64,0:02:21.12,Caption,,0,0,0,,ОТНОШЕНИЯМИ РОССИИ И СОЕДИНЁННЫХ ШТАТОВ,
Dialogue: 0,0:02:21.36,0:02:24.64,Caption,,0,0,0,,СТРАТЕГИЧЕСКОЙ СТАБИЛЬНОСТЬЮ, КОНТРОЛЕМ НАД ВООРУЖЕНИЯМИ.
Dialogue: 0,0:02:26.93,0:02:29.25,Caption,,0,0,0,,ТО ЕСТЬ ЧЕЛОВЕК СИДИТ РОВНО НА ТОМ УЧАСТКЕ,
Dialogue: 0,0:02:29.60,0:02:32.21,Caption,,0,0,0,,ГДЕ НАХОДЯТСЯ РАКЕТЫ, ЯДЕРНЫЕ ВОПРОСЫ,
Dialogue: 0,0:02:32.29,0:02:34.37,Caption,,0,0,0,,АМЕРИКАНЦЫ И БОЛЬШАЯ БЕЗОПАСНОСТЬ.
Dialogue: 0,0:02:34.98,0:02:37.89,Caption,,0,0,0,,И САМОЕ КРАСИВОЕ ЗДЕСЬ ДРУГОЕ. ЭТО ТОТ САМЫЙ
Dialogue: 0,0:02:37.89,0:02:40.93,Caption,,0,0,0,,РЯБКОВ, КОТОРЫЙ В КОНЦЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА
Dialogue: 0,0:02:41.17,0:02:43.73,Caption,,0,0,0,,БЫЛ ОДНИМ ИЗ ГЛАВНЫХ ПУБЛИЧНЫХ ЛИЦ РОССИЙСКИХ
Dialogue: 0,0:02:43.73,0:02:46.61,Caption,,0,0,0,,ТРЕБОВАНИЙ ЗАПАДУ ПО ГАРАНТИЯМ БЕЗОПАСНОСТИ. ТОТ
Dialogue: 0,0:02:46.61,0:02:50.77,Caption,,0,0,0,,САМЫЙ ПАКЕТ ТРЕБОВАНИЙ, КОТОРЫЙ ПОТОМ МНОГИЕ СТАЛИ НАЗЫВАТЬ УЛЬТИМАТУМОМ
Dialogue: 0,0:02:50.77,0:02:53.49,Caption,,0,0,0,,РЯБКОВА. ПРОШЛО ПЯТЬ ЛЕТ. И ВОТ РЯБКОВ ВПЕРВЫЕ
Dialogue: 0,0:02:53.49,0:02:56.13,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ НЕПОСРЕДСТВЕННО В РОССИЙСКОЙ ПЕРЕГОВОРНОЙ
Dialogue: 0,0:02:56.21,0:02:59.01,Caption,,0,0,0,,ГРУППЕ ПО УКРАИНЕ. ОПА. МОЖНО,
Dialogue: 0,0:02:59.15,0:03:03.89,Caption,,0,0,0,,КОНЕЧНО, СЧИТАТЬ, ЧТО ПРОСТО КАДРОВАЯ РОТАЦИЯ. ТОЛЬКО КАДРОВАЯ РОТАЦИЯ
Dialogue: 0,0:03:03.97,0:03:06.85,Caption,,0,0,0,,КАКАЯ ТО УДИВИТЕЛЬНО ТЕМАТИЧЕСКАЯ. ЕСЛИ ВЫ ВЕДЁТЕ
Dialogue: 0,0:03:06.93,0:03:11.25,Caption,,0,0,0,,РАЗГОВОР ИСКЛЮЧИТЕЛЬНО О ТОМ, ГДЕ ПРОВЕСТИ ЛИНИЮ РАЗГРАНИЧЕНИЯ И КТО КОМУ ЧТО
Dialogue: 0,0:03:11.25,0:03:15.57,Caption,,0,0,0,,ОТДАЁТ, ЗАЧЕМ ВАМ ЧЕЛОВЕК, КОТОРЫЙ ГОДАМИ ЗАНИМАЕТСЯ США,
Dialogue: 0,0:03:15.73,0:03:18.37,Caption,,0,0,0,,СТРАТЕГИЧЕСКОЙ СТАБИЛЬНОСТЬЮ И КОНТРОЛЕМ ВООРУЖЕНИЙ?
Dialogue: 0,0:03:18.60,0:03:20.29,Caption,,0,0,0,,ЧТО ОН ТАМ ДОЛЖЕН СОГЛАСОВЫВАТЬ?
Dialogue: 0,0:03:20.45,0:03:25.41,Caption,,0,0,0,,ШИРИНУ РУЧКИ НА КАРТЕ? НЕТ, РЕБЯТА. ТУТ УЖЕ ИНТЕРЕСНО. ТЕМ БОЛЕЕ РОССИЙСКАЯ
Dialogue: 0,0:03:25.41,0:03:28.37,Caption,,0,0,0,,ДЕЛЕГАЦИЯ ДЕЙСТВИТЕЛЬНО СТАЛА ТЯЖЕЛЕЕ. ТАМ НЕ ТОЛЬКО
Dialogue: 0,0:03:28.37,0:03:31.41,Caption,,0,0,0,,МЕДИНСКИЙ. ТАМ ЗАМЕСТИТЕЛИ МИНИСТРА ИНОСТРАННЫХ ДЕЛ,
Dialogue: 0,0:03:31.67,0:03:35.65,Caption,,0,0,0,,ВОЕННАЯ РАЗВЕДКА, ПРЕДСТАВИТЕЛЬ ГЕНЕРАЛЬНОГО ШТАБА. И УКРАИНСКАЯ
Dialogue: 0,0:03:35.65,0:03:37.89,Caption,,0,0,0,,СТОРОНА ТОЖЕ ЕДЕТ НЕ КРУЖКОМ ЛЮБИТЕЛЕЙ
Dialogue: 0,0:03:37.89,0:03:41.70,Caption,,0,0,0,,МЕЖДУНАРОДНОГО ПРАВА. УМЕРОВ,
Dialogue: 0,0:03:41.92,0:03:47.22,Caption,,0,0,0,,БУДАНОВ, АРАХАМИЯ, КИСЛИЦА, ВОЕННЫЕ. ТО ЕСТЬ ЗА СТОЛОМ ОКАЗЫВАЮТСЯ ЛЮДИ,
Dialogue: 0,0:03:47.46,0:03:50.02,Caption,,0,0,0,,КОТОРЫЕ СПОСОБНЫ ОБСУЖДАТЬ НЕ ТОЛЬКО ПОЛИТИЧЕСКИЕ
Dialogue: 0,0:03:50.02,0:03:53.30,Caption,,0,0,0,,ЗАЯВЛЕНИЯ, НО И СОВЕРШЕННО КОНКРЕТНЫЕ ВОЕННЫЕ ВЕЩИ.
Dialogue: 0,0:03:53.89,0:03:56.82,Caption,,0,0,0,,А ТЕПЕРЬ ВОЗВРАЩАЕМСЯ К РЯБКОВУ. ЧТО ИМЕННО РОССИЯ
Dialogue: 0,0:03:56.82,0:03:58.90,Caption,,0,0,0,,ТРЕБОВАЛА В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ ГОДУ?
Dialogue: 0,0:03:59.30,0:04:01.46,Caption,,0,0,0,,И ТУТ НАС ЖДЁТ ОЧЕНЬ ЗАНЯТНАЯ ВСТРЕЧА С
Dialogue: 0,0:04:01.46,0:04:04.02,Caption,,0,0,0,,ДЕВЯНОСТО СЕДЬМЫМ ГОДОМ. ДВАДЦАТЬ СЕДЬМОГО МАЯ
Dialogue: 0,0:04:04.10,0:04:07.06,Caption,,0,0,0,,ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО СЕДЬМОГО ГОДА РОССИЯ И
Dialogue: 0,0:04:07.14,0:04:10.34,Caption,,0,0,0,,НАТО ПОДПИСАЛИ ОСНОВОПОЛАГАЮЩИЙ АКТ. НАЗВАНИЕ,
Dialogue: 0,0:04:10.48,0:04:14.26,Caption,,0,0,0,,КОНЕЧНО, ТАКОЕ, ЧТО ПОСЛЕ ТРЕТЬЕГО СЛОВА ХОЧЕТСЯ ПЕРЕДАТЬ ДОКУМЕНТ
Dialogue: 0,0:04:14.26,0:04:17.30,Caption,,0,0,0,,СПЕЦИАЛИСТУ И ТИХОНЬКО ВЫЙТИ. НО СМЫСЛ ТАМ ГОРАЗДО
Dialogue: 0,0:04:17.30,0:04:20.50,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. РОССИЯ И НАТО ОФИЦИАЛЬНО ЗАЯВЛЯЛИ,
Dialogue: 0,0:04:20.74,0:04:22.82,Caption,,0,0,0,,ЧТО БОЛЬШЕ НЕ РАССМАТРИВАЮТ ДРУГ ДРУГА КАК
Dialogue: 0,0:04:22.82,0:04:25.86,Caption,,0,0,0,,ПРОТИВНИКОВ. ОДНОВРЕМЕННО НАТО ГОВОРИЛО О ТОМ,
Dialogue: 0,0:04:26.10,0:04:28.42,Caption,,0,0,0,,ЧТО КОЛЛЕКТИВНАЯ ОБОРОНА В НОВЫХ СТРАНАХ БУДЕТ
Dialogue: 0,0:04:28.42,0:04:30.98,Caption,,0,0,0,,ОБЕСПЕЧИВАТЬСЯ БЕЗ ДОПОЛНИТЕЛЬНОГО ПОСТОЯННОГО
Dialogue: 0,0:04:30.98,0:04:33.86,Caption,,0,0,0,,РАЗМЕЩЕНИЯ СУЩЕСТВЕННЫХ БОЕВЫХ СИЛ. ОТДЕЛЬНО
Dialogue: 0,0:04:33.94,0:04:36.58,Caption,,0,0,0,,ГОВОРИЛОСЬ ОБ ОТСУТСТВИИ НАМЕРЕНИЙ РАЗМЕЩАТЬ ЯДЕРНОЕ
Dialogue: 0,0:04:36.66,0:04:39.22,Caption,,0,0,0,,ОРУЖИЕ НА ТЕРРИТОРИИ НОВЫХ ЧЛЕНОВ. ВОТ ЗДЕСЬ ОЧЕНЬ
Dialogue: 0,0:04:39.30,0:04:41.46,Caption,,0,0,0,,ВАЖНЫЙ МОМЕНТ. РЕЧЬ НЕ ШЛА О ТОМ,
Dialogue: 0,0:04:41.62,0:04:44.42,Caption,,0,0,0,,ЧТО ПОЛЬША, ЧЕХИЯ, ВЕНГРИЯ,
Dialogue: 0,0:04:44.58,0:04:47.22,Caption,,0,0,0,,ПОТОМ СТРАНЫ БАЛТИИ ДОЛЖНЫ ПОЛУЧИТЬ ЧЛЕНСКИЙ БИЛЕТ
Dialogue: 0,0:04:47.30,0:04:50.74,Caption,,0,0,0,,НАТО, А ЧЕРЕЗ НЕДЕЛЮ СДАТЬ ЕГО ОБРАТНО. ХОТИТЕ СОЮЗ?
Dialogue: 0,0:04:50.77,0:04:54.18,Caption,,0,0,0,,ПОЖАЛУЙСТА. СОБИРАЙТЕСЬ. ЗАСЕДАЙТЕ. ФОРМУ ГЛАДЬТЕ.
Dialogue: 0,0:04:56.37,0:04:59.26,Caption,,0,0,0,,НА ПАРАДЕ ТАНЧИКИ ПОКАЗЫВАЙТЕ. ФЛАГ ПОВЕСЬТЕ,
Dialogue: 0,0:04:59.33,0:05:02.62,Caption,,0,0,0,,МУЗЫКУ ВКЛЮЧИТЕ. НО ВОЙСКА, РАКЕТЫ,
Dialogue: 0,0:05:02.70,0:05:05.42,Caption,,0,0,0,,СРЕДСТВА ПОРАЖЕНИЯ, ТЯЖЁЛАЯ ИНФРАСТРУКТУРА,
Dialogue: 0,0:05:05.68,0:05:08.54,Caption,,0,0,0,,АМЕРИКАНСКАЯ ВОЕННАЯ МАШИНА ВОЗЛЕ РОССИЙСКИХ ГРАНИЦ,
Dialogue: 0,0:05:08.93,0:05:11.26,Caption,,0,0,0,,ВОТ ЗДЕСЬ МОСКВА УЖЕ МНОГО ЛЕТ ГОВОРИТ СОВСЕМ
Dialogue: 0,0:05:11.26,0:05:14.30,Caption,,0,0,0,,ДРУГОЕ. НЕ НЕ НЕ, РЕБЯТА. СОЮЗ СОЮЗОМ,
Dialogue: 0,0:05:14.46,0:05:17.26,Caption,,0,0,0,,А ВОЕННАЯ НАЧИНКА ЭТО УЖЕ ОТДЕЛЬНЫЙ РАЗГОВОР. ИМЕННО
Dialogue: 0,0:05:17.26,0:05:19.98,Caption,,0,0,0,,ПОЭТОМУ ДЕВЯНОСТО СЕДЬМОЙ ГОД СНОВА ПОЯВЛЯЕТСЯ В
Dialogue: 0,0:05:19.98,0:05:22.54,Caption,,0,0,0,,РОССИЙСКИХ ПРЕДЛОЖЕНИЯХ ДЕКАБРЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:05:22.54,0:05:25.50,Caption,,0,0,0,,ПЕРВОГО ГОДА. МОСКВА ПРЕДЛАГАЕТ ОРИЕНТИРОВАТЬСЯ НА
Dialogue: 0,0:05:25.50,0:05:27.33,Caption,,0,0,0,,КОНФИГУРАЦИЮ СИЛ И ВООРУЖЕНИЙ,
Dialogue: 0,0:05:27.57,0:05:30.94,Caption,,0,0,0,,СУЩЕСТВОВАВШУЮ НА МОМЕНТ ПОДПИСАНИЯ ЭТОГО АКТА. НЕ
Dialogue: 0,0:05:31.02,0:05:35.82,Caption,,0,0,0,,ВЫГНАТЬ ИЗ НАТО ВСЕХ, КТО ВСТУПИЛ ПОЗЖЕ. НЕ ОТОБРАТЬ ЧЛЕНСКИЕ КАРТОЧКИ. А
Dialogue: 0,0:05:35.82,0:05:38.86,Caption,,0,0,0,,ВЕРНУТЬ ВОЕННУЮ СОСТАВЛЯЮЩУЮ К ДРУГОЙ ТОЧКЕ ОТСЧЁТА.
Dialogue: 0,0:05:39.08,0:05:41.34,Caption,,0,0,0,,И ВОТ КТО ЭТО ВСЁ ТОГДА ПУБЛИЧНО ОБЪЯСНЯЕТ
Dialogue: 0,0:05:41.42,0:05:45.02,Caption,,0,0,0,,ЗАПАДУ? РЯБКОВ. КРАСИВО ПОЛУЧАЕТСЯ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:05:45.10,0:05:47.82,Caption,,0,0,0,,ПЕРВОМ ГОДУ РЯБКОВ ПРИХОДИТ С ТРЕБОВАНИЯМИ. ЗАПАД
Dialogue: 0,0:05:47.82,0:05:51.02,Caption,,0,0,0,,ГОВОРИТ НЕТ. ПОТОМ СОВЕТ РОССИЯ НАТО ОКОНЧАТЕЛЬНО
Dialogue: 0,0:05:51.02,0:05:54.30,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ ПРАКТИЧЕСКИ В ПУСТУЮ ВЫВЕСКУ. ПОСЛЕДНЕЕ
Dialogue: 0,0:05:54.30,0:05:56.54,Caption,,0,0,0,,ЗАСЕДАНИЕ ПРОХОДИТ В ЯНВАРЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:05:56.54,0:05:59.26,Caption,,0,0,0,,ВТОРОГО ГОДА. ДАЛЬШЕ НАЧИНАЕТСЯ СОВСЕМ ДРУГАЯ
Dialogue: 0,0:05:59.34,0:06:02.54,Caption,,0,0,0,,ИСТОРИЯ. ПРОХОДИТ ПЯТЬ ЛЕТ. РЯБКОВ СНОВА ЗА СТОЛОМ.
Dialogue: 0,0:06:02.75,0:06:05.42,Caption,,0,0,0,,А ИЗ ВАШИНГТОНА ВДРУГ ПРИЛЕТАЕТ ЕЩЁ ОДНА ОЧЕНЬ
Dialogue: 0,0:06:05.42,0:06:11.05,Caption,,0,0,0,,ЛЮБОПЫТНАЯ ИДЕЯ. ДЖАРЕД КУШНЕР ПРЕДЛАГАЕТ ВЕРНУТЬСЯ К МЕХАНИЗМУ
Dialogue: 0,0:06:11.05,0:06:13.61,Caption,,0,0,0,,СОВЕТА РОССИЯ НАТО ДЛЯ РАЗГОВОРА О ЕВРОПЕЙСКОЙ
Dialogue: 0,0:06:13.61,0:06:16.89,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ВОТ ЭТО УЖЕ СОВСЕМ КРАСИВО. ПОТОМУ ЧТО
Dialogue: 0,0:06:16.89,0:06:19.93,Caption,,0,0,0,,СОВЕТ РОССИЯ НАТО СОЗДАВАЛСЯ ИМЕННО КАК МЕСТО,
Dialogue: 0,0:06:20.17,0:06:22.97,Caption,,0,0,0,,ГДЕ МОСКВА И СТРАНЫ АЛЬЯНСА ДОЛЖНЫ БЫЛИ ОБСУЖДАТЬ
Dialogue: 0,0:06:22.97,0:06:26.01,Caption,,0,0,0,,ВОПРОСЫ ОБЩЕЙ БЕЗОПАСНОСТИ. И РОССИЙСКИЕ ПРЕДЛОЖЕНИЯ
Dialogue: 0,0:06:26.09,0:06:27.77,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА ТОЖЕ
Dialogue: 0,0:06:27.77,0:06:30.41,Caption,,0,0,0,,ПРЕДУСМАТРИВАЛИ КОНСУЛЬТАЦИИ ЧЕРЕЗ ЭТОТ МЕХАНИЗМ.
Dialogue: 0,0:06:30.61,0:06:32.89,Caption,,0,0,0,,ПОЛУЧАЕТСЯ КАКАЯ ИНТЕРЕСНАЯ ДИПЛОМАТИЧЕСКАЯ
Dialogue: 0,0:06:32.89,0:06:35.69,Caption,,0,0,0,,ЭВОЛЮЦИЯ. ПЯТЬ ЛЕТ НАЗАД РАЗГОВОР ОСТАНОВИЛСЯ
Dialogue: 0,0:06:35.69,0:06:40.01,Caption,,0,0,0,,ПРИМЕРНО НА СЛОВАХ НЕТ, ЭТИ УСЛОВИЯ НАС НЕ УСТРАИВАЮТ. А ТЕПЕРЬ ДОСТАЮТ
Dialogue: 0,0:06:40.01,0:06:42.57,Caption,,0,0,0,,ЧЕЛОВЕКА, КОТОРЫЙ ЭТИ УСЛОВИЯ ПРЕДСТАВЛЯЛ,
Dialogue: 0,0:06:42.80,0:06:44.81,Caption,,0,0,0,,И РЯДОМ НАЧИНАЮТ ВСПОМИНАТЬ МЕХАНИЗМ,
Dialogue: 0,0:06:44.97,0:06:47.05,Caption,,0,0,0,,ЧЕРЕЗ КОТОРЫЙ ТАКИЕ ВОПРОСЫ ВООБЩЕ ДОЛЖНЫ
Dialogue: 0,0:06:47.05,0:06:50.97,Caption,,0,0,0,,ОБСУЖДАТЬСЯ. ТУТ УЖЕ ХОЧЕТСЯ ЗАДАТЬ ОЧЕНЬ ПРОСТОЙ ВОПРОС. А
Dialogue: 0,0:06:50.97,0:06:55.05,Caption,,0,0,0,,О ЧЁМ ИМ ТОГДА РАЗГОВАРИВАТЬ, ЕСЛИ НЕ ВОЗВРАЩАТЬСЯ К ТОМУ САМОМУ ФУНДАМЕНТАЛЬНОМУ
Dialogue: 0,0:06:55.13,0:06:59.77,Caption,,0,0,0,,СПОРУ? ЧТО ТАМ ЕЩЁ МУСОЛИТЬ? ПОТОМУ ЧТО УКРАИНА ОТДЕЛЬНО ОТ ЭТОГО СПОРА ДАВНО
Dialogue: 0,0:06:59.85,0:07:04.14,Caption,,0,0,0,,УЖЕ НЕ СУЩЕСТВУЕТ. ЕСЛИ РОССИЯ ГОВОРИТ,
Dialogue: 0,0:07:04.30,0:07:08.46,Caption,,0,0,0,,ЧТО ВОПРОС УПИРАЕТСЯ В НАТО, ВООРУЖЕНИЯ И ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:07:08.81,0:07:11.02,Caption,,0,0,0,,ЕСЛИ СОЕДИНЁННЫЕ ШТАТЫ ПРЕДЛАГАЮТ НОВУЮ
Dialogue: 0,0:07:11.02,0:07:13.82,Caption,,0,0,0,,ОБЩЕЕВРОПЕЙСКУЮ КОНСТРУКЦИЮ БЕЗОПАСНОСТИ С РОССИЕЙ,
Dialogue: 0,0:07:14.21,0:07:16.78,Caption,,0,0,0,,ЕСЛИ КУШНЕР ВЫТАСКИВАЕТ СОВЕТ РОССИЯ НАТО,
Dialogue: 0,0:07:17.10,0:07:18.94,Caption,,0,0,0,,ЕСЛИ ЗА СТОЛ ПРИЕЗЖАЕТ РЯБКОВ,
Dialogue: 0,0:07:19.26,0:07:23.42,Caption,,0,0,0,,ТО ТРУДНО СДЕЛАТЬ ВИД, ЧТО ВСЕ СОБРАЛИСЬ ИСКЛЮЧИТЕЛЬНО ОБСУДИТЬ НЕСКОЛЬКО
Dialogue: 0,0:07:23.42,0:07:26.46,Caption,,0,0,0,,РАЙОНОВ НА КАРТЕ. И ЕВРОПА ЭТО ПРЕКРАСНО ЧУВСТВУЕТ.
Dialogue: 0,0:07:26.62,0:07:30.22,Caption,,0,0,0,,POLITICO ПИШЕТ, ЧТО ПРЕДЛОЖЕНИЕ АДМИНИСТРАЦИИ ТРАМПА О НОВОМ
Dialogue: 0,0:07:30.22,0:07:33.02,Caption,,0,0,0,,ОБЩЕЕВРОПЕЙСКОМ СОГЛАШЕНИИ С РОССИЕЙ ВЫЗВАЛО
Dialogue: 0,0:07:33.10,0:07:36.14,Caption,,0,0,0,,СЕРЬЁЗНЫЙ СКЕПТИЦИЗМ В ЕВРОПЕЙСКИХ СТОЛИЦАХ. КАЯ
Dialogue: 0,0:07:36.14,0:07:40.14,Caption,,0,0,0,,КАЛЛАС УЖЕ НАПОМИНАЕТ, ЧТО ЕВРОПЕЙСКАЯ АРХИТЕКТУРА БЕЗОПАСНОСТИ ВООБЩЕ ТО
Dialogue: 0,0:07:40.14,0:07:43.82,Caption,,0,0,0,,СУЩЕСТВУЕТ. НАТО ЕСТЬ. ЕВРОСОЮЗ ЕСТЬ. И ОСОБЕННО
Dialogue: 0,0:07:43.82,0:07:48.14,Caption,,0,0,0,,ЕВРОПЕЙЦАМ НЕ НРАВИТСЯ МЫСЛЬ, ЧТО ВАШИНГТОН СПОСОБЕН НАЧАТЬ ПЕРЕСТРАИВАТЬ ЭТУ
Dialogue: 0,0:07:48.14,0:07:50.22,Caption,,0,0,0,,АРХИТЕКТУРУ БЕЗ ПОЛНОГО ПРЕДВАРИТЕЛЬНОГО
Dialogue: 0,0:07:50.22,0:07:54.62,Caption,,0,0,0,,СОГЛАСОВАНИЯ С ТЕМИ, КТО ВНУТРИ НЕЁ ЖИВЁТ. И ТУТ ЕВРОПА ОКАЗЫВАЕТСЯ
Dialogue: 0,0:07:54.70,0:07:57.02,Caption,,0,0,0,,В ЗАМЕЧАТЕЛЬНОЙ СИТУАЦИИ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:07:57.34,0:08:01.42,Caption,,0,0,0,,ОНА НЕСКОЛЬКО ЛЕТ ОБЪЯСНЯЛА, ЧТО РАЗГОВАРИВАТЬ С МОСКВОЙ ПРАКТИЧЕСКИ НЕ О ЧЕМ.
Dialogue: 0,0:08:01.64,0:08:05.02,Caption,,0,0,0,,С ДРУГОЙ СТОРОНЫ, КАК ТОЛЬКО ВАШИНГТОН РЕАЛЬНО НАЧИНАЕТ ЧТО ТО
Dialogue: 0,0:08:05.10,0:08:07.50,Caption,,0,0,0,,ОБСУЖДАТЬ С МОСКВОЙ, СРАЗУ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:08:07.66,0:08:11.34,Caption,,0,0,0,,ЧТО РАЗГОВАРИВАТЬ ЕСТЬ О ЧЁМ, И ОЧЕНЬ ЖЕЛАТЕЛЬНО ПРИСУТСТВОВАТЬ ЛИЧНО.
Dialogue: 0,0:08:13.62,0:08:16.26,Caption,,0,0,0,,ФРАНЦИЯ УЖЕ ХОЧЕТ ОТПРАВИТЬ СВОЕГО ПРЕДСТАВИТЕЛЯ В
Dialogue: 0,0:08:16.34,0:08:19.06,Caption,,0,0,0,,АБУ ДАБИ. ПОТОМУ ЧТО ОДНО ДЕЛО РАССУЖДАТЬ О
Dialogue: 0,0:08:19.06,0:08:21.38,Caption,,0,0,0,,ПРИНЦИПАХ ИЗ ПАРИЖА. И СОВСЕМ ДРУГОЕ,
Dialogue: 0,0:08:21.62,0:08:23.94,Caption,,0,0,0,,КОГДА БЕЗ ТЕБЯ НАЧИНАЮТ ОБСУЖДАТЬ ПРАВИЛА,
Dialogue: 0,0:08:24.26,0:08:27.14,Caption,,0,0,0,,ПО КОТОРЫМ ПОТОМ БУДЕТ ЖИТЬ ВЕСЬ КОНТИНЕНТ. ВОТ
Dialogue: 0,0:08:27.22,0:08:29.70,Caption,,0,0,0,,ТУТ ФРАНЦУЗСКАЯ ДИПЛОМАТИЯ ВНЕЗАПНО ОБНАРУЖИВАЕТ
Dialogue: 0,0:08:29.70,0:08:32.98,Caption,,0,0,0,,СТАРУЮ ИСТИНУ. ЕСЛИ НА СОВЕЩАНИИ ОБСУЖДАЮТ ТВОЮ
Dialogue: 0,0:08:32.98,0:08:36.58,Caption,,0,0,0,,КВАРТИРУ, ЛУЧШЕ ВСЁ ТАКИ НАХОДИТЬСЯ В КОМНАТЕ. ПРОБЛЕМА ТОЛЬКО
Dialogue: 0,0:08:36.66,0:08:40.02,Caption,,0,0,0,,В ТОМ, КТО ИМЕННО ДОЛЖЕН ПРЕДСТАВЛЯТЬ ЭТУ САМУЮ ЕВРОПУ.
Dialogue: 0,0:08:40.50,0:08:43.07,Caption,,0,0,0,,ПОТОМУ ЧТО ДЖОРДЖА МЕЛОНИ ПРАКТИЧЕСКИ ПРЯМЫМ ТЕКСТОМ
Dialogue: 0,0:08:43.07,0:08:46.98,Caption,,0,0,0,,ГОВОРИТ, ЧТО ЕВРОСОЮЗ ПО УКРАИНСКОМУ ВОПРОСУ РАЗОБЩЁН. ОДНИ
Dialogue: 0,0:08:46.98,0:08:50.58,Caption,,0,0,0,,ФОРМАТЫ. ДРУГИЕ ФОРМАТЫ. ТРЕТЬИ ИНИЦИАТИВЫ. КТО ТО
Dialogue: 0,0:08:50.66,0:08:52.58,Caption,,0,0,0,,ЗВОНИТ ПУТИНУ. КТО ТО ГОВОРИТ,
Dialogue: 0,0:08:52.74,0:08:55.54,Caption,,0,0,0,,ЧТО ЗВОНИТЬ НЕЛЬЗЯ. КТО ТО ХОЧЕТ ОТДЕЛЬНОЕ МЕСТО
Dialogue: 0,0:08:55.54,0:09:00.10,Caption,,0,0,0,,ЗА СТОЛОМ. КТО ТО СЧИТАЕТ, ЧТО ЗА СТОЛОМ ВООБЩЕ ДОЛЖНЫ СИДЕТЬ ТОЛЬКО ИЗБРАННЫЕ.
Dialogue: 0,0:09:00.31,0:09:02.83,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ ЕДИНАЯ ЕВРОПЕЙСКАЯ
Dialogue: 0,0:09:02.90,0:09:07.54,Caption,,0,0,0,,ПОЛИТИКА. ЕДИНСТВА НЕТ, ЗАТО ПРЕДСТАВИТЕЛЕЙ УЖЕ НЕКУДА САЖАТЬ. И НА ЭТОМ
Dialogue: 0,0:09:07.62,0:09:10.42,Caption,,0,0,0,,ФОНЕ ОСОБЕННО ЗАБАВНО ЧИТАТЬ ОПАСЕНИЯ КИЕВА О НОВОЙ
Dialogue: 0,0:09:10.42,0:09:13.54,Caption,,0,0,0,,ЯЛТЕ. ИТАЛЬЯНСКАЯ IL FATTO QUOTIDIANO ПИШЕТ,
Dialogue: 0,0:09:13.86,0:09:16.42,Caption,,0,0,0,,ЧТО УКРАИНА БОИТСЯ СОГЛАШЕНИЯ КРУПНЫХ ДЕРЖАВ БЕЗ
Dialogue: 0,0:09:16.50,0:09:20.42,Caption,,0,0,0,,СВОЕГО УЧАСТИЯ. ФРАЗА ПРО НОВУЮ ЯЛТУ ЗДЕСЬ ОЧЕНЬ ПОКАЗАТЕЛЬНА.
Dialogue: 0,0:09:20.74,0:09:22.58,Caption,,0,0,0,,ПОТОМУ ЧТО ЯЛТА ЭТО НЕ ПРОСТО ГОРОД.
Dialogue: 0,0:09:24.86,0:09:28.54,Caption,,0,0,0,,ЭТО ОБРАЗ МИРА, ГДЕ НЕСКОЛЬКО БОЛЬШИХ ИГРОКОВ САДЯТСЯ ЗА СТОЛ И
Dialogue: 0,0:09:28.54,0:09:31.98,Caption,,0,0,0,,РЕШАЮТ, КАК ДАЛЬШЕ БУДЕТ УСТРОЕНО ПРОСТРАНСТВО ВОКРУГ НИХ.
Dialogue: 0,0:09:32.49,0:09:35.26,Caption,,0,0,0,,КИЕВ БОИТСЯ ИМЕННО ЭТОГО. НЕ ПРОСТО ОТДЕЛЬНОЙ
Dialogue: 0,0:09:35.26,0:09:38.14,Caption,,0,0,0,,ДОГОВОРЁННОСТИ ПУТИНА С ТРАМПОМ. А СИТУАЦИИ,
Dialogue: 0,0:09:38.30,0:09:41.02,Caption,,0,0,0,,КОГДА ОСНОВНЫЕ ПРАВИЛА ОПРЕДЕЛЯТ БОЛЬШИЕ ДЕРЖАВЫ,
Dialogue: 0,0:09:41.34,0:09:43.82,Caption,,0,0,0,,А ОСТАЛЬНЫМ ПОТОМ ПРИНЕСУТ РЕЗУЛЬТАТ И ПРЕДЛОЖАТ
Dialogue: 0,0:09:43.82,0:09:46.62,Caption,,0,0,0,,ОЗНАКОМИТЬСЯ. И ВОТ ЗДЕСЬ СЛОВА ТРАМПА ПРО ДРУГУЮ
Dialogue: 0,0:09:46.70,0:09:49.26,Caption,,0,0,0,,ФОРМУ УКРАИНЫ НАЧИНАЮТ ЗВУЧАТЬ ОСОБЕННО НЕПРИЯТНО
Dialogue: 0,0:09:49.34,0:09:51.98,Caption,,0,0,0,,ДЛЯ КИЕВА. ПОТОМУ ЧТО УКРАИНСКАЯ ДЕЛЕГАЦИЯ НА
Dialogue: 0,0:09:51.98,0:09:55.10,Caption,,0,0,0,,ПЕРЕГОВОРАХ ЕСТЬ. ОНА БОЛЬШАЯ. ТАМ И ПОЛИТИКИ,
Dialogue: 0,0:09:55.40,0:09:59.10,Caption,,0,0,0,,И ДИПЛОМАТЫ, И СИЛОВОЙ БЛОК. НО ПРИСУТСТВОВАТЬ ЗА СТОЛОМ И
Dialogue: 0,0:09:59.10,0:10:01.26,Caption,,0,0,0,,ОПРЕДЕЛЯТЬ РАМКУ РАЗГОВОРА ЭТО НЕ ОДНО И ТО
Dialogue: 0,0:10:01.26,0:10:03.74,Caption,,0,0,0,,ЖЕ. МОЖНО СИДЕТЬ НА СОВЕЩАНИИ ОТ НАЧАЛА ДО
Dialogue: 0,0:10:03.74,0:10:08.38,Caption,,0,0,0,,КОНЦА И ВСЁ РАВНО ОБНАРУЖИТЬ, ЧТО ГЛАВНЫЕ ВОПРОСЫ СФОРМУЛИРОВАЛИ ЕЩЁ ДО ТОГО,
Dialogue: 0,0:10:08.54,0:10:11.42,Caption,,0,0,0,,КАК ТЫ ОТКРЫЛ ПАПКУ. ИМЕННО ПОЭТОМУ ТАК ВАЖЕН
Dialogue: 0,0:10:11.42,0:10:14.70,Caption,,0,0,0,,МАСШТАБ ТЕМЫ. ЕСЛИ ОБСУЖДАЕТСЯ ПРОСТО ПРЕКРАЩЕНИЕ
Dialogue: 0,0:10:14.70,0:10:18.38,Caption,,0,0,0,,ОГНЯ, ЭТО ОДИН РАЗГОВОР. ЕСЛИ ОБСУЖДАЮТСЯ ТЕРРИТОРИИ,
Dialogue: 0,0:10:18.46,0:10:21.98,Caption,,0,0,0,,ВТОРОЙ. ЕСЛИ ОБСУЖДАЮТСЯ БУДУЩАЯ АРМИЯ УКРАИНЫ,
Dialogue: 0,0:10:22.07,0:10:25.90,Caption,,0,0,0,,ВОЕННАЯ ИНФРАСТРУКТУРА, НАТО, РАЗМЕЩЕНИЕ СИЛ,
Dialogue: 0,0:10:26.14,0:10:30.70,Caption,,0,0,0,,ГАРАНТИИ РОССИИ, ГАРАНТИИ ЕВРОПЫ И НОВЫЕ ПРАВИЛА ОТНОШЕНИЙ МОСКВЫ С
Dialogue: 0,0:10:30.70,0:10:33.50,Caption,,0,0,0,,АЛЬЯНСОМ, ЭТО УЖЕ ВООБЩЕ ДРУГОЙ ЭТАЖ ЗДАНИЯ.
Dialogue: 0,0:10:34.06,0:10:36.30,Caption,,0,0,0,,И ВОТ ТУТ ВОЗВРАЩАЕМСЯ К НАШЕЙ ИСХОДНОЙ ФРАЗЕ.
Dialogue: 0,0:10:36.70,0:10:39.26,Caption,,0,0,0,,УКРАИНА НЕМНОГО ДРУГОЙ ФОРМЫ. КАКОЙ ИМЕННО?
Dialogue: 0,0:10:41.53,0:10:45.69,Caption,,0,0,0,,ДОПУСТИМ, МЕНЯЮТСЯ ГРАНИЦЫ. ХОРОШО. НО РОССИЯ ВЕДЬ НЕ ГОВОРИЛА
Dialogue: 0,0:10:45.69,0:10:47.77,Caption,,0,0,0,,ЧЕТЫРЕ ГОДА ПОДРЯД ГЛАВНАЯ НАША ПРОБЛЕМА
Dialogue: 0,0:10:47.77,0:10:51.77,Caption,,0,0,0,,ИСКЛЮЧИТЕЛЬНО В ТОМ, ГДЕ ПРОХОДИТ АДМИНИСТРАТИВНАЯ ЛИНИЯ. ОНА ГОВОРИЛА О
Dialogue: 0,0:10:51.77,0:10:55.61,Caption,,0,0,0,,НЕЙТРАЛЬНОМ СТАТУСЕ. О НАТО. О ВОЕННОМ ПОТЕНЦИАЛЕ. О
Dialogue: 0,0:10:55.61,0:10:59.37,Caption,,0,0,0,,ВООРУЖЕНИЯХ. О БЕЗОПАСНОСТИ РОССИИ. ЕСЛИ В КОНЕЧНОЕ
Dialogue: 0,0:10:59.37,0:11:02.01,Caption,,0,0,0,,СОГЛАШЕНИЕ ДЕЙСТВИТЕЛЬНО ПОЙДУТ ХОТЯ БЫ ЧАСТИ ЭТИХ
Dialogue: 0,0:11:02.01,0:11:05.13,Caption,,0,0,0,,ТРЕБОВАНИЙ, УКРАИНА УЖЕ БУДЕТ ДРУГОЙ НЕ ТОЛЬКО НА КАРТЕ.
Dialogue: 0,0:11:05.35,0:11:08.49,Caption,,0,0,0,,ОНА БУДЕТ ДРУГОЙ ВОЕННО. ДРУГОЙ ВНЕШНЕПОЛИТИЧЕСКИ.
Dialogue: 0,0:11:09.05,0:11:11.53,Caption,,0,0,0,,А ДАЛЬШЕ ВОЗНИКАЕТ ЕЩЁ БОЛЕЕ НЕПРИЯТНЫЙ ВОПРОС О
Dialogue: 0,0:11:11.53,0:11:14.57,Caption,,0,0,0,,ПОЛИТИЧЕСКОЙ ФОРМЕ. ПОТОМУ ЧТО ЕСЛИ СТРАНА СОХРАНЯЕТ
Dialogue: 0,0:11:14.57,0:11:16.49,Caption,,0,0,0,,АБСОЛЮТНО ТОТ ЖЕ ПОЛИТИЧЕСКИЙ КУРС,
Dialogue: 0,0:11:16.89,0:11:19.05,Caption,,0,0,0,,ТУ ЖЕ ИДЕОЛОГИЧЕСКУЮ КОНСТРУКЦИЮ ОТНОШЕНИЙ С
Dialogue: 0,0:11:19.05,0:11:22.49,Caption,,0,0,0,,РОССИЕЙ, ТОТ ЖЕ ВОЕННЫЙ ВЕКТОР И ПРОСТО ТЕРЯЕТ НЕСКОЛЬКО
Dialogue: 0,0:11:22.49,0:11:25.61,Caption,,0,0,0,,ТЕРРИТОРИЙ, ТО ГДЕ ЗДЕСЬ ГЛОБАЛЬНОЕ РЕШЕНИЕ ПРОБЛЕМЫ,
Dialogue: 0,0:11:25.85,0:11:27.61,Caption,,0,0,0,,О КОТОРОМ МОСКВА ГОВОРИТ СТОЛЬКО ЛЕТ?
Dialogue: 0,0:11:28.01,0:11:30.49,Caption,,0,0,0,,ВОТ ПОЭТОМУ ФРАЗА ТРАМПА И ЦЕПЛЯЕТ. ОН НЕ
Dialogue: 0,0:11:30.57,0:11:33.37,Caption,,0,0,0,,СКАЗАЛ УКРАИНА ПОТЕРЯЕТ ЧАСТЬ ТЕРРИТОРИИ. ОН СКАЗАЛ
Dialogue: 0,0:11:33.37,0:11:36.81,Caption,,0,0,0,,ШИРЕ. ДРУГАЯ ФОРМА. И ЭТУ ФОРМУЛИРОВКУ СТОИТ ОЧЕНЬ
Dialogue: 0,0:11:36.81,0:11:39.69,Caption,,0,0,0,,ВНИМАТЕЛЬНО ЗАПОМНИТЬ. ТЕМ ВРЕМЕНЕМ АМЕРИКАНЦЫ ХОТЯТ
Dialogue: 0,0:11:39.69,0:11:42.41,Caption,,0,0,0,,ВИДЕТЬ ПУТИНА НА САММИТЕ БОЛЬШОЙ ДВАДЦАТКИ В МАЙАМИ.
Dialogue: 0,0:11:42.73,0:11:46.09,Caption,,0,0,0,,МОСКВА ГОВОРИТ, ЧТО ОКОНЧАТЕЛЬНОЕ РЕШЕНИЕ БУДЕТ ПРИНЯТО БЛИЖЕ К
Dialogue: 0,0:11:46.17,0:11:49.29,Caption,,0,0,0,,САМОМУ САММИТУ. И ЗДЕСЬ ВОЗНИКАЕТ ЕЩЁ ОДИН УРОВЕНЬ.
Dialogue: 0,0:11:51.56,0:11:54.04,Caption,,0,0,0,,ЕСЛИ АБУ ДАБИ ЭТО РАБОТА ПЕРЕГОВОРНЫХ ГРУПП,
Dialogue: 0,0:11:54.36,0:11:56.36,Caption,,0,0,0,,ТО МАЙАМИ УЖЕ СПОСОБЕН СТАТЬ МЕСТОМ,
Dialogue: 0,0:11:56.68,0:11:59.32,Caption,,0,0,0,,ГДЕ РЕШЕНИЯ ПОДНИМАЮТСЯ НА ПОЛИТИЧЕСКИЙ ЭТАЖ ВЫШЕ.
Dialogue: 0,0:11:59.55,0:12:02.36,Caption,,0,0,0,,ТО ЕСТЬ СПЕЦИАЛИСТЫ РАЗБИРАЮТ ПУНКТЫ. ВОЕННЫЕ
Dialogue: 0,0:12:02.36,0:12:05.24,Caption,,0,0,0,,СЧИТАЮТ ОГРАНИЧЕНИЯ. ДИПЛОМАТЫ СОГЛАСОВЫВАЮТ
Dialogue: 0,0:12:05.24,0:12:07.80,Caption,,0,0,0,,ФОРМУЛИРОВКИ. А ПОТОМ РУКОВОДИТЕЛИ РЕШАЮТ,
Dialogue: 0,0:12:08.04,0:12:11.00,Caption,,0,0,0,,ЧТО ИЗ ЭТОГО ВООБЩЕ ПОДПИСЫВАТЬ. И ЕСЛИ ПУТИН
Dialogue: 0,0:12:11.08,0:12:13.00,Caption,,0,0,0,,В ИТОГЕ ДЕЙСТВИТЕЛЬНО ЕДЕТ В МАЙАМИ,
Dialogue: 0,0:12:13.24,0:12:15.24,Caption,,0,0,0,,СМОТРЕТЬ НАДО БУДЕТ УЖЕ НЕ НА САМ ФАКТ
Dialogue: 0,0:12:15.24,0:12:17.24,Caption,,0,0,0,,РУКОПОЖАТИЯ. СМОТРЕТЬ НАДО БУДЕТ,
Dialogue: 0,0:12:17.48,0:12:20.12,Caption,,0,0,0,,ЧТО УСПЕЛИ ПОДГОТОВИТЬ К ЭТОМУ МОМЕНТУ ЛЮДИ ВРОДЕ
Dialogue: 0,0:12:20.12,0:12:22.76,Caption,,0,0,0,,РЯБКОВА. ПОТОМУ ЧТО НА ВСТРЕЧЕ ЛИДЕРОВ РЕДКО
Dialogue: 0,0:12:22.76,0:12:25.48,Caption,,0,0,0,,НАЧИНАЮТ ЧИТАТЬ ДОГОВОР С ПЕРВОЙ СТРАНИЦЫ. К ИХ
Dialogue: 0,0:12:25.56,0:12:27.32,Caption,,0,0,0,,ВСТРЕЧЕ ОБЫЧНО УЖЕ ПРИНОСЯТ ТО,
Dialogue: 0,0:12:27.48,0:12:30.44,Caption,,0,0,0,,ЧТО ПРЕДВАРИТЕЛЬНО ОТРАБОТАЛИ ОСТАЛЬНЫЕ. ВОТ ПОЧЕМУ
Dialogue: 0,0:12:30.52,0:12:33.48,Caption,,0,0,0,,НЫНЕШНЕЕ ПОВЫШЕНИЕ РОССИЙСКОЙ ДЕЛЕГАЦИИ ВЫГЛЯДИТ
Dialogue: 0,0:12:33.48,0:12:36.12,Caption,,0,0,0,,СОВСЕМ НЕ ДЕКОРАТИВНО. BLOOMBERG ПИШЕТ,
Dialogue: 0,0:12:36.44,0:12:38.84,Caption,,0,0,0,,ЧТО КРЕМЛЬ ДЕМОНСТРИРУЕТ СЕРЬЁЗНЫЙ НАСТРОЙ НА
Dialogue: 0,0:12:38.84,0:12:42.28,Caption,,0,0,0,,ПЕРЕГОВОРЫ И НАПРАВЛЯЕТ РАСШИРЕННУЮ ГРУППУ. И ЗДЕСЬ
Dialogue: 0,0:12:42.28,0:12:44.92,Caption,,0,0,0,,СЕРЬЁЗНОСТЬ ЛУЧШЕ ВСЕГО ВИДНА НЕ ПО КРАСИВЫМ СЛОВАМ
Dialogue: 0,0:12:45.00,0:12:48.84,Caption,,0,0,0,,ПЕСКОВА. СМОТРИТЕ НА ФАМИЛИИ. РЯБКОВ. ГАЛУЗИН.
Dialogue: 0,0:12:49.00,0:12:52.20,Caption,,0,0,0,,КОСТЮКОВ. ПРЕДСТАВИТЕЛЬ ГЕНЕРАЛЬНОГО ШТАБА. КОГДА
Dialogue: 0,0:12:52.20,0:12:54.20,Caption,,0,0,0,,РОССИЯ ОТПРАВЛЯЕТ ЛЮДЕЙ ТАКОГО ПРОФИЛЯ,
Dialogue: 0,0:12:54.44,0:12:57.48,Caption,,0,0,0,,ВОПРОС ЯВНО ВЫХОДИТ ЗА РАМКИ ФОТОГРАФИИ ДЛЯ ПРЕССЫ.
Dialogue: 0,0:12:57.80,0:13:00.44,Caption,,0,0,0,,КСТАТИ, ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ.
Dialogue: 0,0:13:02.72,0:13:05.04,Caption,,0,0,0,,ПОТОМУ ЧТО ИМЕННО НА ТАКИХ ФАМИЛИЯХ ОБЫЧНО И
Dialogue: 0,0:13:05.04,0:13:08.88,Caption,,0,0,0,,ЛЕЖИТ ПОЛОВИНА СМЫСЛА, КОТОРУЮ ПОТОМ ТЕРЯЮТ В ЗАГОЛОВКЕ ИЗ ТРЁХ СЛОВ.
Dialogue: 0,0:13:09.25,0:13:13.20,Caption,,0,0,0,,ТЕПЕРЬ СОБЕРЁМ ВСЁ, НО БЕЗ ПОПЫТКИ СДЕЛАТЬ ИЗ ЭТОГО КРАСИВУЮ ТЕОРИЮ
Dialogue: 0,0:13:13.28,0:13:15.76,Caption,,0,0,0,,РАДИ КРАСИВОЙ ТЕОРИИ. ТРАМП ГОВОРИТ,
Dialogue: 0,0:13:15.92,0:13:18.56,Caption,,0,0,0,,ЧТО УКРАИНА БУДЕТ ДРУГОЙ ФОРМЫ. РОССИЙСКАЯ
Dialogue: 0,0:13:18.56,0:13:20.72,Caption,,0,0,0,,ПЕРЕГОВОРНАЯ ГРУППА УСИЛИВАЕТСЯ ЛЮДЬМИ,
Dialogue: 0,0:13:20.95,0:13:23.04,Caption,,0,0,0,,КОТОРЫЕ ЗАНИМАЮТСЯ СОЕДИНЁННЫМИ ШТАТАМИ,
Dialogue: 0,0:13:23.20,0:13:26.08,Caption,,0,0,0,,СТРАТЕГИЧЕСКОЙ СТАБИЛЬНОСТЬЮ И ВОЕННЫМИ ВОПРОСАМИ.
Dialogue: 0,0:13:26.33,0:13:29.20,Caption,,0,0,0,,ВПЕРВЫЕ В НЕЙ ПОЯВЛЯЕТСЯ РЯБКОВ. ТОТ САМЫЙ РЯБКОВ,
Dialogue: 0,0:13:29.44,0:13:31.60,Caption,,0,0,0,,КОТОРЫЙ ПЯТЬ ЛЕТ НАЗАД ПРЕДСТАВЛЯЛ РОССИЙСКИЕ
Dialogue: 0,0:13:31.60,0:13:34.64,Caption,,0,0,0,,ТРЕБОВАНИЯ ПО ГАРАНТИЯМ БЕЗОПАСНОСТИ. ПАРАЛЛЕЛЬНО
Dialogue: 0,0:13:34.64,0:13:37.60,Caption,,0,0,0,,АМЕРИКАНСКАЯ СТОРОНА ОБСУЖДАЕТ НОВУЮ ОБЩЕЕВРОПЕЙСКУЮ
Dialogue: 0,0:13:37.60,0:13:40.32,Caption,,0,0,0,,КОНСТРУКЦИЮ БЕЗОПАСНОСТИ С РОССИЕЙ. КУШНЕР
Dialogue: 0,0:13:40.40,0:13:43.52,Caption,,0,0,0,,ВСПОМИНАЕТ СОВЕТ РОССИЯ НАТО. ЕВРОПЕЙЦЫ НЕРВНИЧАЮТ.
Dialogue: 0,0:13:43.69,0:13:46.64,Caption,,0,0,0,,ФРАНЦИЯ ХОЧЕТ СВОЕГО ЧЕЛОВЕКА. МЕЛОНИ ГОВОРИТ,
Dialogue: 0,0:13:46.84,0:13:49.84,Caption,,0,0,0,,ЧТО ЕВРОПА РАЗОБЩЕНА. КИЕВ УЖЕ УПОТРЕБЛЯЕТ СЛОВА
Dialogue: 0,0:13:49.84,0:13:52.80,Caption,,0,0,0,,НОВАЯ ЯЛТА. И ВСЁ ЭТО ПРОИСХОДИТ ВОКРУГ ОДНОГО
Dialogue: 0,0:13:52.80,0:13:56.40,Caption,,0,0,0,,ПЕРЕГОВОРНОГО ПРОЦЕССА. ВОТ ТЕПЕРЬ ВОПРОС. ЭТО ВСЁ
Dialogue: 0,0:13:56.40,0:14:00.16,Caption,,0,0,0,,ЕЩЁ ПРОСТО ПЕРЕГОВОРЫ О ТОМ, ГДЕ ОСТАНОВИТЬ БОЕВЫЕ ДЕЙСТВИЯ?
Dialogue: 0,0:14:00.54,0:14:03.04,Caption,,0,0,0,,ИЛИ БОЕВЫЕ ДЕЙСТВИЯ УЖЕ ТОЛЬКО ОДИН ПУНКТ В
Dialogue: 0,0:14:03.12,0:14:07.20,Caption,,0,0,0,,ГОРАЗДО БОЛЬШЕМ РАЗГОВОРЕ? ПОТОМУ ЧТО ЕСЛИ ГЛАВНЫЙ СПОР ДОШЁЛ ОБРАТНО ДО
Dialogue: 0,0:14:07.20,0:14:09.20,Caption,,0,0,0,,ВОПРОСОВ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА,
Dialogue: 0,0:14:09.52,0:14:11.84,Caption,,0,0,0,,ТОГДА ИСТОРИЯ ДЕЙСТВИТЕЛЬНО ЗАМЫКАЕТ КРУГ.
Dialogue: 0,0:14:14.11,0:14:16.52,Caption,,0,0,0,,ТОГДА ЧЕТЫРЕ С ЛИШНИМ ГОДА ОГРОМНОЙ МЯСОРУБКИ
Dialogue: 0,0:14:16.60,0:14:18.76,Caption,,0,0,0,,ПРИВОДЯТ СТОРОНЫ ПРИМЕРНО К ТОМУ СТОЛУ,
Dialogue: 0,0:14:19.08,0:14:21.56,Caption,,0,0,0,,ОТ КОТОРОГО ОНИ КОГДА ТО ВСТАЛИ. ТОЛЬКО УСЛОВИЯ
Dialogue: 0,0:14:21.56,0:14:25.32,Caption,,0,0,0,,ТЕПЕРЬ ДРУГИЕ. ТЕРРИТОРИИ ДРУГИЕ. БАЛАНС СИЛ ДРУГОЙ.
Dialogue: 0,0:14:25.56,0:14:29.00,Caption,,0,0,0,,ОТНОШЕНИЯ РОССИИ И ЕВРОПЫ ДРУГИЕ. ОТНОШЕНИЯ ЕВРОПЫ И
Dialogue: 0,0:14:29.08,0:14:32.28,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТОВ ДРУГИЕ. И ЦЕНА РАЗГОВОРА СОВСЕМ
Dialogue: 0,0:14:32.28,0:14:35.32,Caption,,0,0,0,,ДРУГАЯ. ОТСЮДА И ВОЗНИКАЕТ САМАЯ ЖЁСТКАЯ ВЕРСИЯ
Dialogue: 0,0:14:35.32,0:14:39.80,Caption,,0,0,0,,ПРОИСХОДЯЩЕГО. А ЧТО, ЕСЛИ ГЛОБАЛЬНЫЙ РАЗДЕЛ НА УРОВНЕ ПРИНЦИПОВ УЖЕ
Dialogue: 0,0:14:39.80,0:14:43.48,Caption,,0,0,0,,СОСТОЯЛСЯ, А СЕЙЧАС УЧАСТНИКИ ТОРГУЮТСЯ ТОЛЬКО ЗА ДЕТАЛИ ЕГО
Dialogue: 0,0:14:43.48,0:14:47.40,Caption,,0,0,0,,ОФОРМЛЕНИЯ? НЕ ОБЯЗАТЕЛЬНО КТО ТО НАРИСОВАЛ НОВУЮ КАРТУ ЕВРОПЫ
Dialogue: 0,0:14:47.40,0:14:50.12,Caption,,0,0,0,,И РАЗДАЛ КАЖДОМУ ПО ЭКЗЕМПЛЯРУ. РЕЧЬ О ДРУГОМ.
Dialogue: 0,0:14:50.33,0:14:52.44,Caption,,0,0,0,,ЕСЛИ ВАШИНГТОН УЖЕ ИСХОДИТ ИЗ ТОГО,
Dialogue: 0,0:14:52.60,0:14:55.00,Caption,,0,0,0,,ЧТО УКРАИНА ПОСЛЕ СОГЛАШЕНИЯ БУДЕТ ДРУГОЙ,
Dialogue: 0,0:14:55.32,0:14:57.64,Caption,,0,0,0,,ЕСЛИ МОСКВА ВЫВОДИТ НА ПЕРЕГОВОРЫ ЧЕЛОВЕКА,
Dialogue: 0,0:14:57.80,0:14:59.88,Caption,,0,0,0,,СВЯЗАННОГО С ЕЁ ПРЕЖНИМИ СТРАТЕГИЧЕСКИМИ
Dialogue: 0,0:14:59.88,0:15:03.64,Caption,,0,0,0,,ТРЕБОВАНИЯМИ, ЕСЛИ РАЗГОВОР ПОДНИМАЕТСЯ ОТ УКРАИНЫ К БЕЗОПАСНОСТИ
Dialogue: 0,0:15:03.72,0:15:07.40,Caption,,0,0,0,,ВСЕЙ ЕВРОПЫ, ТО ПРЕДМЕТ СДЕЛКИ ЯВНО СТАНОВИТСЯ БОЛЬШЕ САМОЙ
Dialogue: 0,0:15:07.40,0:15:10.36,Caption,,0,0,0,,УКРАИНЫ. И ВОТ ТОГДА КИЕВСКАЯ ТРЕВОГА ПО ПОВОДУ
Dialogue: 0,0:15:10.36,0:15:13.64,Caption,,0,0,0,,НОВОЙ ЯЛТЫ СТАНОВИТСЯ ПОНЯТНОЙ БЕЗ ВСЯКОЙ ИСТЕРИКИ.
Dialogue: 0,0:15:14.03,0:15:15.88,Caption,,0,0,0,,ПОТОМУ ЧТО ВОПРОС УЖЕ НЕ ТОЛЬКО В ТОМ,
Dialogue: 0,0:15:16.04,0:15:19.08,Caption,,0,0,0,,КАКУЮ ЛИНИЮ ПРОВЕДУТ НА ВОСТОКЕ СТРАНЫ. ВОПРОС В
Dialogue: 0,0:15:19.08,0:15:21.88,Caption,,0,0,0,,ТОМ, КАКИЕ ПРАВИЛА ПОСЛЕ ЭТОГО БУДУТ ДЕЙСТВОВАТЬ ОТ
Dialogue: 0,0:15:21.88,0:15:25.48,Caption,,0,0,0,,РОССИИ ДО ЦЕНТРАЛЬНОЙ ЕВРОПЫ. ГДЕ СТОЯТ ВОЙСКА. ГДЕ
Dialogue: 0,0:15:25.48,0:15:27.72,Caption,,0,0,0,,СТОЯТ РАКЕТЫ. ЧТО МОЖНО РАЗМЕЩАТЬ.
Dialogue: 0,0:15:29.92,0:15:32.96,Caption,,0,0,0,,ЧТО НЕЛЬЗЯ. КУДА МОЖЕТ ДВИГАТЬСЯ НАТО. КАКИЕ
Dialogue: 0,0:15:33.04,0:15:36.00,Caption,,0,0,0,,ГАРАНТИИ ПОЛУЧАЕТ УКРАИНА. КАКИЕ ГАРАНТИИ ТРЕБУЕТ
Dialogue: 0,0:15:36.00,0:15:38.88,Caption,,0,0,0,,РОССИЯ. КТО ЗА ВСЕМ ЭТИМ СЛЕДИТ. И ЧТО
Dialogue: 0,0:15:38.88,0:15:41.20,Caption,,0,0,0,,ПРОИСХОДИТ, ЕСЛИ КТО ТО СНОВА РЕШАЕТ,
Dialogue: 0,0:15:41.44,0:15:44.16,Caption,,0,0,0,,ЧТО ДОГОВОР МОЖНО ПОЛОЖИТЬ В ДАЛЬНИЙ ЯЩИК. А
Dialogue: 0,0:15:44.24,0:15:46.56,Caption,,0,0,0,,ДЕВЯНОСТО СЕДЬМОЙ ГОД ЗДЕСЬ НАЧИНАЕТ ВЫГЛЯДЕТЬ УЖЕ
Dialogue: 0,0:15:46.56,0:15:49.04,Caption,,0,0,0,,НЕ ПРОСТО ИСТОРИЧЕСКОЙ ДАТОЙ. ЭТО ТОЧКА,
Dialogue: 0,0:15:49.33,0:15:51.92,Caption,,0,0,0,,К КОТОРОЙ СТОРОНЫ СНОВА И СНОВА ВОЗВРАЩАЮТСЯ,
Dialogue: 0,0:15:52.16,0:15:54.48,Caption,,0,0,0,,ПОТОМУ ЧТО ИМЕННО ТАМ ЛЕЖИТ ОДИН ИЗ СТАРЫХ
Dialogue: 0,0:15:54.48,0:15:57.60,Caption,,0,0,0,,НЕЗАКРЫТЫХ СПОРОВ. СНАЧАЛА ОСНОВОПОЛАГАЮЩИЙ АКТ.
Dialogue: 0,0:15:57.92,0:16:01.04,Caption,,0,0,0,,ПОТОМ СОВЕТ РОССИЯ НАТО. ПОТОМ ТРЕБОВАНИЯ РОССИИ ДВЕ
Dialogue: 0,0:16:01.12,0:16:04.08,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА. ПОТОМ РАЗРЫВ. И ТЕПЕРЬ
Dialogue: 0,0:16:04.16,0:16:07.04,Caption,,0,0,0,,СНОВА РЯБКОВ, СНОВА РАЗГОВОР О РОССИИ И НАТО,
Dialogue: 0,0:16:07.20,0:16:10.32,Caption,,0,0,0,,СНОВА ОБЩЕЕВРОПЕЙСКАЯ БЕЗОПАСНОСТЬ. МОЖНО СКОЛЬКО
Dialogue: 0,0:16:10.32,0:16:14.16,Caption,,0,0,0,,УГОДНО ДЕЛАТЬ ВИД, ЧТО ЭТО ПРОСТО СОВПАДЕНИЕ КАЛЕНДАРЯ. ТОЛЬКО
Dialogue: 0,0:16:14.16,0:16:17.44,Caption,,0,0,0,,СОВПАДЕНИЕ КАКОЕ ТО ОЧЕНЬ ДИСЦИПЛИНИРОВАННОЕ. ВСЕ
Dialogue: 0,0:16:17.52,0:16:20.40,Caption,,0,0,0,,НУЖНЫЕ ЛЮДИ ПРИШЛИ. ВСЕ СТАРЫЕ ДОКУМЕНТЫ СНОВА
Dialogue: 0,0:16:20.40,0:16:23.36,Caption,,0,0,0,,ПОНАДОБИЛИСЬ. ВСЕ СТАРЫЕ ВОПРОСЫ СНОВА ЛЕЖАТ НА
Dialogue: 0,0:16:23.44,0:16:25.92,Caption,,0,0,0,,СТОЛЕ. И ДАЖЕ ТРАМП УЖЕ ЗАРАНЕЕ ГОВОРИТ,
Dialogue: 0,0:16:26.09,0:16:29.20,Caption,,0,0,0,,ЧТО УКРАИНА ВЫЙДЕТ ИЗ ЭТОЙ ИСТОРИИ ДРУГОЙ. ПОЭТОМУ
Dialogue: 0,0:16:29.28,0:16:31.76,Caption,,0,0,0,,СЕЙЧАС ВАЖНЕЕ НЕ ГРОМКИЕ СЛОВА О СКОРОМ МИРЕ.
Dialogue: 0,0:16:31.97,0:16:34.48,Caption,,0,0,0,,СЛОВО МИР ПОЛИТИКИ ВООБЩЕ ЛЮБЯТ ПОЧТИ ТАК ЖЕ
Dialogue: 0,0:16:34.56,0:16:36.40,Caption,,0,0,0,,СИЛЬНО, КАК СЛОВО ИСТОРИЧЕСКИЙ.
Dialogue: 0,0:16:38.68,0:16:41.08,Caption,,0,0,0,,ВАЖНЕЕ, КТО ПРИЕЗЖАЕТ В АБУ ДАБИ,
Dialogue: 0,0:16:41.38,0:16:44.12,Caption,,0,0,0,,КАКИЕ МЕХАНИЗМЫ СНОВА ВЫТАСКИВАЮТ ИЗ ПРОШЛОГО И
Dialogue: 0,0:16:44.12,0:16:46.12,Caption,,0,0,0,,КАКИЕ СЛОВА ПОЯВЛЯЮТСЯ У ЛЮДЕЙ,
Dialogue: 0,0:16:46.28,0:16:49.16,Caption,,0,0,0,,КОТОРЫЕ ПОТОМ БУДУТ СТАВИТЬ ПОДПИСИ. ПОТОМУ ЧТО
Dialogue: 0,0:16:49.16,0:16:51.56,Caption,,0,0,0,,ФАМИЛИЯ РЯБКОВА В ЭТОЙ ИСТОРИИ ГОВОРИТ ГОРАЗДО
Dialogue: 0,0:16:51.64,0:16:55.00,Caption,,0,0,0,,БОЛЬШЕ, ЧЕМ ОЧЕРЕДНОЕ ЗАЯВЛЕНИЕ О КОНСТРУКТИВНОЙ АТМОСФЕРЕ.
Dialogue: 0,0:16:55.30,0:16:57.72,Caption,,0,0,0,,А СЛОВА ТРАМПА О ДРУГОЙ ФОРМЕ УКРАИНЫ МОГУТ
Dialogue: 0,0:16:57.72,0:17:02.04,Caption,,0,0,0,,ОКАЗАТЬСЯ ТОЙ САМОЙ ФРАЗОЙ, СМЫСЛ КОТОРОЙ СТАНЕТ ОКОНЧАТЕЛЬНО ПОНЯТЕН ТОЛЬКО
Dialogue: 0,0:17:02.04,0:17:05.24,Caption,,0,0,0,,ТОГДА, КОГДА ДОГОВОР УЖЕ ПОЛОЖАТ НА СТОЛ. И ВОТ
Dialogue: 0,0:17:05.32,0:17:09.88,Caption,,0,0,0,,ТОГДА МЫ УВИДИМ, ЧТО ИМЕННО ТАМ ИЗМЕНИЛИ. ТОЛЬКО ГРАНИЦЫ. ИЛИ ВСЮ
Dialogue: 0,0:17:09.88,0:17:11.00,Caption,,0,0,0,,КОНСТРУКЦИЮ ЦЕЛИКОМ.
