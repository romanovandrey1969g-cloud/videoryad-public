Dialogue: 0,0:00:00.12,0:00:03.00,Caption,,0,0,0,,ОБЫЧНО САМЫЕ СМЕЛЫЕ СЦЕНАРИИ СНАЧАЛА ПРОИЗНОСЯТ
Dialogue: 0,0:00:03.00,0:00:06.36,Caption,,0,0,0,,ВПОЛГОЛОСА, ЧТОБЫ ПРИ НЕОБХОДИМОСТИ БЫСТРО СДЕЛАТЬ ВИД,
Dialogue: 0,0:00:06.60,0:00:11.64,Caption,,0,0,0,,БУДТО ВСЕМ ПОСЛЫШАЛОСЬ. НО СЕЙЧАС ПОХОЖИЕ МЫСЛИ ОДНОВРЕМЕННО ПРОЗВУЧАЛИ С
Dialogue: 0,0:00:11.72,0:00:15.64,Caption,,0,0,0,,ДВУХ СТОРОН. ВЛАДИМИР ПУТИН ПРЕДЛОЖИЛ УКРАИНЦАМ ИСКАТЬ ШИРОКОЕ
Dialogue: 0,0:00:15.64,0:00:18.76,Caption,,0,0,0,,ОБЪЕДИНЕНИЕ С РОССИЯНАМИ, А ТАРАС ЧМУТ ДОПУСТИЛ,
Dialogue: 0,0:00:19.07,0:00:21.80,Caption,,0,0,0,,ЧТО ОДНАЖДЫ УКРАИНА МОЖЕТ РАЗВЕРНУТЬСЯ ОТ ЕВРОПЫ К
Dialogue: 0,0:00:21.80,0:00:24.60,Caption,,0,0,0,,РОССИИ. НЕДАВНО ЗА ТАКОЙ РАЗГОВОР ЧЕЛОВЕКА ОТПРАВИЛИ
Dialogue: 0,0:00:24.68,0:00:27.40,Caption,,0,0,0,,БЫ ПРОВЕРЯТЬ ТЕМПЕРАТУРУ. ТЕПЕРЬ СПОРИТЬ ПРИХОДИТСЯ
Dialogue: 0,0:00:27.40,0:00:31.80,Caption,,0,0,0,,УЖЕ НЕ С ФАНТАЗИЕЙ, А С ПУБЛИЧНО СКАЗАННЫМИ СЛОВАМИ. В БЕСЕДЕ С
Dialogue: 0,0:00:31.80,0:00:34.20,Caption,,0,0,0,,ЭМИРОМ КУСТУРИЦЕЙ ПУТИН ОБРАТИЛСЯ НАПРЯМУЮ К
Dialogue: 0,0:00:34.20,0:00:36.84,Caption,,0,0,0,,УКРАИНЦАМ. ОН ЗАЯВИЛ, ЧТО ГОСУДАРСТВА,
Dialogue: 0,0:00:37.08,0:00:39.80,Caption,,0,0,0,,ПОДДЕРЖИВАЮЩИЕ КИЕВ В ПРОТИВОСТОЯНИИ С МОСКВОЙ,
Dialogue: 0,0:00:39.98,0:00:43.24,Caption,,0,0,0,,РЕШАЮТ СОБСТВЕННЫЕ ЗАДАЧИ. ИМ НУЖНА НЕ СИЛЬНАЯ
Dialogue: 0,0:00:43.24,0:00:46.68,Caption,,0,0,0,,УКРАИНА, А ОСЛАБЛЕНИЕ РОССИИ, ЕЁ РАСЧЛЕНЕНИЕ,
Dialogue: 0,0:00:46.84,0:00:50.12,Caption,,0,0,0,,РАЗБОР НА УДОБНЫЕ ЧАСТИ И ПОСЛЕДУЮЩЕЕ ПОДЧИНЕНИЕ.
Dialogue: 0,0:00:50.50,0:00:53.88,Caption,,0,0,0,,ПОМОЩЬ, ПО ЭТОЙ ВЕРСИИ, ВЫГЛЯДИТ НЕ ПОДАРКОМ СОСЕДУ,
Dialogue: 0,0:00:54.04,0:00:57.80,Caption,,0,0,0,,А ЛОМОМ, КОТОРЫМ ПЫТАЮТСЯ ВСКРЫТЬ ЧУЖУЮ ДВЕРЬ. СЛЕДУЮЩАЯ
Dialogue: 0,0:00:57.88,0:01:00.60,Caption,,0,0,0,,МЫСЛЬ ОКАЗАЛАСЬ ЕЩЁ ЛЮБОПЫТНЕЕ. ПУТИН ПРИЗВАЛ
Dialogue: 0,0:01:00.60,0:01:02.84,Caption,,0,0,0,,ЖИТЕЛЕЙ УКРАИНЫ СТРЕМИТЬСЯ К ОБЪЕДИНЕНИЮ С
Dialogue: 0,0:01:02.84,0:01:05.24,Caption,,0,0,0,,РОССИЯНАМИ. ПРИЧЁМ СРАЗУ УТОЧНИЛ,
Dialogue: 0,0:01:05.40,0:01:07.96,Caption,,0,0,0,,ЧТО ДЛЯ ЭТОГО ВОВСЕ НЕ ТРЕБУЕТСЯ ПОМЕЩАТЬ ВСЕХ
Dialogue: 0,0:01:08.04,0:01:14.39,Caption,,0,0,0,,ПОД КРЫШУ ОДНОГО ГОСУДАРСТВА. ОН ГОВОРИЛ О ГОРАЗДО БОЛЕЕ ШИРОКОМ СБЛИЖЕНИИ,
Dialogue: 0,0:01:14.63,0:01:16.87,Caption,,0,0,0,,В КОТОРОМ ВАЖНЫ СОВМЕСТНЫЕ ДЕЙСТВИЯ,
Dialogue: 0,0:01:17.08,0:01:19.51,Caption,,0,0,0,,А НЕ НОВАЯ ЛИНИЯ НА АДМИНИСТРАТИВНОЙ КАРТЕ.
Dialogue: 0,0:01:20.20,0:01:22.95,Caption,,0,0,0,,И ТУТ НА СЦЕНЕ ПОЯВЛЯЕТСЯ ТАРАС ЧМУТ,
Dialogue: 0,0:01:23.10,0:01:24.71,Caption,,0,0,0,,ИЗВЕСТНЫЙ УКРАИНСКИЙ ВОЛОНТЁР.
Dialogue: 0,0:01:25.35,0:01:26.95,Caption,,0,0,0,,НЕДАВНО ОН ПРЕДЛОЖИЛ СЦЕНАРИЙ,
Dialogue: 0,0:01:27.11,0:01:30.71,Caption,,0,0,0,,КОТОРЫЙ ЗВУЧАЛ ТАК, БУДТО ЕГО ПРИДУМАЛИ ЗА СТОЛОМ ПОСЛЕ ОСОБЕННО
Dialogue: 0,0:01:30.71,0:01:33.59,Caption,,0,0,0,,ТЯЖЁЛОГО РАЗГОВОРА С ЕВРОПЕЙСКИМИ ДРУЗЬЯМИ. ЕСЛИ
Dialogue: 0,0:01:33.59,0:01:36.23,Caption,,0,0,0,,ЕВРОПА ПРИНУДИТ УКРАИНУ СОГЛАСИТЬСЯ НА БОЛЕЗНЕННЫЕ
Dialogue: 0,0:01:36.23,0:01:40.07,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЕ УСТУПКИ, ПОЧЕМУ БЫ КИЕВУ ПОТОМ НЕ ПЕРЕСМОТРЕТЬ КРУГ
Dialogue: 0,0:01:40.15,0:01:42.95,Caption,,0,0,0,,СОЮЗНИКОВ? В ТОМ ЧИСЛЕ НЕ СБЛИЗИТЬСЯ С МОСКВОЙ УЖЕ
Dialogue: 0,0:01:43.03,0:01:47.51,Caption,,0,0,0,,ПРОТИВ САМОЙ ЕВРОПЫ. ПУТИН И ЧМУТ ИСХОДЯТ ИЗ РАЗНЫХ ОБСТОЯТЕЛЬСТВ И
Dialogue: 0,0:01:47.51,0:01:50.63,Caption,,0,0,0,,СТОЯТ НА ПРОТИВОПОЛОЖНЫХ ПОЗИЦИЯХ. ОДНАКО ОБА
Dialogue: 0,0:01:50.63,0:01:54.71,Caption,,0,0,0,,ДОПУСКАЮТ ТО, ЧТО НЕДАВНО СЧИТАЛОСЬ НЕПРИЛИЧНОЙ ФАНТАЗИЕЙ НЫНЕШНЯЯ
Dialogue: 0,0:01:54.71,0:01:57.83,Caption,,0,0,0,,РАССТАНОВКА СТОРОН НЕ ОБЯЗАНА СОХРАНЯТЬСЯ ВЕЧНО.
Dialogue: 0,0:01:58.19,0:01:59.83,Caption,,0,0,0,,ПОСЛЕ ЭТОГО УЖЕ ТРУДНО УТВЕРЖДАТЬ,
Dialogue: 0,0:02:00.15,0:02:02.63,Caption,,0,0,0,,БУДТО ПОДОБНЫЙ ВАРИАНТ ВООБЩЕ НИКОМУ НЕ ПРИХОДИТ В
Dialogue: 0,0:02:02.71,0:02:05.35,Caption,,0,0,0,,ГОЛОВУ. ПРИХОДИТ. ПРОСТО РАНЬШЕ ЗА НЕГО МОГЛИ
Dialogue: 0,0:02:05.35,0:02:07.11,Caption,,0,0,0,,ВЫГНАТЬ ИЗ ПРИЛИЧНОГО РАЗГОВОРА,
Dialogue: 0,0:02:07.35,0:02:10.07,Caption,,0,0,0,,А ТЕПЕРЬ ЕГО ПРОИЗНОСЯТ ВСЛУХ. КАК ВЫ ДУМАЕТЕ,
Dialogue: 0,0:02:10.31,0:02:13.03,Caption,,0,0,0,,МНОГИЕ ЛИ РУССКИЕ И УКРАИНЦЫ РАЗМЫШЛЯЮТ ОБ ЭТОМ
Dialogue: 0,0:02:13.03,0:02:16.31,Caption,,0,0,0,,МОЛЧА? НЕ ЧИНОВНИКИ ПЕРЕД КАМЕРАМИ И НЕ ЛЮДИ,
Dialogue: 0,0:02:16.47,0:02:18.87,Caption,,0,0,0,,У КОТОРЫХ МИКРОФОН ДАВНО СТАЛ ЧАСТЬЮ ЛИЦА.
Dialogue: 0,0:02:21.16,0:02:26.28,Caption,,0,0,0,,ОБЫЧНЫЕ ГРАЖДАНЕ, ПОНИМАЮЩИЕ, ЧТО ОДНО НЕУДАЧНОЕ ПРЕДЛОЖЕНИЕ СПОСОБНО РАССОРИТЬ ИХ
Dialogue: 0,0:02:26.35,0:02:28.60,Caption,,0,0,0,,С ДРУЗЬЯМИ, КОЛЛЕГАМИ И РОДСТВЕННИКАМИ.
Dialogue: 0,0:02:29.16,0:02:30.84,Caption,,0,0,0,,ПУБЛИЧНО ТАКИХ ПОЧТИ НЕ ВИДНО,
Dialogue: 0,0:02:31.07,0:02:33.96,Caption,,0,0,0,,ПОТОМУ ЧТО УМЕНИЕ ВОВРЕМЯ ЗАКРЫТЬ РОТ СТАЛО ПОЛЕЗНЕЕ
Dialogue: 0,0:02:33.96,0:02:38.44,Caption,,0,0,0,,УМЕНИЯ КРАСИВО ГОВОРИТЬ. НО СПОСОБЕН ЛИ КОГДА НИБУДЬ НАСТУПИТЬ МОМЕНТ,
Dialogue: 0,0:02:38.76,0:02:41.40,Caption,,0,0,0,,КОГДА РУССКИЕ И УКРАИНЦЫ СНОВА НАЧНУТ ДЕЙСТВОВАТЬ
Dialogue: 0,0:02:41.40,0:02:44.20,Caption,,0,0,0,,СООБЩА ПРОТИВ УГРОЗЫ, ОПАСНОЙ ДЛЯ ОБОИХ?
Dialogue: 0,0:02:44.41,0:02:47.00,Caption,,0,0,0,,ПОДПИШИСЬ, ЕСЛИ ХОЧЕШЬ ВИДЕТЬ РАЗБОР ЦЕЛИКОМ,
Dialogue: 0,0:02:47.17,0:02:49.88,Caption,,0,0,0,,А НЕ В ПЕРЕСКАЗЕ ПРЕСС СЛУЖБЫ. САМЫЙ БЫСТРЫЙ
Dialogue: 0,0:02:49.96,0:02:52.92,Caption,,0,0,0,,ОТВЕТ ЗВУЧИТ ЖЁСТКО НИКОГДА. ПОГИБЛО СЛИШКОМ МНОГО
Dialogue: 0,0:02:52.92,0:02:55.48,Caption,,0,0,0,,ЛЮДЕЙ, НАКОПЛЕНО СЛИШКОМ МНОГО БОЛИ,
Dialogue: 0,0:02:55.87,0:02:58.28,Caption,,0,0,0,,А НЕНАВИСТИ УЖЕ ХВАТИЛО БЫ НА НЕСКОЛЬКО ПОКОЛЕНИЙ.
Dialogue: 0,0:02:58.67,0:03:03.40,Caption,,0,0,0,,ПОТЕРЯНЫ ЖИЗНИ И ДОВЕРИЕ, ЦЕНА СБЛИЖЕНИЯ КАЖЕТСЯ НЕПОДЪЁМНОЙ. РАЗГОВОР
Dialogue: 0,0:03:03.40,0:03:05.96,Caption,,0,0,0,,ОКОНЧЕН. УДОБНЫЙ ОТВЕТ. КОРОТКИЙ,
Dialogue: 0,0:03:06.05,0:03:09.08,Caption,,0,0,0,,УВЕРЕННЫЙ И СОВЕРШЕННО НЕ ТРЕБУЮЩИЙ ЗНАКОМСТВА С
Dialogue: 0,0:03:09.16,0:03:11.96,Caption,,0,0,0,,ИСТОРИЕЙ. ВО ВРЕМЯ ГРАЖДАНСКОЙ ВОЙНЫ В РОССИИ
Dialogue: 0,0:03:12.03,0:03:14.68,Caption,,0,0,0,,РОДСТВЕННИКИ ОКАЗЫВАЛИСЬ ПО РАЗНЫЕ СТОРОНЫ ФРОНТА.
Dialogue: 0,0:03:14.96,0:03:18.12,Caption,,0,0,0,,БРАТ ВОЕВАЛ ПРОТИВ БРАТА, СЫН ПРОТИВ ОТЦА,
Dialogue: 0,0:03:18.48,0:03:20.84,Caption,,0,0,0,,А СТРАНА БЫЛА РАСКОЛОТА ДО ТАКОЙ СТЕПЕНИ,
Dialogue: 0,0:03:21.00,0:03:23.80,Caption,,0,0,0,,КОТОРУЮ ТРУДНО ПРЕДСТАВИТЬ БЕЗ СПЕЦИАЛЬНОГО УСИЛИЯ.
Dialogue: 0,0:03:24.03,0:03:27.40,Caption,,0,0,0,,КАЗАЛОСЬ, ЧТО ПОСЛЕ ЭТОГО ОБЩЕГО БУДУЩЕГО УЖЕ БЫТЬ НЕ
Dialogue: 0,0:03:27.40,0:03:30.28,Caption,,0,0,0,,МОЖЕТ. НО ПРОШЛО ОКОЛО ДВУХ ДЕСЯТИЛЕТИЙ,
Dialogue: 0,0:03:30.51,0:03:34.84,Caption,,0,0,0,,И ПОЯВИЛАСЬ УГРОЗА, КОТОРОЙ СЕМЕЙНЫЕ СЧЁТЫ БЫЛИ СОВЕРШЕННО БЕЗРАЗЛИЧНЫ.
Dialogue: 0,0:03:37.12,0:03:39.68,Caption,,0,0,0,,НАЦИСТСКАЯ ГЕРМАНИЯ НЕ СОБИРАЛАСЬ РАЗБИРАТЬСЯ,
Dialogue: 0,0:03:39.80,0:03:43.76,Caption,,0,0,0,,ЧЕЙ ДЕД БЫЛ КРАСНЫМ, ЧЕЙ БЕЛЫМ И КТО КОГО ПРОКЛЯЛ ЗА ДОМАШНИМ
Dialogue: 0,0:03:43.76,0:03:46.56,Caption,,0,0,0,,СТОЛОМ. НИКТО НЕ ОБЯЗАН ПОВТОРЯТЬ ПРЕЖНИЙ ПУТЬ ПО
Dialogue: 0,0:03:46.64,0:03:50.64,Caption,,0,0,0,,СТАРЫМ РЕЛЬСАМ. ОДНАКО ПРОШЛОЕ ПОКАЗЫВАЕТ ПРОСТУЮ ВЕЩЬ ВЧЕРАШНИЙ
Dialogue: 0,0:03:50.72,0:03:53.52,Caption,,0,0,0,,ВРАГ НЕ ПОЛУЧАЕТ ПОЖИЗНЕННУЮ ДОЛЖНОСТЬ ВРАГА.
Dialogue: 0,0:03:53.91,0:03:57.12,Caption,,0,0,0,,МЕНЯЮТСЯ ОБСТОЯТЕЛЬСТВА, ВЗРОСЛЕЮТ НОВЫЕ ПОКОЛЕНИЯ,
Dialogue: 0,0:03:57.28,0:04:00.56,Caption,,0,0,0,,ИСЧЕЗАЮТ ПРЕЖНИЕ СОЮЗЫ. ВМЕСТЕ С НИМИ МЕНЯЕТСЯ И
Dialogue: 0,0:04:00.56,0:04:04.72,Caption,,0,0,0,,ПРЕДСТАВЛЕНИЕ О ТОМ, КОГО СЧИТАТЬ СВОИМ. ИСТОРИЯ ВООБЩЕ ЛЮБИТ
Dialogue: 0,0:04:04.72,0:04:06.32,Caption,,0,0,0,,ПЕРЕСТАВЛЯТЬ ТАБЛИЧКИ НА ДВЕРЯХ,
Dialogue: 0,0:04:06.64,0:04:08.64,Caption,,0,0,0,,НЕ СПРАШИВАЯ ЖИЛЬЦОВ, УДОБНО ЛИ ИМ.
Dialogue: 0,0:04:09.44,0:04:13.60,Caption,,0,0,0,,ПУТИН РАЗВИЛ ЭТУ ЛИНИЮ, РАССУЖДАЯ О РАЗНИЦЕ МЕЖДУ ПАТРИОТИЗМОМ И
Dialogue: 0,0:04:13.60,0:04:16.80,Caption,,0,0,0,,НАЦИОНАЛИЗМОМ. ПАТРИОТ ЛЮБИТ СОБСТВЕННУЮ СТРАНУ,
Dialogue: 0,0:04:17.04,0:04:20.32,Caption,,0,0,0,,НАЦИОНАЛИСТ СТРОИТ ОТНОШЕНИЕ К МИРУ НА НЕНАВИСТИ К
Dialogue: 0,0:04:20.32,0:04:23.04,Caption,,0,0,0,,ДРУГИМ НАРОДАМ. А НЕНАВИСТЬ МОЖЕТ ДОЛГО СЛУЖИТЬ
Dialogue: 0,0:04:23.12,0:04:26.72,Caption,,0,0,0,,ТОПЛИВОМ ДЛЯ КРИКА, НО ТАЩИТЬ НА НЕЙ СТРАНУ В БУДУЩЕЕ ПРИМЕРНО
Dialogue: 0,0:04:26.80,0:04:29.28,Caption,,0,0,0,,ТАК ЖЕ УДОБНО, КАК ЕХАТЬ НА АВТОМОБИЛЕ,
Dialogue: 0,0:04:29.52,0:04:32.56,Caption,,0,0,0,,У КОТОРОГО ВМЕСТО КОЛЁС ЧЕТЫРЕ БАРАБАНА. ЗАТЕМ ОН
Dialogue: 0,0:04:32.56,0:04:35.36,Caption,,0,0,0,,ВНОВЬ ОБРАТИЛСЯ К УКРАИНЦАМ И ПРЕДЛОЖИЛ СМОТРЕТЬ
Dialogue: 0,0:04:35.36,0:04:39.76,Caption,,0,0,0,,ДАЛЬШЕ НЫНЕШНЕГО ДНЯ, ДУМАЯ О БУДУЩЕМ ДЕТЕЙ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:04:39.86,0:04:44.72,Caption,,0,0,0,,ЖЕЛАНИЕ ОСТАВАТЬСЯ СИЛЬНЫМИ, ЗНАЧИМЫМИ И СОЗДАВАТЬ НОРМАЛЬНЫЕ УСЛОВИЯ ДЛЯ
Dialogue: 0,0:04:44.72,0:04:47.36,Caption,,0,0,0,,РАЗВИТИЯ НЕИЗБЕЖНО ПРИВОДИТ К НЕОБХОДИМОСТИ
Dialogue: 0,0:04:47.50,0:04:53.31,Caption,,0,0,0,,СОЕДИНЯТЬ УСИЛИЯ. НЕ ДЕЛИТЬ ОДНУ КОМНАТУ И ОДИН ПАСПОРТ,
Dialogue: 0,0:04:53.55,0:04:59.23,Caption,,0,0,0,,А ИСКАТЬ ОБЩЕЕ ДЕЙСТВИЕ ТАМ, ГДЕ ПОРОЗНЬ ОБЕ СТОРОНЫ СТАНОВЯТСЯ СЛАБЕЕ. САМО
Dialogue: 0,0:04:59.31,0:05:02.43,Caption,,0,0,0,,УСТРОЙСТВО ЭТОГО ОБРАЩЕНИЯ МНОГОЕ ПОКАЗЫВАЕТ. ПУТИН
Dialogue: 0,0:05:02.43,0:05:04.75,Caption,,0,0,0,,ГОВОРИТ НЕ ТОЛЬКО С РУКОВОДСТВОМ НА БАНКОВОЙ И
Dialogue: 0,0:05:04.83,0:05:08.67,Caption,,0,0,0,,МИНИСТРАМИ, А ПЫТАЕТСЯ ОБРАТИТЬСЯ К НАСЕЛЕНИЮ ПОВЕРХ ДЕЙСТВУЮЩЕЙ
Dialogue: 0,0:05:08.75,0:05:11.15,Caption,,0,0,0,,УКРАИНСКОЙ ВЛАСТИ. СНАЧАЛА ОБЪЯСНЯЕТ,
Dialogue: 0,0:05:11.32,0:05:15.87,Caption,,0,0,0,,КОМУ ВЫГОДНО ПРОТИВОСТОЯНИЕ, ЗАТЕМ ГОВОРИТ О ДЕТЯХ И ВЫВОДИТ РАЗГОВОР К
Dialogue: 0,0:05:15.87,0:05:18.83,Caption,,0,0,0,,СОВМЕСТНОМУ РАЗВИТИЮ. ЛАВРОВ ТЕМ ВРЕМЕНЕМ ЗАЯВИЛ,
Dialogue: 0,0:05:18.99,0:05:21.23,Caption,,0,0,0,,ЧТО ЮГО ВОСТОЧНЫЕ РЕГИОНЫ УКРАИНЫ,
Dialogue: 0,0:05:21.41,0:05:24.75,Caption,,0,0,0,,ЗНАЧИТЕЛЬНАЯ ЧАСТЬ ЕЁ ЦЕНТРА И КИЕВ ОТНОСЯТСЯ К
Dialogue: 0,0:05:24.75,0:05:27.71,Caption,,0,0,0,,ИСКОННО РУССКИМ ЗЕМЛЯМ. ЗЕЛЕНСКИЙ ОТВЕЧАЕТ С
Dialogue: 0,0:05:27.71,0:05:30.11,Caption,,0,0,0,,ПРОТИВОПОЛОЖНОЙ ПОЗИЦИИ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:05:30.35,0:05:33.07,Caption,,0,0,0,,ЕСЛИ БЫ УКРАИНА СОБИРАЛАСЬ ОТДАТЬ ТЕРРИТОРИИ РОССИИ,
Dialogue: 0,0:05:33.31,0:05:35.47,Caption,,0,0,0,,ОНА СДЕЛАЛА БЫ ЭТО ЕЩЁ В ДВАДЦАТЬ ВТОРОМ
Dialogue: 0,0:05:35.55,0:05:39.15,Caption,,0,0,0,,ГОДУ. ВМЕСТО КАПИТУЛЯЦИИ КИЕВ ВЫБРАЛ СОПРОТИВЛЕНИЕ И
Dialogue: 0,0:05:39.15,0:05:41.07,Caption,,0,0,0,,ПОКАЗАЛ ГОТОВНОСТЬ ЗАЩИЩАТЬ СТРАНУ.
Dialogue: 0,0:05:41.64,0:05:44.19,Caption,,0,0,0,,НО СПОР О ТЕРРИТОРИЯХ УЖЕ ПЕРЕСТАЁТ ВМЕЩАТЬ ВЕСЬ
Dialogue: 0,0:05:44.19,0:05:48.03,Caption,,0,0,0,,РАЗГОВОР. ПУТИН ГОВОРИТ НЕ О НЕМЕДЛЕННОМ СОЗДАНИИ ОБЩЕГО
Dialogue: 0,0:05:48.03,0:05:51.55,Caption,,0,0,0,,ГОСУДАРСТВА, А О СОЕДИНЕНИИ УСИЛИЙ. ЗНАЧИТ,
Dialogue: 0,0:05:51.87,0:05:54.59,Caption,,0,0,0,,ОБСУЖДЕНИЕ БУДУЩЕГО ПОСТЕПЕННО ВЫХОДИТ ЗА ПРЕДЕЛЫ
Dialogue: 0,0:05:54.59,0:05:56.99,Caption,,0,0,0,,ПРИВЫЧНОГО ТОРГА ОБ ОБЛАСТЯХ И ГРАНИЦАХ.
Dialogue: 0,0:05:57.55,0:06:00.11,Caption,,0,0,0,,ВОЗНИКАЕТ ДРУГОЙ ВОПРОС КАКИМИ СТАНУТ ОТНОШЕНИЯ
Dialogue: 0,0:06:00.19,0:06:04.11,Caption,,0,0,0,,РУССКИХ И УКРАИНЦЕВ, КОГДА НЫНЕШНЕЕ ПРОТИВОСТОЯНИЕ ЗАКОНЧИТСЯ?
Dialogue: 0,0:06:04.68,0:06:07.39,Caption,,0,0,0,,ЭТУ ТЕМУ НЕ ЗАКРОЕШЬ ЛИНЕЙКОЙ И ЦВЕТНЫМ КАРАНДАШОМ.
Dialogue: 0,0:06:09.67,0:06:12.47,Caption,,0,0,0,,СВОЁ ОБЪЯСНЕНИЕ УКРАИНСКОГО КРИЗИСА ПУТИН ТОЖЕ
Dialogue: 0,0:06:12.47,0:06:15.43,Caption,,0,0,0,,НАЧИНАЕТ НЕ С ПОСЛЕДНИХ РОССИЙСКИХ УДАРОВ. ПО ЕГО
Dialogue: 0,0:06:15.43,0:06:18.55,Caption,,0,0,0,,ВЕРСИИ, РАЗРУШЕНИЕ СТРАНЫ ЗАПУСТИЛИ ПРОЦЕССЫ,
Dialogue: 0,0:06:18.79,0:06:22.07,Caption,,0,0,0,,НАЧАВШИЕСЯ ПОСЛЕ РАСПАДА СОВЕТСКОГО СОЮЗА. ОН
Dialogue: 0,0:06:22.15,0:06:25.99,Caption,,0,0,0,,НАЗЫВАЕТ СУДОСТРОИТЕЛЬНУЮ, АВИАЦИОННУЮ И РАКЕТНУЮ ОТРАСЛИ,
Dialogue: 0,0:06:26.36,0:06:29.27,Caption,,0,0,0,,КОТОРЫЕ УКРАИНА ПОСТЕПЕННО УТРАТИЛА. НАПОМИНАЕТ,
Dialogue: 0,0:06:29.46,0:06:32.39,Caption,,0,0,0,,ЧТО НАСЕЛЕНИЕ УМЕНЬШИЛОСЬ ПРИМЕРНО С ПЯТИДЕСЯТИ ДВУХ
Dialogue: 0,0:06:32.39,0:06:35.59,Caption,,0,0,0,,МИЛЛИОНОВ ДО ДВАДЦАТИ МИЛЛИОНОВ. И ПОДЧЁРКИВАЕТ,
Dialogue: 0,0:06:35.90,0:06:38.95,Caption,,0,0,0,,ЧТО ЭТОТ ОБВАЛ ПРОИЗОШЁЛ ЗАДОЛГО ДО ОТВЕТНЫХ УДАРОВ
Dialogue: 0,0:06:38.96,0:06:43.35,Caption,,0,0,0,,РОССИЙСКИХ РАКЕТНЫХ ВОЙСК. ГЛАВНУЮ ОТВЕТСТВЕННОСТЬ ЗА ПРОИЗОШЕДШЕЕ ПУТИН
Dialogue: 0,0:06:43.35,0:06:45.59,Caption,,0,0,0,,ВОЗЛАГАЕТ НА УКРАИНСКИХ НАЦИОНАЛИСТОВ.
Dialogue: 0,0:06:46.45,0:06:49.43,Caption,,0,0,0,,У ЗЕЛЕНСКОГО КАРТИНА ПОЛНОСТЬЮ ОБРАТНАЯ. ОН ОБЪЯВИЛ,
Dialogue: 0,0:06:49.74,0:06:52.15,Caption,,0,0,0,,ЧТО РОССИЯ ПРОИГРАЛА ДВАДЦАТЬ ШЕСТОЙ ГОД НА ПОЛЕ
Dialogue: 0,0:06:52.15,0:06:55.75,Caption,,0,0,0,,БОЯ, А ТЕПЕРЬ ПЫТАЕТСЯ ВОСПОЛНИТЬ НЕУДАЧУ БАЛЛИСТИЧЕСКИМИ
Dialogue: 0,0:06:55.83,0:06:58.31,Caption,,0,0,0,,УДАРАМИ ПО МИРНОМУ НАСЕЛЕНИЮ. НА ФОНЕ УДАРА ПО
Dialogue: 0,0:06:58.31,0:07:01.11,Caption,,0,0,0,,МОСТУ И НОВЫХ КРУПНЫХ ПОСТУПЛЕНИЙ ОТ ПАРТНЁРОВ КИЕВА
Dialogue: 0,0:07:01.11,0:07:03.19,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ГОВОРИЛ О НЕЧЕСТНЫХ ПРАВИЛАХ,
Dialogue: 0,0:07:03.60,0:07:05.99,Caption,,0,0,0,,НАЗЫВАЛ ВОЙНУ БЕСПЕРСПЕКТИВНОЙ ДЛЯ МОСКВЫ,
Dialogue: 0,0:07:06.31,0:07:09.03,Caption,,0,0,0,,ОБВИНЯЛ РОССИЮ В РАСКОЛЕ ЕВРОПЫ И ПРЕДСТАВЛЯЛ
Dialogue: 0,0:07:09.03,0:07:11.83,Caption,,0,0,0,,ВСТРЕЧУ КОАЛИЦИИ ЖЕЛАЮЩИХ КАК НАГЛЯДНОЕ
Dialogue: 0,0:07:11.83,0:07:13.59,Caption,,0,0,0,,ДОКАЗАТЕЛЬСТВО ПОРАЖЕНИЯ ПУТИНА.
Dialogue: 0,0:07:14.16,0:07:16.55,Caption,,0,0,0,,ЕСТЬ В ЭТОЙ УВЕРЕННОСТИ ОДНА НЕУДОБНАЯ ДЕТАЛЬ.
Dialogue: 0,0:07:16.95,0:07:18.71,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ОДНОВРЕМЕННО ПРИЗНАЁТ,
Dialogue: 0,0:07:19.03,0:07:21.83,Caption,,0,0,0,,ЧТО СОДЕРЖАНИЕ РАЗГОВОРА ПУТИНА С ТРАМПОМ ЕМУ
Dialogue: 0,0:07:21.83,0:07:25.63,Caption,,0,0,0,,НЕИЗВЕСТНО. ОН ПРЯМО ГОВОРИТ,
Dialogue: 0,0:07:25.96,0:07:30.35,Caption,,0,0,0,,ЧТО КИЕВ НЕ ЗНАЕТ, О ЧЁМ БЕСЕДОВАЛИ ДВА ПРЕЗИДЕНТА. ПРИ ЭТОМ УКРАИНСКИЙ
Dialogue: 0,0:07:30.35,0:07:32.99,Caption,,0,0,0,,ЛИДЕР ПЕРЕДАЁТ ЖЕЛАНИЕ ТРАМПА ЗАВЕРШИТЬ БОЕВЫЕ
Dialogue: 0,0:07:32.99,0:07:36.19,Caption,,0,0,0,,ДЕЙСТВИЯ И ТУТ ЖЕ НАПОМИНАЕТ О НЕОБХОДИМОСТИ СИЛЬНОЙ
Dialogue: 0,0:07:36.27,0:07:39.47,Caption,,0,0,0,,ЕВРОПЫ. НА ТАКОМ ФОНЕ ПРЕДПОЛОЖЕНИЕ О БУДУЩЕЙ СМЕНЕ
Dialogue: 0,0:07:39.55,0:07:42.11,Caption,,0,0,0,,СОЮЗОВ ВЫГЛЯДИТ УЖЕ НЕ ШУТКОЙ ИЗ ДАЛЬНЕГО УГЛА
Dialogue: 0,0:07:42.19,0:07:44.99,Caption,,0,0,0,,ИНТЕРНЕТА. НЫНЕШНИЕ ПАРТНЁРЫ МОГУТ ПОТОМ ВЫСТАВИТЬ
Dialogue: 0,0:07:44.99,0:07:48.75,Caption,,0,0,0,,УСЛОВИЯ, КОТОРЫЕ КИЕВ СОЧТЁТ НЕПРИЕМЛЕМЫМИ. ТЕ,
Dialogue: 0,0:07:48.90,0:07:51.31,Caption,,0,0,0,,КОГО СЕЙЧАС НАЗЫВАЮТ ВЕЧНЫМИ ПРОТИВНИКАМИ,
Dialogue: 0,0:07:51.55,0:07:54.59,Caption,,0,0,0,,МОГУТ ОБНАРУЖИТЬ ОБЩИЙ ИНТЕРЕС. ВЕЧНОСТЬ В
Dialogue: 0,0:07:54.67,0:07:56.91,Caption,,0,0,0,,МЕЖДУНАРОДНЫХ ДЕЛАХ ВООБЩЕ ДЛИТСЯ РОВНО ДО
Dialogue: 0,0:07:56.99,0:08:02.03,Caption,,0,0,0,,СЛЕДУЮЩЕГО СЕРЬЁЗНОГО СЧЁТА. ИЗ РОССИИ ПРИХОДИТ ЕЩЁ ОДИН ПРИМЕЧАТЕЛЬНЫЙ СИГНАЛ.
Dialogue: 0,0:08:02.44,0:08:04.67,Caption,,0,0,0,,СМИ СООБЩИЛИ О ЗАКРЫТОМ СЕМИНАРЕ,
Dialogue: 0,0:08:04.99,0:08:07.47,Caption,,0,0,0,,НА КОТОРОМ ДЕПУТАТАМ ГОСУДАРСТВЕННОЙ ДУМЫ ПОРУЧИЛИ
Dialogue: 0,0:08:07.47,0:08:10.43,Caption,,0,0,0,,ЗАРАНЕЕ ГОТОВИТЬСЯ К ЗАВЕРШЕНИЮ СПЕЦИАЛЬНОЙ ВОЕННОЙ
Dialogue: 0,0:08:10.43,0:08:13.95,Caption,,0,0,0,,ОПЕРАЦИИ И ВОЗВРАЩЕНИЮ ВОЕННОСЛУЖАЩИХ. ИМ ПРЕДЛОЖИЛИ
Dialogue: 0,0:08:13.95,0:08:16.67,Caption,,0,0,0,,АКТИВНЕЕ РАБОТАТЬ С ВЕТЕРАНАМИ И НАСЕЛЕНИЕМ,
Dialogue: 0,0:08:16.91,0:08:21.47,Caption,,0,0,0,,ДУМАТЬ О ПОБЕДЕ И О МОМЕНТЕ, КОГДА БОЛЬШОЕ ЧИСЛО ФРОНТОВИКОВ ОДНОВРЕМЕННО
Dialogue: 0,0:08:21.47,0:08:25.23,Caption,,0,0,0,,ВЕРНЁТСЯ ДОМОЙ. САМ ФАКТ ТАКОГО РАЗГОВОРА ПОКАЗЫВАЕТ,
Dialogue: 0,0:08:25.44,0:08:27.71,Caption,,0,0,0,,ЧТО АППАРАТ НАЧИНАЮТ НАСТРАИВАТЬ НЕ ТОЛЬКО НА
Dialogue: 0,0:08:27.71,0:08:34.32,Caption,,0,0,0,,ПРОДОЛЖЕНИЕ БОЕВЫХ ДЕЙСТВИЙ. ЧИНОВНИКАМ ПРЕДЛАГАЮТ ЗАРАНЕЕ ПРЕДСТАВИТЬ СЛЕДУЮЩИЙ
Dialogue: 0,0:08:34.40,0:08:38.08,Caption,,0,0,0,,ЭТАП, КОГДА ПРИВЫЧНАЯ ВОЕННАЯ ПОВЕСТКА СМЕНИТСЯ ТЫСЯЧАМИ
Dialogue: 0,0:08:38.08,0:08:40.24,Caption,,0,0,0,,КОНКРЕТНЫХ ЛЮДЕЙ С ОПЫТОМ ФРОНТА,
Dialogue: 0,0:08:40.45,0:08:43.92,Caption,,0,0,0,,ВОПРОСАМИ И ОЖИДАНИЯМИ. ЭТО УЖЕ НЕ РАССУЖДЕНИЕ О
Dialogue: 0,0:08:43.92,0:08:46.64,Caption,,0,0,0,,ДАЛЁКОМ КОГДА НИБУДЬ. ДЕПУТАТАМ НАПОМИНАЮТ,
Dialogue: 0,0:08:46.86,0:08:49.20,Caption,,0,0,0,,ЧТО ОДНАЖДЫ ИЗ ОКОПОВ ПРИДУТ ИЗБИРАТЕЛИ,
Dialogue: 0,0:08:49.49,0:08:52.08,Caption,,0,0,0,,И ЛИСТОВКОЙ ВОЗЛЕ ПОДЪЕЗДА ОТ НИХ НЕ ОТДЕЛАЕШЬСЯ.
Dialogue: 0,0:08:52.28,0:08:55.68,Caption,,0,0,0,,В РОССИИ ДЕПУТАТАМ, СУДЯ ПО ОПУБЛИКОВАННОЙ ИНФОРМАЦИИ,
Dialogue: 0,0:08:55.92,0:08:58.80,Caption,,0,0,0,,ВЕЛЯТ ЗАРАНЕЕ УЧИТЬСЯ ВЗАИМОДЕЙСТВОВАТЬ С ВЕТЕРАНАМИ
Dialogue: 0,0:08:59.04,0:09:01.84,Caption,,0,0,0,,И ГОТОВИТЬСЯ К ИЗМЕНИВШЕЙСЯ ОБЩЕСТВЕННОЙ РЕАЛЬНОСТИ.
Dialogue: 0,0:09:02.31,0:09:04.72,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ РАССМАТРИВАЕТСЯ КАК ЗАДАЧА,
Dialogue: 0,0:09:04.96,0:09:06.64,Caption,,0,0,0,,КОТОРУЮ НУЖНО ВСТРЕТИТЬ РАБОТОЙ,
Dialogue: 0,0:09:06.80,0:09:09.36,Caption,,0,0,0,,А НЕ УДИВЛЁННЫМ ЛИЦОМ В ДЕНЬ ПРИБЫТИЯ ПОЕЗДОВ.
Dialogue: 0,0:09:09.88,0:09:12.56,Caption,,0,0,0,,НА УКРАИНЕ ЧАСТЬ ПРЕДСТАВИТЕЛЕЙ ВЛАСТИ ТРЕВОЖАТ НЕ
Dialogue: 0,0:09:12.64,0:09:15.84,Caption,,0,0,0,,ТОЛЬКО БУДУЩИЕ РАСХОДЫ. ИХ ПУГАЮТ САМИ ФРОНТОВИКИ,
Dialogue: 0,0:09:16.08,0:09:18.64,Caption,,0,0,0,,КОТОРЫЕ ВЕРНУТСЯ С ТЯЖЁЛЫМИ ВОПРОСАМИ К ЛЮДЯМ,
Dialogue: 0,0:09:18.80,0:09:21.92,Caption,,0,0,0,,ГОДАМИ НАБЛЮДАВШИМ ВОЙНУ ИЗ БЕЗОПАСНЫХ КАБИНЕТОВ.
Dialogue: 0,0:09:22.60,0:09:25.04,Caption,,0,0,0,,У ВЕРНУВШЕГОСЯ СОЛДАТА МОЖЕТ ПОЯВИТЬСЯ ЖЕЛАНИЕ
Dialogue: 0,0:09:25.04,0:09:30.32,Caption,,0,0,0,,УЗНАТЬ, КТО ПРИНИМАЛ РЕШЕНИЯ, КТО ЗА НИХ ОТВЕЧАЛ И ПОЧЕМУ НЕКОТОРЫЕ ПАТРИОТЫ
Dialogue: 0,0:09:30.40,0:09:32.88,Caption,,0,0,0,,ВСЁ ЭТО ВРЕМЯ ВОЕВАЛИ ИСКЛЮЧИТЕЛЬНО В ТЕЛЕВИЗОРЕ.
Dialogue: 0,0:09:33.13,0:09:35.68,Caption,,0,0,0,,ПОДПИШИСЬ, ЕСЛИ ТЕБЕ НУЖЕН ПОЛНЫЙ РАЗБОР,
Dialogue: 0,0:09:35.84,0:09:37.76,Caption,,0,0,0,,А НЕ ВЕРСИЯ СОБЫТИЙ ОТ ПРЕСС СЛУЖБЫ.
Dialogue: 0,0:09:40.04,0:09:42.68,Caption,,0,0,0,,А ЖИТЬ СРЕДИ ПОСЛЕДСТВИЙ ВСЕХ ЭТИХ РЕШЕНИЙ ПРИДЁТСЯ
Dialogue: 0,0:09:42.68,0:09:46.84,Caption,,0,0,0,,МИЛЛИОНАМ ЛЮДЕЙ, КОТОРЫЕ НЕ УЧАСТВУЮТ В ЗАКРЫТЫХ ПЕРЕГОВОРАХ И НЕ
Dialogue: 0,0:09:46.84,0:09:49.96,Caption,,0,0,0,,ВЫБИРАЮТ ФОРМУЛИРОВКИ ДЛЯ ЗАЯВЛЕНИЙ. ПОЛИТИКИ МЕНЯЮТ
Dialogue: 0,0:09:50.04,0:09:52.60,Caption,,0,0,0,,СХЕМЫ, СОЮЗНИКИ ПЕРЕСЧИТЫВАЮТ ВЫГОДУ,
Dialogue: 0,0:09:52.89,0:09:56.12,Caption,,0,0,0,,АРМИИ ДВИГАЮТ ЛИНИЮ ФРОНТА. ПОТОМ ОБЫЧНЫМ СЕМЬЯМ
Dialogue: 0,0:09:56.20,0:09:58.04,Caption,,0,0,0,,ВРУЧАТ ИТОГОВЫЙ СЧЁТ И СООБЩАТ,
Dialogue: 0,0:09:58.19,0:10:02.84,Caption,,0,0,0,,ЧТО УЖИН БЫЛ ПРЕКРАСНЫМ. НЕУЖЕЛИ РУССКИЕ И УКРАИНЦЫ БОЛЬШЕ НИКОГДА НЕ
Dialogue: 0,0:10:02.84,0:10:06.28,Caption,,0,0,0,,ОКАЖУТСЯ ПЕРЕД ОБЩЕЙ УГРОЗОЙ? НЕ СМОГУТ РАБОТАТЬ ВМЕСТЕ,
Dialogue: 0,0:10:06.67,0:10:09.40,Caption,,0,0,0,,НЕ НАЙДУТ СОВПАДАЮЩЕГО ИНТЕРЕСА И НАВСЕГДА ОСТАНУТСЯ
Dialogue: 0,0:10:09.48,0:10:11.48,Caption,,0,0,0,,ПО РАЗНЫЕ СТОРОНЫ ЛЮБОГО ВОПРОСА?
Dialogue: 0,0:10:12.37,0:10:15.08,Caption,,0,0,0,,СЕЙЧАС СОВМЕСТНОЕ БУДУЩЕЕ КАЖЕТСЯ ОГРОМНОМУ ЧИСЛУ
Dialogue: 0,0:10:15.08,0:10:18.04,Caption,,0,0,0,,ЛЮДЕЙ НЕВОЗМОЖНЫМ. НО СОВСЕМ НЕДАВНО НЕВОЗМОЖНЫМ
Dialogue: 0,0:10:18.04,0:10:21.00,Caption,,0,0,0,,СЧИТАЛОСЬ ДАЖЕ ПУБЛИЧНОЕ ОБСУЖДЕНИЕ ТАКОГО ПОВОРОТА.
Dialogue: 0,0:10:21.40,0:10:23.16,Caption,,0,0,0,,ТЕПЕРЬ О НЁМ ГОВОРЯТ И В РОССИИ,
