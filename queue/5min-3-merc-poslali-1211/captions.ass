Dialogue: 0,0:00:00.12,0:00:04.12,Caption,,0,0,0,,ФРИДРИХ МЕРЦ РЕШИЛ, ЧТО С РОССИЕЙ НАДО РАЗГОВАРИВАТЬ С ПОЗИЦИИ СИЛЫ.
Dialogue: 0,0:00:04.33,0:00:07.24,Caption,,0,0,0,,ХОРОШО. ГЕРМАНИЯ ВООБЩЕ СТРАНА С БОГАТЫМ ОПЫТОМ
Dialogue: 0,0:00:07.24,0:00:11.24,Caption,,0,0,0,,ТАКИХ РАЗГОВОРОВ. ПРАВДА, ФИНАЛ ТАМ КАЖДЫЙ РАЗ КАК ТО ПОРТИТ ВСЮ
Dialogue: 0,0:00:11.24,0:00:14.20,Caption,,0,0,0,,КРАСИВУЮ ТЕОРИЮ. ПОЭТОМУ Я БЫ НА МЕСТЕ ФРИДРИХА
Dialogue: 0,0:00:14.28,0:00:16.92,Caption,,0,0,0,,СНАЧАЛА ПОЛИСТАЛ СЕМЕЙНЫЙ АЛЬБОМ. ВДРУГ ТАМ КТО
Dialogue: 0,0:00:16.92,0:00:19.32,Caption,,0,0,0,,НИБУДЬ УЖЕ ПРОХОДИЛ ЭТОТ КУРС И ДАЖЕ ЗНАЕТ,
Dialogue: 0,0:00:19.48,0:00:21.96,Caption,,0,0,0,,ЧЕМ ОН ЗАКАНЧИВАЕТСЯ? ЕСЛИ ВАМ НРАВИТСЯ,
Dialogue: 0,0:00:22.07,0:00:24.52,Caption,,0,0,0,,КОГДА ЗА ГРОМКИМИ ЗАЯВЛЕНИЯМИ МЫ СМОТРИМ ЕЩЁ И
Dialogue: 0,0:00:24.52,0:00:26.68,Caption,,0,0,0,,НА ТО, ЧТО ПРОИСХОДИТ ВОКРУГ НИХ,
Dialogue: 0,0:00:26.89,0:00:29.24,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:29.52,0:00:32.12,Caption,,0,0,0,,КОГДА ВОКРУГ ОДНОГО ЗАЯВЛЕНИЯ НАЧИНАЕТ СОБИРАТЬСЯ
Dialogue: 0,0:00:32.13,0:00:35.16,Caption,,0,0,0,,ОЧЕНЬ ЛЮБОПЫТНАЯ КОМПАНИЯ. И ВЕДЬ МЕРЦ ЭТО СКАЗАЛ
Dialogue: 0,0:00:35.16,0:00:38.20,Caption,,0,0,0,,СОВЕРШЕННО СЕРЬЁЗНО. РОССИЯ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:00:38.36,0:00:41.32,Caption,,0,0,0,,ПО ПРЕЖНЕМУ ПОНИМАЕТ ТОЛЬКО ЯЗЫК СИЛЫ. ПОЭТОМУ
Dialogue: 0,0:00:41.40,0:00:44.68,Caption,,0,0,0,,ЕВРОПА ДОЛЖНА БЫТЬ ЕДИНОЙ, ПРОДОЛЖАТЬ ДАВИТЬ НА МОСКВУ,
Dialogue: 0,0:00:44.92,0:00:47.48,Caption,,0,0,0,,ПОДДЕРЖИВАТЬ УКРАИНУ И ОДНОВРЕМЕННО ГОТОВИТЬСЯ К
Dialogue: 0,0:00:47.48,0:00:49.24,Caption,,0,0,0,,СЕРЬЁЗНЫМ ПЕРЕГОВОРАМ. ФРИДРИХ,
Dialogue: 0,0:00:49.72,0:00:52.52,Caption,,0,0,0,,ТУТ МАЛЕНЬКИЙ ИСТОРИЧЕСКИЙ НЮАНС. С РОССИЕЙ УЖЕ
Dialogue: 0,0:00:52.60,0:00:55.48,Caption,,0,0,0,,ПЫТАЛИСЬ РАЗГОВАРИВАТЬ ТАКИМ ЯЗЫКОМ. ПРИЧЁМ НЕ ГДЕ
Dialogue: 0,0:00:55.56,0:01:00.04,Caption,,0,0,0,,ТО НА ДРУГОМ КОНЦЕ ПЛАНЕТЫ, А ИМЕННО ИЗ БЕРЛИНА. ЗАКОНЧИЛОСЬ ЭТО НЕ СОВСЕМ
Dialogue: 0,0:01:00.04,0:01:03.08,Caption,,0,0,0,,ТАК, КАК РАССЧИТЫВАЛИ АВТОРЫ РАЗГОВОРА. И ШУТКА ПРО
Dialogue: 0,0:01:03.08,0:01:06.04,Caption,,0,0,0,,ДЕДУШКУ ЗДЕСЬ НЕ СОВСЕМ ВЗЯЛАСЬ С ПОТОЛКА. ДЕД
Dialogue: 0,0:01:06.12,0:01:08.52,Caption,,0,0,0,,МЕРЦА ПО МАТЕРИНСКОЙ ЛИНИИ ДЕЙСТВИТЕЛЬНО ЖИЛ В ТУ
Dialogue: 0,0:01:08.52,0:01:12.88,Caption,,0,0,0,,ЭПОХУ И СОСТОЯЛ В НСДАП. ЭТО,
Dialogue: 0,0:01:13.02,0:01:16.48,Caption,,0,0,0,,РАЗУМЕЕТСЯ, НИЧЕГО НЕ ГОВОРИТ О ПОЛИТИЧЕСКИХ ВЗГЛЯДАХ САМОГО
Dialogue: 0,0:01:16.48,0:01:19.68,Caption,,0,0,0,,МЕРЦА. ВНУКИ ЗА ДЕДОВ НЕ ОТВЕЧАЮТ. НО КОГДА
Dialogue: 0,0:01:19.68,0:01:22.16,Caption,,0,0,0,,НЕМЕЦКИЙ КАНЦЛЕР НАЧИНАЕТ РАССУЖДАТЬ О ТОМ,
Dialogue: 0,0:01:22.40,0:01:25.04,Caption,,0,0,0,,КАКИМ ИМЕННО ЯЗЫКОМ СИЛЫ НАДО РАЗГОВАРИВАТЬ С
Dialogue: 0,0:01:25.04,0:01:28.64,Caption,,0,0,0,,РОССИЕЙ, ИСТОРИЧЕСКАЯ ПАМЯТЬ САМА КАК ТО ПРОСИТСЯ В КОМНАТУ.
Dialogue: 0,0:01:28.96,0:01:31.68,Caption,,0,0,0,,ТЕМ БОЛЕЕ ЧТО ДАЛЬШЕ НАЧИНАЕТСЯ ЕЩЁ ИНТЕРЕСНЕЕ.
Dialogue: 0,0:01:31.87,0:01:34.48,Caption,,0,0,0,,ПОТОМУ ЧТО ДЛЯ НАЧАЛА МЕРЦ РЕШИЛ ПОКАЗАТЬ СИЛУ
Dialogue: 0,0:01:34.56,0:01:38.40,Caption,,0,0,0,,НЕ РОССИИ, А СОБСТВЕННЫМ ПАРТНЁРАМ ПО ЕВРОСОЮЗУ. ГЕРМАНИЯ
Dialogue: 0,0:01:38.40,0:01:41.60,Caption,,0,0,0,,ПРЕДЛАГАЕТ, ЧТОБЫ ВСЕ СТРАНЫ ЕВРОСОЮЗА УЧАСТВОВАЛИ В
Dialogue: 0,0:01:41.60,0:01:44.40,Caption,,0,0,0,,ФИНАНСИРОВАНИИ УКРАИНЫ. НА СЛЕДУЮЩИЙ ГОД У КИЕВА
Dialogue: 0,0:01:44.40,0:01:46.80,Caption,,0,0,0,,ПРОГНОЗИРУЮТ ОГРОМНУЮ ФИНАНСОВУЮ ДЫРУ,
Dialogue: 0,0:01:47.04,0:01:51.04,Caption,,0,0,0,,И БЕРЛИН ХОЧЕТ, ЧТОБЫ ЕВРОПЕЙЦЫ ДРУЖНО ПОЛЕЗЛИ В КАРМАНЫ. А ВОТ
Dialogue: 0,0:01:51.04,0:01:54.24,Caption,,0,0,0,,ДРУЖНО НЕ ПОЛУЧИЛОСЬ. РОБЕРТ ФИЦО УСЛЫШАЛ НЕМЕЦКУЮ
Dialogue: 0,0:01:54.24,0:01:57.12,Caption,,0,0,0,,РЕШИТЕЛЬНОСТЬ И НАЗВАЛ ЭТО ШАНТАЖОМ. СЛОВАКИЯ УЖЕ
Dialogue: 0,0:01:57.12,0:02:00.24,Caption,,0,0,0,,ЗАЯВЛЯЕТ, ЧТО УЧАСТВОВАТЬ В НОВОМ КРЕДИТЕ УКРАИНЕ НЕ
Dialogue: 0,0:02:00.24,0:02:03.36,Caption,,0,0,0,,СОБИРАЕТСЯ. И ФИЦО СОВЕРШЕННО СПОКОЙНО НАПОМИНАЕТ
Dialogue: 0,0:02:03.44,0:02:06.48,Caption,,0,0,0,,БЕРЛИНУ ОДНУ ПРОСТУЮ ВЕЩЬ. У ГЕРМАНИИ ЕСТЬ ГОЛОС.
Dialogue: 0,0:02:06.72,0:02:09.52,Caption,,0,0,0,,У СЛОВАКИИ ТОЖЕ ЕСТЬ ГОЛОС. А СЕМИЛЕТНИЙ БЮДЖЕТ
Dialogue: 0,0:02:09.52,0:02:12.56,Caption,,0,0,0,,ЕВРОСОЮЗА НАДО ЕЩЁ ПРИНЯТЬ. ЧЕХИЯ ТОЖЕ НЕ СПЕШИТ
Dialogue: 0,0:02:12.56,0:02:15.04,Caption,,0,0,0,,ВСТАВАТЬ ПО СТОЙКЕ СМИРНО. АНДРЕЙ БАБИШ
Dialogue: 0,0:02:15.04,0:02:18.72,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ, ЧТО ЕСЛИ НАЧНУТ БЛОКИРОВАТЬ ЕВРОПЕЙСКИЙ БЮДЖЕТ РАДИ
Dialogue: 0,0:02:18.80,0:02:23.28,Caption,,0,0,0,,ДАВЛЕНИЯ НА НЕСОГЛАСНЫХ, ТО ЗАБЛОКИРОВАННЫМИ ОКАЖУТСЯ В ТОМ ЧИСЛЕ И ДЕНЬГИ,
Dialogue: 0,0:02:23.52,0:02:25.68,Caption,,0,0,0,,КОТОРЫЕ СОБИРАЛИСЬ НАПРАВЛЯТЬ САМОЙ УКРАИНЕ.
Dialogue: 0,0:02:27.95,0:02:30.27,Caption,,0,0,0,,ВОТ ВАМ И ЕДИНАЯ ЕВРОПА С ПОЗИЦИИ СИЛЫ.
Dialogue: 0,0:02:30.67,0:02:33.39,Caption,,0,0,0,,ПОКА РОССИЯ ДОЛЖНА ИСПУГАТЬСЯ ЕВРОПЕЙСКОГО ЕДИНСТВА,
Dialogue: 0,0:02:33.63,0:02:35.55,Caption,,0,0,0,,ЕВРОПЕЙЦЫ ВЫЯСНЯЮТ МЕЖДУ СОБОЙ,
Dialogue: 0,0:02:35.68,0:02:38.11,Caption,,0,0,0,,КТО КОМУ ЧЕГО ДОЛЖЕН И КТО ВООБЩЕ ИМЕЕТ
Dialogue: 0,0:02:38.11,0:02:40.99,Caption,,0,0,0,,ПРАВО ЗАСТАВЛЯТЬ ОСТАЛЬНЫХ ПЛАТИТЬ. И МЕРЦ ЗДЕСЬ
Dialogue: 0,0:02:40.99,0:02:45.63,Caption,,0,0,0,,ПРЕДСТАВЛЯЕТ ТУ ЧАСТЬ ЕВРОПЫ, КОТОРАЯ ОТСТУПАТЬ НЕ СОБИРАЕТСЯ. НИ ШАГУ НАЗАД.
Dialogue: 0,0:02:45.93,0:02:48.83,Caption,,0,0,0,,ДАВЛЕНИЕ ПРОДОЛЖАТЬ. ФИНАНСИРОВАНИЕ ПРОДОЛЖАТЬ.
Dialogue: 0,0:02:48.99,0:02:52.19,Caption,,0,0,0,,ВОЕННУЮ ПОДДЕРЖКУ ПРОДОЛЖАТЬ. А ЕСЛИ КТО ТО ВНУТРИ
Dialogue: 0,0:02:52.19,0:02:56.27,Caption,,0,0,0,,КЛУБА НЕ СОГЛАСЕН, СНАЧАЛА ПОПРОБУЕМ ОБЪЯСНИТЬ ЕМУ ЕВРОПЕЙСКИЕ ЦЕННОСТИ
Dialogue: 0,0:02:56.27,0:02:59.55,Caption,,0,0,0,,ЧЕРЕЗ БЮДЖЕТ. РЕШИТЕЛЬНАЯ РЕШИМОСТЬ. НО ДАЛЬШЕ ЭТА
Dialogue: 0,0:02:59.55,0:03:01.95,Caption,,0,0,0,,РЕШИМОСТЬ ВЫХОДИТ УЖЕ НЕПОСРЕДСТВЕННО К РОССИЙСКОЙ
Dialogue: 0,0:03:01.95,0:03:04.43,Caption,,0,0,0,,ГРАНИЦЕ. СЕРГЕЙ РЯБКОВ ПРЕДУПРЕДИЛ,
Dialogue: 0,0:03:04.67,0:03:07.31,Caption,,0,0,0,,ЧТО МОСКВЕ ИЗВЕСТНЫ РАЗГОВОРЫ И ПРЕДПОЛАГАЕМЫЕ
Dialogue: 0,0:03:07.31,0:03:10.35,Caption,,0,0,0,,ПЛАНЫ, СВЯЗАННЫЕ С БЛОКАДОЙ КАЛИНИНГРАДСКОЙ ОБЛАСТИ.
Dialogue: 0,0:03:10.74,0:03:13.47,Caption,,0,0,0,,ФОРМУЛИРОВКУ ОН ВЫБРАЛ ПРЕДЕЛЬНО КОРОТКУЮ. ПОПЫТКА
Dialogue: 0,0:03:13.47,0:03:16.11,Caption,,0,0,0,,ПРАКТИЧЕСКИ РЕАЛИЗОВАТЬ ПОДОБНЫЙ СЦЕНАРИЙ СТАНЕТ
Dialogue: 0,0:03:16.11,0:03:20.99,Caption,,0,0,0,,ПРЯМЫМ ПУТЁМ К КАТАСТРОФЕ. ВОТ ЗДЕСЬ СЛОВА ПРО ПОЗИЦИЮ СИЛЫ НАЧИНАЮТ ЗВУЧАТЬ
Dialogue: 0,0:03:20.99,0:03:23.95,Caption,,0,0,0,,УЖЕ СОВСЕМ НЕ КАК ПРЕСС КОНФЕРЕНЦИЯ. КАЛИНИНГРАД НЕ
Dialogue: 0,0:03:23.95,0:03:26.51,Caption,,0,0,0,,НАХОДИТСЯ ГДЕ ТО ДАЛЕКО В РОССИЙСКОМ ТЫЛУ. ОН
Dialogue: 0,0:03:26.59,0:03:29.63,Caption,,0,0,0,,ЗАЖАТ МЕЖДУ ПОЛЬШЕЙ И ЛИТВОЙ. ПОЭТОМУ ЛЮБОЕ РЕАЛЬНОЕ
Dialogue: 0,0:03:29.63,0:03:31.87,Caption,,0,0,0,,ДВИЖЕНИЕ ВОКРУГ НЕГО ОЧЕНЬ БЫСТРО СТАНОВИТСЯ
Dialogue: 0,0:03:31.87,0:03:36.11,Caption,,0,0,0,,ВОПРОСОМ УЖЕ НЕ УКРАИНЫ, А ПРЯМОГО СОПРИКОСНОВЕНИЯ РОССИИ И СТРАН НАТО.
Dialogue: 0,0:03:36.38,0:03:38.51,Caption,,0,0,0,,ПОЛЬША ОДНА. ПОЛЬСКАЯ АРМИЯ ОДНА.
Dialogue: 0,0:03:40.76,0:03:43.82,Caption,,0,0,0,,ПРОСТО НАПРАВЛЕНИЯ РАЗНЫЕ. УКРАИНА ОДНО НАПРАВЛЕНИЕ.
Dialogue: 0,0:03:43.97,0:03:47.10,Caption,,0,0,0,,КАЛИНИНГРАД ДРУГОЕ. И КОГДА НА ОДНОМ НАПРАВЛЕНИИ
Dialogue: 0,0:03:47.18,0:03:51.18,Caption,,0,0,0,,ИДЁТ ПОДДЕРЖКА КИЕВА, А НА ДРУГОМ УКРЕПЛЯЕТСЯ ВОЕННАЯ ИНФРАСТРУКТУРА И
Dialogue: 0,0:03:51.18,0:03:53.98,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ РАЗГОВОРЫ О БЛОКАДЕ РОССИЙСКОГО РЕГИОНА,
Dialogue: 0,0:03:54.30,0:03:56.86,Caption,,0,0,0,,РАССМАТРИВАТЬ ВСЁ ЭТО КАК ДЕВЯТЬ СЛУЧАЙНЫХ НОВОСТЕЙ
Dialogue: 0,0:03:56.86,0:03:59.90,Caption,,0,0,0,,ДОВОЛЬНО ТЯЖЕЛО. ОСОБЕННО КОГДА В СОСЕДНЕЙ ЛИТВЕ В
Dialogue: 0,0:03:59.98,0:04:02.38,Caption,,0,0,0,,ЭТО ЖЕ ВРЕМЯ СТАРТУЮТ МЕЖДУНАРОДНЫЕ УЧЕНИЯ ПО
Dialogue: 0,0:04:02.38,0:04:05.10,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКОЙ УСТОЙЧИВОСТИ. И ТУТ ОПЯТЬ ОЧЕНЬ
Dialogue: 0,0:04:05.10,0:04:08.30,Caption,,0,0,0,,ИНТЕРЕСНЫЙ ВЫБОР СЛОВ. ЭТО НЕ ТРЕНИРОВКА ПАРАДА И
Dialogue: 0,0:04:08.30,0:04:11.18,Caption,,0,0,0,,НЕ СОРЕВНОВАНИЕ ЭЛЕКТРИКОВ. УЧАСТНИКИ РАЗБИРАЮТ,
Dialogue: 0,0:04:11.42,0:04:13.90,Caption,,0,0,0,,ЧТО БУДЕТ С ЭЛЕКТРИЧЕСКИМИ И ГАЗОВЫМИ СЕТЯМИ В
Dialogue: 0,0:04:13.98,0:04:18.54,Caption,,0,0,0,,СЕРЬЁЗНОМ КРИЗИСЕ, ГДЕ НАХОДЯТСЯ СЛАБЫЕ МЕСТА ЭНЕРГЕТИЧЕСКИХ ЦЕПОЧЕК И
Dialogue: 0,0:04:18.62,0:04:21.10,Caption,,0,0,0,,КАК СОХРАНИТЬ РАБОТУ КРИТИЧЕСКОЙ ИНФРАСТРУКТУРЫ.
Dialogue: 0,0:04:21.36,0:04:24.30,Caption,,0,0,0,,БОЛЬШЕ СТА УЧАСТНИКОВ. ЛИТВА, ЛАТВИЯ,
Dialogue: 0,0:04:24.38,0:04:29.74,Caption,,0,0,0,,ЭСТОНИЯ, ПОЛЬША, ФИНЛЯНДИЯ. СЕВЕРО ВОСТОЧНЫЙ ФЛАНГ НАТО. ТО ЕСТЬ ПОКА
Dialogue: 0,0:04:29.82,0:04:34.14,Caption,,0,0,0,,ПОЛИТИКИ ГОВОРЯТ О СИЛЕ, СПЕЦИАЛИСТЫ УЖЕ СИДЯТ НАД СХЕМАМИ И РАЗБИРАЮТСЯ,
Dialogue: 0,0:04:34.30,0:04:38.46,Caption,,0,0,0,,ГДЕ ВЗЯТЬ ЭЛЕКТРИЧЕСТВО, ЕСЛИ НОРМАЛЬНАЯ СИСТЕМА ВДРУГ ПЕРЕСТАНЕТ НОРМАЛЬНО
Dialogue: 0,0:04:38.54,0:04:41.50,Caption,,0,0,0,,РАБОТАТЬ. НАЗЫВАТЬ САМИ ЭТИ УЧЕНИЯ ПОДГОТОВКОЙ К
Dialogue: 0,0:04:41.58,0:04:44.30,Caption,,0,0,0,,БЛОКАДЕ КАЛИНИНГРАДА БЫЛО БЫ СЛИШКОМ ПРОСТО. НАТО
Dialogue: 0,0:04:44.30,0:04:47.18,Caption,,0,0,0,,ПРОВОДИТ ПОДОБНЫЕ МЕРОПРИЯТИЯ НЕ ПЕРВЫЙ ГОД. НО В
Dialogue: 0,0:04:47.18,0:04:50.06,Caption,,0,0,0,,ОБЩЕЙ КАРТИНЕ ПОЯВЛЯЕТСЯ ЕЩЁ ОДИН ОЧЕНЬ КОНКРЕТНЫЙ
Dialogue: 0,0:04:50.06,0:04:54.34,Caption,,0,0,0,,СЛОЙ. РЕЧЬ УЖЕ НЕ ТОЛЬКО О ТАНКАХ,
Dialogue: 0,0:04:54.47,0:04:57.22,Caption,,0,0,0,,РАКЕТАХ И КРАСИВЫХ РЕЧАХ. РЕЧЬ О ТОМ,
Dialogue: 0,0:04:57.38,0:05:01.62,Caption,,0,0,0,,КАК ГОСУДАРСТВО ДОЛЖНО ЖИТЬ, ЕСЛИ ЭНЕРГЕТИЧЕСКАЯ СИСТЕМА ОКАЗЫВАЕТСЯ ПОД
Dialogue: 0,0:05:01.62,0:05:04.50,Caption,,0,0,0,,СЕРЬЁЗНЫМ УДАРОМ. А РЯДОМ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА
Dialogue: 0,0:05:04.50,0:05:08.10,Caption,,0,0,0,,ИСТОРИЯ. РОССИЙСКАЯ ФСБ ЗАЯВЛЯЕТ О ЗАДЕРЖАНИИ ДВУХ
Dialogue: 0,0:05:08.10,0:05:11.38,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРЫХ ОБВИНЯЮТ В РАБОТЕ НА ПОЛЬСКУЮ РАЗВЕДКУ И
Dialogue: 0,0:05:11.38,0:05:14.10,Caption,,0,0,0,,СБОРЕ ИНФОРМАЦИИ О ВОЕННЫХ ОБЪЕКТАХ КАЛИНИНГРАДСКОЙ
Dialogue: 0,0:05:14.10,0:05:16.98,Caption,,0,0,0,,ОБЛАСТИ. ПОЛЬСКАЯ СТОРОНА ЭТИ ОБВИНЕНИЯ ФАКТИЧЕСКИ
Dialogue: 0,0:05:16.98,0:05:19.30,Caption,,0,0,0,,ОТВЕРГАЕТ И НАЗЫВАЕТ РОССИЙСКОЕ ЗАЯВЛЕНИЕ
Dialogue: 0,0:05:19.30,0:05:22.66,Caption,,0,0,0,,ПРОВОКАЦИЕЙ И ДЕЗИНФОРМАЦИЕЙ. ТО ЕСТЬ МЫ УЖЕ ИМЕЕМ
Dialogue: 0,0:05:22.74,0:05:25.46,Caption,,0,0,0,,НЕ ПРОСТО СПОР ПОЛИТИКОВ. УЖЕ ИДУТ ВЗАИМНЫЕ
Dialogue: 0,0:05:25.46,0:05:28.10,Caption,,0,0,0,,ОБВИНЕНИЯ В РАЗВЕДЫВАТЕЛЬНОЙ РАБОТЕ ВОКРУГ ВОЕННЫХ
Dialogue: 0,0:05:28.18,0:05:31.22,Caption,,0,0,0,,ОБЪЕКТОВ. ХОРОШИЙ МОМЕНТ СНОВА ВСПОМНИТЬ МЕРЦА.
Dialogue: 0,0:05:31.46,0:05:34.98,Caption,,0,0,0,,ФРИДРИХ ХОТЕЛ ЯЗЫК СИЛЫ. ВОТ ОН. ТОЛЬКО ВЫГЛЯДИТ
Dialogue: 0,0:05:35.06,0:05:37.14,Caption,,0,0,0,,ЭТОТ ЯЗЫК В РЕАЛЬНОЙ ЖИЗНИ СОВСЕМ НЕ ТАК
Dialogue: 0,0:05:37.14,0:05:41.46,Caption,,0,0,0,,КРАСИВО, КАК ЗА ТРИБУНОЙ. ТУТ УЧЕНИЯ. ТАМ РАЗВЕДКА. ЗДЕСЬ
Dialogue: 0,0:05:41.46,0:05:44.98,Caption,,0,0,0,,БЛОКАДА. ТАМ ПРЕДУПРЕЖДЕНИЕ О КАТАСТРОФЕ. РЯДОМ
Dialogue: 0,0:05:45.05,0:05:47.46,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКАЯ ИНФРАСТРУКТУРА ГОТОВИТСЯ РАБОТАТЬ В
Dialogue: 0,0:05:47.46,0:05:50.18,Caption,,0,0,0,,КРИЗИСЕ. А ТЕПЕРЬ ДОБАВИМ К ЭТОМУ АМЕРИКАНСКИЕ
Dialogue: 0,0:05:50.26,0:05:52.90,Caption,,0,0,0,,РАКЕТЫ. РОССИЙСКАЯ СТОРОНА ЗАЯВИЛА О ПЕРВОМ
Dialogue: 0,0:05:52.90,0:05:55.78,Caption,,0,0,0,,ПЕРЕХВАТЕ ЧЕТЫРЁХ НОВЫХ АМЕРИКАНСКИХ КРЫЛАТЫХ РАКЕТ
Dialogue: 0,0:05:55.85,0:05:59.14,Caption,,0,0,0,,AGM СТО ВОСЕМЬДЕСЯТ ВОСЕМЬ A RUSTY DAGGER. ЭТО
Dialogue: 0,0:05:59.14,0:06:01.06,Caption,,0,0,0,,УЖЕ ИНТЕРЕСНАЯ ИГРУШКА САМА ПО СЕБЕ.
Dialogue: 0,0:06:03.35,0:06:06.07,Caption,,0,0,0,,АМЕРИКАНЦЫ СОЗДАВАЛИ СЕМЕЙСТВО ERAM ИМЕННО КАК
Dialogue: 0,0:06:06.15,0:06:08.47,Caption,,0,0,0,,СРАВНИТЕЛЬНО ДЕШЁВОЕ ДАЛЬНОБОЙНОЕ ОРУЖИЕ,
Dialogue: 0,0:06:08.71,0:06:11.51,Caption,,0,0,0,,КОТОРОЕ МОЖНО ПРОИЗВОДИТЬ БОЛЬШИМИ СЕРИЯМИ. ТО ЕСТЬ
Dialogue: 0,0:06:11.51,0:06:13.75,Caption,,0,0,0,,СМЫСЛ НЕ В ОДНОЙ ЗОЛОТОЙ РАКЕТЕ ЗА БЕЗУМНЫЕ
Dialogue: 0,0:06:13.75,0:06:17.35,Caption,,0,0,0,,ДЕНЬГИ. СМЫСЛ КАК РАЗ В МАССЕ. ТЫСЯЧИ СРАВНИТЕЛЬНО
Dialogue: 0,0:06:17.35,0:06:20.47,Caption,,0,0,0,,ДОСТУПНЫХ РАКЕТ. МНОГО ЦЕЛЕЙ. МНОГО ПУСКОВ.
Dialogue: 0,0:06:20.71,0:06:23.75,Caption,,0,0,0,,ПОСТОЯННАЯ НАГРУЗКА НА ПРОТИВОВОЗДУШНУЮ ОБОРОНУ. И
Dialogue: 0,0:06:23.75,0:06:25.35,Caption,,0,0,0,,ВОТ РОССИЙСКИЕ ВОЕННЫЕ ГОВОРЯТ,
Dialogue: 0,0:06:25.51,0:06:28.07,Caption,,0,0,0,,ЧТО ПЕРВЫЕ ЧЕТЫРЕ УЖЕ СБИТЫ. ЗДЕСЬ НЕ НАДО
Dialogue: 0,0:06:28.07,0:06:30.71,Caption,,0,0,0,,УСТРАИВАТЬ ПОБЕДНЫЙ ПАРАД РАНЬШЕ ВРЕМЕНИ. ЭТО
Dialogue: 0,0:06:30.71,0:06:35.11,Caption,,0,0,0,,ЗАЯВЛЕНИЕ РОССИЙСКОЙ СТОРОНЫ, А НЕ ЛАБОРАТОРНЫЙ ОТЧЁТ С ПОДПИСЬЮ ВСЕХ УЧАСТНИКОВ
Dialogue: 0,0:06:35.11,0:06:38.55,Caption,,0,0,0,,КОНФЛИКТА. НО САМА ИСТОРИЯ ОЧЕНЬ ПОКАЗАТЕЛЬНАЯ. МЫ
Dialogue: 0,0:06:38.55,0:06:41.11,Caption,,0,0,0,,ОПЯТЬ ВОЗВРАЩАЕМСЯ К ЭТОЙ УДИВИТЕЛЬНОЙ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:06:41.19,0:06:44.55,Caption,,0,0,0,,ФОРМУЛЕ. РОССИЯ ПОНИМАЕТ СИЛУ. ХОРОШО. ВОТ
Dialogue: 0,0:06:44.55,0:06:47.67,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ НОВОЕ АМЕРИКАНСКОЕ ОРУЖИЕ. ОНО ПРИЛЕТАЕТ.
Dialogue: 0,0:06:47.91,0:06:50.87,Caption,,0,0,0,,ПО РОССИЙСКОЙ ВЕРСИИ, ЕГО СБИВАЮТ. И ЧТО ДАЛЬШЕ?
Dialogue: 0,0:06:51.02,0:06:54.23,Caption,,0,0,0,,ЕЩЁ РАКЕТЫ? ЕЩЁ ДАЛЬНОСТЬ? ЕЩЁ БОЛЬШЕ РАКЕТ?
Dialogue: 0,0:06:54.55,0:06:56.31,Caption,,0,0,0,,ЕЩЁ БЛИЖЕ К РОССИЙСКИМ ГРАНИЦАМ?
Dialogue: 0,0:06:56.71,0:06:59.51,Caption,,0,0,0,,ВОТ ИМЕННО ЗДЕСЬ ЯЗЫК СИЛЫ ПЕРЕСТАЁТ БЫТЬ КРАСИВОЙ
Dialogue: 0,0:06:59.51,0:07:02.79,Caption,,0,0,0,,ФРАЗОЙ. ОН ПРЕВРАЩАЕТСЯ В ЛЕСТНИЦУ. А У ЛЕСТНИЦЫ
Dialogue: 0,0:07:02.87,0:07:05.67,Caption,,0,0,0,,ЕСТЬ ОДНА НЕПРИЯТНАЯ ОСОБЕННОСТЬ. КАЖДЫЙ СЛЕДУЮЩИЙ
Dialogue: 0,0:07:05.75,0:07:08.47,Caption,,0,0,0,,ШАГ НАХОДИТСЯ ВЫШЕ ПРЕДЫДУЩЕГО. КСТАТИ,
Dialogue: 0,0:07:08.71,0:07:10.87,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВИТСЯ ИМЕННО ТАКОЙ РАЗБОР,
Dialogue: 0,0:07:11.03,0:07:13.19,Caption,,0,0,0,,ГДЕ МЫ НЕ ЧИТАЕМ ДЕВЯТЬ ЗАГОЛОВКОВ ПОДРЯД,
Dialogue: 0,0:07:13.36,0:07:15.03,Caption,,0,0,0,,А СКЛАДЫВАЕМ ИХ В ОДНУ КАРТИНУ,
Dialogue: 0,0:07:15.11,0:07:20.43,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ ДАЛЬШЕ КАК РАЗ ПОЯВЛЯЕТСЯ СТРАНА,
Dialogue: 0,0:07:20.68,0:07:22.75,Caption,,0,0,0,,КОТОРАЯ НА ЭТУ ЛЕСТНИЦУ ПОЧЕМУ ТО НЕ ОЧЕНЬ
Dialogue: 0,0:07:22.75,0:07:26.35,Caption,,0,0,0,,ТОРОПИТСЯ. ЮЖНАЯ КОРЕЯ. ВОТ ТАМ ГЕОГРАФИЯ УЧИТ
Dialogue: 0,0:07:26.35,0:07:29.31,Caption,,0,0,0,,ПОЛИТИКЕ БЫСТРЕЕ ЛЮБОГО УНИВЕРСИТЕТА. ПОТОМУ ЧТО У
Dialogue: 0,0:07:29.31,0:07:32.03,Caption,,0,0,0,,ЮЖНОЙ КОРЕИ СЕВЕРНАЯ КОРЕЯ НАХОДИТСЯ НЕ ГДЕ ТО
Dialogue: 0,0:07:32.03,0:07:34.99,Caption,,0,0,0,,ЗА ОКЕАНОМ. ОНА БУКВАЛЬНО СВЕРХУ НА КАРТЕ. И
Dialogue: 0,0:07:34.99,0:07:37.63,Caption,,0,0,0,,У ЭТОЙ СЕВЕРНОЙ КОРЕИ ЕСТЬ ЯДЕРНОЕ ОРУЖИЕ,
Dialogue: 0,0:07:37.71,0:07:41.15,Caption,,0,0,0,,РАКЕТЫ И ОГРОМНАЯ АРМИЯ. А ЗА ПОСЛЕДНИЕ ГОДЫ
Dialogue: 0,0:07:41.15,0:07:43.87,Caption,,0,0,0,,ПХЕНЬЯН ЕЩЁ И РЕЗКО РАСШИРИЛ ВОЕННОЕ СОТРУДНИЧЕСТВО
Dialogue: 0,0:07:43.95,0:07:47.07,Caption,,0,0,0,,С МОСКВОЙ. СЕВЕРОКОРЕЙСКИЕ ВОЕННЫЕ ПОЛУЧИЛИ БОЕВОЙ
Dialogue: 0,0:07:47.07,0:07:50.43,Caption,,0,0,0,,ОПЫТ, РОССИЯ И КНДР УГЛУБИЛИ ОБОРОННЫЕ СВЯЗИ,
Dialogue: 0,0:07:50.68,0:07:52.75,Caption,,0,0,0,,А В СЕУЛЕ ВНИМАТЕЛЬНО СЛЕДЯТ ЗА ТЕМ,
Dialogue: 0,0:07:52.99,0:07:55.47,Caption,,0,0,0,,КАКИЕ ТЕХНОЛОГИИ И ВОЗМОЖНОСТИ МОЖЕТ ПОЛУЧИТЬ
Dialogue: 0,0:07:55.55,0:07:58.27,Caption,,0,0,0,,ПХЕНЬЯН В РАМКАХ ЭТОГО СОТРУДНИЧЕСТВА. ПОЭТОМУ В
Dialogue: 0,0:07:58.27,0:08:00.67,Caption,,0,0,0,,СЕУЛЕ МОЖНО СКОЛЬКО УГОДНО ПРОВОДИТЬ СОВМЕСТНЫЕ
Dialogue: 0,0:08:00.67,0:08:03.55,Caption,,0,0,0,,УЧЕНИЯ С АМЕРИКАНЦАМИ. МОЖНО ДРУЖИТЬ С ЯПОНИЕЙ.
Dialogue: 0,0:08:03.87,0:08:06.99,Caption,,0,0,0,,МОЖНО БЫТЬ АМЕРИКАНСКИМ СОЮЗНИКОМ. НО СЕВЕРНАЯ КОРЕЯ
Dialogue: 0,0:08:07.07,0:08:09.47,Caption,,0,0,0,,ОТ ЭТОГО НИКУДА НЕ ПЕРЕЕЗЖАЕТ. ОНА ВСЁ РАВНО
Dialogue: 0,0:08:09.47,0:08:12.75,Caption,,0,0,0,,ОСТАЁТСЯ РЯДОМ. И ЗДЕСЬ ЮЖНОКОРЕЙЦЫ ВЕДУТ СЕБЯ ОЧЕНЬ
Dialogue: 0,0:08:12.75,0:08:15.07,Caption,,0,0,0,,ИНТЕРЕСНО. ПОКА ЕВРОПА ОБСУЖДАЕТ,
Dialogue: 0,0:08:15.17,0:08:17.63,Caption,,0,0,0,,КАК РАЗГОВАРИВАТЬ С РОССИЕЙ С ПОЗИЦИИ СИЛЫ,
Dialogue: 0,0:08:18.00,0:08:20.75,Caption,,0,0,0,,ЮЖНАЯ КОРЕЯ ОТКРЫВАЕТ ДЛЯ СЕБЯ МАРШРУТ В ЕВРОПУ
Dialogue: 0,0:08:20.75,0:08:24.27,Caption,,0,0,0,,ЧЕРЕЗ РОССИЙСКУЮ АРКТИКУ. КОНТЕЙНЕРОВОЗ PANSTAR ACRO
Dialogue: 0,0:08:24.28,0:08:26.75,Caption,,0,0,0,,ПРОШЁЛ ИЗ ПУСАНА В ЕВРОПУ ЧЕРЕЗ АРКТИКУ И
Dialogue: 0,0:08:26.75,0:08:28.99,Caption,,0,0,0,,ВЕРНУЛСЯ ОБРАТНО ПРИМЕРНО ЗА ПЯТЬДЕСЯТ ДНЕЙ.
Dialogue: 0,0:08:31.28,0:08:34.16,Caption,,0,0,0,,СЕУЛ ТЕПЕРЬ ХОЧЕТ РАЗВИВАТЬ ЭТО НАПРАВЛЕНИЕ ДАЛЬШЕ И
Dialogue: 0,0:08:34.16,0:08:36.72,Caption,,0,0,0,,РАССЧИТЫВАЕТ ВЫЙТИ НА РЕГУЛЯРНЫЕ ПЕРЕВОЗКИ ПРИМЕРНО
Dialogue: 0,0:08:36.80,0:08:41.76,Caption,,0,0,0,,К ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ ГОДУ. ТО ЕСТЬ РОССИЯ ДЛЯ ЮЖНОЙ КОРЕИ ОДНОВРЕМЕННО ОСТАЁТСЯ
Dialogue: 0,0:08:41.76,0:08:43.60,Caption,,0,0,0,,СЛОЖНЫМ ПОЛИТИЧЕСКИМ ПАРТНЁРОМ,
Dialogue: 0,0:08:43.85,0:08:46.56,Caption,,0,0,0,,СТРАНОЙ, ТЕСНО СВЯЗАННОЙ С СЕВЕРНОЙ КОРЕЕЙ,
Dialogue: 0,0:08:46.80,0:08:50.40,Caption,,0,0,0,,И ГОСУДАРСТВОМ, БЕЗ КОТОРОГО ПЕРСПЕКТИВНЫЙ СЕВЕРНЫЙ МОРСКОЙ КОРИДОР
Dialogue: 0,0:08:50.43,0:08:53.44,Caption,,0,0,0,,НОРМАЛЬНО НЕ РАБОТАЕТ. ОЧЕНЬ ВЗРОСЛАЯ СИТУАЦИЯ.
Dialogue: 0,0:08:53.73,0:08:57.36,Caption,,0,0,0,,НИКАКИХ СКАЗОК ПРО ТО, ЧТО МЫ СЕЙЧАС ГРОМКО ХЛОПНЕМ ДВЕРЬЮ,
Dialogue: 0,0:08:57.55,0:09:00.72,Caption,,0,0,0,,А ПОТОМ ОБНАРУЖИМ, ЧТО ДВЕРЬ БЫЛА В НАШЕМ СОБСТВЕННОМ ДОМЕ.
Dialogue: 0,0:09:01.27,0:09:03.36,Caption,,0,0,0,,ЮЖНОКОРЕЙСКИЙ ПРЕЗИДЕНТ ПРЯМО ГОВОРИТ,
Dialogue: 0,0:09:03.60,0:09:06.64,Caption,,0,0,0,,ЧТО РАЗВИВАТЬ АРКТИЧЕСКИЙ МАРШРУТ СТРАНА СОБИРАЕТСЯ
Dialogue: 0,0:09:06.72,0:09:09.60,Caption,,0,0,0,,С СОБЛЮДЕНИЕМ МЕЖДУНАРОДНЫХ НОРМ И САНКЦИЙ. НО
Dialogue: 0,0:09:09.68,0:09:12.48,Caption,,0,0,0,,РАЗВИВАТЬ ВСЁ РАВНО СОБИРАЕТСЯ. ПОТОМУ ЧТО КАРТА
Dialogue: 0,0:09:12.48,0:09:16.08,Caption,,0,0,0,,СИЛЬНЕЕ ЛОЗУНГОВ. ЧЕРЕЗ СУЭЦ ИДТИ ДОЛЬШЕ. ЧЕРЕЗ
Dialogue: 0,0:09:16.08,0:09:19.28,Caption,,0,0,0,,АРКТИКУ ПРИ БЛАГОПРИЯТНЫХ УСЛОВИЯХ БЫСТРЕЕ. У ЮЖНОЙ
Dialogue: 0,0:09:19.28,0:09:21.76,Caption,,0,0,0,,КОРЕИ ОГРОМНАЯ СУДОСТРОИТЕЛЬНАЯ ПРОМЫШЛЕННОСТЬ.
Dialogue: 0,0:09:22.01,0:09:24.80,Caption,,0,0,0,,ПУСАН ЯВЛЯЕТСЯ ОДНИМ ИЗ КРУПНЕЙШИХ ПОРТОВЫХ УЗЛОВ
Dialogue: 0,0:09:24.88,0:09:27.44,Caption,,0,0,0,,МИРА. И ОТКАЗАТЬСЯ ОТ ТАКОГО НАПРАВЛЕНИЯ ТОЛЬКО
Dialogue: 0,0:09:27.44,0:09:30.64,Caption,,0,0,0,,ПОТОМУ, ЧТО СЕГОДНЯШНЯЯ ПОЛИТИЧЕСКАЯ ПОГОДА НЕУДОБНАЯ,
Dialogue: 0,0:09:30.88,0:09:33.36,Caption,,0,0,0,,В СЕУЛЕ ЯВНО НЕ СПЕШАТ. И ЗДЕСЬ БЫЛА
Dialogue: 0,0:09:33.44,0:09:38.29,Caption,,0,0,0,,ЕЩЁ ОДНА ГРОМКАЯ ИСТОРИЯ. ПОЯВИЛОСЬ СООБЩЕНИЕ,
Dialogue: 0,0:09:38.53,0:09:41.65,Caption,,0,0,0,,ЧТО ЮЖНОКОРЕЙСКАЯ КОМПАНИЯ NEWTYPE INDUSTRIES ЯКОБЫ
Dialogue: 0,0:09:41.65,0:09:44.61,Caption,,0,0,0,,ПРЕКРАТИЛА СОТРУДНИЧЕСТВО С УКРАИНОЙ И ОСТАНОВИЛА
Dialogue: 0,0:09:44.61,0:09:47.09,Caption,,0,0,0,,ИСПЫТАНИЯ СВОЕЙ СИСТЕМЫ ИСКУССТВЕННОГО ИНТЕЛЛЕКТА
Dialogue: 0,0:09:47.17,0:09:49.57,Caption,,0,0,0,,ДЛЯ АРТИЛЛЕРИИ ПОСЛЕ ДИПЛОМАТИЧЕСКОГО КОНФЛИКТА.
Dialogue: 0,0:09:50.21,0:09:52.85,Caption,,0,0,0,,ВОТ ТОЛЬКО ИСТОРИЯ ПРОЖИЛА СОВСЕМ НЕДОЛГО. THE
Dialogue: 0,0:09:52.85,0:09:54.93,Caption,,0,0,0,,DIPLOMAT, КОТОРЫЙ ЕЁ ОПУБЛИКОВАЛ,
Dialogue: 0,0:09:55.09,0:09:57.73,Caption,,0,0,0,,ЗАТЕМ МАТЕРИАЛ ОТОЗВАЛ. ИЗДАНИЕ ПРИЗНАЛО,
Dialogue: 0,0:09:57.86,0:09:59.97,Caption,,0,0,0,,ЧТО ИНТЕРВЬЮ С РУКОВОДИТЕЛЕМ КОМПАНИИ БЫЛО
Dialogue: 0,0:09:59.97,0:10:02.53,Caption,,0,0,0,,СФАБРИКОВАНО. САМА КОМПАНИЯ ЗАЯВИЛА,
Dialogue: 0,0:10:02.69,0:10:04.69,Caption,,0,0,0,,ЧТО НИКТО У НЕЁ ИНТЕРВЬЮ НЕ БРАЛ,
Dialogue: 0,0:10:04.85,0:10:07.17,Caption,,0,0,0,,А ПРИПИСАННЫЕ ЕЁ ПРЕДСТАВИТЕЛЯМ ЦИТАТЫ БЫЛИ
Dialogue: 0,0:10:07.17,0:10:09.81,Caption,,0,0,0,,ВЫДУМАНЫ. ТО ЕСТЬ КРАСИВОЙ ИСТОРИИ О ТОМ,
Dialogue: 0,0:10:10.05,0:10:12.85,Caption,,0,0,0,,КАК ИСПУГАННЫЕ ЮЖНОКОРЕЙЦЫ ОДНИМ ДВИЖЕНИЕМ РАЗОРВАЛИ
Dialogue: 0,0:10:12.85,0:10:17.33,Caption,,0,0,0,,СОТРУДНИЧЕСТВО С УКРАИНОЙ, У НАС НЕТ. НО ИНТЕРЕСНЕЕ ЗДЕСЬ ДРУГОЕ. НАМ
Dialogue: 0,0:10:17.41,0:10:19.41,Caption,,0,0,0,,ЭТА ВЫДУМАННАЯ ИСТОРИЯ ВООБЩЕ НЕ НУЖНА,
Dialogue: 0,0:10:19.64,0:10:23.09,Caption,,0,0,0,,ЧТОБЫ УВИДЕТЬ РЕАЛЬНОЕ ПОВЕДЕНИЕ ЮЖНОЙ КОРЕИ. СЕУЛ
Dialogue: 0,0:10:23.17,0:10:26.13,Caption,,0,0,0,,ПРОДОЛЖАЕТ СОЮЗ С ВАШИНГТОНОМ. ПРОВОДИТ СОВМЕСТНЫЕ
Dialogue: 0,0:10:26.13,0:10:29.33,Caption,,0,0,0,,УЧЕНИЯ. СОТРУДНИЧАЕТ С ЯПОНИЕЙ. СЛЕДИТ ЗА СЕВЕРНОЙ
Dialogue: 0,0:10:29.33,0:10:32.21,Caption,,0,0,0,,КОРЕЕЙ. ПРИ ЭТОМ НЕ ОТКАЗЫВАЕТСЯ ОТ ЭКОНОМИЧЕСКОГО
Dialogue: 0,0:10:32.21,0:10:34.93,Caption,,0,0,0,,ИНТЕРЕСА К РОССИЙСКОМУ АРКТИЧЕСКОМУ МАРШРУТУ И
Dialogue: 0,0:10:34.93,0:10:39.09,Caption,,0,0,0,,ПРЕКРАСНО ПОНИМАЕТ, ЧТО РОССИЙСКО СЕВЕРОКОРЕЙСКОЕ ВОЕННОЕ СОТРУДНИЧЕСТВО
Dialogue: 0,0:10:39.31,0:10:42.69,Caption,,0,0,0,,СТАЛО ДЛЯ НЕГО ОТДЕЛЬНЫМ ФАКТОРОМ БЕЗОПАСНОСТИ. ВОТ
Dialogue: 0,0:10:42.69,0:10:45.17,Caption,,0,0,0,,ЭТО УЖЕ НЕ ЛОЗУНГ. ЭТО РАСЧЁТ. И НА
Dialogue: 0,0:10:45.17,0:10:47.89,Caption,,0,0,0,,ЭТОМ ФОНЕ ЕВРОПЕЙСКАЯ РЕШИТЕЛЬНАЯ РЕШИМОСТЬ ВЫГЛЯДИТ
Dialogue: 0,0:10:47.89,0:10:52.07,Caption,,0,0,0,,ОСОБЕННО ИНТЕРЕСНО. МЕРЦ ГОВОРИТ,
Dialogue: 0,0:10:52.23,0:10:55.83,Caption,,0,0,0,,ЧТО РОССИЯ ПОНИМАЕТ ЯЗЫК СИЛЫ. ФИЦО ОТВЕЧАЕТ МЕРЦУ,
Dialogue: 0,0:10:55.99,0:10:58.31,Caption,,0,0,0,,ЧТО ГЕРМАНИЯ НЕ БУДЕТ КОМАНДОВАТЬ ВСЕМИ ЧЕРЕЗ
Dialogue: 0,0:10:58.31,0:11:02.23,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ БЮДЖЕТ. ВОКРУГ КАЛИНИНГРАДА ЗВУЧАТ ПРЕДУПРЕЖДЕНИЯ,
Dialogue: 0,0:11:02.39,0:11:05.03,Caption,,0,0,0,,ИДУТ УЧЕНИЯ ПО РАБОТЕ ЭНЕРГЕТИКИ В КРИЗИСЕ,
Dialogue: 0,0:11:05.28,0:11:07.19,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ ОБВИНЕНИЯ В РАЗВЕДКЕ,
Dialogue: 0,0:11:07.36,0:11:10.47,Caption,,0,0,0,,ИСПЫТЫВАЕТСЯ НОВОЕ ДАЛЬНОБОЙНОЕ ОРУЖИЕ. А НА ДРУГОМ
Dialogue: 0,0:11:10.47,0:11:13.83,Caption,,0,0,0,,КОНЦЕ ЕВРАЗИИ ЛЮДИ ПРОСТО СМОТРЯТ НА КАРТУ. СВЕРХУ
Dialogue: 0,0:11:13.83,0:11:17.83,Caption,,0,0,0,,СЕВЕРНАЯ КОРЕЯ. ЗА НЕЙ КИТАЙ. РЯДОМ РОССИЯ. ЧЕРЕЗ
Dialogue: 0,0:11:17.91,0:11:20.15,Caption,,0,0,0,,РОССИЙСКУЮ АРКТИКУ ЛЕЖИТ ПОТЕНЦИАЛЬНО ВЫГОДНЫЙ
Dialogue: 0,0:11:20.23,0:11:22.87,Caption,,0,0,0,,ТОРГОВЫЙ МАРШРУТ. И ТУТ ВДРУГ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:11:23.11,0:11:25.99,Caption,,0,0,0,,ЧТО ГЕОГРАФИЯ ВООБЩЕ ПЛОХО РЕАГИРУЕТ НА ПОЛИТИЧЕСКИЕ
Dialogue: 0,0:11:25.99,0:11:29.03,Caption,,0,0,0,,ЛОЗУНГИ. ЕЁ НЕЛЬЗЯ ПЕРЕУБЕДИТЬ ПРЕСС КОНФЕРЕНЦИЕЙ.
Dialogue: 0,0:11:29.27,0:11:31.75,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО ОБЪЯВЛЯТЬ НОВУЮ ЭПОХУ,
Dialogue: 0,0:11:31.96,0:11:34.95,Caption,,0,0,0,,НОВУЮ РЕШИТЕЛЬНОСТЬ И НОВЫЙ ЯЗЫК СИЛЫ. НО УТРОМ
Dialogue: 0,0:11:34.95,0:11:37.35,Caption,,0,0,0,,СТРАНЫ ВСЁ РАВНО ПРОСЫПАЮТСЯ НА ТОМ ЖЕ МЕСТЕ,
Dialogue: 0,0:11:37.48,0:11:41.27,Caption,,0,0,0,,ГДЕ СТОЯЛИ ВЧЕРА. У РОССИИ ОСТАЁТСЯ КАЛИНИНГРАД. У
Dialogue: 0,0:11:41.35,0:11:44.47,Caption,,0,0,0,,ЛИТВЫ ОСТАЁТСЯ ГРАНИЦА. У ПОЛЬШИ ОСТАЁТСЯ РОССИЙСКИЙ
Dialogue: 0,0:11:44.47,0:11:47.99,Caption,,0,0,0,,РЕГИОН РЯДОМ. У ЮЖНОЙ КОРЕИ ОСТАЁТСЯ СЕВЕРНАЯ КОРЕЯ
Dialogue: 0,0:11:48.07,0:11:51.11,Caption,,0,0,0,,НАД ГОЛОВОЙ. А У ФРИДРИХА МЕРЦА ОСТАЁТСЯ ИСТОРИЯ
Dialogue: 0,0:11:51.11,0:11:53.19,Caption,,0,0,0,,СОБСТВЕННОЙ СТРАНЫ. ВОТ С НЕЁ,
Dialogue: 0,0:11:53.36,0:11:56.95,Caption,,0,0,0,,ПОЖАЛУЙ, И СТОИЛО НАЧИНАТЬ ИЗУЧЕНИЕ ИНОСТРАННЫХ ЯЗЫКОВ.
