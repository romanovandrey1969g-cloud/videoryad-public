Dialogue: 0,0:00:00.00,0:00:07.27,Caption,,0,0,0,,У ЗЕЛЕНСКОГО ВНЕЗАПНО ПРОРЕЗАЛАСЬ ТАКАЯ ОТВАГА, БУДТО ЕМУ ВЫДАЛИ ПЕРСОНАЛЬНЫЙ БРОНЕЖИЛЕТ РАЗМЕРОМ СО ВСЮ СТРАНУ.
Dialogue: 0,0:00:07.27,0:00:17.91,Caption,,0,0,0,,НЕДАВНО ЕГО ДОЛГО НЕ БЫЛО В КИЕВЕ, ВОКРУГ ЕГО БЕЗОПАСНОСТИ ХОДИЛИ РАЗГОВОРЫ, А ПОСЛЕ ВОЗВРАЩЕНИЯ ОН СРАЗУ ЗАГОВОРИЛ О НОВЫХ УДАРАХ И НЕДОЛГОЙ ЖИЗНИ КРЫМСКОГО МОСТА.
Dialogue: 0,0:00:17.91,0:00:20.38,Caption,,0,0,0,,СОВПАДЕНИЕ ПОЛУЧИЛОСЬ СЛИШКОМ УДОБНЫМ.
Dialogue: 0,0:00:20.38,0:00:24.86,Caption,,0,0,0,,КТО И ЧТО ПООБЕЩАЛ ЧЕЛОВЕКУ, ЕСЛИ ОН ТАК РЕЗКО ПЕРЕСТАЛ ОГЛЯДЫВАТЬСЯ?
Dialogue: 0,0:00:24.86,0:00:32.84,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ДАЛЬШЕ РАЗБЕРЁМСЯ, ПОЧЕМУ ЛИЧНАЯ НЕУЯЗВИМОСТЬ ОДНОГО ЧЕЛОВЕКА МОЖЕТ ДОРОГО ОБОЙТИСЬ ВСЕМ ОСТАЛЬНЫМ.
Dialogue: 0,0:00:32.84,0:00:36.08,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ОТСУТСТВОВАЛ В СТОЛИЦЕ ПОЧТИ ДВЕ НЕДЕЛИ.
Dialogue: 0,0:00:36.08,0:00:40.30,Caption,,0,0,0,,ВЕРНУЛСЯ, ПОЯВИЛСЯ ПЕРЕД КАМЕРАМИ И МГНОВЕННО ПРИБАВИЛ ГРОМКОСТИ.
Dialogue: 0,0:00:40.30,0:00:51.01,Caption,,0,0,0,,ТЕПЕРЬ ОН ОБЕЩАЕТ НАНОСИТЬ УДАРЫ ПО РОССИЙСКИМ ОБЪЕКТАМ, РАСПОРЯЖАЕТСЯ КРЫМОМ КАК СОБСТВЕННОЙ КЛАДОВОЙ И ОТДЕЛЬНО ПРЕДУПРЕЖДАЕТ, ЧТО КРЫМСКИЙ МОСТ ДОЛГО НЕ ВЫДЕРЖИТ.
Dialogue: 0,0:00:51.01,0:00:57.24,Caption,,0,0,0,,ТАКОЙ НАПОР ВОЗНИК КАК РАЗ ПОСЛЕ СООБЩЕНИЙ О ГАРАНТИЯХ БЕЗОПАСНОСТИ, ПОЛУЧЕННЫХ ЛИЧНО ЗЕЛЕНСКИМ.
Dialogue: 0,0:00:57.24,0:01:01.59,Caption,,0,0,0,,НЕ ДЛЯ УКРАИНСКИХ ГОРОДОВ, ЭЛЕКТРОСТАНЦИЙ ИЛИ ПЕРЕПРАВ ЧЕРЕЗ ДНЕПР.
Dialogue: 0,0:01:01.59,0:01:06.65,Caption,,0,0,0,,РЕЧЬ ИДЁТ ИМЕННО О НЁМ. ЗЕЛЕНСКИЙ СНОВА ОБЪЯВЛЯЕТ КРЫМСКИЙ МОСТ ЗАКОННОЙ ЦЕЛЬЮ.
Dialogue: 0,0:01:06.65,0:01:14.51,Caption,,0,0,0,,ОБОСНОВАНИЕ СТАРОЕ. КИЕВ СЧИТАЕТ КРЫМ СВОЕЙ ТЕРРИТОРИЕЙ, СЛЕДОВАТЕЛЬНО, СЧИТАЕТ ДОПУСТИМЫМИ ЛЮБЫЕ ДЕЙСТВИЯ НА ПОЛУОСТРОВЕ.
Dialogue: 0,0:01:14.51,0:01:16.45,Caption,,0,0,0,,ЕСТЬ И БОЛЕЕ КОРОТКАЯ ФОРМУЛА.
Dialogue: 0,0:01:16.45,0:01:20.15,Caption,,0,0,0,,РОССИЯ АТАКУЕТ УКРАИНСКИЕ МОСТЫ, УКРАИНА ОТВЕЧАЕТ ТЕМ ЖЕ.
Dialogue: 0,0:01:20.15,0:01:23.66,Caption,,0,0,0,,НА СЛОВАХ ВЫХОДИТ ПОЧТИ ШКОЛЬНАЯ ЗАДАЧКА НА РАВЕНСТВО.
Dialogue: 0,0:01:23.66,0:01:31.44,Caption,,0,0,0,,ТОЛЬКО В МОСКВЕ УЖЕ ПРЕДУПРЕДИЛИ, ЧТО СЛЕДУЮЩИЙ ПРИМЕР БУДУТ РЕШАТЬ ДРУГИМИ СРЕДСТВАМИ И ОТВЕТ ОКАЖЕТСЯ НАМНОГО ТЯЖЕЛЕЕ.
Dialogue: 0,0:01:31.44,0:01:41.12,Caption,,0,0,0,,ПЕРЕД ПРОДОЛЖЕНИЕМ ЭТОЙ ИГРЫ ЗЕЛЕНСКИЙ, ПО ДАННЫМ ИСТОЧНИКА В ОФИСЕ ПРЕЗИДЕНТА, ЗАПРОСИЛ У ГЕНШТАБА ОЦЕНКУ СОСТОЯНИЯ УКРАИНСКИХ ПЕРЕПРАВ ЧЕРЕЗ ДНЕПР.
Dialogue: 0,0:01:41.12,0:01:47.08,Caption,,0,0,0,,ВОПРОС БЫЛ ПРЕДЕЛЬНО ЗЕМНОЙ. ЧТО ПРОИЗОЙДЁТ, ЕСЛИ РОССИЙСКИЕ УДАРЫ ПО НИМ СТАНУТ РЕГУЛЯРНЫМИ?
Dialogue: 0,0:01:47.08,0:01:53.70,Caption,,0,0,0,,СКОЛЬКО ПРОДЕРЖАТСЯ КОНСТРУКЦИИ, КАК БЫСТРО НАЧНУТСЯ ПЕРЕБОИ И ДОЛГО ЛИ УДАСТСЯ ПОДДЕРЖИВАТЬ ДВИЖЕНИЕ?
Dialogue: 0,0:01:53.70,0:02:00.39,Caption,,0,0,0,,ЗАМЫСЕЛ ПОЛУЧИЛСЯ БОДРЫЙ. РОССИЙСКИЕ МОСТЫ ЛОМАЕМ, УКРАИНСКИМ ЗАРАНЕЕ НАЗНАЧАЕМ ДОПУСТИМЫЙ СРОК МУЧЕНИЙ.
Dialogue: 0,0:02:00.39,0:02:07.66,Caption,,0,0,0,,ТАКАЯ СТРАТЕГИЯ ПРЕКРАСНО ВЫГЛЯДИТ В КАБИНЕТЕ, ПОКА НА СТОЛЕ ЛЕЖИТ СХЕМА, А НЕ РАСПИСАНИЕ ОСТАНОВЛЕННЫХ ПОЕЗДОВ.
Dialogue: 0,0:02:07.66,0:02:12.40,Caption,,0,0,0,,МОСТ НЕ ОБЯЗАН ЦЕЛИКОМ УПАСТЬ В РЕКУ, ЧТОБЫ ПЕРЕСТАТЬ НОРМАЛЬНО РАБОТАТЬ.
Dialogue: 0,0:02:12.40,0:02:18.11,Caption,,0,0,0,,ДОСТАТОЧНО ПОВРЕЖДЕНИЙ, ПОСТОЯННОЙ УГРОЗЫ НОВЫХ АТАК И ВЫНУЖДЕННЫХ ОГРАНИЧЕНИЙ ДВИЖЕНИЯ.
Dialogue: 0,0:02:18.11,0:02:23.69,Caption,,0,0,0,,ПОСЛЕ ЭТОГО ГРУЗАМ, ТЕХНИКЕ, СНАБЖЕНИЮ И ОБЫЧНОМУ ТРАНСПОРТУ ПРИХОДИТСЯ ИСКАТЬ ОБХОДЫ.
Dialogue: 0,0:02:23.69,0:02:26.35,Caption,,0,0,0,,А НА КАРТЕ ЛЮБОЙ ОБЪЕЗД ЗАНИМАЕТ СЕКУНДУ.
Dialogue: 0,0:02:26.35,0:02:30.18,Caption,,0,0,0,,В РЕАЛЬНОСТИ ОН ТРЕБУЕТ ВРЕМЕНИ, ТОПЛИВА И НОВЫХ МАРШРУТОВ.
Dialogue: 0,0:02:30.18,0:02:35.24,Caption,,0,0,0,,ПОЭТОМУ ГЛАВНАЯ ДЕТАЛЬ ЗДЕСЬ НЕ ОЧЕРЕДНОЕ ОБЕЩАНИЕ УДАРИТЬ ПО КРЫМСКОМУ МОСТУ.
Dialogue: 0,0:02:35.24,0:02:41.11,Caption,,0,0,0,,ГЛАВНОЕ В ДРУГОМ. РЕШЕНИЕ ПРИНЯТО ПОСЛЕ ОЦЕНКИ ВЕРОЯТНОГО ОТВЕТА ПО УКРАИНСКИМ ПЕРЕПРАВАМ.
Dialogue: 0,0:02:41.11,0:02:44.23,Caption,,0,0,0,,ПОСЛЕДСТВИЯ ЗАРАНЕЕ ПОСЧИТАЛИ И СОЧЛИ ТЕРПИМЫМИ.
Dialogue: 0,0:02:44.23,0:02:47.34,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОЧЕНЬ НАГЛЯДНОЕ РАСПРЕДЕЛЕНИЕ ЗАЩИТЫ.
Dialogue: 0,0:02:47.34,0:02:49.81,Caption,,0,0,0,,ДЛЯ ЗЕЛЕНСКОГО ПРЕДУСМОТРЕНЫ ГАРАНТИИ.
Dialogue: 0,0:02:49.81,0:02:54.22,Caption,,0,0,0,,ДЛЯ МОСТОВ ПРЕДУСМОТРЕНА ТАБЛИЦА С ПРЕДПОЛАГАЕМЫМ ЗАПАСОМ ПРОЧНОСТИ.
Dialogue: 0,0:02:54.22,0:02:56.95,Caption,,0,0,0,,СОГЛАСИТЕСЬ, ПЕРВОЕ ЗВУЧИТ ЗАМЕТНО УЮТНЕЕ.
Dialogue: 0,0:02:56.95,0:03:01.23,Caption,,0,0,0,,РОССИЙСКИЕ УДАРЫ ПО УКРАИНСКИМ ОБЪЕКТАМ ТЕМ ВРЕМЕНЕМ ПРОДОЛЖАЮТСЯ.
Dialogue: 0,0:03:01.23,0:03:12.98,Caption,,0,0,0,,МИНИСТЕРСТВО ОБОРОНЫ РОССИИ СООБЩИЛО О ПОРАЖЕНИИ МЕСТА, ГДЕ ПРОХОДИЛО СОВЕЩАНИЕ ВЫСОКОПОСТАВЛЕННЫХ ПРЕДСТАВИТЕЛЕЙ УКРАИНСКОГО ВОЕННОГО КОМАНДОВАНИЯ И ВОЕННО ПРОМЫШЛЕННОГО КОМПЛЕКСА.
Dialogue: 0,0:03:12.98,0:03:16.42,Caption,,0,0,0,,ВМЕСТЕ С НИМИ ТАМ НАХОДИЛИСЬ ИНОСТРАННЫЕ СПЕЦИАЛИСТЫ.
Dialogue: 0,0:03:16.42,0:03:20.70,Caption,,0,0,0,,ТАКОЙ НАБОР УЧАСТНИКОВ ОЗНАЧАЕТ, ЧТО РЕЧЬ ШЛА НЕ О РЯДОВОМ СКЛАДЕ.
Dialogue: 0,0:03:20.70,0:03:31.09,Caption,,0,0,0,,ПОД ОДНОЙ КРЫШЕЙ СОБРАЛИСЬ ТЕ, КТО ОПРЕДЕЛЯЕТ ВОЕННЫЕ ЗАДАЧИ, ТЕ, КТО ОТВЕЧАЕТ ЗА ВЫПУСК ВООРУЖЕНИЙ, И ЗАРУБЕЖНЫЕ ПОМОЩНИКИ, СПОСОБНЫЕ СВЯЗАТЬ ЭТИ ДВА ПРОЦЕССА.
Dialogue: 0,0:03:31.09,0:03:36.22,Caption,,0,0,0,,РОССИЙСКОЕ ВЕДОМСТВО НЕ ПЕРЕЧИСЛИЛО ФАМИЛИИ И НЕ РАСКРЫЛО ПОДРОБНЫЙ ИТОГ УДАРА.
Dialogue: 0,0:03:36.22,0:03:39.65,Caption,,0,0,0,,ЗАТО ГЕОГРАФИЯ ОСТАЛЬНЫХ АТАК БЫЛА ОБОЗНАЧЕНА ШИРОКО.
Dialogue: 0,0:03:39.65,0:03:49.00,Caption,,0,0,0,,ПОД УДАР ПОПАЛИ ВОЕННЫЕ АЭРОДРОМЫ, ЭНЕРГЕТИЧЕСКИЕ И ТРАНСПОРТНЫЕ ОБЪЕКТЫ, ПЛОЩАДКИ ПРОИЗВОДСТВА И ХРАНЕНИЯ БЕСПИЛОТНИКОВ И БЕЗЭКИПАЖНЫХ КАТЕРОВ,
Dialogue: 0,0:03:49.00,0:03:54.78,Caption,,0,0,0,,ПОЗИЦИИ УКРАИНСКИХ ФОРМИРОВАНИЙ И ИНОСТРАННЫХ ВОЕННОСЛУЖАЩИХ В СТА СОРОКА ВОСЬМИ РАЙОНАХ.
Dialogue: 0,0:03:54.78,0:04:03.73,Caption,,0,0,0,,ВО ЛЬВОВЕ НА ВИДЕО ОКАЗАЛСЯ МОМЕНТ ПРЕДПОЛАГАЕМОГО ПРИЛЁТА РАКЕТЫ ХА СТО ОДИН ВОЗЛЕ АВИАЦИОННОГО РЕМОНТНОГО ПРЕДПРИЯТИЯ И СТАНЦИИ СКНИЛОВ.
Dialogue: 0,0:04:03.73,0:04:09.77,Caption,,0,0,0,,РОССИЙСКАЯ СТОРОНА ОТНОСИТ ЭТОТ ЗАВОД К ПРОИЗВОДСТВЕННОЙ ЦЕПОЧКЕ НЕСКОЛЬКИХ ВИДОВ ВООРУЖЕНИЙ.
Dialogue: 0,0:04:09.77,0:04:18.33,Caption,,0,0,0,,СРЕДИ НИХ НАЗЫВАЮТСЯ ОПЕРАТИВНО ТАКТИЧЕСКИЕ И КРЫЛАТЫЕ РАКЕТЫ, ВКЛЮЧАЯ «ФЛАМИНГО», А ТАКЖЕ БЕСПИЛОТНИКИ СРЕДНЕЙ И БОЛЬШОЙ ДАЛЬНОСТИ.
Dialogue: 0,0:04:18.33,0:04:20.67,Caption,,0,0,0,,СМЫСЛ ТАКИХ УДАРОВ ДОВОЛЬНО ЖЁСТКИЙ.
Dialogue: 0,0:04:20.67,0:04:27.62,Caption,,0,0,0,,МОЖНО ЛОВИТЬ УЖЕ ВЫПУЩЕННУЮ РАКЕТУ, ТРАТИТЬ ДОРОГОЙ ПЕРЕХВАТЧИК И НАДЕЯТЬСЯ, ЧТО ОБЛОМКИ НИКОГО НЕ ЗАДЕНУТ.
Dialogue: 0,0:04:27.62,0:04:32.42,Caption,,0,0,0,,А МОЖНО ДОБРАТЬСЯ ДО МЕСТА, ГДЕ СЛЕДУЮЩАЯ РАКЕТА ЕЩЁ ЛЕЖИТ В ВИДЕ ДЕТАЛЕЙ.
Dialogue: 0,0:04:32.42,0:04:37.87,Caption,,0,0,0,,ВО ВРЕМЯ АТАКИ В КИЕВЕ НЕБОЛЬШИЕ ПОВРЕЖДЕНИЯ ПОЛУЧИЛО ЗДАНИЕ ПОСОЛЬСТВА НИДЕРЛАНДОВ.
Dialogue: 0,0:04:37.87,0:04:44.30,Caption,,0,0,0,,СОТРУДНИКИ НЕ ПОСТРАДАЛИ. А ПОЧТИ ОДНОВРЕМЕННО СЕРЬЁЗНАЯ ИСТОРИЯ РАЗВЕРНУЛАСЬ УЖЕ В СЕВЕРНОЙ АФРИКЕ.
Dialogue: 0,0:04:44.30,0:04:50.59,Caption,,0,0,0,,ПОСЛЕ НАПАДЕНИЯ В БЕНГАЗИ ПОЯВИЛИСЬ СООБЩЕНИЯ О ТЯЖЁЛОМ ПОРАЖЕНИИ РОССИЙСКОГО КОРВЕТА «МЕРКУРИЙ».
Dialogue: 0,0:04:50.59,0:04:56.37,Caption,,0,0,0,,В НЕКОТОРЫХ ПУБЛИКАЦИЯХ СОСТОЯНИЕ КОРАБЛЯ ОПИСЫВАЛИ КАК ПРАКТИЧЕСКИ БЕЗВОЗВРАТНУЮ ПОТЕРЮ.
Dialogue: 0,0:04:56.37,0:05:00.32,Caption,,0,0,0,,ПОД АТАКУ ПОПАЛО И КОММЕРЧЕСКОЕ СУДНО ПОД МАЛЬТИЙСКИМ ФЛАГОМ.
Dialogue: 0,0:05:00.32,0:05:02.60,Caption,,0,0,0,,ПОСТРАДАЛИ НЕ МЕНЕЕ ДЕСЯТИ ЧЕЛОВЕК.
Dialogue: 0,0:05:02.60,0:05:07.01,Caption,,0,0,0,,ОДНО ИЗ СООБЩЕНИЙ СВЯЗЫВАЕТ УДАР С УКРАИНСКИМ МОРСКИМ БЕСПИЛОТНИКОМ.
Dialogue: 0,0:05:07.01,0:05:12.14,Caption,,0,0,0,,ВАЖЕН НЕ ПОДРОБНЫЙ РАЗБОР КАЖДОЙ МИНУТЫ НАПАДЕНИЯ, А ВЫБРАННЫЙ ДЛЯ НЕГО МОМЕНТ.
Dialogue: 0,0:05:12.14,0:05:19.08,Caption,,0,0,0,,РОССИЯ, СОЕДИНЁННЫЕ ШТАТЫ И КИТАЙ ПРОВЕЛИ ВСТРЕЧУ И ЗАЯВИЛИ О НАМЕРЕНИИ НЕ ДОПУСТИТЬ ЯДЕРНОГО СТОЛКНОВЕНИЯ.
Dialogue: 0,0:05:19.08,0:05:23.10,Caption,,0,0,0,,СЛЕДОМ МОСКВА ПОЛУЧАЕТ НОВЫЙ ПОВОД ДЛЯ КРАЙНЕ ЖЁСТКОЙ РЕАКЦИИ.
Dialogue: 0,0:05:23.10,0:05:25.12,Caption,,0,0,0,,ОТСЮДА ВОЗНИКАЕТ ОСТРАЯ ВЕРСИЯ.
Dialogue: 0,0:05:25.12,0:05:36.15,Caption,,0,0,0,,ЗЕЛЕНСКОМУ И СИЛАМ, КОТОРЫМ НЕВЫГОДНО СБЛИЖЕНИЕ МОСКВЫ, ВАШИНГТОНА И ПЕКИНА, НУЖЕН ТАКОЙ РОССИЙСКИЙ ОТВЕТ, ПОСЛЕ КОТОРОГО РАЗГОВОР ТРЁХ ДЕРЖАВ ЗАХЛЕБНЁТСЯ НОВЫМ КРИЗИСОМ.
Dialogue: 0,0:05:36.15,0:05:41.60,Caption,,0,0,0,,ТУДА ЖЕ УКЛАДЫВАЕТСЯ ДАВЛЕНИЕ НА ЕВРОПЕЙСКОМ НАПРАВЛЕНИИ И ИГРА ВОКРУГ КАЛИНИНГРАДА.
Dialogue: 0,0:05:41.60,0:05:46.66,Caption,,0,0,0,,СНАЧАЛА ПОДНЕСТИ СПИЧКУ, ПОТОМ ГРОМЧЕ ВСЕХ ВОЗМУЩАТЬСЯ ТЕМПЕРАТУРОЙ В КОМНАТЕ.
Dialogue: 0,0:05:46.66,0:05:54.06,Caption,,0,0,0,,ПОЧТИ В ТОТ ЖЕ МОМЕНТ КИЕВ И ЛОНДОН ОБЪЯВЛЯЮТ О ПЕРЕНОСЕ ЧАСТИ УКРАИНСКОГО ВОЕННОГО ПРОИЗВОДСТВА В ВЕЛИКОБРИТАНИЮ.
Dialogue: 0,0:05:54.06,0:05:58.86,Caption,,0,0,0,,ТАМ СОБИРАЮТСЯ ВЫПУСКАТЬ УДАРНЫЕ БЕСПИЛОТНИКИ СРЕДНЕЙ И БОЛЬШОЙ ДАЛЬНОСТИ.
Dialogue: 0,0:05:58.86,0:06:01.14,Caption,,0,0,0,,ПРОЕКТИРОВАНИЕ ОСТАЁТСЯ УКРАИНСКИМ.
Dialogue: 0,0:06:01.14,0:06:05.03,Caption,,0,0,0,,БРИТАНСКИЕ ПРЕДПРИЯТИЯ ДАЮТ ПЛОЩАДКИ, ОБОРУДОВАНИЕ И ДЕНЬГИ.
Dialogue: 0,0:06:05.03,0:06:07.11,Caption,,0,0,0,,С ПРАКТИЧЕСКОЙ СТОРОНЫ ВСЁ ЯСНО.
Dialogue: 0,0:06:07.11,0:06:13.92,Caption,,0,0,0,,ЗАВОД НА БРИТАНСКОЙ ТЕРРИТОРИИ РОССИЙСКОЙ РАКЕТЕ ДОСТАТЬ НЕСКОЛЬКО СЛОЖНЕЕ, ЧЕМ ПРЕДПРИЯТИЕ ВОЗЛЕ ЛЬВОВА.
Dialogue: 0,0:06:13.92,0:06:19.05,Caption,,0,0,0,,ГЕОГРАФИЯ ВСЁ ЕЩЁ ИНОГДА РАБОТАЕТ ЛУЧШЕ САМОЙ ДОРОГОЙ ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ.
Dialogue: 0,0:06:19.05,0:06:23.79,Caption,,0,0,0,,НО ВМЕСТЕ С ЛИНИЯМИ СБОРКИ ЗА УКРАИНСКУЮ ГРАНИЦУ ПЕРЕНОСИТСЯ ЧАСТЬ ВОЙНЫ.
Dialogue: 0,0:06:23.79,0:06:29.76,Caption,,0,0,0,,ГОСУДАРСТВО НАТО ПРЕДОСТАВЛЯЕТ СОБСТВЕННУЮ ПРОМЫШЛЕННУЮ БАЗУ ДЛЯ ВЫПУСКА УКРАИНСКОГО ОРУЖИЯ.
Dialogue: 0,0:06:29.76,0:06:38.46,Caption,,0,0,0,,БРИТАНИЯ ПОЛУЧАЕТ ПРОИЗВОДСТВО У СЕБЯ, УКРАИНА ПОЛУЧАЕТ ЗАЩИЩЁННУЮ ПЛОЩАДКУ, А СТЕПЕНЬ ПРЯМОГО ВОВЛЕЧЕНИЯ ЛОНДОНА СТАНОВИТСЯ ЕЩЁ ВЫШЕ.
Dialogue: 0,0:06:38.46,0:06:43.97,Caption,,0,0,0,,ЭТА ПРОИЗВОДСТВЕННАЯ СХЕМА НЕ УСТАНАВЛИВАЕТ БРИТАНСКОЕ УЧАСТИЕ В НАПАДЕНИИ В БЕНГАЗИ.
Dialogue: 0,0:06:43.97,0:06:46.37,Caption,,0,0,0,,ОНА ПОКАЗЫВАЕТ БОЛЕЕ КРУПНЫЙ ПРОЦЕСС.
Dialogue: 0,0:06:46.37,0:06:51.30,Caption,,0,0,0,,УКРАИНСКИЙ ВОЕННО ПРОМЫШЛЕННЫЙ КОМПЛЕКС БОЛЬШЕ НЕ ПОМЕЩАЕТСЯ ВНУТРИ УКРАИНЫ.
Dialogue: 0,0:06:51.30,0:07:00.84,Caption,,0,0,0,,ЕГО ЦЕХА ПОСТЕПЕННО РАСПОЛЗАЮТСЯ ПО СТРАНАМ, КОТОРЫЕ НАЗЫВАЮТ СЕБЯ ПОМОЩНИКАМИ, ХОТЯ ОБОРУДОВАНИЕ У НИХ УЖЕ РАБОТАЕТ ВПОЛНЕ ПО ВОЕННОМУ РАСПИСАНИЮ.
Dialogue: 0,0:07:00.84,0:07:07.40,Caption,,0,0,0,,НА ФОНЕ РАКЕТНЫХ ЗАВОДОВ И МОРСКИХ АТАК ОДИН ИЗ САМЫХ ЦЕННЫХ ФРОНТОВЫХ ТОВАРОВ ВЫГЛЯДИТ ПОЧТИ СМЕШНО.
Dialogue: 0,0:07:07.40,0:07:13.50,Caption,,0,0,0,,ЭТО ОБЫЧНОЕ ОПТОВОЛОКНО. ВЕСНОЙ КИЛОМЕТР ХОРОШЕГО КАБЕЛЯ ПРОДАВАЛСЯ ПРИМЕРНО ЗА ЧЕТЫРЕ ДОЛЛАРА.
Dialogue: 0,0:07:13.50,0:07:15.84,Caption,,0,0,0,,ТЕПЕРЬ ЦЕНА ПРИБЛИЗИЛАСЬ К ТРИДЦАТИ.
Dialogue: 0,0:07:15.84,0:07:24.21,Caption,,0,0,0,,ПОДОРОЖАНИЕ ПРЕВЫСИЛО ШЕСТЬ РАЗ, И ЭТО УЖЕ НЕ МЕЛКАЯ СТРОЧКА В СМЕТЕ, КОТОРУЮ БУХГАЛТЕР МОЖЕТ СПРЯТАТЬ МЕЖДУ СКРЕПКАМИ И БУМАГОЙ.
Dialogue: 0,0:07:24.21,0:07:26.48,Caption,,0,0,0,,ГЛАВНЫМ ПОСТАВЩИКОМ ОСТАЁТСЯ КИТАЙ.
Dialogue: 0,0:07:26.48,0:07:32.71,Caption,,0,0,0,,ЗА КИТАЙСКОЕ ВОЛОКНО ОДНОВРЕМЕННО БОРЮТСЯ РОССИЙСКИЕ И УКРАИНСКИЕ ПРОИЗВОДИТЕЛИ ВОЕННОЙ ТЕХНИКИ.
Dialogue: 0,0:07:32.71,0:07:36.02,Caption,,0,0,0,,РЯДОМ СТОИТ ТРЕТИЙ ПОКУПАТЕЛЬ С ОГРОМНЫМ АППЕТИТОМ.
Dialogue: 0,0:07:36.02,0:07:40.11,Caption,,0,0,0,,ЦЕНТРЫ ОБРАБОТКИ ДАННЫХ, ОБСЛУЖИВАЮЩИЕ ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ.
Dialogue: 0,0:07:40.11,0:07:44.65,Caption,,0,0,0,,ПОКА ТОВАР ДЕШЁВЫЙ, ЛИШНИЙ УЧАСТНИК ЦЕПОЧКИ ПРОСТО ПОЛУЧАЕТ СВОЮ ДОЛЮ.
Dialogue: 0,0:07:44.65,0:07:55.23,Caption,,0,0,0,,КОГДА СТОИМОСТЬ РАСТЁТ В НЕСКОЛЬКО РАЗ, КАЖДЫЙ ПОСРЕДНИК НАЧИНАЕТ ВЫГЛЯДЕТЬ КАК ЧЕЛОВЕК, КОТОРЫЙ ПРИНЁС К СТОЛУ ПУСТУЮ ТАРЕЛКУ, НО СЧЁТ ПОПРОСИЛ РАЗДЕЛИТЬ ПОРОВНУ.
Dialogue: 0,0:07:55.23,0:08:04.77,Caption,,0,0,0,,ОСНОВАТЕЛЬ УКРАИНСКОЙ КОМПАНИИ TAF INDUSTRIES АЛЕКСАНДР ЯКОВЕНКО ОЦЕНИВАЕТ СТОИМОСТЬ КАБЕЛЯ ДЛЯ ОДНОГО БЕСПИЛОТНИКА УЖЕ В СУММУ ДО ТЫСЯЧИ ДОЛЛАРОВ.
Dialogue: 0,0:08:04.77,0:08:09.96,Caption,,0,0,0,,И ЭТО ТОЛЬКО ОПТОВОЛОКНО, БЕЗ САМОГО АППАРАТА, КАМЕРЫ, ДВИГАТЕЛЯ И БОЕВОЙ ЧАСТИ.
Dialogue: 0,0:08:09.96,0:08:14.96,Caption,,0,0,0,,РОССИЯ В ЭТО ВРЕМЯ РАСШИРЯЕТ ИСПОЛЬЗОВАНИЕ ОПТОВОЛОКОННЫХ АППАРАТОВ «МОЛНИЯ».
Dialogue: 0,0:08:14.96,0:08:21.13,Caption,,0,0,0,,УКРАИНСКИЙ СПЕЦИАЛИСТ СЕРГЕЙ БЕСКРЕСТНОВ СООБЩАЕТ ОБ ИХ ПОЯВЛЕНИИ СРАЗУ НА НЕСКОЛЬКИХ УЧАСТКАХ.
Dialogue: 0,0:08:21.13,0:08:25.22,Caption,,0,0,0,,ЗАЯВЛЕННАЯ ГЛУБИНА ПРОНИКНОВЕНИЯ ДОСТИГАЕТ ТРИДЦАТИ КИЛОМЕТРОВ.
Dialogue: 0,0:08:25.22,0:08:32.03,Caption,,0,0,0,,АППАРАТ СПОСОБЕН ЛЕТЕТЬ ПРИМЕРНО В ПЯТИДЕСЯТИ МЕТРАХ НАД ЗЕМЛЁЙ, ВЕСТИ РАЗВЕДКУ И ПЕРЕДАВАТЬ ИЗОБРАЖЕНИЕ.
Dialogue: 0,0:08:32.03,0:08:36.38,Caption,,0,0,0,,РАДИОКАНАЛ ОТСУТСТВУЕТ, ПОЭТОМУ ОБЫЧНОМУ ПОДАВЛЕНИЮ НЕЧЕГО ГЛУШИТЬ.
Dialogue: 0,0:08:36.38,0:08:42.28,Caption,,0,0,0,,ЭЛЕКТРОННАЯ БОРЬБА МОЖЕТ БЫТЬ СКОЛЬКО УГОДНО МОЩНОЙ, НО КАБЕЛЬ ЕЁ ВПЕЧАТЛЕНИЙ НЕ РАЗДЕЛЯЕТ.
Dialogue: 0,0:08:42.28,0:08:44.75,Caption,,0,0,0,,САМ ПРИНЦИП ИСПЫТЫВАЛСЯ ЕЩЁ ГОД НАЗАД.
Dialogue: 0,0:08:44.75,0:08:51.50,Caption,,0,0,0,,НОВОСТЬ СОСТОИТ В МАСШТАБЕ. ОТ ОТДЕЛЬНЫХ ОПЫТНЫХ ЗАПУСКОВ ПЕРЕШЛИ К БОЛЕЕ ЗАМЕТНОМУ ПРИМЕНЕНИЮ НА ФРОНТЕ.
Dialogue: 0,0:08:51.50,0:08:57.08,Caption,,0,0,0,,ИНОГДА ПРЕИМУЩЕСТВО СОЗДАЁТ НЕ СЕКРЕТНАЯ ЛАБОРАТОРИЯ И НЕ УЧЁНЫЙ С БЕЗУМНОЙ ПРИЧЁСКОЙ.
Dialogue: 0,0:08:57.08,0:09:05.26,Caption,,0,0,0,,ЕГО ПОЛУЧАЕТ ТОТ, КТО ВОВРЕМЯ ЗАКАЗАЛ КИТАЙСКОМУ ПОСТАВЩИКУ НЕСКОЛЬКО БОЛЬШИХ ПАРТИЙ И НЕ ТОРГОВАЛСЯ ЗА ПОСЛЕДНИЕ ТРИ КОПЕЙКИ.
Dialogue: 0,0:09:05.26,0:09:10.00,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ, ЕСЛИ ВАМ ИНТЕРЕСНА ИМЕННО ТАКАЯ ИЗНАНКА СОБЫТИЙ.
Dialogue: 0,0:09:10.00,0:09:17.14,Caption,,0,0,0,,БОЛЬШИЕ ПЕРЕМЕНЫ ЧАСТО НАЧИНАЮТСЯ НЕ С ГРОМКОЙ РЕЧИ, А СО СЧЁТА ЗА КАБЕЛЬ, КОТОРЫЙ ВНЕЗАПНО ВЫРОС В ШЕСТЬ РАЗ.
Dialogue: 0,0:09:17.14,0:09:22.59,Caption,,0,0,0,,СОВРЕМЕННАЯ ВОЙНА ПРИ ЭТОМ НЕ ПРЕВРАТИЛАСЬ ИСКЛЮЧИТЕЛЬНО В СОРЕВНОВАНИЕ ЭЛЕКТРОНИКИ.
Dialogue: 0,0:09:22.59,0:09:31.41,Caption,,0,0,0,,ПОД КУПЯНСКОМ ОПЕРАЦИЯ «ВЕЛЕС» НАПОМНИЛА, ЧТО СТАРЫЙ ГАЗОПРОВОД СПОСОБЕН ОКАЗАТЬСЯ НЕ МЕНЕЕ ПОЛЕЗНЫМ МАРШРУТОМ, ЧЕМ ДОРОГОЙ БЕСПИЛОТНИК.
Dialogue: 0,0:09:31.41,0:09:37.71,Caption,,0,0,0,,ПО СООБЩЕНИЮ CNN, УКРАИНСКИЕ ВОЕННОСЛУЖАЩИЕ ПРЕОДОЛЕЛИ ВНУТРИ ТРУБЫ БОЛЬШЕ ПЯТНАДЦАТИ КИЛОМЕТРОВ.
Dialogue: 0,0:09:37.71,0:09:41.15,Caption,,0,0,0,,НАЗВАТЬ ЭТО ОБЫЧНЫМ ПЕРЕХОДОМ ЯЗЫК НЕ ПОВОРАЧИВАЕТСЯ.
Dialogue: 0,0:09:41.15,0:09:48.35,Caption,,0,0,0,,НА ЧАСТИ ПУТИ ПРОСТРАНСТВА НЕ ХВАТАЛО ДАЖЕ ДЛЯ ДВИЖЕНИЯ НА ЧЕТВЕРЕНЬКАХ, ПОЭТОМУ ЛЮДЯМ ПРИХОДИЛОСЬ ПОЛЗТИ ЛЁЖА.
Dialogue: 0,0:09:48.35,0:09:56.21,Caption,,0,0,0,,ПОДГОТОВКА ЗАНЯЛА МЕСЯЦЫ. ВОЕННОСЛУЖАЩИХ ЗАРАНЕЕ ТРЕНИРОВАЛИ В ШАХТАХ, ПРИВЫКАЯ К ТЕСНОТЕ И ДОЛГОМУ НАХОЖДЕНИЮ ПОД ЗЕМЛЁЙ.
Dialogue: 0,0:09:56.21,0:10:04.58,Caption,,0,0,0,,ИТОГОМ ОПЕРАЦИИ СТАЛО ПЛЕНЕНИЕ БОЛЕЕ ТРИДЦАТИ РОССИЙСКИХ ВОЕННЫХ И ПЕРЕКРЫТИЕ МАРШРУТА, ПОЗВОЛЯВШЕГО ОБХОДИТЬ УКРАИНСКУЮ ОБОРОНУ.
Dialogue: 0,0:10:04.58,0:10:13.34,Caption,,0,0,0,,ВОТ ДВЕ КАРТИНКИ ОДНОЙ ВОЙНЫ. В ОДНОМ МЕСТЕ БЕСПИЛОТНИК ПРОХОДИТ ТРИДЦАТЬ КИЛОМЕТРОВ, ОСТАВЛЯЯ ЗА СОБОЙ ДОРОГУЮ НИТЬ КИТАЙСКОГО ВОЛОКНА.
Dialogue: 0,0:10:13.34,0:10:20.28,Caption,,0,0,0,,В ДРУГОМ ЛЮДИ ПРЕОДОЛЕВАЮТ ПЯТНАДЦАТЬ КИЛОМЕТРОВ ВНУТРИ ТРУБЫ, ГДЕ ДАЖЕ РАЗВЕРНУТЬСЯ МОЖНО ТОЛЬКО В МЕЧТАХ.
Dialogue: 0,0:10:20.28,0:10:27.42,Caption,,0,0,0,,НОВЕЙШАЯ ЭЛЕКТРОНИКА ВСТРЕТИЛАСЬ С МЕТОДОМ, КОТОРЫЙ НЕ ТРЕБУЕТ СПУТНИКОВ, РАДИОСИГНАЛА И КРАСИВОЙ ПРЕЗЕНТАЦИИ.
Dialogue: 0,0:10:27.42,0:10:29.43,Caption,,0,0,0,,ОБА СПОСОБА РЕШАЮТ ОДНУ ЗАДАЧУ.
Dialogue: 0,0:10:29.43,0:10:33.85,Caption,,0,0,0,,ДОСТАВИТЬ ОРУЖИЕ И ЛЮДЕЙ ТУДА, ГДЕ ИХ ПОЯВЛЕНИЕ СЧИТАЛИ НЕВОЗМОЖНЫМ.
Dialogue: 0,0:10:33.85,0:10:42.28,Caption,,0,0,0,,НАД ВСЕМИ ЭТИМИ ФРОНТОВЫМИ НАХОДКАМИ СУЩЕСТВУЕТ ДРУГОЙ ЭТАЖ ПРОТИВОСТОЯНИЯ, ГДЕ РАССТОЯНИЯ ИЗМЕРЯЮТСЯ УЖЕ НЕ ДЕСЯТКАМИ КИЛОМЕТРОВ.
Dialogue: 0,0:10:42.28,0:10:53.71,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ ИНСТИТУТ СТРАТЕГИЧЕСКИХ ИССЛЕДОВАНИЙ СООБЩАЕТ, ЧТО РОССИЯ НАЧАЛА РАЗВЁРТЫВАТЬ МЕЖКОНТИНЕНТАЛЬНЫЕ РАКЕТЫ «САРМАТ» В ШЕСТЬДЕСЯТ ВТОРОЙ РАКЕТНОЙ ДИВИЗИИ ВОЗЛЕ УЖУРА.
Dialogue: 0,0:10:53.71,0:10:57.28,Caption,,0,0,0,,НОВЫЕ КОМПЛЕКСЫ ДОЛЖНЫ ЗАМЕНИТЬ ПРЕЖНИЕ ТЯЖЁЛЫЕ РАКЕТЫ.
Dialogue: 0,0:10:57.28,0:11:08.18,Caption,,0,0,0,,В ОПУБЛИКОВАННЫХ ХАРАКТЕРИСТИКАХ УКАЗЫВАЕТСЯ ВОЗМОЖНОСТЬ НЕСТИ ДО ПЯТНАДЦАТИ ЯДЕРНЫХ БЛОКОВ С ИНДИВИДУАЛЬНЫМ НАВЕДЕНИЕМ ЛИБО НЕСКОЛЬКО ГИПЕРЗВУКОВЫХ ПЛАНИРУЮЩИХ БЛОКОВ.
Dialogue: 0,0:11:08.18,0:11:13.44,Caption,,0,0,0,,ЭТО УЖЕ ТОТ СЛУЧАЙ, КОГДА СЛОВО «ПЕРЕГРУЗКА» ОТНОСИТСЯ НЕ К ЧЕМОДАНУ В АЭРОПОРТУ.
Dialogue: 0,0:11:13.44,0:11:16.81,Caption,,0,0,0,,ИСПЫТАТЕЛЬНАЯ ИСТОРИЯ КОМПЛЕКСА СКЛАДЫВАЛАСЬ ТЯЖЕЛО.
Dialogue: 0,0:11:16.81,0:11:22.00,Caption,,0,0,0,,ПОСЛЕ УДАЧНОГО ЗАПУСКА В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОМ ГОДУ НАЧАЛАСЬ ПОЛОСА АВАРИЙ.
Dialogue: 0,0:11:22.00,0:11:29.47,Caption,,0,0,0,,В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТОМ ГОДУ РАКЕТА, СОГЛАСНО ОПУБЛИКОВАННЫМ СВЕДЕНИЯМ, ВЗОРВАЛАСЬ НЕПОСРЕДСТВЕННО В ШАХТЕ.
Dialogue: 0,0:11:29.47,0:11:35.50,Caption,,0,0,0,,В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ ЕЩЁ ОДИН ПУСК ЗАВЕРШИЛСЯ НЕУДАЧЕЙ УЖЕ ПОСЛЕ ВЫХОДА РАКЕТЫ НАРУЖУ.
Dialogue: 0,0:11:35.50,0:11:39.66,Caption,,0,0,0,,В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОМ ГОДУ ПРОШЁЛ ВТОРОЙ УСПЕШНЫЙ ЗАПУСК.
Dialogue: 0,0:11:39.66,0:11:51.01,Caption,,0,0,0,,ПОСЛЕ НЕГО КОМАНДУЮЩИЙ РАКЕТНЫМИ ВОЙСКАМИ СТРАТЕГИЧЕСКОГО НАЗНАЧЕНИЯ СЕРГЕЙ КАРАКАЕВ ЗАЯВИЛ, ЧТО РЕЗУЛЬТАТ ПОЗВОЛЯЕТ ПОСТАВИТЬ КОМПЛЕКС НА БОЕВОЕ ДЕЖУРСТВО ДО ЗАВЕРШЕНИЯ ГОДА.
Dialogue: 0,0:11:51.01,0:11:59.97,Caption,,0,0,0,,ОДНОВРЕМЕННО ВОЗЛЕ ДОМБАРОВСКОГО СНОВА ЗАМЕЧЕНА ТЕХНИКА, КОТОРУЮ ПО СПУТНИКОВЫМ ИЗОБРАЖЕНИЯМ СВЯЗЫВАЮТ С ПОДГОТОВКОЙ ОЧЕРЕДНОГО ИСПЫТАНИЯ.
Dialogue: 0,0:11:59.97,0:12:03.54,Caption,,0,0,0,,ГЛАВНЫЙ ВЫВОД НЕ В ПОЯВЛЕНИИ ЕЩЁ ОДНОЙ ОГРОМНОЙ РАКЕТЫ.
Dialogue: 0,0:12:03.54,0:12:08.08,Caption,,0,0,0,,НЕСМОТРЯ НА АВАРИИ И СЛОЖНУЮ ДОВОДКУ, РОССИЯ НЕ СВОРАЧИВАЕТ ПРОГРАММУ.
Dialogue: 0,0:12:08.08,0:12:17.62,Caption,,0,0,0,,СТРАТЕГИЧЕСКИЕ КОМПЛЕКСЫ ПРОДОЛЖАЮТ РАЗВЁРТЫВАТЬ, ПОКА ЕВРОПЕЙСКИЕ ПОЛИТИКИ ВСЁ ЧАЩЕ РАЗМЫШЛЯЮТ ВСЛУХ, ЧЕМ ЗАКОНЧИТСЯ БЕСКОНЕЧНОЕ ПОВЫШЕНИЕ СТАВОК.
Dialogue: 0,0:12:17.62,0:12:21.71,Caption,,0,0,0,,ФРАНЦУЗСКИЙ ПОЛИТИК ЖАН ЛЮК МЕЛАНШОН ПРЕДЛАГАЕТ НАЧАТЬ С КАРТЫ.
Dialogue: 0,0:12:21.71,0:12:24.50,Caption,,0,0,0,,РОССИЯ ЗАНИМАЕТ ОДИННАДЦАТЬ ЧАСОВЫХ ПОЯСОВ.
Dialogue: 0,0:12:24.50,0:12:30.28,Caption,,0,0,0,,ФРАНЦИЯ ЗАМЕТНО КОМПАКТНЕЕ, КАК НИ КРУТИ ГЛОБУС И КАК НИ ХМУРИТЬ БРОВИ ПЕРЕД ТЕЛЕКАМЕРОЙ.
Dialogue: 0,0:12:30.28,0:12:37.35,Caption,,0,0,0,,ПО ЕГО ЛОГИКЕ, НАНОСИТЬ УДАРЫ ПО МОСКВЕ И ЖДАТЬ В ОТВЕТ ПРИГЛАШЕНИЯ К СПОКОЙНОЙ БЕСЕДЕ ДОВОЛЬНО САМОНАДЕЯННО.
Dialogue: 0,0:12:37.35,0:12:45.76,Caption,,0,0,0,,РОССИЯ ОТВЕТИТ. ДАЛЬШЕ МЕЛАНШОН ПЕРЕВОДИТ РАЗГОВОР К ФРАНЦУЗСКИМ ЯДЕРНЫМ ОБЪЕКТАМ И ФОРМУЛИРУЕТ ИТОГ БЕЗ УБАЮКИВАЮЩИХ ОБОРОТОВ.
Dialogue: 0,0:12:45.76,0:12:50.95,Caption,,0,0,0,,ОДНОГО СЕРЬЁЗНОГО УДАРА ПО НИМ ДОСТАТОЧНО, ЧТОБЫ ФРАНЦИЯ ПЕРЕСТАЛА СУЩЕСТВОВАТЬ.
Dialogue: 0,0:12:50.95,0:12:53.61,Caption,,0,0,0,,ОСОБУЮ СИЛУ ЭТИМ СЛОВАМ ПРИДАЁТ ИХ АВТОР.
Dialogue: 0,0:12:53.61,0:13:01.92,Caption,,0,0,0,,ЭТО ПРОИЗНОСИТ НЕ МОСКОВСКИЙ КОММЕНТАТОР, А ОДИН ИЗ САМЫХ ЗАМЕТНЫХ ФРАНЦУЗСКИХ ПРЕТЕНДЕНТОВ НА ВЫСШУЮ ГОСУДАРСТВЕННУЮ ДОЛЖНОСТЬ.
Dialogue: 0,0:13:01.92,0:13:06.98,Caption,,0,0,0,,МЕЛАНШОН И РАНЬШЕ ВЫСТУПАЛ ПРОТИВ ВТЯГИВАНИЯ ФРАНЦИИ В ПРЯМУЮ ВОЙНУ С РОССИЕЙ.
Dialogue: 0,0:13:06.98,0:13:11.98,Caption,,0,0,0,,ОН ТАКЖЕ НЕ ПОДДЕРЖИВАЛ УЧАСТИЕ СТРАНЫ В СТОЛКНОВЕНИИ С КИТАЕМ ИЗ ЗА ТАЙВАНЯ.
Dialogue: 0,0:13:11.98,0:13:14.51,Caption,,0,0,0,,НЫНЕШНЯЯ ОЦЕНКА ПРОДОЛЖАЕТ ТУ ЖЕ ЛИНИЮ.
Dialogue: 0,0:13:14.51,0:13:22.56,Caption,,0,0,0,,ФРАНЦУЗАМ ПРЕДЛАГАЮТ СНАЧАЛА ПОСЧИТАТЬ, ЧТО ОСТАНЕТСЯ ОТ ФРАНЦИИ, И ЛИШЬ ПОТОМ ВЫБИРАТЬ ВЫРАЖЕНИЕ ЛИЦА ДЛЯ ОБЩЕЙ ФОТОГРАФИИ.
Dialogue: 0,0:13:22.56,0:13:25.80,Caption,,0,0,0,,МАРИН ЛЕ ПЕН ПОДХОДИТ К ПРОБЛЕМЕ С ДРУГОЙ СТОРОНЫ.
Dialogue: 0,0:13:25.80,0:13:28.14,Caption,,0,0,0,,ОНА СЧИТАЕТ НЕ БОЕВЫЕ БЛОКИ, А ЕВРО.
Dialogue: 0,0:13:28.14,0:13:33.98,Caption,,0,0,0,,ПО ЕЁ ДАННЫМ, ЕЖЕГОДНАЯ ПОМОЩЬ УКРАИНЕ ОБХОДИТСЯ ФРАНЦИИ ПРИМЕРНО В ШЕСТЬ МИЛЛИАРДОВ ЕВРО.
Dialogue: 0,0:13:33.98,0:13:38.00,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА ПО ОБЩЕЕВРОПЕЙСКИМ ЗАЙМАМ В ЭТУ СУММУ НЕ ВХОДЯТ.
Dialogue: 0,0:13:38.00,0:13:42.48,Caption,,0,0,0,,ЛЕ ПЕН ОБЕЩАЕТ ПРЕКРАТИТЬ ПРЯМОЕ ФИНАНСИРОВАНИЕ, ЕСЛИ ПОЛУЧИТ ВЛАСТЬ.
Dialogue: 0,0:13:42.48,0:13:45.53,Caption,,0,0,0,,ЭТУ ПОЗИЦИЮ ОНА УЖЕ СООБЩИЛА УКРАИНСКОМУ ПОСЛУ.
Dialogue: 0,0:13:45.53,0:13:49.42,Caption,,0,0,0,,ГУМАНИТАРНЫЕ ПРОГРАММЫ И ОБУЧЕНИЕ ВОЕННОСЛУЖАЩИХ СОХРАНЯТСЯ.
Dialogue: 0,0:13:49.42,0:13:56.24,Caption,,0,0,0,,БЮДЖЕТНЫЕ ПЕРЕВОДЫ КИЕВУ ПРЕКРАТЯТСЯ, ПОТОМУ ЧТО, ПО СЛОВАМ ЛЕ ПЕН, ФРАНЦИЯ БОЛЬШЕ НЕ СПОСОБНА ИХ ТЯНУТЬ.
Dialogue: 0,0:13:56.24,0:13:59.81,Caption,,0,0,0,,ВО ФРАНЦУЗСКОЙ ПОЛИТИКЕ СКЛАДЫВАЕТСЯ ЗАНЯТНАЯ РАЗВИЛКА.
Dialogue: 0,0:13:59.81,0:14:05.20,Caption,,0,0,0,,МЕЛАНШОН ПРЕДУПРЕЖДАЕТ, ЧТО НЫНЕШНИЙ КУРС СПОСОБЕН ЗАКОНЧИТЬСЯ УНИЧТОЖЕНИЕМ СТРАНЫ.
Dialogue: 0,0:14:05.20,0:14:11.04,Caption,,0,0,0,,ЛЕ ПЕН ДОБАВЛЯЕТ, ЧТО ЗА ДВИЖЕНИЕ К ТАКОМУ ФИНАЛУ ФРАНЦИЯ ЕЩЁ И ПЛАТИТ МИЛЛИАРДЫ ЕЖЕГОДНО.
Dialogue: 0,0:14:11.04,0:14:14.93,Caption,,0,0,0,,ПУТЕШЕСТВИЕ СОМНИТЕЛЬНОЕ, ЗАТО СЧЁТ КАК В ХОРОШЕМ РЕСТОРАНЕ.
Dialogue: 0,0:14:14.93,0:14:17.59,Caption,,0,0,0,,ЭТО НЕ ВНЕЗАПНАЯ ПЕРЕМЕНА ПОЗИЦИИ ЛЕ ПЕН.
Dialogue: 0,0:14:17.59,0:14:20.90,Caption,,0,0,0,,ОНА ГОВОРИЛА О ПРЕКРАЩЕНИИ ФИНАНСИРОВАНИЯ И РАНЬШЕ.
Dialogue: 0,0:14:20.90,0:14:25.25,Caption,,0,0,0,,НОВЫМ СТАЛО ПРЯМОЕ ПОДТВЕРЖДЕНИЕ ЭТИХ НАМЕРЕНИЙ УКРАИНСКОЙ СТОРОНЕ.
Dialogue: 0,0:14:25.25,0:14:30.44,Caption,,0,0,0,,ПОКА ПАРИЖ СПОРИТ О РАСХОДАХ И РИСКАХ, ЛОНДОН РАСШИРЯЕТ УКРАИНСКОЕ ПРОИЗВОДСТВО.
Dialogue: 0,0:14:30.44,0:14:33.10,Caption,,0,0,0,,ЕДИНОЙ ЕВРОПЕЙСКОЙ ЛИНИИ НЕТ ДАЖЕ БЛИЗКО.
Dialogue: 0,0:14:33.10,0:14:38.88,Caption,,0,0,0,,ОДНИ ГОСУДАРСТВА ИЩУТ ВОЗМОЖНОСТЬ ОТСТУПИТЬ ОТ КРАЯ, ДРУГИЕ ПОДВОЗЯТ К НЕМУ НОВЫЕ СТАНКИ.
Dialogue: 0,0:14:38.88,0:14:42.06,Caption,,0,0,0,,ЗА АТЛАНТИКОЙ НАЧИНАЕТСЯ СОБСТВЕННАЯ ПЕРЕСТРОЙКА.
Dialogue: 0,0:14:42.06,0:14:49.39,Caption,,0,0,0,,ПОСЛЕ ПРОМЕЖУТОЧНЫХ ВЫБОРОВ АМЕРИКАНСКИЕ ДЕМОКРАТЫ ФАКТИЧЕСКИ ОТКРЫЛИ ПОДГОТОВКУ К СЛЕДУЮЩЕЙ БОРЬБЕ ЗА БЕЛЫЙ ДОМ.
Dialogue: 0,0:14:49.39,0:14:55.62,Caption,,0,0,0,,СРЕДИ ВОЗМОЖНЫХ ПРЕТЕНДЕНТОВ НАЗЫВАЮТ ГЭВИНА НЬЮСОМА, МАРКА КЕЛЛИ, ДЖОША ШАПИРО И КАМАЛУ ХАРРИС.
Dialogue: 0,0:14:55.62,0:14:57.63,Caption,,0,0,0,,НЬЮСОМ УЖЕ ПРИЕЗЖАЛ НА УКРАИНУ.
Dialogue: 0,0:14:57.63,0:15:03.09,Caption,,0,0,0,,КЕЛЛИ ПОДДЕРЖИВАЕТ НОВЫЕ ПОСТАВКИ ВООРУЖЕНИЙ КИЕВУ И УСИЛЕНИЕ САНКЦИЙ ПРОТИВ РОССИИ.
Dialogue: 0,0:15:03.09,0:15:08.93,Caption,,0,0,0,,ШАПИРО ВЫСТУПАЕТ ЗА БОЛЕЕ ТЕСНОЕ ВОЕННО ПРОМЫШЛЕННОЕ СОТРУДНИЧЕСТВО С УКРАИНСКОЙ СТОРОНОЙ.
Dialogue: 0,0:15:08.93,0:15:12.50,Caption,,0,0,0,,НО БУДУЩИЕ КАНДИДАТЫ ПОКА ОСТАЮТСЯ ЛИШЬ ЧАСТЬЮ КАРТИНЫ.
Dialogue: 0,0:15:12.50,0:15:15.29,Caption,,0,0,0,,НАМНОГО ВАЖНЕЕ СООТНОШЕНИЕ СИЛ В КОНГРЕССЕ.
Dialogue: 0,0:15:15.29,0:15:24.57,Caption,,0,0,0,,СОГЛАСНО ПРИВЕДЁННЫМ ДАННЫМ, ДЕМОКРАТЫ ПОЛУЧИЛИ ПЯТЬДЕСЯТ ШЕСТЬ МЕСТ В СЕНАТЕ И КАК МИНИМУМ ДВЕСТИ ПЯТЬДЕСЯТ СЕМЬ МЕСТ В ПАЛАТЕ ПРЕДСТАВИТЕЛЕЙ.
Dialogue: 0,0:15:24.57,0:15:30.80,Caption,,0,0,0,,ПОСЛЕ НАЧАЛА РАБОТЫ НОВОГО СОСТАВА АДМИНИСТРАЦИЯ ТРАМПА ОКАЖЕТСЯ ПЕРЕД СОВСЕМ ДРУГИМ КОНГРЕССОМ.
Dialogue: 0,0:15:30.80,0:15:35.92,Caption,,0,0,0,,А ВНЕШНЯЯ ПОЛИТИКА СОЕДИНЁННЫХ ШТАТОВ ДЕЛАЕТСЯ НЕ ОДНОЙ ПРЕЗИДЕНТСКОЙ ПОДПИСЬЮ.
Dialogue: 0,0:15:35.92,0:15:43.97,Caption,,0,0,0,,ЧЕРЕЗ ЗАКОНОДАТЕЛЕЙ ПРОХОДЯТ САНКЦИОННЫЕ РЕШЕНИЯ, ФИНАНСИРОВАНИЕ, ИСКЛЮЧЕНИЯ ИЗ ОГРАНИЧЕНИЙ И МНОЖЕСТВО ДРУГИХ ИНСТРУМЕНТОВ.
Dialogue: 0,0:15:43.97,0:15:53.19,Caption,,0,0,0,,ПРЕЗИДЕНТ МОЖЕТ ПРИЙТИ К СОГЛАШЕНИЮ С МОСКВОЙ, ПОСЛЕ ЧЕГО КОНГРЕССМЕНЫ ОТКРОЮТ ПАПКУ И НАЧНУТ ВЫЯСНЯТЬ, ЧТО ИМЕННО ОНИ РАЗРЕШАТ ЕМУ ВЫПОЛНИТЬ.
Dialogue: 0,0:15:53.19,0:16:02.92,Caption,,0,0,0,,СЕНАТОР ТИМ КЕЙН УЖЕ ОБЪЯВИЛ О НАМЕРЕНИИ ПОДНЯТЬ ВОПРОС О ПОСЛЕДСТВИЯХ РОССИЙСКО АМЕРИКАНСКОГО СОГЛАШЕНИЯ, ПРЕДУСМАТРИВАЮЩЕГО СМЯГЧЕНИЕ ЧАСТИ САНКЦИЙ.
Dialogue: 0,0:16:02.92,0:16:07.53,Caption,,0,0,0,,ЗНАЧИТ, ДОГОВОРЁННОСТЬ МЕЖДУ ЛИДЕРАМИ ЕЩЁ НЕ ГАРАНТИРУЕТ ЕЁ ВОПЛОЩЕНИЯ.
Dialogue: 0,0:16:07.53,0:16:11.43,Caption,,0,0,0,,У БОЛЬШОЙ МЕЖДУНАРОДНОЙ СДЕЛКИ ВСЕГДА ЕСТЬ ДОМАШНИЙ ЭКЗАМЕН.
Dialogue: 0,0:16:11.43,0:16:13.76,Caption,,0,0,0,,НЕДОСТАТОЧНО УБЕДИТЬ ДРУГУЮ СТОРОНУ.
Dialogue: 0,0:16:13.76,0:16:20.25,Caption,,0,0,0,,НУЖНО ВЕРНУТЬСЯ В СОБСТВЕННУЮ СТОЛИЦУ И ОБНАРУЖИТЬ ТАМ ЛЮДЕЙ, ГОТОВЫХ ПРЕВРАТИТЬ ОБЕЩАНИЕ В РЕШЕНИЕ.
Dialogue: 0,0:16:20.25,0:16:26.48,Caption,,0,0,0,,ИНОГДА ИМЕННО НА ЭТОМ МЕСТЕ ТОРЖЕСТВЕННАЯ КОНСТРУКЦИЯ И СКЛАДЫВАЕТСЯ, КАК ЗОНТ НА СИЛЬНОМ ВЕТРУ.
Dialogue: 0,0:16:26.48,0:16:32.19,Caption,,0,0,0,,НА УКРАИНЕ ТЕМ ВРЕМЕНЕМ СНОВА ПРОШЛИ МЕРОПРИЯТИЯ, ПОСВЯЩЁННЫЕ ДНЮ ДОСТОИНСТВА И СВОБОДЫ.
Dialogue: 0,0:16:32.19,0:16:39.59,Caption,,0,0,0,,ЗЕЛЕНСКИЙ, БУДАНОВ, СИБИГА, СТЕФАНЧУК И ДРУГИЕ ПРЕДСТАВИТЕЛИ ВЛАСТИ УЧАСТВОВАЛИ В ЦЕРЕМОНИИ ПАМЯТИ НЕБЕСНОЙ СОТНИ.
Dialogue: 0,0:16:39.59,0:16:45.69,Caption,,0,0,0,,ТАК ГОСУДАРСТВО ЕЖЕГОДНО ЗАКРЕПЛЯЕТ ОФИЦИАЛЬНУЮ ОЦЕНКУ СОБЫТИЙ ДВЕ ТЫСЯЧИ ЧЕТЫРНАДЦАТОГО ГОДА.
Dialogue: 0,0:16:45.69,0:16:50.88,Caption,,0,0,0,,РЕШЕНИЕ БЫЛО ВЕРНЫМ, ЖЕРТВЫ ПОЛУЧИЛИ СМЫСЛ, ВЫБРАННЫЙ ПУТЬ НЕ ПОДЛЕЖИТ СОМНЕНИЮ.
Dialogue: 0,0:16:50.88,0:16:56.66,Caption,,0,0,0,,НО С КАЖДЫМ НОВЫМ ГОДОМ РЯДОМ С ЭТОЙ ФОРМУЛОЙ ВСЁ НАСТОЙЧИВЕЕ ВОЗНИКАЕТ НЕУДОБНЫЙ ВОПРОС.
Dialogue: 0,0:16:56.66,0:17:01.14,Caption,,0,0,0,,ЧТО ИЗМЕНИЛОСЬ БЫ, ЕСЛИ БЫ СТРАНА ПРОСТО ДОЖДАЛАСЬ СЛЕДУЮЩИХ ВЫБОРОВ?
Dialogue: 0,0:17:01.14,0:17:08.34,Caption,,0,0,0,,ЕСЛИ ВИКТОР ЯНУКОВИЧ ДЕЙСТВИТЕЛЬНО УТРАТИЛ ПОДДЕРЖКУ БОЛЬШИНСТВА, ЕГО МОЖНО БЫЛО ПОБЕДИТЬ ОБЫЧНЫМ ГОЛОСОВАНИЕМ.
Dialogue: 0,0:17:08.34,0:17:13.73,Caption,,0,0,0,,БЕЗ УЛИЦЫ, ПЕРЕВОРОТА И ПОСЛЕДУЮЩЕЙ ЦЕПОЧКИ СОБЫТИЙ, ЦЕНА КОТОРОЙ ПРОДОЛЖАЕТ РАСТИ.
Dialogue: 0,0:17:13.73,0:17:15.81,Caption,,0,0,0,,ГОТОВОГО ОТВЕТА УЖЕ НЕ ПОЛУЧИТЬ.
Dialogue: 0,0:17:15.81,0:17:19.77,Caption,,0,0,0,,ПРОШЛОЕ НЕ ПОСТАВИШЬ НА ПАУЗУ И НЕ ЗАПУСТИШЬ С ДРУГОГО МЕСТА.
Dialogue: 0,0:17:19.77,0:17:21.78,Caption,,0,0,0,,ЗАТО МОЖНО СЧИТАТЬ ПОСЛЕДСТВИЯ.
Dialogue: 0,0:17:21.78,0:17:30.73,Caption,,0,0,0,,И ЧЕМ ТЯЖЕЛЕЕ СТАНОВИТСЯ ИТОГ, ТЕМ СЛАБЕЕ ДЕЙСТВУЕТ ТРЕБОВАНИЕ ПРОСТО ВЕРИТЬ, ЧТО ВСЁ ПРОИЗОШЕДШЕЕ БЫЛО ЕДИНСТВЕННЫМ ПРАВИЛЬНЫМ ВАРИАНТОМ.
Dialogue: 0,0:17:30.73,0:17:33.07,Caption,,0,0,0,,ЭТА ТЕМА ВНОВЬ ВЫВОДИТ К ЗЕЛЕНСКОМУ.
Dialogue: 0,0:17:33.07,0:17:43.97,Caption,,0,0,0,,ОН УЧАСТВУЕТ В ЦЕРЕМОНИИ, ГОВОРИТ О ДОСТОИНСТВЕ И СВОБОДЕ, А ЗАТЕМ ПОВЫШАЕТ СТАВКИ, ЗАРАНЕЕ ПРОВЕРИВ, СКОЛЬКО ВРЕМЕНИ ВЫДЕРЖАТ УКРАИНСКИЕ МОСТЫ ПОД РОССИЙСКИМИ УДАРАМИ.
Dialogue: 0,0:17:43.97,0:17:48.78,Caption,,0,0,0,,ВОПРОС О МИРЕ ПОЭТОМУ ДАВНО УПИРАЕТСЯ НЕ В КОЛИЧЕСТВО ПРОИЗНЕСЁННЫХ РЕЧЕЙ.
Dialogue: 0,0:17:48.78,0:17:53.45,Caption,,0,0,0,,СЛОВО КОРОТКОЕ, МИКРОФОНОВ МНОГО, ЖЕЛАЮЩИХ ПОВТОРИТЬ ЕГО ВСЕГДА ХВАТАЕТ.
Dialogue: 0,0:17:53.45,0:18:01.63,Caption,,0,0,0,,НАСТОЯЩАЯ ПРОВЕРКА НАЧНЁТСЯ ТОГДА, КОГДА КОМУ ТО ПРИДЁТСЯ ОТКАЗАТЬСЯ ОТ КОНКРЕТНОГО ШАГА, ВЕДУЩЕГО К ДАЛЬНЕЙШЕМУ СТОЛКНОВЕНИЮ.
Dialogue: 0,0:18:01.63,0:18:06.62,Caption,,0,0,0,,ПОКА ЖЕ ОДНИ ГОСУДАРСТВА ПРИНИМАЮТ ДЕКЛАРАЦИИ О НЕДОПУСТИМОСТИ ЯДЕРНОЙ ВОЙНЫ.
Dialogue: 0,0:18:06.62,0:18:08.70,Caption,,0,0,0,,ДРУГИЕ ПЛАНИРУЮТ АТАКИ НА МОСТЫ.
Dialogue: 0,0:18:08.70,0:18:11.17,Caption,,0,0,0,,ТРЕТЬИ ЗАПУСКАЮТ МОРСКИЕ БЕСПИЛОТНИКИ.
Dialogue: 0,0:18:11.17,0:18:14.74,Caption,,0,0,0,,ЧЕТВЁРТЫЕ ПЕРЕНОСЯТ ОРУЖЕЙНЫЕ ЛИНИИ НА ТЕРРИТОРИЮ НАТО.
Dialogue: 0,0:18:14.74,0:18:19.41,Caption,,0,0,0,,ПЯТЫЕ РАЗВОРАЧИВАЮТ МЕЖКОНТИНЕНТАЛЬНЫЕ РАКЕТЫ И ГОТОВЯТ НОВЫЕ ИСПЫТАНИЯ.
Dialogue: 0,0:18:19.41,0:18:24.80,Caption,,0,0,0,,КАЖДЫЙ УЧАСТНИК РАССЧИТЫВАЕТ, ЧТО ИМЕННО ЕГО СЛЕДУЮЩИЙ ХОД ЕЩЁ НЕ СТАНЕТ ПОСЛЕДНИМ.
Dialogue: 0,0:18:24.80,0:18:32.52,Caption,,0,0,0,,ТАК ОБЫЧНО И ВЕДУТ СЕБЯ ЛЮДИ, КОТОРЫЕ НЕСУТ КАНИСТРУ ПО ГОРЯЩЕЙ КОМНАТЕ И СПОРЯТ ТОЛЬКО О ТОМ, КТО ПЕРВЫМ НАЧАЛ КУРИТЬ.
Dialogue: 0,0:18:32.52,0:18:44.72,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, ЧТО ОПАСНЕЕ В ЭТОЙ ЦЕПОЧКЕ: УВЕРЕННОСТЬ ЗЕЛЕНСКОГО В СОБСТВЕННОЙ БЕЗОПАСНОСТИ, АТАКИ НА ПЕРЕПРАВЫ ИЛИ ПОПЫТКА СОРВАТЬ СБЛИЖЕНИЕ РОССИИ, СОЕДИНЁННЫХ ШТАТОВ И КИТАЯ.
