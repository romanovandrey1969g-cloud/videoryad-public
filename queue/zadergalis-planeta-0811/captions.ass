Dialogue: 0,0:00:00.12,0:00:02.52,Caption,,0,0,0,,ЕВРОПА ВДРУГ НАЧАЛА СЛЕДИТЬ ЗА ТРАМПОМ С ТАКИМ
Dialogue: 0,0:00:02.52,0:00:05.72,Caption,,0,0,0,,ВНИМАНИЕМ, БУДТО ОН НЕ ПРЕЗИДЕНТ СОЮЗНОЙ ДЕРЖАВЫ,
Dialogue: 0,0:00:05.96,0:00:08.76,Caption,,0,0,0,,А ПОДОЗРИТЕЛЬНО БОДРЫЙ РОДСТВЕННИК ВОЗЛЕ СЕМЕЙНОГО
Dialogue: 0,0:00:08.76,0:00:11.56,Caption,,0,0,0,,СЕЙФА. КУДА НАПРАВИЛСЯ, КОМУ ПОЗВОНИЛ,
Dialogue: 0,0:00:11.80,0:00:15.72,Caption,,0,0,0,,С КЕМ ВСТРЕТИЛСЯ, ЧТО ПОЛОЖИЛИ ПЕРЕД НИМ НА ПОДПИСЬ И ПОЧЕМУ
Dialogue: 0,0:00:15.80,0:00:17.56,Caption,,0,0,0,,НИКТО ЗАРАНЕЕ НЕ ОТОБРАЛ РУЧКУ.
Dialogue: 0,0:00:18.19,0:00:22.36,Caption,,0,0,0,,МЕРЦ УЖЕ ТРЕБУЕТ, ЧТОБЫ БУДУЩУЮ ДОГОВОРЕННОСТЬ ПО УКРАИНЕ СОГЛАСОВАЛИ
Dialogue: 0,0:00:22.44,0:00:27.24,Caption,,0,0,0,,СО ВСЕМ НАТО. ЕЩЕ НЕМНОГО, И ВОЗЛЕ ТРАМПА ПОСТАВЯТ СПЕЦИАЛЬНОГО ЕВРОПЕЙСКОГО
Dialogue: 0,0:00:27.24,0:00:30.68,Caption,,0,0,0,,ЧИНОВНИКА, КОТОРЫЙ БУДЕТ МЯГКО ПРИДЕРЖИВАТЬ ЕГО ЗА ЛОКОТЬ.
Dialogue: 0,0:00:31.12,0:00:33.64,Caption,,0,0,0,,ПЕРВЫЕ СЕКУНДЫ ЭТО ВЫГЛЯДИТ ЗАБАВНО. ПОТОМ
Dialogue: 0,0:00:33.64,0:00:37.32,Caption,,0,0,0,,СТАНОВИТСЯ ТРЕВОЖНО. СОЮЗНИКИ НЕ КОНТРОЛИРУЮТ КАЖДЫЙ
Dialogue: 0,0:00:37.32,0:00:40.60,Caption,,0,0,0,,ШАГ СОЮЗНИКА, ЕСЛИ УВЕРЕНЫ, ЧТО ОН ИДЕТ ТУДА ЖЕ,
Dialogue: 0,0:00:40.71,0:00:43.80,Caption,,0,0,0,,КУДА И ОНИ. ТАКАЯ НЕРВОЗНОСТЬ ПОЯВЛЯЕТСЯ,
Dialogue: 0,0:00:43.96,0:00:45.80,Caption,,0,0,0,,КОГДА ОБЩИЙ МАРШРУТ ЗАКОНЧИЛСЯ,
Dialogue: 0,0:00:46.06,0:00:49.08,Caption,,0,0,0,,А ГЛАВНЫЙ ПАССАЖИР ВНЕЗАПНО ВЫЗВАЛ СЕБЕ ОТДЕЛЬНОЕ
Dialogue: 0,0:00:49.08,0:00:53.08,Caption,,0,0,0,,ТАКСИ. КСТАТИ, ПОДПИШИТЕСЬ НА КАНАЛ. ЗДЕСЬ МЫ РАЗБИРАЕМ НЕ ТОЛЬКО
Dialogue: 0,0:00:53.16,0:00:55.24,Caption,,0,0,0,,СЛОВА ПОЛИТИКОВ, НО И ПРИЧИНУ,
Dialogue: 0,0:00:55.48,0:00:58.68,Caption,,0,0,0,,ПО КОТОРОЙ ИМЕННО ЭТИ СЛОВА ПОЯВИЛИСЬ ИМЕННО СЕЙЧАС.
Dialogue: 0,0:00:58.90,0:01:01.16,Caption,,0,0,0,,ПОСМОТРИТЕ, КАКАЯ СКЛАДЫВАЕТСЯ КАРТИНА.
Dialogue: 0,0:01:01.79,0:01:06.04,Caption,,0,0,0,,МЕРЦ НАСТАИВАЕТ, ЧТО СОГЛАШЕНИЕ ПО УКРАИНЕ ДОЛЖНО ПОЛУЧИТЬ ОДОБРЕНИЕ
Dialogue: 0,0:01:06.04,0:01:09.00,Caption,,0,0,0,,ВСЕГО СЕВЕРОАТЛАНТИЧЕСКОГО АЛЬЯНСА. МЕЛОНИ
Dialogue: 0,0:01:09.00,0:01:12.12,Caption,,0,0,0,,ПРЕДЛАГАЕТ НАЗНАЧИТЬ ЕДИНОГО ПРЕДСТАВИТЕЛЯ ЕВРОСОЮЗА
Dialogue: 0,0:01:12.20,0:01:17.43,Caption,,0,0,0,,ДЛЯ РАЗГОВОРА С ПУТИНЫМ. ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОПАСАЮТСЯ,
Dialogue: 0,0:01:17.75,0:01:20.15,Caption,,0,0,0,,ЧТО ТРАМП ДОГОВОРИТСЯ С МОСКВОЙ САМОСТОЯТЕЛЬНО,
Dialogue: 0,0:01:20.39,0:01:23.11,Caption,,0,0,0,,А ИМ ПОЗДНЕЕ ПРИШЛЮТ ГОТОВЫЙ ДОКУМЕНТ И ПРЕДЛОЖАТ
Dialogue: 0,0:01:23.11,0:01:27.03,Caption,,0,0,0,,ПРОВЕРИТЬ, ПРАВИЛЬНО ЛИ НАПИСАНЫ ИХ НАЗВАНИЯ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:01:27.03,0:01:30.55,Caption,,0,0,0,,НАЧИНАЕТСЯ САМОЕ ЛЮБОПЫТНОЕ. ЕСЛИ ЦЕЛИ ОБЩИЕ,
Dialogue: 0,0:01:30.71,0:01:35.59,Caption,,0,0,0,,ЧЕГО ТАК БЕСПОКОИТЬСЯ? ТРАМП ЗАКЛЮЧАЕТ СОГЛАШЕНИЕ. ЕВРОПА ЕГО ПОДДЕРЖИВАЕТ.
Dialogue: 0,0:01:35.81,0:01:38.71,Caption,,0,0,0,,УКРАИНА СТАВИТ ПОДПИСЬ. УЧАСТНИКИ ОБМЕНИВАЮТСЯ
Dialogue: 0,0:01:38.71,0:01:43.03,Caption,,0,0,0,,РУКОПОЖАТИЯМИ, ФОТОГРАФИРУЮТСЯ ВОЗЛЕ ФЛАГОВ И ОТПРАВЛЯЮТСЯ ДОМОЙ С
Dialogue: 0,0:01:43.11,0:01:45.67,Caption,,0,0,0,,ТОРЖЕСТВЕННЫМИ ЛИЦАМИ. ТОЛЬКО МЕРЦ ЗАРАНЕЕ
Dialogue: 0,0:01:45.67,0:01:50.07,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ, ЧТО ПОДПИСЫВАТЬ БЕЗ ЕВРОПЫ НЕЛЬЗЯ. МЕЛОНИ СООБЩАЕТ,
Dialogue: 0,0:01:50.23,0:01:53.19,Caption,,0,0,0,,ЧТО ЕВРОПЕ СРОЧНО ТРЕБУЕТСЯ СОБСТВЕННЫЙ СОБЕСЕДНИК
Dialogue: 0,0:01:53.19,0:01:55.19,Caption,,0,0,0,,ДЛЯ ПУТИНА. А МОСКВА ОТВЕЧАЕТ,
Dialogue: 0,0:01:55.35,0:01:58.23,Caption,,0,0,0,,ЧТО СОДЕРЖАТЕЛЬНЫХ ЕВРОПЕЙСКИХ ПРЕДЛОЖЕНИЙ ПОКА НЕ
Dialogue: 0,0:01:58.23,0:02:01.35,Caption,,0,0,0,,ПОЛУЧАЛА. ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:02:01.56,0:02:03.83,Caption,,0,0,0,,МЕСТО ЗА СТОЛОМ ПОТРЕБОВАЛИ. ПОЛНОМОЧНОГО
Dialogue: 0,0:02:03.83,0:02:06.47,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЯ НАЧАЛИ ИСКАТЬ. ПРАВО УЧАСТВОВАТЬ В
Dialogue: 0,0:02:06.47,0:02:09.27,Caption,,0,0,0,,БУДУЩЕЙ СДЕЛКЕ ОБЪЯВИЛИ ПОЧТИ НЕОТЪЕМЛЕМЫМ. НЕ
Dialogue: 0,0:02:09.35,0:02:13.83,Caption,,0,0,0,,ХВАТАЕТ СУЩЕЙ МЕЛОЧИ, САМОГО ПРЕДЛОЖЕНИЯ. РЕСТОРАН ПРЕКРАСНЫЙ. СТОЛ
Dialogue: 0,0:02:13.90,0:02:16.95,Caption,,0,0,0,,ЗАРЕЗЕРВИРОВАН. ОФИЦИАНТ ВЫЗВАН. ЛУЧШЕЕ МЕНЮ
Dialogue: 0,0:02:16.95,0:02:21.59,Caption,,0,0,0,,ПРИНЕСЕНО. ОСТАЛОСЬ РЕШИТЬ, БУДУТ ГОСТИ ЧТО НИБУДЬ ЗАКАЗЫВАТЬ ИЛИ ПРОСТО ХОТЯТ
Dialogue: 0,0:02:21.59,0:02:24.87,Caption,,0,0,0,,КОНТРОЛИРОВАТЬ ЧУЖОЙ УЖИН. ЭТУ СУЕТУ МОЖНО ОБЪЯСНИТЬ
Dialogue: 0,0:02:24.87,0:02:28.55,Caption,,0,0,0,,УБЕДИТЕЛЬНЕЕ, ЧЕМ ПРИВЫЧНЫМИ РЕЧАМИ О ЕВРОПЕЙСКОМ ЕДИНСТВЕ.
Dialogue: 0,0:02:30.82,0:02:33.54,Caption,,0,0,0,,ЕВРОПУ ТРЕВОЖИТ НЕ ЖЕЛАНИЕ ТРАМПА ДОГОВОРИТЬСЯ,
Dialogue: 0,0:02:33.70,0:02:36.10,Caption,,0,0,0,,А СПОСОБ, КОТОРЫМ ОН НАМЕРЕН ЭТО СДЕЛАТЬ.
Dialogue: 0,0:02:36.74,0:02:39.54,Caption,,0,0,0,,МНОГО ЛЕТ СОЕДИНЕННЫЕ ШТАТЫ И ЕВРОПЕЙСКИЕ СТРАНЫ
Dialogue: 0,0:02:39.54,0:02:42.74,Caption,,0,0,0,,ДЕЙСТВОВАЛИ ПРОТИВ РОССИИ ВНУТРИ ОДНОЙ СИСТЕМЫ. ОНИ
Dialogue: 0,0:02:42.82,0:02:46.26,Caption,,0,0,0,,СПОРИЛИ О РАСХОДАХ, ПЕРЕКЛАДЫВАЛИ ОБЯЗАТЕЛЬСТВА ДРУГ НА ДРУГА,
Dialogue: 0,0:02:46.42,0:02:49.54,Caption,,0,0,0,,ТРЕБОВАЛИ НОВЫХ ВЗНОСОВ И ИЗОБРАЖАЛИ ТЯЖЕЛЕЙШИЙ
Dialogue: 0,0:02:49.54,0:02:52.98,Caption,,0,0,0,,СЕМЕЙНЫЙ КОНФЛИКТ. НО СИЛОВАЯ ОСНОВА ОСТАВАЛАСЬ
Dialogue: 0,0:02:52.98,0:02:55.70,Caption,,0,0,0,,ОБЩЕЙ. АМЕРИКА ОБЕСПЕЧИВАЛА ВОЕННУЮ МОЩЬ,
Dialogue: 0,0:02:55.85,0:02:58.02,Caption,,0,0,0,,РАЗВЕДКУ, ПЕРЕВОЗКИ И СНАБЖЕНИЕ,
Dialogue: 0,0:02:58.26,0:03:01.30,Caption,,0,0,0,,ПОЛИТИЧЕСКОЕ ПРИКРЫТИЕ, ФИНАНСОВЫЕ ИНСТРУМЕНТЫ,
Dialogue: 0,0:03:01.46,0:03:04.66,Caption,,0,0,0,,ДОЛЛАРОВУЮ ИНФРАСТРУКТУРУ И ОГРОМНЫЕ МОЩНОСТИ
Dialogue: 0,0:03:04.66,0:03:07.14,Caption,,0,0,0,,ОБОРОННОЙ ПРОМЫШЛЕННОСТИ. ЕВРОПА МОГЛА
Dialogue: 0,0:03:07.14,0:03:09.62,Caption,,0,0,0,,ДЕМОНСТРИРОВАТЬ УДИВИТЕЛЬНУЮ ПРИНЦИПИАЛЬНОСТЬ,
Dialogue: 0,0:03:09.86,0:03:12.26,Caption,,0,0,0,,ПОКА ЗА ЕЕ ПЛЕЧОМ СТОЯЛ ЧЕЛОВЕК РОСТОМ ПОД
Dialogue: 0,0:03:12.26,0:03:15.38,Caption,,0,0,0,,ДВА МЕТРА И ВЕСОМ ПРИМЕРНО СТО ДВАДЦАТЬ КИЛОГРАММОВ.
Dialogue: 0,0:03:15.66,0:03:17.86,Caption,,0,0,0,,ОЧЕНЬ ЛЕГКО РАССКАЗЫВАТЬ СОСЕДУ О СОБСТВЕННОЙ
Dialogue: 0,0:03:17.86,0:03:21.06,Caption,,0,0,0,,ГРОЗНОСТИ, ЕСЛИ РЯДОМ МОЛЧА РАЗМИНАЕТСЯ ТАЙСОН.
Dialogue: 0,0:03:21.62,0:03:23.54,Caption,,0,0,0,,НО ТЕПЕРЬ ТАЙСОН ПОСМОТРЕЛ НА ЧАСЫ,
Dialogue: 0,0:03:23.78,0:03:27.38,Caption,,0,0,0,,ВСПОМНИЛ О ДРУГИХ ВСТРЕЧАХ И СОБРАЛСЯ УХОДИТЬ. ПОСЛЕ
Dialogue: 0,0:03:27.46,0:03:30.10,Caption,,0,0,0,,ЭТОГО РАЗГОВОР СТАНОВИТСЯ ГОРАЗДО КОРОЧЕ. ПРЕЖНИЙ
Dialogue: 0,0:03:30.10,0:03:33.14,Caption,,0,0,0,,РАСЧЕТ ЕВРОПЫ НЕ ПРЕДПОЛАГАЛ, ЧТО ГЕРМАНИЯ,
Dialogue: 0,0:03:33.30,0:03:38.02,Caption,,0,0,0,,ФРАНЦИЯ, ПОЛЬША, БРИТАНИЯ И ОСТАЛЬНЫЕ ОДНАЖДЫ ОСТАНУТСЯ НАПРОТИВ
Dialogue: 0,0:03:38.02,0:03:40.66,Caption,,0,0,0,,РОССИИ И БУДУТ ПРОВЕРЯТЬ ПРЕДЕЛ СОБСТВЕННЫХ
Dialogue: 0,0:03:40.74,0:03:42.82,Caption,,0,0,0,,ВОЗМОЖНОСТЕЙ БЕЗ АМЕРИКАНСКОЙ ПОДДЕРЖКИ.
Dialogue: 0,0:03:43.37,0:03:46.10,Caption,,0,0,0,,РАСЧЕТ ДЕРЖАЛСЯ НА ОБЩЕЙ СИСТЕМЕ С СОЕДИНЕННЫМИ
Dialogue: 0,0:03:46.10,0:03:51.49,Caption,,0,0,0,,ШТАТАМИ. ТЕПЕРЬ ИЗ НЕЕ ВЫПАДАЕТ ЦЕНТРАЛЬНАЯ ДЕТАЛЬ. НЕ
Dialogue: 0,0:03:51.49,0:03:54.93,Caption,,0,0,0,,ЛАТВИЯ. НЕ ЛЮКСЕМБУРГ. НЕ ОЧЕРЕДНАЯ БРЮССЕЛЬСКАЯ
Dialogue: 0,0:03:54.93,0:03:57.57,Caption,,0,0,0,,КОМИССИЯ С ДЛИННЫМ НАЗВАНИЕМ. АМЕРИКА.
Dialogue: 0,0:03:58.31,0:04:00.37,Caption,,0,0,0,,ПРИ ЭТОМ ТРАМП НЕ ОБЪЯСНЯЕТ ЕВРОПЕЙЦАМ,
Dialogue: 0,0:04:00.53,0:04:04.45,Caption,,0,0,0,,ЧТО ОНИ БЫЛИ НЕПРАВЫ, А ОН СТАНЕТ ДОБРЫМ МИРОТВОРЦЕМ И ВСЕХ ПОМИРИТ.
Dialogue: 0,0:04:04.97,0:04:08.13,Caption,,0,0,0,,У НЕГО ДРУГАЯ МОТИВАЦИЯ. СОЕДИНЕННЫМ ШТАТАМ НУЖНЫ
Dialogue: 0,0:04:08.13,0:04:11.17,Caption,,0,0,0,,РЫНКИ, РЕСУРСЫ, ПРИБЫЛЬНЫЕ СОГЛАШЕНИЯ,
Dialogue: 0,0:04:11.33,0:04:13.89,Caption,,0,0,0,,ВЛИЯНИЕ И КОНТРОЛЬ НАД ВАЖНЕЙШИМИ ПОТОКАМИ.
Dialogue: 0,0:04:14.28,0:04:17.01,Caption,,0,0,0,,ВАШИНГТОН ПРИ ТРАМПЕ НЕ СТАНОВИТСЯ БЛАГОТВОРИТЕЛЬНЫМ
Dialogue: 0,0:04:17.01,0:04:19.81,Caption,,0,0,0,,ФОНДОМ СВЯТОГО ДОНАЛЬДА. МЕНЯЕТСЯ НЕ ЦЕЛЬ,
Dialogue: 0,0:04:20.04,0:04:23.01,Caption,,0,0,0,,А ИНСТРУМЕНТ. ЕСЛИ ЖЕЛАЕМОЕ МОЖНО ПОЛУЧИТЬ ЧЕРЕЗ
Dialogue: 0,0:04:23.01,0:04:27.17,Caption,,0,0,0,,СДЕЛКУ, ЗАЧЕМ ГОДАМИ ОПЛАЧИВАТЬ ПРОТИВОСТОЯНИЕ БЕЗ ЯСНОЙ
Dialogue: 0,0:04:27.17,0:04:31.49,Caption,,0,0,0,,ДАТЫ ОКОНЧАНИЯ? ИМЕННО ЗДЕСЬ ПРЕЖНИЕ СОЮЗНИКИ НАЧИНАЮТ РАСХОДИТЬСЯ.
Dialogue: 0,0:04:32.05,0:04:34.61,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ СТРАТЕГИЯ СТРОИЛАСЬ НА САНКЦИЯХ,
Dialogue: 0,0:04:34.77,0:04:38.93,Caption,,0,0,0,,ДАВЛЕНИИ, ПОМОЩИ УКРАИНЕ И ПОСТЕПЕННОМ ИСТОЩЕНИИ РОССИИ.
Dialogue: 0,0:04:39.32,0:04:41.89,Caption,,0,0,0,,ПРЕДПОЛАГАЛОСЬ, ЧТО МОСКВА ЛИБО НЕ ВЫДЕРЖИТ,
Dialogue: 0,0:04:42.05,0:04:45.73,Caption,,0,0,0,,ЛИБО ОСЛАБНЕТ НАСТОЛЬКО, ЧТО УСЛОВИЯ ЕЙ БУДУТ НЕ ПРЕДЛАГАТЬ,
Dialogue: 0,0:04:45.81,0:04:48.61,Caption,,0,0,0,,А ПЕРЕЧИСЛЯТЬ. ЗА ЭТИМ ВИДЕН И БОЛЕЕ ДАЛЬНИЙ
Dialogue: 0,0:04:48.61,0:04:51.65,Caption,,0,0,0,,ИНТЕРЕС. ОСЛАБЛЕННАЯ РОССИЯ МОГЛА БЫ ОТКРЫТЬ ДОСТУП
Dialogue: 0,0:04:51.73,0:04:53.81,Caption,,0,0,0,,К СВОИМ РЕСУРСАМ НА УСЛОВИЯХ ПОБЕДИТЕЛЕЙ.
Dialogue: 0,0:04:54.42,0:04:57.09,Caption,,0,0,0,,ТРАМП СМОТРИТ НА ЭТОТ ЗАМЫСЕЛ И ЗАДАЕТ ВОПРОС,
Dialogue: 0,0:04:57.42,0:05:00.53,Caption,,0,0,0,,КОТОРЫЙ ТРУДНО НЕ НАЗВАТЬ АМЕРИКАНСКИМ. СКОЛЬКО ЕЩЕ
Dialogue: 0,0:05:00.53,0:05:05.09,Caption,,0,0,0,,БУДЕТ СТОИТЬ ЭТОТ АТТРАКЦИОН? И КАКОЙ ПРИЗ ПОЛУЧАТ СОЕДИНЕННЫЕ ШТАТЫ?
Dialogue: 0,0:05:05.40,0:05:09.61,Caption,,0,0,0,,НЕ ЛОЗУНГ. НЕ РЕЗОЛЮЦИЮ,
Dialogue: 0,0:05:09.73,0:05:12.89,Caption,,0,0,0,,КОТОРУЮ НИКТО НЕ ДОЧИТАЕТ. НЕ ОЧЕРЕДНОЙ ГРУППОВОЙ
Dialogue: 0,0:05:12.89,0:05:16.01,Caption,,0,0,0,,СНИМОК ИЗ БРЮССЕЛЯ. КАКОВ КОНКРЕТНЫЙ РЕЗУЛЬТАТ ДЛЯ
Dialogue: 0,0:05:16.01,0:05:20.09,Caption,,0,0,0,,АМЕРИКИ? НА ЭТОМ МЕСТЕ СОЮЗНАЯ КОНСТРУКЦИЯ НАЧИНАЕТ НЕПРИЯТНО
Dialogue: 0,0:05:20.09,0:05:22.25,Caption,,0,0,0,,ПОСКРИПЫВАТЬ. ЕСЛИ ТРАМП РЕШИТ,
Dialogue: 0,0:05:22.44,0:05:25.53,Caption,,0,0,0,,ЧТО ПРЯМОЕ СОГЛАШЕНИЕ С РОССИЕЙ ВЫГОДНЕЕ ПРЕЖНЕГО
Dialogue: 0,0:05:25.53,0:05:29.37,Caption,,0,0,0,,КУРСА, ЕВРОПЕЙСКУЮ СТРАТЕГИЮ НИКТО НЕ ЗАПРЕЩАЕТ. ХОТИТЕ
Dialogue: 0,0:05:29.37,0:05:33.77,Caption,,0,0,0,,ПРОДОЛЖАТЬ ДАВЛЕНИЕ? ПРОДОЛЖАЙТЕ. ТОЛЬКО УЖЕ САМИ. ДЛЯ ЕВРОПЫ ЭТИ СЛОВА
Dialogue: 0,0:05:33.77,0:05:37.37,Caption,,0,0,0,,СТРАШНЕЕ ПОЛОВИНЫ РОССИЙСКИХ РАКЕТ. ОДНО ДЕЛО ГОДАМИ
Dialogue: 0,0:05:37.37,0:05:40.01,Caption,,0,0,0,,ЗАЯВЛЯТЬ, ЧТО РОССИЮ НЕОБХОДИМО ОСТАНОВИТЬ,
Dialogue: 0,0:05:40.18,0:05:45.05,Caption,,0,0,0,,ОСЛАБИТЬ, НАКАЗАТЬ, ДОЖАТЬ И ПРЕПОДАТЬ ЕЙ ИСТОРИЧЕСКИЙ УРОК. СОВСЕМ
Dialogue: 0,0:05:45.05,0:05:47.77,Caption,,0,0,0,,ДРУГОЕ УСЛЫШАТЬ ИЗ ВАШИНГТОНА ПРЕКРАСНАЯ ИДЕЯ,
Dialogue: 0,0:05:47.93,0:05:51.77,Caption,,0,0,0,,ДЕЙСТВУЙТЕ, А МЫ БОЛЬШЕ НЕ УЧАСТВУЕМ. ТОГДА БЫСТРО ВЫЯСНИТСЯ,
Dialogue: 0,0:05:52.01,0:05:54.65,Caption,,0,0,0,,КАКАЯ ДОЛЯ ПРЕЖНЕЙ СИЛЫ ПРИНАДЛЕЖАЛА ЕВРОПЕ,
Dialogue: 0,0:05:54.97,0:05:57.13,Caption,,0,0,0,,А КАКАЯ ПРЕДОСТАВЛЯЛАСЬ СОЕДИНЕННЫМИ ШТАТАМИ.
Dialogue: 0,0:05:57.53,0:06:00.25,Caption,,0,0,0,,ПОЭТОМУ ТРЕБОВАНИЕ МЕРЦА О СОГЛАСОВАНИИ БУДУЩЕЙ
Dialogue: 0,0:06:00.25,0:06:03.53,Caption,,0,0,0,,СДЕЛКИ СО ВСЕМ НАТО ПРИОБРЕТАЕТ ДРУГОЙ СМЫСЛ. ЭТО
Dialogue: 0,0:06:03.53,0:06:05.93,Caption,,0,0,0,,НЕ ОБЫЧНОЕ ЖЕЛАНИЕ ПОЛУЧИТЬ КРЕСЛО В ПЕРЕГОВОРНОЙ
Dialogue: 0,0:06:06.01,0:06:10.01,Caption,,0,0,0,,КОМНАТЕ, А ПОПЫТКА УДЕРЖАТЬ ГЛАВНОГО УЧАСТНИКА ВНУТРИ ОБЩЕЙ
Dialogue: 0,0:06:10.01,0:06:13.21,Caption,,0,0,0,,СИСТЕМЫ И НЕ ПОЗВОЛИТЬ ЕМУ НАЧАТЬ ОТДЕЛЬНУЮ ПАРТИЮ.
Dialogue: 0,0:06:13.84,0:06:16.17,Caption,,0,0,0,,БЕЗ ПОЛНОЦЕННОГО АМЕРИКАНСКОГО УЧАСТИЯ НАТО
Dialogue: 0,0:06:16.17,0:06:19.69,Caption,,0,0,0,,ФОРМАЛЬНО НИКУДА НЕ ИСЧЕЗНЕТ. ФЛАГИ ОСТАНУТСЯ. ШТАБ
Dialogue: 0,0:06:19.77,0:06:22.65,Caption,,0,0,0,,В БРЮССЕЛЕ ПРОДОЛЖИТ РАБОТАТЬ. СОВЕЩАНИЯ БУДУТ
Dialogue: 0,0:06:22.65,0:06:29.57,Caption,,0,0,0,,ПРОХОДИТЬ ПО РАСПИСАНИЮ. ФОТОГРАФИИ СТАНУТ ЕЩЕ ТОРЖЕСТВЕННЕЕ. НО РЕАЛЬНЫЙ ВЕС
Dialogue: 0,0:06:29.57,0:06:33.41,Caption,,0,0,0,,КОНСТРУКЦИИ ЗАМЕТНО ИЗМЕНИТСЯ. И ТУТ КУШНЕР СООБЩАЕТ
Dialogue: 0,0:06:33.41,0:06:38.53,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ЕЩЕ ОДНУ НОВОСТЬ, ОТ КОТОРОЙ НАСТРОЕНИЕ ЛУЧШЕ НЕ СТАНОВИТСЯ. ВАШИНГТОН
Dialogue: 0,0:06:38.53,0:06:40.93,Caption,,0,0,0,,ОБСУЖДАЕТ НЕ ТОЛЬКО УРЕГУЛИРОВАНИЕ НА УКРАИНЕ.
Dialogue: 0,0:06:41.48,0:06:44.93,Caption,,0,0,0,,РЕЧЬ ИДЕТ О НОВОЙ АРХИТЕКТУРЕ БЕЗОПАСНОСТИ В ЕВРОПЕ,
Dialogue: 0,0:06:45.25,0:06:47.89,Caption,,0,0,0,,ГДЕ ДОЛЖНЫ УЧИТЫВАТЬСЯ В ТОМ ЧИСЛЕ ИНТЕРЕСЫ РОССИИ.
Dialogue: 0,0:06:48.29,0:06:50.77,Caption,,0,0,0,,В ЭТОТ МОМЕНТ У НЕКОТОРЫХ ЕВРОПЕЙСКИХ ЧИНОВНИКОВ
Dialogue: 0,0:06:50.85,0:06:53.41,Caption,,0,0,0,,КОФЕ НАВЕРНЯКА ВЫБРАЛ НЕПРАВИЛЬНОЕ НАПРАВЛЕНИЕ.
Dialogue: 0,0:06:53.80,0:06:57.01,Caption,,0,0,0,,УКРАИНА ЯВЛЯЕТСЯ ОТДЕЛЬНЫМ ВОПРОСОМ. ОГРОМНЫМ,
Dialogue: 0,0:06:57.18,0:07:01.17,Caption,,0,0,0,,ТЯЖЕЛЫМ, КРОВАВЫМ И КРАЙНЕ СЛОЖНЫМ. НО ВСЕ ЖЕ ОТДЕЛЬНЫМ.
Dialogue: 0,0:07:01.63,0:07:04.69,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ БЕЗОПАСНОСТЬ НАХОДИТСЯ ЭТАЖОМ ВЫШЕ. ТАМ
Dialogue: 0,0:07:04.69,0:07:07.65,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ НАТО, БАЗЫ, ВООРУЖЕНИЯ,
Dialogue: 0,0:07:07.74,0:07:11.97,Caption,,0,0,0,,РАЗМЕЩЕНИЕ ВОЙСК, ОГРАНИЧЕНИЯ И ГАРАНТИИ. ТАМ ВЫЯСНЯЮТ,
Dialogue: 0,0:07:12.19,0:07:14.61,Caption,,0,0,0,,КТО ПРЕДСТАВЛЯЕТ УГРОЗУ, КОМУ,
Dialogue: 0,0:07:14.76,0:07:17.81,Caption,,0,0,0,,КАКИМИ СРЕДСТВАМИ И НА КАКОМ РАССТОЯНИИ. ТАМ
Dialogue: 0,0:07:17.89,0:07:19.49,Caption,,0,0,0,,ВОЗНИКАЮТ РОССИЙСКИЕ ТРЕБОВАНИЯ,
Dialogue: 0,0:07:19.75,0:07:22.53,Caption,,0,0,0,,КОТОРЫЕ МОСКВА ВЫДВИГАЛА ЕЩЕ ДО НЫНЕШНЕГО КОНФЛИКТА.
Dialogue: 0,0:07:23.13,0:07:25.41,Caption,,0,0,0,,ЕСЛИ ПЕРЕГОВОРЫ ПОДНИМАЮТСЯ НА ЭТОТ УРОВЕНЬ,
Dialogue: 0,0:07:25.65,0:07:28.37,Caption,,0,0,0,,ПОНЯТНО, ПОЧЕМУ ЕВРОПА ВНЕЗАПНО ВСПОМНИЛА,
Dialogue: 0,0:07:28.61,0:07:31.25,Caption,,0,0,0,,ЧТО ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ НЕЛЬЗЯ ОБСУЖДАТЬ БЕЗ
Dialogue: 0,0:07:31.25,0:07:34.45,Caption,,0,0,0,,ЕВРОПЕЙЦЕВ. ЗВУЧИТ РАЗУМНО. ЕСТЬ ЛИШЬ ОДНА
Dialogue: 0,0:07:34.45,0:07:37.33,Caption,,0,0,0,,НЕПРИЯТНАЯ ПОДРОБНОСТЬ. НЕДОСТАТОЧНО ОБЪЯВИТЬ,
Dialogue: 0,0:07:37.57,0:07:40.77,Caption,,0,0,0,,ЧТО ОБСУЖДАЕМЫЙ ВОПРОС КАСАЕТСЯ ТЕБЯ. НУЖНО ИМЕТЬ
Dialogue: 0,0:07:40.77,0:07:44.53,Caption,,0,0,0,,СИЛУ ОСТАНОВИТЬ РЕШЕНИЕ, ПРИНЯТОЕ БЕЗ ТВОЕГО СОГЛАСИЯ.
Dialogue: 0,0:07:46.80,0:07:49.36,Caption,,0,0,0,,И ЗДЕСЬ НАЧИНАЕТСЯ ПОЛИТИЧЕСКАЯ АРИФМЕТИКА БЕЗ
Dialogue: 0,0:07:49.44,0:07:52.16,Caption,,0,0,0,,СКИДОК. ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЕ ЭТОГО НЕ СДЕЛАЛИ.
Dialogue: 0,0:07:53.18,0:07:55.60,Caption,,0,0,0,,ДАЛЬШЕ УКРАИНСКИЕ ПЕРЕГОВОРЫ ПРЕВРАЩАЮТСЯ ИЗ ВСЕЙ
Dialogue: 0,0:07:55.60,0:07:58.16,Caption,,0,0,0,,КАРТИНЫ ЛИШЬ В ОДИН ЕЕ ВАЖНЫЙ ФРАГМЕНТ.
Dialogue: 0,0:07:58.86,0:08:01.04,Caption,,0,0,0,,НА СЛЕДУЮЩЕЙ НЕДЕЛЕ В АБУ ДАБИ СНОВА ДОЛЖНЫ
Dialogue: 0,0:08:01.12,0:08:02.88,Caption,,0,0,0,,ВСТРЕТИТЬСЯ ПРЕДСТАВИТЕЛИ РОССИИ,
Dialogue: 0,0:08:03.03,0:08:08.48,Caption,,0,0,0,,УКРАИНЫ И СОЕДИНЕННЫХ ШТАТОВ. УКРАИНСКУЮ ДЕЛЕГАЦИЮ ВОЗГЛАВИТ БУДАНОВ. РОССИЙСКУЮ
Dialogue: 0,0:08:08.56,0:08:10.96,Caption,,0,0,0,,СТОРОНУ ПРЕДСТАВЛЯЕТ МЕДИНСКИЙ. НЕТ СМЫСЛА
Dialogue: 0,0:08:10.96,0:08:13.60,Caption,,0,0,0,,УСТРАИВАТЬ ПРЕДСТАВЛЕНИЕ ВОКРУГ ФАМИЛИЙ. ЭТИ ЛЮДИ
Dialogue: 0,0:08:13.68,0:08:18.64,Caption,,0,0,0,,УЖЕ ЗНАКОМЫ. ОНИ ПОНИМАЮТ, НА КАКИХ ВОПРОСАХ СТОРОНЫ ПРЕЖДЕ УПИРАЛИСЬ ЛБАМИ В
Dialogue: 0,0:08:18.72,0:08:21.44,Caption,,0,0,0,,ОДНУ СТЕНУ. ИМ ИЗВЕСТНЫ ТРЕБОВАНИЯ МОСКВЫ,
Dialogue: 0,0:08:21.68,0:08:24.88,Caption,,0,0,0,,ВОЗМОЖНОСТИ КИЕВА И АМЕРИКАНСКИЕ ПРЕДЛОЖЕНИЯ. ОНИ
Dialogue: 0,0:08:24.88,0:08:29.84,Caption,,0,0,0,,ЗНАЮТ, ЧТО МОЖНО ОБСУЖДАТЬ, А ЧТО ПОКА ОСТАЕТСЯ ЗА ПРЕДЕЛАМИ УСТУПОК. ЭТО
Dialogue: 0,0:08:29.92,0:08:32.48,Caption,,0,0,0,,ДАВНО НЕ ПЕРВОЕ СВИДАНИЕ. НИКОМУ НЕ ПОТРЕБУЕТСЯ
Dialogue: 0,0:08:32.56,0:08:34.80,Caption,,0,0,0,,НЕЛОВКО СПРАШИВАТЬ СОБЕСЕДНИКА О РАБОТЕ,
Dialogue: 0,0:08:35.04,0:08:37.60,Caption,,0,0,0,,ЛЮБИМЫХ ФИЛЬМАХ И ПЛАНАХ НА ВЫХОДНЫЕ. ВСЕ
Dialogue: 0,0:08:37.60,0:08:40.96,Caption,,0,0,0,,ПРЕДСТАВЛЕНЫ. ЖЕЛАНИЯ СТОРОН ТОЖЕ ИЗВЕСТНЫ. ПОЭТОМУ
Dialogue: 0,0:08:40.96,0:08:43.84,Caption,,0,0,0,,УКРАИНСКАЯ ЧАСТЬ ПЕРЕГОВОРОВ ВАЖНА НЕ ТЕМ,
Dialogue: 0,0:08:44.08,0:08:47.12,Caption,,0,0,0,,ЧТО ДЕЛЕГАЦИЮ ВОЗГЛАВЛЯЕТ БУДАНОВ. ГЛАВНОЕ В ДРУГОМ.
Dialogue: 0,0:08:47.75,0:08:50.24,Caption,,0,0,0,,КОНТУРЫ ЭТОГО БЛОКА ДОСТАТОЧНО ЯСНО ВИДНЫ.
Dialogue: 0,0:08:50.74,0:08:54.64,Caption,,0,0,0,,ТЕРРИТОРИИ. ГАРАНТИИ. ПРЕКРАЩЕНИЕ УДАРОВ. КОНТРОЛЬ
Dialogue: 0,0:08:54.72,0:08:57.92,Caption,,0,0,0,,ЗА ИСПОЛНЕНИЕМ. ВОЕННЫЕ УСЛОВИЯ. ПОЛИТИЧЕСКИЕ
Dialogue: 0,0:08:57.92,0:09:01.28,Caption,,0,0,0,,РЕШЕНИЯ. СПОРИТЬ ПО КАЖДОМУ ПУНКТУ МОЖНО ДОЛГО.
Dialogue: 0,0:09:03.54,0:09:06.90,Caption,,0,0,0,,НО СТОРОНЫ ЗНАЮТ, ЧТО ЛЕЖИТ НА ПРИЛАВКЕ И ИЗ ЗА ЧЕГО
Dialogue: 0,0:09:06.90,0:09:11.22,Caption,,0,0,0,,ИДЕТ ТОРГ. ВОКРУГ УКРАИНСКОГО БЛОКА ФОРМИРУЕТСЯ БОЛЕЕ ШИРОКАЯ
Dialogue: 0,0:09:11.22,0:09:14.18,Caption,,0,0,0,,РАМКА. ОТНОШЕНИЯ РОССИИ И СОЕДИНЕННЫХ ШТАТОВ.
Dialogue: 0,0:09:14.51,0:09:17.46,Caption,,0,0,0,,ОТНОШЕНИЯ РОССИИ И НАТО. ОТНОШЕНИЯ ЕВРОПЫ С
Dialogue: 0,0:09:17.46,0:09:20.42,Caption,,0,0,0,,АМЕРИКОЙ. БУДУЩЕЕ ВСЕЙ СИСТЕМЫ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:09:20.42,0:09:23.95,Caption,,0,0,0,,БЕЗОПАСНОСТИ. И ЗДЕСЬ КАНЦЛЕРУ ГЕРМАНИИ ТРУДНО
Dialogue: 0,0:09:23.95,0:09:26.98,Caption,,0,0,0,,СОХРАНЯТЬ БЕЗМЯТЕЖНУЮ УЛЫБКУ. В УКРАИНСКОМ ВОПРОСЕ
Dialogue: 0,0:09:26.98,0:09:30.42,Caption,,0,0,0,,ЕВРОПА ЕЩЕ СПОСОБНА ЗАЯВЛЯТЬ, ЧТО ОНА ГЛАВНЫЙ СПОНСОР,
Dialogue: 0,0:09:30.61,0:09:32.98,Caption,,0,0,0,,КОНФЛИКТ ПРОИСХОДИТ РЯДОМ С ЕЕ ГРАНИЦАМИ,
Dialogue: 0,0:09:33.22,0:09:36.18,Caption,,0,0,0,,ЗАТРАГИВАЕТ ЕЕ БЕЗОПАСНОСТЬ И ПОТОМУ РЕШАТЬ БЕЗ НЕЕ
Dialogue: 0,0:09:36.18,0:09:40.02,Caption,,0,0,0,,НЕЛЬЗЯ. ОДНАКО ЕСЛИ ВАШИНГТОН НАЧИНАЕТ НАПРЯМУЮ ОБСУЖДАТЬ С
Dialogue: 0,0:09:40.02,0:09:43.38,Caption,,0,0,0,,МОСКВОЙ ДОЛГОСРОЧНЫЕ ОТНОШЕНИЯ ДВУХ КРУПНЫХ ДЕРЖАВ,
Dialogue: 0,0:09:43.86,0:09:46.83,Caption,,0,0,0,,ПОЛОЖЕНИЕ ЕВРОПЕЙСКИХ СТОЛИЦ МЕНЯЕТСЯ. ОНИ БОЛЬШЕ НЕ
Dialogue: 0,0:09:46.83,0:09:50.10,Caption,,0,0,0,,УПРАВЛЯЮТ ПРОЦЕССОМ. ОНИ СТАНОВЯТСЯ ОДНИМ ИЗ ЕГО
Dialogue: 0,0:09:50.10,0:09:53.22,Caption,,0,0,0,,УЧАСТНИКОВ. ТАКАЯ СМЕНА ДОЛЖНОСТИ РЕДКО РАДУЕТ
Dialogue: 0,0:09:53.22,0:09:57.14,Caption,,0,0,0,,ЧЕЛОВЕКА, КОТОРЫЙ ЕЩЕ ВЧЕРА СЧИТАЛ СЕБЯ НАЧАЛЬНИКОМ. ВЧЕРА ТЫ
Dialogue: 0,0:09:57.14,0:10:01.14,Caption,,0,0,0,,СТОЯЛ ВОЗЛЕ ДОСКИ, ДЕРЖАЛ УКАЗКУ И ОБЪЯСНЯЛ ОКРУЖАЮЩИМ ПРАВИЛА
Dialogue: 0,0:10:01.14,0:10:04.34,Caption,,0,0,0,,ПОВЕДЕНИЯ. СЕГОДНЯ ТЕБЕ УКАЗЫВАЮТ НА СВОБОДНОЕ МЕСТО
Dialogue: 0,0:10:04.42,0:10:08.18,Caption,,0,0,0,,И СООБЩАЮТ, ЧТО ПРАВИЛА БУДУТ ОБСУЖДАТЬ ВСЕ ВМЕСТЕ. ПОЭТОМУ
Dialogue: 0,0:10:08.18,0:10:11.30,Caption,,0,0,0,,МЕЛОНИ ПРЕДЛАГАЕТ СРОЧНО НАЙТИ ЕДИНОГО ЕВРОПЕЙСКОГО
Dialogue: 0,0:10:11.30,0:10:14.26,Caption,,0,0,0,,ПЕРЕГОВОРЩИКА. САМА НЕОБХОДИМОСТЬ ТАКОГО ПОИСКА
Dialogue: 0,0:10:14.26,0:10:17.71,Caption,,0,0,0,,ГОВОРИТ МНОГОЕ. ЕВРОПА ГОДАМИ ВЫСТУПАЛА ОТ ИМЕНИ
Dialogue: 0,0:10:17.71,0:10:23.03,Caption,,0,0,0,,ЕВРОПЫ. НО КАК ТОЛЬКО ВОЗНИК ДЕЙСТВИТЕЛЬНО КРУПНЫЙ РАЗГОВОР,
Dialogue: 0,0:10:23.25,0:10:26.63,Caption,,0,0,0,,ВЫЯСНИЛОСЬ, ЧТО ЧЕЛОВЕКА С ПРИЗНАННЫМ ПРАВОМ ГОВОРИТЬ ЗА ВСЮ
Dialogue: 0,0:10:26.71,0:10:32.39,Caption,,0,0,0,,ЕВРОПУ ЕЩЕ ПРЕДСТОИТ ВЫБРАТЬ. ВЫГЛЯДИТ ВПЕЧАТЛЯЮЩЕ. ДВАДЦАТЬ СЕМЬ ГОСУДАРСТВ.
Dialogue: 0,0:10:32.79,0:10:36.47,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ КОМИССИЯ. ЕВРОПЕЙСКИЙ СОВЕТ. ЕВРОПЕЙСКИЙ
Dialogue: 0,0:10:36.47,0:10:40.31,Caption,,0,0,0,,ПАРЛАМЕНТ. РЯДОМ НАТО. ТЫСЯЧИ ЧИНОВНИКОВ. ГОРЫ
Dialogue: 0,0:10:40.31,0:10:43.19,Caption,,0,0,0,,РЕГЛАМЕНТОВ И ДЕСЯТКИ ТЫСЯЧ СТРАНИЦ СОГЛАСОВАННЫХ
Dialogue: 0,0:10:43.19,0:10:46.31,Caption,,0,0,0,,ДОКУМЕНТОВ. А ПОЗВОНИТЬ ПУТИНУ ОТ ИМЕНИ ВСЕХ НЕКОМУ.
Dialogue: 0,0:10:46.71,0:10:50.79,Caption,,0,0,0,,ВОТ ОНА, ИНСТИТУЦИОНАЛЬНАЯ СВЕРХДЕРЖАВА ВО ВСЕЙ КРАСЕ. ЭТО НЕ
Dialogue: 0,0:10:50.87,0:10:54.07,Caption,,0,0,0,,ПРОСТО ШУТКА. ПЕРЕД ЕВРОПОЙ СТОИТ РЕАЛЬНАЯ ПРОБЛЕМА,
Dialogue: 0,0:10:54.30,0:10:57.11,Caption,,0,0,0,,ПОСКОЛЬКУ ИНТЕРЕСЫ ЕЕ УЧАСТНИКОВ ЗАМЕТНО ОТЛИЧАЮТСЯ.
Dialogue: 0,0:10:57.67,0:11:01.03,Caption,,0,0,0,,ГЕРМАНИЯ СЧИТАЕТ РАСХОДЫ И РИСКИ. ИТАЛИЯ ОЦЕНИВАЕТ
Dialogue: 0,0:11:01.03,0:11:04.87,Caption,,0,0,0,,ВОЗМОЖНОСТИ. ФРАНЦИЯ ПОМНИТ О СВОИХ АМБИЦИЯХ. ПОЛЬША
Dialogue: 0,0:11:04.87,0:11:07.51,Caption,,0,0,0,,НАХОДИТСЯ В ОТДЕЛЬНОЙ ИСТОРИЧЕСКОЙ РЕАЛЬНОСТИ,
Dialogue: 0,0:11:07.75,0:11:09.59,Caption,,0,0,0,,ГДЕ РОССИЯ ВОЗНИКАЕТ В РАЗГОВОРЕ,
Dialogue: 0,0:11:09.75,0:11:13.03,Caption,,0,0,0,,ДАЖЕ ЕСЛИ ЕГО НАЧАЛИ С ОБСУЖДЕНИЯ УРОЖАЯ КАРТОФЕЛЯ.
Dialogue: 0,0:11:13.51,0:11:18.31,Caption,,0,0,0,,БРИТАНИЯ ПОКИНУЛА ЕВРОСОЮЗ, НО ОСТАЛАСЬ ВНУТРИ ОБЩЕЙ ПОЛИТИЧЕСКОЙ И ВОЕННОЙ
Dialogue: 0,0:11:18.39,0:11:21.83,Caption,,0,0,0,,СИСТЕМЫ. У СТРАН БАЛТИИ СВОЯ ПОЗИЦИЯ. У ВЕНГРИИ
Dialogue: 0,0:11:21.83,0:11:25.19,Caption,,0,0,0,,СВОЯ. У СЛОВАКИИ ТОЖЕ. ПОПРОБУЙТЕ СОБРАТЬ ИЗ ЭТОГО
Dialogue: 0,0:11:25.27,0:11:29.83,Caption,,0,0,0,,ОДНОГО ПРЕДСТАВИТЕЛЯ, КОТОРЫЙ ВОЙДЕТ В КРЕМЛЬ И УВЕРЕННО ПРОИЗНЕСЕТ Я
Dialogue: 0,0:11:29.83,0:11:32.87,Caption,,0,0,0,,УПОЛНОМОЧЕН ГОВОРИТЬ ЗА ВСЕХ. ПЕРВЫЙ ВОПРОС ПУТИНА
Dialogue: 0,0:11:32.87,0:11:37.35,Caption,,0,0,0,,БУДЕТ ПРОСТЫМ ТОЧНО ЗА ВСЕХ? И ПОЧТИ СРАЗУ ГДЕ НИБУДЬ ЗА СПИНОЙ ПОСЛЫШИТСЯ
Dialogue: 0,0:11:37.35,0:11:43.86,Caption,,0,0,0,,ВЫРАЗИТЕЛЬНОЕ ПОКАШЛИВАНИЕ. ОДНАКО ЕВРОПЕЙСКАЯ РАЗДРОБЛЕННОСТЬ НЕ ЕДИНСТВЕННАЯ И
Dialogue: 0,0:11:43.94,0:11:46.42,Caption,,0,0,0,,ДАЖЕ НЕ ГЛАВНАЯ ТРУДНОСТЬ. ОСНОВНАЯ ПРОБЛЕМА
Dialogue: 0,0:11:46.42,0:11:50.58,Caption,,0,0,0,,НАХОДИТСЯ В ВАШИНГТОНЕ. РАНЬШЕ ЕВРОПЕЙЦЫ МОГЛИ СПОРИТЬ МЕЖДУ СОБОЙ СКОЛЬКО
Dialogue: 0,0:11:50.58,0:11:54.10,Caption,,0,0,0,,УГОДНО. АМЕРИКАНСКАЯ МАШИНА УДЕРЖИВАЛА ОБЩИЙ КАРКАС.
Dialogue: 0,0:11:54.55,0:11:57.22,Caption,,0,0,0,,ТЕПЕРЬ ИСТОЧНИКОМ ГЛАВНОГО РАСХОЖДЕНИЯ СТАНОВИТСЯ
Dialogue: 0,0:11:57.22,0:12:00.34,Caption,,0,0,0,,САМ ПРЕЗИДЕНТ СОЕДИНЕННЫХ ШТАТОВ. ТРАМП НЕ
Dialogue: 0,0:12:00.34,0:12:03.46,Caption,,0,0,0,,ОГРАНИЧИВАЕТСЯ РАЗГОВОРАМИ С МОСКВОЙ. ОН ВЫСТРАИВАЕТ
Dialogue: 0,0:12:03.46,0:12:06.50,Caption,,0,0,0,,СОБСТВЕННУЮ СДЕЛКУ. ЕЕ ИТОГ МОЖЕТ НЕ СОВПАСТЬ С
Dialogue: 0,0:12:06.50,0:12:10.26,Caption,,0,0,0,,РЕЗУЛЬТАТОМ, РАДИ КОТОРОГО ЕВРОПА ПЯТЬ ЛЕТ ТРАТИЛА ДЕНЬГИ,
Dialogue: 0,0:12:10.40,0:12:14.50,Caption,,0,0,0,,ПЕРЕДАВАЛА ОРУЖИЕ, РАСХОДОВАЛА ПОЛИТИЧЕСКИЙ КАПИТАЛ И ПЕРЕСТРАИВАЛА
Dialogue: 0,0:12:14.50,0:12:18.58,Caption,,0,0,0,,ПРОМЫШЛЕННОСТЬ. ОТСЮДА НЕРВНЫЕ ИНТОНАЦИИ МЕРЦА. ЕМУ
Dialogue: 0,0:12:18.66,0:12:21.22,Caption,,0,0,0,,НУЖНО НЕ ПРОСТОЕ ПРИСУТСТВИЕ НА ПЕРЕГОВОРАХ. ОН
Dialogue: 0,0:12:21.30,0:12:24.18,Caption,,0,0,0,,ТРЕБУЕТ ВОЗМОЖНОСТИ ВЛИЯТЬ НА ОКОНЧАТЕЛЬНЫЕ УСЛОВИЯ.
Dialogue: 0,0:12:24.59,0:12:26.98,Caption,,0,0,0,,ПРИСУТСТВОВАТЬ И ВЛИЯТЬ ВОВСЕ НЕ ОДНО И ТО
Dialogue: 0,0:12:26.98,0:12:30.02,Caption,,0,0,0,,ЖЕ. СВОБОДНЫЙ СТУЛ МОЖНО НАЙТИ ПОЧТИ ДЛЯ КАЖДОГО.
Dialogue: 0,0:12:30.33,0:12:33.78,Caption,,0,0,0,,ВОДУ ПРИНЕСУТ. ТАБЛИЧКУ С ФАМИЛИЕЙ ПОСТАВЯТ. ДАЖЕ
Dialogue: 0,0:12:33.78,0:12:35.70,Caption,,0,0,0,,ДАДУТ СДЕЛАТЬ ВСТУПИТЕЛЬНОЕ ЗАЯВЛЕНИЕ.
Dialogue: 0,0:12:36.34,0:12:39.14,Caption,,0,0,0,,НО ПРАВО ПРОИЗНЕСТИ СЛОВА "ЭТО НЕПРИЕМЛЕМО,
Dialogue: 0,0:12:39.30,0:12:42.34,Caption,,0,0,0,,НАЧИНАЙТЕ СНАЧАЛА" ОЗНАЧАЕТ НАСТОЯЩУЮ ВЛАСТЬ.
Dialogue: 0,0:12:42.80,0:12:48.02,Caption,,0,0,0,,ГЛАВНЫЙ ВОПРОС СОСТОИТ В ТОМ, СОХРАНИТСЯ ЛИ ТАКАЯ ВЛАСТЬ У ЕВРОПЫ. ОСОБЕННО ПОСЛЕ
Dialogue: 0,0:12:48.02,0:12:51.14,Caption,,0,0,0,,АМЕРИКАНСКИХ ВЫБОРОВ. ДЕМОКРАТЫ ДОБИЛИСЬ СЕРЬЕЗНОГО
Dialogue: 0,0:12:51.14,0:12:54.58,Caption,,0,0,0,,РЕЗУЛЬТАТА И ПОЛУЧАЮТ БОЛЬШЕ ВОЗМОЖНОСТЕЙ ДАВИТЬ НА
Dialogue: 0,0:12:54.58,0:12:56.58,Caption,,0,0,0,,АДМИНИСТРАЦИЮ ТРАМПА ЧЕРЕЗ КОНГРЕСС.
Dialogue: 0,0:12:58.78,0:13:01.34,Caption,,0,0,0,,ПОДДЕРЖКА УКРАИНЫ СНОВА СТАНОВИТСЯ КРУПНЫМ
Dialogue: 0,0:13:01.34,0:13:04.30,Caption,,0,0,0,,ИНСТРУМЕНТОМ ВНУТРЕННЕЙ БОРЬБЫ. ФИНАНСИРОВАНИЕ.
Dialogue: 0,0:13:04.52,0:13:08.14,Caption,,0,0,0,,САНКЦИОННЫЕ РЕШЕНИЯ. РАССЛЕДОВАНИЯ. БЮДЖЕТНЫЕ СПОРЫ.
Dialogue: 0,0:13:08.38,0:13:13.34,Caption,,0,0,0,,ДАВЛЕНИЕ НА БЕЛЫЙ ДОМ. ОДНОВРЕМЕННО ЗАПУСКАЕТСЯ ГОНКА СО ВРЕМЕНЕМ. ЕСЛИ
Dialogue: 0,0:13:13.42,0:13:15.90,Caption,,0,0,0,,ТРАМП ХОЧЕТ ПРОВЕСТИ СОБСТВЕННУЮ ЛИНИЮ ПО РОССИИ И
Dialogue: 0,0:13:15.98,0:13:18.22,Caption,,0,0,0,,УКРАИНЕ, ЕМУ ВЫГОДНО УСКОРИТЬСЯ,
Dialogue: 0,0:13:18.37,0:13:20.78,Caption,,0,0,0,,ПОКА УСТРОЙСТВО ВЛАСТИ В ВАШИНГТОНЕ НЕ СТАЛО ДЛЯ
Dialogue: 0,0:13:20.86,0:13:24.46,Caption,,0,0,0,,НЕГО ЕЩЕ МЕНЕЕ УДОБНЫМ. С ПРИХОДОМ НОВОГО КОНГРЕССА
Dialogue: 0,0:13:24.70,0:13:27.42,Caption,,0,0,0,,ЛЮБОЙ ЗНАЧИМЫЙ ШАГ МОЖНО ПРЕВРАТИТЬ В ОТДЕЛЬНЫЙ
Dialogue: 0,0:13:27.42,0:13:30.22,Caption,,0,0,0,,АМЕРИКАНСКИЙ ПОЛИТИЧЕСКИЙ МОРДОБОЙ С КОМИССИЯМИ,
Dialogue: 0,0:13:30.41,0:13:34.30,Caption,,0,0,0,,СЛУШАНИЯМИ И БЕСКОНЕЧНЫМИ ОБВИНЕНИЯМИ. ДЛЯ ЕВРОПЫ
Dialogue: 0,0:13:34.45,0:13:37.34,Caption,,0,0,0,,ЭТО НАДЕЖДА. НЕ ОБЯЗАТЕЛЬНО ПЕРЕУБЕЖДАТЬ ТРАМПА
Dialogue: 0,0:13:37.34,0:13:41.98,Caption,,0,0,0,,ЛИЧНО. МОЖНО ПОДОЖДАТЬ, ПОКА ВНУТРИ СОЕДИНЕННЫХ ШТАТОВ СТАНЕТ БОЛЬШЕ ЛЮДЕЙ,
Dialogue: 0,0:13:42.22,0:13:45.34,Caption,,0,0,0,,ГОТОВЫХ ВЦЕПИТЬСЯ В КАЖДОЕ ЕГО РЕШЕНИЕ. ВЫХОДИТ,
Dialogue: 0,0:13:45.65,0:13:48.14,Caption,,0,0,0,,ПЕРЕГОВОРЫ ПРОХОДЯТ НЕ ТОЛЬКО МЕЖДУ МОСКВОЙ,
Dialogue: 0,0:13:48.25,0:13:52.46,Caption,,0,0,0,,КИЕВОМ, ВАШИНГТОНОМ И ЕВРОПЕЙСКИМИ СТОЛИЦАМИ. У ТРАМПА ЕСТЬ
Dialogue: 0,0:13:52.54,0:13:55.34,Caption,,0,0,0,,ЕЩЕ ОДИН ПЕРЕГОВОРНЫЙ СТОЛ У СЕБЯ ДОМА. И
Dialogue: 0,0:13:55.42,0:13:57.42,Caption,,0,0,0,,ЛЮДИ ЗА НИМ НЕ НАМЕРЕНЫ ДЕЛАТЬ ЕГО ЖИЗНЬ
Dialogue: 0,0:13:57.42,0:14:00.78,Caption,,0,0,0,,ПРОЩЕ. ТЕПЕРЬ РАССМОТРИМ НАИБОЛЕЕ ВАЖНУЮ РАЗВИЛКУ.
Dialogue: 0,0:14:01.14,0:14:04.78,Caption,,0,0,0,,ПРЕДПОЛОЖИМ, СОЕДИНЕННЫЕ ШТАТЫ ПРОСТО ПОКИДАЮТ ПРЕЖНЮЮ
Dialogue: 0,0:14:04.78,0:14:06.94,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ ЛИНИЮ. НЕ МЕШАЮТ ЕЙ,
Dialogue: 0,0:14:07.19,0:14:09.66,Caption,,0,0,0,,НО И НЕ ПОДДЕРЖИВАЮТ. ГОВОРЯТ ЕВРОПЕЙЦАМ,
Dialogue: 0,0:14:09.84,0:14:12.22,Caption,,0,0,0,,ЧТО ТЕ МОГУТ ПРОДОЛЖАТЬ ДАВЛЕНИЕ НА РОССИЮ
Dialogue: 0,0:14:12.22,0:14:15.42,Caption,,0,0,0,,СОБСТВЕННЫМИ СИЛАМИ. ДАЖЕ ТАКОЙ СЦЕНАРИЙ СОЗДАСТ
Dialogue: 0,0:14:15.42,0:14:21.54,Caption,,0,0,0,,ОГРОМНЫЕ ПРОБЛЕМЫ. БОЛЬШУЮ ЧАСТЬ ВОЕННЫХ РАСХОДОВ ЕВРОПЕ ПРИДЕТСЯ БРАТЬ
Dialogue: 0,0:14:21.62,0:14:24.50,Caption,,0,0,0,,НА СЕБЯ. УКРАИНЕ ПОТРЕБУЕТСЯ БОЛЬШЕ ЕВРОПЕЙСКИХ
Dialogue: 0,0:14:24.50,0:14:27.62,Caption,,0,0,0,,ДЕНЕГ. ОРУЖИЕ ПРИДЕТСЯ САМОСТОЯТЕЛЬНО ПРОИЗВОДИТЬ И
Dialogue: 0,0:14:27.62,0:14:30.66,Caption,,0,0,0,,ИСКАТЬ. ЭКОНОМИЧЕСКИЕ ПОСЛЕДСТВИЯ ТОЖЕ ПРИДЕТСЯ
Dialogue: 0,0:14:30.66,0:14:33.14,Caption,,0,0,0,,ПЕРЕВАРИВАТЬ БЕЗ ПРЕЖНЕЙ АМЕРИКАНСКОЙ ПОДДЕРЖКИ.
Dialogue: 0,0:14:33.86,0:14:36.90,Caption,,0,0,0,,ДАЖЕ РИСК ПРЯМОГО СТОЛКНОВЕНИЯ ОЩУЩАЕТСЯ ИНАЧЕ,
Dialogue: 0,0:14:37.13,0:14:39.70,Caption,,0,0,0,,КОГДА РЯДОМ НЕТ МОЩНОГО АМЕРИКАНСКОГО ПЛЕЧА.
Dialogue: 0,0:14:40.31,0:14:42.98,Caption,,0,0,0,,НО ВОЗМОЖЕН И БОЛЕЕ ЖЕСТКИЙ ВАРИАНТ. РЕЧЬ НЕ
Dialogue: 0,0:14:43.06,0:14:45.62,Caption,,0,0,0,,ИДЕТ О СОЮЗЕ МОСКВЫ И ВАШИНГТОНА. НЕ НУЖНО
Dialogue: 0,0:14:45.62,0:14:48.18,Caption,,0,0,0,,ПРЕДСТАВЛЯТЬ ТРАМПА И ПУТИНА В ОДНОМ БЕТОННОМ
Dialogue: 0,0:14:48.18,0:14:51.30,Caption,,0,0,0,,УКРЫТИИ С ОБЩИМ БИНОКЛЕМ. ДЛЯ ИЗМЕНЕНИЯ СИТУАЦИИ
Dialogue: 0,0:14:51.30,0:14:53.78,Caption,,0,0,0,,ДОСТАТОЧНО СОВПАДЕНИЯ ИНТЕРЕСОВ ПО НЕСКОЛЬКИМ
Dialogue: 0,0:14:53.86,0:14:56.74,Caption,,0,0,0,,КЛЮЧЕВЫМ НАПРАВЛЕНИЯМ. ВАШИНГТОН ХОЧЕТ УМЕНЬШИТЬ
Dialogue: 0,0:14:56.74,0:14:58.26,Caption,,0,0,0,,РАСХОДЫ НА БЕЗОПАСНОСТЬ ЕВРОПЫ.
Dialogue: 0,0:14:58.82,0:15:01.70,Caption,,0,0,0,,МОСКВА ХОЧЕТ СНИЗИТЬ ВОЕННОЕ ДАВЛЕНИЕ НАТО ВОЗЛЕ
Dialogue: 0,0:15:01.70,0:15:04.74,Caption,,0,0,0,,РОССИЙСКИХ ГРАНИЦ. СОЕДИНЕННЫЕ ШТАТЫ ЗАИНТЕРЕСОВАНЫ
Dialogue: 0,0:15:04.82,0:15:08.02,Caption,,0,0,0,,В ВЫГОДНЫХ СДЕЛКАХ И ЭКОНОМИЧЕСКИХ ПРОЕКТАХ. РОССИЯ
Dialogue: 0,0:15:08.02,0:15:11.14,Caption,,0,0,0,,СТРЕМИТСЯ К СНЯТИЮ ЧАСТИ ОГРАНИЧЕНИЙ И НОРМАЛИЗАЦИИ
Dialogue: 0,0:15:11.14,0:15:14.42,Caption,,0,0,0,,ОТНОШЕНИЙ. АМЕРИКА НЕ ХОЧЕТ БЕСКОНЕЧНО ОПЛАЧИВАТЬ
Dialogue: 0,0:15:14.42,0:15:17.14,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ ПРОТИВОСТОЯНИЕ. МОСКВА ТРЕБУЕТ,
Dialogue: 0,0:15:17.30,0:15:19.70,Caption,,0,0,0,,ЧТОБЫ ЕВРОПЕЙСКАЯ БЕЗОПАСНОСТЬ НЕ СТРОИЛАСЬ
Dialogue: 0,0:15:19.70,0:15:22.42,Caption,,0,0,0,,ИСКЛЮЧИТЕЛЬНО ПРОТИВ РОССИИ. ЕСЛИ ВОКРУГ ЭТИХ
Dialogue: 0,0:15:22.42,0:15:24.58,Caption,,0,0,0,,ИНТЕРЕСОВ НАЧНЕТСЯ НАСТОЯЩИЙ ТОРГ,
Dialogue: 0,0:15:24.83,0:15:27.46,Caption,,0,0,0,,ЕВРОПА УВИДИТ ДРУГУЮ ПОЛИТИЧЕСКУЮ КАРТИНУ.
Dialogue: 0,0:15:27.72,0:15:30.02,Caption,,0,0,0,,АМЕРИКАНЦЫ УЖЕ НЕ ПРОСТО ОТХОДЯТ В СТОРОНУ И
Dialogue: 0,0:15:30.02,0:15:35.66,Caption,,0,0,0,,ОСВОБОЖДАЮТ МЕСТО. ОНИ НАЧИНАЮТ ДОГОВАРИВАТЬСЯ С ГОСУДАРСТВОМ,
Dialogue: 0,0:15:35.97,0:15:38.54,Caption,,0,0,0,,ПРОТИВ КОТОРОГО БЫЛА НАПРАВЛЕНА ЗНАЧИТЕЛЬНАЯ ЧАСТЬ
Dialogue: 0,0:15:38.54,0:15:41.66,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ СТРАТЕГИИ ПОСЛЕДНИХ ЛЕТ. ДЛЯ БРЮССЕЛЯ
Dialogue: 0,0:15:41.91,0:15:45.42,Caption,,0,0,0,,ЭТО НЕ ОБЫЧНАЯ ПОТЕРЯ ПОМОЩНИКА. ЭТО СМЕНА ВСЕЙ
Dialogue: 0,0:15:45.50,0:15:48.94,Caption,,0,0,0,,ГЕОМЕТРИИ ОТНОШЕНИЙ. РАНЬШЕ СУЩЕСТВОВАЛ ТРЕУГОЛЬНИК,
Dialogue: 0,0:15:49.18,0:15:52.06,Caption,,0,0,0,,ГДЕ ЕВРОПА И СОЕДИНЕННЫЕ ШТАТЫ РАСПОЛАГАЛИСЬ НА
Dialogue: 0,0:15:52.14,0:15:55.58,Caption,,0,0,0,,ОДНОЙ СТОРОНЕ, А РОССИЯ НА ДРУГОЙ. ПОТОМ ОДНА ИЗ ВЕРШИН
Dialogue: 0,0:15:55.58,0:15:58.38,Caption,,0,0,0,,БЕРЕТ СТУЛ И СПОКОЙНО ПЕРЕСТАВЛЯЕТ ЕГО БЛИЖЕ К
Dialogue: 0,0:15:58.38,0:16:01.02,Caption,,0,0,0,,ЦЕНТРУ. ПОСЛЕ ЭТОГО МОЖНО ДОЛГО ПОВТОРЯТЬ,
Dialogue: 0,0:16:01.18,0:16:03.90,Caption,,0,0,0,,ЧТО НИЧЕГО НЕ ИЗМЕНИЛОСЬ. НО ИЗМЕНИЛОСЬ ВСЕ.
Dialogue: 0,0:16:04.46,0:16:06.94,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ЗАЯВЛЕНИЕ МЕРЦА НЕЛЬЗЯ СЧИТАТЬ
Dialogue: 0,0:16:06.94,0:16:10.14,Caption,,0,0,0,,ОЧЕРЕДНОЙ РЕЧЬЮ НЕМЕЦКОГО КАНЦЛЕРА. ДЕЛО НЕ В ТОМ,
Dialogue: 0,0:16:10.30,0:16:13.02,Caption,,0,0,0,,ОБИДЕЛИСЬ ЕВРОПЕЙЦЫ НА ТРАМПА ИЛИ ТОЛЬКО ГОТОВЯТСЯ
Dialogue: 0,0:16:13.02,0:16:16.22,Caption,,0,0,0,,ОБИДЕТЬСЯ. ОБИДА В МИРОВОЙ ПОЛИТИКЕ СТОИТ НЕДОРОГО.
Dialogue: 0,0:16:16.69,0:16:19.74,Caption,,0,0,0,,УТРОМ ПОССОРИЛИСЬ. ПОСЛЕ ОБЕДА ЗАКЛЮЧИЛИ КОНТРАКТ.
Dialogue: 0,0:16:19.98,0:16:22.54,Caption,,0,0,0,,ВЕЧЕРОМ СНОВА ВЫРАЗИЛИ ГЛУБОКОЕ РАЗОЧАРОВАНИЕ.
Dialogue: 0,0:16:22.91,0:16:26.22,Caption,,0,0,0,,НАСТОЯЩИЙ ВОПРОС СЕРЬЕЗНЕЕ. КТО БУДЕТ УСТАНАВЛИВАТЬ
Dialogue: 0,0:16:26.30,0:16:28.70,Caption,,0,0,0,,ПРАВИЛА ПОСЛЕ ЗАВЕРШЕНИЯ УКРАИНСКОГО КОНФЛИКТА?
Dialogue: 0,0:16:29.08,0:16:31.98,Caption,,0,0,0,,АМЕРИКА ВМЕСТЕ С ЕВРОПОЙ? АМЕРИКА САМОСТОЯТЕЛЬНО?
Dialogue: 0,0:16:32.33,0:16:34.86,Caption,,0,0,0,,РОССИЯ И СОЕДИНЕННЫЕ ШТАТЫ В ХОДЕ ОТДЕЛЬНОГО
Dialogue: 0,0:16:34.86,0:16:38.70,Caption,,0,0,0,,БОЛЬШОГО ТОРГА? СОХРАНИТ ЛИ ЕВРОПА ПРАВО ЗАБЛОКИРОВАТЬ РЕШЕНИЕ?
Dialogue: 0,0:16:38.99,0:16:41.82,Caption,,0,0,0,,ИЛИ ЕЙ ПОКАЖУТ СОГЛАСОВАННЫЕ УСЛОВИЯ И ПРЕДЛОЖАТ
Dialogue: 0,0:16:41.82,0:16:43.74,Caption,,0,0,0,,КРАСИВО ПРИСУТСТВОВАТЬ ПРИ ОБЪЯВЛЕНИИ?
Dialogue: 0,0:16:44.36,0:16:47.34,Caption,,0,0,0,,ИМЕННО ЗДЕСЬ НАХОДИТСЯ ГЛАВНЫЙ НЕРВ ПРОИСХОДЯЩЕГО.
Dialogue: 0,0:16:49.62,0:16:52.18,Caption,,0,0,0,,УКРАИНА ОСТАЕТСЯ ВАЖНЕЙШЕЙ ЧАСТЬЮ ПЕРЕГОВОРОВ,
Dialogue: 0,0:16:52.48,0:16:55.14,Caption,,0,0,0,,НО УЖЕ НЕ ЗАПОЛНЯЕТ ВСЮ КАРТИНУ. БУДАНОВ
Dialogue: 0,0:16:55.14,0:16:57.94,Caption,,0,0,0,,НАПРАВЛЯЕТСЯ В АБУ ДАБИ. МЕДИНСКИЙ ЕДЕТ ТУДА ЖЕ.
Dialogue: 0,0:16:58.32,0:17:00.34,Caption,,0,0,0,,ИМ ПРЕДСТОИТ СНОВА ОБСУЖДАТЬ ВОПРОСЫ,
Dialogue: 0,0:17:00.58,0:17:03.38,Caption,,0,0,0,,ПОЗИЦИИ ПО КОТОРЫМ ДАВНО ИЗВЕСТНЫ ОБЕИМ СТОРОНАМ.
Dialogue: 0,0:17:03.84,0:17:06.82,Caption,,0,0,0,,РАЗГОВОРЫ БУДУТ ТЯЖЕЛЫМИ. КРАСНЫЕ ЛИНИИ НИКУДА НЕ
Dialogue: 0,0:17:06.82,0:17:09.78,Caption,,0,0,0,,ИСЧЕЗНУТ. НИКТО НЕ СТАНЕТ ЛУЧШИМ ДРУГОМ ЗА ОДИН
Dialogue: 0,0:17:09.78,0:17:12.42,Caption,,0,0,0,,ВЕЧЕР И ОДИН ОБЩИЙ УЖИН. НО ЗА СПИНАМИ
Dialogue: 0,0:17:12.42,0:17:14.66,Caption,,0,0,0,,ПЕРЕГОВОРЩИКОВ РАЗВИВАЕТСЯ ДРУГОЙ ПРОЦЕСС.
Dialogue: 0,0:17:14.81,0:17:16.66,Caption,,0,0,0,,ОБСУЖДАЕТСЯ УСТРОЙСТВО СИСТЕМЫ,
Dialogue: 0,0:17:16.98,0:17:20.10,Caption,,0,0,0,,КОТОРАЯ ВОЗНИКНЕТ ПОСЛЕ КОНФЛИКТА. И В ЭТОМ БОЛЕЕ
Dialogue: 0,0:17:20.10,0:17:22.98,Caption,,0,0,0,,КРУПНОМ РАЗГОВОРЕ ЕВРОПА ОБНАРУЖИЛА КРАЙНЕ
Dialogue: 0,0:17:22.98,0:17:26.18,Caption,,0,0,0,,НЕПРИЯТНЫЙ ФАКТ. ОНА ПРИВЫКЛА АВТОМАТИЧЕСКИ ВКЛЮЧАТЬ
Dialogue: 0,0:17:26.18,0:17:29.06,Caption,,0,0,0,,СОЕДИНЕННЫЕ ШТАТЫ В СОБСТВЕННУЮ ПОЗИЦИЮ. ТРАМП ВСЕ
Dialogue: 0,0:17:29.06,0:17:33.54,Caption,,0,0,0,,НАСТОЙЧИВЕЕ НАПОМИНАЕТ, ЧТО АМЕРИКА ЯВЛЯЕТСЯ ОТДЕЛЬНЫМ ГОСУДАРСТВОМ И
Dialogue: 0,0:17:33.54,0:17:36.18,Caption,,0,0,0,,РУКОВОДСТВУЕТСЯ СОБСТВЕННЫМИ ИНТЕРЕСАМИ. МЫСЛЬ
Dialogue: 0,0:17:36.26,0:17:39.14,Caption,,0,0,0,,КАЖЕТСЯ ОЧЕВИДНОЙ. ОДНАКО ДЛЯ ЕВРОПЕЙСКОЙ ПОЛИТИКИ
Dialogue: 0,0:17:39.14,0:17:42.10,Caption,,0,0,0,,ПОСЛЕДНИХ ЛЕТ ОНА ПРОЗВУЧАЛА ПОЧТИ КАК РЕВОЛЮЦИОННОЕ
Dialogue: 0,0:17:42.10,0:17:45.14,Caption,,0,0,0,,ОТКРЫТИЕ. ЕСЛИ ВАШИНГТОН ОКОНЧАТЕЛЬНО РЕШИТ,
Dialogue: 0,0:17:45.46,0:17:48.42,Caption,,0,0,0,,ЧТО ТОРГ С МОСКВОЙ ВЫГОДНЕЕ ДАЛЬНЕЙШЕГО СОДЕРЖАНИЯ
Dialogue: 0,0:17:48.42,0:17:52.74,Caption,,0,0,0,,ПРЕЖНЕЙ СИСТЕМЫ, МЕРЦУ ПРИДЕТСЯ ОТВЕТИТЬ НА ПРОСТОЙ ВОПРОС. ЧТО
Dialogue: 0,0:17:52.74,0:17:54.98,Caption,,0,0,0,,ЕВРОПА СПОСОБНА СДЕЛАТЬ САМОСТОЯТЕЛЬНО?
Dialogue: 0,0:17:55.48,0:17:58.74,Caption,,0,0,0,,НЕ ПОТРЕБОВАТЬ. НЕ ПРИЗВАТЬ. НЕ СОБРАТЬ НОВЫЙ
Dialogue: 0,0:17:58.74,0:18:01.62,Caption,,0,0,0,,САММИТ. НЕ ВЫПУСТИТЬ ЗАЯВЛЕНИЕ СРАЗУ НА НЕСКОЛЬКИХ
Dialogue: 0,0:18:01.62,0:18:07.10,Caption,,0,0,0,,ЯЗЫКАХ. ИМЕННО СДЕЛАТЬ. БЕЗ ЧУЖОГО КОШЕЛЬКА,
Dialogue: 0,0:18:07.25,0:18:11.10,Caption,,0,0,0,,ЧУЖОЙ АРМИИ И ЧУЖОГО ПОЛИТИЧЕСКОГО ПРИКРЫТИЯ. ТОГДА
Dialogue: 0,0:18:11.18,0:18:14.46,Caption,,0,0,0,,И СТАНЕТ ПОНЯТНА НАСТОЯЩАЯ СТОИМОСТЬ ВСЕХ РАЗГОВОРОВ
Dialogue: 0,0:18:14.58,0:18:16.86,Caption,,0,0,0,,О СТРАТЕГИЧЕСКОЙ САМОСТОЯТЕЛЬНОСТИ ЕВРОПЫ.
Dialogue: 0,0:18:17.48,0:18:19.82,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОСТЬ НАЧИНАЕТСЯ НЕ В ТОТ МОМЕНТ,
Dialogue: 0,0:18:20.14,0:18:23.02,Caption,,0,0,0,,КОГДА ТЫ САМ ПРОИЗНОСИШЬ ТОРЖЕСТВЕННУЮ РЕЧЬ. ОНА
Dialogue: 0,0:18:23.02,0:18:27.18,Caption,,0,0,0,,НАЧИНАЕТСЯ ТОГДА, КОГДА ПОСЛЕ ЭТОЙ РЕЧИ ТЕБЕ ПРИНОСЯТ СЧЕТ,
Dialogue: 0,0:18:27.42,0:18:30.38,Caption,,0,0,0,,А ПЛАТИТЬ БОЛЬШЕ НЕКОМУ. И ОФИЦИАНТ УЖЕ МЕДЛЕННО
Dialogue: 0,0:18:30.38,0:18:32.38,Caption,,0,0,0,,НАПРАВЛЯЕТСЯ К ЕВРОПЕЙСКОМУ СТОЛИКУ.
