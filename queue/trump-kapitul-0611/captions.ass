Dialogue: 0,0:00:00.12,0:00:03.16,Caption,,0,0,0,,ТРАМП ОПЯТЬ ОБЕЩАЕТ БОЛЬШУЮ СДЕЛКУ. ТУТ ХОЧЕТСЯ
Dialogue: 0,0:00:03.24,0:00:06.36,Caption,,0,0,0,,СПРОСИТЬ ДОНАЛЬД, А УЧАСТНИКИ СДЕЛКИ ОБ ЭТОМ ЗНАЮТ?
Dialogue: 0,0:00:06.57,0:00:08.60,Caption,,0,0,0,,ПОТОМУ ЧТО КИЕВ ПРОДОЛЖАЕТ СПОРИТЬ,
Dialogue: 0,0:00:08.84,0:00:13.80,Caption,,0,0,0,,ЕВРОПА ГНЁТ СВОЁ, МОСКВА ТОЖЕ ПОДАРКОВ НИКОМУ НЕ ОБЕЩАЛА. А ТРАМП
Dialogue: 0,0:00:13.88,0:00:17.80,Caption,,0,0,0,,УЖЕ РАССУЖДАЕТ ТАК, БУДТО ОСТАЛОСЬ ТОЛЬКО РУЧКИ РАЗДАТЬ. И ВОТ ЭТО
Dialogue: 0,0:00:17.88,0:00:20.52,Caption,,0,0,0,,УЖЕ ДОВОЛЬНО ЛЮБОПЫТНО. ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ
Dialogue: 0,0:00:20.52,0:00:23.16,Caption,,0,0,0,,ЧТО ЗДЕСЬ ИНТЕРЕСНЕЕ ВСЕГО НЕ ОЧЕРЕДНАЯ ГРОМКАЯ
Dialogue: 0,0:00:23.16,0:00:27.24,Caption,,0,0,0,,ФРАЗА ТРАМПА, А ТО, ПОЧЕМУ ОН ВООБЩЕ ПОЗВОЛЯЕТ СЕБЕ ГОВОРИТЬ ТАК
Dialogue: 0,0:00:27.24,0:00:30.36,Caption,,0,0,0,,УВЕРЕННО, КОГДА ВОКРУГ НЕГО НИКТО ОСОБЕННО НЕ СПЕШИТ
Dialogue: 0,0:00:30.44,0:00:35.32,Caption,,0,0,0,,СОГЛАШАТЬСЯ. СМОТРИТЕ, ЧТО ПРОИСХОДИТ. ТРАМП ПРИНИМАЕТ КИРИЛЛА ДМИТРИЕВА.
Dialogue: 0,0:00:35.74,0:00:38.36,Caption,,0,0,0,,УКРАИНСКАЯ ДЕЛЕГАЦИЯ В ТОТ ЖЕ ДЕНЬ ДО ПРЕЗИДЕНТА
Dialogue: 0,0:00:38.44,0:00:41.48,Caption,,0,0,0,,США НЕ ДОБИРАЕТСЯ. ПОТОМ ТРАМП ВЫХОДИТ И ГОВОРИТ
Dialogue: 0,0:00:41.56,0:00:43.80,Caption,,0,0,0,,УЖЕ НЕ ПРО ПАУЗУ НА ПАРУ НЕДЕЛЬ И
Dialogue: 0,0:00:43.88,0:00:46.60,Caption,,0,0,0,,НЕ ПРО ОЧЕРЕДНОЙ ОБМЕН ЛЮБЕЗНОСТЯМИ. ОН ГОВОРИТ ПРО
Dialogue: 0,0:00:46.68,0:00:48.92,Caption,,0,0,0,,БОЛЬШОЕ СОГЛАШЕНИЕ. ПРИЧЁМ ТАКОЕ,
Dialogue: 0,0:00:49.16,0:00:51.16,Caption,,0,0,0,,КОТОРОЕ ЗАТРОНЕТ НЕ ТОЛЬКО УКРАИНУ,
Dialogue: 0,0:00:51.44,0:00:53.96,Caption,,0,0,0,,НО И ВСЮ ЕВРОПУ. ПОЧТИ ОДНОВРЕМЕННО КУШНЕР
Dialogue: 0,0:00:53.96,0:00:56.68,Caption,,0,0,0,,РАССКАЗЫВАЕТ О НОВОЙ АРХИТЕКТУРЕ БЕЗОПАСНОСТИ.
Dialogue: 0,0:00:57.00,0:00:59.56,Caption,,0,0,0,,АМЕРИКАНЦЫ ПРОВОДЯТ КОНСУЛЬТАЦИИ С УКРАИНЦАМИ И
Dialogue: 0,0:00:59.56,0:01:02.28,Caption,,0,0,0,,ЕВРОПЕЙЦАМИ. НА ДЕСЯТОЕ И ОДИННАДЦАТОЕ НОЯБРЯ
Dialogue: 0,0:01:02.28,0:01:05.24,Caption,,0,0,0,,СОБИРАЮТ НОВЫЙ РАУНД В АБУ ДАБИ. ТУДА ЕДУТ
Dialogue: 0,0:01:05.24,0:01:08.68,Caption,,0,0,0,,РОССИЯ, УКРАИНА И США. ТО ЕСТЬ СНАРУЖИ ВСЕ ЕЩЁ
Dialogue: 0,0:01:08.76,0:01:11.88,Caption,,0,0,0,,СПОРЯТ, А ВНУТРИ МЕХАНИЗМА УЖЕ КРУТЯТСЯ ШЕСТЕРЁНКИ.
Dialogue: 0,0:01:14.07,0:01:15.91,Caption,,0,0,0,,И ГЛАВНЫЙ ВОПРОС СЕЙЧАС НЕ В ТОМ,
Dialogue: 0,0:01:16.10,0:01:18.87,Caption,,0,0,0,,ПОДПИСАНА ЛИ ГДЕ ТО СЕКРЕТНАЯ БУМАЖКА. ВОПРОС
Dialogue: 0,0:01:18.87,0:01:21.35,Caption,,0,0,0,,ДРУГОЙ. ПОЧЕМУ ТРАМП ГОВОРИТ ТАК,
Dialogue: 0,0:01:21.61,0:01:24.87,Caption,,0,0,0,,БУДТО УЖЕ ЗНАЕТ ЦЕНУ ОТКАЗА КАЖДОГО УЧАСТНИКА?
Dialogue: 0,0:01:25.35,0:01:27.75,Caption,,0,0,0,,ПОТОМУ ЧТО БОЛЬШАЯ СДЕЛКА В РЕАЛЬНОЙ ПОЛИТИКЕ
Dialogue: 0,0:01:27.75,0:01:29.43,Caption,,0,0,0,,НАЧИНАЕТСЯ НЕ С ДРУЖНОГО "ДА".
Dialogue: 0,0:01:29.98,0:01:33.67,Caption,,0,0,0,,ОНА НАЧИНАЕТСЯ С МОМЕНТА, КОГДА ВСЕМ ПО ОЧЕРЕДИ ОБЪЯСНЯЮТ,
Dialogue: 0,0:01:33.91,0:01:37.11,Caption,,0,0,0,,СКОЛЬКО БУДЕТ СТОИТЬ СЛОВО "НЕТ". ЛУКАШЕНКО НЕДАВНО
Dialogue: 0,0:01:37.11,0:01:39.83,Caption,,0,0,0,,СФОРМУЛИРОВАЛ РАЗВИЛКУ СОВСЕМ БЕЗ ДИПЛОМАТИЧЕСКОГО
Dialogue: 0,0:01:39.83,0:01:43.19,Caption,,0,0,0,,ТУМАНА. ЛИБО СТОРОНЫ ЗАКАНЧИВАЮТ КОНФЛИКТ В БЛИЖАЙШИЕ
Dialogue: 0,0:01:43.19,0:01:47.27,Caption,,0,0,0,,МЕСЯЦЫ, ЛИБО ДАЛЬШЕ СТАВКИ СПОСОБНЫ ДОЙТИ ДО СОВСЕМ ОПАСНОГО
Dialogue: 0,0:01:47.27,0:01:51.91,Caption,,0,0,0,,УРОВНЯ, ВПЛОТЬ ДО ЯДЕРНОГО. ТРАМП ЯВНО НЕ ХОЧЕТ ПРОВЕРЯТЬ ВТОРОЙ ВАРИАНТ НА
Dialogue: 0,0:01:51.91,0:01:55.75,Caption,,0,0,0,,ПРАКТИКЕ. НЕ ПОТОМУ, ЧТО ЕГО ВДРУГ ПОТЯНУЛО СПАСАТЬ МИР В БЕЛОМ
Dialogue: 0,0:01:55.75,0:01:58.31,Caption,,0,0,0,,КОСТЮМЕ И С ГОЛУБЕМ НА ПЛЕЧЕ. ЕМУ НУЖЕН
Dialogue: 0,0:01:58.31,0:02:01.11,Caption,,0,0,0,,РЕЗУЛЬТАТ. БЫСТРЫЙ, ПОНЯТНЫЙ И ТАКОЙ,
Dialogue: 0,0:02:01.35,0:02:03.67,Caption,,0,0,0,,КОТОРЫЙ МОЖНО ПОЛОЖИТЬ ПЕРЕД СВОЕЙ АУДИТОРИЕЙ И
Dialogue: 0,0:02:03.67,0:02:07.59,Caption,,0,0,0,,СКАЗАТЬ ВОТ, СДЕЛАЛ. ПОСЛЕ ПРОМЕЖУТОЧНЫХ ВЫБОРОВ ЭТО ЖЕЛАНИЕ
Dialogue: 0,0:02:07.59,0:02:10.47,Caption,,0,0,0,,СТАНОВИТСЯ ТОЛЬКО СИЛЬНЕЕ. ВНУТРИ США У НЕГО
Dialogue: 0,0:02:10.55,0:02:13.67,Caption,,0,0,0,,ПРИБАВИЛОСЬ ПРОБЛЕМ. БРИТАНСКАЯ ПРЕССА УЖЕ ОБСУЖДАЕТ
Dialogue: 0,0:02:13.67,0:02:16.39,Caption,,0,0,0,,УСИЛЕНИЕ ДАВЛЕНИЯ НА КИЕВ. А ЗНАЧИТ,
Dialogue: 0,0:02:16.79,0:02:19.11,Caption,,0,0,0,,ТРАТИТЬ МЕСЯЦЫ НА БЕСКОНЕЧНЫЕ РАУНДЫ,
Dialogue: 0,0:02:19.27,0:02:21.75,Caption,,0,0,0,,ГДЕ ВСЕ ВСТРЕЧАЮТСЯ, УЛЫБАЮТСЯ,
Dialogue: 0,0:02:21.91,0:02:24.87,Caption,,0,0,0,,ФОТОГРАФИРУЮТСЯ И РАСХОДЯТСЯ С ТЕМИ ЖЕ ПОЗИЦИЯМИ,
Dialogue: 0,0:02:25.18,0:02:28.39,Caption,,0,0,0,,ДЛЯ ТРАМПА СТАНОВИТСЯ ВСЁ МЕНЕЕ ИНТЕРЕСНО. ЕМУ НУЖНА
Dialogue: 0,0:02:28.39,0:02:30.55,Caption,,0,0,0,,НЕ ЕЩЁ ОДНА ПЕРЕГОВОРНАЯ ФОТОГРАФИЯ.
Dialogue: 0,0:02:32.83,0:02:36.67,Caption,,0,0,0,,ЕМУ НУЖНА КОНСТРУКЦИЯ, ПОСЛЕ КОТОРОЙ ОТКАЗАТЬСЯ БУДЕТ ДОРОЖЕ,
Dialogue: 0,0:02:36.83,0:02:41.07,Caption,,0,0,0,,ЧЕМ СОГЛАСИТЬСЯ. И ВОТ ТУТ НАЧИНАЕТСЯ САМОЕ НЕПРИЯТНОЕ ДЛЯ КИЕВА.
Dialogue: 0,0:02:41.47,0:02:44.19,Caption,,0,0,0,,МОСКВА СВОИ БАЗОВЫЕ УСЛОВИЯ ДАВНО ОБОЗНАЧИЛА.
Dialogue: 0,0:02:44.49,0:02:48.35,Caption,,0,0,0,,ТЕРРИТОРИИ. СТАТУС УКРАИНЫ. НАТО. ВОЕННАЯ
Dialogue: 0,0:02:48.35,0:02:51.79,Caption,,0,0,0,,ИНФРАСТРУКТУРА. САНКЦИИ. БЕЗОПАСНОСТЬ В ЕВРОПЕ.
Dialogue: 0,0:02:52.34,0:02:54.59,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО СПОРИТЬ С ЭТИМ СПИСКОМ,
Dialogue: 0,0:02:54.91,0:02:58.91,Caption,,0,0,0,,НО СДЕЛАТЬ ВИД, ЧТО ЕГО НЕТ, УЖЕ НЕ ПОЛУЧИТСЯ. БОЛЕЕ ТОГО,
Dialogue: 0,0:02:59.15,0:03:01.71,Caption,,0,0,0,,В УКРАИНСКОМ ИНФОРМАЦИОННОМ ПОЛЕ УЖЕ ОБСУЖДАЮТ
Dialogue: 0,0:03:01.71,0:03:04.67,Caption,,0,0,0,,БОЛЬШОЙ РОССИЙСКИЙ ПАКЕТ. ТАМ ОПИСЫВАЮТ СНАЧАЛА
Dialogue: 0,0:03:04.67,0:03:06.83,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКУЮ ПАУЗУ ДО КОНЦА ГОДА,
Dialogue: 0,0:03:07.07,0:03:10.11,Caption,,0,0,0,,ЗАТЕМ ПЕРЕХОД К БОЛЕЕ ШИРОКОМУ ДОГОВОРУ. ОТДЕЛЬНО
Dialogue: 0,0:03:10.11,0:03:13.23,Caption,,0,0,0,,ИДУТ ТРЕБОВАНИЯ ПО АРМИИ, ИНФРАСТРУКТУРЕ НАТО,
Dialogue: 0,0:03:13.39,0:03:17.55,Caption,,0,0,0,,ЯЗЫКУ, ЦЕРКВИ И ЗАПАДНОМУ ВОЕННОМУ ПРИСУТСТВИЮ. И ЗДЕСЬ
Dialogue: 0,0:03:17.55,0:03:21.95,Caption,,0,0,0,,ИНТЕРЕСНО ДАЖЕ НЕ ТО, СКОЛЬКО ПУНКТОВ ИЗ ЭТОЙ УТЕЧКИ В ИТОГЕ ОКАЖЕТСЯ
Dialogue: 0,0:03:22.03,0:03:24.67,Caption,,0,0,0,,НА НАСТОЯЩЕМ СТОЛЕ. ИНТЕРЕСЕН МАСШТАБ ТОРГА.
Dialogue: 0,0:03:24.90,0:03:27.39,Caption,,0,0,0,,РАЗГОВОР ИДЁТ УЖЕ НЕ ПРО ОДИН УЧАСТОК ФРОНТА
Dialogue: 0,0:03:27.71,0:03:29.87,Caption,,0,0,0,,И НЕ ПРО ПАРУ НЕДЕЛЬ ТИШИНЫ. В КИЕВЕ
Dialogue: 0,0:03:29.95,0:03:33.07,Caption,,0,0,0,,ОПИСЫВАЮТ СХЕМУ, ГДЕ СНАЧАЛА ПЫТАЮТСЯ ЗАКРЫТЬ ТО,
Dialogue: 0,0:03:33.16,0:03:38.03,Caption,,0,0,0,,ЧТО МОЖНО ЗАКРЫТЬ БЫСТРЕЕ, А САМЫЕ ТЯЖЁЛЫЕ ВОПРОСЫ ПЕРЕНОСЯТ НА СЛЕДУЮЩИЙ ЭТАП.
Dialogue: 0,0:03:38.26,0:03:41.79,Caption,,0,0,0,,СНАЧАЛА ЭНЕРГЕТИКА. ПОТОМ БЕЗОПАСНОСТЬ. ПОТОМ БОЛЕЕ
Dialogue: 0,0:03:41.79,0:03:44.67,Caption,,0,0,0,,ТЯЖЁЛЫЕ ПОЛИТИЧЕСКИЕ УСЛОВИЯ. ДЛЯ ТРАМПА ТАКОЙ
Dialogue: 0,0:03:44.75,0:03:47.31,Caption,,0,0,0,,ПОДХОД ЕЩЁ И УДОБЕН ПОЛИТИЧЕСКИ. ПОЯВИЛАСЬ
Dialogue: 0,0:03:47.31,0:03:50.27,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКАЯ ПАУЗА. УЖЕ МОЖНО СКАЗАТЬ,
Dialogue: 0,0:03:50.44,0:03:56.40,Caption,,0,0,0,,ЧТО ПРОЦЕСС ПОШЁЛ. СОБРАЛИ НОВЫЙ РАУНД. ЕЩЁ ОДИН РЕЗУЛЬТАТ.
Dialogue: 0,0:03:56.79,0:03:59.68,Caption,,0,0,0,,ДОГОВОРИЛИСЬ О ЧАСТИ ПОВЕСТКИ. ЕЩЁ ОДИН РЕЗУЛЬТАТ.
Dialogue: 0,0:04:00.06,0:04:03.28,Caption,,0,0,0,,ГОРАЗДО ПРИЯТНЕЕ, ЧЕМ ПОЛГОДА ОБЪЯСНЯТЬ ИЗБИРАТЕЛЮ,
Dialogue: 0,0:04:03.52,0:04:05.20,Caption,,0,0,0,,ЧТО ПЕРЕГОВОРЫ ИДУТ ЗАМЕЧАТЕЛЬНО,
Dialogue: 0,0:04:05.44,0:04:10.00,Caption,,0,0,0,,ТОЛЬКО ПОКАЗАТЬ ПОКА НЕЧЕГО. И ЕСЛИ ТРАМП ДЕЙСТВИТЕЛЬНО ХОЧЕТ ЗАКРЫТЬ КОНФЛИКТ
Dialogue: 0,0:04:10.08,0:04:13.52,Caption,,0,0,0,,БЫСТРО, ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС. КОГО ЛЕГЧЕ СДВИНУТЬ?
Dialogue: 0,0:04:13.74,0:04:17.20,Caption,,0,0,0,,МОСКВУ, КОТОРАЯ ГОДАМИ ПОВТОРЯЕТ ОДНИ И ТЕ ЖЕ ТРЕБОВАНИЯ?
Dialogue: 0,0:04:17.58,0:04:20.80,Caption,,0,0,0,,ИЛИ КИЕВ, КОТОРЫЙ ЗНАЧИТЕЛЬНО СИЛЬНЕЕ ЗАВИСИТ ОТ ВНЕШНЕЙ
Dialogue: 0,0:04:20.80,0:04:24.24,Caption,,0,0,0,,ПОДДЕРЖКИ? ВОТ ЗДЕСЬ И ПОЯВЛЯЕТСЯ ТА ЧАСТЬ КАРТИНЫ,
Dialogue: 0,0:04:24.50,0:04:26.64,Caption,,0,0,0,,КОТОРУЮ ОБЫЧНО ОБСУЖДАЮТ НАМНОГО ТИШЕ.
Dialogue: 0,0:04:27.39,0:04:30.72,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ВЫГЛЯДИТ ЖЁСТКО. ПУБЛИЧНО СПОРИТ. ГОВОРИТ
Dialogue: 0,0:04:30.80,0:04:34.24,Caption,,0,0,0,,ПРО КРАСНЫЕ ЛИНИИ. ПРОСИТ ГАРАНТИИ. ТРЕБУЕТ ОРУЖИЕ.
Dialogue: 0,0:04:34.40,0:04:36.88,Caption,,0,0,0,,ОТКАЗЫВАЕТСЯ ПРОДАВАТЬ УСТУПКИ КАК УСТУПКИ.
Dialogue: 0,0:04:37.46,0:04:40.56,Caption,,0,0,0,,НО ЖЁСТКОСТЬ ПРЕЗИДЕНТА И УСТОЙЧИВОСТЬ ВСЕЙ СИСТЕМЫ
Dialogue: 0,0:04:40.64,0:04:42.72,Caption,,0,0,0,,ВОКРУГ ПРЕЗИДЕНТА ДАЛЕКО НЕ ОДНО И ТО ЖЕ.
Dialogue: 0,0:04:43.00,0:04:46.56,Caption,,0,0,0,,ВЛАСТЬ ВЫГЛЯДИТ МОНОЛИТНОЙ, ПОКА ЛЮДИ ВНУТРИ НЕЁ УВЕРЕНЫ,
Dialogue: 0,0:04:46.80,0:04:50.08,Caption,,0,0,0,,ЧТО ЦЕНТР СПОСОБЕН ИХ ПРИКРЫТЬ. ПОКА ЧИНОВНИК ЗНАЕТ,
Dialogue: 0,0:04:50.33,0:04:53.04,Caption,,0,0,0,,ЧТО ДОЛЖНОСТЬ ОСТАНЕТСЯ. ПОКА СИЛОВИК УВЕРЕН,
Dialogue: 0,0:04:53.20,0:04:56.48,Caption,,0,0,0,,ЧТО НАЧАЛЬСТВО ЕГО НЕ СДАСТ. ПОКА БИЗНЕС ПОНИМАЕТ,
Dialogue: 0,0:04:56.64,0:04:58.72,Caption,,0,0,0,,С КЕМ ДОГОВАРИВАТЬСЯ. ПОКА ВСЕ ВЕРЯТ,
Dialogue: 0,0:04:59.01,0:05:01.68,Caption,,0,0,0,,ЧТО ВНЕШНЯЯ ПОДДЕРЖКА ЗАВТРА БУДЕТ ТАКОЙ ЖЕ,
Dialogue: 0,0:05:01.84,0:05:05.28,Caption,,0,0,0,,КАК ВЧЕРА. А ПОТОМ У КОГО ТО НАЧИНАЕТСЯ РАССЛЕДОВАНИЕ. У
Dialogue: 0,0:05:05.36,0:05:07.84,Caption,,0,0,0,,КОГО ТО ВСПЛЫВАЮТ СТАРЫЕ ЗАКУПКИ. У КОГО ТО
Dialogue: 0,0:05:07.84,0:05:11.04,Caption,,0,0,0,,НАХОДЯТСЯ СЧЕТА, ИМУЩЕСТВО, СВЯЗИ,
Dialogue: 0,0:05:11.16,0:05:16.27,Caption,,0,0,0,,ДОКУМЕНТЫ. КОМУ ТО НАЧИНАЕТ СВЕТИТЬ НЕ НОВЫЙ КАБИНЕТ,
Dialogue: 0,0:05:16.42,0:05:19.63,Caption,,0,0,0,,А СОВСЕМ ДРУГОЕ ПОМЕЩЕНИЕ. И ПОЛИТИЧЕСКАЯ ВЕРНОСТЬ
Dialogue: 0,0:05:19.71,0:05:22.03,Caption,,0,0,0,,ВНЕЗАПНО СТАНОВИТСЯ ГОРАЗДО МЕНЕЕ РОМАНТИЧНОЙ.
Dialogue: 0,0:05:22.53,0:05:25.71,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРЫЙ ВЧЕРА ГОВОРИЛ "МЫ ОДНА КОМАНДА",
Dialogue: 0,0:05:25.95,0:05:28.67,Caption,,0,0,0,,СЕГОДНЯ ПЕРВЫМ ДЕЛОМ НАЧИНАЕТ СЧИТАТЬ СОБСТВЕННЫЕ
Dialogue: 0,0:05:28.67,0:05:31.79,Caption,,0,0,0,,РИСКИ. ВОТ ПОЧЕМУ ВНУТРЕННИЕ УКРАИНСКИЕ ПРОЦЕССЫ
Dialogue: 0,0:05:31.79,0:05:33.55,Caption,,0,0,0,,ИНТЕРЕСНЫ ЗДЕСЬ НЕ САМИ ПО СЕБЕ.
Dialogue: 0,0:05:34.36,0:05:38.27,Caption,,0,0,0,,НАБУ. СКАНДАЛЫ ВОКРУГ СИЛОВОГО БЛОКА. ЧИНОВНИКИ.
Dialogue: 0,0:05:38.50,0:05:41.71,Caption,,0,0,0,,ПРОКУРОРЫ. ВОЕННЫЕ. КОРРУПЦИОННЫЙ МАТЕРИАЛ.
Dialogue: 0,0:05:42.31,0:05:45.87,Caption,,0,0,0,,ВСЕ ЭТИ ИСТОРИИ ПОКАЗЫВАЮТ, СКОЛЬКО ВНУТРИ СИСТЕМЫ ЛЮДЕЙ,
Dialogue: 0,0:05:46.11,0:05:48.75,Caption,,0,0,0,,У КОТОРЫХ ЕСТЬ СОБСТВЕННАЯ ЦЕНА РИСКА. А ЕСЛИ
Dialogue: 0,0:05:48.75,0:05:53.39,Caption,,0,0,0,,МЕНЯЕТСЯ ЦЕНА РИСКА, МЕНЯЕТСЯ И ЦЕНА ЛОЯЛЬНОСТИ. НЕ ОБЯЗАТЕЛЬНО ТРАМПУ
Dialogue: 0,0:05:53.47,0:05:56.03,Caption,,0,0,0,,ЗВОНИТЬ ЗЕЛЕНСКОМУ И ОРАТЬ В ТРУБКУ. ГОРАЗДО
Dialogue: 0,0:05:56.03,0:05:59.07,Caption,,0,0,0,,НЕПРИЯТНЕЕ, КОГДА ЗВОНИТЬ ЗЕЛЕНСКОМУ НАЧИНАЮТ СВОИ.
Dialogue: 0,0:05:59.63,0:06:02.11,Caption,,0,0,0,,ОДИН ХОЧЕТ ГАРАНТИИ. ВТОРОЙ ИНТЕРЕСУЕТСЯ,
Dialogue: 0,0:06:02.27,0:06:04.99,Caption,,0,0,0,,ЧТО БУДЕТ ПОСЛЕ СОГЛАШЕНИЯ. ТРЕТИЙ ВНЕЗАПНО
Dialogue: 0,0:06:04.99,0:06:08.11,Caption,,0,0,0,,ВСПОМИНАЕТ, ЧТО ОН ВООБЩЕ ВСЕГДА БЫЛ СТОРОННИКОМ РАЗУМНОГО
Dialogue: 0,0:06:08.11,0:06:10.91,Caption,,0,0,0,,КОМПРОМИССА. ЧЕТВЁРТЫЙ ЧЕРЕЗ НЕДЕЛЮ ОКАЖЕТСЯ
Dialogue: 0,0:06:10.99,0:06:15.87,Caption,,0,0,0,,ЧЕЛОВЕКОМ МИРА С РОЖДЕНИЯ. ПОЛИТИКА УМЕЕТ УДИВИТЕЛЬНО БЫСТРО ЛЕЧИТЬ ПРОВАЛЫ
Dialogue: 0,0:06:15.95,0:06:18.59,Caption,,0,0,0,,ПАМЯТИ. И ВОТ ЗДЕСЬ У ВАШИНГТОНА ВОЗМОЖНОСТЕЙ
Dialogue: 0,0:06:18.59,0:06:21.95,Caption,,0,0,0,,ХВАТАЕТ. НЕ ОДНОЙ ВОЛШЕБНОЙ КНОПКИ. И НЕ КАКОГО
Dialogue: 0,0:06:22.03,0:06:24.91,Caption,,0,0,0,,ТО ТАЙНОГО ПУЛЬТА ПОД СТОЛОМ. А ВПОЛНЕ ОБЫЧНЫХ
Dialogue: 0,0:06:24.91,0:06:28.43,Caption,,0,0,0,,ВЕЩЕЙ, ОТ КОТОРЫХ УКРАИНСКАЯ ГОСУДАРСТВЕННАЯ МАШИНА ЗАВИСИТ
Dialogue: 0,0:06:28.43,0:06:31.55,Caption,,0,0,0,,КАЖДЫЙ ДЕНЬ. РАЗВЕДДАННЫЕ. ВОЕННАЯ ПОМОЩЬ.
Dialogue: 0,0:06:33.84,0:06:36.72,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ. ДОСТУП К ЗАПАДНЫМ ФИНАНСОВЫМ
Dialogue: 0,0:06:36.72,0:06:40.00,Caption,,0,0,0,,МЕХАНИЗМАМ. САНКЦИОННЫЕ РЕШЕНИЯ. ПОЛИТИЧЕСКАЯ
Dialogue: 0,0:06:40.00,0:06:42.48,Caption,,0,0,0,,ПОДДЕРЖКА. КОНТАКТЫ С ЧИНОВНИКАМИ,
Dialogue: 0,0:06:42.63,0:06:45.12,Caption,,0,0,0,,ВОЕННЫМИ, СИЛОВИКАМИ И БИЗНЕСОМ.
Dialogue: 0,0:06:45.75,0:06:48.56,Caption,,0,0,0,,КАЖДЫЙ ТАКОЙ РЫЧАГ ОТДЕЛЬНО СИСТЕМУ НЕ ВАЛИТ. НО
Dialogue: 0,0:06:48.64,0:06:50.96,Caption,,0,0,0,,ЕСЛИ ЧЕЛОВЕК ВНУТРИ ЭТОЙ СИСТЕМЫ ПОНИМАЕТ,
Dialogue: 0,0:06:51.12,0:06:53.60,Caption,,0,0,0,,ЧТО ЗАВТРА ОДИН ИЗ КАНАЛОВ СТАНЕТ СЛАБЕЕ,
Dialogue: 0,0:06:53.99,0:06:56.88,Caption,,0,0,0,,ОН НАЧИНАЕТ СЧИТАТЬ СВОЁ БУДУЩЕЕ ЗАРАНЕЕ. И ВОТ
Dialogue: 0,0:06:56.96,0:06:59.20,Caption,,0,0,0,,ЭТО ДЛЯ ЗЕЛЕНСКОГО КУДА НЕПРИЯТНЕЕ ОЧЕРЕДНОЙ
Dialogue: 0,0:06:59.20,0:07:02.00,Caption,,0,0,0,,ПЕРЕПАЛКИ С ТРАМПОМ ПЕРЕД КАМЕРАМИ. ПОТОМУ ЧТО С
Dialogue: 0,0:07:02.00,0:07:04.80,Caption,,0,0,0,,ТРАМПОМ МОЖНО ПОСПОРИТЬ ПУБЛИЧНО. А СО СВОИМИ
Dialogue: 0,0:07:04.80,0:07:10.32,Caption,,0,0,0,,ПРИХОДИТСЯ ЖИТЬ КАЖДЫЙ ДЕНЬ. ТЕПЕРЬ ПЕТРОПАВЛОВСКАЯ БОРЩАГОВКА. ОДИН ЧАСТНЫЙ ДОМ
Dialogue: 0,0:07:10.40,0:07:13.68,Caption,,0,0,0,,ПОД КИЕВОМ. ОБВИНЕНИЯ В НЕЗАКОННОМ УДЕРЖАНИИ ЛЮДЕЙ И
Dialogue: 0,0:07:13.68,0:07:18.32,Caption,,0,0,0,,ПЫТКАХ. ТОЛПА. ВОЕННЫЕ. СИЛОВИКИ. СЛЕДСТВИЕ. СБУ.
Dialogue: 0,0:07:18.56,0:07:21.36,Caption,,0,0,0,,НАЦГВАРДИЯ. ПРЕДСТАВИТЕЛИ ПРЕЗИДЕНТСКОЙ ВЕРТИКАЛИ.
Dialogue: 0,0:07:21.75,0:07:24.16,Caption,,0,0,0,,ДЛЯ ОДНОЙ ТОЧКИ НА КАРТЕ НАРОДУ СОБРАЛОСЬ,
Dialogue: 0,0:07:24.30,0:07:27.60,Caption,,0,0,0,,МЯГКО ГОВОРЯ, ПРИЛИЧНО. И ДЕЛО ТУТ ДАЖЕ НЕ В ТОМ,
Dialogue: 0,0:07:27.90,0:07:30.80,Caption,,0,0,0,,КТО В ИТОГЕ ОКАЖЕТСЯ ПРАВ ПО КОНКРЕТНОМУ ЭПИЗОДУ.
Dialogue: 0,0:07:30.95,0:07:34.32,Caption,,0,0,0,,ВАЖНО ДРУГОЕ. НАСКОЛЬКО БЫСТРО ЛОКАЛЬНЫЙ КОНФЛИКТ
Dialogue: 0,0:07:34.32,0:07:37.68,Caption,,0,0,0,,СПОСОБЕН ВТЯНУТЬ СРАЗУ НЕСКОЛЬКО УРОВНЕЙ СИСТЕМЫ. А
Dialogue: 0,0:07:37.76,0:07:40.96,Caption,,0,0,0,,РЯДОМ КИЕВ. СВЕТА НЕТ ПО НЕСКОЛЬКО СУТОК. ПРОБЛЕМЫ
Dialogue: 0,0:07:40.96,0:07:44.48,Caption,,0,0,0,,С ВОДОЙ. ЛЮДИ ВЫХОДЯТ НА УЛИЦЫ. ПЕРЕКРЫВАЮТ ДОРОГИ.
Dialogue: 0,0:07:44.64,0:07:47.68,Caption,,0,0,0,,ТРАНСПОРТ ВСТАЁТ. В ОДНОМ МЕСТЕ КОНФЛИКТ ВОКРУГ
Dialogue: 0,0:07:47.68,0:07:51.36,Caption,,0,0,0,,МОБИЛИЗАЦИИ. В ДРУГОМ КОММУНАЛЬНЫЙ КРИЗИС. В ТРЕТЬЕМ
Dialogue: 0,0:07:51.43,0:07:57.33,Caption,,0,0,0,,УГОЛОВНОЕ ДЕЛО. В ЧЕТВЁРТОМ ЧИНОВНИКИ НЕРВНО ИНТЕРЕСУЮТСЯ,
Dialogue: 0,0:07:57.53,0:08:00.61,Caption,,0,0,0,,КТО СЛЕДУЮЩИЙ. ЭТИ ИСТОРИИ НЕ ОБЯЗАНЫ БЫТЬ СВЯЗАНЫ
Dialogue: 0,0:08:00.61,0:08:04.05,Caption,,0,0,0,,МЕЖДУ СОБОЙ, ЧТОБЫ СОЗДАВАТЬ ОДНУ БОЛЬШУЮ ПРОБЛЕМУ ДЛЯ ВЛАСТИ.
Dialogue: 0,0:08:04.51,0:08:06.77,Caption,,0,0,0,,КРИЗИС ВООБЩЕ РЕДКО СПРАШИВАЕТ РАЗРЕШЕНИЯ У
Dialogue: 0,0:08:06.77,0:08:09.73,Caption,,0,0,0,,СОСЕДНЕГО КРИЗИСА. ОНИ ПРОСТО ПРИХОДЯТ ОДНОВРЕМЕННО.
Dialogue: 0,0:08:10.20,0:08:12.77,Caption,,0,0,0,,И ТОГДА НАВЕРХУ НАЧИНАЮТ СЧИТАТЬ УЖЕ НЕ РЕЙТИНГ
Dialogue: 0,0:08:12.77,0:08:16.61,Caption,,0,0,0,,ПРЕЗИДЕНТА, А ЗАПАС ПРОЧНОСТИ ВСЕЙ КОНСТРУКЦИИ. ПОДПИШИТЕСЬ.
Dialogue: 0,0:08:16.89,0:08:19.41,Caption,,0,0,0,,ПОТОМУ ЧТО ДАЛЬШЕ НАЧИНАЕТСЯ ВТОРАЯ ПОЛОВИНА ЭТОЙ
Dialogue: 0,0:08:19.41,0:08:23.25,Caption,,0,0,0,,ИСТОРИИ. ДАЖЕ ЕСЛИ ТРАМП НАЙДЁТ СПОСОБ ПРОДАВИТЬ КИЕВ,
Dialogue: 0,0:08:23.46,0:08:26.21,Caption,,0,0,0,,ЕМУ ВСЁ РАВНО ОСТАНЕТСЯ ЕВРОПА. А ЕВРОПА ДЛЯ
Dialogue: 0,0:08:26.29,0:08:29.33,Caption,,0,0,0,,НЕГО ЗАДАЧА ДАЖЕ ИНТЕРЕСНЕЕ. ПОТОМУ ЧТО КИЕВ ХОТЯ
Dialogue: 0,0:08:29.41,0:08:31.97,Caption,,0,0,0,,БЫ ЗАВИСИТ ОТ АМЕРИКАНСКОЙ ПОДДЕРЖКИ НАПРЯМУЮ.
Dialogue: 0,0:08:32.45,0:08:35.01,Caption,,0,0,0,,ЕВРОПА ЖЕ ПОСЛЕДНИЕ ГОДЫ ОЧЕНЬ СТАРАТЕЛЬНО УЧИТСЯ
Dialogue: 0,0:08:35.01,0:08:37.57,Caption,,0,0,0,,ПРОИЗНОСИТЬ СЛОВО "САМОСТОЯТЕЛЬНОСТЬ" С СЕРЬЁЗНЫМ
Dialogue: 0,0:08:37.57,0:08:40.69,Caption,,0,0,0,,ЛИЦОМ. СТРАТЕГИЧЕСКАЯ АВТОНОМИЯ. СОБСТВЕННАЯ
Dialogue: 0,0:08:40.69,0:08:44.93,Caption,,0,0,0,,ОБОРОНА. НОВЫЕ БЮДЖЕТЫ. НОВЫЕ ЗАВОДЫ. НОВЫЕ ЗАКУПКИ.
Dialogue: 0,0:08:45.01,0:08:48.53,Caption,,0,0,0,,КРАСИВЫЕ ЗАЯВЛЕНИЯ. ВСЁ ВЫГЛЯДИТ ВНУШИТЕЛЬНО. ПОКА
Dialogue: 0,0:08:48.61,0:08:51.73,Caption,,0,0,0,,НЕ ПОЯВЛЯЕТСЯ ОДИН СКУЧНЫЙ ВОПРОС. А ЕСЛИ АМЕРИКА
Dialogue: 0,0:08:51.81,0:08:56.37,Caption,,0,0,0,,ОТОЙДЁТ В СТОРОНУ? ВОТ НЕ В ТЕЛЕВИЗОРЕ. А РЕАЛЬНО. БЕЗ ПРИВЫЧНОГО
Dialogue: 0,0:08:56.37,0:08:59.41,Caption,,0,0,0,,ОБЪЁМА РАЗВЕДКИ. БЕЗ АМЕРИКАНСКОЙ ЛОГИСТИКИ. БЕЗ
Dialogue: 0,0:08:59.41,0:09:02.53,Caption,,0,0,0,,ЧАСТИ ВООРУЖЕНИЙ. БЕЗ ВОЕННОГО ПРИСУТСТВИЯ. БЕЗ
Dialogue: 0,0:09:02.53,0:09:05.65,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО ПРИКРЫТИЯ. БЕЗ СТРАТЕГИЧЕСКОГО ЗОНТИКА
Dialogue: 0,0:09:05.73,0:09:12.08,Caption,,0,0,0,,В ПРЕЖНЕМ ВИДЕ. ЧТО ТОГДА? И ЗДЕСЬ КУШНЕР СО СВОЕЙ НОВОЙ АРХИТЕКТУРОЙ
Dialogue: 0,0:09:12.08,0:09:15.52,Caption,,0,0,0,,БЕЗОПАСНОСТИ СТАНОВИТСЯ КУДА ИНТЕРЕСНЕЕ ОЧЕРЕДНОГО
Dialogue: 0,0:09:15.52,0:09:19.52,Caption,,0,0,0,,ЗАЯВЛЕНИЯ О МИРЕ. ПОТОМУ ЧТО НОВАЯ АРХИТЕКТУРА БЕЗОПАСНОСТИ НЕ
Dialogue: 0,0:09:19.52,0:09:22.40,Caption,,0,0,0,,СВОДИТСЯ К ПРЕКРАЩЕНИЮ ОГНЯ НА ТРИ МЕСЯЦА. ЭТО
Dialogue: 0,0:09:22.40,0:09:25.92,Caption,,0,0,0,,ПРАВИЛА ПОСЛЕ КОНФЛИКТА. КТО КОМУ ЧТО ГАРАНТИРУЕТ.
Dialogue: 0,0:09:26.32,0:09:28.64,Caption,,0,0,0,,ГДЕ ЗАКАНЧИВАЕТСЯ АМЕРИКАНСКАЯ ОТВЕТСТВЕННОСТЬ.
Dialogue: 0,0:09:28.80,0:09:31.76,Caption,,0,0,0,,КАКОЙ СТАТУС ПОЛУЧАЕТ УКРАИНА. ЧТО ПРОИСХОДИТ С
Dialogue: 0,0:09:31.84,0:09:35.04,Caption,,0,0,0,,ВОЕННЫМ ПРИСУТСТВИЕМ НАТО. КАКИЕ ОГРАНИЧЕНИЯ ТРЕБУЕТ
Dialogue: 0,0:09:35.04,0:09:37.84,Caption,,0,0,0,,МОСКВА. ЧТО ЕВРОПА ГОТОВА ОБЕСПЕЧИВАТЬ САМА.
Dialogue: 0,0:09:38.43,0:09:40.80,Caption,,0,0,0,,ВОТ ПОЧЕМУ ТРАМП ГОВОРИТ УЖЕ ПРО ВСЮ ЕВРОПУ.
Dialogue: 0,0:09:41.01,0:09:43.76,Caption,,0,0,0,,УКРАИНА В ЭТОЙ КОНСТРУКЦИИ ТОЛЬКО ОДИН ЭТАЖ. А
Dialogue: 0,0:09:43.76,0:09:48.48,Caption,,0,0,0,,ФУНДАМЕНТ ЛЕЖИТ НАМНОГО ШИРЕ. И ЗДЕСЬ У ТРАМПА ЕСТЬ ОЧЕНЬ ПРОСТОЙ СПОСОБ
Dialogue: 0,0:09:48.48,0:09:51.76,Caption,,0,0,0,,ИСПОРТИТЬ ЕВРОПЕЙЦАМ НАСТРОЕНИЕ. НЕ УГРОЖАТЬ. НЕ
Dialogue: 0,0:09:51.76,0:09:54.72,Caption,,0,0,0,,РУГАТЬСЯ. НЕ СТУЧАТЬ КУЛАКОМ ПО СТОЛУ. ПРОСТО
Dialogue: 0,0:09:54.80,0:09:58.72,Caption,,0,0,0,,СПРОСИТЬ ХОРОШО, ВЫ ХОТИТЕ ПРОДОЛЖАТЬ ПРЕЖНИЙ КУРС. СКОЛЬКО ВЫ ГОТОВЫ
Dialogue: 0,0:09:58.80,0:10:04.40,Caption,,0,0,0,,ЗА НЕГО ПЛАТИТЬ САМИ? НЕ СЛОВАМИ. ДЕНЬГАМИ. ОРУЖИЕМ. ЛОГИСТИКОЙ. ЛЮДЬМИ.
Dialogue: 0,0:10:04.69,0:10:09.60,Caption,,0,0,0,,РИСКОМ. И СКОЛЬКО ЛЕТ? ВОТ ЗДЕСЬ СТРАТЕГИЧЕСКАЯ АВТОНОМИЯ ПЕРЕСТАЁТ БЫТЬ
Dialogue: 0,0:10:09.68,0:10:12.48,Caption,,0,0,0,,КРАСИВОЙ РЕЧЬЮ И ПРЕВРАЩАЕТСЯ В БУХГАЛТЕРИЮ. А
Dialogue: 0,0:10:12.48,0:10:15.04,Caption,,0,0,0,,БУХГАЛТЕРИЯ ОЧЕНЬ БЫСТРО ЛЕЧИТ ПОЛИТИЧЕСКИЙ
Dialogue: 0,0:10:15.04,0:10:18.56,Caption,,0,0,0,,РОМАНТИЗМ. ЕВРОПА СПОСОБНА УВЕЛИЧИВАТЬ ВОЕННЫЕ РАСХОДЫ.
Dialogue: 0,0:10:18.80,0:10:21.68,Caption,,0,0,0,,СПОСОБНА РАСШИРЯТЬ ПРОИЗВОДСТВО. СПОСОБНА ЗАКУПАТЬ
Dialogue: 0,0:10:21.76,0:10:27.96,Caption,,0,0,0,,БОЛЬШЕ ТЕХНИКИ. НО МЕЖДУ "МЫ ПОСТЕПЕННО УСИЛИВАЕМСЯ" И "ЗАВТРА
Dialogue: 0,0:10:27.96,0:10:31.08,Caption,,0,0,0,,ПОЛНОСТЬЮ ЗАМЕНЯЕМ АМЕРИКУ" ЛЕЖИТ ДОВОЛЬНО ПРИЛИЧНАЯ
Dialogue: 0,0:10:31.08,0:10:34.36,Caption,,0,0,0,,ПРОПАСТЬ. И ТРАМП ЭТО ПРЕКРАСНО ПОНИМАЕТ. ЕСЛИ
Dialogue: 0,0:10:34.36,0:10:36.84,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТОЛИЦЫ ХОТЯТ ПРОДОЛЖАТЬ ЛИНИЮ,
Dialogue: 0,0:10:37.08,0:10:39.40,Caption,,0,0,0,,КОТОРУЮ ВАШИНГТОН ПЕРЕСТАЁТ СЧИТАТЬ ВЫГОДНОЙ,
Dialogue: 0,0:10:39.80,0:10:42.12,Caption,,0,0,0,,ИМ ПРИДЁТСЯ ОБЪЯСНЯТЬ СОБСТВЕННЫМ ИЗБИРАТЕЛЯМ,
Dialogue: 0,0:10:42.44,0:10:46.04,Caption,,0,0,0,,ПОЧЕМУ СЧЁТ ТЕПЕРЬ ПРИХОДИТ НАПРЯМУЮ ИМ. ПРИЧЁМ НА
Dialogue: 0,0:10:46.04,0:10:48.68,Caption,,0,0,0,,ДРУГОМ КОНЦЕ ЭТОЙ ИСТОРИИ НАХОДИТСЯ НЕ МАЛЕНЬКОЕ
Dialogue: 0,0:10:48.68,0:10:53.16,Caption,,0,0,0,,ГОСУДАРСТВО, А ЯДЕРНАЯ РОССИЯ. И ЗДЕСЬ СЛОВА ЛУКАШЕНКО ПРО
Dialogue: 0,0:10:53.16,0:10:56.52,Caption,,0,0,0,,ОПАСНУЮ РАЗВИЛКУ СНОВА НАЧИНАЮТ ЗВУЧАТЬ СОВСЕМ НЕ
Dialogue: 0,0:10:56.52,0:10:59.48,Caption,,0,0,0,,КАК ТЕЛЕВИЗИОННАЯ СТРАШИЛКА. ПРЯМОЕ СТОЛКНОВЕНИЕ
Dialogue: 0,0:10:59.48,0:11:02.28,Caption,,0,0,0,,РОССИИ И ЕВРОПЫ НЕ КОМПЬЮТЕРНАЯ ИГРА,
Dialogue: 0,0:11:02.38,0:11:05.08,Caption,,0,0,0,,ГДЕ МОЖНО В НАСТРОЙКАХ ОТКЛЮЧИТЬ ЯДЕРНОЕ ОРУЖИЕ И
Dialogue: 0,0:11:05.08,0:11:08.04,Caption,,0,0,0,,ОСТАВИТЬ ТОЛЬКО ТАНЧИКИ. ЕСЛИ СИСТЕМА СРЫВАЕТСЯ,
Dialogue: 0,0:11:08.19,0:11:11.72,Caption,,0,0,0,,НИКТО НЕ ОБЕЩАЛ, ЧТО СТОРОНЫ АККУРАТНО БУДУТ СОБЛЮДАТЬ УДОБНЫЙ
Dialogue: 0,0:11:11.72,0:11:14.68,Caption,,0,0,0,,СЦЕНАРИЙ. ВОТ ПОЭТОМУ ДАЖЕ ЧАСТИЧНЫЙ АМЕРИКАНСКИЙ
Dialogue: 0,0:11:14.76,0:11:17.32,Caption,,0,0,0,,ОТХОД СТАНОВИТСЯ РЫЧАГОМ. НЕ ОБЯЗАТЕЛЬНО БРОСАТЬ
Dialogue: 0,0:11:17.32,0:11:20.44,Caption,,0,0,0,,ЕВРОПУ. ДОСТАТОЧНО ЗАСТАВИТЬ ЕВРОПЕЙЦЕВ ВСЕРЬЁЗ
Dialogue: 0,0:11:20.44,0:11:22.52,Caption,,0,0,0,,ПОСЧИТАТЬ, СКОЛЬКО СТОИТ ВАРИАНТ,
Dialogue: 0,0:11:22.84,0:11:25.80,Caption,,0,0,0,,ГДЕ АМЕРИКА ПОМОГАЕТ МЕНЬШЕ. И ТОГДА РАЗГОВОР О
Dialogue: 0,0:11:25.88,0:11:29.32,Caption,,0,0,0,,СДЕЛКЕ МЕНЯЕТСЯ. УЖЕ НЕ "НРАВЯТСЯ ЛИ НАМ УСЛОВИЯ".
Dialogue: 0,0:11:29.71,0:11:33.16,Caption,,0,0,0,,А "ЧТО БУДЕТ, ЕСЛИ МЫ ИХ ОТВЕРГНЕМ". ВОТ ЭТО СОВСЕМ ДРУГАЯ
Dialogue: 0,0:11:33.16,0:11:38.07,Caption,,0,0,0,,АРИФМЕТИКА. И НА ЭТОМ ФОНЕ АБУ ДАБИ ВЫГЛЯДИТ УЖЕ
Dialogue: 0,0:11:38.15,0:11:42.47,Caption,,0,0,0,,НЕ ПРОСТО ОЧЕРЕДНЫМ МЕСТОМ, ГДЕ ТРИ ДЕЛЕГАЦИИ ПРОЧИТАЮТ ДРУГ ДРУГУ ЗАРАНЕЕ
Dialogue: 0,0:11:42.47,0:11:45.27,Caption,,0,0,0,,НАПИСАННЫЕ БУМАГИ. УКРАИНСКИЙ МИД ГОВОРИТ О
Dialogue: 0,0:11:45.27,0:11:49.19,Caption,,0,0,0,,БЕЗОПАСНОСТИ, МЕРАХ ДОВЕРИЯ И ВЫХОДЕ НА ПОТЕНЦИАЛЬНУЮ ВСТРЕЧУ
Dialogue: 0,0:11:49.19,0:11:52.23,Caption,,0,0,0,,ЗЕЛЕНСКОГО С ПУТИНЫМ. АМЕРИКАНЦЫ ФОРСИРУЮТ НОВЫЙ
Dialogue: 0,0:11:52.23,0:11:55.27,Caption,,0,0,0,,РАУНД. КУШНЕР ВЕДЁТ КОНСУЛЬТАЦИИ С УКРАИНЦАМИ И
Dialogue: 0,0:11:55.27,0:11:58.71,Caption,,0,0,0,,ЕВРОПЕЙЦАМИ. ДМИТРИЕВ УЖЕ БЫЛ У ТРАМПА. САМ ТРАМП
Dialogue: 0,0:11:58.80,0:12:03.43,Caption,,0,0,0,,ГОВОРИТ О БОЛЬШОЙ СДЕЛКЕ, КОТОРАЯ ВЫХОДИТ ДАЛЕКО ЗА ПРЕДЕЛЫ УКРАИНЫ. ПРИЧЁМ
Dialogue: 0,0:12:03.51,0:12:07.91,Caption,,0,0,0,,ЗДЕСЬ ХОРОШО ВИДНО, НАСКОЛЬКО РАЗНЫЕ ЗАДАЧИ СТОРОНЫ ТАЩАТ НА ОДИН СТОЛ.
Dialogue: 0,0:12:08.46,0:12:12.71,Caption,,0,0,0,,КИЕВ ХОЧЕТ ПОНЯТЬ, КАКИЕ ГАРАНТИИ ПОЛУЧИТ ВНУТРИ БУДУЩЕГО СОГЛАШЕНИЯ.
Dialogue: 0,0:12:13.11,0:12:15.35,Caption,,0,0,0,,ВАШИНГТОН УЖЕ ПЫТАЕТСЯ ГОВОРИТЬ О ТОМ,
Dialogue: 0,0:12:15.59,0:12:18.79,Caption,,0,0,0,,КАКИМ БУДЕТ ВЕСЬ ПОРЯДОК БЕЗОПАСНОСТИ ПОСЛЕ НЕГО. ТО
Dialogue: 0,0:12:18.87,0:12:20.87,Caption,,0,0,0,,ЕСТЬ ОДИН ПРИХОДИТ ОБСУЖДАТЬ СВОЮ КВАРТИРУ,
Dialogue: 0,0:12:21.09,0:12:23.35,Caption,,0,0,0,,А ДРУГОЙ УЖЕ СОБРАЛСЯ МЕНЯТЬ ПРАВИЛА ДЛЯ ВСЕГО
Dialogue: 0,0:12:23.43,0:12:26.79,Caption,,0,0,0,,ДОМА. И ИМЕННО ПОЭТОМУ ЕВРОПА ЗДЕСЬ НЕ ПРИЛОЖЕНИЕ
Dialogue: 0,0:12:26.87,0:12:29.51,Caption,,0,0,0,,К УКРАИНСКОЙ ТЕМЕ. ОНА СТАНОВИТСЯ ЧАСТЬЮ САМОЙ
Dialogue: 0,0:12:29.59,0:12:32.87,Caption,,0,0,0,,СДЕЛКИ. ЕСЛИ НОВЫЕ ПРАВИЛА НЕ УСТРАИВАЮТ ЕВРОПЕЙЦЕВ,
Dialogue: 0,0:12:33.15,0:12:35.83,Caption,,0,0,0,,У КИЕВА ОСТАЁТСЯ ПОДДЕРЖКА ДЛЯ ПРОДОЛЖЕНИЯ ПРЕЖНЕЙ
Dialogue: 0,0:12:35.83,0:12:38.31,Caption,,0,0,0,,ЛИНИИ. ЕСЛИ ОНИ НЕ УСТРАИВАЮТ МОСКВУ,
Dialogue: 0,0:12:38.57,0:12:41.35,Caption,,0,0,0,,МОСКВА НЕ СЧИТАЕТ ПРОБЛЕМУ ЗАКРЫТОЙ. ЕСЛИ ОНИ НЕ
Dialogue: 0,0:12:41.43,0:12:44.55,Caption,,0,0,0,,УСТРАИВАЮТ ВАШИНГТОН, ТРАМП НЕ ПОЛУЧАЕТ РЕЗУЛЬТАТА,
Dialogue: 0,0:12:44.87,0:12:46.31,Caption,,0,0,0,,РАДИ КОТОРОГО ВСЁ ЭТО ЗАТЕВАЛ.
Dialogue: 0,0:12:48.59,0:12:50.67,Caption,,0,0,0,,ПОЭТОМУ СТОРОНЫ ЕДУТ В АБУ ДАБИ С РАЗНЫМИ
Dialogue: 0,0:12:50.67,0:12:53.95,Caption,,0,0,0,,СПИСКАМИ, НО ВОПРОС У ВСЕХ В ИТОГЕ ОДИН. КАК
Dialogue: 0,0:12:53.95,0:12:56.35,Caption,,0,0,0,,СДЕЛАТЬ СЛЕДУЮЩИЙ ШАГ ДЕШЕВЛЕ ОТКАЗА?
Dialogue: 0,0:12:56.85,0:12:59.71,Caption,,0,0,0,,КИЕВ БУДЕТ ПЫТАТЬСЯ ПОЛУЧИТЬ МАКСИМУМ ГАРАНТИЙ И
Dialogue: 0,0:12:59.71,0:13:02.83,Caption,,0,0,0,,МИНИМУМ УСТУПОК. МОСКВА БУДЕТ ДОБИВАТЬСЯ ТОГО,
Dialogue: 0,0:13:03.07,0:13:06.27,Caption,,0,0,0,,ЧТО СЧИТАЕТ УСТРАНЕНИЕМ ПРИЧИН КОНФЛИКТА. ЕВРОПЕЙЦЫ
Dialogue: 0,0:13:06.27,0:13:08.91,Caption,,0,0,0,,БУДУТ ЗАЩИЩАТЬ СВОЁ ВЛИЯНИЕ НА БУДУЩУЮ СИСТЕМУ
Dialogue: 0,0:13:08.91,0:13:12.27,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ВАШИНГТОН БУДЕТ ТРЕБОВАТЬ РЕЗУЛЬТАТА.
Dialogue: 0,0:13:12.58,0:13:15.23,Caption,,0,0,0,,ПРИЧЁМ РЕЗУЛЬТАТА БЫСТРО. ИМЕННО ПОЭТОМУ ТРАМПУ
Dialogue: 0,0:13:15.23,0:13:17.55,Caption,,0,0,0,,СЕЙЧАС НЕ ОБЯЗАТЕЛЬНО ИМЕТЬ ГОТОВЫЙ ДОГОВОР В
Dialogue: 0,0:13:17.55,0:13:21.07,Caption,,0,0,0,,КАРМАНЕ. ЕМУ ВАЖНЕЕ ДРУГОЕ. ЧТОБЫ КАЖДЫЙ УЧАСТНИК
Dialogue: 0,0:13:21.07,0:13:25.79,Caption,,0,0,0,,НАЧАЛ СЧИТАТЬ НЕ ТОЛЬКО ТО, ЧТО ОН ПОТЕРЯЕТ ВНУТРИ СДЕЛКИ. НО И ТО,
Dialogue: 0,0:13:26.02,0:13:30.99,Caption,,0,0,0,,ЧТО ОН ПОТЕРЯЕТ БЕЗ НЕЁ. ВОТ ТОГДА И НАЧИНАЮТСЯ НАСТОЯЩИЕ ПЕРЕГОВОРЫ. НЕ
Dialogue: 0,0:13:30.99,0:13:33.63,Caption,,0,0,0,,КОГДА ВСЕ ВНЕЗАПНО ПОЛЮБИЛИ ДРУГ ДРУГА. НЕ КОГДА
Dialogue: 0,0:13:33.63,0:13:36.75,Caption,,0,0,0,,ВСЕ ПРИЗНАЛИ ЧУЖУЮ ПРАВОТУ. А КОГДА СЛОВО "НЕТ"
Dialogue: 0,0:13:36.89,0:13:39.95,Caption,,0,0,0,,СТАНОВИТСЯ СЛИШКОМ ДОРОГИМ. И ЕСЛИ ТРАМП СУМЕЕТ
Dialogue: 0,0:13:40.03,0:13:42.99,Caption,,0,0,0,,ДОВЕСТИ КИЕВ И ЕВРОПУ ДО ЭТОГО РАСЧЁТА ОДНОВРЕМЕННО,
Dialogue: 0,0:13:43.35,0:13:46.43,Caption,,0,0,0,,САМАЯ ВАЖНАЯ ЧАСТЬ БОЛЬШОЙ СДЕЛКИ ПРОИЗОЙДЁТ ЕЩЁ ДО
Dialogue: 0,0:13:46.43,0:13:48.67,Caption,,0,0,0,,ПОДПИСЕЙ. КТО ТО ПЕРВЫМ ПОЙМЁТ,
Dialogue: 0,0:13:48.92,0:13:51.55,Caption,,0,0,0,,ЧТО УЖЕ ТОРГУЕТСЯ НЕ ЗА ЛУЧШИЕ УСЛОВИЯ. ОН
Dialogue: 0,0:13:51.55,0:13:55.07,Caption,,0,0,0,,ТОРГУЕТСЯ ЗА ТО, ЧТОБЫ ОТКАЗ НЕ ОКАЗАЛСЯ ЕЩЁ ХУЖЕ.
