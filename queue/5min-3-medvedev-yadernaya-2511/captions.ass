Dialogue: 0,0:00:00.12,0:00:02.27,Caption,,0,0,0,,ЕСТЬ ТАКОЕ ВЫРАЖЕНИЕ ДЕРЖАТЬ КОЗЫРЬ В
Dialogue: 0,0:00:02.27,0:00:05.64,Caption,,0,0,0,,РУКАВЕ. ХОРОШАЯ ВЕЩЬ, ОСОБЕННО ЕСЛИ ПРОТИВНИК НЕ ЗНАЕТ,
Dialogue: 0,0:00:05.80,0:00:08.11,Caption,,0,0,0,,КАКОЙ ИМЕННО КОЗЫРЬ ВЫ ТАМ ПРЯЧЕТЕ. А
Dialogue: 0,0:00:08.11,0:00:11.33,Caption,,0,0,0,,ЕСЛИ ЗНАЕТ? ЕСЛИ ОН ПРЕКРАСНО ОСВЕДОМЛЁН ОБО ВСЕХ
Dialogue: 0,0:00:11.33,0:00:13.48,Caption,,0,0,0,,ВАШИХ КОЗЫРЯХ, НО ПРОДОЛЖАЕТ ИГРУ?
Dialogue: 0,0:00:14.04,0:00:16.20,Caption,,0,0,0,,ТУТ УЖЕ НЕВОЛЬНО НАЧИНАЕШЬ ИНТЕРЕСОВАТЬСЯ,
Dialogue: 0,0:00:16.46,0:00:18.44,Caption,,0,0,0,,ЧТО У НЕГО САМОГО НА РУКАХ. ИЛИ ОН
Dialogue: 0,0:00:18.44,0:00:20.36,Caption,,0,0,0,,РАССЧИТЫВАЕТ НА ЧТО ТО СОВСЕМ ДРУГОЕ?
Dialogue: 0,0:00:20.57,0:00:22.42,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН ИМЕННО ТАКОЙ
Dialogue: 0,0:00:22.42,0:00:25.23,Caption,,0,0,0,,РАЗБОР, БЕЗ ПЕРЕСКАЗА ГАЗЕТ И ДИПЛОМАТИЧЕСКОЙ
Dialogue: 0,0:00:25.23,0:00:27.61,Caption,,0,0,0,,ШЕЛУХИ, ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ БУДЕМ
Dialogue: 0,0:00:27.61,0:00:29.88,Caption,,0,0,0,,РАЗБИРАТЬСЯ НЕ В ТОМ, ЧТО СКАЗАЛИ,
Dialogue: 0,0:00:30.27,0:00:33.22,Caption,,0,0,0,,А В ТОМ, ПОЧЕМУ ПОСЛЕ ЭТИХ СЛОВ ВСЕ ПРОДОЛЖАЮТ
Dialogue: 0,0:00:33.22,0:00:36.85,Caption,,0,0,0,,ВЕСТИ СЕБЯ ТАК, БУДТО НИЧЕГО ОСОБЕННОГО НЕ ПРОИЗОШЛО.
Dialogue: 0,0:00:36.85,0:00:38.84,Caption,,0,0,0,,ДМИТРИЙ МЕДВЕДЕВ ОПЯТЬ НА ПЕРЕДОВОЙ,
Dialogue: 0,0:00:39.08,0:00:42.36,Caption,,0,0,0,,ОПЯТЬ НА ОСТРИЕ КОПЬЯ. БОРЗО, ДЕРЗКО,
Dialogue: 0,0:00:42.76,0:00:44.39,Caption,,0,0,0,,ТУТ УЖ ДМИТРИЮ АНАТОЛЬЕВИЧУ НЕ
Dialogue: 0,0:00:44.39,0:00:47.82,Caption,,0,0,0,,ОТКАЖЕШЬ. НА ЭТОТ РАЗ ОН НАПИСАЛ ЦЕЛУЮ НАУЧНУЮ СТАТЬЮ О
Dialogue: 0,0:00:47.82,0:00:51.24,Caption,,0,0,0,,ЯДЕРНОМ ОРУЖИИ, ЯДЕРНОЙ ДОКТРИНЕ И ТЕХ УСЛОВИЯХ,
Dialogue: 0,0:00:51.48,0:00:53.57,Caption,,0,0,0,,ПРИ КОТОРЫХ РОССИЯ ИМЕЕТ ПРАВО ПЕРЕЙТИ
Dialogue: 0,0:00:53.57,0:00:55.95,Caption,,0,0,0,,УЖЕ СОВСЕМ К ДРУГИМ АРГУМЕНТАМ. И ТАМ ЕСТЬ
Dialogue: 0,0:00:55.95,0:00:58.88,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ЗАНЯТНАЯ ВЕЩЬ. МЕДВЕДЕВ ФАКТИЧЕСКИ
Dialogue: 0,0:00:58.88,0:01:02.29,Caption,,0,0,0,,ГОВОРИТ, ЧТО СИТУАЦИИ, ПРИ КОТОРЫХ РОССИЙСКАЯ ЯДЕРНАЯ
Dialogue: 0,0:01:02.29,0:01:05.00,Caption,,0,0,0,,ДОКТРИНА УЖЕ ПОЗВОЛЯЛА ОТВЕТИТЬ ЯДЕРНЫМ УДАРОМ,
Dialogue: 0,0:01:05.27,0:01:08.12,Caption,,0,0,0,,ВОЗНИКАЛИ. НО УДАРА НЕ БЫЛО. ПОЧЕМУ?
Dialogue: 0,0:01:08.35,0:01:10.79,Caption,,0,0,0,,ПОТОМУ ЧТО МОСКВА КАЖДЫЙ РАЗ ОЦЕНИВАЛА
Dialogue: 0,0:01:10.79,0:01:15.29,Caption,,0,0,0,,МАСШТАБ УЩЕРБА, ПОСЛЕДСТВИЯ, СОРАЗМЕРНОСТЬ ОТВЕТА И ВСЮ ОСТАЛЬНУЮ
Dialogue: 0,0:01:15.29,0:01:19.03,Caption,,0,0,0,,КАРТИНУ. ТО ЕСТЬ КНОПКА,
Dialogue: 0,0:01:19.11,0:01:21.03,Caption,,0,0,0,,ЕСЛИ ГОВОРИТЬ СОВСЕМ ПРОСТЫМ ЯЗЫКОМ,
Dialogue: 0,0:01:21.23,0:01:23.83,Caption,,0,0,0,,ВРОДЕ БЫ УЖЕ ЛЕЖАЛА НА СТОЛЕ. ОСНОВАНИЯ,
Dialogue: 0,0:01:23.98,0:01:27.71,Caption,,0,0,0,,ПО ЭТОЙ ЛОГИКЕ, УЖЕ БЫЛИ. НО КНОПКУ НЕ НАЖАЛИ. ТЕПЕРЬ
Dialogue: 0,0:01:27.71,0:01:30.95,Caption,,0,0,0,,МЕДВЕДЕВ ОБЪЯСНЯЕТ СЛЕДУЮЩИЙ ПРЕДЕЛ. ЕСЛИ ЗАПАД
Dialogue: 0,0:01:30.95,0:01:32.95,Caption,,0,0,0,,ПЕРЕДАСТ УКРАИНЕ ЯДЕРНОЕ ОРУЖИЕ,
Dialogue: 0,0:01:33.19,0:01:37.01,Caption,,0,0,0,,СКРЫТО ИЛИ ОТКРЫТО, ТОГДА РОССИЯ НАНЕСЁТ ПРЕВЕНТИВНЫЙ
Dialogue: 0,0:01:37.01,0:01:39.03,Caption,,0,0,0,,ЯДЕРНЫЙ УДАР. ЕЩЁ ОДИН СЦЕНАРИЙ,
Dialogue: 0,0:01:39.27,0:01:41.18,Caption,,0,0,0,,МАССИРОВАННОЕ ПРИМЕНЕНИЕ ОБЫЧНОГО
Dialogue: 0,0:01:41.18,0:01:43.79,Caption,,0,0,0,,ОРУЖИЯ, ЕСЛИ ПОСЛЕДСТВИЯ СПОСОБНЫ ПРИВЕСТИ К
Dialogue: 0,0:01:43.79,0:01:47.22,Caption,,0,0,0,,ОГРОМНОЙ ТЕХНОГЕННОЙ, ЭКОЛОГИЧЕСКОЙ ИЛИ СОЦИАЛЬНОЙ
Dialogue: 0,0:01:47.22,0:01:50.96,Caption,,0,0,0,,КАТАСТРОФЕ. ЗВУЧИТ СЕРЬЁЗНО. ОЧЕНЬ СЕРЬЁЗНО. ТОЛЬКО ЕСТЬ
Dialogue: 0,0:01:50.96,0:01:54.35,Caption,,0,0,0,,ОДНА МАЛЕНЬКАЯ ДЕТАЛЬ. УЖЕ ЗВУЧАТ УВЕРЕННЫЕ ОБЕЩАНИЯ
Dialogue: 0,0:01:54.35,0:01:57.42,Caption,,0,0,0,,УДАРА ПО КИЕВУ И НАТО. НО САМ МЕДВЕДЕВ КОНКРЕТНОГО
Dialogue: 0,0:01:57.42,0:02:00.15,Caption,,0,0,0,,АДРЕСАТА НЕ НАЗВАЛ. ТАК КОМУ ИМЕННО ПРИЛЕТИТ?
Dialogue: 0,0:02:00.25,0:02:02.79,Caption,,0,0,0,,КИЕВУ? СТРАНЕ, КОТОРАЯ ПЕРЕДАСТ ОРУЖИЕ?
Dialogue: 0,0:02:02.96,0:02:05.59,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЕ НАТО? ВСЕМ СРАЗУ?
Dialogue: 0,0:02:06.07,0:02:08.07,Caption,,0,0,0,,А ЕЩЁ САМЫЕ ОСТРЫЕ ПОЛОЖЕНИЯ ОКАЗАЛИСЬ
Dialogue: 0,0:02:08.07,0:02:10.16,Caption,,0,0,0,,НЕ ГДЕ НИБУДЬ КРУПНЫМИ БУКВАМИ В НАЧАЛЕ
Dialogue: 0,0:02:10.16,0:02:12.86,Caption,,0,0,0,,СТАТЬИ, А В СНОСКАХ. ЭТО ВООБЩЕ ЗАМЕЧАТЕЛЬНАЯ
Dialogue: 0,0:02:12.86,0:02:15.75,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ ТРАДИЦИЯ. САМОЕ ИНТЕРЕСНОЕ ИНОГДА
Dialogue: 0,0:02:15.75,0:02:19.08,Caption,,0,0,0,,ЛЕЖИТ ИМЕННО ТАМ, КУДА ОБЫЧНЫЙ ЧЕЛОВЕК НИКОГДА НЕ
Dialogue: 0,0:02:19.08,0:02:21.59,Caption,,0,0,0,,ДОЧИТЫВАЕТ. МЕЛКИЙ ШРИФТ, ПРИМЕЧАНИЕ,
Dialogue: 0,0:02:21.67,0:02:24.09,Caption,,0,0,0,,СНОСКА. ПОЧТИ КАК ДОГОВОР С БАНКОМ. НА
Dialogue: 0,0:02:24.09,0:02:27.19,Caption,,0,0,0,,ПЕРВОЙ СТРАНИЦЕ ВСЁ КРАСИВО, А ПОТОМ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:02:27.36,0:02:30.00,Caption,,0,0,0,,ЧТО САМОЕ ВЕСЁЛОЕ БЫЛО ВНИЗУ. ПРИ ЭТОМ
Dialogue: 0,0:02:30.00,0:02:32.34,Caption,,0,0,0,,МЕДВЕДЕВ ПРИВОДИТ ДОВОЛЬНО ПРОСТОЙ МЫСЛЕННЫЙ
Dialogue: 0,0:02:32.34,0:02:36.84,Caption,,0,0,0,,ЭКСПЕРИМЕНТ. В ДВЕ ТЫСЯЧИ ДЕВЯТНАДЦАТОМ ГОДУ
Dialogue: 0,0:02:36.84,0:02:39.68,Caption,,0,0,0,,УКРАИНА ЗАКРЕПИЛА КУРС НА ВСТУПЛЕНИЕ В НАТО. В ДВЕ
Dialogue: 0,0:02:39.68,0:02:42.00,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТОМ ПОЛУЧИЛА СТАТУС ПАРТНЁРА
Dialogue: 0,0:02:42.00,0:02:44.85,Caption,,0,0,0,,АЛЬЯНСА С РАСШИРЕННЫМИ ВОЗМОЖНОСТЯМИ. МОСКВА
Dialogue: 0,0:02:44.85,0:02:47.92,Caption,,0,0,0,,ГОДАМИ ГОВОРИЛА, ЧТО СЧИТАЕТ ДАЛЬНЕЙШЕЕ ВОЕННОЕ
Dialogue: 0,0:02:47.92,0:02:50.52,Caption,,0,0,0,,СБЛИЖЕНИЕ ПРЯМОЙ УГРОЗОЙ. ЧТО БЫЛО БЫ,
Dialogue: 0,0:02:50.79,0:02:52.96,Caption,,0,0,0,,ЕСЛИ РОССИЯ ПРЕДЛОЖИЛА ИРАНУ ПРИМЕРНО
Dialogue: 0,0:02:52.96,0:02:55.72,Caption,,0,0,0,,ТУ ЖЕ МОДЕЛЬ, КОТОРАЯ СУЩЕСТВУЕТ ВНУТРИ НАТО?
Dialogue: 0,0:02:55.94,0:02:59.35,Caption,,0,0,0,,САМО ОРУЖИЕ РОССИЙСКОЕ, КОНТРОЛЬ ОСТАЁТСЯ У РОССИЙСКОГО
Dialogue: 0,0:02:59.35,0:03:02.26,Caption,,0,0,0,,КОМАНДОВАНИЯ, НО ВСЁ ЭТО ПОЯВЛЯЕТСЯ НА ТЕРРИТОРИИ
Dialogue: 0,0:03:02.26,0:03:04.74,Caption,,0,0,0,,ИРАНА. ДУМАЮ, В ВАШИНГТОНЕ НИКТО НЕ СТАЛ БЫ
Dialogue: 0,0:03:04.74,0:03:07.20,Caption,,0,0,0,,ОБЪЯСНЯТЬ, ЧТО ЭТО ВСЕГО ЛИШЬ ТЕХНИЧЕСКАЯ ФОРМА
Dialogue: 0,0:03:07.20,0:03:10.02,Caption,,0,0,0,,СОТРУДНИЧЕСТВА И БЕСПОКОИТЬСЯ СОВЕРШЕННО НЕ О ЧЕМ.
Dialogue: 0,0:03:10.02,0:03:12.82,Caption,,0,0,0,,ВОТ ТУТ ЛОГИКА МЕДВЕДЕВА ВПОЛНЕ ПОНЯТНА. ЕСЛИ
Dialogue: 0,0:03:12.82,0:03:15.24,Caption,,0,0,0,,ПОДОБНОЕ СЧИТАЕТСЯ УГРОЗОЙ ДЛЯ ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:03:15.48,0:03:18.65,Caption,,0,0,0,,СТРАННО ТРЕБОВАТЬ, ЧТОБЫ ДРУГАЯ СТОРОНА СМОТРЕЛА НА ТУ ЖЕ
Dialogue: 0,0:03:18.65,0:03:21.05,Caption,,0,0,0,,КОНСТРУКЦИЮ КАК НА ДРУЖЕСКИЙ ЖЕСТ. НО ДАЛЬШЕ
Dialogue: 0,0:03:21.05,0:03:24.34,Caption,,0,0,0,,НАЧИНАЕТСЯ САМОЕ ИНТЕРЕСНОЕ. ПОТОМУ ЧТО ЯДЕРНОЕ ОРУЖИЕ
Dialogue: 0,0:03:24.34,0:03:27.42,Caption,,0,0,0,,ДОЛЖНО НЕ ТОЛЬКО СУЩЕСТВОВАТЬ. ОНО ДОЛЖНО ЕЩЁ И
Dialogue: 0,0:03:27.42,0:03:29.80,Caption,,0,0,0,,СДЕРЖИВАТЬ. А ВОТ ЗДЕСЬ, К СОЖАЛЕНИЮ,
Dialogue: 0,0:03:29.95,0:03:33.72,Caption,,0,0,0,,УЖЕ ДАЖЕ ПРОСТОЙ ЧЕЛОВЕК, ПРОСТАЯ ДОМОХОЗЯЙКА ГДЕ НИБУДЬ В ТВЕРИ
Dialogue: 0,0:03:33.72,0:03:36.38,Caption,,0,0,0,,ПРЕКРАСНО ВИДИТ ОДНУ ВЕЩЬ. ЗАПАД РОССИЙСКИХ
Dialogue: 0,0:03:36.38,0:03:40.40,Caption,,0,0,0,,ЯДЕРНЫХ УГРОЗ НЕ БОИТСЯ ТАК, КАК ДОЛЖЕН БЫЛ БЫ БОЯТЬСЯ ГОСУДАРСТВА
Dialogue: 0,0:03:40.40,0:03:43.56,Caption,,0,0,0,,С ТАКИМ АРСЕНАЛОМ. НЕ ПОТОМУ, ЧТО ТАМ ЗАБЫЛИ,
Dialogue: 0,0:03:43.75,0:03:48.31,Caption,,0,0,0,,СКОЛЬКО У РОССИИ БОЕГОЛОВОК. НЕ ПОТОМУ,
Dialogue: 0,0:03:48.45,0:03:50.79,Caption,,0,0,0,,ЧТО НЕ ЗНАЮТ О РАКЕТАХ, ПОДЛОДКАХ,
Dialogue: 0,0:03:50.95,0:03:52.77,Caption,,0,0,0,,СТРАТЕГИЧЕСКОЙ АВИАЦИИ ИЛИ ТОМ ЖЕ
Dialogue: 0,0:03:52.77,0:03:55.59,Caption,,0,0,0,,"ПОСЕЙДОНЕ". ПРЕКРАСНО ВСЁ ЗНАЮТ. ОНИ,
Dialogue: 0,0:03:55.75,0:03:59.19,Caption,,0,0,0,,СУДЯ ПО СВОИМ ДЕЙСТВИЯМ, ПРОСТО ВЫНЕСЛИ РОССИЙСКОЕ ЯДЕРНОЕ
Dialogue: 0,0:03:59.19,0:04:01.27,Caption,,0,0,0,,ОРУЖИЕ ЗА СКОБКИ СОБСТВЕННОГО РАСЧЁТА.
Dialogue: 0,0:04:01.83,0:04:04.09,Caption,,0,0,0,,РАСЧЁТ ВЫГЛЯДИТ ПРИМЕРНО ТАК. ОНО
Dialogue: 0,0:04:04.09,0:04:07.43,Caption,,0,0,0,,ЕСТЬ. ОНО ОГРОМНОЕ. ОНО СПОСОБНО УСТРОИТЬ КОНЕЦ
Dialogue: 0,0:04:07.43,0:04:09.59,Caption,,0,0,0,,СВЕТА. НО РОССИЯ ЕГО НЕ ПРИМЕНИТ,
Dialogue: 0,0:04:09.67,0:04:11.47,Caption,,0,0,0,,ПОКА СИТУАЦИЯ НЕ СТАНЕТ СОВСЕМ
Dialogue: 0,0:04:11.47,0:04:14.62,Caption,,0,0,0,,КРИТИЧЕСКОЙ. И ВОТ ЭТО УЖЕ ГОРАЗДО ВАЖНЕЕ КОЛИЧЕСТВА
Dialogue: 0,0:04:14.62,0:04:16.95,Caption,,0,0,0,,БОЕГОЛОВОК. ПОТОМУ ЧТО ЯДЕРНОЕ ОРУЖИЕ,
Dialogue: 0,0:04:17.04,0:04:18.95,Caption,,0,0,0,,"ПОСЕЙДОНЫ" И ВСЁ ОСТАЛЬНОЕ В ТАКОЙ
Dialogue: 0,0:04:18.95,0:04:21.52,Caption,,0,0,0,,ЛОГИКЕ ПРЕВРАЩАЮТСЯ В ОРУЖИЕ ПОСЛЕДНЕГО
Dialogue: 0,0:04:21.52,0:04:24.17,Caption,,0,0,0,,УДАРА. НЕ ПОСЛЕДНЕГО АРГУМЕНТА В СПОРЕ. А
Dialogue: 0,0:04:24.17,0:04:27.03,Caption,,0,0,0,,ПОСЛЕДНЕГО УДАРА, КОГДА СПОР УЖЕ ЗАКОНЧИЛСЯ,
Dialogue: 0,0:04:27.19,0:04:30.20,Caption,,0,0,0,,СТОЛ ПЕРЕВЁРНУТ, МЕБЕЛЬ СЛОМАНА И ВСЕМ СТАЛО
Dialogue: 0,0:04:30.20,0:04:33.78,Caption,,0,0,0,,ОКОНЧАТЕЛЬНО ЯСНО, ЧТО ДАЛЬШЕ ИДТИ УЖЕ ПРОСТО НЕКУДА.
Dialogue: 0,0:04:33.78,0:04:35.75,Caption,,0,0,0,,ЧТОБЫ РОССИЯ ДОШЛА ДО ТАКОЙ ТОЧКИ,
Dialogue: 0,0:04:36.07,0:04:38.54,Caption,,0,0,0,,ЕЙ ПРИДЁТСЯ ПРОЙТИ ОЧЕНЬ ПЛОХОЙ ПУТЬ.
Dialogue: 0,0:04:38.54,0:04:41.05,Caption,,0,0,0,,ОЧЕНЬ СТРАШНЫЙ. ПРАКТИЧЕСКИ ОКАЗАТЬСЯ НА
Dialogue: 0,0:04:41.05,0:04:44.42,Caption,,0,0,0,,ГРАНИ ПОРАЖЕНИЯ, КОГДА ОБЫЧНЫМИ СРЕДСТВАМИ СИТУАЦИЮ УЖЕ
Dialogue: 0,0:04:44.42,0:04:47.18,Caption,,0,0,0,,НЕ УДЕРЖАТЬ. И ЕСЛИ СМОТРЕТЬ НА ХАРАКТЕР РЕШЕНИЙ
Dialogue: 0,0:04:47.18,0:04:49.51,Caption,,0,0,0,,МОСКВЫ ЗА ВСЕ ЭТИ ГОДЫ, НА ТО,
Dialogue: 0,0:04:49.67,0:04:51.73,Caption,,0,0,0,,КАК ПУТИН ПРИНИМАЕТ САМЫЕ ТЯЖЁЛЫЕ
Dialogue: 0,0:04:51.73,0:04:54.03,Caption,,0,0,0,,РЕШЕНИЯ, КАК ДОЛГО ОБЫЧНО ОСТАВЛЯЕТСЯ
Dialogue: 0,0:04:54.03,0:04:55.91,Caption,,0,0,0,,ПРОСТРАНСТВО ДЛЯ СЛЕДУЮЩЕГО ШАГА,
Dialogue: 0,0:04:56.31,0:05:01.11,Caption,,0,0,0,,ТО ИМЕННО НА ЭТО, ПОХОЖЕ, И СТРОИТСЯ ЗАПАДНЫЙ РАСЧЁТ. НЕ НА ТО,
Dialogue: 0,0:05:01.27,0:05:03.19,Caption,,0,0,0,,ЧТО У РОССИИ НЕТ ЯДЕРНОГО ОРУЖИЯ.
Dialogue: 0,0:05:05.46,0:05:08.18,Caption,,0,0,0,,А НА ТО, ЧТО ПРИМЕНИТ ОНА ЕГО ТОЛЬКО ТОГДА,
Dialogue: 0,0:05:08.42,0:05:10.42,Caption,,0,0,0,,КОГДА ВСЁ УЖЕ БУДЕТ ПОЧТИ НА КРАЮ.
Dialogue: 0,0:05:10.98,0:05:13.62,Caption,,0,0,0,,ВОТ ПОЭТОМУ ОЧЕРЕДНОЕ ГРОЗНОЕ ЗАЯВЛЕНИЕ МЕДВЕДЕВА
Dialogue: 0,0:05:13.62,0:05:15.71,Caption,,0,0,0,,САМО ПО СЕБЕ НИЧЕГО НЕ МЕНЯЕТ. ОН
Dialogue: 0,0:05:15.71,0:05:18.70,Caption,,0,0,0,,СНОВА ВПЕРЕДИ. СНОВА ГОВОРИТ ЖЁСТЧЕ МНОГИХ.
Dialogue: 0,0:05:18.70,0:05:21.74,Caption,,0,0,0,,СНОВА ПРЕДУПРЕЖДАЕТ. НО МЫ ЭТО УЖЕ ВИДЕЛИ.
Dialogue: 0,0:05:21.74,0:05:25.59,Caption,,0,0,0,,БОРЗО, ДЕРЗКО, ЯРКО. А ДАЛЬШЕ ЗАЯВЛЕНИЯ ОЧЕНЬ ЧАСТО
Dialogue: 0,0:05:25.59,0:05:28.07,Caption,,0,0,0,,ТАК И ОСТАЮТСЯ ЗАЯВЛЕНИЯМИ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:05:28.07,0:05:31.77,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ КОСМОС. ЗАПАДНЫЕ РАЗВЕДКИ СЕЙЧАС ОБСУЖДАЮТ УЖЕ
Dialogue: 0,0:05:31.77,0:05:34.18,Caption,,0,0,0,,СОВСЕМ ДРУГУЮ ИСТОРИЮ. ПО ИХ ДАННЫМ,
Dialogue: 0,0:05:34.43,0:05:36.68,Caption,,0,0,0,,РОССИЯ СПОСОБНА ДО КОНЦА ГОДА ВЫВЕСТИ
Dialogue: 0,0:05:36.68,0:05:39.94,Caption,,0,0,0,,НА ОРБИТУ АППАРАТ, КОТОРЫЙ ОНИ НАЗЫВАЮТ "СПУТНИК С",
Dialogue: 0,0:05:40.11,0:05:42.34,Caption,,0,0,0,,С ЯДЕРНЫМ ЗАРЯДОМ. СООБЩАЕТСЯ,
Dialogue: 0,0:05:42.50,0:05:44.39,Caption,,0,0,0,,ЧТО АППАРАТ НЕСКОЛЬКО ЛЕТ НАХОДИЛСЯ В
Dialogue: 0,0:05:44.39,0:05:46.81,Caption,,0,0,0,,ГОТОВОМ СОСТОЯНИИ В МОСКОВСКОМ РЕГИОНЕ. В
Dialogue: 0,0:05:46.81,0:05:49.54,Caption,,0,0,0,,НАЧАЛЕ НОЯБРЯ СОЮЗНИКАМ ПЕРЕДАЛИ ПРЕДУПРЕЖДЕНИЕ,
Dialogue: 0,0:05:49.78,0:05:51.82,Caption,,0,0,0,,ЧТО ЗАПУСК МОЖЕТ СОСТОЯТЬСЯ В ТЕЧЕНИЕ
Dialogue: 0,0:05:51.82,0:05:54.11,Caption,,0,0,0,,ШЕСТИДЕСЯТИ ДНЕЙ. НЕМЕЦКОЕ КОСМИЧЕСКОЕ
Dialogue: 0,0:05:54.11,0:05:57.47,Caption,,0,0,0,,КОМАНДОВАНИЕ ДОПУСКАЕТ ДЕКАБРЬ. ПРИЧЁМ САМА ЭТА ИСТОРИЯ
Dialogue: 0,0:05:57.47,0:06:00.59,Caption,,0,0,0,,ПОЯВИЛАСЬ НЕ ВЧЕРА. ВНУТРЕННИЕ ПРЕДУПРЕЖДЕНИЯ В США О
Dialogue: 0,0:06:00.59,0:06:02.99,Caption,,0,0,0,,ПОДОБНОЙ УГРОЗЕ ХОДИЛИ ЕЩЁ С ФЕВРАЛЯ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:06:02.99,0:06:06.80,Caption,,0,0,0,,ДВАДЦАТЬ ТРЕТЬЕГО ГОДА. АМЕРИКАНСКАЯ ВОЕННАЯ РАЗВЕДКА ПОЗДНЕЕ
Dialogue: 0,0:06:06.80,0:06:09.46,Caption,,0,0,0,,СООБЩАЛА, ЧТО РОССИЯ РАБОТАЕТ НАД СИСТЕМОЙ,
Dialogue: 0,0:06:09.62,0:06:11.73,Caption,,0,0,0,,СПОСОБНОЙ НЕСТИ ЯДЕРНОЕ ОРУЖИЕ В
Dialogue: 0,0:06:11.73,0:06:15.06,Caption,,0,0,0,,КОСМОС. И ТУТ ХОЧЕТСЯ ЗАДАТЬ СОВСЕМ ПРОСТОЙ ВОПРОС.
Dialogue: 0,0:06:15.06,0:06:17.38,Caption,,0,0,0,,А ЧТО, СОБСТВЕННО, ОСТАЁТСЯ ДЕЛАТЬ?
Dialogue: 0,0:06:19.58,0:06:21.33,Caption,,0,0,0,,ЕСЛИ ВЫ САМИ ОФИЦИАЛЬНО СОЗДАЁТЕ
Dialogue: 0,0:06:21.33,0:06:23.10,Caption,,0,0,0,,ВОЕННУЮ ГРУППИРОВКУ В КОСМОСЕ,
Dialogue: 0,0:06:23.42,0:06:25.34,Caption,,0,0,0,,ЕСЛИ ВЫ ТУДА УЖЕ ПРИТАЩИЛИ МЕЧ,
Dialogue: 0,0:06:25.65,0:06:29.33,Caption,,0,0,0,,ТО ПОЧЕМУ ВАС УДИВЛЯЕТ, ЧТО КТО ТО ДРУГОЙ НАЧИНАЕТ ТАЩИТЬ ТУДА
Dialogue: 0,0:06:29.33,0:06:32.71,Caption,,0,0,0,,ЩИТ? ВАМ ЗЕМЛИ БЫЛО МАЛО? ЗДЕСЬ УМУДРИЛИСЬ УСТРОИТЬ
Dialogue: 0,0:06:32.71,0:06:34.86,Caption,,0,0,0,,ПРОТИВОСТОЯНИЕ НА МОРЕ, НА СУШЕ,
Dialogue: 0,0:06:34.95,0:06:39.02,Caption,,0,0,0,,В ВОЗДУХЕ, ПОД ВОДОЙ, В КИБЕРПРОСТРАНСТВЕ. ТЕПЕРЬ ОЧЕРЕДЬ
Dialogue: 0,0:06:39.02,0:06:41.26,Caption,,0,0,0,,ДОШЛА ДО ОРБИТЫ. И САМОЕ СМЕШНОЕ,
Dialogue: 0,0:06:41.57,0:06:43.22,Caption,,0,0,0,,ЕСЛИ ВООБЩЕ ЗДЕСЬ МОЖНО УПОТРЕБЛЯТЬ
Dialogue: 0,0:06:43.22,0:06:45.82,Caption,,0,0,0,,СЛОВО "СМЕШНОЕ", ЧТО ПОСЛЕ ЭТОГО КАЖДАЯ СТОРОНА
Dialogue: 0,0:06:45.82,0:06:48.38,Caption,,0,0,0,,НАЧИНАЕТ ОЧЕНЬ ИСКРЕННЕ ВОЗМУЩАТЬСЯ ДЕЙСТВИЯМИ
Dialogue: 0,0:06:48.38,0:06:50.99,Caption,,0,0,0,,ДРУГОЙ. МЫ ТУТ ПРОСТО ОБЕСПЕЧИВАЕМ
Dialogue: 0,0:06:50.99,0:06:55.04,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. А ОНИ МИЛИТАРИЗИРУЮТ КОСМОС. КОНЕЧНО. СТАРЫЙ
Dialogue: 0,0:06:55.04,0:06:58.03,Caption,,0,0,0,,ДОБРЫЙ ПОЛИТИЧЕСКИЙ ФОКУС. МОЙ МЕЧ ЭТО
Dialogue: 0,0:06:58.03,0:07:01.85,Caption,,0,0,0,,ЗАЩИТА. ТВОЙ ЩИТ ЭТО ЭСКАЛАЦИЯ. ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ
Dialogue: 0,0:07:01.85,0:07:04.61,Caption,,0,0,0,,ФОРМАТ, ПОДДЕРЖИТЕ КАНАЛ ПОДПИСКОЙ. ПОТОМУ ЧТО
Dialogue: 0,0:07:04.61,0:07:07.16,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЕТСЯ УЖЕ НЕ СПОР О КРАСИВЫХ
Dialogue: 0,0:07:07.16,0:07:10.66,Caption,,0,0,0,,ЗАЯВЛЕНИЯХ. ДАЛЬШЕ НАЧИНАЕТСЯ ВОПРОС ЦЕНЫ ЭТОЙ ИГРЫ.
Dialogue: 0,0:07:10.66,0:07:13.58,Caption,,0,0,0,,АМЕРИКАНСКОЕ КОСМИЧЕСКОЕ КОМАНДОВАНИЕ ПРЕДУПРЕЖДАЕТ
Dialogue: 0,0:07:13.58,0:07:16.26,Caption,,0,0,0,,ЯДЕРНЫЙ ВЗРЫВ НА НИЗКОЙ ОКОЛОЗЕМНОЙ ОРБИТЕ СПОСОБЕН
Dialogue: 0,0:07:16.26,0:07:18.76,Caption,,0,0,0,,ВЫВЕСТИ ИЗ СТРОЯ ОКОЛО ТРЕТИ НАХОДЯЩИХСЯ ТАМ
Dialogue: 0,0:07:18.76,0:07:21.84,Caption,,0,0,0,,СПУТНИКОВ УЖЕ В ПЕРВЫЕ ЧАСЫ ИЛИ ДНИ. В ПОСЛЕДУЮЩИЕ
Dialogue: 0,0:07:21.84,0:07:24.03,Caption,,0,0,0,,МЕСЯЦЫ МОГУТ ОТКАЗАТЬ И ОСТАЛЬНЫЕ. А
Dialogue: 0,0:07:24.03,0:07:27.78,Caption,,0,0,0,,ЭЛЕКТРОМАГНИТНЫЙ ИМПУЛЬС СПОСОБЕН ВЫЗВАТЬ МАСШТАБНЫЕ СБОИ ДАЖЕ
Dialogue: 0,0:07:27.78,0:07:29.66,Caption,,0,0,0,,НА ЗЕМЛЕ. ЭТО УЖЕ НЕ ОДИН АППАРАТ,
Dialogue: 0,0:07:29.88,0:07:31.82,Caption,,0,0,0,,КОТОРЫЙ ЭФФЕКТНО ПОГАСНЕТ НА ЭКРАНЕ.
Dialogue: 0,0:07:34.10,0:07:36.17,Caption,,0,0,0,,СОВРЕМЕННЫЙ МИР СИДИТ НА СПУТНИКАХ
Dialogue: 0,0:07:36.17,0:07:38.50,Caption,,0,0,0,,ПЛОТНЕЕ, ЧЕМ МНОГИЕ ДУМАЮТ. СВЯЗЬ,
Dialogue: 0,0:07:38.59,0:07:41.86,Caption,,0,0,0,,НАВИГАЦИЯ, РАЗВЕДКА, БАНКОВСКИЕ ОПЕРАЦИИ,
Dialogue: 0,0:07:41.95,0:07:44.66,Caption,,0,0,0,,ЛОГИСТИКА, АРМИЯ, АВИАЦИЯ,
Dialogue: 0,0:07:44.74,0:07:47.85,Caption,,0,0,0,,МОРЕ. УДАР ПО СПУТНИКОВОЙ ИНФРАСТРУКТУРЕ ЭТО
Dialogue: 0,0:07:47.85,0:07:50.58,Caption,,0,0,0,,НЕ КРАСИВЫЙ КОСМИЧЕСКИЙ ФЕЙЕРВЕРК. ЭТО ПОПЫТКА
Dialogue: 0,0:07:50.58,0:07:54.01,Caption,,0,0,0,,ВЫБИТЬ ГЛАЗА И УШИ СРАЗУ У ОГРОМНОЙ СИСТЕМЫ. ПЛЮС
Dialogue: 0,0:07:54.01,0:07:56.91,Caption,,0,0,0,,ОБЛОМКИ. ОДИН РАЗРУШЕННЫЙ АППАРАТ СОЗДАЁТ НОВЫЕ
Dialogue: 0,0:07:56.91,0:07:58.98,Caption,,0,0,0,,ОБЛОМКИ, ТЕ БЬЮТ ДРУГИЕ АППАРАТЫ,
Dialogue: 0,0:07:59.14,0:08:01.49,Caption,,0,0,0,,ТЕ СОЗДАЮТ НОВЫЕ. ПОЛУЧАЕТСЯ ТОТ САМЫЙ
Dialogue: 0,0:08:01.49,0:08:04.60,Caption,,0,0,0,,ЭФФЕКТ КЕССЛЕРА, КОГДА КОСМОС НАЧИНАЕТ ПРЕВРАЩАТЬСЯ В
Dialogue: 0,0:08:04.60,0:08:08.00,Caption,,0,0,0,,ГИГАНТСКУЮ СВАЛКУ, ЧЕРЕЗ КОТОРУЮ УЖЕ ОПАСНО ЛЕТАТЬ ВООБЩЕ
Dialogue: 0,0:08:08.00,0:08:10.84,Caption,,0,0,0,,ВСЕМ. И ВОТ ГЕРМАНИЯ УЖЕ ОБСУЖДАЕТ ЗАЩИТУ
Dialogue: 0,0:08:10.84,0:08:13.46,Caption,,0,0,0,,СВОИХ СПУТНИКОВ И СРЕДСТВА УНИЧТОЖЕНИЯ ИЛИ
Dialogue: 0,0:08:13.46,0:08:16.81,Caption,,0,0,0,,НЕЙТРАЛИЗАЦИИ ЧУЖИХ АППАРАТОВ. ТО ЕСТЬ СХЕМА ПОЧТИ
Dialogue: 0,0:08:16.81,0:08:19.74,Caption,,0,0,0,,ИДЕАЛЬНАЯ. СНАЧАЛА ОДНА СТОРОНА РАЗВИВАЕТ ВОЕННЫЕ
Dialogue: 0,0:08:19.74,0:08:23.04,Caption,,0,0,0,,ВОЗМОЖНОСТИ В КОСМОСЕ. ПОТОМ ДРУГАЯ СТОРОНА ОТВЕЧАЕТ
Dialogue: 0,0:08:23.04,0:08:25.81,Caption,,0,0,0,,СВОИМИ. ПОТОМ ПЕРВАЯ СТОРОНА ПУГАЕТСЯ ОТВЕТА И
Dialogue: 0,0:08:25.81,0:08:28.18,Caption,,0,0,0,,НАЧИНАЕТ СОЗДАВАТЬ ОРУЖИЕ ПРОТИВ ОРУЖИЯ,
Dialogue: 0,0:08:28.42,0:08:30.50,Caption,,0,0,0,,КОТОРОЕ ПОЯВИЛОСЬ КАК ОТВЕТ НА ЕЁ ЖЕ
Dialogue: 0,0:08:30.50,0:08:33.30,Caption,,0,0,0,,ОРУЖИЕ. ЧЕРЕЗ ПАРУ КРУГОВ НИКТО УЖЕ НЕ ПОМНИТ,
Dialogue: 0,0:08:33.39,0:08:35.70,Caption,,0,0,0,,КТО ПЕРВЫЙ ПОЛЕЗ НА ДЕРЕВО. ЗАТО ВСЕ
Dialogue: 0,0:08:35.70,0:08:37.94,Caption,,0,0,0,,СИДЯТ НА ВЕТКАХ С ДУБИНАМИ. И ВСЁ ЭТО,
Dialogue: 0,0:08:38.06,0:08:41.51,Caption,,0,0,0,,РАЗУМЕЕТСЯ, ТРЕБУЕТ ДЕНЕГ. МНОГО ДЕНЕГ. ФРИДРИХ
Dialogue: 0,0:08:41.51,0:08:44.59,Caption,,0,0,0,,МЕРЦ УЖЕ ГОВОРИТ, ЧТО НОВЫЕ РАЗВЕДДАННЫЕ ПОКАЗЫВАЮТ
Dialogue: 0,0:08:44.59,0:08:46.90,Caption,,0,0,0,,ГОТОВНОСТЬ РОССИИ К ДАЛЬНЕЙШЕЙ ЭСКАЛАЦИИ.
Dialogue: 0,0:08:49.18,0:08:50.86,Caption,,0,0,0,,НЕМЕЦКОЕ ПРАВИТЕЛЬСТВО ЗАЯВЛЯЕТ,
Dialogue: 0,0:08:51.09,0:08:53.34,Caption,,0,0,0,,ЧТО ОТНОСИТСЯ К СООБЩЕНИЯМ О РОССИЙСКОМ ЯДЕРНОМ
Dialogue: 0,0:08:53.34,0:08:55.80,Caption,,0,0,0,,СПУТНИКЕ ОЧЕНЬ СЕРЬЁЗНО. ПОЯВИЛИСЬ
Dialogue: 0,0:08:55.80,0:08:58.67,Caption,,0,0,0,,СВЕДЕНИЯ, ЧТО АППАРАТ УЖЕ ИЗВЛЕЧЁН ИЗ ХРАНИЛИЩА
Dialogue: 0,0:08:58.67,0:09:01.57,Caption,,0,0,0,,И ГОТОВИТСЯ К ЗАПУСКУ. ТО ЕСТЬ ПОЛИТИЧЕСКАЯ ЧАСТЬ
Dialogue: 0,0:09:01.57,0:09:04.93,Caption,,0,0,0,,ПРОЦЕССА УЖЕ ЗАПУЩЕНА. УГРОЗА НАЗВАНА. ОПАСНОСТЬ
Dialogue: 0,0:09:04.93,0:09:07.81,Caption,,0,0,0,,ОБЪЯВЛЕНА. РАСХОДЫ НА ПРОТИВОДЕЙСТВИЕ МОЖНО
Dialogue: 0,0:09:07.81,0:09:11.02,Caption,,0,0,0,,ОБЪЯСНЯТЬ. А ДАЛЬШЕ ЗАПУСКАЕТСЯ ЗНАКОМЫЙ МЕХАНИЗМ. НАМ
Dialogue: 0,0:09:11.02,0:09:13.92,Caption,,0,0,0,,НУЖНА ЗАЩИТА, ПОТОМУ ЧТО У НИХ ПОЯВИЛОСЬ НОВОЕ
Dialogue: 0,0:09:13.92,0:09:17.50,Caption,,0,0,0,,ОРУЖИЕ. ОНИ ОТВЕЧАЮТ, ЧТО НОВОЕ ОРУЖИЕ ПОЯВИЛОСЬ ПОТОМУ,
Dialogue: 0,0:09:17.66,0:09:20.14,Caption,,0,0,0,,ЧТО ВЫ СОЗДАЛИ СВОЮ СИСТЕМУ РАНЬШЕ. И
Dialogue: 0,0:09:20.14,0:09:22.54,Caption,,0,0,0,,КАЖДЫЙ СЛЕДУЮЩИЙ КРУГ СТАНОВИТСЯ ДОРОЖЕ
Dialogue: 0,0:09:22.54,0:09:25.37,Caption,,0,0,0,,ПРЕДЫДУЩЕГО. ПРИ ЭТОМ ЕСТЬ ЕЩЁ ДОГОВОР О КОСМОСЕ ТЫСЯЧА
Dialogue: 0,0:09:25.37,0:09:27.02,Caption,,0,0,0,,ДЕВЯТЬСОТ ШЕСТЬДЕСЯТ СЕДЬМОГО ГОДА,
Dialogue: 0,0:09:27.42,0:09:29.62,Caption,,0,0,0,,КОТОРЫЙ ЗАПРЕЩАЕТ РАЗМЕЩАТЬ НА ОРБИТЕ
Dialogue: 0,0:09:29.62,0:09:32.34,Caption,,0,0,0,,ЯДЕРНОЕ ОРУЖИЕ И ДРУГИЕ ВИДЫ ОРУЖИЯ МАССОВОГО
Dialogue: 0,0:09:32.34,0:09:35.37,Caption,,0,0,0,,УНИЧТОЖЕНИЯ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТОМ ГОДУ РОССИЯ
Dialogue: 0,0:09:35.37,0:09:38.30,Caption,,0,0,0,,НАЛОЖИЛА ВЕТО НА РЕЗОЛЮЦИЮ СОВЕТА БЕЗОПАСНОСТИ ООН,
Dialogue: 0,0:09:38.54,0:09:40.59,Caption,,0,0,0,,КОТОРАЯ ПОДТВЕРЖДАЛА ЭТОТ ЗАПРЕТ.
Dialogue: 0,0:09:40.59,0:09:42.62,Caption,,0,0,0,,ТРИНАДЦАТЬ СТРАН ПРОГОЛОСОВАЛИ ЗА,
Dialogue: 0,0:09:42.84,0:09:45.03,Caption,,0,0,0,,КИТАЙ ВОЗДЕРЖАЛСЯ. РОССИЙСКАЯ СТОРОНА
Dialogue: 0,0:09:45.03,0:09:47.57,Caption,,0,0,0,,ПРИ ЭТОМ ОТВЕРГАЕТ ОБВИНЕНИЯ В ПОДГОТОВКЕ
Dialogue: 0,0:09:47.57,0:09:50.44,Caption,,0,0,0,,ЯДЕРНОГО ЗАПУСКА И ГОВОРИТ О МИРНОМ ХАРАКТЕРЕ СВОЕЙ
Dialogue: 0,0:09:50.44,0:09:53.02,Caption,,0,0,0,,КОСМИЧЕСКОЙ ДЕЯТЕЛЬНОСТИ. И ВОТ ТУТ КАК РАЗ НЕ
Dialogue: 0,0:09:53.02,0:09:55.60,Caption,,0,0,0,,НАДО НИЧЕГО УСЛОЖНЯТЬ. ЕСТЬ СООБЩЕНИЯ
Dialogue: 0,0:09:55.60,0:09:59.35,Caption,,0,0,0,,РАЗВЕДОК. ЕСТЬ ПРЕДУПРЕЖДЕНИЯ ВОЕННЫХ. ЕСТЬ ОТРИЦАНИЕ
Dialogue: 0,0:09:59.35,0:10:05.02,Caption,,0,0,0,,МОСКВЫ. ЕСТЬ ДОГОВОР. ЕСТЬ ВЕТО. ЕСТЬ УСКОРЯЮЩЕЕСЯ
Dialogue: 0,0:10:05.02,0:10:07.53,Caption,,0,0,0,,ВООРУЖЕНИЕ КОСМОСА. И ЕСТЬ ОДИН ФАКТ,
Dialogue: 0,0:10:07.69,0:10:09.69,Caption,,0,0,0,,КОТОРЫЙ ВИДНО БЕЗ ТЕЛЕСКОПА. ВСЕ
Dialogue: 0,0:10:09.69,0:10:12.71,Caption,,0,0,0,,УЧАСТНИКИ УЖЕ ГОТОВЯТСЯ К СЛЕДУЮЩЕМУ ЭТАПУ. А НА
Dialogue: 0,0:10:12.71,0:10:15.70,Caption,,0,0,0,,ЗЕМЛЕ ТЕМ ВРЕМЕНЕМ ИДЁТ ДРУГАЯ ЗНАКОМАЯ ИСТОРИЯ.
Dialogue: 0,0:10:15.70,0:10:19.45,Caption,,0,0,0,,СНОВА ПОЯВИЛИСЬ СООБЩЕНИЯ, ЧТО ПОСЛЕ ПРЕДПОЛАГАЕМОГО ОБРУШЕНИЯ
Dialogue: 0,0:10:19.45,0:10:22.66,Caption,,0,0,0,,АРКИ КРЫМСКОГО МОСТА ПУТИН ЯКОБЫ ПОРУЧИЛ ПОДГОТОВИТЬ
Dialogue: 0,0:10:22.66,0:10:25.61,Caption,,0,0,0,,ЧЁТКИЙ ПЛАН УДАРОВ ПО МОСТАМ ЧЕРЕЗ ДНЕПР. СНОВА
Dialogue: 0,0:10:25.61,0:10:28.67,Caption,,0,0,0,,НАЗЫВАЮТСЯ ОТВЕТСТВЕННЫЕ. СНОВА КТО ТО УЖЕ ЧТО ТО
Dialogue: 0,0:10:28.67,0:10:31.67,Caption,,0,0,0,,ПРЕДСТАВИЛ. СНОВА ИДУТ СРОКИ. В ТЕЧЕНИЕ ТРЁХ
Dialogue: 0,0:10:31.67,0:10:34.88,Caption,,0,0,0,,МЕСЯЦЕВ ЯКОБЫ ДОЛЖНЫ ВЫВЕСТИ ИЗ СТРОЯ МИНИМУМ ДВА
Dialogue: 0,0:10:34.88,0:10:38.27,Caption,,0,0,0,,МОСТА. ПЕРВЫМИ НАЗЫВАЮТ МОСТЫ В ЗАПОРОЖЬЕ. А КИЕВСКИЕ
Dialogue: 0,0:10:38.27,0:10:41.84,Caption,,0,0,0,,МОСТЫ, ПО ЭТОМУ СЛУХУ, СОБИРАЮТСЯ ВЫВОДИТЬ ИЗ СТРОЯ ДО ОСЕНИ
Dialogue: 0,0:10:41.84,0:10:44.67,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА. ЧИТАЕШЬ И
Dialogue: 0,0:10:44.67,0:10:48.33,Caption,,0,0,0,,ВОЗНИКАЕТ ОЩУЩЕНИЕ ДЕЖАВЮ. МЫ ЭТО УЖЕ СКОЛЬКО ЛЕТ СЛЫШИМ?
Dialogue: 0,0:10:48.56,0:10:52.57,Caption,,0,0,0,,СКОЛЬКО РАЗ НАМ РАССКАЗЫВАЛИ, ЧТО ВОТ ТЕПЕРЬ ТОЧНО ПРИНЯТО РЕШЕНИЕ?
Dialogue: 0,0:10:52.81,0:10:55.03,Caption,,0,0,0,,ВОТ ТЕПЕРЬ ТОЧНО МОСТЫ. ВОТ ТЕПЕРЬ
Dialogue: 0,0:10:55.03,0:10:58.33,Caption,,0,0,0,,ТОЧНО УНИЧТОЖАТ ЛОГИСТИКУ. ВОТ ТЕПЕРЬ ТОЧНО ПРИКАЗ УЖЕ
Dialogue: 0,0:10:58.33,0:11:01.15,Caption,,0,0,0,,ЛЕЖИТ НА СТОЛЕ. И КАЖДЫЙ РАЗ ПОЯВЛЯЕТСЯ КАКОЙ
Dialogue: 0,0:11:01.15,0:11:03.53,Caption,,0,0,0,,ТО ИСТОЧНИК, КОТОРЫЙ ПРЕКРАСНО ЗНАЕТ,
Dialogue: 0,0:11:03.69,0:11:05.69,Caption,,0,0,0,,ЧТО ПУТИН СКАЗАЛ ЗА ЗАКРЫТОЙ ДВЕРЬЮ,
Dialogue: 0,0:11:05.92,0:11:09.17,Caption,,0,0,0,,КОМУ ПОРУЧИЛ, КАКИЕ СРОКИ ПОСТАВИЛ И ЧТО СОБИРАЕТСЯ
Dialogue: 0,0:11:09.17,0:11:12.57,Caption,,0,0,0,,ДЕЛАТЬ ЧЕРЕЗ ПОЛГОДА. УДИВИТЕЛЬНАЯ ПРОФЕССИЯ. ТАКОЕ
Dialogue: 0,0:11:12.57,0:11:15.06,Caption,,0,0,0,,ОЩУЩЕНИЕ, ЧТО ЭТИ ЛЮДИ СИДЯТ НЕ РЯДОМ С
Dialogue: 0,0:11:15.06,0:11:17.45,Caption,,0,0,0,,КАБИНЕТОМ ПРЕЗИДЕНТА, А ПРЯМО ПОД СТОЛОМ.
Dialogue: 0,0:11:19.72,0:11:21.72,Caption,,0,0,0,,ПОЭТОМУ К ЭТОЙ ИСТОРИИ ОТНОШЕНИЕ
Dialogue: 0,0:11:21.72,0:11:24.84,Caption,,0,0,0,,ПРОСТОЕ. ЭТО СЛУХ. ПОКА НЕ ПОЯВЯТСЯ ДЕЙСТВИЯ,
Dialogue: 0,0:11:24.92,0:11:27.20,Caption,,0,0,0,,ЭТО ОСТАЁТСЯ СЛУХОМ. ПОТОМУ ЧТО ЕСТЬ
Dialogue: 0,0:11:27.20,0:11:29.00,Caption,,0,0,0,,БОЛЬШАЯ ПРОБЛЕМА С ИСТОЧНИКАМИ,
Dialogue: 0,0:11:29.24,0:11:31.29,Caption,,0,0,0,,КОТОРЫЕ НАЧИНАЮТ ВЫДАВАТЬ СВОИ ХОТЕЛКИ
Dialogue: 0,0:11:31.29,0:11:33.32,Caption,,0,0,0,,ЗА РЕАЛЬНОСТЬ. ОНИ ОЧЕНЬ ХОТЯТ,
Dialogue: 0,0:11:33.47,0:11:35.59,Caption,,0,0,0,,ЧТОБЫ ПРОИЗОШЛО ИМЕННО ТАК. ПОТОМ
Dialogue: 0,0:11:35.59,0:11:39.02,Caption,,0,0,0,,НАХОДЯТ ЧЕЛОВЕКА, КОТОРЫЙ ТОЖЕ ЭТОГО ХОЧЕТ. ЧЕРЕЗ ДВА
Dialogue: 0,0:11:39.02,0:11:41.71,Caption,,0,0,0,,ПЕРЕСКАЗА ЖЕЛАНИЕ ПРЕВРАЩАЕТСЯ В "РЕШЕНИЕ УЖЕ
Dialogue: 0,0:11:41.71,0:11:44.47,Caption,,0,0,0,,ПРИНЯТО". А ДАЛЬШЕ ВСЕ ЖДУТ. И ЗДЕСЬ МЫ СНОВА
Dialogue: 0,0:11:44.47,0:11:47.95,Caption,,0,0,0,,ВОЗВРАЩАЕМСЯ ТУДА, ОТКУДА НАЧАЛИ. ПОТОМУ ЧТО ВОПРОС НЕ
Dialogue: 0,0:11:47.95,0:11:50.95,Caption,,0,0,0,,ТОЛЬКО В МОСТАХ. НЕ ТОЛЬКО В СТАТЬЕ МЕДВЕДЕВА.
Dialogue: 0,0:11:50.95,0:11:53.72,Caption,,0,0,0,,НЕ ТОЛЬКО В ЯДЕРНОЙ ДОКТРИНЕ. И ДАЖЕ НЕ ТОЛЬКО В
Dialogue: 0,0:11:53.72,0:11:57.86,Caption,,0,0,0,,КОСМОСЕ. ВОПРОС В ТОМ, НАСКОЛЬКО ПРОТИВНИК ВЕРИТ ВАШИМ
Dialogue: 0,0:11:57.86,0:12:01.35,Caption,,0,0,0,,УГРОЗАМ. МОЖНО ИМЕТЬ САМЫЙ БОЛЬШОЙ ПИСТОЛЕТ В КОМНАТЕ. НО
Dialogue: 0,0:12:01.35,0:12:04.44,Caption,,0,0,0,,ЕСЛИ ВСЕ УВЕРЕНЫ, ЧТО ВЫ ДОСТАНЕТЕ ЕГО ТОЛЬКО ТОГДА,
Dialogue: 0,0:12:04.68,0:12:08.23,Caption,,0,0,0,,КОГДА УЖЕ ЛЕЖИТЕ НА ПОЛУ, ЕГО СДЕРЖИВАЮЩАЯ СИЛА СТАНОВИТСЯ
Dialogue: 0,0:12:08.23,0:12:11.16,Caption,,0,0,0,,СОВСЕМ ДРУГОЙ. ВОТ В ЧЁМ НЕПРИЯТНОСТЬ. ЗАПАД,
Dialogue: 0,0:12:11.40,0:12:14.20,Caption,,0,0,0,,СУДЯ ПО ЕГО ДЕЙСТВИЯМ, НЕ ВЕДЁТ СЕБЯ КАК ЧЕЛОВЕК,
Dialogue: 0,0:12:14.44,0:12:16.17,Caption,,0,0,0,,КОТОРЫЙ БОИТСЯ РОССИЙСКОГО ЯДЕРНОГО
Dialogue: 0,0:12:16.17,0:12:19.54,Caption,,0,0,0,,ОТВЕТА ПРЯМО СЕЙЧАС. ОН ПРОДОЛЖАЕТ ПОВЫШАТЬ СТАВКИ.
Dialogue: 0,0:12:19.54,0:12:22.50,Caption,,0,0,0,,РАСШИРЯЕТ ВОЕННУЮ ИНФРАСТРУКТУРУ. ОСВАИВАЕТ
Dialogue: 0,0:12:22.50,0:12:25.94,Caption,,0,0,0,,КОСМОС. ОБСУЖДАЕТ НОВЫЕ СИСТЕМЫ. ПРОВЕРЯЕТ СЛЕДУЮЩИЕ
Dialogue: 0,0:12:25.94,0:12:28.90,Caption,,0,0,0,,ГРАНИЦЫ. ПОТОМУ ЧТО ИСХОДИТ ИЗ ОДНОГО РАСЧЁТА. ДО
Dialogue: 0,0:12:28.90,0:12:31.96,Caption,,0,0,0,,САМОГО ПОСЛЕДНЕГО МОМЕНТА МОСКВА БУДЕТ ИСКАТЬ ДРУГОЙ
Dialogue: 0,0:12:31.96,0:12:34.84,Caption,,0,0,0,,ВАРИАНТ. ЕЩЁ ОДИН ОТВЕТ. ЕЩЁ ОДИН СИГНАЛ.
Dialogue: 0,0:12:37.12,0:12:39.73,Caption,,0,0,0,,ЕЩЁ ОДНУ КРАСНУЮ ЛИНИЮ. ЕЩЁ ОДНО
Dialogue: 0,0:12:39.73,0:12:42.96,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЕ. А ЯДЕРНЫЙ АРГУМЕНТ ОСТАНЕТСЯ ТАМ,
Dialogue: 0,0:12:43.20,0:12:46.40,Caption,,0,0,0,,В САМОМ КОНЦЕ, ГДЕ ДО НЕГО ЕЩЁ НАДО ОЧЕНЬ ДОЛГО И
Dialogue: 0,0:12:46.48,0:12:49.99,Caption,,0,0,0,,ОЧЕНЬ СТРАШНО ИДТИ. И ЕСЛИ ЭТОТ РАСЧЁТ ДЕЙСТВИТЕЛЬНО СТАЛ
Dialogue: 0,0:12:49.99,0:12:53.26,Caption,,0,0,0,,ОСНОВОЙ ЗАПАДНОЙ СТРАТЕГИИ, ТО ПРОБЛЕМА ДЛЯ РОССИИ УЖЕ НЕ В
Dialogue: 0,0:12:53.26,0:12:55.99,Caption,,0,0,0,,ОТСУТСТВИИ СТРАШНОГО ОРУЖИЯ. СТРАШНОГО ОРУЖИЯ У
Dialogue: 0,0:12:55.99,0:12:59.12,Caption,,0,0,0,,НЕЁ ДОСТАТОЧНО. ПРОБЛЕМА В ДРУГОМ. ОРУЖИЕ,
Dialogue: 0,0:12:59.36,0:13:01.25,Caption,,0,0,0,,КОТОРОЕ ПРОТИВНИК ЗАРАНЕЕ ВЫНЕС ЗА
Dialogue: 0,0:13:01.25,0:13:04.52,Caption,,0,0,0,,СКОБКИ СВОИХ РЕШЕНИЙ, ПЕРЕСТАЁТ РАБОТАТЬ КАК ПОЛНОЦЕННЫЙ
Dialogue: 0,0:13:04.52,0:13:06.80,Caption,,0,0,0,,ИНСТРУМЕНТ СДЕРЖИВАНИЯ ЗАДОЛГО ДО ТОГО,
Dialogue: 0,0:13:07.02,0:13:09.06,Caption,,0,0,0,,КАК НАСТУПАЕТ МОМЕНТ ЕГО РЕАЛЬНОГО
Dialogue: 0,0:13:09.06,0:13:12.27,Caption,,0,0,0,,ПРИМЕНЕНИЯ. И ВОТ ЭТО НАМНОГО ОПАСНЕЕ ЛЮБОЙ ОЧЕРЕДНОЙ
Dialogue: 0,0:13:12.27,0:13:13.20,Caption,,0,0,0,,ГРОЗНОЙ СТАТЬИ.
