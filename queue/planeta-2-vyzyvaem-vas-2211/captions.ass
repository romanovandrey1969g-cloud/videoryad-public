Dialogue: 0,0:00:00.12,0:00:02.28,Caption,,0,0,0,,МОСКВА ОТПРАВИЛА ЕВРОПЕЙЦАМ ПРИГЛАШЕНИЕ,
Dialogue: 0,0:00:02.52,0:00:05.32,Caption,,0,0,0,,А ПЕРВЫМ У ДВЕРИ ПОЧЕМУ ТО ПОЯВИЛСЯ ЗЕЛЕНСКИЙ.
Dialogue: 0,0:00:05.55,0:00:08.12,Caption,,0,0,0,,НЕ С ЧЕМОДАНОМ, НЕ С ПРОГРАММОЙ ПЕРЕГОВОРОВ,
Dialogue: 0,0:00:08.35,0:00:12.36,Caption,,0,0,0,,А С ЗАПРЕТОМ ДЛЯ ТЕХ, КОГО ЗВАЛИ ВМЕСТО НЕГО. ФРАНЦИЯ,
Dialogue: 0,0:00:12.51,0:00:14.92,Caption,,0,0,0,,ГЕРМАНИЯ И ВЕЛИКОБРИТАНИЯ ЕЩЁ НЕ УСПЕЛИ РЕШИТЬ,
Dialogue: 0,0:00:15.15,0:00:20.04,Caption,,0,0,0,,ПОЕДУТ ЛИ ИХ ПРЕДСТАВИТЕЛИ, ЗАТО КИЕВ УЖЕ РЕШИЛ ЗА ВСЕХ. ПОЛУЧИЛАСЬ ЗАНЯТНАЯ
Dialogue: 0,0:00:20.04,0:00:23.72,Caption,,0,0,0,,КАРТИНА ХОЗЯИН ОТКРЫЛ ДВЕРЬ, ГОСТИ ТОЛЬКО ИЩУТ ПАЛЬТО,
Dialogue: 0,0:00:23.96,0:00:26.44,Caption,,0,0,0,,А СОСЕД ИЗ ДРУГОГО ПОДЪЕЗДА КРИЧИТ С БАЛКОНА,
Dialogue: 0,0:00:26.68,0:00:29.56,Caption,,0,0,0,,ЧТО ВИЗИТ ОТМЕНЯЕТСЯ. ЕСЛИ ВАМ НРАВИТСЯ РАЗБИРАТЬ
Dialogue: 0,0:00:29.56,0:00:31.88,Caption,,0,0,0,,ТАКИЕ СЮЖЕТЫ БЕЗ СКУЧНОЙ ПРОТОКОЛЬНОЙ ЖВАЧКИ,
Dialogue: 0,0:00:32.04,0:00:36.76,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ВЛАДИМИР ПУТИН ПРЕДЛОЖИЛ ПРЕДСТАВИТЕЛЯМ ЕВРОПЕЙСКИХ
Dialogue: 0,0:00:36.76,0:00:39.56,Caption,,0,0,0,,ГОСУДАРСТВ ПРИЕХАТЬ В МОСКВУ. САМО ПРЕДЛОЖЕНИЕ
Dialogue: 0,0:00:39.56,0:00:42.36,Caption,,0,0,0,,ПРЕДЕЛЬНО ПОНЯТНОЕ. ЕСТЬ СЕРЬЁЗНЫЕ РАЗНОГЛАСИЯ,
Dialogue: 0,0:00:42.52,0:00:44.92,Caption,,0,0,0,,ЕСТЬ ОПАСНЫЕ ВОПРОСЫ, ЕСТЬ СТОЛИЦА,
Dialogue: 0,0:00:45.08,0:00:48.12,Caption,,0,0,0,,ГОТОВАЯ ПРИНЯТЬ ПЕРЕГОВОРЩИКОВ. ОСТАЁТСЯ ОПРЕДЕЛИТЬ
Dialogue: 0,0:00:48.12,0:00:51.96,Caption,,0,0,0,,СОСТАВ ДЕЛЕГАЦИИ И СОДЕРЖАНИЕ РАЗГОВОРА. НО ЕЩЁ ДО
Dialogue: 0,0:00:51.96,0:00:54.84,Caption,,0,0,0,,ЛЮБЫХ РЕШЕНИЙ ВЛАДИМИР ЗЕЛЕНСКИЙ СООБЩИЛ ЕВРОПЕЙЦАМ,
Dialogue: 0,0:00:55.00,0:00:57.96,Caption,,0,0,0,,ЧТО ПРИНИМАТЬ ПРИГЛАШЕНИЕ НЕЛЬЗЯ. СЛОВО НЕ МОГУТ
Dialogue: 0,0:00:57.96,0:01:00.76,Caption,,0,0,0,,ЗДЕСЬ ОСОБЕННО ПРЕКРАСНО. В МОСКВУ ПОЗВАЛИ НЕ
Dialogue: 0,0:01:00.76,0:01:03.64,Caption,,0,0,0,,УКРАИНСКИХ ЧИНОВНИКОВ. САМОЛЁТ ГОТОВЯТ НЕ ДЛЯ
Dialogue: 0,0:01:03.64,0:01:06.44,Caption,,0,0,0,,ЗЕЛЕНСКОГО. РЕШЕНИЕ ПРЕДСТОИТ ПРИНИМАТЬ ПАРИЖУ,
Dialogue: 0,0:01:06.60,0:01:10.20,Caption,,0,0,0,,БЕРЛИНУ И ЛОНДОНУ. ЭТО САМОСТОЯТЕЛЬНЫЕ ГОСУДАРСТВА,
Dialogue: 0,0:01:10.36,0:01:15.08,Caption,,0,0,0,,У КАЖДОГО СВОЁ ПРАВИТЕЛЬСТВО, СВОИ ИНТЕРЕСЫ И СОБСТВЕННАЯ ВНЕШНЯЯ ПОЛИТИКА.
Dialogue: 0,0:01:17.36,0:01:21.20,Caption,,0,0,0,,ПО КРАЙНЕЙ МЕРЕ, ТАК БЫЛО ПРИНЯТО СЧИТАТЬ ДО ПОЯВЛЕНИЯ КИЕВСКОЙ
Dialogue: 0,0:01:21.20,0:01:23.84,Caption,,0,0,0,,ДИСПЕТЧЕРСКОЙ СЛУЖБЫ. ЕВРОПА ДОЛЖНА НАХОДИТЬ
Dialogue: 0,0:01:23.84,0:01:26.40,Caption,,0,0,0,,СРЕДСТВА ДЛЯ УКРАИНЫ, ПЕРЕДАВАТЬ ОРУЖИЕ,
Dialogue: 0,0:01:26.59,0:01:29.92,Caption,,0,0,0,,ПРИНИМАТЬ САНКЦИИ И НЕСТИ СВЯЗАННЫЕ С ЭТИМ РАСХОДЫ.
Dialogue: 0,0:01:30.44,0:01:33.68,Caption,,0,0,0,,ТЕПЕРЬ ВЫЯСНЯЕТСЯ, ЧТО КИЕВ ХОТЕЛ БЫ ВЫДАВАТЬ ЕЙ ЕЩЁ И
Dialogue: 0,0:01:33.68,0:01:36.56,Caption,,0,0,0,,РАЗРЕШЕНИЯ НА РАЗГОВОР. ПОМОЩЬ ПРИНИМАЕТСЯ БЕЗ
Dialogue: 0,0:01:36.56,0:01:40.32,Caption,,0,0,0,,ОГРАНИЧЕНИЙ, САМОСТОЯТЕЛЬНОСТЬ СОЮЗНИКОВ ОТПУСКАЕТСЯ ПО ТАЛОНАМ.
Dialogue: 0,0:01:40.49,0:01:42.80,Caption,,0,0,0,,МОЖНО ПОДДЕРЖИВАТЬ ВИЗИТ ИЛИ СЧИТАТЬ ЕГО
Dialogue: 0,0:01:42.80,0:01:45.76,Caption,,0,0,0,,БЕСПОЛЕЗНЫМ. СУТЬ НЕ В ЭТОМ. ПРЕЗИДЕНТ УКРАИНЫ
Dialogue: 0,0:01:45.76,0:01:49.68,Caption,,0,0,0,,ПЫТАЕТСЯ ОПРЕДЕЛИТЬ, ВПРАВЕ ЛИ РУКОВОДИТЕЛИ ДРУГИХ СТРАН ОБЩАТЬСЯ С
Dialogue: 0,0:01:49.68,0:01:52.72,Caption,,0,0,0,,РОССИЕЙ. ТАК СКОРО ПРИДЁТСЯ СОГЛАСОВЫВАТЬ С КИЕВОМ
Dialogue: 0,0:01:52.80,0:01:55.92,Caption,,0,0,0,,НЕ ТОЛЬКО ПЕРЕГОВОРЫ, НО И СПИСОК НОМЕРОВ В ТЕЛЕФОННОЙ КНИГЕ.
Dialogue: 0,0:01:56.64,0:01:59.12,Caption,,0,0,0,,ОСОБЫЙ БЛЕСК ЭТОЙ ИСТОРИИ ПРИДАЛО ОБЪЯСНЕНИЕ
Dialogue: 0,0:01:59.12,0:02:02.08,Caption,,0,0,0,,ЗЕЛЕНСКОГО. РОССИЙСКОЕ ПРИГЛАШЕНИЕ ОН ПРЕДСТАВИЛ КАК
Dialogue: 0,0:02:02.16,0:02:05.04,Caption,,0,0,0,,ПРИЗНАК НЕЖЕЛАНИЯ ВЕСТИ ПЕРЕГОВОРЫ. ЛОГИКА
Dialogue: 0,0:02:05.04,0:02:08.64,Caption,,0,0,0,,ПОЛУЧИЛАСЬ УДОБНАЯ, ПОЧТИ НЕУЯЗВИМАЯ. МОСКВА МОЛЧИТ,
Dialogue: 0,0:02:08.86,0:02:12.32,Caption,,0,0,0,,ЗНАЧИТ, ДИАЛОГ ЕЙ НЕ НУЖЕН. МОСКВА ЗОВЁТ РАЗГОВАРИВАТЬ,
Dialogue: 0,0:02:12.48,0:02:14.48,Caption,,0,0,0,,ЗНАЧИТ, ДИАЛОГ ЕЙ ТОЖЕ НЕ НУЖЕН.
Dialogue: 0,0:02:15.04,0:02:18.64,Caption,,0,0,0,,ВИДИМО, НАСТОЯЩЕЕ СТРЕМЛЕНИЕ К ПЕРЕГОВОРАМ ОПРЕДЕЛЯЕТСЯ
Dialogue: 0,0:02:18.64,0:02:23.04,Caption,,0,0,0,,КАКИМ ТО ТРЕТЬИМ СПОСОБОМ, ИЗВЕСТНЫМ ТОЛЬКО В КИЕВЕ. ОДНАКО ЗА ПУБЛИЧНОЙ
Dialogue: 0,0:02:23.04,0:02:26.16,Caption,,0,0,0,,ПЕРЕПАЛКОЙ УЖЕ ВИДНЫ ВПОЛНЕ РЕАЛЬНЫЕ ДЕЙСТВИЯ.
Dialogue: 0,0:02:28.44,0:02:31.08,Caption,,0,0,0,,ПО СВЕДЕНИЯМ BLOOMBERG, ПРЕДСТАВИТЕЛИ ФРАНЦИИ,
Dialogue: 0,0:02:31.23,0:02:34.28,Caption,,0,0,0,,ГЕРМАНИИ И ВЕЛИКОБРИТАНИИ ОБСУЖДАЛИ ВОЗМОЖНОСТЬ
Dialogue: 0,0:02:34.36,0:02:35.80,Caption,,0,0,0,,ВСТРЕЧИ С РОССИЙСКОЙ СТОРОНОЙ.
Dialogue: 0,0:02:36.36,0:02:38.92,Caption,,0,0,0,,СОВЕТНИК ПО НАЦИОНАЛЬНОЙ БЕЗОПАСНОСТИ ОДНОЙ ИЗ
Dialogue: 0,0:02:38.92,0:02:42.04,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СТРАН СВЯЗЫВАЛСЯ С ПОМОЩНИКОМ ПРЕЗИДЕНТА
Dialogue: 0,0:02:42.04,0:02:44.36,Caption,,0,0,0,,РОССИИ ПО ВНЕШНЕПОЛИТИЧЕСКИМ ВОПРОСАМ.
Dialogue: 0,0:02:44.99,0:02:47.72,Caption,,0,0,0,,ЭТО МЕНЯЕТ ВЕС ВСЕЙ ИСТОРИИ. ПОКА НЕТ НИ
Dialogue: 0,0:02:47.72,0:02:51.40,Caption,,0,0,0,,УТВЕРЖДЁННОЙ ДАТЫ, НИ СОГЛАСОВАННОГО СОСТАВА УЧАСТНИКОВ,
Dialogue: 0,0:02:51.72,0:02:55.00,Caption,,0,0,0,,НИ ГОТОВОЙ ПОВЕСТКИ. НО КОНТАКТ МЕЖДУ СТОРОНАМИ УЖЕ
Dialogue: 0,0:02:55.00,0:02:57.40,Caption,,0,0,0,,ОПИСЫВАЕТСЯ ВПОЛНЕ КОНКРЕТНО. ПЕРЕД НАМИ НЕ
Dialogue: 0,0:02:57.40,0:03:01.96,Caption,,0,0,0,,СЛУЧАЙНЫЙ СЛУХ, ВОЗНИКШИЙ ОТ СКУКИ В РЕДАКЦИОННОМ КАБИНЕТЕ. МЕХАНИЗМ
Dialogue: 0,0:03:01.96,0:03:04.76,Caption,,0,0,0,,ВОЗМОЖНОЙ ВСТРЕЧИ УЖЕ НАЧАЛИ ОСТОРОЖНО ПРОВЕРЯТЬ.
Dialogue: 0,0:03:05.04,0:03:08.12,Caption,,0,0,0,,МИНИСТР ОБОРОНЫ ГЕРМАНИИ БОРИС ПИСТОРИУС ПОШЁЛ ЕЩЁ
Dialogue: 0,0:03:08.12,0:03:12.04,Caption,,0,0,0,,ДАЛЬШЕ. ОН ЗАЯВИЛ, ЧТО ОТКАЗ ОТ МОСКОВСКОГО ПРИГЛАШЕНИЯ СТАЛ БЫ
Dialogue: 0,0:03:12.04,0:03:15.16,Caption,,0,0,0,,СОВЕРШЕННО НЕПРАВИЛЬНЫМ СИГНАЛОМ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:03:15.31,0:03:17.32,Caption,,0,0,0,,РЕЗУЛЬТАТ СПОСОБЕН ПОЛУЧИТЬ ЛИШЬ ТОТ,
Dialogue: 0,0:03:17.61,0:03:22.12,Caption,,0,0,0,,КТО РАЗГОВАРИВАЕТ. ЕВРОПЕЙСКАЯ МЫСЛЬ СОВЕРШИЛА ТРУДНЫЙ ПОХОД И НАКОНЕЦ
Dialogue: 0,0:03:22.12,0:03:26.44,Caption,,0,0,0,,ДОБРАЛАСЬ ДО ОТКРЫТИЯ, ЗНАКОМОГО ЛЮБОМУ ЧЕЛОВЕКУ ПОСЛЕ ПЕРВОГО СЕМЕЙНОГО
Dialogue: 0,0:03:26.44,0:03:29.64,Caption,,0,0,0,,СКАНДАЛА. ЕСЛИ СТОРОНЫ ХОТЯТ ПОНЯТЬ ДРУГ ДРУГА,
Dialogue: 0,0:03:29.96,0:03:32.44,Caption,,0,0,0,,ИМ ПРИХОДИТСЯ ОТКРЫТЬ РОТ НЕ ТОЛЬКО ДЛЯ ВЗАИМНЫХ
Dialogue: 0,0:03:32.52,0:03:35.24,Caption,,0,0,0,,ОБВИНЕНИЙ. НА ФОНЕ ПОСЛЕДНИХ ЛЕТ ЭТО УЖЕ ПОЧТИ
Dialogue: 0,0:03:35.24,0:03:38.04,Caption,,0,0,0,,ИНТЕЛЛЕКТУАЛЬНЫЙ ПРОРЫВ. ГОВОРИТ ЭТО НЕ ОТСТАВНОЙ
Dialogue: 0,0:03:38.04,0:03:41.08,Caption,,0,0,0,,ПОЛИТИК, КОТОРОМУ ТЕПЕРЬ МОЖНО СОВЕТОВАТЬ ЧТО УГОДНО.
Dialogue: 0,0:03:43.36,0:03:46.24,Caption,,0,0,0,,ПИСТОРИУС ЗАНИМАЕТ ПОСТ МИНИСТРА ОБОРОНЫ ГЕРМАНИИ.
Dialogue: 0,0:03:46.56,0:03:50.00,Caption,,0,0,0,,ОН ЗНАЕТ, В КАКОМ СОСТОЯНИИ НАХОДЯТСЯ ОТНОШЕНИЯ РОССИИ И
Dialogue: 0,0:03:50.00,0:03:54.64,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СТРАН, КАКИЕ ВООРУЖЕНИЯ ОТПРАВЛЯЮТСЯ УКРАИНЕ И ЧЕМ МОЖЕТ
Dialogue: 0,0:03:54.64,0:03:57.84,Caption,,0,0,0,,ЗАКОНЧИТЬСЯ ДАЛЬНЕЙШЕЕ ПОВЫШЕНИЕ СТАВОК. МОСКВА ПРИ
Dialogue: 0,0:03:57.84,0:04:00.96,Caption,,0,0,0,,ЭТОМ ПОБЕДНУЮ ДОРОЖКУ ПЕРЕД БУДУЩЕЙ ДЕЛЕГАЦИЕЙ НЕ
Dialogue: 0,0:04:00.96,0:04:03.68,Caption,,0,0,0,,РАССТИЛАЕТ. ЗАМЕСТИТЕЛЬ МИНИСТРА ИНОСТРАННЫХ ДЕЛ
Dialogue: 0,0:04:03.76,0:04:08.24,Caption,,0,0,0,,СЕРГЕЙ РЯБКОВ ПОДТВЕРДИЛ, ЧТО ВОЗМОЖНЫЙ ПРИЕЗД ЕВРОПЕЙСКИХ ПЕРЕГОВОРЩИКОВ
Dialogue: 0,0:04:08.24,0:04:11.36,Caption,,0,0,0,,ПРОРАБАТЫВАЕТСЯ. ОДНОВРЕМЕННО ОН УТОЧНИЛ СОГЛАШЕНИЯ
Dialogue: 0,0:04:11.44,0:04:14.48,Caption,,0,0,0,,О НОВОМ РАУНДЕ ПЕРЕГОВОРОВ ПО УКРАИНЕ ПОКА НЕТ.
Dialogue: 0,0:04:14.83,0:04:17.12,Caption,,0,0,0,,ДАЖЕ ЕСЛИ ДЕЛЕГАЦИЯ ПОЯВИТСЯ В МОСКВЕ,
Dialogue: 0,0:04:17.36,0:04:20.80,Caption,,0,0,0,,СРАЗУ ВОЗНИКНЕТ ВОПРОС О ЕЁ ПОЛНОМОЧИЯХ. ЕВРОПЕЙЦЫ
Dialogue: 0,0:04:20.88,0:04:24.48,Caption,,0,0,0,,МОГУТ ПРИЕХАТЬ, ЧТОБЫ УСЛЫШАТЬ РОССИЙСКИЕ ТРЕБОВАНИЯ. МОГУТ
Dialogue: 0,0:04:24.48,0:04:27.20,Caption,,0,0,0,,ОБСУЖДАТЬ КОНТУРЫ БЕЗОПАСНОСТИ. МОГУТ ПОПЫТАТЬСЯ
Dialogue: 0,0:04:27.28,0:04:31.12,Caption,,0,0,0,,ПОЛУЧИТЬ ПРЕДЛОЖЕНИЯ, КОТОРЫЕ ЗАТЕМ ПРИДЁТСЯ ВЕЗТИ НА СОГЛАСОВАНИЕ В
Dialogue: 0,0:04:31.12,0:04:34.08,Caption,,0,0,0,,ВАШИНГТОН И КИЕВ. ВНЕШНЕ ВСЁ ЭТО ВЫГЛЯДИТ КАК
Dialogue: 0,0:04:34.08,0:04:38.32,Caption,,0,0,0,,ОДНА ПОЕЗДКА, НО ВНУТРИ ЛЕЖАТ СОВЕРШЕННО РАЗНЫЕ ЗАДАЧИ. ТУТ В
Dialogue: 0,0:04:38.40,0:04:43.12,Caption,,0,0,0,,СЮЖЕТ ВХОДИТ ДОНАЛЬД ТРАМП. ПРЕЗИДЕНТ ФИНЛЯНДИИ АЛЕКСАНДР СТУББ РАССКАЗАЛ О
Dialogue: 0,0:04:43.12,0:04:45.28,Caption,,0,0,0,,ТЕЛЕФОННОМ РАЗГОВОРЕ АМЕРИКАНСКОГО ЛИДЕРА С
Dialogue: 0,0:04:45.28,0:04:47.04,Caption,,0,0,0,,УЧАСТНИКАМИ КОАЛИЦИИ ЖЕЛАЮЩИХ,
Dialogue: 0,0:04:47.20,0:04:50.16,Caption,,0,0,0,,СОБРАВШИМИСЯ В БЕРЛИНЕ. ТРАМП ПОЗВОНИЛ ИМ С БОРТА
Dialogue: 0,0:04:50.16,0:04:53.12,Caption,,0,0,0,,САМОЛЁТА ПОСЛЕ КОНТАКТОВ С ВЛАДИМИРОМ ПУТИНЫМ И СИ
Dialogue: 0,0:04:53.12,0:04:59.09,Caption,,0,0,0,,ЦЗИНЬПИНОМ В КИТАЕ. ОН ПЕРЕСКАЗАЛ ЕВРОПЕЙЦАМ СОДЕРЖАНИЕ СОСТОЯВШИХСЯ
Dialogue: 0,0:04:59.09,0:05:03.25,Caption,,0,0,0,,РАЗГОВОРОВ, СООБЩИЛ О ГОТОВНОСТИ ПУТИНА К ДИАЛОГУ И ПОСОВЕТОВАЛ
Dialogue: 0,0:05:03.33,0:05:06.45,Caption,,0,0,0,,ЛИДЕРАМ ЕВРОПЫ САМОСТОЯТЕЛЬНО СВЯЗАТЬСЯ С РОССИЙСКИМ
Dialogue: 0,0:05:06.45,0:05:09.97,Caption,,0,0,0,,ПРЕЗИДЕНТОМ. ИНСТРУКЦИЯ ПРОЩЕ НЕКУДА. КОНТАКТ У ВАС
Dialogue: 0,0:05:09.97,0:05:12.29,Caption,,0,0,0,,ЕСТЬ, АДРЕС СТОЛИЦЫ НЕ МЕНЯЛСЯ,
Dialogue: 0,0:05:12.53,0:05:15.41,Caption,,0,0,0,,ПЕРЕВОДЧИКИ ТОЖЕ НИКУДА НЕ ИСЧЕЗЛИ. ЕСЛИ ВОПРОС
Dialogue: 0,0:05:15.41,0:05:17.25,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ТРЕБУЕТ РАЗГОВОРА,
Dialogue: 0,0:05:17.47,0:05:20.45,Caption,,0,0,0,,НАБЕРИТЕ НОМЕР, А НЕ ПРОВОДИТЕ ЕЩЁ ОДИН КРУГЛЫЙ СТОЛ О
Dialogue: 0,0:05:20.53,0:05:24.93,Caption,,0,0,0,,ПОЛЬЗЕ ТЕЛЕФОННОЙ СВЯЗИ. РОЛИ РАСПРЕДЕЛИЛИСЬ ПОЧТИ ТЕАТРАЛЬНО. ТРАМП
Dialogue: 0,0:05:24.93,0:05:27.89,Caption,,0,0,0,,НАПРАВЛЯЕТ ЕВРОПЕЙЦЕВ К ПУТИНУ. ПИСТОРИУС СЧИТАЕТ
Dialogue: 0,0:05:27.89,0:05:31.17,Caption,,0,0,0,,ОТКАЗ ОШИБКОЙ. РОССИЯ ГОТОВА ЗАНИМАТЬСЯ ПОДГОТОВКОЙ
Dialogue: 0,0:05:31.17,0:05:33.89,Caption,,0,0,0,,ВИЗИТА. ЗЕЛЕНСКИЙ СТОИТ СБОКУ И ТРЕБУЕТ,
Dialogue: 0,0:05:34.05,0:05:37.09,Caption,,0,0,0,,ЧТОБЫ НИКТО НИКУДА НЕ ЕХАЛ. ПРИЧЁМ ПОДПИСЫВАТЬ
Dialogue: 0,0:05:37.09,0:05:40.37,Caption,,0,0,0,,КАПИТУЛЯЦИЮ ЕВРОПЫ КРОВЬЮ НА КРЕМЛЁВСКОЙ СТЕНЕ НИКТО
Dialogue: 0,0:05:40.45,0:05:43.17,Caption,,0,0,0,,НЕ ПРЕДЛАГАЕТ. ПОКА СПОР ИДЁТ ЛИШЬ О ВОЗМОЖНОСТИ
Dialogue: 0,0:05:43.25,0:05:48.29,Caption,,0,0,0,,СЕСТЬ И ПОГОВОРИТЬ. СТУББ ДОБАВИЛ ЕЩЁ ОДНУ СУЩЕСТВЕННУЮ ДЕТАЛЬ. ПО ЕГО
Dialogue: 0,0:05:48.29,0:05:51.97,Caption,,0,0,0,,МНЕНИЮ, ОКОНЧАТЕЛЬНОЕ УРЕГУЛИРОВАНИЕ НЕВОЗМОЖНО БЕЗ ЛИЧНОЙ
Dialogue: 0,0:05:52.05,0:05:54.69,Caption,,0,0,0,,ВСТРЕЧИ ПУТИНА И ЗЕЛЕНСКОГО. СЛЕДОВАТЕЛЬНО,
Dialogue: 0,0:05:54.85,0:05:57.97,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ПОЕЗДКА НЕ ЗАМЕНЯЕТ ОТДЕЛЬНЫЙ РОССИЙСКО
Dialogue: 0,0:05:57.97,0:06:00.61,Caption,,0,0,0,,УКРАИНСКИЙ КОНТАКТ. У ЕВРОПЕЙЦЕВ СВОЯ ЧАСТЬ
Dialogue: 0,0:06:00.61,0:06:05.89,Caption,,0,0,0,,РАЗГОВОРА, У КИЕВА СВОЯ. ДЕЛЕГАЦИЯ ИЗ ТРЁХ СТОЛИЦ НЕ ПОЛУЧАЕТ ПРАВО ОФОРМИТЬ
Dialogue: 0,0:06:05.89,0:06:07.65,Caption,,0,0,0,,УКРАИНСКОЕ БУДУЩЕЕ БЕЗ УКРАИНЫ.
Dialogue: 0,0:06:09.94,0:06:13.46,Caption,,0,0,0,,ОНА ЛИШЬ ОТКРЫВАЕТ КАНАЛ, В КОТОРОМ БУДУТ ОБСУЖДАТЬСЯ ВОПРОСЫ,
Dialogue: 0,0:06:13.70,0:06:16.82,Caption,,0,0,0,,ВЫХОДЯЩИЕ ЗА ПРЕДЕЛЫ КИЕВСКИХ ПОЖЕЛАНИЙ. ИМЕННО
Dialogue: 0,0:06:16.82,0:06:19.54,Caption,,0,0,0,,ПОЭТОМУ РАЗДРАЖЕНИЕ ЗЕЛЕНСКОГО ВЫГЛЯДИТ НАСТОЛЬКО
Dialogue: 0,0:06:19.54,0:06:22.66,Caption,,0,0,0,,ПОКАЗАТЕЛЬНО. ПОКА ЕВРОПА ОБСУЖДАЕТ РОССИЮ ВМЕСТЕ С
Dialogue: 0,0:06:22.66,0:06:27.62,Caption,,0,0,0,,УКРАИНСКИМ РУКОВОДСТВОМ, КИЕВ СПОСОБЕН ВЛИЯТЬ НА КАЖДУЮ ОБЩУЮ ФОРМУЛИРОВКУ.
Dialogue: 0,0:06:27.84,0:06:30.26,Caption,,0,0,0,,ЛЮБАЯ ПОЗИЦИЯ ПРОХОДИТ ЧЕРЕЗ ПРИВЫЧНЫЙ КРУГ
Dialogue: 0,0:06:30.26,0:06:33.86,Caption,,0,0,0,,КОНСУЛЬТАЦИЙ, ГДЕ УКРАИНСКИЕ ПРЕДСТАВИТЕЛИ ЗАРАНЕЕ ЗНАЮТ,
Dialogue: 0,0:06:34.02,0:06:37.14,Caption,,0,0,0,,ЧТО БУДЕТ СКАЗАНО. ПРЯМОЙ КАНАЛ МЕЖДУ ЕВРОПЕЙСКИМИ
Dialogue: 0,0:06:37.14,0:06:40.74,Caption,,0,0,0,,СТОЛИЦАМИ И МОСКВОЙ ЛОМАЕТ ЭТУ УДОБНУЮ КОНСТРУКЦИЮ.
Dialogue: 0,0:06:41.20,0:06:44.82,Caption,,0,0,0,,ТАМ МОГУТ ПОЯВИТЬСЯ ТЕМЫ, ПРЕДЛОЖЕНИЯ И ПРЕДУПРЕЖДЕНИЯ,
Dialogue: 0,0:06:44.98,0:06:47.54,Caption,,0,0,0,,КОТОРЫЕ ЗЕЛЕНСКИЙ УВИДИТ УЖЕ ПОСЛЕ РАЗГОВОРА,
Dialogue: 0,0:06:47.69,0:06:50.02,Caption,,0,0,0,,А НЕ ДО НЕГО. НИКТО ЕЩЁ НЕ ДОГОВОРИЛСЯ
Dialogue: 0,0:06:50.02,0:06:52.74,Caption,,0,0,0,,ДЕЙСТВОВАТЬ У НЕГО ЗА СПИНОЙ. НО КИЕВ ТЕРЯЕТ
Dialogue: 0,0:06:52.82,0:06:55.46,Caption,,0,0,0,,ПРАВО ЗАРАНЕЕ ДЕРЖАТЬ РУКУ НА КАЖДОМ ЕВРОПЕЙСКОМ
Dialogue: 0,0:06:55.46,0:06:59.94,Caption,,0,0,0,,ПРЕДЛОЖЕНИИ. ПОХОЖЕ, ДАЖЕ ТАКАЯ ПЕРСПЕКТИВА ЕМУ УЖЕ СИЛЬНО НЕ НРАВИТСЯ.
Dialogue: 0,0:07:00.28,0:07:02.82,Caption,,0,0,0,,СОБСТВЕННАЯ ГОЛОВНАЯ БОЛЬ ЕСТЬ И У ЕВРОПЕЙЦЕВ.
Dialogue: 0,0:07:03.10,0:07:06.18,Caption,,0,0,0,,ОСОБЕННО У ФРАНЦИИ. ИТАЛЬЯНСКАЯ ГАЗЕТА ИЛЬ СОЛЕ
Dialogue: 0,0:07:06.26,0:07:10.42,Caption,,0,0,0,,ДВАДЦАТЬ ЧЕТЫРЕ ОРЕ СООБЩИЛА, ЧТО ПАРИЖ ДОПУСКАЕТ ПРИНЯТИЕ РОССИЙСКОГО
Dialogue: 0,0:07:10.42,0:07:13.86,Caption,,0,0,0,,ПРИГЛАШЕНИЯ. УСЛОВИЕМ НАЗЫВАЕТСЯ ПОЛНОЦЕННОЕ УЧАСТИЕ
Dialogue: 0,0:07:13.86,0:07:16.58,Caption,,0,0,0,,ЕВРОПЕЙЦЕВ В ПЕРЕГОВОРНОМ ПРОЦЕССЕ. ФОРМАТ ТАКОГО
Dialogue: 0,0:07:16.58,0:07:19.62,Caption,,0,0,0,,УЧАСТИЯ И САМО ПРИГЛАШЕНИЕ ЕЩЁ ПРЕДСТОИТ ОФИЦИАЛЬНО
Dialogue: 0,0:07:19.62,0:07:21.38,Caption,,0,0,0,,СОГЛАСОВАТЬ. ТРЕБОВАНИЕ ПОНЯТНО.
Dialogue: 0,0:07:23.65,0:07:25.97,Caption,,0,0,0,,ЛЕТЕТЬ В МОСКВУ РАДИ ЭКСКУРСИИ ПО КОВРАМ И
Dialogue: 0,0:07:25.97,0:07:28.77,Caption,,0,0,0,,ОБЩЕГО СНИМКА ФРАНЦУЗАМ НЕЗАЧЕМ. ОНИ ХОТЯТ НЕ
Dialogue: 0,0:07:28.77,0:07:33.09,Caption,,0,0,0,,ИЗОБРАЖАТЬ ПРИСУТСТВИЕ, А ВЛИЯТЬ НА РЕШЕНИЯ. В ПРОТИВНОМ СЛУЧАЕ ДОРОГОЙ
Dialogue: 0,0:07:33.09,0:07:35.89,Caption,,0,0,0,,ВИЗИТ ПРЕВРАТИТСЯ В ФОТОСЕССИЮ С ОЧЕНЬ НАПРЯЖЁННЫМИ
Dialogue: 0,0:07:35.89,0:07:38.93,Caption,,0,0,0,,ЛИЦАМИ. НО ПАРИЖ ПРИВОЗИТ С СОБОЙ ПРЕДЛОЖЕНИЕ,
Dialogue: 0,0:07:39.17,0:07:42.21,Caption,,0,0,0,,КОТОРОЕ СПОСОБНО ИСПОРТИТЬ НАСТРОЕНИЕ ЕЩЁ ДО ПОДАЧИ
Dialogue: 0,0:07:42.21,0:07:45.25,Caption,,0,0,0,,КОФЕ. ФРАНЦИЯ ВЫСТУПАЕТ ЗА ГАРАНТИИ БЕЗОПАСНОСТИ
Dialogue: 0,0:07:45.25,0:07:48.53,Caption,,0,0,0,,УКРАИНЕ, ПОХОЖИЕ НА ПЯТУЮ СТАТЬЮ СЕВЕРОАТЛАНТИЧЕСКОГО
Dialogue: 0,0:07:48.53,0:07:51.65,Caption,,0,0,0,,АЛЬЯНСА. СОБЕСЕДНИК ИТАЛЬЯНСКОГО ИЗДАНИЯ ПРЯМО
Dialogue: 0,0:07:51.65,0:07:54.69,Caption,,0,0,0,,ОЦЕНИЛ ТАКИЕ ГАРАНТИИ КАК ФАКТИЧЕСКИЙ АНАЛОГ
Dialogue: 0,0:07:54.69,0:07:57.57,Caption,,0,0,0,,ВСТУПЛЕНИЯ УКРАИНЫ В НАТО. РОССИЙСКАЯ ПОЗИЦИЯ
Dialogue: 0,0:07:57.57,0:08:00.53,Caption,,0,0,0,,УСТРОЕНА РОВНО НАОБОРОТ. РЯБКОВ ПОДЧЁРКИВАЕТ,
Dialogue: 0,0:08:00.93,0:08:03.97,Caption,,0,0,0,,ЧТО МОСКВА ОТВЕРГАЕТ И ОФИЦИАЛЬНОЕ ЧЛЕНСТВО УКРАИНЫ
Dialogue: 0,0:08:04.05,0:08:06.29,Caption,,0,0,0,,В АЛЬЯНСЕ, И ЛЮБЫЕ КОНСТРУКЦИИ,
Dialogue: 0,0:08:06.46,0:08:09.89,Caption,,0,0,0,,ПРЕВРАЩАЮЩИЕ ЕЁ В УЧАСТНИКА НАТО БЕЗ СООТВЕТСТВУЮЩЕЙ
Dialogue: 0,0:08:09.89,0:08:13.17,Caption,,0,0,0,,ВЫВЕСКИ. ПОЛУЧАЕТСЯ ВЕЛИКОЛЕПНЫЙ НАБОР ДЛЯ НАЧАЛА
Dialogue: 0,0:08:13.17,0:08:15.73,Caption,,0,0,0,,ПЕРЕГОВОРОВ. ЕВРОПА СОБИРАЕТСЯ УЗНАТЬ,
Dialogue: 0,0:08:15.92,0:08:17.73,Caption,,0,0,0,,МОЖНО ЛИ ДОГОВОРИТЬСЯ С РОССИЕЙ,
Dialogue: 0,0:08:18.05,0:08:20.29,Caption,,0,0,0,,И ОДНОВРЕМЕННО КЛАДЁТ В ПОРТФЕЛЬ УСЛОВИЕ,
Dialogue: 0,0:08:20.53,0:08:23.81,Caption,,0,0,0,,КОТОРОЕ РОССИЯ УЖЕ СЧИТАЕТ НЕПРИЕМЛЕМЫМ. ЭТО КАК
Dialogue: 0,0:08:23.89,0:08:26.61,Caption,,0,0,0,,ПРИЙТИ МИРИТЬСЯ ПОСЛЕ СЕМЕЙНОЙ ССОРЫ И С ПОРОГА
Dialogue: 0,0:08:26.61,0:08:29.33,Caption,,0,0,0,,ПОТРЕБОВАТЬ ПЕРЕПИСАТЬ КВАРТИРУ. ЗАТО НАМЕРЕНИЯ
Dialogue: 0,0:08:29.41,0:08:32.85,Caption,,0,0,0,,ДОБРЫЕ, БУКЕТ КУПИЛИ. СХЕМА ПОВТОРЯЕТСЯ С УДИВИТЕЛЬНЫМ
Dialogue: 0,0:08:32.85,0:08:36.13,Caption,,0,0,0,,УПОРСТВОМ. МОСКВА ОТКАЗЫВАЕТСЯ ОТ НАТОВСКОЙ МОДЕЛИ.
Dialogue: 0,0:08:36.37,0:08:38.93,Caption,,0,0,0,,ЕЙ ПРИНОСЯТ ТУ ЖЕ МОДЕЛЬ ПОД ДРУГИМ НАЗВАНИЕМ.
Dialogue: 0,0:08:41.21,0:08:44.33,Caption,,0,0,0,,МОСКВА СНОВА ОТКАЗЫВАЕТСЯ. ТОГДА МЕНЯЮТ ЦВЕТ ПАПКИ,
Dialogue: 0,0:08:44.49,0:08:46.57,Caption,,0,0,0,,ПЕРЕСТАВЛЯЮТ СТРАНИЦЫ И РАССЧИТЫВАЮТ,
Dialogue: 0,0:08:46.73,0:08:49.53,Caption,,0,0,0,,ЧТО С ТРЕТЬЕЙ ПОПЫТКИ СОДЕРЖАНИЕ НИКТО НЕ УЗНАЕТ.
Dialogue: 0,0:08:50.08,0:08:53.13,Caption,,0,0,0,,НО РОССИЯ СПОРИТ НЕ С НАЗВАНИЕМ ДОКУМЕНТА. ЕЁ
Dialogue: 0,0:08:53.13,0:08:56.73,Caption,,0,0,0,,ИНТЕРЕСУЕТ, КАКИЕ ВОЕННЫЕ ОБЯЗАТЕЛЬСТВА ВОЗЬМУТ ГОСУДАРСТВА
Dialogue: 0,0:08:56.73,0:09:00.65,Caption,,0,0,0,,НАТО, КАКИЕ СИЛЫ МОГУТ ПОЯВИТЬСЯ НА УКРАИНЕ И НАСКОЛЬКО
Dialogue: 0,0:09:00.65,0:09:03.69,Caption,,0,0,0,,ГЛУБОКО КИЕВ ОКАЖЕТСЯ ВСТРОЕН В ИНФРАСТРУКТУРУ
Dialogue: 0,0:09:03.77,0:09:07.85,Caption,,0,0,0,,АЛЬЯНСА. ПАРИЖ, НАПРОТИВ, ДОБИВАЕТСЯ ДЛЯ УКРАИНЫ ЗАЩИТЫ,
Dialogue: 0,0:09:08.01,0:09:10.41,Caption,,0,0,0,,КОТОРАЯ ПО СВОИМ ПОСЛЕДСТВИЯМ ДОЛЖНА ПРИБЛИЗИТЬСЯ К
Dialogue: 0,0:09:10.41,0:09:14.57,Caption,,0,0,0,,НАТОВСКОЙ. ВСЯ ДОЛГАЯ ИСТОРИЯ ОТНОШЕНИЙ РОССИИ С НАТО ЗДЕСЬ
Dialogue: 0,0:09:14.65,0:09:17.29,Caption,,0,0,0,,НЕ ТРЕБУЕТСЯ. НЫНЕШНЕГО ПРОТИВОРЕЧИЯ ВПОЛНЕ
Dialogue: 0,0:09:17.29,0:09:20.25,Caption,,0,0,0,,ДОСТАТОЧНО. ЕВРОПЕЙЦЫ РАССМАТРИВАЮТ ПОЕЗДКУ,
Dialogue: 0,0:09:20.49,0:09:22.89,Caption,,0,0,0,,ОДНАКО ОДНО ИЗ ГЛАВНЫХ ФРАНЦУЗСКИХ ПРЕДЛОЖЕНИЙ
Dialogue: 0,0:09:22.89,0:09:25.61,Caption,,0,0,0,,ЗАРАНЕЕ СТАЛКИВАЕТСЯ С КАТЕГОРИЧЕСКИМ РОССИЙСКИМ
Dialogue: 0,0:09:25.61,0:09:28.57,Caption,,0,0,0,,ОТКАЗОМ. НО ВОЗМОЖНАЯ ПОЕЗДКА МОЖЕТ БЫТЬ СВЯЗАНА НЕ
Dialogue: 0,0:09:28.65,0:09:31.37,Caption,,0,0,0,,ТОЛЬКО С УКРАИНСКИМ УРЕГУЛИРОВАНИЕМ. ЕСТЬ ВЕРСИЯ
Dialogue: 0,0:09:31.45,0:09:33.21,Caption,,0,0,0,,ГОРАЗДО НЕПРИЯТНЕЕ ДЛЯ ПАРИЖА,
Dialogue: 0,0:09:33.32,0:09:36.89,Caption,,0,0,0,,БЕРЛИНА И ЛОНДОНА. ЕВРОПЕЙЦЕВ К МОСКВЕ ПОДТАЛКИВАЕТ
Dialogue: 0,0:09:36.97,0:09:38.57,Caption,,0,0,0,,НЕ ВНЕЗАПНАЯ ЛЮБОВЬ К БЕСЕДАМ,
Dialogue: 0,0:09:38.89,0:09:42.57,Caption,,0,0,0,,А РАСТУЩАЯ ЦЕНА СОБСТВЕННОГО МОЛЧАНИЯ. СОГЛАСНО ЭТОЙ
Dialogue: 0,0:09:42.57,0:09:46.33,Caption,,0,0,0,,ВЕРСИИ, РОССИЙСКИЙ ОТВЕТ НА УКРАИНСКИЕ УДАРЫ РАССМАТРИВАЕТСЯ
Dialogue: 0,0:09:46.41,0:09:49.45,Caption,,0,0,0,,НЕ ТОЛЬКО В ПРЕДЕЛАХ УКРАИНЫ. СРЕДИ ВОЗМОЖНЫХ ЦЕЛЕЙ
Dialogue: 0,0:09:49.45,0:09:52.41,Caption,,0,0,0,,ОБСУЖДАЮТСЯ ВОЕННЫЕ ПРОИЗВОДСТВЕННЫЕ ОБЪЕКТЫ,
Dialogue: 0,0:09:52.57,0:09:54.81,Caption,,0,0,0,,РАСПОЛОЖЕННЫЕ НЕПОСРЕДСТВЕННО В ЕВРОПЕ.
Dialogue: 0,0:09:57.09,0:09:59.58,Caption,,0,0,0,,ТУТ ПЕРЕГОВОРНЫЙ СТОЛ ПЕРЕСТАЁТ БЫТЬ МЕБЕЛЬЮ ДЛЯ
Dialogue: 0,0:09:59.58,0:10:02.38,Caption,,0,0,0,,ПРОТОКОЛЬНЫХ ФОТОГРАФИЙ. ОДНО ДЕЛО ОТПРАВЛЯТЬ
Dialogue: 0,0:10:02.38,0:10:06.46,Caption,,0,0,0,,ВООРУЖЕНИЯ ИЗ СТРАНЫ, НАД КОТОРОЙ ЛЕТАЮТ ТОЛЬКО ПАССАЖИРСКИЕ САМОЛЁТЫ.
Dialogue: 0,0:10:06.78,0:10:10.46,Caption,,0,0,0,,ЧИНОВНИКИ СЧИТАЮТ СНАРЯДЫ, УТВЕРЖДАЮТ ОЧЕРЕДНЫЕ ПАКЕТЫ,
Dialogue: 0,0:10:10.62,0:10:13.74,Caption,,0,0,0,,ОБЕЩАЮТ КИЕВУ НОВЫЕ ПАРТИИ ТЕХНИКИ И ВЕЧЕРОМ
Dialogue: 0,0:10:13.74,0:10:16.70,Caption,,0,0,0,,СПОКОЙНО ВОЗВРАЩАЮТСЯ ДОМОЙ. СОВСЕМ ДРУГОЕ ДЕЛО,
Dialogue: 0,0:10:16.86,0:10:19.74,Caption,,0,0,0,,КОГДА ПОТЕНЦИАЛЬНОЙ ЦЕЛЬЮ СТАНОВИТСЯ ПРЕДПРИЯТИЕ ЗА
Dialogue: 0,0:10:19.74,0:10:22.62,Caption,,0,0,0,,ЧАС ЕЗДЫ ОТ ИХ СОБСТВЕННОГО КАБИНЕТА. ТОГДА
Dialogue: 0,0:10:22.62,0:10:25.26,Caption,,0,0,0,,ПРИХОДИТСЯ ОБСУЖДАТЬ НЕ ТОЛЬКО ОБЪЁМ ПОМОЩИ УКРАИНЕ.
Dialogue: 0,0:10:25.82,0:10:28.22,Caption,,0,0,0,,НА ПЕРВЫЙ ПЛАН ВЫХОДИТ ПЕРСПЕКТИВА КОНФЛИКТА,
Dialogue: 0,0:10:28.46,0:10:31.66,Caption,,0,0,0,,СПОСОБНОГО ПЕРЕСЕЧЬ УКРАИНСКУЮ ГРАНИЦУ И ПРИЙТИ НА
Dialogue: 0,0:10:31.66,0:10:35.82,Caption,,0,0,0,,ТЕРРИТОРИЮ ГОСУДАРСТВ, УЧАСТВУЮЩИХ В ПОСТАВКАХ. У ВОЙНЫ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:10:35.82,0:10:39.66,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ ОБРАТНЫЙ АДРЕС, А ЭТО УЖЕ СОВСЕМ НЕ ТА КВИТАНЦИЯ,
Dialogue: 0,0:10:39.82,0:10:42.30,Caption,,0,0,0,,КОТОРУЮ УДОБНО ОТПРАВИТЬ НАЛОГОПЛАТЕЛЬЩИКУ.
Dialogue: 0,0:10:42.93,0:10:45.42,Caption,,0,0,0,,ДЛЯ ЕВРОПЕЙСКИХ ПРАВИТЕЛЬСТВ ТАКОЙ РИСК НЕЛЬЗЯ
Dialogue: 0,0:10:45.50,0:10:48.70,Caption,,0,0,0,,ОСТАВИТЬ НА УСМОТРЕНИЕ КИЕВА. УДАР ПО СТРАНЕ НАТО
Dialogue: 0,0:10:48.70,0:10:51.50,Caption,,0,0,0,,СПОСОБЕН ЗАПУСТИТЬ ЦЕПЬ ВОЕННЫХ И ПОЛИТИЧЕСКИХ
Dialogue: 0,0:10:51.50,0:10:54.14,Caption,,0,0,0,,РЕШЕНИЙ. КАЖДЫЙ СЛЕДУЮЩИЙ ШАГ БУДЕТ ЗАВИСЕТЬ ОТ
Dialogue: 0,0:10:54.14,0:10:57.74,Caption,,0,0,0,,ПРЕДЫДУЩЕГО, А ОСТАНОВИТЬ МЕХАНИЗМ ПОСЛЕ ЗАПУСКА МОЖЕТ ОКАЗАТЬСЯ
Dialogue: 0,0:10:57.74,0:11:01.82,Caption,,0,0,0,,ГОРАЗДО СЛОЖНЕЕ, ЧЕМ СЕЙЧАС ОБЕЩАЮТ БОДРЫЕ ЛЮДИ У МИКРОФОНОВ. У
Dialogue: 0,0:11:01.82,0:11:04.38,Caption,,0,0,0,,ЭТОЙ ВЕРСИИ ЕСТЬ ЕЩЁ БОЛЕЕ ЛЮБОПЫТНАЯ СТОРОНА.
Dialogue: 0,0:11:06.66,0:11:09.14,Caption,,0,0,0,,ПРОТИВ ПЕРЕНОСА РОССИЙСКОГО ОТВЕТА НА ЕВРОПЕЙСКУЮ
Dialogue: 0,0:11:09.14,0:11:14.58,Caption,,0,0,0,,ТЕРРИТОРИЮ, КАК УТВЕРЖДАЕТСЯ, ВЫСТУПАЛИ НЕ ТОЛЬКО САМИ ЕВРОПЕЙЦЫ. СДЕРЖИВАЮЩЕЕ
Dialogue: 0,0:11:14.58,0:11:17.38,Caption,,0,0,0,,ВЛИЯНИЕ ОКАЗЫВАЛИ СОЕДИНЁННЫЕ ШТАТЫ И КИТАЙ.
Dialogue: 0,0:11:17.85,0:11:21.06,Caption,,0,0,0,,СОЧЕТАНИЕ ПРИМЕЧАТЕЛЬНОЕ. АМЕРИКА СВЯЗАНА С ЕВРОПОЙ
Dialogue: 0,0:11:21.06,0:11:24.18,Caption,,0,0,0,,СОЮЗОМ ПО НАТО И ОСТАЁТСЯ ЕЁ ГЛАВНЫМ ВОЕННЫМ
Dialogue: 0,0:11:24.18,0:11:27.30,Caption,,0,0,0,,ПАРТНЁРОМ. КИТАЙ НЕ ПРИНАДЛЕЖИТ К ЭТОМУ БЛОКУ,
Dialogue: 0,0:11:27.54,0:11:30.50,Caption,,0,0,0,,ПРОВОДИТ ОТДЕЛЬНУЮ ЛИНИЮ И ВЫСТРАИВАЕТ С РОССИЕЙ
Dialogue: 0,0:11:30.50,0:11:33.70,Caption,,0,0,0,,СОВЕРШЕННО ИНЫЕ ОТНОШЕНИЯ. У ВАШИНГТОНА И ПЕКИНА
Dialogue: 0,0:11:33.70,0:11:38.42,Caption,,0,0,0,,РАЗНЫЕ ЦЕЛИ, РАЗНЫЕ ПАРТНЁРЫ И СЛИШКОМ МНОГО ВЗАИМНЫХ ПРЕТЕНЗИЙ.
Dialogue: 0,0:11:38.89,0:11:41.94,Caption,,0,0,0,,ОДНАКО ПРЯМОЕ РАСШИРЕНИЕ КОНФЛИКТА НА ЕВРОПУ НЕ
Dialogue: 0,0:11:41.94,0:11:44.90,Caption,,0,0,0,,УСТРАИВАЛО ОБЕ ДЕРЖАВЫ. ИМ НЕ ТРЕБОВАЛАСЬ НОВАЯ
Dialogue: 0,0:11:44.90,0:11:49.22,Caption,,0,0,0,,СТУПЕНЬ СТОЛКНОВЕНИЯ, НА КОТОРОЙ ЛЮБОЙ ПРОСЧЁТ МОГ ПРЕВРАТИТЬ РЕГИОНАЛЬНУЮ
Dialogue: 0,0:11:49.22,0:11:52.10,Caption,,0,0,0,,ВОЙНУ В КРИЗИС С УЧАСТИЕМ КРУПНЕЙШИХ ЦЕНТРОВ СИЛЫ.
Dialogue: 0,0:11:52.50,0:11:56.26,Caption,,0,0,0,,ЭТО ОЗНАЧАЕТ, ЧТО РОССИЙСКИЕ РЕШЕНИЯ ЗАВИСЕЛИ НЕ ТОЛЬКО ОТ ВОЕННЫХ
Dialogue: 0,0:11:56.26,0:11:59.54,Caption,,0,0,0,,ВОЗМОЖНОСТЕЙ И ОЦЕНКИ ЕВРОПЕЙСКОГО УЧАСТИЯ. МОСКВЕ
Dialogue: 0,0:11:59.54,0:12:02.26,Caption,,0,0,0,,ПРИХОДИЛОСЬ УЧИТЫВАТЬ ПОЗИЦИЮ ВАШИНГТОНА И ПЕКИНА,
Dialogue: 0,0:12:02.42,0:12:05.14,Caption,,0,0,0,,С КОТОРЫМИ ОНА ВЕДЁТ СОБСТВЕННЫЕ СЛОЖНЫЕ ПЕРЕГОВОРЫ.
Dialogue: 0,0:12:05.56,0:12:07.94,Caption,,0,0,0,,ПОСЛЕ ЭТОГО ОСОБЕННО ИНТЕРЕСНО ВЫГЛЯДИТ ЭПИЗОД
Dialogue: 0,0:12:07.94,0:12:13.14,Caption,,0,0,0,,ВОКРУГ КОНТАКТОВ ПУТИНА, ТРАМПА И СИ ЦЗИНЬПИНА В ШЭНЬЧЖЭНЕ. НЕЗАДОЛГО ДО
Dialogue: 0,0:12:13.14,0:12:15.94,Caption,,0,0,0,,ВСТРЕЧИ ПРОИЗОШЁЛ ОЧЕРЕДНОЙ УДАР ПО КРЫМСКОМУ МОСТУ.
Dialogue: 0,0:12:18.21,0:12:20.37,Caption,,0,0,0,,СОГЛАСНО РАССМАТРИВАЕМОЙ ТРАКТОВКЕ,
Dialogue: 0,0:12:20.53,0:12:23.01,Caption,,0,0,0,,АТАКУ УДАЛОСЬ ПРЕДСТАВИТЬ НЕ ПРОСТО КАК ДЕЙСТВИЕ
Dialogue: 0,0:12:23.01,0:12:25.73,Caption,,0,0,0,,УКРАИНЫ ПРОТИВ РОССИЙСКОГО ОБЪЕКТА. ЕЁ МОГЛИ
Dialogue: 0,0:12:25.81,0:12:28.61,Caption,,0,0,0,,ПОКАЗАТЬ КАК ДЕМОНСТРАТИВНЫЙ ВЫПАД ПРОТИВ САМОГО
Dialogue: 0,0:12:28.61,0:12:32.21,Caption,,0,0,0,,ПЕРЕГОВОРНОГО ПРОЦЕССА И ЛИЧНОЕ ОСКОРБЛЕНИЕ ТРАМПА И
Dialogue: 0,0:12:32.21,0:12:36.05,Caption,,0,0,0,,СИ ЦЗИНЬПИНА. РАЗНИЦА ОГРОМНАЯ. МОЖНО ПРОСИТЬ ДВЕ
Dialogue: 0,0:12:36.13,0:12:38.29,Caption,,0,0,0,,ДЕРЖАВЫ НЕ МЕШАТЬ РОССИЙСКОМУ ОТВЕТУ,
Dialogue: 0,0:12:38.52,0:12:41.65,Caption,,0,0,0,,ПЕРЕЧИСЛЯЯ ВОЕННЫЕ ПРИЧИНЫ. А МОЖНО ПОСТАВИТЬ ВОПРОС
Dialogue: 0,0:12:41.65,0:12:44.21,Caption,,0,0,0,,ИНАЧЕ КТО ТО НАМЕРЕННО БЬЁТ В МОМЕНТ ИХ
Dialogue: 0,0:12:44.21,0:12:48.69,Caption,,0,0,0,,ПЕРЕГОВОРОВ, ПОКАЗЫВАЯ, ЧТО ДОГОВОРЁННОСТИ КРУПНЕЙШИХ ЛИДЕРОВ НИЧЕГО ДЛЯ
Dialogue: 0,0:12:48.77,0:12:51.81,Caption,,0,0,0,,НЕГО НЕ ЗНАЧАТ. ТОГДА ВАШИНГТОН И ПЕКИН ПОЛУЧАЮТ
Dialogue: 0,0:12:51.89,0:12:54.93,Caption,,0,0,0,,УЖЕ НЕ ОТВЛЕЧЁННУЮ ПРОСЬБУ МОСКВЫ. ИМ ПРЕДЛАГАЮТ
Dialogue: 0,0:12:55.01,0:12:59.17,Caption,,0,0,0,,ОЦЕНИТЬ ДЕЙСТВИЯ, КОТОРЫЕ ВЫСТАВЛЯЮТ БЕССМЫСЛЕННЫМИ ИХ СОБСТВЕННЫЕ
Dialogue: 0,0:12:59.25,0:13:02.45,Caption,,0,0,0,,УСИЛИЯ И СНИЖАЮТ ВЕС ИХ ЛИДЕРОВ. ДАЖЕ САМЫЙ
Dialogue: 0,0:13:02.45,0:13:04.21,Caption,,0,0,0,,ТЕРПЕЛИВЫЙ ПОСРЕДНИК ПЛОХО ЛЮБИТ,
Dialogue: 0,0:13:04.46,0:13:06.45,Caption,,0,0,0,,КОГДА ЕГО ИСПОЛЬЗУЮТ ВМЕСТО ДЕКОРАЦИИ.
Dialogue: 0,0:13:07.07,0:13:10.85,Caption,,0,0,0,,ПО ЭТОЙ ВЕРСИИ, ПОСЛЕ АТАКИ НА КРЫМСКИЙ МОСТ ВЕРОЯТНОСТЬ РОССИЙСКОГО
Dialogue: 0,0:13:10.93,0:13:13.49,Caption,,0,0,0,,ОТВЕТА ПО ЕВРОПЕЙСКИМ ВОЕННЫМ ПРОИЗВОДСТВАМ ЗАМЕТНО
Dialogue: 0,0:13:13.49,0:13:17.81,Caption,,0,0,0,,УВЕЛИЧИЛАСЬ. РАНЬШЕ США И КИТАЙ ЖЁСТКО ВОЗРАЖАЛИ ПРОТИВ ВЫХОДА
Dialogue: 0,0:13:17.81,0:13:19.65,Caption,,0,0,0,,КОНФЛИКТА НА ТЕРРИТОРИЮ ЕВРОПЫ.
Dialogue: 0,0:13:20.29,0:13:22.85,Caption,,0,0,0,,ЕСЛИ УДАР ПРЕДСТАВИЛИ КАК ВЫЗОВ ЛИЧНО ТРАМПУ И
Dialogue: 0,0:13:22.93,0:13:26.53,Caption,,0,0,0,,СИ, ПРЕЖНЯЯ ПРЕГРАДА МОГЛА СТАТЬ СЛАБЕЕ. ВОТ ТОГДА У
Dialogue: 0,0:13:26.61,0:13:29.41,Caption,,0,0,0,,ЕВРОПЫ ПОЯВЛЯЕТСЯ ОЧЕНЬ ПРАКТИЧНАЯ ПРИЧИНА ЕХАТЬ В
Dialogue: 0,0:13:29.41,0:13:34.88,Caption,,0,0,0,,МОСКВУ. НЕ СПАСАТЬ ПЕРЕГОВОРНЫЙ ПРОЦЕСС КРАСИВЫМИ РЕЧАМИ,
Dialogue: 0,0:13:35.23,0:13:38.96,Caption,,0,0,0,,А ВЫЯСНЯТЬ, НАСКОЛЬКО БЛИЗКО РОССИЙСКИЙ ОТВЕТ ПОДОШЁЛ К ИХ
Dialogue: 0,0:13:38.96,0:13:43.44,Caption,,0,0,0,,СОБСТВЕННЫМ ЗАВОДАМ. КОГДА ПОД УГРОЗОЙ ОКАЗЫВАЕТСЯ ТЕРРИТОРИЯ СОЮЗНИКА,
Dialogue: 0,0:13:43.76,0:13:46.08,Caption,,0,0,0,,КИЕВ УЖЕ НЕ МОЖЕТ БЫТЬ ЕДИНСТВЕННЫМ ЦЕНТРОМ
Dialogue: 0,0:13:46.16,0:13:51.60,Caption,,0,0,0,,ОБСУЖДЕНИЯ. ФРАНЦУЗСКОЕ, ГЕРМАНСКОЕ И БРИТАНСКОЕ ПРАВИТЕЛЬСТВА ОБЯЗАНЫ ДУМАТЬ
Dialogue: 0,0:13:51.68,0:13:54.72,Caption,,0,0,0,,О БЕЗОПАСНОСТИ СВОИХ СТРАН. И ТУТ СОВЕТЫ ЗЕЛЕНСКОГО
Dialogue: 0,0:13:54.80,0:13:57.44,Caption,,0,0,0,,НЕ ЛЕТЕТЬ НАЧИНАЮТ ЗВУЧАТЬ ПРИМЕРНО КАК ПРОСЬБА НЕ
Dialogue: 0,0:13:57.44,0:14:01.84,Caption,,0,0,0,,ВЫЗЫВАТЬ ПОЖАРНЫХ, ПОКА ГОРИТ ЧУЖОЙ ЭТАЖ. ИМЕННО НА ЭТОМ ФОНЕ
Dialogue: 0,0:14:01.84,0:14:04.80,Caption,,0,0,0,,ИНТЕРЕС КОАЛИЦИИ ЖЕЛАЮЩИХ К МОСКОВСКОМУ ПРИГЛАШЕНИЮ
Dialogue: 0,0:14:05.04,0:14:08.24,Caption,,0,0,0,,ПРИОБРЕТАЕТ ДРУГОЙ СМЫСЛ. ОФИЦИАЛЬНО ЕВРОПЕЙЦЫ ХОТЯТ
Dialogue: 0,0:14:08.32,0:14:11.12,Caption,,0,0,0,,ПОЛУЧИТЬ ПОЛНОЦЕННОЕ МЕСТО В ОБСУЖДЕНИИ УКРАИНСКОГО
Dialogue: 0,0:14:11.12,0:14:14.08,Caption,,0,0,0,,УРЕГУЛИРОВАНИЯ. ТАКАЯ ЦЕЛЬ У НИХ ДЕЙСТВИТЕЛЬНО ЕСТЬ.
Dialogue: 0,0:14:14.26,0:14:16.64,Caption,,0,0,0,,ОНИ ВКЛАДЫВАЮТ В ПОДДЕРЖКУ КИЕВА ДЕНЬГИ,
Dialogue: 0,0:14:16.72,0:14:20.64,Caption,,0,0,0,,ОРУЖИЕ И РЕПУТАЦИЮ, ПОЭТОМУ НЕ СОБИРАЮТСЯ НАБЛЮДАТЬ ЗА ИТОГОВЫМИ
Dialogue: 0,0:14:20.64,0:14:25.20,Caption,,0,0,0,,РЕШЕНИЯМИ ИЗ КОРИДОРА. НО РИСК УДАРА ПО ЕВРОПЕЙСКОЙ ВОЕННОЙ ПРОМЫШЛЕННОСТИ
Dialogue: 0,0:14:25.20,0:14:28.48,Caption,,0,0,0,,СОЗДАЁТ ВТОРУЮ ПРИЧИНУ. ПРЯМОЙ КОНТАКТ НУЖЕН УЖЕ НЕ
Dialogue: 0,0:14:28.48,0:14:31.68,Caption,,0,0,0,,ТОЛЬКО РАДИ БУДУЩЕГО УКРАИНЫ. ЕВРОПА ХОЧЕТ ПОНИМАТЬ,
Dialogue: 0,0:14:32.00,0:14:34.48,Caption,,0,0,0,,ГДЕ РОССИЯ ПРОВОДИТ ЧЕРТУ МЕЖДУ ПОСТАВКОЙ
Dialogue: 0,0:14:34.48,0:14:38.64,Caption,,0,0,0,,ВООРУЖЕНИЙ, УЧАСТИЕМ В БОЕВЫХ ДЕЙСТВИЯХ И ОСНОВАНИЕМ ДЛЯ ОТВЕТА
Dialogue: 0,0:14:38.72,0:14:44.36,Caption,,0,0,0,,ПО ТЕРРИТОРИИ ПОСТАВЩИКА. ТОГДА В МОСКВЕ ПРИДЁТСЯ ГОВОРИТЬ О ГРАНИЦАХ
Dialogue: 0,0:14:44.36,0:14:47.48,Caption,,0,0,0,,ПРОТИВОСТОЯНИЯ МЕЖДУ РОССИЕЙ И САМИМИ ЕВРОПЕЙСКИМИ
Dialogue: 0,0:14:47.48,0:14:49.80,Caption,,0,0,0,,ГОСУДАРСТВАМИ. ЭТО РАЗГОВОР НЕ О ТОМ,
Dialogue: 0,0:14:50.04,0:14:53.16,Caption,,0,0,0,,КАКОЙ ПУНКТ ЗАПИСАТЬ В УКРАИНСКОЕ СОГЛАШЕНИЕ. ЭТО
Dialogue: 0,0:14:53.16,0:14:55.88,Caption,,0,0,0,,ПОПЫТКА НЕ ПРОСНУТЬСЯ ОДНАЖДЫ ВНУТРИ КОНФЛИКТА,
Dialogue: 0,0:14:56.20,0:14:58.44,Caption,,0,0,0,,КОТОРЫЙ ЕЩЁ СОВСЕМ НЕДАВНО СЧИТАЛСЯ ЧУЖИМ.
Dialogue: 0,0:14:59.26,0:15:02.04,Caption,,0,0,0,,ВЫСКАЗЫВАНИЕ ПИСТОРИУСА ПОСЛЕ ЭТОГО ЗВУЧИТ СОВСЕМ НЕ
Dialogue: 0,0:15:02.12,0:15:04.92,Caption,,0,0,0,,КАК ДЕЖУРНЫЙ ПРИЗЫВ К ДИАЛОГУ. МИНИСТР ОБОРОНЫ
Dialogue: 0,0:15:04.92,0:15:08.04,Caption,,0,0,0,,ГЕРМАНИИ НАЗЫВАЕТ ОТКАЗ НЕПРАВИЛЬНЫМ СИГНАЛОМ И
Dialogue: 0,0:15:08.04,0:15:11.00,Caption,,0,0,0,,ГОВОРИТ О НЕОБХОДИМОСТИ РАЗГОВАРИВАТЬ. ЕСЛИ РЕЧЬ
Dialogue: 0,0:15:11.00,0:15:13.64,Caption,,0,0,0,,ИДЁТ ТОЛЬКО ОБ ОБМЕНЕ ПОЗИЦИЯМИ ПО УКРАИНЕ,
Dialogue: 0,0:15:13.88,0:15:16.68,Caption,,0,0,0,,ФРАЗА ДЕЙСТВИТЕЛЬНО ВЫГЛЯДИТ БАНАЛЬНО. МИНИСТРЫ
Dialogue: 0,0:15:16.68,0:15:19.00,Caption,,0,0,0,,ПРОИЗНОСЯТ ПОДОБНОЕ С ТАКОЙ РЕГУЛЯРНОСТЬЮ,
Dialogue: 0,0:15:19.24,0:15:21.72,Caption,,0,0,0,,ЧТО МОЖНО ПЕЧАТАТЬ ЗАРАНЕЕ И МЕНЯТЬ ФАМИЛИЮ.
Dialogue: 0,0:15:22.35,0:15:25.16,Caption,,0,0,0,,НО ПРИ УГРОЗЕ ПРЯМОГО СТОЛКНОВЕНИЯ ЗА ЭТИМИ СЛОВАМИ
Dialogue: 0,0:15:25.16,0:15:28.28,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ КОНКРЕТНЫЙ СТРАХ. ГЕРМАНИЯ ПРОДОЛЖАЕТ
Dialogue: 0,0:15:28.28,0:15:30.12,Caption,,0,0,0,,УЧАСТВОВАТЬ В ВООРУЖЕНИИ УКРАИНЫ,
Dialogue: 0,0:15:30.28,0:15:33.24,Caption,,0,0,0,,ОБСУЖДАЕТ ГАРАНТИИ И ОДНОВРЕМЕННО ДОЛЖНА ОЦЕНИВАТЬ
Dialogue: 0,0:15:33.24,0:15:36.52,Caption,,0,0,0,,ВЕРОЯТНОСТЬ ОТВЕТА УЖЕ ПО ЕВРОПЕЙСКИМ ОБЪЕКТАМ. В
Dialogue: 0,0:15:36.60,0:15:39.40,Caption,,0,0,0,,ТАКОЙ СИТУАЦИИ ОТКАЗ ВЫСЛУШАТЬ МОСКВУ СТАНОВИТСЯ НЕ
Dialogue: 0,0:15:39.40,0:15:44.60,Caption,,0,0,0,,ПРОЯВЛЕНИЕМ ПРИНЦИПИАЛЬНОСТИ, А ДОРОГОЙ ФОРМОЙ САМОУВЕРЕННОСТИ. ПЕРЕД ЕВРОПЕЙЦАМИ
Dialogue: 0,0:15:44.68,0:15:47.88,Caption,,0,0,0,,СТОЯТ ДВЕ ОТДЕЛЬНЫЕ ЗАДАЧИ. ПЕРВАЯ КАСАЕТСЯ УСЛОВИЙ
Dialogue: 0,0:15:47.88,0:15:51.40,Caption,,0,0,0,,ВОЗМОЖНОГО УРЕГУЛИРОВАНИЯ НА УКРАИНЕ. ЗДЕСЬ МОСКВА,
Dialogue: 0,0:15:51.51,0:15:54.28,Caption,,0,0,0,,ПАРИЖ И КИЕВ РАСХОДЯТСЯ ПОЧТИ ВО ВСЁМ.
Dialogue: 0,0:15:56.57,0:15:59.45,Caption,,0,0,0,,СПОР О ГАРАНТИЯХ, ПОХОЖИХ НА ЧЛЕНСТВО В НАТО,
Dialogue: 0,0:15:59.68,0:16:02.81,Caption,,0,0,0,,ЭТО ПОКАЗЫВАЕТ ПРЕДЕЛЬНО ЯСНО. ВТОРАЯ КАСАЕТСЯ
Dialogue: 0,0:16:02.81,0:16:05.85,Caption,,0,0,0,,ПРЕДОТВРАЩЕНИЯ ПРЯМОГО СТОЛКНОВЕНИЯ РОССИИ С
Dialogue: 0,0:16:05.85,0:16:08.97,Caption,,0,0,0,,ЕВРОПЕЙСКИМИ СТРАНАМИ. ЭТОТ РИСК СПОСОБЕН ЗАСТАВИТЬ
Dialogue: 0,0:16:08.97,0:16:14.01,Caption,,0,0,0,,СТОРОНЫ ГОВОРИТЬ ДАЖЕ ТОГДА, КОГДА ПО УКРАИНСКОМУ ВОПРОСУ ОНИ НЕ ГОТОВЫ УСТУПИТЬ
Dialogue: 0,0:16:14.09,0:16:17.21,Caption,,0,0,0,,НИ САНТИМЕТРА. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ И НАПИШИТЕ В
Dialogue: 0,0:16:17.29,0:16:20.97,Caption,,0,0,0,,КОММЕНТАРИЯХ, ПОЕДУТ ЛИ ЕВРОПЕЙЦЫ В МОСКВУ. САМЫЕ СЕРЬЁЗНЫЕ
Dialogue: 0,0:16:20.97,0:16:23.37,Caption,,0,0,0,,ПОВОРОТЫ ЧАСТО НАЧИНАЮТСЯ НЕ С ПОДПИСАННОГО
Dialogue: 0,0:16:23.37,0:16:27.21,Caption,,0,0,0,,ДОГОВОРА, А С ВНЕЗАПНОГО ЖЕЛАНИЯ ВЧЕРАШНИХ СПОРЩИКОВ УТОЧНИТЬ,
Dialogue: 0,0:16:27.45,0:16:30.01,Caption,,0,0,0,,КУДА ИМЕННО МОЖЕТ ПРИЛЕТЕТЬ ИХ СОБСТВЕННЫЙ СЧЁТ.
Dialogue: 0,0:16:30.65,0:16:33.45,Caption,,0,0,0,,ТЕПЕРЬ СНОВА ПОСМОТРИМ НА ЗАПРЕТ ЗЕЛЕНСКОГО. ЕСЛИ
Dialogue: 0,0:16:33.53,0:16:35.93,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ДЕЛЕГАЦИЯ СОБИРАЕТСЯ ОБСУЖДАТЬ ТОЛЬКО
Dialogue: 0,0:16:35.93,0:16:39.69,Caption,,0,0,0,,УКРАИНУ, НЕДОВОЛЬСТВО КИЕВА ХОТЯ БЫ ИМЕЕТ ПОНЯТНУЮ ОСНОВУ.
Dialogue: 0,0:16:40.08,0:16:42.41,Caption,,0,0,0,,ЗЕЛЕНСКИЙ НЕ ХОЧЕТ, ЧТОБЫ РЕШЕНИЯ,
Dialogue: 0,0:16:42.53,0:16:48.01,Caption,,0,0,0,,КАСАЮЩИЕСЯ ЕГО СТРАНЫ, ГОТОВИЛИСЬ БЕЗ ЕГО УЧАСТИЯ. НО БЕЗОПАСНОСТЬ ФРАНЦИИ,
Dialogue: 0,0:16:48.16,0:16:51.45,Caption,,0,0,0,,ГЕРМАНИИ И ВЕЛИКОБРИТАНИИ НЕ ЯВЛЯЕТСЯ УКРАИНСКОЙ
Dialogue: 0,0:16:51.45,0:16:54.97,Caption,,0,0,0,,СОБСТВЕННОСТЬЮ. БЕРЛИНУ НЕ ТРЕБУЕТСЯ РАЗРЕШЕНИЕ КИЕВА,
Dialogue: 0,0:16:55.16,0:16:59.29,Caption,,0,0,0,,ЧТОБЫ ВЫЯСНИТЬ, КАКИЕ ДЕЙСТВИЯ МОСКВА СЧИТАЕТ ПРЯМЫМ УЧАСТИЕМ
Dialogue: 0,0:16:59.37,0:17:02.73,Caption,,0,0,0,,ГЕРМАНИИ В КОНФЛИКТЕ. ПАРИЖ НЕ ОБЯЗАН СПРАШИВАТЬ
Dialogue: 0,0:17:02.81,0:17:06.17,Caption,,0,0,0,,ЗЕЛЕНСКОГО, МОЖНО ЛИ ОБСУЖДАТЬ УГРОЗЫ ФРАНЦУЗСКИМ ОБЪЕКТАМ.
Dialogue: 0,0:17:06.40,0:17:08.57,Caption,,0,0,0,,ЛОНДОН ТОЖЕ СПОСОБЕН САМ ОПРЕДЕЛИТЬ,
Dialogue: 0,0:17:08.87,0:17:11.05,Caption,,0,0,0,,КОГДА РИСК ДЛЯ БРИТАНСКОЙ ТЕРРИТОРИИ ТРЕБУЕТ
Dialogue: 0,0:17:11.13,0:17:16.60,Caption,,0,0,0,,ОТДЕЛЬНОГО КОНТАКТА. РАНО ИЛИ ПОЗДНО ЕВРОПЕЙСКИМ ЛИДЕРАМ ПРИДЁТСЯ
Dialogue: 0,0:17:16.60,0:17:19.32,Caption,,0,0,0,,ОПРЕДЕЛИТЬ ПРЕДЕЛ ЭТОЙ ЗАВИСИМОСТИ. ОНИ МОГУТ
Dialogue: 0,0:17:19.32,0:17:23.88,Caption,,0,0,0,,ПРОДОЛЖАТЬ ПОМОГАТЬ УКРАИНЕ, НЕ ОТДАВАЯ КИЕВУ ПРАВО РАСПОРЯЖАТЬСЯ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:17:23.88,0:17:28.20,Caption,,0,0,0,,ВНЕШНЕЙ ПОЛИТИКОЙ. ЕСЛИ ЗЕЛЕНСКИЙ СЧИТАЕТ ДАЖЕ САМОСТОЯТЕЛЬНЫЙ РАЗГОВОР
Dialogue: 0,0:17:28.20,0:17:31.32,Caption,,0,0,0,,НЕДОПУСТИМЫМ, КОНФЛИКТ ИНТЕРЕСОВ УЖЕ ВЫШЕЛ НАРУЖУ.
Dialogue: 0,0:17:31.88,0:17:34.12,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ СОБЫТИЙ ГОВОРИТ САМА ЗА СЕБЯ.
Dialogue: 0,0:17:34.43,0:17:36.84,Caption,,0,0,0,,ТРАМП СОВЕТУЕТ ЕВРОПЕЙЦАМ ОБРАТИТЬСЯ К ПУТИНУ.
Dialogue: 0,0:17:37.14,0:17:39.96,Caption,,0,0,0,,ВОЗМОЖНОСТЬ КОНТАКТА НАЧИНАЮТ ОБСУЖДАТЬ. ОДИН ИЗ
Dialogue: 0,0:17:39.96,0:17:42.20,Caption,,0,0,0,,СОВЕТНИКОВ СВЯЗЫВАЕТСЯ С ПОМОЩНИКОМ РОССИЙСКОГО
Dialogue: 0,0:17:42.20,0:17:44.84,Caption,,0,0,0,,ПРЕЗИДЕНТА. ПИСТОРИУС ПУБЛИЧНО ПОДДЕРЖИВАЕТ
Dialogue: 0,0:17:44.84,0:17:48.20,Caption,,0,0,0,,ПЕРЕГОВОРЫ. МОСКВА ОБЕЩАЕТ БЫСТРО ОРГАНИЗОВАТЬ ВИЗИТ
Dialogue: 0,0:17:48.28,0:17:51.40,Caption,,0,0,0,,ПОСЛЕ СОГЛАСИЯ ЕВРОПЕЙСКОЙ СТОРОНЫ. И ТОЛЬКО ЗАТЕМ
Dialogue: 0,0:17:51.48,0:17:53.88,Caption,,0,0,0,,КИЕВ ПЫТАЕТСЯ ОПУСТИТЬ ШЛАГБАУМ ПЕРЕД ЧУЖОЙ
Dialogue: 0,0:17:53.88,0:17:57.00,Caption,,0,0,0,,ДЕЛЕГАЦИЕЙ. ПОЗИЦИЯ ЗЕЛЕНСКОГО ОСТАЁТСЯ ЕГО
Dialogue: 0,0:17:57.00,0:17:59.88,Caption,,0,0,0,,ПОЗИЦИЕЙ. ОНА НЕ ЗАКРЫВАЕТ РОССИЙСКО ЕВРОПЕЙСКИЙ
Dialogue: 0,0:17:59.88,0:18:03.40,Caption,,0,0,0,,КАНАЛ И НЕ ОТМЕНЯЕТ ИНТЕРЕСОВ ТРЁХ ГОСУДАРСТВ. САМ
Dialogue: 0,0:18:03.40,0:18:06.52,Caption,,0,0,0,,ФАКТ ПЕРЕГОВОРОВ НИКОГО НИ К ЧЕМУ НЕ ПРИВЯЗЫВАЕТ.
Dialogue: 0,0:18:06.92,0:18:09.88,Caption,,0,0,0,,ЕВРОПЕЙЦЫ МОГУТ ВЫСЛУШАТЬ МОСКВУ И ОТВЕРГНУТЬ ЕЁ
Dialogue: 0,0:18:09.88,0:18:12.92,Caption,,0,0,0,,ТРЕБОВАНИЯ. МОГУТ ПРИЕХАТЬ СО СВОИМИ УСЛОВИЯМИ И
Dialogue: 0,0:18:13.00,0:18:15.48,Caption,,0,0,0,,УЕХАТЬ БЕЗ РЕЗУЛЬТАТА. МОГУТ ОБНАРУЖИТЬ,
Dialogue: 0,0:18:15.64,0:18:20.92,Caption,,0,0,0,,ЧТО РАСХОЖДЕНИЯ ЕЩЁ ГЛУБЖЕ, ЧЕМ КАЗАЛОСЬ. НО ДАЖЕ ПРОВАЛИВШИЙСЯ РАЗГОВОР ДАЁТ
Dialogue: 0,0:18:21.00,0:18:24.76,Caption,,0,0,0,,ПОНИМАНИЕ ГРАНИЦ, ЗА КОТОРЫМИ НАЧИНАЕТСЯ ОПАСНАЯ ЭСКАЛАЦИЯ.
Dialogue: 0,0:18:27.03,0:18:29.19,Caption,,0,0,0,,ГОРАЗДО ТРУДНЕЕ БУДЕТ ОБЪЯСНИТЬ СОБСТВЕННЫМ
Dialogue: 0,0:18:29.19,0:18:31.67,Caption,,0,0,0,,ГРАЖДАНАМ СОЗНАТЕЛЬНЫЙ ОТКАЗ ОТ КОНТАКТА,
Dialogue: 0,0:18:31.94,0:18:34.87,Caption,,0,0,0,,ЕСЛИ УГРОЗА ПРИБЛИЗИТСЯ К ИХ СТРАНЕ. ПРЕДСТАВЬТЕ
Dialogue: 0,0:18:34.87,0:18:39.03,Caption,,0,0,0,,ГЕРМАНСКОГО МИНИСТРА, КОТОРЫЙ СООБЩАЕТ ПАРЛАМЕНТУ МЫ МОГЛИ УТОЧНИТЬ
Dialogue: 0,0:18:39.03,0:18:41.03,Caption,,0,0,0,,НАМЕРЕНИЯ РОССИИ, НО НЕ СТАЛИ,
Dialogue: 0,0:18:41.27,0:18:43.83,Caption,,0,0,0,,ПОТОМУ ЧТО ПРЕЗИДЕНТ УКРАИНЫ НЕ ОДОБРИЛ ПОЕЗДКУ.
Dialogue: 0,0:18:44.40,0:18:47.03,Caption,,0,0,0,,АПЛОДИСМЕНТЫ В ТАКОМ ЗАЛЕ БУДУТ ОЧЕНЬ КОРОТКИМИ.
Dialogue: 0,0:18:47.26,0:18:50.79,Caption,,0,0,0,,КОНЕЧНО, ПРИГЛАШЕНИЕ САМО ПО СЕБЕ НЕ ОЗНАЧАЕТ СКОРОЙ СДЕЛКИ.
Dialogue: 0,0:18:51.08,0:18:54.87,Caption,,0,0,0,,РЯБКОВ ГОВОРИТ, ЧТО ОКОНЧАТЕЛЬНОЙ ДОГОВОРЁННОСТИ О НОВОМ РАУНДЕ НЕТ.
Dialogue: 0,0:18:55.25,0:18:57.83,Caption,,0,0,0,,ФРАНЦИЯ ТРЕБУЕТ ПОЛНОЦЕННОЙ РОЛИ. МОСКВА НЕ
Dialogue: 0,0:18:57.83,0:19:01.11,Caption,,0,0,0,,ОТКАЗЫВАЕТСЯ ОТ СВОЕЙ ПОЗИЦИИ ПО НАТО. СТУББ СЧИТАЕТ
Dialogue: 0,0:19:01.11,0:19:03.99,Caption,,0,0,0,,НЕОБХОДИМОЙ ОТДЕЛЬНУЮ ВСТРЕЧУ ПУТИНА И ЗЕЛЕНСКОГО.
Dialogue: 0,0:19:04.23,0:19:08.79,Caption,,0,0,0,,ПРЕПЯТСТВИЙ ДОСТАТОЧНО, ЧТОБЫ ИМИ ЗАСТАВИТЬ ВЕСЬ КОРИДОР. НИ ОДНО ГЛАВНОЕ
Dialogue: 0,0:19:08.79,0:19:13.35,Caption,,0,0,0,,ПРОТИВОРЕЧИЕ НЕ ИСЧЕЗЛО, И РУКОПОЖАТИЕ В МОСКВЕ НЕ ПРЕВРАТИТ ОППОНЕНТОВ В
Dialogue: 0,0:19:13.43,0:19:16.47,Caption,,0,0,0,,ДРУЗЕЙ. НО ВОЗМОЖНЫЙ ВИЗИТ УЖЕ ПОКАЗЫВАЕТ,
Dialogue: 0,0:19:16.71,0:19:19.59,Caption,,0,0,0,,КАКИЕ РИСКИ ЕВРОПА СЧИТАЕТ СЛИШКОМ СЕРЬЁЗНЫМИ ДЛЯ
Dialogue: 0,0:19:19.67,0:19:24.31,Caption,,0,0,0,,ОБСУЖДЕНИЯ ЧЕРЕЗ ПОСРЕДНИКОВ. ЕСЛИ СРЕДИ НИХ ДЕЙСТВИТЕЛЬНО НАХОДИТСЯ ВЕРОЯТНОСТЬ
Dialogue: 0,0:19:24.31,0:19:26.39,Caption,,0,0,0,,РОССИЙСКОГО ОТВЕТА ПО ЕВРОПЕЙСКИМ ВОЕННЫМ
Dialogue: 0,0:19:26.39,0:19:30.39,Caption,,0,0,0,,ПРЕДПРИЯТИЯМ, СОДЕРЖАНИЕ ВСТРЕЧИ СТАНЕТ НАМНОГО ЖЁСТЧЕ ПРИВЫЧНОГО
Dialogue: 0,0:19:30.47,0:19:33.43,Caption,,0,0,0,,ОБМЕНА ЗАЯВЛЕНИЯМИ. У ЕВРОПЕЙЦЕВ ТОГДА ПОЯВЯТСЯ НЕ
Dialogue: 0,0:19:33.43,0:19:36.39,Caption,,0,0,0,,ТОЛЬКО ТРЕБОВАНИЯ К РОССИИ, НО И СОБСТВЕННЫЕ ОПАСЕНИЯ.
Dialogue: 0,0:19:38.66,0:19:42.98,Caption,,0,0,0,,МОСКВА, В СВОЮ ОЧЕРЕДЬ, СМОЖЕТ ОБСУЖДАТЬ НЕ ТОЛЬКО УКРАИНСКИЕ УСЛОВИЯ,
Dialogue: 0,0:19:43.30,0:19:46.10,Caption,,0,0,0,,НО И ПОСЛЕДСТВИЯ ВОЕННОГО УЧАСТИЯ ЕВРОПЕЙСКИХ СТРАН.
Dialogue: 0,0:19:46.90,0:19:50.02,Caption,,0,0,0,,ГЛАВНЫЙ СДВИГ ПРОИЗОЙДЁТ НЕ У ТРАПА САМОЛЁТА И
Dialogue: 0,0:19:50.10,0:19:52.90,Caption,,0,0,0,,НЕ ПЕРЕД ПЕРВЫМ РУКОПОЖАТИЕМ. ОН НАЧНЁТСЯ В ТОТ
Dialogue: 0,0:19:52.90,0:19:58.74,Caption,,0,0,0,,МОМЕНТ, КОГДА ФРАНЦИЯ, ГЕРМАНИЯ И ВЕЛИКОБРИТАНИЯ СТАНУТ ОТДЕЛЬНО ОТ КИЕВА
Dialogue: 0,0:19:58.74,0:20:01.54,Caption,,0,0,0,,ГОВОРИТЬ С РОССИЕЙ О ПРЕДЕЛАХ УГРОЗЫ ДЛЯ САМИХ
Dialogue: 0,0:20:01.54,0:20:05.62,Caption,,0,0,0,,СЕБЯ. ПОСЛЕ ЭТОГО ЗАПРЕТ ЗЕЛЕНСКОГО ПОТЕРЯЕТ ПРЕЖНИЙ ВЕС.
Dialogue: 0,0:20:05.84,0:20:07.70,Caption,,0,0,0,,ПОТОМУ ЧТО ВОПРОС БУДЕТ УЖЕ НЕ В ТОМ,
Dialogue: 0,0:20:07.90,0:20:10.58,Caption,,0,0,0,,ПОЗВОЛИЛ ЛИ КИЕВ ЕВРОПЕЙЦАМ ПРИЕХАТЬ В МОСКВУ.
Dialogue: 0,0:20:11.14,0:20:13.86,Caption,,0,0,0,,ВОПРОС ОКАЖЕТСЯ КУДА НЕПРИЯТНЕЕ ЕСЛИ ОПАСНОСТЬ
Dialogue: 0,0:20:13.86,0:20:15.54,Caption,,0,0,0,,ПРИХОДИТ К ЕВРОПЕЙСКОМУ ПОРОГУ,
Dialogue: 0,0:20:15.78,0:20:18.18,Caption,,0,0,0,,КТО ТАМ ХОЗЯИН И КТО ВСЁ ТАКИ РЕШАЕТ,
Dialogue: 0,0:20:18.27,0:20:19.54,Caption,,0,0,0,,ОТКРЫВАТЬ ДВЕРЬ ИЛИ НЕТ?
