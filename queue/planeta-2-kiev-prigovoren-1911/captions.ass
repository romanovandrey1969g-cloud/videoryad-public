Dialogue: 0,0:00:00.12,0:00:03.16,Caption,,0,0,0,,ВИТАЛИЙ КИМ ЗАГЛЯНУЛ В ПОСЛЕВОЕННОЕ БУДУЩЕЕ УКРАИНЫ
Dialogue: 0,0:00:03.24,0:00:05.72,Caption,,0,0,0,,И УВИДЕЛ ТАМ НЕ ПРАЗДНИЧНЫЕ ВСТРЕЧИ ВЕРНУВШИХСЯ
Dialogue: 0,0:00:05.72,0:00:11.56,Caption,,0,0,0,,ВОЕННЫХ, А ПРЕСТУПНОСТЬ, НАПРЯЖЕНИЕ И РЕВОЛЮЦИИ. ЗАНЯТНАЯ КАРТИНА ЧЕЛОВЕК
Dialogue: 0,0:00:11.56,0:00:15.00,Caption,,0,0,0,,ВОЗВРАЩАЕТСЯ С ФРОНТА, А ЧИНОВНИК УЖЕ МЫСЛЕННО ПРОВЕРЯЕТ,
Dialogue: 0,0:00:15.20,0:00:17.40,Caption,,0,0,0,,ХОРОШО ЛИ ЗАПИРАЕТСЯ ДВЕРЬ ЕГО КАБИНЕТА.
Dialogue: 0,0:00:17.96,0:00:20.68,Caption,,0,0,0,,И ЧЕМ ДОЛЬШЕ КИМ РАССУЖДАЕТ О МИЛЛИОНАХ ВЕТЕРАНОВ,
Dialogue: 0,0:00:21.00,0:00:24.76,Caption,,0,0,0,,ТЕМ ПОНЯТНЕЕ, ПОЧЕМУ РЯДОМ ВОЗНИКАЕТ ТЕМА ЗАКРЫТЫХ ГРАНИЦ.
Dialogue: 0,0:00:24.98,0:00:27.32,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ВАМ ИНТЕРЕСНЫ РАЗБОРЫ,
Dialogue: 0,0:00:27.63,0:00:29.96,Caption,,0,0,0,,В КОТОРЫХ ЧИНОВНИЧЬИ СЛОВА РАССМАТРИВАЮТ НЕ ПО
Dialogue: 0,0:00:29.96,0:00:33.56,Caption,,0,0,0,,УПАКОВКЕ, А ПО СОДЕРЖИМОМУ. НАЧАТЬ ПРИДЁТСЯ С ЭКОНОМИКИ.
Dialogue: 0,0:00:34.01,0:00:36.68,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ ВАЛЮТНЫЙ ФОНД УХУДШИЛ ПРОГНОЗ ДЛЯ
Dialogue: 0,0:00:36.68,0:00:39.88,Caption,,0,0,0,,УКРАИНЫ. НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОЙ ГОД ВМЕСТО РОСТА
Dialogue: 0,0:00:39.88,0:00:42.84,Caption,,0,0,0,,НА ОДИН ПРОЦЕНТ ТЕПЕРЬ ОЖИДАЕТСЯ ПАДЕНИЕ НА ПОЛОВИНУ
Dialogue: 0,0:00:42.84,0:00:46.12,Caption,,0,0,0,,ПРОЦЕНТА, А В СЛЕДУЮЩЕМ ГОДУ ЕЩЁ НА ОДИН ПРОЦЕНТ.
Dialogue: 0,0:00:46.52,0:00:49.96,Caption,,0,0,0,,ОДНОВРЕМЕННО КИЕВУ СОВЕТУЮТ РАСШИРИТЬ НАЛОГОВУЮ БАЗУ
Dialogue: 0,0:00:50.04,0:00:52.52,Caption,,0,0,0,,И УВЕЛИЧИТЬ СБОРЫ. КОРОВА ХУДЕЕТ,
Dialogue: 0,0:00:52.76,0:00:55.88,Caption,,0,0,0,,А ПЛАН ПО МОЛОКУ ПОВЫШАЮТ. ЭНЕРГЕТИЧЕСКИЕ ПРОБЛЕМЫ
Dialogue: 0,0:00:55.88,0:00:58.84,Caption,,0,0,0,,ЛИШЬ УСКОРЯЮТ ПРОЦЕСС. НЬЮ ЙОРК ТАЙМС ПИШЕТ,
Dialogue: 0,0:00:59.08,0:01:02.20,Caption,,0,0,0,,ЧТО УКРАИНСКИЕ ГОРОДА КРАЙНЕ УЯЗВИМЫ. НАСЕЛЕНИЕ
Dialogue: 0,0:01:02.20,0:01:05.88,Caption,,0,0,0,,ГОТОВЯТ К РЕЖИМУ, ПРИ КОТОРОМ ЭЛЕКТРИЧЕСТВО БУДЕТ ПОЯВЛЯТЬСЯ ВСЕГО НА
Dialogue: 0,0:01:05.88,0:01:08.76,Caption,,0,0,0,,НЕСКОЛЬКО ЧАСОВ В СУТКИ. ПО СЛОВАМ КОРОЛЬЧУКА,
Dialogue: 0,0:01:09.00,0:01:11.56,Caption,,0,0,0,,ТАКОЕ ПОЛОЖЕНИЕ МОЖЕТ СОХРАНЯТЬСЯ НЕДЕЛЯМИ И
Dialogue: 0,0:01:11.56,0:01:14.76,Caption,,0,0,0,,ЗАТРОНУТЬ ШКОЛЫ, БОЛЬНИЦЫ И ДЕТСКИЕ САДЫ.
Dialogue: 0,0:01:17.05,0:01:19.53,Caption,,0,0,0,,НО ГЛАВНЫЙ УДАР ПРИХОДИТСЯ НЕ ПО РАСПИСАНИЮ
Dialogue: 0,0:01:19.53,0:01:22.65,Caption,,0,0,0,,ВКЛЮЧЕНИЙ. ЕСЛИ ПРЕДПРИЯТИЕ СТОИТ БЕЗ ЭНЕРГИИ,
Dialogue: 0,0:01:22.97,0:01:25.69,Caption,,0,0,0,,ЧЕЛОВЕК ОСТАЁТСЯ БЕЗ РАБОТЫ И ЗАРПЛАТЫ. МОЖНО
Dialogue: 0,0:01:25.69,0:01:29.13,Caption,,0,0,0,,СПОРИТЬ, КОГДА ЗАГОРИТСЯ ЛАМПОЧКА. НЕПРИЯТНЕЕ УЗНАТЬ,
Dialogue: 0,0:01:29.21,0:01:31.69,Caption,,0,0,0,,ЧТО ВКЛЮЧАТЬ ЕЁ УЖЕ НЕ НА ЧТО. ИМЕННО
Dialogue: 0,0:01:31.77,0:01:34.33,Caption,,0,0,0,,В ТАКУЮ ЭКОНОМИКУ КИМ ПРЕДЛАГАЕТ ВЕРНУТЬ ЛЮДЕЙ С
Dialogue: 0,0:01:34.41,0:01:37.21,Caption,,0,0,0,,ФРОНТА. ПОСЛЕ ЗАВЕРШЕНИЯ БОЕВЫХ ДЕЙСТВИЙ,
Dialogue: 0,0:01:37.45,0:01:41.45,Caption,,0,0,0,,ПО ЕГО ОЦЕНКЕ, В УКРАИНЕ ОКАЖЕТСЯ БОЛЕЕ ТРЁХ МИЛЛИОНОВ ВЕТЕРАНОВ.
Dialogue: 0,0:01:41.74,0:01:44.81,Caption,,0,0,0,,ВМЕСТЕ С СЕМЬЯМИ ЭТО ОКОЛО ДЕВЯТИ МИЛЛИОНОВ ЧЕЛОВЕК,
Dialogue: 0,0:01:44.97,0:01:48.01,Caption,,0,0,0,,ПОЧТИ ТРЕТЬ НАСЕЛЕНИЯ. РАЗДАТЬ ВСЕМ ПОСОБИЯ,
Dialogue: 0,0:01:48.20,0:01:50.65,Caption,,0,0,0,,ПРОИЗНЕСТИ ТОРЖЕСТВЕННУЮ РЕЧЬ И СЧИТАТЬ ЗАДАЧУ
Dialogue: 0,0:01:50.73,0:01:53.53,Caption,,0,0,0,,ВЫПОЛНЕННОЙ НЕ ВЫЙДЕТ. БЮДЖЕТ ТАКОГО ПРАЗДНИКА
Dialogue: 0,0:01:53.53,0:01:55.53,Caption,,0,0,0,,ЗАБОТЫ НЕ ВЫДЕРЖИТ. НА ВОПРОС,
Dialogue: 0,0:01:55.77,0:01:58.57,Caption,,0,0,0,,ГОТОВА ЛИ УКРАИНА К МАССОВОМУ ВОЗВРАЩЕНИЮ ВОЕННЫХ,
Dialogue: 0,0:01:58.89,0:02:01.93,Caption,,0,0,0,,КИМ ОТВЕЧАЕТ БЕЗ УКРАШЕНИЙ "НЕ ГОТОВА". СЛЕДОМ
Dialogue: 0,0:02:01.93,0:02:03.69,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ СЛОВА О ПРЕСТУПНОСТИ,
Dialogue: 0,0:02:03.85,0:02:07.13,Caption,,0,0,0,,ОБЩЕСТВЕННОМ НАПРЯЖЕНИИ И РЕВОЛЮЦИЯХ. КИМ ГОВОРИТ НЕ
Dialogue: 0,0:02:07.21,0:02:09.29,Caption,,0,0,0,,О ДАЛЁКОЙ ВЕРОЯТНОСТИ, А О ТОМ,
Dialogue: 0,0:02:09.42,0:02:12.57,Caption,,0,0,0,,ЧТО "ЭТО БУДЕТ". ЭКОНОМИКА, ПО ЕГО МНЕНИЮ,
Dialogue: 0,0:02:12.81,0:02:15.85,Caption,,0,0,0,,ДОЛЖНА ЗАРАНЕЕ СОЗДАТЬ РАБОЧИЕ МЕСТА ДЛЯ ВЕТЕРАНОВ,
Dialogue: 0,0:02:16.09,0:02:18.81,Caption,,0,0,0,,ЧТОБЫ ОНИ МОГЛИ СОДЕРЖАТЬ СЕБЯ И СЕМЬИ. НО
Dialogue: 0,0:02:18.81,0:02:22.01,Caption,,0,0,0,,ПОЧЕМУ РАЗГОВОР О СОБСТВЕННЫХ СОЛДАТАХ ПОЧТИ СРАЗУ
Dialogue: 0,0:02:22.01,0:02:26.17,Caption,,0,0,0,,СВОРАЧИВАЕТ К РЕВОЛЮЦИЯМ? ПОЧЕМУ ЧИНОВНИК ВИДИТ В НИХ НЕ ТОЛЬКО РАБОТНИКОВ
Dialogue: 0,0:02:26.17,0:02:30.49,Caption,,0,0,0,,И ПРЕДПРИНИМАТЕЛЕЙ, НО И ИСТОЧНИК ОПАСНОСТИ ДЛЯ СУЩЕСТВУЮЩЕГО ПОРЯДКА?
Dialogue: 0,0:02:32.78,0:02:37.34,Caption,,0,0,0,,ДОМОЙ ВЕРНУТСЯ НЕ СОТРУДНИКИ, ЗАДЕРЖАВШИЕСЯ НА НЕСКОЛЬКО ЛЕТ В ФИЛИАЛЕ КОМПАНИИ.
Dialogue: 0,0:02:37.72,0:02:40.22,Caption,,0,0,0,,МНОГИЕ ИЗ ЭТИХ МУЖЧИН ГОДАМИ ЖИЛИ РЯДОМ С
Dialogue: 0,0:02:40.22,0:02:41.90,Caption,,0,0,0,,ОДНИМИ И ТЕМИ ЖЕ СОСЛУЖИВЦАМИ,
Dialogue: 0,0:02:42.26,0:02:45.74,Caption,,0,0,0,,ТЕРЯЛИ ТОВАРИЩЕЙ И УЗНАВАЛИ ЦЕНУ ЧУЖОМУ СЛОВУ. ИМ
Dialogue: 0,0:02:45.82,0:02:48.78,Caption,,0,0,0,,НЕ НУЖНА ПРЕЗЕНТАЦИЯ О КОМАНДНОЙ РАБОТЕ. ОНИ ЗНАЮТ,
Dialogue: 0,0:02:48.94,0:02:50.70,Caption,,0,0,0,,КТО ОСТАНЕТСЯ РЯДОМ ПОД ОГНЁМ,
Dialogue: 0,0:02:51.01,0:02:55.34,Caption,,0,0,0,,А КТО ИСЧЕЗНЕТ, КОГДА СТАНЕТ ЖАРКО. ТАК ВОЗНИКАЕТ БОЕВОЕ БРАТСТВО,
Dialogue: 0,0:02:55.58,0:02:58.30,Caption,,0,0,0,,КОТОРОЕ НЕ ОТМЕНЯЕТСЯ ПРИКАЗОМ О ДЕМОБИЛИЗАЦИИ.
Dialogue: 0,0:02:58.79,0:03:02.22,Caption,,0,0,0,,РАЗУМЕЕТСЯ, МИЛЛИОНЫ ВЕТЕРАНОВ НЕ ПРОСНУТСЯ ОДНАЖДЫ С ОБЩЕЙ
Dialogue: 0,0:03:02.30,0:03:04.86,Caption,,0,0,0,,ПРОГРАММОЙ И ЕДИНЫМ КОМАНДИРОМ. НО ЭТО УЖЕ НЕ
Dialogue: 0,0:03:04.86,0:03:08.78,Caption,,0,0,0,,СЛУЧАЙНЫЕ ЛЮДИ, ВПЕРВЫЕ ВСТРЕТИВШИЕСЯ НА ПЛОЩАДИ. МЕЖДУ НИМИ
Dialogue: 0,0:03:08.78,0:03:11.90,Caption,,0,0,0,,СУЩЕСТВУЮТ СВЯЗИ, ДОВЕРИЕ И АВТОРИТЕТ ТЕХ,
Dialogue: 0,0:03:12.22,0:03:15.10,Caption,,0,0,0,,КТО ПРОШЁЛ С НИМИ САМЫЕ ТЯЖЁЛЫЕ ГОДЫ. ТАКАЯ
Dialogue: 0,0:03:15.10,0:03:17.34,Caption,,0,0,0,,СРЕДА СПОСОБНА ОРГАНИЗОВАТЬСЯ БЫСТРЕЕ,
Dialogue: 0,0:03:17.50,0:03:21.82,Caption,,0,0,0,,ЧЕМ ХОТЕЛОСЬ БЫ НАЧАЛЬНИКУ, ПРИВЫКШЕМУ РАЗГОВАРИВАТЬ С ГРАЖДАНАМИ ЧЕРЕЗ ТУРНИКЕТ
Dialogue: 0,0:03:21.90,0:03:25.18,Caption,,0,0,0,,И ОХРАННИКА. ПРИЧИНЫ ДЛЯ НЕДОВОЛЬСТВА ПРИДУМЫВАТЬ ТОЖЕ НЕ
Dialogue: 0,0:03:25.18,0:03:27.82,Caption,,0,0,0,,ПРИДЁТСЯ. ПЯТЬ ЛЕТ ВОЕННЫЕ НАБЛЮДАЮТ ЗА
Dialogue: 0,0:03:27.82,0:03:30.54,Caption,,0,0,0,,МОБИЛИЗАЦИЕЙ. ОНИ СЛЫШАТ ИСТОРИИ О ЛЮДЯХ,
Dialogue: 0,0:03:30.78,0:03:34.46,Caption,,0,0,0,,КОТОРЫХ ЗАБИРАЮТ НА УЛИЦАХ, ЗНАЮТ О ПРОБЛЕМАХ СО СНАБЖЕНИЕМ,
Dialogue: 0,0:03:34.62,0:03:37.42,Caption,,0,0,0,,ВИДЯТ СООБЩЕНИЯ О КОРРУПЦИОННЫХ ДЕЛАХ И ОГРОМНЫЕ
Dialogue: 0,0:03:37.42,0:03:41.34,Caption,,0,0,0,,СУММЫ, ПРОХОДЯЩИЕ ЧЕРЕЗ ГОСУДАРСТВЕННЫЕ СТРУКТУРЫ. ОНИ
Dialogue: 0,0:03:41.42,0:03:44.62,Caption,,0,0,0,,ПОНИМАЮТ РАЗНИЦУ МЕЖДУ ПЕРЕДОВОЙ И КАБИНЕТОМ. ОНА
Dialogue: 0,0:03:44.62,0:03:47.34,Caption,,0,0,0,,ИЗМЕРЯЕТСЯ НЕ КИЛОМЕТРАМИ, А ЧУЖОЙ СОВЕСТЬЮ.
Dialogue: 0,0:03:49.60,0:03:53.77,Caption,,0,0,0,,ПОЭТОМУ ОБЕЩАНИЕ, ЧТО ПОСЛЕ ВОЗВРАЩЕНИЯ ВСЕ СПОКОЙНО НАДЕНУТ РАБОЧИЕ
Dialogue: 0,0:03:53.77,0:03:56.41,Caption,,0,0,0,,КАСКИ И ОТПРАВЯТСЯ ВОССТАНАВЛИВАТЬ СТРАНУ,
Dialogue: 0,0:03:56.70,0:04:02.17,Caption,,0,0,0,,ЗВУЧИТ СЛИШКОМ БЕЗМЯТЕЖНО. НО САМ КИМ УПОМИНАЕТ НЕ ТОЛЬКО ТРУДОУСТРОЙСТВО. О
Dialogue: 0,0:04:02.17,0:04:05.53,Caption,,0,0,0,,ПРЕСТУПНОСТИ, НАПРЯЖЕНИИ И РЕВОЛЮЦИЯХ НЕ ГОВОРЯТ,
Dialogue: 0,0:04:05.76,0:04:08.33,Caption,,0,0,0,,КОГДА ЖДУТ ИСКЛЮЧИТЕЛЬНО БЛАГОДАРНЫХ ПОЛУЧАТЕЛЕЙ
Dialogue: 0,0:04:08.41,0:04:10.81,Caption,,0,0,0,,СОЦИАЛЬНЫХ ПРОГРАММ. ПОКА ОДИН НАХОДИЛСЯ НА
Dialogue: 0,0:04:10.81,0:04:13.29,Caption,,0,0,0,,ПЕРЕДОВОЙ, ДРУГОЙ РАСПРЕДЕЛЯЛ БЮДЖЕТЫ,
Dialogue: 0,0:04:13.40,0:04:16.01,Caption,,0,0,0,,ПОДПИСЫВАЛ КОНТРАКТЫ И СТРОИЛ КАРЬЕРУ. ПОСЛЕ
Dialogue: 0,0:04:16.01,0:04:18.73,Caption,,0,0,0,,ДЕМОБИЛИЗАЦИИ РАЗГОВОР МОЖЕТ ПОЙТИ НЕ С БЕЗЛИКИМ
Dialogue: 0,0:04:18.73,0:04:22.49,Caption,,0,0,0,,ГОСУДАРСТВОМ, А С КОНКРЕТНЫМИ ФАМИЛИЯМИ. ПЕРИОД У ВСЕХ ОДИН,
Dialogue: 0,0:04:22.81,0:04:25.93,Caption,,0,0,0,,ТОЛЬКО УСЛОВИЯ ПОЧЕМУ ТО РАЗНЫЕ. ГДЕ НАХОДИЛОСЬ
Dialogue: 0,0:04:25.93,0:04:29.93,Caption,,0,0,0,,ОБЕЩАННОЕ СНАБЖЕНИЕ? ПОЧЕМУ ОДНИ ГОДАМИ НЕ ВЫХОДИЛИ С ПЕРЕДОВОЙ,
Dialogue: 0,0:04:30.17,0:04:31.77,Caption,,0,0,0,,А ДРУГИЕ ПРЕКРАСНО УСТРОИЛИСЬ?
Dialogue: 0,0:04:32.05,0:04:33.85,Caption,,0,0,0,,ОБЪЯСНЯТЬ ПРИДЁТСЯ НЕ В СТУДИИ,
Dialogue: 0,0:04:34.09,0:04:36.01,Caption,,0,0,0,,ГДЕ ВЕДУЩИЙ ВОВРЕМЯ СМЕНИТ ТЕМУ,
Dialogue: 0,0:04:36.24,0:04:40.17,Caption,,0,0,0,,А ЛЮДЯМ, КОТОРЫХ ОТПРАВЛЯЛИ РИСКОВАТЬ ЖИЗНЬЮ. ТОГДА СПОР О
Dialogue: 0,0:04:40.17,0:04:43.29,Caption,,0,0,0,,РАЗМЕРЕ ВЫПЛАТ ЗАКОНЧИТСЯ И НАЧНЁТСЯ РАЗГОВОР ОБ
Dialogue: 0,0:04:43.29,0:04:46.33,Caption,,0,0,0,,ОТВЕТСТВЕННОСТИ. ЭТО НЕ ПРЕВРАЩАЕТ ВСЕХ ВЕТЕРАНОВ В
Dialogue: 0,0:04:46.41,0:04:49.45,Caption,,0,0,0,,ЕДИНУЮ ОРГАНИЗАЦИЮ. ЗАТО ПРЕДСТАВЛЕНИЕ О НИХ КАК О
Dialogue: 0,0:04:49.45,0:04:52.65,Caption,,0,0,0,,БЕСПОМОЩНОЙ И РАЗОБЩЁННОЙ МАССЕ СТАНОВИТСЯ ОПАСНОЙ
Dialogue: 0,0:04:52.65,0:04:55.37,Caption,,0,0,0,,ЧИНОВНИЧЬЕЙ ФАНТАЗИЕЙ. МОЖНО УСПОКАИВАТЬ СЕБЯ
Dialogue: 0,0:04:55.45,0:04:58.33,Caption,,0,0,0,,ДОКЛАДОМ С КРАСИВЫМИ ДИАГРАММАМИ. ДИАГРАММА ВООБЩЕ
Dialogue: 0,0:04:58.33,0:05:01.45,Caption,,0,0,0,,УДОБНЫЙ СОБЕСЕДНИК ОНА НЕ ЗАДАЁТ ВСТРЕЧНЫХ ВОПРОСОВ.
Dialogue: 0,0:05:03.71,0:05:06.83,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ЦЕНИТЕ РАЗГОВОР БЕЗ УСПОКОИТЕЛЬНЫХ
Dialogue: 0,0:05:06.83,0:05:09.88,Caption,,0,0,0,,ФОРМУЛИРОВОК. ВЕТЕРАНСКИЕ ОБЪЕДИНЕНИЯ МОГУТ СТАТЬ
Dialogue: 0,0:05:09.88,0:05:12.92,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОЙ ПОЛИТИЧЕСКОЙ СИЛОЙ. ВСТРОИТЬ ЕЁ В
Dialogue: 0,0:05:12.92,0:05:17.00,Caption,,0,0,0,,ПРИВЫЧНУЮ ВЕРТИКАЛЬ, ВЫДАТЬ НЕСКОЛЬКО ДОЛЖНОСТЕЙ И ПОСТАВИТЬ ГАЛОЧКУ
Dialogue: 0,0:05:17.08,0:05:20.27,Caption,,0,0,0,,БУДЕТ НЕПРОСТО. ПОКА ПРОДОЛЖАЮТСЯ БОЕВЫЕ ДЕЙСТВИЯ,
Dialogue: 0,0:05:20.54,0:05:23.64,Caption,,0,0,0,,У ВЛАСТИ ИМЕЕТСЯ УНИВЕРСАЛЬНОЕ ОБЪЯСНЕНИЕ ПОЧТИ ДЛЯ
Dialogue: 0,0:05:23.64,0:05:28.20,Caption,,0,0,0,,ВСЕГО. БЮДЖЕТУ, ЭКОНОМИКЕ И ОГРАНИЧЕНИЯМ ХРОНИЧЕСКИ НЕ ХВАТАЕТ
Dialogue: 0,0:05:28.20,0:05:30.84,Caption,,0,0,0,,ОДНОГО И ТОГО ЖЕ ОБЪЯСНЕНИЯ КОНФЛИКТ. ЛЮБОЕ
Dialogue: 0,0:05:30.84,0:05:35.40,Caption,,0,0,0,,НЕДОВОЛЬСТВО ПРОСЯТ ОТЛОЖИТЬ. НО БОЕВЫЕ ДЕЙСТВИЯ ОДНАЖДЫ ЗАВЕРШАЮТСЯ. И К
Dialogue: 0,0:05:35.40,0:05:39.80,Caption,,0,0,0,,ЧИНОВНИКУ ПРИХОДИТ ЧЕЛОВЕК, КОТОРЫЙ ВСЕ ЭТИ ГОДЫ НАХОДИЛСЯ ИМЕННО ТАМ,
Dialogue: 0,0:05:40.03,0:05:45.24,Caption,,0,0,0,,КУДА ЕГО ПОСЛАЛО ГОСУДАРСТВО. ПРОСЬБА ЕЩЁ НЕМНОГО ПОТЕРПЕТЬ ДЕЙСТВУЕТ НА НЕГО УЖЕ
Dialogue: 0,0:05:45.32,0:05:48.68,Caption,,0,0,0,,НЕ ТАК ВОЛШЕБНО. РАБОТЫ НЕТ, ЖИЛЬЁ РАЗРУШЕНО,
Dialogue: 0,0:05:48.84,0:05:51.32,Caption,,0,0,0,,ЦЕНЫ ВЫРОСЛИ, А НАПРОТИВ СИДИТ ЧЕЛОВЕК,
Dialogue: 0,0:05:51.48,0:05:53.96,Caption,,0,0,0,,ЧЬЯ КАРЬЕРА ЗА ГОДЫ КОНФЛИКТА ТОЛЬКО УЛУЧШАЛАСЬ.
Dialogue: 0,0:05:54.67,0:05:57.16,Caption,,0,0,0,,ПРЕДЛОЖИТЬ ВЕТЕРАНУ ПОНИМАНИЕ МОЖНО. ТРУДНЕЕ
Dialogue: 0,0:05:57.16,0:06:00.60,Caption,,0,0,0,,ОБЪЯСНИТЬ, ПОЧЕМУ ПОНИМАНИЕ ВСЕГДА ТРЕБУЕТСЯ ОТ НЕГО,
Dialogue: 0,0:06:00.84,0:06:02.68,Caption,,0,0,0,,А КОМФОРТ ДОСТАЁТСЯ КОМУ ТО ДРУГОМУ.
Dialogue: 0,0:06:03.23,0:06:06.28,Caption,,0,0,0,,ПОЭТОМУ СЛОВА КИМА О ПОДГОТОВКЕ ГОСУДАРСТВА МОЖНО
Dialogue: 0,0:06:06.28,0:06:10.60,Caption,,0,0,0,,ПРОЧИТАТЬ ИНАЧЕ. ВОЗМОЖНО, ЧАСТЬ ЧИНОВНИКОВ ДУМАЕТ НЕ СТОЛЬКО О ПОМОЩИ
Dialogue: 0,0:06:10.60,0:06:14.52,Caption,,0,0,0,,ВЕРНУВШИМСЯ, СКОЛЬКО О СОХРАНЕНИИ СОБСТВЕННЫХ КРЕСЕЛ. ИМ
Dialogue: 0,0:06:14.52,0:06:18.92,Caption,,0,0,0,,ПРЕДСТОИТ ВСТРЕТИТЬ ТЕХ, У КОГО НАКОПИЛИСЬ ВОПРОСЫ И ЕСТЬ ПРИВЫЧКА ДОБИВАТЬСЯ
Dialogue: 0,0:06:18.92,0:06:24.54,Caption,,0,0,0,,РЕЗУЛЬТАТА. ДЛЯ ХОЗЯИНА ПРОСТОРНОГО КАБИНЕТА ТАКАЯ ПЕРСПЕКТИВА
Dialogue: 0,0:06:24.54,0:06:27.58,Caption,,0,0,0,,ТРЕВОЖНЕЕ ЛЮБОЙ ТАБЛИЦЫ СОЦИАЛЬНЫХ РАСХОДОВ. КИМ
Dialogue: 0,0:06:27.66,0:06:31.82,Caption,,0,0,0,,ЭТОГО ПРЯМО НЕ ПРОИЗНОСИТ. НО ПОСЛЕ ПРЕДУПРЕЖДЕНИЙ О ПРЕСТУПНОСТИ,
Dialogue: 0,0:06:31.97,0:06:35.58,Caption,,0,0,0,,НАПРЯЖЕНИИ И РЕВОЛЮЦИЯХ ВОЗНИКАЕТ ВОПРОС ЧИНОВНИК
Dialogue: 0,0:06:35.66,0:06:37.98,Caption,,0,0,0,,БОИТСЯ БЕЗРАБОТНОГО ВЕТЕРАНА ИЛИ ВЕТЕРАНА,
Dialogue: 0,0:06:38.22,0:06:39.74,Caption,,0,0,0,,КОТОРЫЙ ПОМНИТ СЛИШКОМ МНОГОЕ?
Dialogue: 0,0:06:40.18,0:06:42.70,Caption,,0,0,0,,А ЗАТЕМ ПОЯВЛЯЮТСЯ ГРАНИЦЫ. КИМ ПРИЗНАЁТ,
Dialogue: 0,0:06:43.00,0:06:46.22,Caption,,0,0,0,,ЧТО ПОСЛЕ ИХ ОТКРЫТИЯ ЛЮДИ НАЧНУТ УЕЗЖАТЬ. ЗНАЧИТ,
Dialogue: 0,0:06:46.61,0:06:49.82,Caption,,0,0,0,,ВЛАСТИ ПОНИМАЮТ МАСШТАБ ВОЗМОЖНОГО ИСХОДА. СТОИТ
Dialogue: 0,0:06:49.82,0:06:54.22,Caption,,0,0,0,,УБРАТЬ ОГРАНИЧЕНИЯ, И ЗНАЧИТЕЛЬНАЯ ЧАСТЬ НАСЕЛЕНИЯ ПРЕДПОЧТЁТ НЕ ЖДАТЬ,
Dialogue: 0,0:06:54.38,0:06:56.94,Caption,,0,0,0,,ПОКА ЭКОНОМИЧЕСКИЕ ОБЕЩАНИЯ ПРЕВРАТЯТСЯ В ЗАРПЛАТУ.
Dialogue: 0,0:06:57.34,0:06:59.74,Caption,,0,0,0,,СОГЛАСНО ДАННЫМ ОПРОСА GRADUS RESEARCH,
Dialogue: 0,0:06:59.87,0:07:03.66,Caption,,0,0,0,,УПОМЯНУТЫМ В ЭТОЙ ДИСКУССИИ, ДОЛЯ УКРАИНЦЕВ В ЕВРОСОЮЗЕ,
Dialogue: 0,0:07:03.90,0:07:06.38,Caption,,0,0,0,,НЕ НАМЕРЕННЫХ ВОЗВРАЩАТЬСЯ ДАЖЕ ПОСЛЕ ОКОНЧАНИЯ
Dialogue: 0,0:07:06.38,0:07:08.78,Caption,,0,0,0,,КОНФЛИКТА НА ПРИЕМЛЕМЫХ ДЛЯ КИЕВА УСЛОВИЯХ,
Dialogue: 0,0:07:09.16,0:07:12.86,Caption,,0,0,0,,ЗА ГОД УВЕЛИЧИЛАСЬ С СЕМНАДЦАТИ ДО ТРИДЦАТИ ЧЕТЫРЁХ
Dialogue: 0,0:07:12.86,0:07:17.26,Caption,,0,0,0,,ПРОЦЕНТОВ. КАЖДЫЙ ТРЕТИЙ. ДЛЯ СТРАНЫ ЭТО УДАР СРАЗУ ПО НЕСКОЛЬКИМ
Dialogue: 0,0:07:17.26,0:07:20.14,Caption,,0,0,0,,НАПРАВЛЕНИЯМ. НУЖНЫ РАБОЧИЕ, СПЕЦИАЛИСТЫ,
Dialogue: 0,0:07:20.30,0:07:23.82,Caption,,0,0,0,,ПРЕДПРИНИМАТЕЛИ И НАЛОГОПЛАТЕЛЬЩИКИ. БЕЗ НИХ НЕКОМУ
Dialogue: 0,0:07:23.82,0:07:29.02,Caption,,0,0,0,,РЕМОНТИРОВАТЬ ИНФРАСТРУКТУРУ, ЗАПУСКАТЬ ПРЕДПРИЯТИЯ И НАПОЛНЯТЬ БЮДЖЕТ. СОЦИАЛЬНЫЕ
Dialogue: 0,0:07:29.02,0:07:30.94,Caption,,0,0,0,,ПРОГРАММЫ ПИТАЮТСЯ НЕ ОБЕЩАНИЯМИ,
Dialogue: 0,0:07:31.18,0:07:35.10,Caption,,0,0,0,,А ДЕНЬГАМИ ЛЮДЕЙ, У КОТОРЫХ ЕСТЬ РАБОТА. ПОЭТОМУ ОТКРЫТЬ ГРАНИЦЫ
Dialogue: 0,0:07:35.10,0:07:37.74,Caption,,0,0,0,,СТРАШНО СЛИШКОМ МНОГИЕ МОГУТ ВЫБРАТЬ БИЛЕТ В ОДНУ
Dialogue: 0,0:07:37.74,0:07:42.66,Caption,,0,0,0,,СТОРОНУ. НО ПОСМОТРИМ НА ОТЪЕЗД ИЗ ОКНА КАБИНЕТА,
Dialogue: 0,0:07:42.88,0:07:45.62,Caption,,0,0,0,,ХОЗЯИН КОТОРОГО ОПАСАЕТСЯ ВОПРОСОВ ОТ ВЕТЕРАНОВ.
Dialogue: 0,0:07:46.24,0:07:48.82,Caption,,0,0,0,,ПОКИНУВШИЙ СТРАНУ ЧЕЛОВЕК УЖЕ НЕ ПРИДЁТ СПРАШИВАТЬ О
Dialogue: 0,0:07:48.82,0:07:53.14,Caption,,0,0,0,,КОНТРАКТАХ, СНАБЖЕНИИ И ПРИНЯТЫХ РЕШЕНИЯХ. ДЛЯ ЭКОНОМИКИ И
Dialogue: 0,0:07:53.14,0:07:55.22,Caption,,0,0,0,,БЮДЖЕТА ЕГО ОТЪЕЗД СТАНЕТ ПОТЕРЕЙ,
Dialogue: 0,0:07:55.48,0:07:58.26,Caption,,0,0,0,,ЗАТО ВОКРУГ КОНКРЕТНОГО НАЧАЛЬНИКА СДЕЛАЕТСЯ ТИШЕ.
Dialogue: 0,0:07:58.74,0:08:02.66,Caption,,0,0,0,,РЕДКИЙ СЛУЧАЙ, КОГДА ОБЩАЯ КАТАСТРОФА СПОСОБНА ПОДАРИТЬ ОТДЕЛЬНОМУ
Dialogue: 0,0:08:02.74,0:08:05.86,Caption,,0,0,0,,ЧИНОВНИКУ ДУШЕВНЫЙ КОМФОРТ. СТРАНА СЛАБЕЕТ,
Dialogue: 0,0:08:06.05,0:08:08.98,Caption,,0,0,0,,БЮДЖЕТ ПУСТЕЕТ, ВОССТАНОВЛЕНИЕ ТОРМОЗИТСЯ,
Dialogue: 0,0:08:09.30,0:08:11.94,Caption,,0,0,0,,А ЧИНОВНИК СПОКОЕН. ВОТ И ВСЯ ПОСЛЕВОЕННАЯ
Dialogue: 0,0:08:11.94,0:08:13.70,Caption,,0,0,0,,АРИФМЕТИКА ОДНИХ НАДО УДЕРЖАТЬ,
Dialogue: 0,0:08:13.95,0:08:15.70,Caption,,0,0,0,,ПОТОМУ ЧТО БЕЗ НИХ НЕКОМУ РАБОТАТЬ,
Dialogue: 0,0:08:16.00,0:08:19.94,Caption,,0,0,0,,ДРУГИХ ТРУДОУСТРОИТЬ, ПОТОМУ ЧТО ПОСОБИЯМИ МИЛЛИОНЫ НЕ ПРОКОРМИШЬ,
Dialogue: 0,0:08:20.16,0:08:22.74,Caption,,0,0,0,,ТРЕТЬИ УЖЕ ОБУСТРОИЛИСЬ В ЕВРОПЕ И ВОЗВРАЩАТЬСЯ НЕ
Dialogue: 0,0:08:22.74,0:08:25.46,Caption,,0,0,0,,ПЛАНИРУЮТ, А ТЕ, КТО ВЕРНЁТСЯ С ФРОНТА,
Dialogue: 0,0:08:25.78,0:08:28.74,Caption,,0,0,0,,РИСКУЮТ ОКАЗАТЬСЯ САМОЙ ОРГАНИЗОВАННОЙ И САМОЙ
Dialogue: 0,0:08:28.74,0:08:32.10,Caption,,0,0,0,,НЕУДОБНОЙ ЧАСТЬЮ ОБЩЕСТВА. ПОСЛЕ КОНФЛИКТА УКРАИНЕ
Dialogue: 0,0:08:32.10,0:08:36.58,Caption,,0,0,0,,ПОНАДОБЯТСЯ РАБОЧИЕ РУКИ, НО НА ГРАНИЦЕ С РУМЫНИЕЙ УЖЕ ОБСУЖДАЮТ КОЛЮЧУЮ
Dialogue: 0,0:08:36.66,0:08:39.38,Caption,,0,0,0,,ПРОВОЛОКУ. ТУТ СНОВА ПОЯВЛЯЕТСЯ МЕЖДУНАРОДНЫЙ
Dialogue: 0,0:08:39.46,0:08:42.34,Caption,,0,0,0,,ВАЛЮТНЫЙ ФОНД С ТРЕБОВАНИЕМ УВЕЛИЧИТЬ БЮДЖЕТНЫЕ
Dialogue: 0,0:08:42.34,0:08:44.58,Caption,,0,0,0,,ПОСТУПЛЕНИЯ. ОСТАЛОСЬ НАЙТИ ТЕХ,
Dialogue: 0,0:08:44.74,0:08:47.62,Caption,,0,0,0,,КТО ЕГО ОПЛАТИТ. БЮДЖЕТ НАПОЛНЯТ ВЕТЕРАНЫ,
Dialogue: 0,0:08:47.86,0:08:49.94,Caption,,0,0,0,,КОТОРЫМ ГОСУДАРСТВО ТОЛЬКО ОБЕЩАЕТ ЖИЛЬЁ,
Dialogue: 0,0:08:50.10,0:08:54.10,Caption,,0,0,0,,РАБОТУ И НОРМАЛЬНУЮ ЖИЗНЬ? В РАСЧЁТАХ ВСЁ ВЫГЛЯДИТ УБЕДИТЕЛЬНО.
Dialogue: 0,0:08:56.39,0:08:58.63,Caption,,0,0,0,,ТАБЛИЦА НЕ МЁРЗНЕТ БЕЗ ОТОПЛЕНИЯ,
Dialogue: 0,0:08:58.87,0:09:01.67,Caption,,0,0,0,,НЕ ЗАКРЫВАЕТ МАСТЕРСКУЮ И НЕ ПОКУПАЕТ БИЛЕТ ЗА
Dialogue: 0,0:09:01.67,0:09:04.87,Caption,,0,0,0,,ГРАНИЦУ. С НЕЙ ЛЕГКО УПРАВЛЯТЬ СТРАНОЙ. ЖАЛЬ,
Dialogue: 0,0:09:05.11,0:09:08.07,Caption,,0,0,0,,ЧТО НАЛОГИ ПЛАТЯТ НЕ ЯЧЕЙКИ, А ЖИВЫЕ ЛЮДИ.
Dialogue: 0,0:09:09.00,0:09:11.35,Caption,,0,0,0,,ПОСЛЕ ЗАВЕРШЕНИЯ КОНФЛИКТА УКРАИНЕ ПОНАДОБЯТСЯ
Dialogue: 0,0:09:11.35,0:09:14.23,Caption,,0,0,0,,ОГРОМНЫЕ СРЕДСТВА. РАЗРУШЕННЫЕ ОБЪЕКТЫ МОЖНО
Dialogue: 0,0:09:14.23,0:09:17.35,Caption,,0,0,0,,ОТСТРОИТЬ. БЕТОН ПРОДАЁТСЯ, КАБЕЛЬ МЕНЯЕТСЯ,
Dialogue: 0,0:09:17.59,0:09:19.91,Caption,,0,0,0,,КРЕДИТ ПРИ НЕОБХОДИМОСТИ БЕРЁТСЯ ОЧЕРЕДНОЙ.
Dialogue: 0,0:09:20.19,0:09:23.11,Caption,,0,0,0,,МАТЕРИАЛЬНЫЙ УЩЕРБ МОЖНО ОЦЕНИТЬ И ЗАНЕСТИ В СМЕТУ.
Dialogue: 0,0:09:23.33,0:09:25.67,Caption,,0,0,0,,С ДОВЕРИЕМ ЭТОТ НОМЕР НЕ ПРОХОДИТ. СУДЯ ПО
Dialogue: 0,0:09:25.67,0:09:27.75,Caption,,0,0,0,,СЛОВАМ КИМА О БУДУЩЕЙ ПРЕСТУПНОСТИ,
Dialogue: 0,0:09:27.95,0:09:32.23,Caption,,0,0,0,,НАПРЯЖЕНИИ И РЕВОЛЮЦИЯХ, ОН ПОНИМАЕТ МАСШТАБ ПРЕДСТОЯЩЕГО СТОЛКНОВЕНИЯ.
Dialogue: 0,0:09:32.63,0:09:35.19,Caption,,0,0,0,,ПОЭТОМУ ОБСУЖДАТЬ ТОЛЬКО ДЕНЬГИ НА ВОССТАНОВЛЕНИЕ
Dialogue: 0,0:09:35.19,0:09:37.99,Caption,,0,0,0,,НЕДОСТАТОЧНО. ГЛАВНЫЙ ВОПРОС СОСТОИТ В ТОМ,
Dialogue: 0,0:09:38.22,0:09:40.95,Caption,,0,0,0,,КТО БУДЕТ ВОССТАНАВЛИВАТЬ УКРАИНУ. КТО РЕШИТ
Dialogue: 0,0:09:40.95,0:09:43.11,Caption,,0,0,0,,ОСТАТЬСЯ, КТО ОКОНЧАТЕЛЬНО УЕДЕТ,
Dialogue: 0,0:09:43.40,0:09:46.47,Caption,,0,0,0,,КТО ВЕРНЁТСЯ С ФРОНТА И КАКИЕ ОТВЕТЫ ПОЛУЧИТ
Dialogue: 0,0:09:46.47,0:09:49.43,Caption,,0,0,0,,ОТ ТЕХ, КТО ВСТРЕТИТ ЕГО ЗА ДВЕРЯМИ ГОСУДАРСТВЕННЫХ
Dialogue: 0,0:09:49.43,0:09:52.15,Caption,,0,0,0,,КАБИНЕТОВ. ВОЕННЫЕ ДЕЙСТВИЯ МОГУТ ЗАВЕРШИТЬСЯ
Dialogue: 0,0:09:52.15,0:09:55.35,Caption,,0,0,0,,ПРИКАЗОМ И ПОДПИСЬЮ. ИХ ПОСЛЕДСТВИЯ ПРИКАЗАМ УЖЕ НЕ
Dialogue: 0,0:09:55.35,0:09:58.07,Caption,,0,0,0,,ПОДЧИНЯЮТСЯ. САМЫЙ ТЯЖЁЛЫЙ РАЗГОВОР ИНОГДА
Dialogue: 0,0:09:58.07,0:10:01.59,Caption,,0,0,0,,НАЧИНАЕТСЯ НЕ НА ПЕРЕДОВОЙ, А ПОСЛЕ ВОЗВРАЩЕНИЯ ДОМОЙ,
Dialogue: 0,0:10:01.82,0:10:04.15,Caption,,0,0,0,,КОГДА У ЧЕЛОВЕКА НАКОНЕЦ ПОЯВЛЯЕТСЯ ВОЗМОЖНОСТЬ
Dialogue: 0,0:10:04.15,0:10:06.55,Caption,,0,0,0,,СПРОСИТЬ, РАДИ ЧЕГО ВСЁ ЭТО БЫЛО.
