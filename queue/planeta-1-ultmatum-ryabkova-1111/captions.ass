Dialogue: 0,0:00:00.12,0:00:03.16,Caption,,0,0,0,,САМАЯ ОПАСНАЯ ФРАЗА ПОСЛЕДНИХ ДНЕЙ ПРОЗВУЧАЛА НЕ НА
Dialogue: 0,0:00:03.16,0:00:07.24,Caption,,0,0,0,,ПЕРЕГОВОРАХ В АБУ ДАБИ. РОССИЯ НЕ СОБИРАЕТСЯ НАПАДАТЬ НА ЕВРОПУ,
Dialogue: 0,0:00:07.47,0:00:10.52,Caption,,0,0,0,,СКАЗАЛ СЕРГЕЙ РЯБКОВ, НО В СЛУЧАЕ АГРЕССИИ ОТВЕТИТ,
Dialogue: 0,0:00:10.84,0:00:13.16,Caption,,0,0,0,,А САМ КОНФЛИКТ БУДЕТ СОВСЕМ ДРУГИМ И ОЧЕНЬ
Dialogue: 0,0:00:13.16,0:00:16.84,Caption,,0,0,0,,КОРОТКИМ. КОГДА ТАКОЕ ГОВОРИТ ЗАМГЛАВЫ РОССИЙСКОГО МИД,
Dialogue: 0,0:00:17.12,0:00:19.80,Caption,,0,0,0,,СЛОВО "КОРОТКИМ" УТЕШАЕТ ПРИМЕРНО КАК ТАБЛИЧКА
Dialogue: 0,0:00:19.80,0:00:22.84,Caption,,0,0,0,,"ВЫХОДА НЕТ" В ГОРЯЩЕМ КИНОТЕАТРЕ. ПЯТЬ ЛЕТ НАЗАД
Dialogue: 0,0:00:22.84,0:00:25.56,Caption,,0,0,0,,МОСКВА УЖЕ ПОЛОЖИЛА ЗАПАДУ НА СТОЛ ТРЕБОВАНИЯ ПО
Dialogue: 0,0:00:25.56,0:00:28.20,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ИХ НАЗВАЛИ УЛЬТИМАТУМОМ,
Dialogue: 0,0:00:28.44,0:00:30.84,Caption,,0,0,0,,ОТОДВИНУЛИ В СТОРОНУ И ПРОДОЛЖИЛИ ЖИТЬ ТАК,
Dialogue: 0,0:00:31.07,0:00:33.88,Caption,,0,0,0,,БУДТО НЕПРИЯТНЫЙ РАЗГОВОР САМ РАССОСЁТСЯ. НЕ
Dialogue: 0,0:00:33.88,0:00:36.76,Caption,,0,0,0,,РАССОСАЛСЯ. ПОЭТОМУ ПЕРЕД НАМИ НЕ ПРОСТО ОЧЕРЕДНОЙ
Dialogue: 0,0:00:36.84,0:00:40.04,Caption,,0,0,0,,РАУНД СПОРА ОБ УКРАИНЕ. ЭТО УЛЬТИМАТУМ ДВА НОЛЬ.
Dialogue: 0,0:00:40.60,0:00:42.44,Caption,,0,0,0,,А ЕСЛИ СМОТРЕТЬ НЕ НА ПРОТОКОЛ ВСТРЕЧ,
Dialogue: 0,0:00:42.67,0:00:46.44,Caption,,0,0,0,,А НА ЦЕНУ ОШИБКИ, ТО УЖЕ И КАРИБСКИЙ КРИЗИС ДВА НОЛЬ. СТОРОНЫ
Dialogue: 0,0:00:46.44,0:00:49.48,Caption,,0,0,0,,ЕЩЁ РАЗГОВАРИВАЮТ, НО ОДНОВРЕМЕННО ОБЪЯСНЯЮТ,
Dialogue: 0,0:00:49.72,0:00:52.76,Caption,,0,0,0,,КАК БЫСТРО РАЗГОВОР МОЖЕТ ЗАКОНЧИТЬСЯ ВМЕСТЕ СО ВСЕМ
Dialogue: 0,0:00:52.84,0:00:56.36,Caption,,0,0,0,,ОСТАЛЬНЫМ. ЕСЛИ ВАМ ИНТЕРЕСНЫ ИМЕННО ТАКИЕ СИГНАЛЫ,
Dialogue: 0,0:00:56.59,0:00:58.92,Caption,,0,0,0,,А НЕ СОРЕВНОВАНИЕ ПРЕДСТАВИТЕЛЕЙ ПРЕСС СЛУЖБ В
Dialogue: 0,0:00:59.00,0:01:02.12,Caption,,0,0,0,,БОДРЫХ ЛИЦАХ, ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ МЫ СМОТРИМ,
Dialogue: 0,0:01:02.28,0:01:04.44,Caption,,0,0,0,,ЧТО УЧАСТНИКИ ДЕЛАЮТ ПОСЛЕ ВСТРЕЧ,
Dialogue: 0,0:01:04.70,0:01:07.24,Caption,,0,0,0,,ПОТОМУ ЧТО ЗАЯВЛЕНИЯ ОБЫЧНО ЖИВУТ ДО БЛИЖАЙШЕГО
Dialogue: 0,0:01:07.32,0:01:10.60,Caption,,0,0,0,,ЗАКРЫТОГО СОВЕЩАНИЯ. ВСЮ ПРОБЛЕМУ МАРКО РУБИО УЛОЖИЛ
Dialogue: 0,0:01:10.68,0:01:13.64,Caption,,0,0,0,,В ОДНУ ФОРМУЛУ. ГАРАНТИИ ДЛЯ УКРАИНЫ ДОЛЖНЫ БЫТЬ
Dialogue: 0,0:01:13.64,0:01:18.65,Caption,,0,0,0,,ПРИЕМЛЕМЫ ДЛЯ РОССИИ. В ЭТОЙ ФРАЗЕ БОЛЬШЕ СМЫСЛА,
Dialogue: 0,0:01:18.94,0:01:21.29,Caption,,0,0,0,,ЧЕМ В КИПЕ ПРОЕКТОВ С ПЕЧАТЯМИ И ТОРЖЕСТВЕННЫМИ
Dialogue: 0,0:01:21.29,0:01:24.89,Caption,,0,0,0,,ПОДПИСЯМИ. ЕСЛИ ПОД ВИДОМ ЗАЩИТЫ УКРАИНЫ ВОЗЛЕ РОССИИ
Dialogue: 0,0:01:24.89,0:01:28.89,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ РОВНО ТО, ПРОТИВ ЧЕГО МОСКВА ВЫСТУПАЛА ВСЕ ЭТИ ГОДЫ,
Dialogue: 0,0:01:29.27,0:01:32.57,Caption,,0,0,0,,СОГЛАШЕНИЕ НЕ УСТРАНЯЕТ УГРОЗУ. ОНО ОФОРМЛЯЕТ НОВУЮ
Dialogue: 0,0:01:32.65,0:01:36.17,Caption,,0,0,0,,ПРИЧИНУ ДЛЯ ВОЙНЫ КРАСИВЫМ ШРИФТОМ. ОБРАТНОЕ ПРАВИЛО
Dialogue: 0,0:01:36.17,0:01:38.89,Caption,,0,0,0,,ДЕЙСТВУЕТ ТАК ЖЕ. РОССИЯ НЕ МОЖЕТ ЗАПИСАТЬ ВСЕ
Dialogue: 0,0:01:38.89,0:01:42.41,Caption,,0,0,0,,СВОИ ПОЖЕЛАНИЯ, ПОДВИНУТЬ БУМАГУ ЕВРОПЕ И УКАЗАТЬ ПАЛЬЦЕМ,
Dialogue: 0,0:01:42.55,0:01:45.69,Caption,,0,0,0,,ГДЕ РАСПИСАТЬСЯ. ЕВРОПЕЙСКИЕ СТРАНЫ ТОЖЕ ДОЛЖНЫ
Dialogue: 0,0:01:45.77,0:01:49.21,Caption,,0,0,0,,ПРИНЯТЬ УСЛОВИЯ, ИНАЧЕ ВМЕСТО СИСТЕМЫ БЕЗОПАСНОСТИ ПОЛУЧИТСЯ
Dialogue: 0,0:01:49.21,0:01:52.73,Caption,,0,0,0,,ПЕРЕДЫШКА, ВО ВРЕМЯ КОТОРОЙ ВСЕ ПРОСТО ПЕРЕЗАРЯДЯТ ОРУЖИЕ.
Dialogue: 0,0:01:53.24,0:01:55.21,Caption,,0,0,0,,НОРМАЛЬНАЯ ГАРАНТИЯ НАЧИНАЕТСЯ ТАМ,
Dialogue: 0,0:01:55.46,0:01:57.85,Caption,,0,0,0,,ГДЕ ОДНА СТОРОНА ПОЛУЧАЕТ ЗАЩИТУ,
Dialogue: 0,0:01:58.07,0:02:00.65,Caption,,0,0,0,,А ДРУГАЯ НЕ СЧИТАЕТ ЭТУ ЗАЩИТУ ПОДГОТОВКОЙ
Dialogue: 0,0:02:00.65,0:02:05.29,Caption,,0,0,0,,НАПАДЕНИЯ. ОДНОМУ СПОКОЙНО, ВТОРОЙ НЕ ТЯНЕТСЯ К РАКЕТЕ. НИКАКОЙ ВЫСШЕЙ
Dialogue: 0,0:02:05.29,0:02:09.37,Caption,,0,0,0,,МАТЕМАТИКИ. НО ИМЕННО ЭТА ПРОСТАЯ АРИФМЕТИКА ПО НЕВЕДОМОЙ
Dialogue: 0,0:02:09.37,0:02:12.01,Caption,,0,0,0,,ПРИЧИНЕ ОКАЗЫВАЕТСЯ НЕПОСИЛЬНОЙ ДЛЯ КАБИНЕТОВ,
Dialogue: 0,0:02:12.32,0:02:14.57,Caption,,0,0,0,,ГДЕ НА СОВЕЩАНИЕ ПРИНОСЯТ ПО ТРИ ПАПКИ И
Dialogue: 0,0:02:14.57,0:02:18.89,Caption,,0,0,0,,НИ ОДНОГО ОТВЕТА. КРУГ УЧАСТНИКОВ ПРИ ЭТОМ НАМНОГО ШИРЕ МОСКВЫ И
Dialogue: 0,0:02:18.89,0:02:22.73,Caption,,0,0,0,,КИЕВА. ЗАЩИТА НУЖНА УКРАИНЕ. ЕВРОПА ХОЧЕТ ПОНИМАТЬ,
Dialogue: 0,0:02:22.88,0:02:25.93,Caption,,0,0,0,,ЧТО ЕЙ НИЧТО НЕ УГРОЖАЕТ. РОССИЯ ТРЕБУЕТ ГАРАНТИЙ
Dialogue: 0,0:02:25.93,0:02:29.21,Caption,,0,0,0,,ДЛЯ СЕБЯ. БЕЛОРУССИЯ НАХОДИТСЯ РЯДОМ И ПОСЛЕДСТВИЯ
Dialogue: 0,0:02:29.21,0:02:32.01,Caption,,0,0,0,,ЛЮБОГО НОВОГО ПОРЯДКА ПОЛУЧИТ ОДНОЙ ИЗ ПЕРВЫХ.
Dialogue: 0,0:02:34.29,0:02:37.10,Caption,,0,0,0,,ТУРЦИЯ СОСТОИТ В НАТО, НО ДАВНО ДОКАЗАЛА,
Dialogue: 0,0:02:37.24,0:02:40.14,Caption,,0,0,0,,ЧТО СОБСТВЕННЫЕ ИНТЕРЕСЫ У НЕЁ ИМЕЮТСЯ И РАЗРЕШЕНИЯ
Dialogue: 0,0:02:40.14,0:02:42.29,Caption,,0,0,0,,БРЮССЕЛЯ НА КАЖДЫЙ ИЗ НИХ ОНА НЕ ПРОСИТ.
Dialogue: 0,0:02:42.85,0:02:47.26,Caption,,0,0,0,,КИТАЙ РАСПОЛОЖЕН НЕ В ЕВРОПЕ, ОДНАКО СПОР КРУПНЕЙШИХ ДЕРЖАВ О ВОЙСКАХ,
Dialogue: 0,0:02:47.49,0:02:50.22,Caption,,0,0,0,,РАКЕТАХ И ПРАВИЛАХ НА ОГРОМНОМ ПРОСТРАНСТВЕ ПЕКИН
Dialogue: 0,0:02:50.61,0:02:53.26,Caption,,0,0,0,,ТОЧНО НЕ СТАНЕТ СМОТРЕТЬ КАК ТРАНСЛЯЦИЮ КЕРЛИНГА.
Dialogue: 0,0:02:53.73,0:02:56.94,Caption,,0,0,0,,ВСЕ УЧАСТНИКИ ХОТЯТ БЕЗОПАСНОСТИ. ТРУДНОСТЬ В ТОМ,
Dialogue: 0,0:02:57.25,0:02:59.98,Caption,,0,0,0,,ЧТО КАЖДЫЙ МЕЧТАЕТ ЗАКАЗАТЬ ЕЁ ТОЛЬКО ДЛЯ СЕБЯ,
Dialogue: 0,0:03:00.27,0:03:04.78,Caption,,0,0,0,,А СЧЁТ ОТПРАВИТЬ СОСЕДУ. ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ ХОТЯТ ОБЯЗАТЕЛЬНО
Dialogue: 0,0:03:04.78,0:03:06.94,Caption,,0,0,0,,ПРИСУТСТВОВАТЬ ПРИ РАЗГОВОРЕ О НОВОЙ СИСТЕМЕ
Dialogue: 0,0:03:06.94,0:03:11.66,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ЧТОБЫ СООБЩИТЬ, ЧТО НОВАЯ СИСТЕМА БЕЗОПАСНОСТИ ИМ НЕ НУЖНА.
Dialogue: 0,0:03:12.25,0:03:14.70,Caption,,0,0,0,,УРСУЛА ФОН ДЕР ЛЯЙЕН ПРЕДЛАГАЕТ СНАЧАЛА ДОБИТЬСЯ
Dialogue: 0,0:03:14.70,0:03:18.38,Caption,,0,0,0,,ПРЕКРАЩЕНИЯ ОГНЯ НА УКРАИНЕ И ТОЛЬКО ПОТОМ ОБСУЖДАТЬ
Dialogue: 0,0:03:18.38,0:03:21.82,Caption,,0,0,0,,ОБЩИЕ ПРАВИЛА. ГЛАВА МИД ГЕРМАНИИ ЙОХАНН ВАДЕФУЛЬ
Dialogue: 0,0:03:21.90,0:03:23.98,Caption,,0,0,0,,ИДЁТ ЕЩЁ ДАЛЬШЕ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:03:24.28,0:03:26.46,Caption,,0,0,0,,НОВУЮ АРХИТЕКТУРУ СОЗДАВАТЬ НЕЗАЧЕМ,
Dialogue: 0,0:03:26.54,0:03:30.06,Caption,,0,0,0,,НАДО ВОССТАНОВИТЬ ПРЕЖНЮЮ. ШИКАРНЫЙ ПЛАН. СТАРАЯ
Dialogue: 0,0:03:30.14,0:03:32.78,Caption,,0,0,0,,КОНСТРУКЦИЯ ПРИВЕЛА ЕВРОПУ К КРУПНЕЙШЕМУ ВОЕННОМУ
Dialogue: 0,0:03:32.78,0:03:35.02,Caption,,0,0,0,,КОНФЛИКТУ ЗА ДЕСЯТИЛЕТИЯ, ЗНАЧИТ,
Dialogue: 0,0:03:35.25,0:03:39.82,Caption,,0,0,0,,ЕЁ НАДО АККУРАТНО ПОДНЯТЬ, ОТРЯХНУТЬ И СНОВА ПОСТАВИТЬ НА ТО ЖЕ МЕСТО.
Dialogue: 0,0:03:40.20,0:03:42.22,Caption,,0,0,0,,ЕСЛИ МОСТ РУХНУЛ ВМЕСТЕ С МАШИНАМИ,
Dialogue: 0,0:03:42.38,0:03:45.26,Caption,,0,0,0,,ГЛАВНОЕ НЕ МЕНЯТЬ ПРОЕКТ. ВДРУГ ВО ВТОРОЙ РАЗ
Dialogue: 0,0:03:45.49,0:03:51.77,Caption,,0,0,0,,ВОДИТЕЛИ ОКАЖУТСЯ ЛЕГЧЕ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ ГОДУ РОССИЯ УЖЕ
Dialogue: 0,0:03:51.77,0:03:56.81,Caption,,0,0,0,,ГОВОРИЛА О РАСШИРЕНИИ НАТО, ВООРУЖЕНИЯХ И ИНФРАСТРУКТУРЕ ВОЗЛЕ СВОИХ ГРАНИЦ.
Dialogue: 0,0:03:57.14,0:04:00.65,Caption,,0,0,0,,ЗАПАД ОТВЕТИЛ, ЧТО ПЕРЕСМАТРИВАТЬ ЭТИ ПРИНЦИПЫ НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:04:01.02,0:04:05.05,Caption,,0,0,0,,ТЕПЕРЬ ПОЗАДИ ГОДЫ ВОЙНЫ, А ИЗ ЕВРОПЫ ДОНОСИТСЯ ПРЕДЛОЖЕНИЕ ВЕРНУТЬСЯ К
Dialogue: 0,0:04:05.13,0:04:09.21,Caption,,0,0,0,,ИСХОДНЫМ НАСТРОЙКАМ. ПРЕМЬЕР НОРВЕГИИ ЙОНАС ГАР СТЁРЕ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:04:09.21,0:04:13.21,Caption,,0,0,0,,ПРИЗНАЛ, ЧТО ИЗОЛЯЦИЯ РОССИИ ПРОВАЛИЛАСЬ. ПОСЛЕДСТВИЕ ЯСНОЕ
Dialogue: 0,0:04:13.21,0:04:15.53,Caption,,0,0,0,,КОГДА ЕВРОПЕЙЦЫ НЕ РАЗГОВАРИВАЮТ С МОСКВОЙ,
Dialogue: 0,0:04:15.85,0:04:18.65,Caption,,0,0,0,,МОСКВА СЛЫШИТ ПРЕЖДЕ ВСЕГО ВАШИНГТОН. ПОЛУЧИЛОСЬ
Dialogue: 0,0:04:18.65,0:04:21.77,Caption,,0,0,0,,ИЗЯЩНО. ЕВРОПА САМА ПОДНЯЛАСЬ ИЗ СВОЕГО КРЕСЛА,
Dialogue: 0,0:04:22.01,0:04:24.97,Caption,,0,0,0,,ГРОМКО ЗАХЛОПНУЛА ДВЕРЬ, А ТЕПЕРЬ ВОЗМУЩАЕТСЯ,
Dialogue: 0,0:04:25.17,0:04:28.17,Caption,,0,0,0,,ЧТО СВОБОДНЫЙ СТУЛ ЗАНЯЛИ АМЕРИКАНЦЫ. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:04:28.49,0:04:30.97,Caption,,0,0,0,,И ПОЯВИТСЯ СПЕЦИАЛЬНАЯ КОМИССИЯ ПО РАССЛЕДОВАНИЮ
Dialogue: 0,0:04:30.97,0:04:33.69,Caption,,0,0,0,,ЗАГАДОЧНОГО ИСЧЕЗНОВЕНИЯ ЕВРОПЕЙСКОГО ВЛИЯНИЯ.
Dialogue: 0,0:04:34.17,0:04:36.65,Caption,,0,0,0,,НОРВЕЖСКИЙ ВЫВОД ПРОСТ. ХОТИТЕ УЧАСТВОВАТЬ В
Dialogue: 0,0:04:36.73,0:04:39.29,Caption,,0,0,0,,РЕЗУЛЬТАТЕ, ПРИДЁТСЯ ВЕСТИ ПРЯМОЙ ДИАЛОГ.
Dialogue: 0,0:04:39.87,0:04:42.33,Caption,,0,0,0,,ГЕРМАНИЯ В ОТВЕТ НЕ ОТКАЗЫВАЕТСЯ ОТ РАЗГОВОРА,
Dialogue: 0,0:04:42.55,0:04:45.61,Caption,,0,0,0,,НО ЗАРАНЕЕ ПРОСИТ НЕ ТРОГАТЬ ПРЕЖНИЕ ПРАВИЛА. ТО
Dialogue: 0,0:04:45.69,0:04:48.01,Caption,,0,0,0,,ЕСТЬ ДВЕРЬ ОТКРЫТЬ МОЖНО, ЗАХОДИТЬ НЕЛЬЗЯ,
Dialogue: 0,0:04:48.25,0:04:52.89,Caption,,0,0,0,,МЕБЕЛЬ ДВИГАТЬ ЗАПРЕЩЕНО, А ПОЖАР В КОМНАТЕ ПРЕДЛАГАЕТСЯ СЧИТАТЬ ОСОБЕННОСТЬЮ
Dialogue: 0,0:04:52.97,0:04:55.53,Caption,,0,0,0,,ИНТЕРЬЕРА. НА ТАКОМ ФОНЕ РУБИО ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:04:55.53,0:04:59.93,Caption,,0,0,0,,ВЫГЛЯДИТ РЕДКИМ ЧЕЛОВЕКОМ, КОТОРЫЙ РЕШИЛ ГОВОРИТЬ ЗАКОНЧЕННЫМИ ПРЕДЛОЖЕНИЯМИ.
Dialogue: 0,0:05:02.20,0:05:04.36,Caption,,0,0,0,,СОГЛАШЕНИЕ ДОЛЖНО ЗАЩИТИТЬ УКРАИНУ,
Dialogue: 0,0:05:04.59,0:05:06.60,Caption,,0,0,0,,НЕ СОЗДАВАЯ НОВОЙ УГРОЗЫ ДЛЯ РОССИИ.
Dialogue: 0,0:05:07.24,0:05:10.04,Caption,,0,0,0,,ОДНОСТОРОННЯЯ БУМАГА РАБОТАЕТ ДО ПЕРВОГО СЕРЬЁЗНОГО
Dialogue: 0,0:05:10.12,0:05:12.84,Caption,,0,0,0,,ИСПЫТАНИЯ. ПЕРЕГОВОРЫ В АБУ ДАБИ НА ЭТОМ ФОНЕ
Dialogue: 0,0:05:13.00,0:05:16.12,Caption,,0,0,0,,ОСТАЮТСЯ ВТОРЫМ ПЛАНОМ. ЗА ДВА ДНЯ УЧАСТНИКИ
Dialogue: 0,0:05:16.12,0:05:18.68,Caption,,0,0,0,,НАВЕРНЯКА УСПЕЮТ НАЗВАТЬ БЕСЕДУ ПОЛЕЗНОЙ,
Dialogue: 0,0:05:18.84,0:05:23.00,Caption,,0,0,0,,ОТКРОВЕННОЙ, СОДЕРЖАТЕЛЬНОЙ И ЛЮБЫМ ДРУГИМ ПОДХОДЯЩИМ СЛОВОМ,
Dialogue: 0,0:05:23.24,0:05:25.00,Caption,,0,0,0,,ЧТОБЫ НИКТО СЛУЧАЙНО НЕ ПОНЯЛ,
Dialogue: 0,0:05:25.08,0:05:27.96,Caption,,0,0,0,,О ЧЁМ ОНИ ДОГОВОРИЛИСЬ. ОДИН УВИДИТ ПРОГРЕСС,
Dialogue: 0,0:05:28.12,0:05:29.88,Caption,,0,0,0,,ВТОРОЙ СОХРАНИТ ПРИНЦИПИАЛЬНОСТЬ,
Dialogue: 0,0:05:30.10,0:05:33.16,Caption,,0,0,0,,ТРЕТИЙ СООБЩИТ О СБЛИЖЕНИИ ПОЗИЦИЙ. ПОБЕДЯТ ВСЕ,
Dialogue: 0,0:05:33.32,0:05:36.60,Caption,,0,0,0,,ТАБЛО ЗАРАНЕЕ ВЫДАЁТ КАЖДОМУ ПЕРВОЕ МЕСТО. НО ТОЛЬКО
Dialogue: 0,0:05:36.60,0:05:39.48,Caption,,0,0,0,,ЗА ЗАКРЫТОЙ ДВЕРЬЮ СТОРОНЫ МОГУТ МЕНЯТЬ ПОЗИЦИИ БЕЗ
Dialogue: 0,0:05:39.56,0:05:42.68,Caption,,0,0,0,,ПУБЛИЧНОЙ ПОТЕРИ ЛИЦА. НАС ДОЛЖНЫ ИНТЕРЕСОВАТЬ НЕ
Dialogue: 0,0:05:42.76,0:05:46.28,Caption,,0,0,0,,ЭТИ ЛИЦА. СМОТРИТЕ, КТО ДОБИВАЕТСЯ МЕСТА ЗА СТОЛОМ,
Dialogue: 0,0:05:46.52,0:05:49.96,Caption,,0,0,0,,КАКИЕ ТЕМЫ ПОЯВИЛИСЬ И КАКИЕ ДЕЙСТВИЯ НАЧНУТСЯ ПОСЛЕ
Dialogue: 0,0:05:50.04,0:05:52.44,Caption,,0,0,0,,АБУ ДАБИ. ФАЙНЭНШЛ ТАЙМС СООБЩАЕТ,
Dialogue: 0,0:05:52.62,0:05:55.32,Caption,,0,0,0,,ЧТО ЕВРОПА РЕШИЛА НЕ ЖДАТЬ ИТОГОВ В ПРИХОЖЕЙ.
Dialogue: 0,0:05:55.54,0:05:58.52,Caption,,0,0,0,,СОВЕТНИКИ ФРАНЦИИ, ГЕРМАНИИ И БРИТАНИИ,
Dialogue: 0,0:05:58.68,0:06:01.56,Caption,,0,0,0,,А ТАКЖЕ ПРЕДСТАВИТЕЛИ ЕВРОКОМИССИИ И НАТО ХОТЯТ
Dialogue: 0,0:06:01.56,0:06:03.88,Caption,,0,0,0,,УЧАСТВОВАТЬ В ОТДЕЛЬНЫХ ЧАСТЯХ ПЕРЕГОВОРОВ.
Dialogue: 0,0:06:04.28,0:06:07.80,Caption,,0,0,0,,ВАШИНГТОН И МОСКВА МОГУТ ЗАГОВОРИТЬ ОБ УЧЕНИЯХ НАТО,
Dialogue: 0,0:06:07.96,0:06:12.68,Caption,,0,0,0,,РАЗМЕЩЕНИИ ВОЙСК, ВООРУЖЕНИЯХ И ВОЕННОЙ ИНФРАСТРУКТУРЕ. ЕВРОПА СЧИТАЕТ
Dialogue: 0,0:06:12.76,0:06:15.32,Caption,,0,0,0,,ЭТИ ВОПРОСЫ СВОИМИ И ОЧЕНЬ НЕРВНИЧАЕТ,
Dialogue: 0,0:06:15.46,0:06:18.44,Caption,,0,0,0,,КОГДА ЕЁ СУДЬБУ ОБСУЖДАЮТ БЕЗ ЕЁ ПОДРОБНЫХ УКАЗАНИЙ.
Dialogue: 0,0:06:20.72,0:06:23.36,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ВАМ НУЖЕН РАЗБОР ПОСЛЕДСТВИЙ,
Dialogue: 0,0:06:23.60,0:06:25.84,Caption,,0,0,0,,А НЕ КОЛЛЕКЦИЯ ЦИТАТ ЗА ДЕНЬ. И НАПИШИТЕ
Dialogue: 0,0:06:25.84,0:06:30.72,Caption,,0,0,0,,В КОММЕНТАРИЯХ, ВЕРИТЕ ЛИ ВЫ, ЧТО ЕВРОПА СОГЛАСИТСЯ ОБСУЖДАТЬ САМУ СИСТЕМУ
Dialogue: 0,0:06:30.72,0:06:34.80,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ИЛИ СНОВА ПРЕДЛОЖИТ ВСЕМ ВЕРНУТЬСЯ В ИСХОДНУЮ ТОЧКУ
Dialogue: 0,0:06:34.88,0:06:39.92,Caption,,0,0,0,,И ОЧЕНЬ УДИВИТСЯ РЕЗУЛЬТАТУ. СПОР ДАВНО ВЫШЕЛ ЗА ПРЕДЕЛЫ ЛИНИИ БОЕВЫХ ДЕЙСТВИЙ.
Dialogue: 0,0:06:40.32,0:06:42.24,Caption,,0,0,0,,ГДЕ ОКАЖУТСЯ ВОЙСКА ПОСЛЕ ВОЙНЫ.
Dialogue: 0,0:06:42.82,0:06:45.76,Caption,,0,0,0,,КАКИЕ ВООРУЖЕНИЯ БУДУТ РАЗМЕЩАТЬ. ЧТО СТАНЕТ С
Dialogue: 0,0:06:45.84,0:06:48.88,Caption,,0,0,0,,УЧЕНИЯМИ НАТО. ГДЕ ДЛЯ РОССИИ ПРОХОДИТ КРАСНАЯ
Dialogue: 0,0:06:48.88,0:06:52.08,Caption,,0,0,0,,ЧЕРТА. ЧТО УКРАИНА СЧИТАЕТ ДОСТАТОЧНОЙ ЗАЩИТОЙ.
Dialogue: 0,0:06:52.40,0:06:54.88,Caption,,0,0,0,,КАКИЕ УСЛОВИЯ ЕВРОПА ГОТОВА ПРИНЯТЬ ДЛЯ СЕБЯ.
Dialogue: 0,0:06:55.49,0:06:59.92,Caption,,0,0,0,,ОТ ЭТИХ ОТВЕТОВ ЗАВИСИТ, БУДЕТ ЛИ СОГЛАШЕНИЕ ЗАВЕРШЕНИЕМ КОНФЛИКТА ИЛИ
Dialogue: 0,0:07:00.00,0:07:03.28,Caption,,0,0,0,,РАСПИСАНИЕМ СЛЕДУЮЩЕГО. ИМЕННО ЗДЕСЬ ПРЕДУПРЕЖДЕНИЕ
Dialogue: 0,0:07:03.36,0:07:06.56,Caption,,0,0,0,,РЯБКОВА ПРИОБРЕТАЕТ НАСТОЯЩИЙ СМЫСЛ. ОН ГОВОРИТ НЕ О
Dialogue: 0,0:07:06.56,0:07:08.72,Caption,,0,0,0,,ЦВЕТЕ СКАТЕРТИ В АБУ ДАБИ И НЕ О
Dialogue: 0,0:07:08.80,0:07:11.68,Caption,,0,0,0,,ПОРЯДКЕ СЛЕДУЮЩЕЙ ВСТРЕЧИ. ЕГО ПОСЛАНИЕ ЕВРОПЕ
Dialogue: 0,0:07:11.76,0:07:14.48,Caption,,0,0,0,,ЗВУЧИТ ПРЕДЕЛЬНО ПРЯМО ЕВРОПА ГОТОВИТСЯ К ВОЙНЕ,
Dialogue: 0,0:07:14.72,0:07:18.64,Caption,,0,0,0,,РОССИЯ НАПАДАТЬ НЕ НАМЕРЕНА, НО К ВОЗМОЖНОМУ СТОЛКНОВЕНИЮ ГОТОВА,
Dialogue: 0,0:07:18.82,0:07:20.80,Caption,,0,0,0,,А ОТВЕТ НА АГРЕССИЮ БУДЕТ БЫСТРЫМ.
Dialogue: 0,0:07:21.36,0:07:23.68,Caption,,0,0,0,,ВСЛЕД ЗА НИМ ВАСИЛИЙ НЕБЕНЗЯ ПРЕДУПРЕЖДАЕТ,
Dialogue: 0,0:07:23.84,0:07:26.56,Caption,,0,0,0,,ЧТО ПРЯМОЙ КОНФЛИКТ С ЕВРОПОЙ СПОСОБЕН РАЗВИВАТЬСЯ
Dialogue: 0,0:07:26.56,0:07:30.48,Caption,,0,0,0,,СТРЕМИТЕЛЬНО. ДВА ВЫСОКОПОСТАВЛЕННЫХ РОССИЙСКИХ ДИПЛОМАТА ПОЧТИ
Dialogue: 0,0:07:30.48,0:07:33.52,Caption,,0,0,0,,ОДНОВРЕМЕННО ПРОИЗНОСЯТ ОДНУ И ТУ ЖЕ ТРЕВОЖНУЮ ВЕЩЬ.
Dialogue: 0,0:07:35.80,0:07:38.92,Caption,,0,0,0,,ДО ТОЧКИ, ПОСЛЕ КОТОРОЙ РЕШЕНИЯ БУДУТ ПРИНИМАТЬ УЖЕ НЕ
Dialogue: 0,0:07:38.92,0:07:43.40,Caption,,0,0,0,,УЧАСТНИКИ ПЕРЕГОВОРОВ, МОЖНО ДОЕХАТЬ ОЧЕНЬ БЫСТРО. И ТОРМОЗНОЙ ПУТЬ У
Dialogue: 0,0:07:43.40,0:07:46.44,Caption,,0,0,0,,ЯДЕРНЫХ ДЕРЖАВ ПРОВЕРЯТЬ РУЛЕТКОЙ НИКТО НЕ ЗАХОЧЕТ.
Dialogue: 0,0:07:47.32,0:07:50.04,Caption,,0,0,0,,ВОТ ЧЕМ НЫНЕШНИЙ МОМЕНТ ОТЛИЧАЕТСЯ ОТ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:07:50.12,0:07:53.08,Caption,,0,0,0,,ДВАДЦАТЬ ПЕРВОГО ГОДА. ТОГДА СПОРИЛИ О ВОЗМОЖНЫХ
Dialogue: 0,0:07:53.08,0:07:56.12,Caption,,0,0,0,,ПОСЛЕДСТВИЯХ. ТЕПЕРЬ ТРЕБОВАНИЯ ВОЗВРАЩАЮТСЯ ПОСЛЕ
Dialogue: 0,0:07:56.12,0:07:58.28,Caption,,0,0,0,,МНОГОЛЕТНЕЙ ВОЙНЫ, С ПОГИБШИМИ,
Dialogue: 0,0:07:58.44,0:08:01.88,Caption,,0,0,0,,РАЗРУШЕНИЯМИ И НАКОПЛЕННОЙ ЗЛОБОЙ. ВОПРОСЫ ПОЧТИ ТЕ
Dialogue: 0,0:08:01.88,0:08:05.48,Caption,,0,0,0,,ЖЕ, НО ЦЕНА КАЖДОГО НЕВЕРНОГО ОТВЕТА ВЫРОСЛА ДО УРОВНЯ,
Dialogue: 0,0:08:05.80,0:08:08.36,Caption,,0,0,0,,НА КОТОРОМ ОШИБКА ПЕРЕСТАЁТ БЫТЬ МАТЕРИАЛОМ ДЛЯ
Dialogue: 0,0:08:08.36,0:08:13.32,Caption,,0,0,0,,СЛЕДУЮЩЕГО САММИТА. НАЗВАНИЕ "УЛЬТИМАТУМ ДВА НОЛЬ" ЗДЕСЬ НЕ УКРАШЕНИЕ.
Dialogue: 0,0:08:13.80,0:08:16.84,Caption,,0,0,0,,МОСКВА СНОВА ТРЕБУЕТ РАЗГОВОРА О БЕЗОПАСНОСТИ ВСЕГО
Dialogue: 0,0:08:16.84,0:08:19.32,Caption,,0,0,0,,ПРОСТРАНСТВА, О НАТО, ВОЙСКАХ,
Dialogue: 0,0:08:19.48,0:08:23.08,Caption,,0,0,0,,ВООРУЖЕНИЯХ И ИНФРАСТРУКТУРЕ. ЕВРОПА СНОВА ПЫТАЕТСЯ
Dialogue: 0,0:08:23.08,0:08:26.36,Caption,,0,0,0,,ОСТАВИТЬ ОСНОВУ ПРЕЖНЕЙ. ВАШИНГТОН ИЩЕТ ФОРМУЛУ,
Dialogue: 0,0:08:26.60,0:08:29.88,Caption,,0,0,0,,КОТОРУЮ СМОГУТ ПРИНЯТЬ ОБЕ СТОРОНЫ. УКРАИНА ТРЕБУЕТ
Dialogue: 0,0:08:29.88,0:08:35.00,Caption,,0,0,0,,ЗАЩИТЫ. БЕЛОРУССИЯ, ТУРЦИЯ И КИТАЙ НЕИЗБЕЖНО БУДУТ СЧИТАТЬ СОБСТВЕННЫЕ
Dialogue: 0,0:08:35.08,0:08:38.20,Caption,,0,0,0,,РИСКИ. В ОДНУ РАМКУ НАДО ПОМЕСТИТЬ ИНТЕРЕСЫ ТЕХ,
Dialogue: 0,0:08:38.52,0:08:42.76,Caption,,0,0,0,,КТО ГОДАМИ ДОКАЗЫВАЛ, ЧТО РАМКА ПРИНАДЛЕЖИТ ТОЛЬКО ЕМУ. А "КАРИБСКИЙ
Dialogue: 0,0:08:42.76,0:08:45.72,Caption,,0,0,0,,КРИЗИС ДВА НОЛЬ" ОПИСЫВАЕТ УЖЕ НЕ СОДЕРЖАНИЕ
Dialogue: 0,0:08:45.72,0:08:50.04,Caption,,0,0,0,,ТРЕБОВАНИЙ, А ПОЛОЖЕНИЕ МИРА У ЧЕРТЫ. ВОЕННЫЕ ВАРИАНТЫ ЗВУЧАТ
Dialogue: 0,0:08:50.04,0:08:53.16,Caption,,0,0,0,,ВСЛУХ. ДИПЛОМАТЫ ГОВОРЯТ О КОРОТКОМ КОНФЛИКТЕ ТАК,
Dialogue: 0,0:08:53.39,0:08:55.32,Caption,,0,0,0,,ЧТО ОПТИМИЗМА ЭТО НЕ ДОБАВЛЯЕТ.
Dialogue: 0,0:08:57.59,0:09:01.51,Caption,,0,0,0,,УЧАСТНИКИ ПРОДОЛЖАЮТ ВСТРЕЧИ, ОДНОВРЕМЕННО ПОКАЗЫВАЯ ДРУГ ДРУГУ,
Dialogue: 0,0:09:01.59,0:09:04.71,Caption,,0,0,0,,ЧТО ПРОИЗОЙДЁТ ПРИ ПРОВАЛЕ. МОЙ ЛИЧНЫЙ ПРОГНОЗ
Dialogue: 0,0:09:04.71,0:09:07.51,Caption,,0,0,0,,ПРЕДЕЛЬНО ЖЁСТКИЙ. ЕСЛИ ЭТОТ КРИЗИС НЕ УДАСТСЯ
Dialogue: 0,0:09:07.51,0:09:11.43,Caption,,0,0,0,,ПРЕОДОЛЕТЬ, ОН НЕИЗБЕЖНО ПЕРЕРАСТЁТ В ЯДЕРНУЮ ВОЙНУ В ЕВРОПЕ.
Dialogue: 0,0:09:11.83,0:09:13.67,Caption,,0,0,0,,НЕ В ОЧЕРЕДНОЙ ОБМЕН САНКЦИЯМИ,
Dialogue: 0,0:09:13.91,0:09:15.83,Caption,,0,0,0,,НЕ В ЕЩЁ ОДИН СПОР НА САММИТЕ,
Dialogue: 0,0:09:16.07,0:09:20.47,Caption,,0,0,0,,А В ЯДЕРНУЮ ВОЙНУ. ПОЭТОМУ ПОБЕДНЫЕ ОБЪЯВЛЕНИЯ ПОСЛЕ АБУ ДАБИ МОЖНО
Dialogue: 0,0:09:20.55,0:09:23.27,Caption,,0,0,0,,СМЕЛО СКЛАДЫВАТЬ В ОТДЕЛЬНЫЙ ЯЩИК. ПУСТЬ КАЖДЫЙ
Dialogue: 0,0:09:23.27,0:09:26.87,Caption,,0,0,0,,УЧАСТНИК РАССКАЖЕТ, КАК ТВЁРДО ОН ОТСТОЯЛ ПОЗИЦИИ И НАСКОЛЬКО
Dialogue: 0,0:09:26.87,0:09:29.99,Caption,,0,0,0,,КОНСТРУКТИВНО ПРОШЛА БЕСЕДА. ЭТО ОБЯЗАТЕЛЬНАЯ ЧАСТЬ
Dialogue: 0,0:09:29.99,0:09:33.27,Caption,,0,0,0,,ПРЕДСТАВЛЕНИЯ. К РЕАЛЬНОЙ БЕЗОПАСНОСТИ ОНА ОТНОСИТСЯ
Dialogue: 0,0:09:33.27,0:09:36.31,Caption,,0,0,0,,ПРИМЕРНО КАК МЕНЮ К ОПЛАТЕ УЖИНА ВЫГЛЯДИТ ПРИЯТНО,
Dialogue: 0,0:09:36.63,0:09:39.19,Caption,,0,0,0,,НО ПЛАТИТЬ ВСЁ РАВНО ПРИДЁТСЯ. ПРОВЕРЯТЬ НАДО
Dialogue: 0,0:09:39.19,0:09:42.55,Caption,,0,0,0,,ПОСЛЕДУЮЩИЕ ДЕЙСТВИЯ. ВОЗОБНОВИТ ЛИ ЕВРОПА ПРЯМОЙ
Dialogue: 0,0:09:42.55,0:09:45.83,Caption,,0,0,0,,РАЗГОВОР С МОСКВОЙ. ИЗМЕНИТСЯ ЛИ ОТНОШЕНИЕ К УЧЕНИЯМ
Dialogue: 0,0:09:45.83,0:09:48.63,Caption,,0,0,0,,НАТО. НАЧНУТ ЛИ ОБСУЖДАТЬ РАЗМЕЩЕНИЕ ВОЙСК И
Dialogue: 0,0:09:48.63,0:09:50.63,Caption,,0,0,0,,ВООРУЖЕНИЙ КАК ОБЩУЮ ПРОБЛЕМУ,
Dialogue: 0,0:09:50.87,0:09:53.19,Caption,,0,0,0,,А НЕ КАК ПРАВО ОДНОЙ СТОРОНЫ И НЕРВНЫЙ
Dialogue: 0,0:09:53.27,0:09:55.51,Caption,,0,0,0,,ТИК ДРУГОЙ. ПОЯВИТСЯ ЛИ РЕШЕНИЕ,
Dialogue: 0,0:09:55.83,0:10:00.39,Caption,,0,0,0,,ПРИ КОТОРОМ УКРАИНА ЗАЩИЩЕНА, РОССИЯ НЕ ВИДИТ ПОДГОТОВКИ НОВОЙ УГРОЗЫ,
Dialogue: 0,0:10:00.63,0:10:03.67,Caption,,0,0,0,,А ЕВРОПА НЕ СЧИТАЕТ РОССИЙСКИЕ ТРЕБОВАНИЯ ПОКУШЕНИЕМ
Dialogue: 0,0:10:03.75,0:10:07.11,Caption,,0,0,0,,НА СОБСТВЕННУЮ БЕЗОПАСНОСТЬ. ЕСЛИ ТАКИЕ ШАГИ НАЧНУТСЯ,
Dialogue: 0,0:10:07.50,0:10:10.95,Caption,,0,0,0,,ЗНАЧИТ, АБУ ДАБИ ДЕЙСТВИТЕЛЬНО СТАЛ НАЧАЛОМ ПЕРЕМЕН.
Dialogue: 0,0:10:13.14,0:10:17.46,Caption,,0,0,0,,ЕСЛИ УЧАСТНИКИ УЛЫБНУТСЯ, НАЗОВУТ ВСТРЕЧУ ИСТОРИЧЕСКОЙ И ПРОДОЛЖАТ ДЕЛАТЬ
Dialogue: 0,0:10:17.46,0:10:19.78,Caption,,0,0,0,,РОВНО ТО ЖЕ, ЧТО ДЕЛАЛИ ДО НЕЁ,
Dialogue: 0,0:10:20.17,0:10:22.42,Caption,,0,0,0,,ЧАСЫ ПРОСТО ПРОДОЛЖАТ ОТСЧИТЫВАТЬ ВРЕМЯ ДО
Dialogue: 0,0:10:22.42,0:10:26.82,Caption,,0,0,0,,СЛЕДУЮЩЕГО КРИЗИСА. ТОЛЬКО СЛЕДУЮЩИЙ МОЖЕТ ОКАЗАТЬСЯ НАСТОЛЬКО КОРОТКИМ,
Dialogue: 0,0:10:27.13,0:10:29.94,Caption,,0,0,0,,ЧТО ИТОГОВОЕ ЗАЯВЛЕНИЕ УЖЕ НЕКОМУ БУДЕТ ЧИТАТЬ.
Dialogue: 0,0:10:30.51,0:10:33.30,Caption,,0,0,0,,ПЯТЬ ЛЕТ НАЗАД РАЗГОВОР О НОВОЙ СИСТЕМЕ БЕЗОПАСНОСТИ
Dialogue: 0,0:10:33.30,0:10:35.54,Caption,,0,0,0,,ОТЛОЖИЛИ, СЛОВНО НЕПРИЯТНЫЙ СЧЁТ,
Dialogue: 0,0:10:35.78,0:10:38.82,Caption,,0,0,0,,КОТОРЫЙ МОЖНО СПРЯТАТЬ ПОД САЛФЕТКУ. СЧЁТ НИКУДА НЕ
Dialogue: 0,0:10:38.82,0:10:44.42,Caption,,0,0,0,,ИСЧЕЗ, К НЕМУ ДОБАВИЛИ ВОЙНУ, ПОТЕРИ И ПРОЦЕНТЫ ЗА ПРОСРОЧКУ. ТЕПЕРЬ ЕГО СНОВА
Dialogue: 0,0:10:44.42,0:10:47.38,Caption,,0,0,0,,ПРИНЕСЛИ НА СТОЛ. И ЕСЛИ ЕВРОПА ОПЯТЬ РЕШИТ,
Dialogue: 0,0:10:47.62,0:10:51.30,Caption,,0,0,0,,ЧТО СТАРАЯ СИСТЕМА ПРЕКРАСНА, А ВИНОВАТА ИСКЛЮЧИТЕЛЬНО РЕАЛЬНОСТЬ,
Dialogue: 0,0:10:51.56,0:10:53.78,Caption,,0,0,0,,РАСПЛАЧИВАТЬСЯ ПРИДЁТСЯ УЖЕ НЕ ЗАЯВЛЕНИЯМИ.
