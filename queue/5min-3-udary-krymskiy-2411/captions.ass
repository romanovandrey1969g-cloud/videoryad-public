Dialogue: 0,0:00:00.12,0:00:04.92,Caption,,0,0,0,,ЗЕЛЕНСКИЙ, ПОХОЖЕ, ОКОНЧАТЕЛЬНО ОСМЕЛЕЛ. ЕЩЁ НЕДАВНО ВОКРУГ НЕГО БЫЛО
Dialogue: 0,0:00:04.92,0:00:07.24,Caption,,0,0,0,,СТОЛЬКО РАЗГОВОРОВ О ЛИЧНОЙ БЕЗОПАСНОСТИ,
Dialogue: 0,0:00:07.54,0:00:09.56,Caption,,0,0,0,,ЧТО ВПОРУ БЫЛО НЕ ВЫСТУПЛЕНИЯ ГОТОВИТЬ,
Dialogue: 0,0:00:09.80,0:00:12.20,Caption,,0,0,0,,А ЧЕМОДАНЫ СОБИРАТЬ. А ТЕПЕРЬ СМОТРИТЕ,
Dialogue: 0,0:00:12.34,0:00:15.48,Caption,,0,0,0,,КАКОЙ БОЕВОЙ НАСТРОЙ! УГРОЗЫ ОДНА ЗА ДРУГОЙ,
Dialogue: 0,0:00:15.72,0:00:20.12,Caption,,0,0,0,,ЗАЯВЛЕНИЯ ВСЁ ГРОМЧЕ, СТАВКИ ВСЁ ВЫШЕ. И ВЕДЬ ВСЁ ЭТО ПРОИСХОДИТ
Dialogue: 0,0:00:20.12,0:00:23.08,Caption,,0,0,0,,В ОЧЕНЬ ИНТЕРЕСНЫЙ МОМЕНТ. ЧТО ЖЕ ТАКОЕ ИЗМЕНИЛОСЬ,
Dialogue: 0,0:00:23.32,0:00:25.40,Caption,,0,0,0,,ЧТО ЧЕЛОВЕК ВДРУГ ПОЧУВСТВОВАЛ СЕБЯ НАСТОЛЬКО
Dialogue: 0,0:00:25.48,0:00:28.60,Caption,,0,0,0,,УВЕРЕННО? ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ДАЛЬШЕ БУДЕТ ЕЩЁ
Dialogue: 0,0:00:28.60,0:00:32.84,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. ЗЕЛЕНСКИЙ ПОЧТИ ДВЕ НЕДЕЛИ НЕ ВОЗВРАЩАЛСЯ В КИЕВ.
Dialogue: 0,0:00:33.00,0:00:36.20,Caption,,0,0,0,,ПОТОМ ВЕРНУЛСЯ. И ТУТ СЛОВНО ТУМБЛЕР ПЕРЕКЛЮЧИЛИ.
Dialogue: 0,0:00:36.43,0:00:40.12,Caption,,0,0,0,,СНОВА КАМЕРЫ. СНОВА ЗАЯВЛЕНИЯ. СНОВА УГРОЗЫ. ПРИЧЁМ
Dialogue: 0,0:00:40.20,0:00:42.60,Caption,,0,0,0,,УЖЕ НЕ ПРОСТО В ОБЩЕЙ ФОРМЕ. КРЫМСКИЙ МОСТ
Dialogue: 0,0:00:42.60,0:00:45.24,Caption,,0,0,0,,ДОЛГО НЕ ПРОСТОИТ. ПО РОССИЙСКИМ ОБЪЕКТАМ БУДЕМ
Dialogue: 0,0:00:45.24,0:00:50.28,Caption,,0,0,0,,РАБОТАТЬ. КРЫМ НАШ, ЗНАЧИТ, ДЕЛАЕМ ТАМ ЧТО ХОТИМ. И ВСЁ ЭТО ПОЧТИ
Dialogue: 0,0:00:50.36,0:00:54.28,Caption,,0,0,0,,СРАЗУ ПОСЛЕ ТОГО, КАК ПОЯВИЛАСЬ ВЕРСИЯ О ГАРАНТИЯХ ЕГО ЛИЧНОЙ
Dialogue: 0,0:00:54.28,0:00:57.16,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ВОТ ЗДЕСЬ СЛОВО "ЛИЧНОЙ" ОЧЕНЬ ВАЖНОЕ.
Dialogue: 0,0:00:57.48,0:01:00.44,Caption,,0,0,0,,НЕ БЕЗОПАСНОСТИ КИЕВА. НЕ БЕЗОПАСНОСТИ УКРАИНСКОЙ
Dialogue: 0,0:01:00.44,0:01:03.88,Caption,,0,0,0,,ЭНЕРГЕТИКИ. НЕ БЕЗОПАСНОСТИ МОСТОВ ЧЕРЕЗ ДНЕПР. ДАЖЕ
Dialogue: 0,0:01:03.96,0:01:07.48,Caption,,0,0,0,,НЕ БЕЗОПАСНОСТИ ВСЕЙ СТРАНЫ. ЕГО СОБСТВЕННОЙ. И ЕСЛИ
Dialogue: 0,0:01:07.56,0:01:11.64,Caption,,0,0,0,,ЭТА ВЕРСИЯ ВЕРНА, ВНЕЗАПНЫЙ ПРИЛИВ ХРАБРОСТИ ВЫГЛЯДИТ УЖЕ СОВСЕМ НЕ
Dialogue: 0,0:01:11.64,0:01:15.77,Caption,,0,0,0,,ЗАГАДОЧНО. КОГДА ТЕБЕ ОБЪЯСНИЛИ,
Dialogue: 0,0:01:15.92,0:01:18.09,Caption,,0,0,0,,ЧТО ЛИЧНО ДО ТЕБЯ ПОСТАРАЮТСЯ НЕ ДОБРАТЬСЯ,
Dialogue: 0,0:01:18.42,0:01:20.89,Caption,,0,0,0,,ПОВЫШАТЬ СТАВКИ СТАНОВИТСЯ ГОРАЗДО КОМФОРТНЕЕ.
Dialogue: 0,0:01:21.21,0:01:23.77,Caption,,0,0,0,,ОСОБЕННО КОГДА СЧЁТ ЗА ЭТИ СТАВКИ ПОТОМ ПРИХОДИТ
Dialogue: 0,0:01:23.85,0:01:26.81,Caption,,0,0,0,,НЕ ТЕБЕ ДОМОЙ. НА ЭТОМ ФОНЕ ЗЕЛЕНСКИЙ СНОВА
Dialogue: 0,0:01:26.81,0:01:29.05,Caption,,0,0,0,,БЕРЁТСЯ ЗА КРЫМСКИЙ МОСТ. ОН ГОВОРИТ,
Dialogue: 0,0:01:29.28,0:01:33.61,Caption,,0,0,0,,ЧТО ПУТИН ДОЛЖЕН ПОНЯТЬ, ЧТО МОСТ ВСЁ РАВНО НЕ УСТОИТ. САМ МОСТ
Dialogue: 0,0:01:33.61,0:01:36.57,Caption,,0,0,0,,СНОВА НАЗЫВАЕТСЯ ЗАКОННОЙ ЦЕЛЬЮ. ОБЪЯСНЕНИЕ ТОЖЕ
Dialogue: 0,0:01:36.65,0:01:39.13,Caption,,0,0,0,,ЗНАКОМОЕ. КИЕВ СЧИТАЕТ КРЫМ УКРАИНСКИМ,
Dialogue: 0,0:01:39.21,0:01:43.61,Caption,,0,0,0,,ЗНАЧИТ, ПО ЭТОЙ ЛОГИКЕ, ИМЕЕТ ПРАВО ДЕЙСТВОВАТЬ ТАМ ПО СВОЕМУ УСМОТРЕНИЮ.
Dialogue: 0,0:01:44.25,0:01:46.81,Caption,,0,0,0,,В ДРУГОМ ВЫСТУПЛЕНИИ ЗЕЛЕНСКИЙ СФОРМУЛИРОВАЛ ЕЩЁ
Dialogue: 0,0:01:46.81,0:01:49.53,Caption,,0,0,0,,ПРОЩЕ. РОССИЯ БЬЁТ ПО УКРАИНСКИМ МОСТАМ,
Dialogue: 0,0:01:49.71,0:01:53.13,Caption,,0,0,0,,УКРАИНА ОТВЕЧАЕТ. ВСЁ СПРАВЕДЛИВО. ТОЛЬКО МОСКВА НА
Dialogue: 0,0:01:53.13,0:01:56.17,Caption,,0,0,0,,ЭТУ АРИФМЕТИКУ СМОТРИТ НЕСКОЛЬКО ИНАЧЕ. ПУТИН УЖЕ
Dialogue: 0,0:01:56.17,0:01:59.69,Caption,,0,0,0,,ПРЕДУПРЕДИЛ, ЧТО ЗА НОВЫЕ АТАКИ ПО КРЫМСКОМУ МОСТУ ПОСЛЕДУЕТ
Dialogue: 0,0:01:59.69,0:02:02.49,Caption,,0,0,0,,ГОРАЗДО БОЛЕЕ БОЛЕЗНЕННЫЙ ОТВЕТ. И ВОТ ТУТ
Dialogue: 0,0:02:02.49,0:02:05.21,Caption,,0,0,0,,НАЧИНАЕТСЯ ДЕЙСТВИТЕЛЬНО ИНТЕРЕСНАЯ ЧАСТЬ. ПО
Dialogue: 0,0:02:05.21,0:02:07.45,Caption,,0,0,0,,ИНФОРМАЦИИ ИСТОЧНИКА В ОФИСЕ ПРЕЗИДЕНТА,
Dialogue: 0,0:02:07.61,0:02:10.49,Caption,,0,0,0,,ПЕРЕД РЕШЕНИЕМ ПРОДОЛЖАТЬ УДАРЫ ЗЕЛЕНСКИЙ ОБСУЖДАЛ С
Dialogue: 0,0:02:10.49,0:02:13.29,Caption,,0,0,0,,ГЕНШТАБОМ СОСТОЯНИЕ УКРАИНСКИХ МОСТОВ И ПЕРЕПРАВ
Dialogue: 0,0:02:13.29,0:02:15.85,Caption,,0,0,0,,ЧЕРЕЗ ДНЕПР. ТО ЕСТЬ ВОПРОС СТАВИЛСЯ ОЧЕНЬ
Dialogue: 0,0:02:15.85,0:02:18.97,Caption,,0,0,0,,ПРАКТИЧЕСКИЙ. ЕСЛИ МОСКВА НАЧНЁТ РЕГУЛЯРНО БИТЬ ПО
Dialogue: 0,0:02:18.97,0:02:21.61,Caption,,0,0,0,,УКРАИНСКИМ ПЕРЕПРАВАМ, СКОЛЬКО ОНИ ВЫДЕРЖАТ?
Dialogue: 0,0:02:21.75,0:02:23.85,Caption,,0,0,0,,КАК ДОЛГО УДАСТСЯ СОХРАНЯТЬ ДВИЖЕНИЕ?
Dialogue: 0,0:02:24.04,0:02:28.29,Caption,,0,0,0,,СКОЛЬКО ВРЕМЕНИ ВООБЩЕ ЕСТЬ? И,
Dialogue: 0,0:02:28.45,0:02:32.69,Caption,,0,0,0,,СУДЯ ПО ЭТОЙ ВЕРСИИ, ОТВЕТ ЗЕЛЕНСКОГО УСТРОИЛ. В КИЕВЕ РЕШИЛИ,
Dialogue: 0,0:02:32.78,0:02:35.17,Caption,,0,0,0,,ЧТО ЗАПАС ВРЕМЕНИ ИМЕЕТСЯ. ЗНАЧИТ,
Dialogue: 0,0:02:35.25,0:02:37.49,Caption,,0,0,0,,МОЖНО ИДТИ ДАЛЬШЕ. БОЛЕЕ ТОГО,
Dialogue: 0,0:02:37.73,0:02:41.25,Caption,,0,0,0,,ТОТ ЖЕ ИСТОЧНИК УТВЕРЖДАЕТ, ЧТО РЕЧЬ УЖЕ ШЛА НЕ ТОЛЬКО О КРЫМСКОМ
Dialogue: 0,0:02:41.25,0:02:44.45,Caption,,0,0,0,,МОСТЕ. ЗЕЛЕНСКИЙ ЯКОБЫ ПОРУЧИЛ ГОТОВИТЬ ОПЕРАЦИИ И
Dialogue: 0,0:02:44.45,0:02:47.41,Caption,,0,0,0,,ПРОТИВ ДРУГИХ МОСТОВ НА РОССИЙСКОЙ ТЕРРИТОРИИ. ОЧЕНЬ
Dialogue: 0,0:02:47.41,0:02:50.69,Caption,,0,0,0,,БОДРАЯ КОНСТРУКЦИЯ. ЧУЖИЕ МОСТЫ СОБИРАЕМСЯ ЛОМАТЬ.
Dialogue: 0,0:02:50.92,0:02:52.93,Caption,,0,0,0,,СВОИ ЗАРАНЕЕ ПОСЧИТАЛИ И РЕШИЛИ,
Dialogue: 0,0:02:53.09,0:02:55.57,Caption,,0,0,0,,ЧТО КАКОЕ ТО ВРЕМЯ ОНИ ЕЩЁ ПРОТЯНУТ. А
Dialogue: 0,0:02:55.57,0:02:59.73,Caption,,0,0,0,,ЕСЛИ НЕ ПРОТЯНУТ? ВОТ ЗДЕСЬ ШТАБНАЯ АРИФМЕТИКА БЫСТРО ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:02:59.81,0:03:02.93,Caption,,0,0,0,,СОВЕРШЕННО БЫТОВУЮ ПРОБЛЕМУ. ПО МОСТУ ВЕДЬ МАЛО ОДИН
Dialogue: 0,0:03:02.93,0:03:05.81,Caption,,0,0,0,,РАЗ ПРОЕХАТЬ ДЛЯ КРАСИВОГО СЮЖЕТА. ПО НЕМУ КАЖДЫЙ
Dialogue: 0,0:03:05.81,0:03:08.29,Caption,,0,0,0,,ДЕНЬ ДОЛЖНЫ ИДТИ ПОЕЗДА, МАШИНЫ,
Dialogue: 0,0:03:08.37,0:03:12.21,Caption,,0,0,0,,ГРУЗЫ, СНАБЖЕНИЕ. ДАЖЕ ЕСЛИ ПРОЛЁТ НЕ РУХНУЛ В ВОДУ,
Dialogue: 0,0:03:12.53,0:03:14.69,Caption,,0,0,0,,ПОСТОЯННЫЕ УДАРЫ МОГУТ СДЕЛАТЬ НОРМАЛЬНУЮ
Dialogue: 0,0:03:14.69,0:03:17.09,Caption,,0,0,0,,ЭКСПЛУАТАЦИЮ ТАКОЙ ПЕРЕПРАВЫ ОТДЕЛЬНОЙ ГОЛОВНОЙ
Dialogue: 0,0:03:17.09,0:03:20.13,Caption,,0,0,0,,БОЛЬЮ. И ПОЭТОМУ ИСТОРИЯ С КРЫМСКИМ МОСТОМ СЕЙЧАС
Dialogue: 0,0:03:20.13,0:03:22.85,Caption,,0,0,0,,ИНТЕРЕСНА НЕ ОЧЕРЕДНОЙ УГРОЗОЙ САМА ПО СЕБЕ.
Dialogue: 0,0:03:23.16,0:03:25.73,Caption,,0,0,0,,ИНТЕРЕСЕН РАСЧЁТ. СУДЯ ПО ЭТОЙ ВЕРСИИ,
Dialogue: 0,0:03:25.97,0:03:28.21,Caption,,0,0,0,,РЕШЕНИЕ ПОВЫШАТЬ СТАВКИ ПРИНИМАЕТСЯ УЖЕ С
Dialogue: 0,0:03:28.21,0:03:32.05,Caption,,0,0,0,,ПОНИМАНИЕМ, ЧТО ОТВЕТ МОЖЕТ ПРИЙТИ ПО УКРАИНСКИМ МОСТАМ. ПРОСТО
Dialogue: 0,0:03:32.13,0:03:34.21,Caption,,0,0,0,,В КИЕВЕ СЧИТАЮТ, ЧТО ПОКА ВЫДЕРЖАТ.
Dialogue: 0,0:03:34.85,0:03:37.65,Caption,,0,0,0,,А ТЕПЕРЬ ЕЩЁ РАЗ ВСПОМНИМ НАЧАЛО. ДЛЯ СОБСТВЕННОЙ
Dialogue: 0,0:03:37.65,0:03:40.37,Caption,,0,0,0,,БЕЗОПАСНОСТИ ЗЕЛЕНСКИЙ, ПО ОДНОЙ ИЗ ВЕРСИЙ,
Dialogue: 0,0:03:40.51,0:03:46.97,Caption,,0,0,0,,УЖЕ ПОЛУЧИЛ ГАРАНТИИ. ДЛЯ МОСТОВ ЧЕРЕЗ ДНЕПР ПОКА ЕСТЬ РАСЧЁТЫ. РАЗНИЦА
Dialogue: 0,0:03:47.05,0:03:50.01,Caption,,0,0,0,,ВСЁ ТАКИ СУЩЕСТВЕННАЯ. ТЕМ ВРЕМЕНЕМ РОССИЙСКИЕ УДАРЫ
Dialogue: 0,0:03:50.09,0:03:52.97,Caption,,0,0,0,,ПО УКРАИНЕ ПРОДОЛЖАЮТСЯ. РОССИЙСКОЕ МИНИСТЕРСТВО
Dialogue: 0,0:03:53.05,0:03:55.45,Caption,,0,0,0,,ОБОРОНЫ СООБЩИЛО ОБ УДАРЕ ПО МЕСТУ СОВЕЩАНИЯ
Dialogue: 0,0:03:55.45,0:03:57.61,Caption,,0,0,0,,ВЫСОКОПОСТАВЛЕННЫХ ПРЕДСТАВИТЕЛЕЙ УКРАИНСКОГО
Dialogue: 0,0:03:57.61,0:04:00.89,Caption,,0,0,0,,КОМАНДОВАНИЯ И ВОЕННО ПРОМЫШЛЕННОГО КОМПЛЕКСА. ТАМ
Dialogue: 0,0:04:00.89,0:04:05.45,Caption,,0,0,0,,ЖЕ, КАК УТВЕРЖДАЕТСЯ, НАХОДИЛИСЬ ИНОСТРАННЫЕ СПЕЦИАЛИСТЫ. ЕСЛИ ЗАЯВЛЕННЫЙ
Dialogue: 0,0:04:05.45,0:04:08.01,Caption,,0,0,0,,СОСТАВ УЧАСТНИКОВ СООТВЕТСТВУЕТ ДЕЙСТВИТЕЛЬНОСТИ,
Dialogue: 0,0:04:08.33,0:04:10.89,Caption,,0,0,0,,ЭТО УЖЕ НЕ ПРОСТО ОЧЕРЕДНОЙ СКЛАД ИЛИ РЕМОНТНАЯ
Dialogue: 0,0:04:10.89,0:04:13.69,Caption,,0,0,0,,ПЛОЩАДКА. В ОДНОМ МЕСТЕ СХОДЯТСЯ ЛЮДИ,
Dialogue: 0,0:04:13.77,0:04:15.69,Caption,,0,0,0,,КОТОРЫЕ ПРИНИМАЮТ ВОЕННЫЕ РЕШЕНИЯ,
Dialogue: 0,0:04:16.01,0:04:18.41,Caption,,0,0,0,,ЛЮДИ, КОТОРЫЕ ОБЕСПЕЧИВАЮТ ПРОИЗВОДСТВО,
Dialogue: 0,0:04:18.58,0:04:22.89,Caption,,0,0,0,,И ИНОСТРАННЫЕ СПЕЦИАЛИСТЫ. ПРИ ЭТОМ РОССИЙСКОЕ ВЕДОМСТВО НЕ НАЗВАЛО ВСЕХ
Dialogue: 0,0:04:22.89,0:04:24.97,Caption,,0,0,0,,УЧАСТНИКОВ И НЕ РАСКРЫЛО ПОДРОБНОСТЕЙ,
Dialogue: 0,0:04:25.13,0:04:27.61,Caption,,0,0,0,,КОТОРЫЕ ПОЗВОЛИЛИ БЫ СУДИТЬ О РЕЗУЛЬТАТАХ УДАРА.
Dialogue: 0,0:04:27.89,0:04:30.57,Caption,,0,0,0,,КОНКРЕТНОГО ПОДТВЕРЖДЁННОГО ПЕРЕЧНЯ ФАМИЛИЙ НЕТ.
Dialogue: 0,0:04:30.92,0:04:33.21,Caption,,0,0,0,,ОДНОВРЕМЕННО СООБЩАЛОСЬ ОБ УДАРАХ ПО ВОЕННЫМ
Dialogue: 0,0:04:33.21,0:04:36.09,Caption,,0,0,0,,АЭРОДРОМАМ, ОБЪЕКТАМ ЭНЕРГЕТИЧЕСКОЙ И ТРАНСПОРТНОЙ
Dialogue: 0,0:04:36.09,0:04:40.17,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ, ПРОИЗВОДСТВУ И ХРАНЕНИЮ БЕСПИЛОТНИКОВ И БЕЗЭКИПАЖНЫХ
Dialogue: 0,0:04:40.17,0:04:43.05,Caption,,0,0,0,,КАТЕРОВ, А ТАКЖЕ ПО МЕСТАМ РАЗМЕЩЕНИЯ УКРАИНСКИХ
Dialogue: 0,0:04:43.05,0:04:45.77,Caption,,0,0,0,,ПОДРАЗДЕЛЕНИЙ И ИНОСТРАННЫХ ВОЕННОСЛУЖАЩИХ В СТА
Dialogue: 0,0:04:45.77,0:04:49.05,Caption,,0,0,0,,СОРОКА ВОСЬМИ РАЙОНАХ. ОТДЕЛЬНЫЙ ЭПИЗОД ПРОИЗОШЁЛ ВО
Dialogue: 0,0:04:49.05,0:04:54.52,Caption,,0,0,0,,ЛЬВОВЕ. НА ВИДЕО ПОПАЛ МОМЕНТ ПРЕДПОЛАГАЕМОГО УДАРА РАКЕТЫ
Dialogue: 0,0:04:54.52,0:04:57.32,Caption,,0,0,0,,ХА СТО ОДИН В РАЙОНЕ АВИАЦИОННО РЕМОНТНОГО ЗАВОДА
Dialogue: 0,0:04:57.40,0:05:00.36,Caption,,0,0,0,,И СТАНЦИИ СКНИЛОВ. РОССИЙСКАЯ СТОРОНА СВЯЗЫВАЕТ
Dialogue: 0,0:05:00.36,0:05:02.92,Caption,,0,0,0,,ПРЕДПРИЯТИЕ С ПРОИЗВОДСТВОМ СРАЗУ НЕСКОЛЬКИХ СИСТЕМ
Dialogue: 0,0:05:02.92,0:05:05.73,Caption,,0,0,0,,ВООРУЖЕНИЙ. УПОМИНАЮТСЯ ОПЕРАТИВНО ТАКТИЧЕСКИЕ
Dialogue: 0,0:05:05.73,0:05:08.12,Caption,,0,0,0,,РАКЕТЫ, КРЫЛАТЫЕ РАКЕТЫ "ФЛАМИНГО",
Dialogue: 0,0:05:08.36,0:05:11.24,Caption,,0,0,0,,А ТАКЖЕ БЕСПИЛОТНИКИ СРЕДНЕЙ И БОЛЬШОЙ ДАЛЬНОСТИ. И
Dialogue: 0,0:05:11.24,0:05:15.96,Caption,,0,0,0,,ЗДЕСЬ УЖЕ ХОРОШО ВИДНО, КУДА СМЕЩАЕТСЯ БОРЬБА. НЕДОСТАТОЧНО СБИТЬ ГОТОВУЮ
Dialogue: 0,0:05:15.96,0:05:18.52,Caption,,0,0,0,,РАКЕТУ. МОЖНО ПОПЫТАТЬСЯ УДАРИТЬ ТУДА,
Dialogue: 0,0:05:18.76,0:05:20.68,Caption,,0,0,0,,ГДЕ СОБИРАЮТСЯ ИЗГОТОВИТЬ СЛЕДУЮЩУЮ.
Dialogue: 0,0:05:21.24,0:05:24.20,Caption,,0,0,0,,КИЕВ НАРАЩИВАЕТ ДАЛЬНОБОЙНЫЕ ВОЗМОЖНОСТИ. МОСКВА
Dialogue: 0,0:05:24.20,0:05:26.52,Caption,,0,0,0,,СТАРАЕТСЯ БИТЬ ПО ПРОИЗВОДСТВЕННОЙ БАЗЕ ЭТИХ
Dialogue: 0,0:05:26.52,0:05:29.40,Caption,,0,0,0,,ВОЗМОЖНОСТЕЙ. ОБЫЧНАЯ ПРОМЫШЛЕННОСТЬ ВСЁ ГЛУБЖЕ
Dialogue: 0,0:05:29.40,0:05:33.88,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ЧАСТЬ ФРОНТА. ВО ВРЕМЯ РОССИЙСКОЙ АТАКИ В КИЕВЕ ПОСТРАДАЛО И
Dialogue: 0,0:05:33.88,0:05:36.76,Caption,,0,0,0,,ЗДАНИЕ ПОСОЛЬСТВА НИДЕРЛАНДОВ. ПОВРЕЖДЕНИЯ БЫЛИ
Dialogue: 0,0:05:36.76,0:05:40.68,Caption,,0,0,0,,НЕЗНАЧИТЕЛЬНЫМИ, СОТРУДНИКИ НЕ ПОСТРАДАЛИ. И ВОТ НА ЭТОМ ФОНЕ
Dialogue: 0,0:05:40.68,0:05:43.56,Caption,,0,0,0,,ПРОИСХОДИТ ИСТОРИЯ УЖЕ СОВСЕМ В ДРУГОМ КОНЦЕ КАРТЫ.
Dialogue: 0,0:05:44.05,0:05:47.00,Caption,,0,0,0,,В БЕНГАЗИ ПОСЛЕ АТАКИ ПОЯВИЛИСЬ СООБЩЕНИЯ О ТЯЖЁЛОМ
Dialogue: 0,0:05:47.00,0:05:49.16,Caption,,0,0,0,,ПОРАЖЕНИИ РОССИЙСКОГО КОРВЕТА "МЕРКУРИЙ",
Dialogue: 0,0:05:49.40,0:05:52.60,Caption,,0,0,0,,ВПЛОТЬ ДО ЕГО ПРАКТИЧЕСКИ ПОЛНОЙ ПОТЕРИ. ПАРАЛЛЕЛЬНО
Dialogue: 0,0:05:52.60,0:05:55.00,Caption,,0,0,0,,СООБЩАЛОСЬ ОБ АТАКЕ НА КОММЕРЧЕСКОЕ СУДНО ПОД
Dialogue: 0,0:05:55.00,0:05:59.16,Caption,,0,0,0,,МАЛЬТИЙСКИМ ФЛАГОМ, ГДЕ ПОСТРАДАЛИ НЕ МЕНЕЕ ДЕСЯТИ ЧЕЛОВЕК. В ОДНОМ
Dialogue: 0,0:05:59.16,0:06:01.72,Caption,,0,0,0,,ИЗ СООБЩЕНИЙ НАПАДЕНИЕ СВЯЗЫВАЮТ С УКРАИНСКИМ
Dialogue: 0,0:06:01.72,0:06:08.09,Caption,,0,0,0,,МОРСКИМ БЕСПИЛОТНИКОМ. УЧАСТНИКИ ВСЕХ АТАК ДОСТОВЕРНО НЕ УСТАНОВЛЕНЫ. НО
Dialogue: 0,0:06:08.17,0:06:10.89,Caption,,0,0,0,,ЗДЕСЬ ВАЖНЕЕ МОМЕНТ НАПАДЕНИЯ. РОССИЯ,
Dialogue: 0,0:06:10.97,0:06:13.61,Caption,,0,0,0,,США И КИТАЙ ТОЛЬКО ЧТО ПРОВЕЛИ ВСТРЕЧУ И
Dialogue: 0,0:06:13.61,0:06:16.41,Caption,,0,0,0,,ПРИНЯЛИ ДЕКЛАРАЦИЮ О СТРЕМЛЕНИИ ИЗБЕЖАТЬ ЯДЕРНОГО
Dialogue: 0,0:06:16.41,0:06:19.85,Caption,,0,0,0,,СТОЛКНОВЕНИЯ. И ПРАКТИЧЕСКИ СРАЗУ ПОЯВЛЯЕТСЯ НОВЫЙ
Dialogue: 0,0:06:19.85,0:06:22.65,Caption,,0,0,0,,СЕРЬЁЗНЫЙ РАЗДРАЖИТЕЛЬ ДЛЯ МОСКВЫ. ЕСТЬ ОСТРАЯ
Dialogue: 0,0:06:22.65,0:06:24.73,Caption,,0,0,0,,ВЕРСИЯ ЗЕЛЕНСКОМУ И ВНЕШНИМ СИЛАМ,
Dialogue: 0,0:06:24.81,0:06:27.29,Caption,,0,0,0,,ЗАИНТЕРЕСОВАННЫМ В СРЫВЕ СБЛИЖЕНИЯ МОСКВЫ,
Dialogue: 0,0:06:27.45,0:06:31.37,Caption,,0,0,0,,ВАШИНГТОНА И ПЕКИНА, НУЖЕН РЕЗКИЙ РОССИЙСКИЙ ОТВЕТ. ТАКОЙ,
Dialogue: 0,0:06:31.69,0:06:33.93,Caption,,0,0,0,,ПОСЛЕ КОТОРОГО ВМЕСТО ДАЛЬНЕЙШИХ ПЕРЕГОВОРОВ
Dialogue: 0,0:06:33.93,0:06:36.89,Caption,,0,0,0,,ПРИДЁТСЯ ТУШИТЬ НОВЫЙ КРИЗИС. В ЭТОЙ ЖЕ СВЯЗИ
Dialogue: 0,0:06:36.89,0:06:39.29,Caption,,0,0,0,,ВОЗНИКАЕТ ВОПРОС О ДОПОРОГОВОЙ ЭСКАЛАЦИИ НА
Dialogue: 0,0:06:39.29,0:06:43.93,Caption,,0,0,0,,ЕВРОПЕЙСКОМ НАПРАВЛЕНИИ, ВКЛЮЧАЯ ЧУВСТВИТЕЛЬНУЮ ТЕМУ КАЛИНИНГРАДА. И ВОТ ЧТО
Dialogue: 0,0:06:43.93,0:06:47.05,Caption,,0,0,0,,ИНТЕРЕСНО. МЕСТНЫЕ СИЛЫ СООБЩИЛИ О ПЕРЕХВАТЕ БОЛЕЕ
Dialogue: 0,0:06:47.13,0:06:48.81,Caption,,0,0,0,,ДВАДЦАТИ МОРСКИХ БЕСПИЛОТНИКОВ,
Dialogue: 0,0:06:49.13,0:06:51.85,Caption,,0,0,0,,НО РОССИЙСКИЙ КОРАБЛЬ ВСЁ РАВНО ОКАЗАЛСЯ ПОД ТЯЖЁЛЫМ
Dialogue: 0,0:06:51.85,0:06:54.57,Caption,,0,0,0,,УДАРОМ. ПРИЧЁМ ДАЛЕКО ОТ ОСНОВНОЙ ЗОНЫ БОЕВЫХ
Dialogue: 0,0:06:54.57,0:06:57.93,Caption,,0,0,0,,ДЕЙСТВИЙ. ТЕПЕРЬ ВОЗМОЖНЫЙ ОТВЕТ МОСКВЫ БУДУТ ОЦЕНИВАТЬ НЕ
Dialogue: 0,0:06:57.93,0:07:01.77,Caption,,0,0,0,,ТОЛЬКО ЕЁ ПРОТИВНИКИ, НО И ПАРТНЁРЫ В ВАШИНГТОНЕ И ПЕКИНЕ. А
Dialogue: 0,0:07:01.85,0:07:04.81,Caption,,0,0,0,,ПОЧТИ ОДНОВРЕМЕННО КИЕВ И ЛОНДОН ОБЪЯВЛЯЮТ ЕЩЁ ОБ
Dialogue: 0,0:07:04.81,0:07:07.93,Caption,,0,0,0,,ОДНОМ ШАГЕ. УКРАИНСКИЕ УДАРНЫЕ БЕСПИЛОТНИКИ СРЕДНЕЙ
Dialogue: 0,0:07:07.93,0:07:09.69,Caption,,0,0,0,,И БОЛЬШОЙ ДАЛЬНОСТИ БУДУТ ПРОИЗВОДИТЬ В
Dialogue: 0,0:07:09.69,0:07:12.81,Caption,,0,0,0,,ВЕЛИКОБРИТАНИИ. РАЗРАБОТКА УКРАИНСКАЯ. ПРОИЗВОДСТВО
Dialogue: 0,0:07:12.81,0:07:16.09,Caption,,0,0,0,,БРИТАНСКОЕ. ДЕНЬГИ ТОЖЕ БРИТАНСКИЕ. ЛОГИКА ПОНЯТНА.
Dialogue: 0,0:07:18.38,0:07:20.86,Caption,,0,0,0,,УКРАИНСКИЕ ПРЕДПРИЯТИЯ НАХОДЯТСЯ ПОД ПОСТОЯННОЙ
Dialogue: 0,0:07:20.86,0:07:23.58,Caption,,0,0,0,,УГРОЗОЙ РОССИЙСКИХ УДАРОВ. ЗАВОД В БРИТАНИИ ОТ
Dialogue: 0,0:07:23.66,0:07:25.90,Caption,,0,0,0,,РОССИЙСКОЙ РАКЕТЫ ЗАЩИЩЁН НЕСКОЛЬКО ЛУЧШЕ,
Dialogue: 0,0:07:26.14,0:07:28.70,Caption,,0,0,0,,ЧЕМ ЗАВОД ПОД ЛЬВОВОМ. НО ВМЕСТЕ С ЗАВОДОМ
Dialogue: 0,0:07:28.78,0:07:31.50,Caption,,0,0,0,,ЗА ПРЕДЕЛЫ УКРАИНЫ УХОДИТ И ЧАСТЬ САМОГО ВОЕННОГО
Dialogue: 0,0:07:31.50,0:07:34.30,Caption,,0,0,0,,ПРОИЗВОДСТВА. ТО ЕСТЬ УКРАИНА ПОЛУЧАЕТ ВОЗМОЖНОСТЬ
Dialogue: 0,0:07:34.30,0:07:37.02,Caption,,0,0,0,,ВЫПУСКАТЬ ВООРУЖЕНИЕ НА ТЕРРИТОРИИ ГОСУДАРСТВА НАТО,
Dialogue: 0,0:07:37.26,0:07:40.06,Caption,,0,0,0,,ИСПОЛЬЗУЯ ЕГО ПРОМЫШЛЕННОСТЬ И ФИНАНСИРОВАНИЕ. ЭТО
Dialogue: 0,0:07:40.06,0:07:42.62,Caption,,0,0,0,,НИКАК НЕ ДОКАЗЫВАЕТ СВЯЗЬ БРИТАНИИ С НАПАДЕНИЕМ В
Dialogue: 0,0:07:42.70,0:07:46.14,Caption,,0,0,0,,БЕНГАЗИ. НО ПОКАЗЫВАЕТ ДРУГУЮ ТЕНДЕНЦИЮ. ГЕОГРАФИЯ
Dialogue: 0,0:07:46.22,0:07:48.70,Caption,,0,0,0,,УКРАИНСКОЙ ВОЕННОЙ ПРОМЫШЛЕННОСТИ СТАНОВИТСЯ ШИРЕ
Dialogue: 0,0:07:48.70,0:07:51.10,Caption,,0,0,0,,САМОЙ УКРАИНЫ. А ПОКА СТРОЯТСЯ НОВЫЕ
Dialogue: 0,0:07:51.10,0:07:55.26,Caption,,0,0,0,,ПРОИЗВОДСТВЕННЫЕ ЦЕПОЧКИ, НА ФРОНТЕ ВНЕЗАПНО СТАНОВИТСЯ ДЕФИЦИТОМ СОВСЕМ
Dialogue: 0,0:07:55.26,0:07:58.54,Caption,,0,0,0,,ДРУГАЯ ВЕЩЬ. ОБЫЧНОЕ ОПТОВОЛОКНО. ЕЩЁ ВЕСНОЙ
Dialogue: 0,0:07:58.54,0:08:00.94,Caption,,0,0,0,,КИЛОМЕТР КАЧЕСТВЕННОГО КАБЕЛЯ СТОИЛ ОКОЛО ЧЕТЫРЁХ
Dialogue: 0,0:08:00.94,0:08:04.14,Caption,,0,0,0,,ДОЛЛАРОВ. ТЕПЕРЬ ПОЧТИ ТРИДЦАТЬ. РОСТ БОЛЬШЕ ЧЕМ В
Dialogue: 0,0:08:04.14,0:08:07.66,Caption,,0,0,0,,ШЕСТЬ РАЗ. ОСНОВНЫМ ПОСТАВЩИКОМ ОСТАЁТСЯ КИТАЙ. И ЗА
Dialogue: 0,0:08:07.66,0:08:10.22,Caption,,0,0,0,,ОДИН И ТОТ ЖЕ ТОВАР ТЕПЕРЬ КОНКУРИРУЮТ МОСКВА,
Dialogue: 0,0:08:10.30,0:08:12.54,Caption,,0,0,0,,КИЕВ И ЕЩЁ ОДИН ОГРОМНЫЙ ПОТРЕБИТЕЛЬ,
Dialogue: 0,0:08:12.78,0:08:15.58,Caption,,0,0,0,,КОТОРЫЙ ВООБЩЕ К ФРОНТУ ОТНОШЕНИЯ НЕ ИМЕЕТ. ЦЕНТРЫ
Dialogue: 0,0:08:15.58,0:08:17.90,Caption,,0,0,0,,ОБРАБОТКИ ДАННЫХ ДЛЯ ИСКУССТВЕННОГО ИНТЕЛЛЕКТА.
Dialogue: 0,0:08:18.22,0:08:20.70,Caption,,0,0,0,,КРАСИВО ПОЛУЧИЛОСЬ. ОДНИ ПОКУПАЮТ КАБЕЛЬ,
Dialogue: 0,0:08:20.78,0:08:26.17,Caption,,0,0,0,,ЧТОБЫ УЧИТЬ НЕЙРОСЕТИ. ДРУГИЕ ПОКУПАЮТ ТОТ ЖЕ КАБЕЛЬ,
Dialogue: 0,0:08:26.41,0:08:28.89,Caption,,0,0,0,,ЧТОБЫ БЕСПИЛОТНИК НЕЛЬЗЯ БЫЛО ЗАГЛУШИТЬ СРЕДСТВАМИ
Dialogue: 0,0:08:28.89,0:08:32.09,Caption,,0,0,0,,РАДИОЭЛЕКТРОННОЙ БОРЬБЫ. РОССИЙСКИЕ ПРОИЗВОДИТЕЛИ,
Dialogue: 0,0:08:32.27,0:08:36.49,Caption,,0,0,0,,ПО ДАННЫМ ИСТОЧНИКА, ИМЕЮТ ЗДЕСЬ ЗАМЕТНОЕ ПРЕИМУЩЕСТВО. ОНИ ЗАКУПАЮТ
Dialogue: 0,0:08:36.49,0:08:39.77,Caption,,0,0,0,,КРУПНЫЕ ПАРТИИ НАПРЯМУЮ У КИТАЙСКИХ КОМПАНИЙ. НА
Dialogue: 0,0:08:39.77,0:08:42.65,Caption,,0,0,0,,УКРАИНЕ РЫНОК РАЗБИТ МЕЖДУ МНОЖЕСТВОМ ПРЕДПРИЯТИЙ И
Dialogue: 0,0:08:42.65,0:08:45.93,Caption,,0,0,0,,ПОСРЕДНИКОВ. А КОГДА ТОВАР ДОРОЖАЕТ В НЕСКОЛЬКО РАЗ,
Dialogue: 0,0:08:46.17,0:08:48.97,Caption,,0,0,0,,ЛИШНЕЕ ЗВЕНО В ЦЕПОЧКЕ ВНЕЗАПНО СТАНОВИТСЯ ОЧЕНЬ
Dialogue: 0,0:08:49.05,0:08:51.85,Caption,,0,0,0,,ДОРОГИМ УДОВОЛЬСТВИЕМ. ОСНОВАТЕЛЬ УКРАИНСКОЙ TAF
Dialogue: 0,0:08:51.86,0:08:55.13,Caption,,0,0,0,,INDUSTRIES АЛЕКСАНДР ЯКОВЕНКО ОЦЕНИВАЕТ СТОИМОСТЬ
Dialogue: 0,0:08:55.13,0:08:58.09,Caption,,0,0,0,,ОПТОВОЛОКНА ДЛЯ ОДНОГО БЕСПИЛОТНИКА УЖЕ ДО ТЫСЯЧИ
Dialogue: 0,0:08:58.09,0:09:01.29,Caption,,0,0,0,,ДОЛЛАРОВ. ТЫСЯЧА ДОЛЛАРОВ ТОЛЬКО ЗА КАБЕЛЬ. И
Dialogue: 0,0:09:01.29,0:09:03.77,Caption,,0,0,0,,НЕКОТОРЫЕ ПРОИЗВОДИТЕЛИ НАЧИНАЮТ СНОВА СМОТРЕТЬ В
Dialogue: 0,0:09:03.77,0:09:06.49,Caption,,0,0,0,,СТОРОНУ БЕСПРОВОДНОГО УПРАВЛЕНИЯ. НЕ ПОТОМУ ЧТО ОНО
Dialogue: 0,0:09:06.49,0:09:09.45,Caption,,0,0,0,,ВНЕЗАПНО СТАЛО ЛУЧШЕ. ПОТОМУ ЧТО ХОРОШЕЕ РЕШЕНИЕ
Dialogue: 0,0:09:09.53,0:09:12.49,Caption,,0,0,0,,СТАЛО СЛИШКОМ ДОРОГИМ. А РОССИЯ ТЕМ ВРЕМЕНЕМ НАЧАЛА
Dialogue: 0,0:09:12.49,0:09:15.77,Caption,,0,0,0,,ШИРЕ ПРИМЕНЯТЬ ОПТОВОЛОКОННЫЕ "МОЛНИИ". ПО СЛОВАМ
Dialogue: 0,0:09:15.77,0:09:18.01,Caption,,0,0,0,,УКРАИНСКОГО СПЕЦИАЛИСТА СЕРГЕЯ БЕСКРЕСТНОВА,
Dialogue: 0,0:09:18.33,0:09:20.81,Caption,,0,0,0,,ЭТИ АППАРАТЫ УЖЕ ПОЯВЛЯЮТСЯ СРАЗУ НА НЕСКОЛЬКИХ
Dialogue: 0,0:09:20.81,0:09:23.77,Caption,,0,0,0,,НАПРАВЛЕНИЯХ. ДАЛЬНОСТЬ ПРОНИКНОВЕНИЯ ДО ТРИДЦАТИ
Dialogue: 0,0:09:23.85,0:09:26.49,Caption,,0,0,0,,КИЛОМЕТРОВ. ВЫСОТА ОКОЛО ПЯТИДЕСЯТИ МЕТРОВ.
Dialogue: 0,0:09:26.81,0:09:29.13,Caption,,0,0,0,,РАДИОКАНАЛА УПРАВЛЕНИЯ НЕТ. ЗНАЧИТ,
Dialogue: 0,0:09:29.24,0:09:31.69,Caption,,0,0,0,,ОБЫЧНОЕ РАДИОПОДАВЛЕНИЕ ЗДЕСЬ ПРОСТО НЕ ЗА ЧТО
Dialogue: 0,0:09:31.69,0:09:36.37,Caption,,0,0,0,,ХВАТАТЬ. ТАКОЙ АППАРАТ МОЖЕТ ИДТИ НИЗКО,
Dialogue: 0,0:09:36.53,0:09:39.17,Caption,,0,0,0,,ПЕРЕДАВАТЬ ИЗОБРАЖЕНИЕ И ВЕСТИ РАЗВЕДКУ ПРЯМО ВО
Dialogue: 0,0:09:39.17,0:09:42.05,Caption,,0,0,0,,ВРЕМЯ ПОЛЁТА. ПРИЧЁМ САМА ТЕХНОЛОГИЯ НЕ НОВАЯ.
Dialogue: 0,0:09:42.37,0:09:45.33,Caption,,0,0,0,,ИСПЫТАНИЯ ПОДОБНЫХ РЕШЕНИЙ ОТМЕЧАЛИСЬ ЕЩЁ ГОД НАЗАД.
Dialogue: 0,0:09:45.65,0:09:48.37,Caption,,0,0,0,,ИЗМЕНИЛОСЬ ДРУГОЕ. ТЕПЕРЬ РЕЧЬ ИДЁТ УЖЕ НЕ ОБ
Dialogue: 0,0:09:48.37,0:09:52.37,Caption,,0,0,0,,ОТДЕЛЬНОМ ЭКСПЕРИМЕНТЕ, А О БОЛЕЕ ШИРОКОМ ПРИМЕНЕНИИ. ТО ЕСТЬ ИНОГДА
Dialogue: 0,0:09:52.37,0:09:55.01,Caption,,0,0,0,,ПРЕИМУЩЕСТВО НА ФРОНТЕ НАЧИНАЕТСЯ НЕ С ГЕНИАЛЬНОГО
Dialogue: 0,0:09:55.01,0:09:59.17,Caption,,0,0,0,,КОНСТРУКТОРА. А С ТОГО, КТО РАНЬШЕ ПОЗВОНИЛ КИТАЙСКОМУ ПОСТАВЩИКУ И
Dialogue: 0,0:09:59.17,0:10:01.89,Caption,,0,0,0,,ЗАБРОНИРОВАЛ БОЛЬШУЮ ПАРТИЮ КАБЕЛЯ. КСТАТИ,
Dialogue: 0,0:10:02.13,0:10:06.45,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ, ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ ДЕТАЛИ. ПОТОМУ ЧТО ИМЕННО
Dialogue: 0,0:10:06.53,0:10:08.53,Caption,,0,0,0,,В НИХ ИНОГДА ПРЯЧЕТСЯ ОТВЕТ НА ВОПРОС,
Dialogue: 0,0:10:08.84,0:10:11.49,Caption,,0,0,0,,ПОЧЕМУ ОДНА СТОРОНА ВНЕЗАПНО ПОЛУЧАЕТ НОВУЮ
Dialogue: 0,0:10:11.49,0:10:15.01,Caption,,0,0,0,,ВОЗМОЖНОСТЬ, А ДРУГАЯ НАЧИНАЕТ ИСКАТЬ ЗАМЕНУ. И ЧТОБЫ
Dialogue: 0,0:10:15.01,0:10:19.09,Caption,,0,0,0,,ОКОНЧАТЕЛЬНО НЕ ПОВЕРИТЬ, БУДТО СОВРЕМЕННАЯ ВОЙНА ТЕПЕРЬ СОСТОИТ ТОЛЬКО ИЗ
Dialogue: 0,0:10:19.17,0:10:21.25,Caption,,0,0,0,,ДРОНОВ, КАБЕЛЕЙ И ЭЛЕКТРОНИКИ,
Dialogue: 0,0:10:21.57,0:10:24.21,Caption,,0,0,0,,ПОСМОТРИМ НА КУПЯНСК. ОПЕРАЦИЯ "ВЕЛЕС".
Dialogue: 0,0:10:24.84,0:10:27.57,Caption,,0,0,0,,УКРАИНСКИЕ ВОЕННОСЛУЖАЩИЕ, ПО СООБЩЕНИЮ CNN,
Dialogue: 0,0:10:27.82,0:10:30.45,Caption,,0,0,0,,ПРОШЛИ БОЛЬШЕ ПЯТНАДЦАТИ КИЛОМЕТРОВ ПО СТАРОМУ
Dialogue: 0,0:10:30.45,0:10:33.33,Caption,,0,0,0,,ГАЗОПРОВОДУ. ПРИЧЁМ СЛОВО "ПРОШЛИ" ЗДЕСЬ ДОВОЛЬНО
Dialogue: 0,0:10:33.33,0:10:38.05,Caption,,0,0,0,,УСЛОВНОЕ. МЕСТА БЫЛО СТОЛЬКО, ЧТО ЧАСТЬ МАРШРУТА ПРИХОДИЛОСЬ ПРЕОДОЛЕВАТЬ ЛЁЖА.
Dialogue: 0,0:10:38.34,0:10:41.01,Caption,,0,0,0,,ДЛЯ ПОДГОТОВКИ ЛЮДЕЙ ЗАРАНЕЕ ТРЕНИРОВАЛИ В ШАХТАХ.
Dialogue: 0,0:10:41.10,0:10:45.59,Caption,,0,0,0,,НА ОПЕРАЦИЮ УШЛИ МЕСЯЦЫ. РЕЗУЛЬТАТОМ,
Dialogue: 0,0:10:45.75,0:10:49.43,Caption,,0,0,0,,КАК СООБЩАЕТСЯ, СТАЛО ПЛЕНЕНИЕ БОЛЕЕ ТРИДЦАТИ РОССИЙСКИХ
Dialogue: 0,0:10:49.43,0:10:52.07,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ И БЛОКИРОВАНИЕ МАРШРУТА ОБХОДА
Dialogue: 0,0:10:52.07,0:10:55.43,Caption,,0,0,0,,УКРАИНСКОЙ ОБОРОНЫ. И ВОТ ВАМ СОВРЕМЕННАЯ ВОЙНА В
Dialogue: 0,0:10:55.43,0:10:58.55,Caption,,0,0,0,,ОДНОМ КАДРЕ. НА ОДНОМ УЧАСТКЕ БЕСПИЛОТНИК ЛЕТИТ НА
Dialogue: 0,0:10:58.55,0:11:02.71,Caption,,0,0,0,,ТРИДЦАТЬ КИЛОМЕТРОВ, РАЗМАТЫВАЯ ДОРОГУЩИЙ КИТАЙСКИЙ КАБЕЛЬ. НА ДРУГОМ
Dialogue: 0,0:11:02.79,0:11:05.43,Caption,,0,0,0,,УЧАСТКЕ ЧЕЛОВЕК ПОЛЗЁТ ПЯТНАДЦАТЬ КИЛОМЕТРОВ ВНУТРИ
Dialogue: 0,0:11:05.51,0:11:08.15,Caption,,0,0,0,,СТАРОЙ ТРУБЫ. ВЫСОКИЕ ТЕХНОЛОГИИ ВСТРЕТИЛИСЬ СО
Dialogue: 0,0:11:08.15,0:11:11.19,Caption,,0,0,0,,СТАРОЙ ДОБРОЙ ПОДЗЕМНОЙ ТАКТИКОЙ. И ОБЕ СХЕМЫ
Dialogue: 0,0:11:11.19,0:11:13.99,Caption,,0,0,0,,РАБОТАЮТ ПРИМЕРНО НА ОДНУ ЗАДАЧУ. ПРОЙТИ ТУДА,
Dialogue: 0,0:11:14.15,0:11:17.91,Caption,,0,0,0,,ГДЕ ТЕБЯ НЕ ЖДУТ. НО НАД ВСЕЙ ЭТОЙ ИЗОБРЕТАТЕЛЬНОСТЬЮ ВИСИТ СОВСЕМ
Dialogue: 0,0:11:17.91,0:11:20.63,Caption,,0,0,0,,ДРУГОЙ УРОВЕНЬ ПРОТИВОСТОЯНИЯ. РОССИЯ,
Dialogue: 0,0:11:20.87,0:11:23.19,Caption,,0,0,0,,ПО ДАННЫМ МЕЖДУНАРОДНОГО ИНСТИТУТА СТРАТЕГИЧЕСКИХ
Dialogue: 0,0:11:23.19,0:11:26.63,Caption,,0,0,0,,ИССЛЕДОВАНИЙ, НАЧАЛА РАЗВЁРТЫВАНИЕ МЕЖКОНТИНЕНТАЛЬНЫХ РАКЕТ
Dialogue: 0,0:11:26.63,0:11:29.19,Caption,,0,0,0,,"САРМАТ" В ШЕСТЬДЕСЯТ ВТОРОЙ РАКЕТНОЙ ДИВИЗИИ ПОД
Dialogue: 0,0:11:29.19,0:11:32.55,Caption,,0,0,0,,УЖУРОМ. ЭТИ РАКЕТЫ ДОЛЖНЫ ЗАМЕНИТЬ СТАРЫЕ ТЯЖЁЛЫЕ
Dialogue: 0,0:11:32.55,0:11:35.59,Caption,,0,0,0,,КОМПЛЕКСЫ. В ЗАЯВЛЕННЫХ ХАРАКТЕРИСТИКАХ ФИГУРИРУЮТ
Dialogue: 0,0:11:35.67,0:11:38.39,Caption,,0,0,0,,ДО ПЯТНАДЦАТИ ЯДЕРНЫХ БОЕВЫХ БЛОКОВ ИНДИВИДУАЛЬНОГО
Dialogue: 0,0:11:38.39,0:11:41.51,Caption,,0,0,0,,НАВЕДЕНИЯ ЛИБО НЕСКОЛЬКО ГИПЕРЗВУКОВЫХ ПЛАНИРУЮЩИХ
Dialogue: 0,0:11:41.51,0:11:44.23,Caption,,0,0,0,,БЛОКОВ. ПРИ ЭТОМ ИСТОРИЯ ИСПЫТАНИЙ У "САРМАТА"
Dialogue: 0,0:11:44.23,0:11:46.95,Caption,,0,0,0,,ПОЛУЧИЛАСЬ ДАЛЕКО НЕ ПАРАДНОЙ. ПОСЛЕ УСПЕШНОГО
Dialogue: 0,0:11:46.95,0:11:48.87,Caption,,0,0,0,,ЗАПУСКА В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОМ ГОДУ
Dialogue: 0,0:11:48.87,0:11:51.91,Caption,,0,0,0,,ПОСЛЕДОВАЛИ НЕУДАЧИ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТОМ
Dialogue: 0,0:11:51.91,0:11:53.91,Caption,,0,0,0,,РАКЕТА, ПО ОПУБЛИКОВАННЫМ ДАННЫМ,
Dialogue: 0,0:11:54.15,0:12:00.11,Caption,,0,0,0,,ВЗОРВАЛАСЬ В ШАХТЕ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ ЕЩЁ ОДНО ИСПЫТАНИЕ
Dialogue: 0,0:12:00.11,0:12:02.91,Caption,,0,0,0,,ЗАКОНЧИЛОСЬ АВАРИЕЙ ПОСЛЕ ВЫХОДА РАКЕТЫ ИЗ ШАХТЫ.
Dialogue: 0,0:12:03.31,0:12:05.63,Caption,,0,0,0,,ДВЕНАДЦАТОГО МАЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОГО
Dialogue: 0,0:12:05.63,0:12:08.59,Caption,,0,0,0,,СОСТОЯЛСЯ ВТОРОЙ УСПЕШНЫЙ ЗАПУСК. ПОСЛЕ НЕГО
Dialogue: 0,0:12:08.59,0:12:10.91,Caption,,0,0,0,,КОМАНДУЮЩИЙ РАКЕТНЫМИ ВОЙСКАМИ СТРАТЕГИЧЕСКОГО
Dialogue: 0,0:12:10.91,0:12:12.99,Caption,,0,0,0,,НАЗНАЧЕНИЯ СЕРГЕЙ КАРАКАЕВ ЗАЯВИЛ,
Dialogue: 0,0:12:13.22,0:12:15.55,Caption,,0,0,0,,ЧТО ИСПЫТАНИЕ ПОЗВОЛИТ ПОСТАВИТЬ КОМПЛЕКС НА
Dialogue: 0,0:12:15.55,0:12:18.35,Caption,,0,0,0,,ДЕЖУРСТВО ДО КОНЦА ГОДА. И ОДНОВРЕМЕННО У
Dialogue: 0,0:12:18.35,0:12:20.83,Caption,,0,0,0,,ДОМБАРОВСКОГО СНОВА ПОЯВЛЯЕТСЯ ТЕХНИКА,
Dialogue: 0,0:12:21.07,0:12:23.55,Caption,,0,0,0,,СВЯЗАННАЯ, СУДЯ ПО СПУТНИКОВЫМ СНИМКАМ,
Dialogue: 0,0:12:23.70,0:12:26.99,Caption,,0,0,0,,С ПОДГОТОВКОЙ СЛЕДУЮЩЕГО ИСПЫТАНИЯ. НО СЕНСАЦИЯ
Dialogue: 0,0:12:27.07,0:12:31.87,Caption,,0,0,0,,ЗДЕСЬ ВОВСЕ НЕ В ТОМ, ЧТО ПОЯВИЛАСЬ НОВАЯ РАКЕТА. ИНТЕРЕСНЕЕ ДРУГОЕ. ДАЖЕ
Dialogue: 0,0:12:31.95,0:12:34.75,Caption,,0,0,0,,ПРИ СЛОЖНОЙ ИСПЫТАТЕЛЬНОЙ ИСТОРИИ РОССИЯ ПРОДОЛЖАЕТ
Dialogue: 0,0:12:34.75,0:12:37.55,Caption,,0,0,0,,РАЗВЁРТЫВАТЬ СТРАТЕГИЧЕСКИЕ СИСТЕМЫ. А НА ДРУГОМ
Dialogue: 0,0:12:37.55,0:12:40.27,Caption,,0,0,0,,КОНЦЕ ЕВРОПЫ ПОЛИТИКИ ВСЁ ЧАЩЕ НАЧИНАЮТ ВСЛУХ
Dialogue: 0,0:12:40.27,0:12:44.67,Caption,,0,0,0,,СЧИТАТЬ, ЧТО БУДЕТ, ЕСЛИ НЫНЕШНЯЯ ИГРА В ПОВЫШЕНИЕ СТАВОК ОДНАЖДЫ
Dialogue: 0,0:12:44.67,0:12:47.31,Caption,,0,0,0,,ПЕРЕСТАНЕТ БЫТЬ ИГРОЙ. И ЗДЕСЬ ОЧЕНЬ КСТАТИ
Dialogue: 0,0:12:47.31,0:12:50.35,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЖАН ЛЮК МЕЛАНШОН. ОН СМОТРИТ НА КАРТУ
Dialogue: 0,0:12:50.35,0:12:53.55,Caption,,0,0,0,,И ПРЕДЛАГАЕТ ФРАНЦУЗАМ ПРОСТУЮ ГЕОГРАФИЮ. РОССИЯ
Dialogue: 0,0:12:53.63,0:12:56.51,Caption,,0,0,0,,РАСТЯНУЛАСЬ НА ОДИННАДЦАТЬ ЧАСОВЫХ ПОЯСОВ. ФРАНЦИЯ
Dialogue: 0,0:12:56.59,0:12:58.67,Caption,,0,0,0,,НЕТ. ПОЭТОМУ, ГОВОРИТ МЕЛАНШОН,
Dialogue: 0,0:12:58.98,0:13:01.47,Caption,,0,0,0,,РАССЧИТЫВАТЬ, ЧТО МОЖНО БИТЬ ПО МОСКВЕ,
Dialogue: 0,0:13:01.71,0:13:04.03,Caption,,0,0,0,,А РОССИЯ В ОТВЕТ ПРЕДЛОЖИТ ВСЕМ СПОКОЙНО СЕСТЬ
Dialogue: 0,0:13:04.11,0:13:07.23,Caption,,0,0,0,,И ПОГОВОРИТЬ, ДОВОЛЬНО СТРАННО. ОНА БУДЕТ ОТВЕЧАТЬ.
Dialogue: 0,0:13:09.51,0:13:11.91,Caption,,0,0,0,,НО ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ НЕПРИЯТНОЕ УЖЕ ДЛЯ
Dialogue: 0,0:13:11.91,0:13:14.95,Caption,,0,0,0,,ФРАНЦУЗСКОГО ЗРИТЕЛЯ. МЕЛАНШОН ГОВОРИТ О ФРАНЦУЗСКИХ
Dialogue: 0,0:13:14.95,0:13:17.83,Caption,,0,0,0,,ЯДЕРНЫХ ОБЪЕКТАХ. И ФОРМУЛИРУЕТ БЕЗ КРАСИВЫХ
Dialogue: 0,0:13:17.83,0:13:20.87,Caption,,0,0,0,,ДИПЛОМАТИЧЕСКИХ ФАНТИКОВ. ОДИН СЕРЬЁЗНЫЙ УДАР ПО
Dialogue: 0,0:13:20.95,0:13:25.51,Caption,,0,0,0,,ТАКИМ ОБЪЕКТАМ, И ФРАНЦИИ БОЛЬШЕ НЕТ. ВСЁ. ЗАКРЫВАЕМ ЛАВОЧКУ. ВОТ
Dialogue: 0,0:13:25.59,0:13:28.23,Caption,,0,0,0,,ЭТО УЖЕ НОРМАЛЬНЫЙ МАСШТАБ РАЗГОВОРА О ПОСЛЕДСТВИЯХ.
Dialogue: 0,0:13:28.47,0:13:31.67,Caption,,0,0,0,,НЕ ПАДЕНИЕ РЕЙТИНГА. НЕ ОЧЕРЕДНОЙ БЮДЖЕТНЫЙ КРИЗИС.
Dialogue: 0,0:13:31.90,0:13:34.15,Caption,,0,0,0,,НЕ ПРОБЛЕМЫ ПРАВИТЕЛЬСТВА НА СЛЕДУЮЩИХ ВЫБОРАХ.
Dialogue: 0,0:13:34.39,0:13:37.43,Caption,,0,0,0,,СТРАНЫ МОЖЕТ ПРОСТО НЕ БЫТЬ. И ОСОБЕННО ИНТЕРЕСНО,
Dialogue: 0,0:13:37.67,0:13:39.67,Caption,,0,0,0,,ЧТО ЭТУ ФОРМУЛУ ПРОИЗНОСИТ НЕ РОССИЙСКИЙ
Dialogue: 0,0:13:39.67,0:13:42.63,Caption,,0,0,0,,ТЕЛЕВЕДУЩИЙ. ЕЁ ПРОИЗНОСИТ ФРАНЦУЗСКИЙ ПОЛИТИК.
Dialogue: 0,0:13:42.88,0:13:45.43,Caption,,0,0,0,,ПРИЧЁМ НЕ КАКОЙ ТО ЧЕЛОВЕК ИЗ ПОЛИТИЧЕСКОГО ПОДВАЛА.
Dialogue: 0,0:13:45.73,0:13:48.15,Caption,,0,0,0,,ОДИН ИЗ САМЫХ ЗАМЕТНЫХ КАНДИДАТОВ НА ВЫСШУЮ
Dialogue: 0,0:13:48.23,0:13:50.55,Caption,,0,0,0,,ДОЛЖНОСТЬ В СТРАНЕ. МЕЛАНШОН УЖЕ ГОВОРИЛ,
Dialogue: 0,0:13:50.79,0:13:53.03,Caption,,0,0,0,,ЧТО НЕ СОБИРАЕТСЯ ВТЯГИВАТЬ ФРАНЦИЮ В ПРЯМОЕ
Dialogue: 0,0:13:53.03,0:13:57.27,Caption,,0,0,0,,СТОЛКНОВЕНИЕ НИ С РОССИЕЙ, НИ С КИТАЕМ ИЗ ЗА ТАЙВАНЯ. ТО ЕСТЬ
Dialogue: 0,0:13:57.27,0:14:00.15,Caption,,0,0,0,,ЕГО НЫНЕШНЕЕ ЗАЯВЛЕНИЕ ВПОЛНЕ УКЛАДЫВАЕТСЯ В ПРЕЖНЮЮ
Dialogue: 0,0:14:00.15,0:14:03.19,Caption,,0,0,0,,ЛИНИЮ. А С ДРУГОЙ СТОРОНЫ ФРАНЦУЗСКОЙ ПОЛИТИКИ МАРИН ЛЕ
Dialogue: 0,0:14:03.19,0:14:06.79,Caption,,0,0,0,,ПЕН СЧИТАЕТ УЖЕ НЕ РАКЕТЫ, А ДЕНЬГИ. ПО ЕЁ СЛОВАМ,
Dialogue: 0,0:14:06.95,0:14:09.83,Caption,,0,0,0,,ФРАНЦИЯ ЕЖЕГОДНО ОТДАЁТ УКРАИНЕ ОКОЛО ШЕСТИ
Dialogue: 0,0:14:09.83,0:14:12.95,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО. И ЭТО БЕЗ УЧЁТА ОБЯЗАТЕЛЬСТВ ПО
Dialogue: 0,0:14:12.95,0:14:15.59,Caption,,0,0,0,,ЕВРОПЕЙСКИМ ЗАЙМАМ. ЛЕ ПЕН ЗАЯВЛЯЕТ,
Dialogue: 0,0:14:15.75,0:14:18.23,Caption,,0,0,0,,ЧТО В СЛУЧАЕ ПРИХОДА К ВЛАСТИ ФИНАНСОВУЮ ПОМОЩЬ
Dialogue: 0,0:14:18.31,0:14:24.36,Caption,,0,0,0,,СОБИРАЕТСЯ ПРЕКРАТИТЬ. ПРИЧЁМ УКРАИНСКОМУ ПОСЛУ ОНА ЭТО УЖЕ СООБЩИЛА.
Dialogue: 0,0:14:24.76,0:14:27.96,Caption,,0,0,0,,ГУМАНИТАРНАЯ ПОМОЩЬ ОСТАНЕТСЯ. ОБУЧЕНИЕ УКРАИНСКИХ
Dialogue: 0,0:14:27.96,0:14:31.00,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ ОСТАНЕТСЯ. А ПРЯМОЕ БЮДЖЕТНОЕ
Dialogue: 0,0:14:31.00,0:14:32.84,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ, ГОВОРИТ ЛЕ ПЕН,
Dialogue: 0,0:14:33.00,0:14:35.96,Caption,,0,0,0,,ФРАНЦИЯ БОЛЬШЕ НЕ ТЯНЕТ. ПОЛУЧАЕТСЯ ЗАНЯТНАЯ
Dialogue: 0,0:14:35.96,0:14:38.20,Caption,,0,0,0,,ФРАНЦУЗСКАЯ ВИЛКА. ОДИН ГОВОРИТ,
Dialogue: 0,0:14:38.44,0:14:41.08,Caption,,0,0,0,,ЧТО ПРОДОЛЖЕНИЕ НЫНЕШНЕГО КУРСА СПОСОБНО ЗАКОНЧИТЬСЯ
Dialogue: 0,0:14:41.08,0:14:43.88,Caption,,0,0,0,,КАТАСТРОФОЙ ДЛЯ САМОЙ СТРАНЫ. ДРУГАЯ ГОВОРИТ,
Dialogue: 0,0:14:44.04,0:14:46.12,Caption,,0,0,0,,ЧТО ЗА ЭТОТ КУРС ЕЩЁ И ПЛАТИТЬ БОЛЬШЕ
Dialogue: 0,0:14:46.12,0:14:48.76,Caption,,0,0,0,,НЕЧЕМ. И ЭТО ДВЕ СОВЕРШЕННО РАЗНЫЕ ЧАСТИ
Dialogue: 0,0:14:48.76,0:14:51.72,Caption,,0,0,0,,ФРАНЦУЗСКОГО ПОЛИТИЧЕСКОГО СПЕКТРА. ПРИ ЭТОМ ДЕЛАТЬ
Dialogue: 0,0:14:51.80,0:14:54.68,Caption,,0,0,0,,ВИД, БУДТО ЛЕ ПЕН ТОЛЬКО СЕЙЧАС ВПЕРВЫЕ СКАЗАЛА О
Dialogue: 0,0:14:54.68,0:14:59.32,Caption,,0,0,0,,ПРЕКРАЩЕНИИ ФИНАНСИРОВАНИЯ, ТОЖЕ НЕ НАДО. ЭТА ПОЗИЦИЯ УЖЕ ЗВУЧАЛА. НО
Dialogue: 0,0:14:59.40,0:15:01.88,Caption,,0,0,0,,ТЕПЕРЬ ОНА ПОДТВЕРЖДАЕТСЯ ЕЩЁ РАЗ И УЖЕ НАПРЯМУЮ
Dialogue: 0,0:15:01.96,0:15:04.92,Caption,,0,0,0,,УКРАИНСКОЙ СТОРОНЕ. А ПОКА ПАРИЖ СПОРИТ О ЦЕНЕ,
Dialogue: 0,0:15:05.16,0:15:07.96,Caption,,0,0,0,,ЛОНДОН СТРОИТ УКРАИНСКИЕ БЕСПИЛОТНИКИ. ТО ЕСТЬ
Dialogue: 0,0:15:07.96,0:15:11.24,Caption,,0,0,0,,НИКАКОЙ ЕДИНОЙ ЕВРОПЕЙСКОЙ КНОПКИ ЗДЕСЬ НЕТ. ОДНИ
Dialogue: 0,0:15:11.24,0:15:14.92,Caption,,0,0,0,,ХОТЯТ УМЕНЬШАТЬ УЧАСТИЕ. ДРУГИЕ ЕГО РАСШИРЯЮТ. И ЗА
Dialogue: 0,0:15:14.92,0:15:17.96,Caption,,0,0,0,,ОКЕАНОМ КАРТИНА СТАНОВИТСЯ ЕЩЁ ИНТЕРЕСНЕЕ. ПОСЛЕ
Dialogue: 0,0:15:17.96,0:15:21.24,Caption,,0,0,0,,ПРОМЕЖУТОЧНЫХ ВЫБОРОВ ТРЕТЬЕГО НОЯБРЯ ДЕМОКРАТЫ США
Dialogue: 0,0:15:21.24,0:15:23.64,Caption,,0,0,0,,УЖЕ ФАКТИЧЕСКИ ВОШЛИ В СЛЕДУЮЩУЮ ПРЕЗИДЕНТСКУЮ
Dialogue: 0,0:15:23.64,0:15:26.60,Caption,,0,0,0,,ГОНКУ. СРЕДИ ПОТЕНЦИАЛЬНЫХ ФИГУР ОБСУЖДАЮТ ГЭВИНА
Dialogue: 0,0:15:26.60,0:15:29.64,Caption,,0,0,0,,НЬЮСОМА, МАРКА КЕЛЛИ, ДЖОША ШАПИРО,
Dialogue: 0,0:15:29.80,0:15:33.08,Caption,,0,0,0,,КАМАЛУ ХАРРИС. НЬЮСОМ ШЕСТНАДЦАТОГО НОЯБРЯ ПОСЕТИЛ
Dialogue: 0,0:15:33.08,0:15:38.55,Caption,,0,0,0,,УКРАИНУ. КЕЛЛИ ВЫСТУПАЕТ ЗА РАСШИРЕНИЕ САНКЦИЙ ПРОТИВ РОССИИ
Dialogue: 0,0:15:38.55,0:15:41.59,Caption,,0,0,0,,И НОВЫЕ ПОСТАВКИ ВООРУЖЕНИЙ КИЕВУ. ШАПИРО
Dialogue: 0,0:15:41.67,0:15:44.15,Caption,,0,0,0,,ПОДДЕРЖИВАЕТ ВОЕННО ПРОМЫШЛЕННОЕ СОТРУДНИЧЕСТВО С
Dialogue: 0,0:15:44.15,0:15:47.27,Caption,,0,0,0,,УКРАИНОЙ. НО ФАМИЛИИ ЗДЕСЬ ДАЖЕ НЕ САМОЕ ВАЖНОЕ.
Dialogue: 0,0:15:47.51,0:15:50.47,Caption,,0,0,0,,ГОРАЗДО ИНТЕРЕСНЕЕ НОВЫЙ КОНГРЕСС. ПО ПРИВЕДЁННЫМ
Dialogue: 0,0:15:50.47,0:15:54.31,Caption,,0,0,0,,ДАННЫМ, ДЕМОКРАТЫ ПОЛУЧИЛИ ПЯТЬДЕСЯТ ШЕСТЬ МЕСТ В СЕНАТЕ И
Dialogue: 0,0:15:54.31,0:15:56.55,Caption,,0,0,0,,НЕ МЕНЕЕ ДВУХСОТ ПЯТИДЕСЯТИ СЕМИ В ПАЛАТЕ
Dialogue: 0,0:15:56.55,0:15:59.35,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЕЙ. ЕСЛИ ЭТО СООТНОШЕНИЕ СОХРАНИТСЯ К
Dialogue: 0,0:15:59.35,0:16:04.23,Caption,,0,0,0,,НАЧАЛУ РАБОТЫ НОВОГО СОСТАВА, С ЯНВАРЯ У АДМИНИСТРАЦИИ ТРАМПА ПОЯВЛЯЕТСЯ СОВСЕМ
Dialogue: 0,0:16:04.23,0:16:07.51,Caption,,0,0,0,,ДРУГАЯ ПОЛИТИЧЕСКАЯ РЕАЛЬНОСТЬ. ПОТОМУ ЧТО САНКЦИИ,
Dialogue: 0,0:16:07.59,0:16:10.71,Caption,,0,0,0,,ДЕНЬГИ, ИСКЛЮЧЕНИЯ ИЗ САНКЦИОННОГО РЕЖИМА И ЧАСТЬ
Dialogue: 0,0:16:10.71,0:16:13.75,Caption,,0,0,0,,ВНЕШНЕПОЛИТИЧЕСКИХ РЕШЕНИЙ ПРОХОДЯТ НЕ ТОЛЬКО ЧЕРЕЗ
Dialogue: 0,0:16:13.75,0:16:16.87,Caption,,0,0,0,,БЕЛЫЙ ДОМ. УЖЕ ДЕВЯТНАДЦАТОГО НОЯБРЯ СЕНАТОР ТИМ
Dialogue: 0,0:16:16.95,0:16:20.47,Caption,,0,0,0,,КЕЙН ЗАЯВИЛ, ЧТО СОБИРАЕТСЯ ПОДНИМАТЬ ВОПРОС О ПОСЛЕДСТВИЯХ
Dialogue: 0,0:16:20.47,0:16:22.87,Caption,,0,0,0,,РОССИЙСКО АМЕРИКАНСКОГО СОГЛАШЕНИЯ ОТ ДЕВЯТОГО
Dialogue: 0,0:16:22.87,0:16:26.39,Caption,,0,0,0,,ОКТЯБРЯ, ПРЕДУСМАТРИВАЮЩЕГО СМЯГЧЕНИЕ ОТДЕЛЬНЫХ САНКЦИОННЫХ
Dialogue: 0,0:16:26.39,0:16:29.35,Caption,,0,0,0,,ОГРАНИЧЕНИЙ. ТО ЕСТЬ ТРАМП МОЖЕТ ДОГОВАРИВАТЬСЯ С
Dialogue: 0,0:16:29.35,0:16:32.47,Caption,,0,0,0,,МОСКВОЙ. А КОНГРЕСС ЗАТЕМ МОЖЕТ НАЧАТЬ РАЗБИРАТЬСЯ,
Dialogue: 0,0:16:32.71,0:16:35.51,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО ПРЕЗИДЕНТ ВООБЩЕ ИМЕЕТ ПРАВО ЗАЙТИ
Dialogue: 0,0:16:35.59,0:16:38.39,Caption,,0,0,0,,В ВЫПОЛНЕНИИ ЭТИХ ДОГОВОРЁННОСТЕЙ. И ВОТ ВАМ ЕЩЁ
Dialogue: 0,0:16:38.47,0:16:41.51,Caption,,0,0,0,,ОДИН СЛОЙ ЛЮБОЙ БОЛЬШОЙ СДЕЛКИ. МАЛО ДОГОВОРИТЬСЯ С
Dialogue: 0,0:16:41.51,0:16:44.47,Caption,,0,0,0,,ДРУГОЙ СТРАНОЙ. НАДО ЕЩЁ ИМЕТЬ ВОЗМОЖНОСТЬ ВЫПОЛНИТЬ
Dialogue: 0,0:16:44.47,0:16:50.67,Caption,,0,0,0,,ОБЕЩАННОЕ У СЕБЯ ДОМА. В КИЕВЕ ДВАДЦАТЬ ПЕРВОГО НОЯБРЯ ПРОШЛИ МЕРОПРИЯТИЯ
Dialogue: 0,0:16:50.75,0:16:53.55,Caption,,0,0,0,,КО ДНЮ ДОСТОИНСТВА И СВОБОДЫ. ЗЕЛЕНСКИЙ ВМЕСТЕ С
Dialogue: 0,0:16:53.55,0:16:58.35,Caption,,0,0,0,,БУДАНОВЫМ, СИБИГОЙ, СТЕФАНЧУКОМ И ДРУГИМИ ПРЕДСТАВИТЕЛЯМИ ВЛАСТИ ПРИНЯЛ
Dialogue: 0,0:16:58.35,0:17:01.31,Caption,,0,0,0,,УЧАСТИЕ В ЦЕРЕМОНИИ ПАМЯТИ НЕБЕСНОЙ СОТНИ. САМ
Dialogue: 0,0:17:01.31,0:17:04.43,Caption,,0,0,0,,РИТУАЛ ПОНЯТЕН. ГОСУДАРСТВО КАЖДЫЙ ГОД ПОДТВЕРЖДАЕТ
Dialogue: 0,0:17:04.43,0:17:07.15,Caption,,0,0,0,,СОБСТВЕННУЮ ВЕРСИЮ СОБЫТИЙ ДВЕ ТЫСЯЧИ ЧЕТЫРНАДЦАТОГО
Dialogue: 0,0:17:07.23,0:17:10.11,Caption,,0,0,0,,ГОДА. ВСЁ БЫЛО НЕ ЗРЯ. ВЫБОР БЫЛ ПРАВИЛЬНЫМ.
Dialogue: 0,0:17:10.32,0:17:13.15,Caption,,0,0,0,,ЖЕРТВЫ ИМЕЛИ СМЫСЛ. ТОЛЬКО ЧЕРЕЗ СТОЛЬКО ЛЕТ К
Dialogue: 0,0:17:13.15,0:17:15.47,Caption,,0,0,0,,ЭТОЙ КОНСТРУКЦИИ НАЧИНАЕТ ПРИСТАВАТЬ ОЧЕНЬ
Dialogue: 0,0:17:15.47,0:17:18.83,Caption,,0,0,0,,НЕПРИЯТНЫЙ ВОПРОС. А ЕСЛИ ПРОСТО ДОЖДАТЬСЯ СЛЕДУЮЩИХ
Dialogue: 0,0:17:18.83,0:17:22.27,Caption,,0,0,0,,ВЫБОРОВ? ЕСЛИ ЯНУКОВИЧ ДЕЙСТВИТЕЛЬНО ПОТЕРЯЛ ПОДДЕРЖКУ,
Dialogue: 0,0:17:22.48,0:17:24.67,Caption,,0,0,0,,РАЗВЕ НЕЛЬЗЯ БЫЛО ДОЖДАТЬСЯ ЕГО ПОРАЖЕНИЯ НА
Dialogue: 0,0:17:24.67,0:17:28.35,Caption,,0,0,0,,ВЫБОРАХ? ЭТО НЕ ВОПРОС С ГОТОВЫМ ОТВЕТОМ. ИСТОРИЮ НАЗАД
Dialogue: 0,0:17:28.35,0:17:31.31,Caption,,0,0,0,,НЕ ПЕРЕМОТАЕШЬ. НО ПРОБЛЕМА В ДРУГОМ. ЧЕМ ВЫШЕ
Dialogue: 0,0:17:31.31,0:17:33.55,Caption,,0,0,0,,ЦЕНА СОБЫТИЙ, ПОСЛЕДОВАВШИХ ПОТОМ,
Dialogue: 0,0:17:33.95,0:17:36.27,Caption,,0,0,0,,ТЕМ ТРУДНЕЕ ПРОСТО ПОВТОРЯТЬ СТАРУЮ ФОРМУЛУ И
Dialogue: 0,0:17:36.27,0:17:39.71,Caption,,0,0,0,,РАССЧИТЫВАТЬ, ЧТО НИКТО НИКОГДА НЕ НАЧНЁТ СЧИТАТЬ ИТОГ. И
Dialogue: 0,0:17:39.71,0:17:42.03,Caption,,0,0,0,,ВОТ ЗДЕСЬ ВСЯ ЭТА ИСТОРИЯ СНОВА ВОЗВРАЩАЕТ НАС
Dialogue: 0,0:17:42.11,0:17:44.91,Caption,,0,0,0,,К ЗЕЛЕНСКОМУ. ВОТ ПОЭТОМУ ГЛАВНЫЙ ВОПРОС СЕЙЧАС УЖЕ
Dialogue: 0,0:17:44.91,0:17:47.87,Caption,,0,0,0,,НЕ В ТОМ, СКОЛЬКО РАЗ ПОЛИТИКИ ПРОИЗНЕСУТ СЛОВО "МИР".
Dialogue: 0,0:17:48.03,0:17:50.75,Caption,,0,0,0,,ПРОИЗНЕСТИ ЕГО ВООБЩЕ НЕСЛОЖНО. ГОРАЗДО ИНТЕРЕСНЕЕ
Dialogue: 0,0:17:50.75,0:17:53.39,Caption,,0,0,0,,ДРУГОЕ. КТО ПЕРВЫМ ОТКАЖЕТСЯ ОТ КОНКРЕТНОГО
Dialogue: 0,0:17:53.47,0:17:57.07,Caption,,0,0,0,,ДЕЙСТВИЯ, КОТОРОЕ ТОЛКАЕТ СИТУАЦИЮ В ПРОТИВОПОЛОЖНУЮ СТОРОНУ?
Dialogue: 0,0:17:59.34,0:18:02.22,Caption,,0,0,0,,ПОТОМУ ЧТО ПОКА ОДНИ ПОДПИСЫВАЮТ ДЕКЛАРАЦИИ,
Dialogue: 0,0:18:02.46,0:18:04.62,Caption,,0,0,0,,ДРУГИЕ ПРОВЕРЯЮТ МОСТЫ НА ПРОЧНОСТЬ,
Dialogue: 0,0:18:04.86,0:18:07.10,Caption,,0,0,0,,ТРЕТЬИ ОТПРАВЛЯЮТ МОРСКИЕ БЕСПИЛОТНИКИ,
Dialogue: 0,0:18:07.34,0:18:10.14,Caption,,0,0,0,,ЧЕТВЁРТЫЕ ПЕРЕНОСЯТ ВОЕННОЕ ПРОИЗВОДСТВО ЗА ГРАНИЦУ.
Dialogue: 0,0:18:10.54,0:18:12.78,Caption,,0,0,0,,И ЕСЛИ НИКТО НЕ СОБИРАЕТСЯ ОСТАНАВЛИВАТЬСЯ,
Dialogue: 0,0:18:13.06,0:18:15.02,Caption,,0,0,0,,ТО ОДНАЖДЫ ВОПРОС БУДЕТ УЖЕ НЕ В ТОМ,
Dialogue: 0,0:18:15.10,0:18:17.26,Caption,,0,0,0,,УДАЛОСЬ ЛИ ДОГОВОРИТЬСЯ. А В ТОМ,
Dialogue: 0,0:18:17.50,0:18:19.50,Caption,,0,0,0,,УСПЕЮТ ЛИ ЕЩЁ ВООБЩЕ ДОГОВОРИТЬСЯ.
