Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ПРЕДСТАВЬТЕ КАМЕРУ ХРАНЕНИЯ, ГДЕ ОДНАЖДЫ РЕШИЛИ,
Dialogue: 0,0:00:03.24,0:00:06.60,Caption,,0,0,0,,ЧТО ЧЕМОДАН СЛИШКОМ ДОЛГО СТОИТ БЕЗ ХОЗЯИНА. ЗНАЧИТ,
Dialogue: 0,0:00:06.97,0:00:11.24,Caption,,0,0,0,,МОЖНО ВСКРЫТЬ ЗАМОК, ПРОДАТЬ СОДЕРЖИМОЕ И НАЗВАТЬ ЭТО СМЕЛОСТЬЮ. ЕСТЬ
Dialogue: 0,0:00:11.24,0:00:13.72,Caption,,0,0,0,,ТОЛЬКО ОДНА ЗАГВОЗДКА. ПОСЛЕ ТАКОГО ОСТАЛЬНЫЕ
Dialogue: 0,0:00:13.80,0:00:16.36,Caption,,0,0,0,,КЛИЕНТЫ ПОЧЕМУ ТО ПЕРЕСТАЮТ ДОВЕРЯТЬ ГАРДЕРОБЩИКУ
Dialogue: 0,0:00:16.36,0:00:20.20,Caption,,0,0,0,,СВОИ ВЕЩИ. В ЕВРОПЕ ЭТУ ЗАТЕЮ ДОСТАЛИ ИЗ ШКАФА СНОВА.
Dialogue: 0,0:00:20.60,0:00:23.00,Caption,,0,0,0,,РОССИЙСКИЕ АКТИВЫ ОПЯТЬ ПРЕДЛАГАЮТ ЗАБРАТЬ,
Dialogue: 0,0:00:23.08,0:00:25.72,Caption,,0,0,0,,ХОТЯ ЛЮДИ, ОТВЕЧАЮЩИЕ ЗА КРУПНЫЕ КАПИТАЛЫ,
Dialogue: 0,0:00:26.06,0:00:29.48,Caption,,0,0,0,,УЖЕ СПРАШИВАЮТ, КТО ПОСЛЕ ЭТОГО ПОНЕСЁТ ТУДА СВОИ ДЕНЬГИ.
Dialogue: 0,0:00:30.27,0:00:34.68,Caption,,0,0,0,,ЕСЛИ ВАМ ПО ДУШЕ РАЗБОРЫ, ГДЕ ВСЛЕД ЗА ГРОМКИМ ЗАЯВЛЕНИЕМ ПРОВЕРЯЮТ СОДЕРЖИМОЕ
Dialogue: 0,0:00:34.68,0:00:37.88,Caption,,0,0,0,,КАССЫ, ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:38.12,0:00:42.76,Caption,,0,0,0,,КОГДА ПАФОС БЕСПЛАТНЫЙ, А ПОСЛЕДСТВИЯ ВЫСТАВЛЯЮТ ОТДЕЛЬНЫМ СЧЁТОМ. ПЕРВОЙ
Dialogue: 0,0:00:42.84,0:00:45.64,Caption,,0,0,0,,ОТЛИЧИЛАСЬ ЛАТВИЯ. ТАМ ЕВРОПЕ ПРЕДЛОЖИЛИ,
Dialogue: 0,0:00:45.79,0:00:49.64,Caption,,0,0,0,,ЦИТИРУЮ, "ОТРАСТИТЬ ЯЙЦА ПОБОЛЬШЕ" И ПЕРЕСТАТЬ ЦЕРЕМОНИТЬСЯ С
Dialogue: 0,0:00:49.64,0:00:51.48,Caption,,0,0,0,,ЗАМОРОЖЕННЫМИ РОССИЙСКИМИ СРЕДСТВАМИ.
Dialogue: 0,0:00:52.10,0:00:54.60,Caption,,0,0,0,,АРГУМЕНТ ПОЧТИ ДЕТСКИЙ. ДЕНЬГИ ДОСТУПНЫ,
Dialogue: 0,0:00:54.92,0:00:59.80,Caption,,0,0,0,,ВЛАДЕЛЕЦ НАЗНАЧЕН ВИНОВАТЫМ, ПОЛУЧАТЕЛЬ ЗАРАНЕЕ ВЫБРАН. ЗАЧЕМ СОБЛЮДАТЬ КАКИЕ ТО
Dialogue: 0,0:00:59.80,0:01:03.88,Caption,,0,0,0,,СКУЧНЫЕ ПРАВИЛА? ПОМОЩЬ УКРАИНЕ СТАНОВИТСЯ ДЛЯ САМОЙ ЛАТВИИ ВСЁ
Dialogue: 0,0:01:03.88,0:01:06.76,Caption,,0,0,0,,ТЯЖЕЛЕЕ. СВОЮ КОПИЛКУ РАЗБИВАТЬ НЕПРИЯТНО,
Dialogue: 0,0:01:06.92,0:01:09.16,Caption,,0,0,0,,А ЧУЖУЮ ПРЕДЛАГАЮТ РАСКОЛОТИТЬ С ТАКИМ
Dialogue: 0,0:01:09.16,0:01:13.48,Caption,,0,0,0,,ВООДУШЕВЛЕНИЕМ, БУДТО ЗА ЭТО ПОЛАГАЕТСЯ ПРИЗ. НЕБОЛЬШИЕ СТРАНЫ ОПЯТЬ
Dialogue: 0,0:01:13.48,0:01:15.08,Caption,,0,0,0,,ВКЛЮЧИЛИ МАКСИМАЛЬНУЮ ГРОМКОСТЬ.
Dialogue: 0,0:01:17.34,0:01:20.72,Caption,,0,0,0,,ПРАВДА, ОСНОВНЫЕ РОССИЙСКИЕ КАПИТАЛЫ ХРАНЯТСЯ НЕ У НИХ.
Dialogue: 0,0:01:21.02,0:01:25.92,Caption,,0,0,0,,ПОЭТОМУ РЕЧИ ПРОИЗНОСЯТ ОДНИ, А ЮРИДИЧЕСКИЕ И ФИНАНСОВЫЕ ОСКОЛКИ БУДУТ СОБИРАТЬ
Dialogue: 0,0:01:25.92,0:01:28.72,Caption,,0,0,0,,ДРУГИЕ. И ТУТ СЛОВО БЕРЁТ ЕВРОКЛИР.
Dialogue: 0,0:01:29.52,0:01:32.32,Caption,,0,0,0,,ПОСЛЕ ЛАТВИЙСКОГО ЗАДОРА РАЗГОВОР СРАЗУ СТАНОВИТСЯ
Dialogue: 0,0:01:32.32,0:01:36.72,Caption,,0,0,0,,ВЗРОСЛЕЕ. РУКОВОДИТЕЛЬ ДЕПОЗИТАРИЯ ВАЛЕРИ УРБЕН ОБСУЖДАЕТ НЕ
Dialogue: 0,0:01:36.72,0:01:41.92,Caption,,0,0,0,,РАЗМЕР ЧЬЕЙ ЛИБО СМЕЛОСТИ, А ПОВЕДЕНИЕ ИНВЕСТОРОВ. ИХ ИНТЕРЕСУЕТ ЭЛЕМЕНТАРНАЯ
Dialogue: 0,0:01:42.00,0:01:45.12,Caption,,0,0,0,,ВЕЩЬ. ЕСЛИ СЕГОДНЯ ПРАВО СОБСТВЕННОСТИ ОТМЕНЯЮТ РАДИ
Dialogue: 0,0:01:45.12,0:01:49.44,Caption,,0,0,0,,УДОБНОГО РЕШЕНИЯ, ПОЧЕМУ ЗАВТРА ТОТ ЖЕ ПРИЁМ НЕ ПРИМЕНЯТ ЕЩЁ
Dialogue: 0,0:01:49.52,0:01:52.32,Caption,,0,0,0,,К КОМУ НИБУДЬ? ИНВЕСТОР ТЕРПИТ НАЛОГИ,
Dialogue: 0,0:01:52.48,0:01:54.72,Caption,,0,0,0,,ОГРАНИЧЕНИЯ И НЕПРИЯТНЫЕ ЗАКОНЫ,
Dialogue: 0,0:01:54.90,0:01:58.08,Caption,,0,0,0,,КОГДА ПОНИМАЕТ РАМКИ ЗАРАНЕЕ. НО ЕСЛИ ИМУЩЕСТВО
Dialogue: 0,0:01:58.16,0:02:00.72,Caption,,0,0,0,,МОЖНО ОБЪЯВИТЬ ПОДХОДЯЩИМ ДЛЯ ЧУЖИХ РАСХОДОВ УЖЕ
Dialogue: 0,0:02:00.72,0:02:02.56,Caption,,0,0,0,,ПОСЛЕ ЕГО ПОПАДАНИЯ В СИСТЕМУ,
Dialogue: 0,0:02:02.80,0:02:06.72,Caption,,0,0,0,,ДОВЕРИЕ ЗАКАНЧИВАЕТСЯ БЫСТРЕЕ СОВЕЩАНИЯ. УРБЕН ПРЯМО
Dialogue: 0,0:02:06.72,0:02:09.60,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ ОБ ОТТОКЕ КАПИТАЛА. И ВРЕМЯ ДЛЯ
Dialogue: 0,0:02:09.60,0:02:13.04,Caption,,0,0,0,,ЭКСПЕРИМЕНТА ЕВРОПА ВЫБРАЛА ВЕЛИКОЛЕПНОЕ. ЕЙ НУЖНЫ
Dialogue: 0,0:02:13.05,0:02:15.04,Caption,,0,0,0,,ГИГАНТСКИЕ ВЛОЖЕНИЯ В ОБОРОНУ,
Dialogue: 0,0:02:15.20,0:02:19.28,Caption,,0,0,0,,ЦИФРОВУЮ ОТРАСЛЬ, ДЕМОГРАФИЧЕСКИЕ ПРОГРАММЫ И ПОДДЕРЖКУ УКРАИНЫ.
Dialogue: 0,0:02:19.84,0:02:22.96,Caption,,0,0,0,,МИЛЛИАРДЫ ТРЕБУЮТСЯ ПОВСЮДУ. СНАЧАЛА МЕЖДУНАРОДНОМУ
Dialogue: 0,0:02:22.96,0:02:25.52,Caption,,0,0,0,,ИНВЕСТОРУ ПОКАЗЫВАЮТ МАСТЕР КЛАСС ПО ОБРАЩЕНИЮ С
Dialogue: 0,0:02:25.60,0:02:28.72,Caption,,0,0,0,,ЧУЖОЙ СОБСТВЕННОСТЬЮ. ЗАТЕМ ПОДОДВИГАЮТ ДОГОВОР И
Dialogue: 0,0:02:28.80,0:02:31.44,Caption,,0,0,0,,ПРЕДЛАГАЮТ ВЛОЖИТЬСЯ ЕЩЁ. ГЛАВНЫЙ ВОПРОС БУДЕТ
Dialogue: 0,0:02:31.44,0:02:34.88,Caption,,0,0,0,,КОРОТКИМ. ПОЧЕМУ ИМЕННО ЕГО КАПИТАЛ НЕ ОКАЖЕТСЯ
Dialogue: 0,0:02:34.88,0:02:41.40,Caption,,0,0,0,,СЛЕДУЮЩИМ УДОБНЫМ ЧЕМОДАНОМ? ТЕМА РОССИЙСКИХ АКТИВОВ ВОЗВРАЩАЕТСЯ ПОТОМУ,
Dialogue: 0,0:02:41.64,0:02:44.52,Caption,,0,0,0,,ЧТО ПРЕЖНИХ СПОСОБОВ ЭКОНОМИЧЕСКОГО НАЖИМА У ЕВРОПЫ
Dialogue: 0,0:02:44.52,0:02:49.24,Caption,,0,0,0,,СТАНОВИТСЯ ВСЁ МЕНЬШЕ, А РЕЗУЛЬТАТ КАЖДОГО СЛЕДУЮЩЕГО ОБХОДИТСЯ ДОРОЖЕ. ЗА
Dialogue: 0,0:02:49.32,0:02:50.92,Caption,,0,0,0,,ДВАДЦАТЬ ПЯТЫМ ПОСЛЕДУЕТ НОВЫЙ,
Dialogue: 0,0:02:51.26,0:02:54.04,Caption,,0,0,0,,НО УВЕЛИЧЕНИЕ СПИСКА САМО ПО СЕБЕ НЕ УСИЛИВАЕТ
Dialogue: 0,0:02:54.04,0:02:57.08,Caption,,0,0,0,,ДАВЛЕНИЕ. ПОРЯДКОВЫЙ НОМЕР НЕ ОТВЕЧАЕТ НА ВОПРОС,
Dialogue: 0,0:02:57.23,0:03:00.52,Caption,,0,0,0,,ЧТО ИМЕННО ИЗМЕНИЛОСЬ. НОВОЕ ОГРАНИЧЕНИЕ ДОЛЖНО
Dialogue: 0,0:03:00.52,0:03:05.48,Caption,,0,0,0,,ПЕРЕКРЫТЬ КОНКРЕТНЫЙ КАНАЛ, УДАРИТЬ ПО ОПРЕДЕЛЁННОЙ ОТРАСЛИ И ДАТЬ ИЗМЕРИМЫЙ
Dialogue: 0,0:03:05.48,0:03:08.36,Caption,,0,0,0,,РЕЗУЛЬТАТ. ЕСЛИ ОНО ЛИШЬ ПОПОЛНЯЕТ КОЛЛЕКЦИЮ,
Dialogue: 0,0:03:08.53,0:03:12.36,Caption,,0,0,0,,ЭТО УЖЕ НЕ РЫЧАГ, А АЛЬБОМ С МАРКАМИ ДЛЯ ОЧЕНЬ ДОРОГОГО ХОББИ.
Dialogue: 0,0:03:12.81,0:03:14.44,Caption,,0,0,0,,МОСКВА ПРИ ЭТОМ ИСХОДИТ ИЗ ТОГО,
Dialogue: 0,0:03:14.62,0:03:17.64,Caption,,0,0,0,,ЧТО САНКЦИИ НЕ ОТМЕНЯТ ЕЩЁ ШЕСТЬ ЛЕТ. ЭТО
Dialogue: 0,0:03:17.64,0:03:20.68,Caption,,0,0,0,,МЕНЯЕТ ЛОГИКУ ПРОТИВОСТОЯНИЯ. ЕВРОПА ПРОДОЛЖАЕТ
Dialogue: 0,0:03:20.68,0:03:23.80,Caption,,0,0,0,,ПОДАВАТЬ ОГРАНИЧЕНИЯ КАК ОЧЕРЕДНУЮ ПОРЦИЮ НАКАЗАНИЯ.
Dialogue: 0,0:03:24.09,0:03:26.76,Caption,,0,0,0,,РОССИЯ ЗАКЛАДЫВАЕТ ИХ В ДОЛГОСРОЧНЫЕ РАСЧЁТЫ И
Dialogue: 0,0:03:26.76,0:03:32.12,Caption,,0,0,0,,ПЕРЕСТРАИВАЕТ РАБОТУ ТАК, БУДТО ЭТИ УСЛОВИЯ СТАЛИ ПОСТОЯННЫМИ. ВРЕМЕННАЯ МЕРА
Dialogue: 0,0:03:32.12,0:03:35.24,Caption,,0,0,0,,ДОЛЖНА ВЫНУДИТЬ ПРОТИВНИКА ИЗМЕНИТЬ ПОВЕДЕНИЕ. НО
Dialogue: 0,0:03:35.32,0:03:37.80,Caption,,0,0,0,,КОГДА ОН ЗАРАНЕЕ ПЛАНИРУЕТ НЕСКОЛЬКО ЛЕТ ЖИЗНИ ПОД
Dialogue: 0,0:03:37.80,0:03:42.20,Caption,,0,0,0,,ДАВЛЕНИЕМ, МЕРА ПРЕВРАЩАЕТСЯ В ОКРУЖАЮЩУЮ СРЕДУ. ПОЭТОМУ КАЖДЫЙ
Dialogue: 0,0:03:42.28,0:03:45.48,Caption,,0,0,0,,НОВЫЙ ПАКЕТ ОБЯЗАН ДАВАТЬ ИНОЙ ЭФФЕКТ. ПОВТОР
Dialogue: 0,0:03:45.48,0:03:47.88,Caption,,0,0,0,,ПРЕЖНИХ ЗАПРЕТОВ ПОД СВЕЖИМ НОМЕРОМ СОЗДАЁТ
Dialogue: 0,0:03:47.88,0:03:52.60,Caption,,0,0,0,,ЗАНЯТОСТЬ ЧИНОВНИКАМ, НО НЕ ОБЯЗАТЕЛЬНО НОВУЮ ПРОБЛЕМУ МОСКВЕ. А ТЕПЕРЬ
Dialogue: 0,0:03:52.68,0:03:58.65,Caption,,0,0,0,,САМОЕ АППЕТИТНОЕ. ПОКА ЕВРОПЕЙСКИЕ СТОЛИЦЫ РАПОРТУЮТ ОБ ИЗБАВЛЕНИИ ОТ
Dialogue: 0,0:03:58.65,0:04:03.21,Caption,,0,0,0,,РОССИЙСКИХ ЭНЕРГОНОСИТЕЛЕЙ, ПОКУПАТЕЛИ В ЕВРОПЕ ИСПРАВНО ПРИОБРЕТАЮТ РОССИЙСКИЙ
Dialogue: 0,0:04:03.29,0:04:07.77,Caption,,0,0,0,,СЖИЖЕННЫЙ ПРИРОДНЫЙ ГАЗ. ЗА ПЕРВЫЕ ДЕСЯТЬ МЕСЯЦЕВ НЫНЕШНЕГО ГОДА НА НЕГО
Dialogue: 0,0:04:07.85,0:04:10.89,Caption,,0,0,0,,УШЛО ОКОЛО ВОСЬМИ ЦЕЛЫХ СЕМИ ДЕСЯТЫХ МИЛЛИАРДА ЕВРО.
Dialogue: 0,0:04:11.37,0:04:14.25,Caption,,0,0,0,,ЭТО НА ДВАДЦАТЬ ОДИН ПРОЦЕНТ БОЛЬШЕ РАСХОДОВ ЗА
Dialogue: 0,0:04:14.33,0:04:18.41,Caption,,0,0,0,,ВЕСЬ ПРОШЛЫЙ ГОД. ВОТ ЗДЕСЬ САНКЦИОННАЯ АРИФМЕТИКА ОКОНЧАТЕЛЬНО
Dialogue: 0,0:04:18.49,0:04:21.37,Caption,,0,0,0,,НАЧИНАЕТ ХИХИКАТЬ. ОДНОЙ РУКОЙ ЕВРОПА ПЫТАЕТСЯ
Dialogue: 0,0:04:21.45,0:04:24.41,Caption,,0,0,0,,ПЕРЕКРЫТЬ РОССИЙСКИЕ ДОХОДЫ. ДРУГОЙ ПОДПИСЫВАЕТ
Dialogue: 0,0:04:24.41,0:04:27.69,Caption,,0,0,0,,ПЛАТЁЖ ЗА ГАЗ НА МИЛЛИАРДЫ. ОБЕ РУКИ ПРИНАДЛЕЖАТ
Dialogue: 0,0:04:27.69,0:04:31.29,Caption,,0,0,0,,ОДНОМУ ОРГАНИЗМУ, НО, ПОХОЖЕ, ДАВНО НЕ РАЗГОВАРИВАЮТ.
Dialogue: 0,0:04:32.00,0:04:35.05,Caption,,0,0,0,,ОКТЯБРЬ ПОЛУЧИЛСЯ ЕЩЁ НАГЛЯДНЕЕ. САМОГО ГАЗА
Dialogue: 0,0:04:35.05,0:04:37.85,Caption,,0,0,0,,ПРИОБРЕЛИ МЕНЬШЕ, ОБЪЁМ ПОСТАВОК СОКРАТИЛСЯ,
Dialogue: 0,0:04:38.17,0:04:41.53,Caption,,0,0,0,,А ЗАПЛАТИЛИ БОЛЬШЕ ИЗ ЗА ПОДОРОЖАНИЯ. РОССИЙСКИЙ СПГ
Dialogue: 0,0:04:41.53,0:04:44.41,Caption,,0,0,0,,БЕРУТ ФРАНЦИЯ, БЕЛЬГИЯ, ИСПАНИЯ,
Dialogue: 0,0:04:44.54,0:04:47.45,Caption,,0,0,0,,НИДЕРЛАНДЫ И ПОРТУГАЛИЯ. А ГДЕ ТО НЕПОДАЛЁКУ,
Dialogue: 0,0:04:47.60,0:04:51.61,Caption,,0,0,0,,ВЕРОЯТНО, УЖЕ ВЫБИРАЮТ ПАПКУ ДЛЯ ОЧЕРЕДНОГО ПАКЕТА ЗАПРЕТОВ.
Dialogue: 0,0:04:51.82,0:04:55.61,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЧТОБЫ НЕ ПРОПУСТИТЬ ПРОДОЛЖЕНИЕ. ДАЛЬШЕ НАЧИНАЕТСЯ
Dialogue: 0,0:04:55.61,0:05:00.57,Caption,,0,0,0,,РЫНОК В ЕГО ЧЕСТНОМ ВИДЕ, ГДЕ ЛОЗУНГИ ЗАКАНЧИВАЮТСЯ ВОЗЛЕ ЦЕННИКА. ТУРЦИЯ
Dialogue: 0,0:05:00.57,0:05:05.05,Caption,,0,0,0,,СООБЩАЕТ РОССИИ, ЧТО ГАЗ ОБХОДИТСЯ СЛИШКОМ ДОРОГО. ЕСЛИ СТОИМОСТЬ НЕ
Dialogue: 0,0:05:05.05,0:05:08.49,Caption,,0,0,0,,ИЗМЕНИТСЯ, АНКАРА БУДЕТ ИСКАТЬ ЗАМЕНУ. ВЕНГРИЯ ТОЖЕ
Dialogue: 0,0:05:08.49,0:05:10.25,Caption,,0,0,0,,ПРИСМАТРИВАЕТСЯ К ДРУГИМ ВАРИАНТАМ.
Dialogue: 0,0:05:12.52,0:05:15.16,Caption,,0,0,0,,ЧАСТЬ ПОСТАВОК ИЗ РОССИИ ТАМ НАМЕРЕНЫ ЗАМЕСТИТЬ
Dialogue: 0,0:05:15.16,0:05:17.56,Caption,,0,0,0,,РУМЫНСКИМ ГАЗОМ. БУДАПЕШТ ГОВОРИТ О НОВЫХ
Dialogue: 0,0:05:17.56,0:05:20.20,Caption,,0,0,0,,НАПРАВЛЕНИЯХ И РАСПРЕДЕЛЕНИИ РИСКОВ МЕЖДУ
Dialogue: 0,0:05:20.28,0:05:23.24,Caption,,0,0,0,,НЕСКОЛЬКИМИ МАРШРУТАМИ. ПЕТЕР МАДЬЯР УТВЕРЖДАЕТ,
Dialogue: 0,0:05:23.56,0:05:25.88,Caption,,0,0,0,,ЧТО РОССИЙСКОЕ ТОПЛИВО НЕ НАСТОЛЬКО ВЫГОДНО,
Dialogue: 0,0:05:26.12,0:05:28.92,Caption,,0,0,0,,КАК УВЕРЯЛО ПРЕЖНЕЕ ПРАВИТЕЛЬСТВО. ПОТОМ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:05:28.92,0:05:30.60,Caption,,0,0,0,,СТОИМОСТЬ АЛЬТЕРНАТИВНОГО СПГ,
Dialogue: 0,0:05:30.99,0:05:33.96,Caption,,0,0,0,,И НАСТРОЕНИЕ ПОРТИТСЯ. ОН ТОЖЕ ОКАЗЫВАЕТСЯ ДОРОГИМ.
Dialogue: 0,0:05:34.36,0:05:37.24,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНЫЙ ВЫБОР. ОДИН ВАРИАНТ НЕ
Dialogue: 0,0:05:37.24,0:05:39.80,Caption,,0,0,0,,НРАВИТСЯ ЦЕНОЙ, ВТОРОЙ ТОЖЕ КУСАЕТСЯ,
Dialogue: 0,0:05:40.04,0:05:42.84,Caption,,0,0,0,,А ТРЕТИЙ, ДЕШЁВЫЙ И НИКОМУ БОЛЬШЕ НЕ НУЖНЫЙ,
Dialogue: 0,0:05:43.00,0:05:47.08,Caption,,0,0,0,,ОБИТАЕТ ТАМ ЖЕ, ГДЕ БЕСПЛАТНЫЙ СЫР БЕЗ МЫШЕЛОВКИ. ТАК ВЫГЛЯДИТ
Dialogue: 0,0:05:47.08,0:05:50.28,Caption,,0,0,0,,НАСТОЯЩИЙ ЭНЕРГЕТИЧЕСКИЙ РЫНОК. У НЕГО НЕТ ЧУВСТВА
Dialogue: 0,0:05:50.28,0:05:53.08,Caption,,0,0,0,,ПРЕКРАСНОГО. ЕСТЬ СТОИМОСТЬ, ДОСТАВКА,
Dialogue: 0,0:05:53.24,0:05:56.76,Caption,,0,0,0,,ПРОПУСКНАЯ СПОСОБНОСТЬ, УСЛОВИЯ ДОГОВОРА И ЧЕЛОВЕК,
Dialogue: 0,0:05:57.03,0:06:00.12,Caption,,0,0,0,,КОТОРОМУ ПРИНЕСУТ КВИТАНЦИЮ. МОЛДОВА ВЫБРАЛА БОЛЕЕ
Dialogue: 0,0:06:00.12,0:06:04.28,Caption,,0,0,0,,ЖЁСТКУЮ ФОРМУЛУ И ОБЪЯВИЛА, ЧТО РОССИЙСКИЙ ГАЗ БОЛЬШЕ НЕ ПРИОБРЕТАЕТ.
Dialogue: 0,0:06:04.97,0:06:07.96,Caption,,0,0,0,,ОДНОВРЕМЕННО СТРАНА СОЕДИНЯЕТ СВОЮ ЭНЕРГОСИСТЕМУ С
Dialogue: 0,0:06:07.96,0:06:10.76,Caption,,0,0,0,,РУМЫНИЕЙ. УЖЕ РАБОТАЕТ ЛИНИЯ ОТ ВУЛКАНЕШТ ДО
Dialogue: 0,0:06:10.76,0:06:14.68,Caption,,0,0,0,,КИШИНЁВА, ГОТОВЯТСЯ ДОПОЛНИТЕЛЬНЫЕ СОЕДИНЕНИЯ. ЗДЕСЬ ПЕРЕМЕНЫ
Dialogue: 0,0:06:14.68,0:06:17.40,Caption,,0,0,0,,СУЩЕСТВУЮТ НЕ В ЗАЯВЛЕНИЯХ. УСТАНАВЛИВАЕТСЯ
Dialogue: 0,0:06:17.40,0:06:19.64,Caption,,0,0,0,,ОБОРУДОВАНИЕ, ПРОТЯГИВАЮТСЯ СЕТИ,
Dialogue: 0,0:06:19.88,0:06:23.00,Caption,,0,0,0,,ПЕРЕСТРАИВАЕТСЯ СХЕМА СНАБЖЕНИЯ. НО ЗА ТОРЖЕСТВЕННОЙ
Dialogue: 0,0:06:23.00,0:06:26.20,Caption,,0,0,0,,ЛЕНТОЧКОЙ СТОИТ БУХГАЛТЕР С ПАПКОЙ. НОВАЯ ЭНЕРГИЯ
Dialogue: 0,0:06:26.28,0:06:33.04,Caption,,0,0,0,,ОБХОДИТСЯ ПОТРЕБИТЕЛЮ ДОРОЖЕ. ПОСТАВЩИКА И МАРШРУТ ЗАМЕНИТЬ МОЖНО. МОЖНО ПРОВЕСТИ
Dialogue: 0,0:06:33.04,0:06:36.64,Caption,,0,0,0,,ЦЕРЕМОНИЮ, СКАЗАТЬ ПРАВИЛЬНЫЕ СЛОВА И ОБЪЯВИТЬ ИСТОРИЧЕСКУЮ
Dialogue: 0,0:06:36.72,0:06:39.36,Caption,,0,0,0,,ПОБЕДУ. ТОЛЬКО ПЛАТЁЖКА НЕ ЧИТАЕТ РЕЧЕЙ. ОНА
Dialogue: 0,0:06:39.44,0:06:42.40,Caption,,0,0,0,,ПРИХОДИТ С КОНКРЕТНОЙ СУММОЙ. ВСЯ ЕВРОПЕЙСКАЯ
Dialogue: 0,0:06:42.40,0:06:45.12,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКАЯ КОНСТРУКЦИЯ ВЫГЛЯДИТ ПРОСТО. ОТ
Dialogue: 0,0:06:45.12,0:06:50.00,Caption,,0,0,0,,РОССИЙСКОГО ГАЗА ХОТЯТ УЙТИ, НО ВО ВРЕМЯ ЭТОГО УХОДА РОССИЙСКИЙ СПГ ПРОДОЛЖАЮТ
Dialogue: 0,0:06:50.00,0:06:53.20,Caption,,0,0,0,,РАЗГРУЖАТЬ В ЕВРОПЕЙСКИХ ПОРТАХ. ВЕНГРИЯ ИЩЕТ
Dialogue: 0,0:06:53.28,0:06:56.00,Caption,,0,0,0,,ТОПЛИВО В РУМЫНИИ. ДРУГИЕ СТРАНЫ РАССЧИТЫВАЮТ НА
Dialogue: 0,0:06:56.00,0:06:59.36,Caption,,0,0,0,,АМЕРИКАНСКИЕ ПОСТАВКИ. МОЛДОВА ПРОКЛАДЫВАЕТ НОВЫЕ
Dialogue: 0,0:06:59.44,0:07:01.92,Caption,,0,0,0,,ЛИНИИ. КТО ТО ЖДЁТ БУДУЩЕГО ЗАПРЕТА,
Dialogue: 0,0:07:02.15,0:07:05.52,Caption,,0,0,0,,А ПОКА ВЫПОЛНЯЕТ ДЕЙСТВУЮЩИЕ КОНТРАКТЫ. ЗАЯВЛЕНИЕ ОБ
Dialogue: 0,0:07:05.60,0:07:08.96,Caption,,0,0,0,,ОТКАЗЕ НИЧЕГО НЕ ОЗНАЧАЕТ, ПОКА НЕ ПРОВЕРЕНЫ ПРИЧАЛ,
Dialogue: 0,0:07:09.04,0:07:12.64,Caption,,0,0,0,,ТРУБОПРОВОД И БАНКОВСКАЯ ОПЕРАЦИЯ. У МОЛЕКУЛЫ ГАЗА
Dialogue: 0,0:07:12.72,0:07:15.60,Caption,,0,0,0,,НЕТ УДОСТОВЕРЕНИЯ ЛИЧНОСТИ. ОНА НЕ КРАСНЕЕТ НА
Dialogue: 0,0:07:15.68,0:07:20.16,Caption,,0,0,0,,ТАМОЖНЕ И НЕ ПРИЗНАЁТСЯ, ОТКУДА ПРИЕХАЛА. ИМЕННО ПОЭТОМУ ЗАМОРОЖЕННЫЕ
Dialogue: 0,0:07:20.16,0:07:23.12,Caption,,0,0,0,,РОССИЙСКИЕ СРЕДСТВА СНОВА ВЫГЛЯДЯТ ДЛЯ ЕВРОПЫ ТАКИМИ
Dialogue: 0,0:07:23.12,0:07:26.08,Caption,,0,0,0,,СОБЛАЗНИТЕЛЬНЫМИ. ЭТО НЕ НЕБОЛЬШОЕ ОГРАНИЧЕНИЕ,
Dialogue: 0,0:07:26.31,0:07:29.12,Caption,,0,0,0,,ЭФФЕКТ КОТОРОГО НАДО ЖДАТЬ МЕСЯЦАМИ. ПЕРЕД ГЛАЗАМИ
Dialogue: 0,0:07:29.12,0:07:33.60,Caption,,0,0,0,,ЛЕЖИТ КРУПНАЯ СУММА, ДО КОТОРОЙ УЖЕ ДОТЯНУЛАСЬ СИСТЕМА ХРАНЕНИЯ. НЕ
Dialogue: 0,0:07:33.60,0:07:36.64,Caption,,0,0,0,,ТРЕБУЕТСЯ ВВОДИТЬ НОВЫЙ СБОР. НЕ НАДО ЗАНИМАТЬ У
Dialogue: 0,0:07:36.64,0:07:39.28,Caption,,0,0,0,,ИЗБИРАТЕЛЕЙ ОЧЕРЕДНЫЕ СОРОК МИЛЛИАРДОВ. НЕ
Dialogue: 0,0:07:39.28,0:07:43.44,Caption,,0,0,0,,ПРИХОДИТСЯ НАДЕЯТЬСЯ, ЧТО СЛЕДУЮЩИЙ САНКЦИОННЫЙ ПАКЕТ ОКАЖЕТСЯ ВОЛШЕБНЫМ.
Dialogue: 0,0:07:45.73,0:07:48.13,Caption,,0,0,0,,ДОСТАТОЧНО ОТКРЫТЬ ЧУЖУЮ ЯЧЕЙКУ И РАСПОРЯДИТЬСЯ
Dialogue: 0,0:07:48.13,0:07:51.65,Caption,,0,0,0,,СОДЕРЖИМЫМ. ВОТ ПОЧЕМУ ВОПРОС ВОЗВРАЩАЕТСЯ НА СТОЛ С
Dialogue: 0,0:07:51.65,0:07:54.85,Caption,,0,0,0,,УПОРСТВОМ ПЛОХО ЗАКРЫВАЮЩЕГОСЯ ЯЩИКА. ПОСЛЕДСТВИЯ
Dialogue: 0,0:07:54.93,0:07:58.61,Caption,,0,0,0,,ТАМ ПОНИМАЮТ. ЕВРОКЛИР ОБЪЯСНЯЕТ ИХ ЯСНО. РЕЧЬ ИДЁТ
Dialogue: 0,0:07:58.72,0:08:03.01,Caption,,0,0,0,,О ДОВЕРИИ, ОТТОКЕ КАПИТАЛА И РЕПУТАЦИИ ВСЕЙ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:08:03.01,0:08:06.29,Caption,,0,0,0,,ФИНАНСОВОЙ ПЛОЩАДКИ. НО ЕСЛИ ЕВРОПА НАМЕРЕНА ДАЛЬШЕ
Dialogue: 0,0:08:06.29,0:08:10.53,Caption,,0,0,0,,ОПЛАЧИВАТЬ ПОДДЕРЖКУ УКРАИНЫ, ОДНОВРЕМЕННО УСИЛИВАЯ ДАВЛЕНИЕ НА РОССИЮ,
Dialogue: 0,0:08:10.85,0:08:13.89,Caption,,0,0,0,,АКТИВЫ В КОНЦЕ КОНЦОВ КОНФИСКУЮТ. ДРУГОГО СТОЛЬ
Dialogue: 0,0:08:13.89,0:08:16.69,Caption,,0,0,0,,КРУПНОГО И ДОСТУПНОГО ФИНАНСОВОГО ИНСТРУМЕНТА У НЕЁ
Dialogue: 0,0:08:16.69,0:08:18.85,Caption,,0,0,0,,ПОЧТИ НЕ ОСТАЛОСЬ. РИСК ИЗВЕСТЕН,
Dialogue: 0,0:08:19.09,0:08:22.69,Caption,,0,0,0,,ЦЕНА ПОНЯТНА, РУКА ВСЁ РАВНО ПОТЯНЕТСЯ К ЗАМКУ. ТОЛЬКО НЕ
Dialogue: 0,0:08:22.69,0:08:26.29,Caption,,0,0,0,,СТОИТ ЖДАТЬ, ЧТО ПОСЛЕ ИЗЪЯТИЯ СРЕДСТВ РОССИЯ ПРОСНЁТСЯ,
Dialogue: 0,0:08:26.53,0:08:29.33,Caption,,0,0,0,,УВИДИТ СТРАШНУЮ НОВОСТЬ И НЕМЕДЛЕННО ВЫКЛЮЧИТ
Dialogue: 0,0:08:29.33,0:08:33.49,Caption,,0,0,0,,СОПРОТИВЛЕНИЕ. СУММА СЕРЬЁЗНАЯ. ШАГ ГРОМКИЙ. УДАР
Dialogue: 0,0:08:33.56,0:08:36.77,Caption,,0,0,0,,ЧУВСТВИТЕЛЬНЫЙ. НО ПРОТИВНИК НЕ ОТКЛЮЧАЕТСЯ ОДНОЙ
Dialogue: 0,0:08:36.77,0:08:40.77,Caption,,0,0,0,,БАНКОВСКОЙ ОПЕРАЦИЕЙ, КАК НАСТОЛЬНАЯ ЛАМПА. МОСКВА СООБЩИЛА,
Dialogue: 0,0:08:41.01,0:08:43.57,Caption,,0,0,0,,ЧТО ПОДГОТОВИЛА ДОПОЛНИТЕЛЬНЫЕ ОТВЕТНЫЕ ДЕЙСТВИЯ НА
Dialogue: 0,0:08:43.57,0:08:46.85,Caption,,0,0,0,,СЛУЧАЙ КОНФИСКАЦИИ. СОДЕРЖАНИЕ ЭТИХ МЕР ПОКА НЕ
Dialogue: 0,0:08:46.85,0:08:50.21,Caption,,0,0,0,,РАСКРЫВАЮТ. ЗАТО НАПРАВЛЕНИЕ ОЧЕВИДНО. ЕСЛИ
Dialogue: 0,0:08:50.29,0:08:53.09,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТРАНЫ ПРИСВАИВАЮТ РОССИЙСКОЕ ИМУЩЕСТВО,
Dialogue: 0,0:08:53.47,0:08:56.05,Caption,,0,0,0,,РОССИЯ НАЧИНАЕТ ИСКАТЬ ЕВРОПЕЙСКИЕ АКТИВЫ,
Dialogue: 0,0:08:56.21,0:09:00.29,Caption,,0,0,0,,ПРАВА, ПРОЕКТЫ И ОПЕРАЦИИ, ПО КОТОРЫМ МОЖНО УДАРИТЬ В ОТВЕТ.
Dialogue: 0,0:09:02.55,0:09:04.71,Caption,,0,0,0,,ТАК НАЧИНАЕТСЯ СПОР ДВУХ КАССИРОВ,
Dialogue: 0,0:09:05.03,0:09:07.51,Caption,,0,0,0,,КАЖДЫЙ ИЗ КОТОРЫХ ЧИТАЕТ ЛЕКЦИЮ О ЗАКОНЕ,
Dialogue: 0,0:09:07.75,0:09:10.63,Caption,,0,0,0,,ОДНОВРЕМЕННО ПЕРЕСЧИТЫВАЯ ИМУЩЕСТВО ДРУГОЙ СТОРОНЫ.
Dialogue: 0,0:09:11.35,0:09:13.51,Caption,,0,0,0,,ОТВЕТНАЯ КВИТАНЦИЯ ЕЩЁ НЕ НАПЕЧАТАНА,
Dialogue: 0,0:09:13.75,0:09:16.55,Caption,,0,0,0,,НО АППАРАТ УЖЕ ПРОГРЕВАЕТСЯ. ТЕПЕРЬ ГЕРМАНИЯ.
Dialogue: 0,0:09:17.19,0:09:19.35,Caption,,0,0,0,,ЗДЕСЬ РЕЧЬ ИДЁТ УЖЕ НЕ О ДЕПОЗИТАРИЯХ И
Dialogue: 0,0:09:19.35,0:09:22.39,Caption,,0,0,0,,ГАЗОВЫХ ПЛАТЕЖАХ. БУНДЕСТАГ ОДОБРИЛ РАСШИРЕНИЕ
Dialogue: 0,0:09:22.39,0:09:25.35,Caption,,0,0,0,,ВОЗМОЖНОСТЕЙ НЕМЕЦКИХ СПЕЦСЛУЖБ. ФЕДЕРАЛЬНАЯ
Dialogue: 0,0:09:25.35,0:09:27.67,Caption,,0,0,0,,РАЗВЕДЫВАТЕЛЬНАЯ СЛУЖБА И ВЕДОМСТВО ПО ЗАЩИТЕ
Dialogue: 0,0:09:27.67,0:09:29.75,Caption,,0,0,0,,КОНСТИТУЦИИ ПОЛУЧАЮТ ИНСТРУМЕНТЫ,
Dialogue: 0,0:09:29.99,0:09:32.95,Caption,,0,0,0,,КОТОРЫМИ МОЖНО РАБОТАТЬ АКТИВНЕЕ И ДАЛЬШЕ ПРЕЖНИХ
Dialogue: 0,0:09:32.95,0:09:37.19,Caption,,0,0,0,,ГРАНИЦ. ЗА РЕФОРМУ ОТДАЛИ ГОЛОСА ТРИСТА ВОСЕМЬ ДЕПУТАТОВ.
Dialogue: 0,0:09:37.50,0:09:40.79,Caption,,0,0,0,,ПРОТИВ ВЫСТУПИЛИ СТО ДЕВЯНОСТО. ЕЩЁ СЕМЬДЕСЯТ ОДИН
Dialogue: 0,0:09:40.79,0:09:43.83,Caption,,0,0,0,,ВОЗДЕРЖАЛСЯ. ЭТО НЕ ПРОСТО РАЗРЕШЕНИЕ ВНИМАТЕЛЬНЕЕ
Dialogue: 0,0:09:43.83,0:09:46.31,Caption,,0,0,0,,ЧИТАТЬ ПЕРЕХВАЧЕННУЮ ПЕРЕПИСКУ ИЗ УДОБНОГО КРЕСЛА.
Dialogue: 0,0:09:46.71,0:09:49.51,Caption,,0,0,0,,РАЗВЕДКА ГЕРМАНИИ СМОЖЕТ ПРОВОДИТЬ АКТИВНЫЕ ОПЕРАЦИИ
Dialogue: 0,0:09:49.59,0:09:53.83,Caption,,0,0,0,,ЗА ПРЕДЕЛАМИ СТРАНЫ. В ЕЁ РАСПОРЯЖЕНИИ ОКАЖУТСЯ ВОЗМОЖНОСТИ ПРОНИКАТЬ В
Dialogue: 0,0:09:53.83,0:09:57.03,Caption,,0,0,0,,ИНФОРМАЦИОННЫЕ СИСТЕМЫ, НАРУШАТЬ РАБОТУ СЕРВЕРОВ,
Dialogue: 0,0:09:57.33,0:09:59.03,Caption,,0,0,0,,ВОЗДЕЙСТВОВАТЬ НА ПРЕДПРИЯТИЯ,
Dialogue: 0,0:09:59.19,0:10:01.35,Caption,,0,0,0,,УЧАСТВУЮЩИЕ В ВЫПУСКЕ БЕСПИЛОТНИКОВ,
Dialogue: 0,0:10:01.59,0:10:04.95,Caption,,0,0,0,,ВМЕШИВАТЬСЯ В ОРУЖЕЙНЫЕ ЦЕПОЧКИ ПОСТАВОК И ОТКЛЮЧАТЬ
Dialogue: 0,0:10:05.03,0:10:07.75,Caption,,0,0,0,,ОТДЕЛЬНЫЕ ТЕХНИЧЕСКИЕ КОМПЛЕКСЫ. УРОВЕНЬ ИГРЫ
Dialogue: 0,0:10:07.75,0:10:11.27,Caption,,0,0,0,,СТАНОВИТСЯ ДРУГИМ. ВОПРОС ПРЕДЕЛЬНО ПРЯМОЙ. НА КОМ
Dialogue: 0,0:10:11.27,0:10:13.99,Caption,,0,0,0,,ГЕРМАНИЯ СОБИРАЕТСЯ ОПРОБОВАТЬ ЭТИ ВОЗМОЖНОСТИ?
Dialogue: 0,0:10:14.38,0:10:17.03,Caption,,0,0,0,,ОДНАКО РОССИЙСКИМ НАПРАВЛЕНИЕМ НЕМЕЦКАЯ РЕФОРМА НЕ
Dialogue: 0,0:10:17.03,0:10:22.75,Caption,,0,0,0,,ИСЧЕРПЫВАЕТСЯ. У СПЕЦСЛУЖБ РАСШИРЯЮТСЯ ВОЗМОЖНОСТИ И ВНУТРИ
Dialogue: 0,0:10:22.83,0:10:25.31,Caption,,0,0,0,,ГЕРМАНИИ. ПРИ ОПРЕДЕЛЁННЫХ УСЛОВИЯХ СОТРУДНИКИ
Dialogue: 0,0:10:25.39,0:10:29.63,Caption,,0,0,0,,СМОГУТ ВХОДИТЬ В ПОМЕЩЕНИЯ, ЧТОБЫ ВОЗДЕЙСТВОВАТЬ НА ТЕХНИЧЕСКИЕ УСТРОЙСТВА.
Dialogue: 0,0:10:30.04,0:10:34.51,Caption,,0,0,0,,ЛЕВЫЕ ПРЕДУПРЕЖДАЮТ, ЧТО ТАЙНЫЕ ВЕДОМСТВА ПОЛУЧАЮТ ЧРЕЗМЕРНУЮ СИЛУ.
Dialogue: 0,0:10:34.91,0:10:37.47,Caption,,0,0,0,,"ЗЕЛЁНЫЕ" СПОРЯТ О ДОПУСТИМОСТИ ПРИВЛЕЧЕНИЯ
Dialogue: 0,0:10:37.47,0:10:40.59,Caption,,0,0,0,,НЕСОВЕРШЕННОЛЕТНИХ К СОТРУДНИЧЕСТВУ. ЗАКОН ТАКЖЕ
Dialogue: 0,0:10:40.67,0:10:42.91,Caption,,0,0,0,,ПОЗВОЛЯЕТ ОГРАНИЧИВАТЬ ОБМЕН РАЗВЕДЫВАТЕЛЬНОЙ
Dialogue: 0,0:10:42.91,0:10:45.71,Caption,,0,0,0,,ИНФОРМАЦИЕЙ МЕЖДУ ФЕДЕРАЛЬНЫМ УРОВНЕМ И ЗЕМЛЯМИ,
Dialogue: 0,0:10:46.03,0:10:50.11,Caption,,0,0,0,,ЕСЛИ ЕСТЬ ОПАСЕНИЕ, ЧТО СЕКРЕТНЫЕ СВЕДЕНИЯ МОГУТ УТЕЧЬ. И В ЭТОМ
Dialogue: 0,0:10:50.19,0:10:53.23,Caption,,0,0,0,,МЕСТЕ ВОЗНИКАЕТ ПАРТИЯ АДГ. ГЕРМАНИЯ,
Dialogue: 0,0:10:53.38,0:10:56.59,Caption,,0,0,0,,РАЗУМЕЕТСЯ, НЕ ОБНАРУЖИЛА РАЗВЕДЫВАТЕЛЬНУЮ ДЕЯТЕЛЬНОСТЬ НА
Dialogue: 0,0:10:56.67,0:10:59.71,Caption,,0,0,0,,ПРОШЛОЙ НЕДЕЛЕ. ТАКИЕ СТРУКТУРЫ ПЕРЕЖИВАЮТ КАБИНЕТЫ
Dialogue: 0,0:10:59.71,0:11:02.59,Caption,,0,0,0,,МИНИСТРОВ И РЕДКО ИСЧЕЗАЮТ ВМЕСТЕ С ЧЕЛОВЕКОМ,
Dialogue: 0,0:11:02.75,0:11:06.03,Caption,,0,0,0,,ПОДПИСАВШИМ ОЧЕРЕДНУЮ РЕФОРМУ. КАНЦЛЕРЫ УХОДЯТ.
Dialogue: 0,0:11:06.31,0:11:09.55,Caption,,0,0,0,,КОАЛИЦИИ РАССЫПАЮТСЯ. РУКОВОДИТЕЛИ ВЕДОМСТВ МЕНЯЮТ
Dialogue: 0,0:11:09.63,0:11:12.11,Caption,,0,0,0,,КАБИНЕТЫ. НО ИСТОЧНИКИ, АРХИВЫ,
Dialogue: 0,0:11:12.35,0:11:17.07,Caption,,0,0,0,,ТЕХНИЧЕСКИЕ КОМПЛЕКСЫ, СВЯЗИ И НАКОПЛЕННЫЕ СВЕДЕНИЯ ОСТАЮТСЯ. ПОЭТОМУ
Dialogue: 0,0:11:17.07,0:11:19.55,Caption,,0,0,0,,ВАЖНЕЕ НЕ СЕГОДНЯШНЯЯ РЕЧЬ ВОЗЛЕ МИКРОФОНА,
Dialogue: 0,0:11:19.86,0:11:22.83,Caption,,0,0,0,,А ИНСТРУМЕНТ, КОТОРЫЙ ГОСУДАРСТВО КЛАДЁТ СЕБЕ В СЕЙФ.
Dialogue: 0,0:11:23.39,0:11:26.19,Caption,,0,0,0,,РЕЧЬ ЗАКОНЧИТСЯ ЧЕРЕЗ ДЕСЯТЬ МИНУТ. ПОЛНОМОЧИЕ
Dialogue: 0,0:11:26.19,0:11:29.07,Caption,,0,0,0,,ОСТАНЕТСЯ НА ГОДЫ. КАПИТАЛ МОЖНО ЗАМОРОЗИТЬ.
Dialogue: 0,0:11:29.23,0:11:32.83,Caption,,0,0,0,,ПОСТАВЩИКА ГАЗА МОЖНО ЗАМЕНИТЬ. НОВЫЙ СПИСОК САНКЦИЙ
Dialogue: 0,0:11:32.83,0:11:35.07,Caption,,0,0,0,,МОЖНО ВЫПУСТИТЬ К СЛЕДУЮЩЕМУ ЗАСЕДАНИЮ.
Dialogue: 0,0:11:37.27,0:11:39.83,Caption,,0,0,0,,А РАЗВЕДЫВАТЕЛЬНЫЕ ВОЗМОЖНОСТИ ПОСЛЕ РАСШИРЕНИЯ
Dialogue: 0,0:11:39.83,0:11:42.95,Caption,,0,0,0,,ПОЧТИ НИКОГДА НЕ УМЕНЬШАЮТСЯ ПО ПЕРВОМУ ВЕЖЛИВОМУ
Dialogue: 0,0:11:43.03,0:11:46.15,Caption,,0,0,0,,ТРЕБОВАНИЮ. ГОСУДАРСТВЕННЫЙ АППАРАТ ПЛОХО РАССТАЁТСЯ
Dialogue: 0,0:11:46.23,0:11:51.43,Caption,,0,0,0,,С ТЕМ, ЧТО ОДНАЖДЫ ПОЛУЧИЛ. ВМЕСТЕ ЭТИ СОБЫТИЯ СКЛАДЫВАЮТСЯ В ЯСНУЮ КАРТИНУ.
Dialogue: 0,0:11:51.83,0:11:55.19,Caption,,0,0,0,,ЕВРОПА ПЕРЕБИРАЕТ НОВЫЕ СПОСОБЫ ДАВЛЕНИЯ НА РОССИЮ.
Dialogue: 0,0:11:55.51,0:11:57.67,Caption,,0,0,0,,В ХОД ИДУТ ОГРАНИЧЕНИЯ, ДЕНЬГИ,
Dialogue: 0,0:11:57.84,0:12:01.19,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИЕ МАРШРУТЫ И ТАЙНЫЕ ОПЕРАЦИИ. ТОЛЬКО
Dialogue: 0,0:12:01.19,0:12:03.99,Caption,,0,0,0,,БЕСПЛАТНЫХ СПОСОБОВ В ЭТОЙ КОРОБКЕ УЖЕ НЕ ОСТАЛОСЬ.
Dialogue: 0,0:12:04.39,0:12:07.03,Caption,,0,0,0,,ЗАМЕНА ГАЗА УВЕЛИЧИВАЕТ РАСХОДЫ ПОТРЕБИТЕЛЕЙ.
Dialogue: 0,0:12:07.34,0:12:10.23,Caption,,0,0,0,,САНКЦИИ СОПРОВОЖДАЮТСЯ ПОКУПКОЙ РОССИЙСКОГО СПГ НА
Dialogue: 0,0:12:10.23,0:12:13.67,Caption,,0,0,0,,МИЛЛИАРДЫ ЕВРО. КОНФИСКАЦИЯ АКТИВОВ ГРОЗИТ УДАРОМ ПО
Dialogue: 0,0:12:13.67,0:12:16.39,Caption,,0,0,0,,ДОВЕРИЮ К ЕВРОПЕЙСКОЙ СИСТЕМЕ ХРАНЕНИЯ КАПИТАЛА.
Dialogue: 0,0:12:16.64,0:12:19.75,Caption,,0,0,0,,УСИЛЕНИЕ РАЗВЕДКИ РАДИ ВНЕШНЕГО ПРОТИВНИКА ОТКРЫВАЕТ
Dialogue: 0,0:12:19.75,0:12:22.39,Caption,,0,0,0,,СПОР О ПРИМЕНЕНИИ НОВЫХ ВОЗМОЖНОСТЕЙ ВНУТРИ
Dialogue: 0,0:12:22.39,0:12:25.27,Caption,,0,0,0,,ГЕРМАНИИ. ПРИДУМАТЬ ЕЩЁ ОДИН ИНСТРУМЕНТ ЕВРОПА
Dialogue: 0,0:12:25.27,0:12:27.75,Caption,,0,0,0,,СУМЕЕТ. С ИЗОБРЕТАТЕЛЬНОСТЬЮ ТАМ ПОРЯДОК,
Dialogue: 0,0:12:28.00,0:12:30.55,Caption,,0,0,0,,ОСОБЕННО КОГДА ПЛАТИТЬ СНАЧАЛА ДОЛЖЕН КТО ТО ДРУГОЙ.
Dialogue: 0,0:12:30.97,0:12:33.35,Caption,,0,0,0,,НО ГЛАВНЫЙ ВОПРОС УЖЕ НЕ В КОЛИЧЕСТВЕ ПРИДУМАННЫХ
Dialogue: 0,0:12:33.35,0:12:35.99,Caption,,0,0,0,,МЕР. СКОЛЬКО ТАКИХ РЕШЕНИЙ МОЖНО ПРИНЯТЬ,
Dialogue: 0,0:12:36.24,0:12:38.95,Caption,,0,0,0,,ПРЕЖДЕ ЧЕМ ОСНОВНАЯ ЧАСТЬ ИХ СТОИМОСТИ НАЧНЁТ
Dialogue: 0,0:12:38.95,0:12:41.83,Caption,,0,0,0,,ВОЗВРАЩАТЬСЯ ЕВРОПЕЙСКИМ СТРАНАМ ЧЕРЕЗ ДОРОГУЮ
Dialogue: 0,0:12:41.83,0:12:46.39,Caption,,0,0,0,,ЭНЕРГИЮ, БЕГСТВО КАПИТАЛА, ОТВЕТНЫЕ КОНФИСКАЦИИ И СПЕЦСЛУЖБЫ,
Dialogue: 0,0:12:46.58,0:12:49.19,Caption,,0,0,0,,ПОЛУЧИВШИЕ СЛИШКОМ УДОБНЫЙ ДОСТУП К ВНУТРЕННЕЙ
Dialogue: 0,0:12:49.19,0:12:52.15,Caption,,0,0,0,,ЖИЗНИ? РОССИЙСКИЕ СРЕДСТВА НАХОДЯТСЯ БЛИЗКО.
Dialogue: 0,0:12:54.44,0:12:58.76,Caption,,0,0,0,,ИХ НЕ НАДО ИСКАТЬ, ПЕРЕВОЗИТЬ ИЛИ УБЕЖДАТЬ ПРИБЫТЬ ДОБРОВОЛЬНО. ПОЭТОМУ
Dialogue: 0,0:12:58.76,0:13:01.32,Caption,,0,0,0,,ЕВРОПА ОПЯТЬ СМОТРИТ НА НИХ КАК НА ЗАПАСНОЙ
Dialogue: 0,0:13:01.32,0:13:04.28,Caption,,0,0,0,,КОШЕЛЁК. ТОЛЬКО ВСКРЫТИЕ ЭТОЙ КАССЫ СТАНЕТ
Dialogue: 0,0:13:04.28,0:13:07.08,Caption,,0,0,0,,НЕОБРАТИМЫМ ШАГОМ. ДЕНЬГИ ПОТРАТИТЬ НЕТРУДНО.
Dialogue: 0,0:13:07.48,0:13:09.64,Caption,,0,0,0,,ГОРАЗДО СЛОЖНЕЕ ПОТОМ УБЕДИТЬ ВЕСЬ МИР,
Dialogue: 0,0:13:09.80,0:13:12.60,Caption,,0,0,0,,ЧТО ЧУЖИЕ КОШЕЛЬКИ В ЕВРОПЕ ПО ПРЕЖНЕМУ СЧИТАЮТСЯ
Dialogue: 0,0:13:12.68,0:13:13.08,Caption,,0,0,0,,ЧУЖИМИ.
