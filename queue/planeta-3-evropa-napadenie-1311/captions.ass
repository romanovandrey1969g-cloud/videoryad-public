Dialogue: 0,0:00:00.12,0:00:02.36,Caption,,0,0,0,,ЕВРОПА ОПЯТЬ РАЗВОРАЧИВАЕТ ПУШКИ НА ВОСТОК,
Dialogue: 0,0:00:02.74,0:00:04.84,Caption,,0,0,0,,НО ВО ФРАНЦИИ ВНЕЗАПНО РЕШИЛИ ПРОВЕРИТЬ,
Dialogue: 0,0:00:05.16,0:00:07.40,Caption,,0,0,0,,НЕ НАПРАВЛЕН ЛИ КАКОЙ НИБУДЬ СТВОЛ ЕЩЁ И
Dialogue: 0,0:00:07.40,0:00:10.44,Caption,,0,0,0,,В СОСЕДНЕЕ ОКНО. БРИТАНИЯ ТРЕБУЕТ ДАВИТЬ СИЛЬНЕЕ,
Dialogue: 0,0:00:10.76,0:00:12.68,Caption,,0,0,0,,НАТО ПЕРЕКРАИВАЕТ ВОЕННЫЕ ПЛАНЫ,
Dialogue: 0,0:00:12.85,0:00:15.80,Caption,,0,0,0,,ГЕРМАНИЯ ОБЗАВОДИТСЯ ДАЛЬНОБОЙНЫМ ОРУЖИЕМ. И ТОЛЬКО
Dialogue: 0,0:00:15.88,0:00:18.44,Caption,,0,0,0,,ПАРИЖ ВМЕСТО ДРУЖНЫХ ОВАЦИЙ СПРАШИВАЕТ БЕРЛИН,
Dialogue: 0,0:00:18.79,0:00:21.64,Caption,,0,0,0,,КТО ПОЛУЧИТ ПРАВО ВЫБИРАТЬ ЦЕЛЬ И НАЖИМАТЬ КНОПКУ.
Dialogue: 0,0:00:22.08,0:00:24.52,Caption,,0,0,0,,ВОПРОС ДЛЯ ФРАНЦУЗОВ НЕ ПРАЗДНЫЙ. ВООРУЖЁННОГО
Dialogue: 0,0:00:24.60,0:00:27.80,Caption,,0,0,0,,СОСЕДА ОНИ УЖЕ ВИДЕЛИ. ОБЪЯСНЕНИЯ ТОГДА ТОЖЕ ЗВУЧАЛИ
Dialogue: 0,0:00:27.80,0:00:32.60,Caption,,0,0,0,,УБЕДИТЕЛЬНО. ПРАВДА, НЕДОЛГО. ПОДПИШИТЕСЬ НА КАНАЛ. ЗДЕСЬ СЕГОДНЯШНИЕ
Dialogue: 0,0:00:32.60,0:00:34.76,Caption,,0,0,0,,ЗАЯВЛЕНИЯ НЕ ЖИВУТ ОТДЕЛЬНО ОТ ИСТОРИИ,
Dialogue: 0,0:00:34.92,0:00:37.80,Caption,,0,0,0,,КОТОРАЯ ИНОГДА ВОЗВРАЩАЕТСЯ БЕЗ ПРИГЛАШЕНИЯ И СРАЗУ
Dialogue: 0,0:00:37.80,0:00:39.48,Caption,,0,0,0,,ТРЕБУЕТ ЛУЧШЕЕ МЕСТО ЗА СТОЛОМ.
Dialogue: 0,0:00:40.11,0:00:42.68,Caption,,0,0,0,,ФРАНЦУЗСКИМ ВОЕННЫМ ПОНАДОБИЛИСЬ ТОЧНЫЕ ОТВЕТЫ ПО
Dialogue: 0,0:00:42.68,0:00:45.88,Caption,,0,0,0,,НЕМЕЦКИМ ДАЛЬНОБОЙНЫМ СИСТЕМАМ. КТО ОТДАЁТ ПРИКАЗ НА
Dialogue: 0,0:00:45.88,0:00:48.60,Caption,,0,0,0,,ПРИМЕНЕНИЕ? НАСКОЛЬКО ДАЛЕКО ПОЛЕТЯТ РАКЕТЫ?
Dialogue: 0,0:00:48.81,0:00:51.16,Caption,,0,0,0,,КАКИЕ ЦЕЛИ БУДУТ СЧИТАТЬСЯ ДОПУСТИМЫМИ?
Dialogue: 0,0:00:51.48,0:00:55.48,Caption,,0,0,0,,И КТО СТАНЕТ ОТВЕЧАТЬ, ЕСЛИ ПОСЛЕ НЕМЕЦКОГО ЗАПУСКА РОССИЙСКАЯ СТОРОНА
Dialogue: 0,0:00:55.48,0:00:58.36,Caption,,0,0,0,,РЕШИТ, ЧТО РЕЧЬ ПОШЛА УЖЕ НЕ ОБ ОБЫЧНОМ УДАРЕ,
Dialogue: 0,0:00:58.59,0:01:03.40,Caption,,0,0,0,,А О СТРАТЕГИЧЕСКОЙ УГРОЗЕ? СЛОВО "СДЕРЖИВАНИЕ" ВООБЩЕ ОЧЕНЬ УДОБНОЕ. ПОКА
Dialogue: 0,0:01:03.48,0:01:08.04,Caption,,0,0,0,,РАКЕТА СТОИТ В АНГАРЕ, ОНО ЗВУЧИТ ПОЧТИ УСПОКАИВАЮЩЕ. НО ПОСЛЕ СТАРТА
Dialogue: 0,0:01:08.25,0:01:10.92,Caption,,0,0,0,,УСПОКАИВАТЬ ПРИХОДИТСЯ УЖЕ СОВСЕМ ДРУГИХ ЛЮДЕЙ И
Dialogue: 0,0:01:10.92,0:01:12.92,Caption,,0,0,0,,ОБЫЧНО ПО ОЧЕНЬ ДОРОГОМУ ТЕЛЕФОНУ.
Dialogue: 0,0:01:15.20,0:01:19.60,Caption,,0,0,0,,КАК СООБЩИЛА FINANCIAL TIMES, ПАРИЖ ПОТРЕБОВАЛ ОТ БЕРЛИНА РАЗЪЯСНИТЬ БУДУЩИЙ
Dialogue: 0,0:01:19.68,0:01:22.40,Caption,,0,0,0,,ПОРЯДОК ПРИМЕНЕНИЯ НОВЫХ СИСТЕМ БОЛЬШОЙ ДАЛЬНОСТИ.
Dialogue: 0,0:01:22.87,0:01:26.32,Caption,,0,0,0,,ЭТО НЕ ОПЫТНЫЙ ОБРАЗЕЦ, КОТОРЫЙ ГЕНЕРАЛЫ ПОКАЖУТ НА ВЫСТАВКЕ,
Dialogue: 0,0:01:26.49,0:01:28.40,Caption,,0,0,0,,СФОТОГРАФИРУЮТСЯ РЯДОМ И ЗАБУДУТ.
Dialogue: 0,0:01:28.95,0:01:31.60,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТРАНЫ НАПРАВЛЯЮТ ДЕСЯТКИ МИЛЛИАРДОВ
Dialogue: 0,0:01:31.60,0:01:35.84,Caption,,0,0,0,,ЕВРО НА ОРУЖИЕ, СПОСОБНОЕ ПОРАЖАТЬ ЦЕЛИ ДАЛЕКО ЗА НЫНЕШНЕЙ ЗОНОЙ
Dialogue: 0,0:01:35.84,0:01:38.40,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЙ. ГЕРМАНИЯ И БРИТАНИЯ СТРОЯТ
Dialogue: 0,0:01:38.40,0:01:42.72,Caption,,0,0,0,,ВОЗМОЖНОСТИ, РАССЧИТАННЫЕ НА КУДА БОЛЬШУЮ ГЛУБИНУ. В ЭТОТ МОМЕНТ
Dialogue: 0,0:01:42.80,0:01:45.60,Caption,,0,0,0,,У ФРАНЦИИ ПРОСЫПАЕТСЯ ПАМЯТЬ. ПРИЧЁМ ПАМЯТЬ НЕ
Dialogue: 0,0:01:45.60,0:01:50.40,Caption,,0,0,0,,МУЗЕЙНАЯ, А ТА, КОТОРАЯ ЗНАЕТ АДРЕС СОСЕДА И ПОМНИТ,
Dialogue: 0,0:01:50.56,0:01:52.40,Caption,,0,0,0,,ОТКУДА РАНЬШЕ ДОНОСИЛСЯ ГРОХОТ.
Dialogue: 0,0:01:53.03,0:01:56.00,Caption,,0,0,0,,ОТНОШЕНИЯ ПАРИЖА И БЕРЛИНА НАСЧИТЫВАЮТ СТОЛЬКО ВОЙН,
Dialogue: 0,0:01:56.30,0:01:59.12,Caption,,0,0,0,,ЧТО ДЛЯ НИХ ВПОРУ ЗАВОДИТЬ ОТДЕЛЬНУЮ СЕМЕЙНУЮ ПАПКУ.
Dialogue: 0,0:01:59.58,0:02:02.32,Caption,,0,0,0,,ФРАНКО ПРУССКАЯ ВОЙНА ПРИНЕСЛА ФРАНЦИИ ПОРАЖЕНИЕ.
Dialogue: 0,0:02:02.57,0:02:05.92,Caption,,0,0,0,,ЗАТЕМ ПРИШЛА ПЕРВАЯ МИРОВАЯ. ПОТОМ ВТОРАЯ МИРОВАЯ.
Dialogue: 0,0:02:06.24,0:02:08.88,Caption,,0,0,0,,ТЕПЕРЬ МЕЖДУ СТРАНАМИ НЕТ ПОГРАНИЧНЫХ ШЛАГБАУМОВ,
Dialogue: 0,0:02:09.12,0:02:13.68,Caption,,0,0,0,,ЗАТО ЕСТЬ ОБЩИЙ РЫНОК, СОВМЕСТНЫЕ ЗАСЕДАНИЯ И ТОРЖЕСТВЕННЫЕ РЕЧИ О
Dialogue: 0,0:02:13.68,0:02:17.04,Caption,,0,0,0,,ЕВРОПЕЙСКОМ ЕДИНСТВЕ. НО ОТМЕНА ПАСПОРТНОГО КОНТРОЛЯ
Dialogue: 0,0:02:17.12,0:02:20.16,Caption,,0,0,0,,НЕ СТИРАЕТ НАЦИОНАЛЬНУЮ ПАМЯТЬ. ПОЭТОМУ НЕМЕЦКОЕ
Dialogue: 0,0:02:20.16,0:02:22.64,Caption,,0,0,0,,ПЕРЕВООРУЖЕНИЕ ФРАНЦИЯ ОЦЕНИВАЕТ СРАЗУ С ДВУХ
Dialogue: 0,0:02:22.72,0:02:24.56,Caption,,0,0,0,,СТОРОН. ПЕРВАЯ КАСАЕТСЯ РОССИИ.
Dialogue: 0,0:02:26.82,0:02:29.62,Caption,,0,0,0,,ЕСЛИ РАКЕТА ИЗ ГЕРМАНИИ УЙДЁТ ДАЛЕКО НА РОССИЙСКУЮ
Dialogue: 0,0:02:29.62,0:02:32.82,Caption,,0,0,0,,ТЕРРИТОРИЮ, МОСКВА МОЖЕТ ОТВЕТИТЬ УЖЕ НЕ В ПРЕДЕЛАХ ТОЙ
Dialogue: 0,0:02:32.82,0:02:36.50,Caption,,0,0,0,,ПЛОЩАДКИ, ГДЕ ЕВРОПЕЙЦЫ ПРИВЫКЛИ ИСПЫТЫВАТЬ ЧУЖОЕ ТЕРПЕНИЕ.
Dialogue: 0,0:02:37.11,0:02:40.82,Caption,,0,0,0,,ВТОРАЯ КАСАЕТСЯ САМОЙ ЕВРОПЫ. ГЕРМАНИЯ ШАГ ЗА ШАГОМ
Dialogue: 0,0:02:40.82,0:02:43.70,Caption,,0,0,0,,ПОЛУЧАЕТ ШАНС СТАТЬ ЕЁ КРУПНЕЙШЕЙ ОБЫЧНОЙ ВОЕННОЙ
Dialogue: 0,0:02:43.70,0:02:46.98,Caption,,0,0,0,,СИЛОЙ. И ТОГДА ВОПРОС ЗВУЧИТ УЖЕ ИНАЧЕ. КТО
Dialogue: 0,0:02:46.98,0:02:49.54,Caption,,0,0,0,,ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ БУДЕТ ЗАДАВАТЬ ПРАВИЛА ВНУТРИ
Dialogue: 0,0:02:49.54,0:02:53.46,Caption,,0,0,0,,СОЮЗА, ГДЕ БЕРЛИН РАСПОЛАГАЕТ САМОЙ МОЩНОЙ АРМИЕЙ И
Dialogue: 0,0:02:53.46,0:02:55.22,Caption,,0,0,0,,СЕРЬЁЗНОЙ ВОЕННОЙ ПРОМЫШЛЕННОСТЬЮ?
Dialogue: 0,0:02:55.86,0:02:58.34,Caption,,0,0,0,,ВОТ ЗДЕСЬ ЕВРОПЕЙСКАЯ БУХГАЛТЕРИЯ ПЕРЕСТАЁТ БЫТЬ
Dialogue: 0,0:02:58.42,0:03:01.62,Caption,,0,0,0,,СКУЧНОЙ. ЭММАНУЭЛЬ МАКРОН ДАВНО ПРЕДЛАГАЕТ РАСШИРИТЬ
Dialogue: 0,0:03:01.62,0:03:04.02,Caption,,0,0,0,,РОЛЬ ФРАНЦУЗСКИХ ЯДЕРНЫХ СИЛ В ЗАЩИТЕ ЕВРОПЫ.
Dialogue: 0,0:03:04.49,0:03:07.14,Caption,,0,0,0,,СОЮЗНИКАМ ОБЕЩАЮТ ДОПОЛНИТЕЛЬНУЮ УВЕРЕННОСТЬ.
Dialogue: 0,0:03:07.38,0:03:10.82,Caption,,0,0,0,,ГЕРМАНИЯ НАКАПЛИВАЕТ ОБЫЧНЫЕ ВООРУЖЕНИЯ. БРИТАНИЯ
Dialogue: 0,0:03:10.82,0:03:13.86,Caption,,0,0,0,,РАЗВИВАЕТ СОБСТВЕННЫЕ СРЕДСТВА. ПОЛЬША СТРЕМИТЕЛЬНО
Dialogue: 0,0:03:13.86,0:03:17.06,Caption,,0,0,0,,УВЕЛИЧИВАЕТ АРМИЮ. ФОРМАЛЬНО КАЖДЫЙ ВКЛАДЫВАЕТСЯ В
Dialogue: 0,0:03:17.06,0:03:20.42,Caption,,0,0,0,,ОДНУ ОБЩУЮ ЗАДАЧУ. НО ПАРИЖ ОТЧЕГО ТО СПОКОЙНЕЕ
Dialogue: 0,0:03:20.50,0:03:22.82,Caption,,0,0,0,,НЕ СТАНОВИТСЯ. ПОЛУЧАЕТСЯ ПОЧТИ ОБРАЗЦОВАЯ
Dialogue: 0,0:03:22.82,0:03:27.14,Caption,,0,0,0,,КОНСТРУКЦИЯ. ФРАНЦИЯ ПОМНИТ, ЧЕМ ЗАКАНЧИВАЛОСЬ УСИЛЕНИЕ ГЕРМАНИИ,
Dialogue: 0,0:03:27.38,0:03:32.42,Caption,,0,0,0,,САМА ПОМОГАЕТ ЭТОМУ УСИЛЕНИЮ, А СВЕРХУ ЕЩЁ ПРЕДЛАГАЕТ ПРИКРЫТЬ ПРОЦЕСС ФРАНЦУЗСКИМ
Dialogue: 0,0:03:32.42,0:03:35.46,Caption,,0,0,0,,ЯДЕРНЫМ ПОТЕНЦИАЛОМ. ОСТАЛОСЬ ТОЛЬКО ВЫДАТЬ БЕРЛИНУ
Dialogue: 0,0:03:35.46,0:03:37.78,Caption,,0,0,0,,КЛЮЧИ И ПОПРОСИТЬ ВЕРНУТЬ ДО ВЕЧЕРА.
Dialogue: 0,0:03:38.39,0:03:41.46,Caption,,0,0,0,,ПАРИЖ, ВЫ УВЕРЕНЫ, ЧТО ЧИТАЛИ ДОГОВОР ЦЕЛИКОМ,
Dialogue: 0,0:03:41.63,0:03:47.67,Caption,,0,0,0,,ВКЛЮЧАЯ МЕЛКИЙ ШРИФТ? ЯДЕРНАЯ ЗАЩИТА НЕ ПОХОЖА НА НАВЕС ОТ ДОЖДЯ.
Dialogue: 0,0:03:47.90,0:03:52.07,Caption,,0,0,0,,НЕЛЬЗЯ ПРИКРЫТЬ ИМ СОЮЗНИКОВ, А ПРИ ПЕРВОМ ГРОМКОМ ХЛОПКЕ СДЕЛАТЬ ВИД,
Dialogue: 0,0:03:52.19,0:03:54.31,Caption,,0,0,0,,ЧТО КАЖДЫЙ СТОЯЛ ПОД СВОИМ ОБЛАКОМ.
Dialogue: 0,0:03:55.27,0:03:57.99,Caption,,0,0,0,,ЕСЛИ НЕМЕЦКОЕ РЕШЕНИЕ О ЗАПУСКЕ ПОВЫШАЕТ РИСК
Dialogue: 0,0:03:57.99,0:04:02.07,Caption,,0,0,0,,БОЛЬШОГО ОТВЕТА, А ФРАНЦИЯ ОБЕЩАЕТ ИГРАТЬ РАСШИРЕННУЮ РОЛЬ В ЯДЕРНОМ
Dialogue: 0,0:04:02.07,0:04:06.15,Caption,,0,0,0,,СДЕРЖИВАНИИ, ВОЗНИКАЕТ ПРАКТИЧЕСКИЙ ВОПРОС. ПРИКАЗ ОТДАЁТ БЕРЛИН,
Dialogue: 0,0:04:06.53,0:04:09.27,Caption,,0,0,0,,НО КОМУ ПРИДЁТСЯ ОСТАНАВЛИВАТЬ ДАЛЬНЕЙШУЮ ЦЕПОЧКУ?
Dialogue: 0,0:04:09.67,0:04:11.99,Caption,,0,0,0,,ПАРИЖ ЯВНО НЕ ХОЧЕТ ОДНАЖДЫ УЗНАТЬ ОТВЕТ ИЗ
Dialogue: 0,0:04:11.99,0:04:14.71,Caption,,0,0,0,,ЭКСТРЕННОГО СООБЩЕНИЯ. РАЗГОВОРЫ О ЕВРОПЕЙСКОМ
Dialogue: 0,0:04:14.71,0:04:17.11,Caption,,0,0,0,,СОГЛАСИИ РЯДОМ С ЭТИМ ВЫГЛЯДЯТ ДЕКОРАТИВНО.
Dialogue: 0,0:04:17.59,0:04:20.63,Caption,,0,0,0,,НАСТОЯЩИЙ СПОР ИДЁТ О ПРАВЕ ПРИНИМАТЬ РЕШЕНИЕ И
Dialogue: 0,0:04:20.63,0:04:23.67,Caption,,0,0,0,,ОБ ОБЯЗАННОСТИ ПЛАТИТЬ ЗА ПОСЛЕДСТВИЯ. У БРИТАНИИ В
Dialogue: 0,0:04:23.67,0:04:28.39,Caption,,0,0,0,,ЭТОМ СПЕКТАКЛЕ СВОЯ РОЛЬ, И СКРОМНОСТЬЮ ОНА НЕ ОТЛИЧАЕТСЯ. БЫВШИЙ СОВЕТНИК
Dialogue: 0,0:04:28.39,0:04:30.23,Caption,,0,0,0,,БРИТАНСКОГО ПРАВИТЕЛЬСТВА ПО НАЦИОНАЛЬНОЙ
Dialogue: 0,0:04:30.23,0:04:32.39,Caption,,0,0,0,,БЕЗОПАСНОСТИ МАРК СЕДВИЛЛ СЧИТАЕТ,
Dialogue: 0,0:04:32.67,0:04:35.35,Caption,,0,0,0,,ЧТО НАТО СЛЕДУЕТ НЕ ОГРАНИЧИВАТЬСЯ ОБОРОНОЙ,
Dialogue: 0,0:04:35.58,0:04:38.15,Caption,,0,0,0,,А СОЗДАВАТЬ ДЛЯ РОССИИ СТРАТЕГИЧЕСКИЕ ТРУДНОСТИ.
Dialogue: 0,0:04:38.47,0:04:43.27,Caption,,0,0,0,,ИНЫМИ СЛОВАМИ, ОДНОГО КРЕПКОГО ЗАБОРА ЛОНДОНУ МАЛО. ОН ПРЕДЛАГАЕТ
Dialogue: 0,0:04:43.35,0:04:45.75,Caption,,0,0,0,,ВРЕМЯ ОТ ВРЕМЕНИ БРОСАТЬ ЧЕРЕЗ НЕГО ЧТО НИБУДЬ
Dialogue: 0,0:04:45.75,0:04:50.31,Caption,,0,0,0,,ТЯЖЁЛОЕ И СМОТРЕТЬ, КТО ВЫЙДЕТ РАЗБИРАТЬСЯ. В ПЕРЕЧНЕ ИДЕЙ ЕСТЬ
Dialogue: 0,0:04:50.31,0:04:54.07,Caption,,0,0,0,,КИБЕРАТАКИ, ДЕЙСТВИЯ ПРОТИВ ТАК НАЗЫВАЕМОГО ТЕНЕВОГО ФЛОТА,
Dialogue: 0,0:04:54.38,0:04:57.19,Caption,,0,0,0,,УДАРЫ ПО РОССИЙСКИМ РАЗВЕДЫВАТЕЛЬНЫМ СЕТЯМ И
Dialogue: 0,0:04:57.19,0:05:03.24,Caption,,0,0,0,,ИНФОРМАЦИОННЫЕ ОПЕРАЦИИ. СЕДВИЛЛ БОЛЬШЕ НЕ ЗАНИМАЕТ ГОСУДАРСТВЕННЫЙ ПОСТ.
Dialogue: 0,0:05:03.63,0:05:05.72,Caption,,0,0,0,,ОДНАКО САМА ЛОГИКА СЛИШКОМ ЗНАКОМА,
Dialogue: 0,0:05:05.88,0:05:08.44,Caption,,0,0,0,,ЧТОБЫ СЧИТАТЬ ЕЁ ЛИЧНОЙ ФАНТАЗИЕЙ ОТСТАВНОГО
Dialogue: 0,0:05:08.44,0:05:11.48,Caption,,0,0,0,,ЧИНОВНИКА. БРИТАНСКИЙ ПОДХОД СОХРАНЯЕТСЯ ГОДАМИ.
Dialogue: 0,0:05:11.88,0:05:15.16,Caption,,0,0,0,,ДАВЛЕНИЕ СЛЕДУЕТ НАРАЩИВАТЬ ЗАРАНЕЕ. ПРОТИВНИКУ НАДО
Dialogue: 0,0:05:15.16,0:05:18.28,Caption,,0,0,0,,СОЗДАВАТЬ НОВЫЕ УГРОЗЫ. ЦЕНА БЕЗДЕЙСТВИЯ ДЛЯ НЕГО
Dialogue: 0,0:05:18.28,0:05:22.52,Caption,,0,0,0,,ДОЛЖНА РАСТИ, А ЦЕНА ИНИЦИАТИВЫ ДЛЯ ЛОНДОНА ЖЕЛАТЕЛЬНО ОСТАВАТЬСЯ
Dialogue: 0,0:05:22.60,0:05:25.00,Caption,,0,0,0,,ГДЕ НИБУДЬ ЗА ЛА МАНШЕМ. ЭТА СХЕМА УЖЕ
Dialogue: 0,0:05:25.00,0:05:27.96,Caption,,0,0,0,,РАБОТАЛА НА НАШИХ ГЛАЗАХ. КОГДА БРИТАНИЯ РЕШИЛА
Dialogue: 0,0:05:28.04,0:05:30.36,Caption,,0,0,0,,ВОССТАНОВИТЬ ПРЯМОЙ ВОЕННЫЙ КАНАЛ С МОСКВОЙ,
Dialogue: 0,0:05:30.76,0:05:33.16,Caption,,0,0,0,,МИРОЛЮБИЕМ ТАМ И НЕ ПАХЛО. ДО ЭТОГО ПЯТЬ
Dialogue: 0,0:05:33.24,0:05:36.28,Caption,,0,0,0,,ЛЕТ ПОДРЯД ГРАНИЦЫ ДОПУСТИМОГО ДВИГАЛИ ВСЁ ДАЛЬШЕ.
Dialogue: 0,0:05:36.59,0:05:39.56,Caption,,0,0,0,,НОВЫЕ РАКЕТЫ, РАЗВЕДЫВАТЕЛЬНАЯ ПОДДЕРЖКА,
Dialogue: 0,0:05:39.80,0:05:44.28,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ РАЗРЕШЕНИЯ, УВЕЛИЧЕНИЕ ДАЛЬНОСТИ ПРИМЕНЕНИЯ. КАЖДЫЙ СЛЕДУЮЩИЙ
Dialogue: 0,0:05:44.36,0:05:47.00,Caption,,0,0,0,,ШАГ ОБЪЯВЛЯЛИ АККУРАТНЫМ И КОНТРОЛИРУЕМЫМ,
Dialogue: 0,0:05:47.19,0:05:49.24,Caption,,0,0,0,,ПОКА ЛЕСТНИЦА НЕ ЗАКОНЧИЛАСЬ ЭТАЖОМ,
Dialogue: 0,0:05:49.40,0:05:51.96,Caption,,0,0,0,,С КОТОРОГО ОТВЕТ МОГ ПРИЛЕТЕТЬ УЖЕ ПО САМОМУ
Dialogue: 0,0:05:51.96,0:05:56.76,Caption,,0,0,0,,ЛОНДОНУ. ТУТ И ВЫЯСНИЛОСЬ, ЧТО ТЕЛЕФОННАЯ СВЯЗЬ ПОЛЕЗНЕЕ ОЧЕРЕДНОЙ ГРОЗНОЙ
Dialogue: 0,0:05:56.76,0:05:59.08,Caption,,0,0,0,,РЕЧИ. СНАЧАЛА СТАВКИ ПОДНИМАЮТ,
Dialogue: 0,0:05:59.26,0:06:01.40,Caption,,0,0,0,,ЗАТЕМ КЛАДУТ РЯДОМ НОМЕР НА СЛУЧАЙ,
Dialogue: 0,0:06:01.68,0:06:04.52,Caption,,0,0,0,,ЕСЛИ ДРУГАЯ СТОРОНА ВОСПРИМЕТ УГРОЗУ ИМЕННО КАК
Dialogue: 0,0:06:04.52,0:06:08.04,Caption,,0,0,0,,УГРОЗУ. УДОБНО. ПОКА РАКЕТЫ ПАДАЮТ НА УКРАИНЕ,
Dialogue: 0,0:06:08.25,0:06:10.76,Caption,,0,0,0,,ЭТО СТРАТЕГИЯ. КОГДА ТРАЕКТОРИЯ МЫСЛЕННО
Dialogue: 0,0:06:10.76,0:06:15.16,Caption,,0,0,0,,ПОВОРАЧИВАЕТ К БРИТАНИИ, НАЧИНАЕТСЯ ГОРЯЧИЙ ИНТЕРЕС К ПРЕДОТВРАЩЕНИЮ
Dialogue: 0,0:06:15.16,0:06:20.48,Caption,,0,0,0,,НЕДОРАЗУМЕНИЙ. ТЕПЕРЬ ТОТ ЖЕ ПОЧЕРК ПОЯВЛЯЕТСЯ В ПРЕДЛОЖЕНИЯХ
Dialogue: 0,0:06:20.48,0:06:23.76,Caption,,0,0,0,,СЕДВИЛЛА. МОСКВЕ ПРЕДЛАГАЮТ ПОСТОЯННО НАПОМИНАТЬ ОБ
Dialogue: 0,0:06:23.76,0:06:26.96,Caption,,0,0,0,,УЯЗВИМОСТИ. ОДНАКО НОРВЕЖСКИЙ ВИЦЕ АДМИРАЛ РУНЕ
Dialogue: 0,0:06:27.04,0:06:30.24,Caption,,0,0,0,,АНДЕРСЕН СМОТРИТ НА ЭТУ БОДРОСТЬ БЕЗ ВОСТОРГА. ПО
Dialogue: 0,0:06:30.32,0:06:33.04,Caption,,0,0,0,,ЕГО СЛОВАМ, НАТО НЕОБХОДИМО УЧИТЫВАТЬ,
Dialogue: 0,0:06:33.32,0:06:35.92,Caption,,0,0,0,,КАК ЕГО ДЕЙСТВИЯ ВЫГЛЯДЯТ С РОССИЙСКОЙ СТОРОНЫ,
Dialogue: 0,0:06:36.16,0:06:39.68,Caption,,0,0,0,,ИНАЧЕ ОДНА ОШИБКА В ОЦЕНКЕ НАМЕРЕНИЙ МОЖЕТ ЗАПУСТИТЬ
Dialogue: 0,0:06:39.68,0:06:43.68,Caption,,0,0,0,,СОБЫТИЯ, КОТОРЫЕ НИКТО НЕ СОБИРАЛСЯ НАЧИНАТЬ. РОБ ДЖОНСОН ИЗ
Dialogue: 0,0:06:43.68,0:06:47.44,Caption,,0,0,0,,ОКСФОРДА ГОВОРИТ ЕЩЁ ПРЯМЕЕ. РОСТ ВОЕННОГО ДАВЛЕНИЯ,
Dialogue: 0,0:06:47.60,0:06:51.44,Caption,,0,0,0,,ПО ЕГО ОЦЕНКЕ, ПРИВЕДЁТ К ОТВЕТНЫМ МЕРАМ. В РЕЗУЛЬТАТЕ ВНУТРИ
Dialogue: 0,0:06:51.44,0:06:54.40,Caption,,0,0,0,,ЗАПАДНОГО ЛАГЕРЯ ОДНОВРЕМЕННО ЗВУЧАТ ТРИ РЕЦЕПТА.
Dialogue: 0,0:06:54.96,0:06:58.56,Caption,,0,0,0,,ЛОНДОНСКАЯ ЛИНИЯ ТРЕБУЕТ ПРИБАВИТЬ НАЖИМ. НОРВЕЖСКИЙ
Dialogue: 0,0:06:58.64,0:07:01.44,Caption,,0,0,0,,ВОЕННЫЙ ПРЕДУПРЕЖДАЕТ О РИСКЕ НЕВЕРНОГО РАСЧЁТА.
Dialogue: 0,0:07:01.97,0:07:04.72,Caption,,0,0,0,,ОКСФОРДСКИЙ СПЕЦИАЛИСТ СОВЕТУЕТ НЕ ЛЕЗТЬ ТУДА,
Dialogue: 0,0:07:04.96,0:07:08.24,Caption,,0,0,0,,ГДЕ НА КАЖДОЕ ДЕЙСТВИЕ ПОСЛЕДУЕТ ВСТРЕЧНОЕ. ЕДИНАЯ
Dialogue: 0,0:07:08.24,0:07:11.36,Caption,,0,0,0,,СТРАТЕГИЯ ПОЛУЧИЛАСЬ РОСКОШНАЯ. ОСТАЛОСЬ ВЫБРАТЬ,
Dialogue: 0,0:07:11.60,0:07:14.40,Caption,,0,0,0,,КАКОЙ ИЗ ТРЁХ ВЗАИМОИСКЛЮЧАЮЩИХ СОВЕТОВ СЧИТАТЬ
Dialogue: 0,0:07:14.42,0:07:18.56,Caption,,0,0,0,,ОБЩИМ. НА ЭТОМ ФОНЕ НАТО НАЧИНАЕТ САМУЮ КРУПНУЮ ПЕРЕДЕЛКУ
Dialogue: 0,0:07:18.64,0:07:21.36,Caption,,0,0,0,,ВОЕННОГО ПЛАНИРОВАНИЯ ЗА ПОСЛЕДНИЕ ДВА ДЕСЯТИЛЕТИЯ.
Dialogue: 0,0:07:21.76,0:07:23.36,Caption,,0,0,0,,ПРЕЖНЯЯ МОДЕЛЬ ПРЕДУСМАТРИВАЛА,
Dialogue: 0,0:07:23.60,0:07:26.40,Caption,,0,0,0,,ЧТО СОЮЗНИКИ СОХРАНЯЮТ ЧАСТЬ СИЛ ДЛЯ КРИЗИСОВ НА
Dialogue: 0,0:07:26.40,0:07:30.16,Caption,,0,0,0,,БЛИЖНЕМ ВОСТОКЕ, В АФРИКЕ И ДРУГИХ УДАЛЁННЫХ РЕГИОНАХ.
Dialogue: 0,0:07:32.43,0:07:36.75,Caption,,0,0,0,,ТЕПЕРЬ ПРИОРИТЕТЫ МЕНЯЮТСЯ, ПОТОМУ ЧТО ОСНОВНОЙ СЦЕНАРИЙ БОЛЬШОГО СТОЛКНОВЕНИЯ
Dialogue: 0,0:07:36.75,0:07:39.23,Caption,,0,0,0,,АЛЬЯНС ВИДИТ УЖЕ НА ЕВРОПЕЙСКОЙ ТЕРРИТОРИИ.
Dialogue: 0,0:07:39.71,0:07:42.51,Caption,,0,0,0,,ВОСЕМНАДЦАТЬ РЕЗЕРВНЫХ БРИГАД ОБЩЕЙ ЧИСЛЕННОСТЬЮ
Dialogue: 0,0:07:42.51,0:07:45.31,Caption,,0,0,0,,ОКОЛО ДЕВЯНОСТА ТЫСЯЧ ВОЕННОСЛУЖАЩИХ ПРЕЖДЕ
Dialogue: 0,0:07:45.31,0:07:47.63,Caption,,0,0,0,,ПРЕДНАЗНАЧАЛИСЬ В ТОМ ЧИСЛЕ ДЛЯ ОПЕРАЦИЙ ЗА
Dialogue: 0,0:07:47.71,0:07:51.87,Caption,,0,0,0,,ПРЕДЕЛАМИ ЕВРОПЫ. ТЕПЕРЬ ДЕРЖАТЬ ТАКОЙ РЕЗЕРВ ПОД ВНЕШНИЕ КРИЗИСЫ
Dialogue: 0,0:07:52.03,0:07:54.91,Caption,,0,0,0,,СЧИТАЮТ МЕНЕЕ НЕОБХОДИМЫМ. ГЛАВНОЕ НАПРАВЛЕНИЕ
Dialogue: 0,0:07:54.99,0:07:57.79,Caption,,0,0,0,,ОКАЗАЛОСЬ ЗНАЧИТЕЛЬНО БЛИЖЕ. ДЛЯ КАЖДОГО УЧАСТНИКА
Dialogue: 0,0:07:57.87,0:07:59.95,Caption,,0,0,0,,РАССЧИТЫВАЮТ ПОТРЕБНОСТЬ В ЛИЧНОМ СОСТАВЕ,
Dialogue: 0,0:08:00.11,0:08:02.51,Caption,,0,0,0,,АВИАЦИИ, ПРОТИВОВОЗДУШНОЙ ОБОРОНЕ,
Dialogue: 0,0:08:02.67,0:08:07.23,Caption,,0,0,0,,РАКЕТАХ И ДРУГИХ СРЕДСТВАХ, НЕОБХОДИМЫХ ДЛЯ КРУПНОГО ПРОТИВОСТОЯНИЯ В ЕВРОПЕ.
Dialogue: 0,0:08:07.70,0:08:10.19,Caption,,0,0,0,,ЭТО УЖЕ НЕ ВРЕМЕННОЕ УСИЛЕНИЕ ОТДЕЛЬНЫХ ЧАСТЕЙ,
Dialogue: 0,0:08:10.45,0:08:13.47,Caption,,0,0,0,,А ПОПЫТКА ЗАНОВО СОБРАТЬ ВЕСЬ ВОЕННЫЙ МЕХАНИЗМ.
Dialogue: 0,0:08:13.77,0:08:16.11,Caption,,0,0,0,,ВАШИНГТОН ПРИ ЭТОМ ПОКАЗЫВАЕТ СТАРЫЙ НОМЕР,
Dialogue: 0,0:08:16.35,0:08:19.31,Caption,,0,0,0,,КОТОРЫЙ НИКОГДА НЕ ТЕРЯЕТ ПОПУЛЯРНОСТИ. АМЕРИКАНСКИХ
Dialogue: 0,0:08:19.31,0:08:22.35,Caption,,0,0,0,,ВОЕННЫХ В ЕВРОПЕ МОЖНО ОСТАВИТЬ МЕНЬШЕ. СОЕДИНЁННЫЕ
Dialogue: 0,0:08:22.35,0:08:24.91,Caption,,0,0,0,,ШТАТЫ ГОТОВЯТСЯ СОКРАТИТЬ ЧАСТЬ КОНТИНГЕНТА,
Dialogue: 0,0:08:25.30,0:08:27.95,Caption,,0,0,0,,А СОЮЗНИКАМ ПРЕДЛАГАЮТ ПОДНЯТЬ ОБОРОННЫЕ ТРАТЫ ДО
Dialogue: 0,0:08:27.95,0:08:31.23,Caption,,0,0,0,,ПЯТИ ПРОЦЕНТОВ ВАЛОВОГО ВНУТРЕННЕГО ПРОДУКТА. ПЯТЬ
Dialogue: 0,0:08:31.31,0:08:35.95,Caption,,0,0,0,,ЛЕТ ЕВРОПЕЙЦЕВ УБЕЖДАЛИ, ЧТО БОРЬБА ОБЩАЯ И ОТВЕТСТВЕННОСТЬ ТОЖЕ ОБЩАЯ.
Dialogue: 0,0:08:36.22,0:08:39.39,Caption,,0,0,0,,ТЕПЕРЬ ОФИЦИАНТ ПРИНЁС СЧЁТ, ПОЛОЖИЛ ЕГО ПЕРЕД ЕВРОПОЙ,
Dialogue: 0,0:08:39.65,0:08:42.43,Caption,,0,0,0,,А АМЕРИКАНСКАЯ ДЕЛЕГАЦИЯ ВНЕЗАПНО ВСПОМНИЛА,
Dialogue: 0,0:08:42.60,0:08:45.07,Caption,,0,0,0,,ЧТО ПРИПАРКОВАЛАСЬ В НЕПОЛОЖЕННОМ МЕСТЕ.
Dialogue: 0,0:08:47.35,0:08:49.35,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ РАЗБОР БЕЗ КАЗЁННЫХ
Dialogue: 0,0:08:49.35,0:08:52.79,Caption,,0,0,0,,ЗАКЛИНАНИЙ, ПОДПИШИТЕСЬ НА КАНАЛ. В КОММЕНТАРИЯХ НАПИШИТЕ,
Dialogue: 0,0:08:53.16,0:08:55.91,Caption,,0,0,0,,КОГО ФРАНЦИЯ ОПАСАЕТСЯ СИЛЬНЕЕ ЧЕРЕЗ ДВАДЦАТЬ ЛЕТ,
Dialogue: 0,0:08:56.15,0:08:58.39,Caption,,0,0,0,,РОССИЮ ИЛИ ВООРУЖЁННУЮ ГЕРМАНИЮ.
Dialogue: 0,0:08:59.26,0:09:01.99,Caption,,0,0,0,,СЛЕДУЮЩЕЙ К НОВОМУ РАСПРЕДЕЛЕНИЮ СИЛ ПОДКЛЮЧАЕТСЯ
Dialogue: 0,0:09:01.99,0:09:06.63,Caption,,0,0,0,,ПОЛЬША. ДОНАЛЬД ТУСК ЗАЯВИЛ, ЧТО СТРАНА СПОСОБНА СПРАВИТЬСЯ С ВНЕШНИМ
Dialogue: 0,0:09:06.63,0:09:09.51,Caption,,0,0,0,,ПРОТИВНИКОМ, СОЗДАЁТ КРУПНЕЙШУЮ АРМИЮ РЕГИОНА,
Dialogue: 0,0:09:09.83,0:09:12.71,Caption,,0,0,0,,А БАЛТИЙСКОЕ МОРЕ СТАНОВИТСЯ ПОЛЬСКИМ. МОРЕ,
Dialogue: 0,0:09:12.80,0:09:16.79,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, О СМЕНЕ СОБСТВЕННИКА ПОКА НЕ УВЕДОМИЛИ. ВОЗМОЖНО,
Dialogue: 0,0:09:17.15,0:09:19.67,Caption,,0,0,0,,ПИСЬМО ПОТЕРЯЛОСЬ МЕЖДУ ВАРШАВОЙ И БЕРЕГОВОЙ
Dialogue: 0,0:09:19.75,0:09:22.39,Caption,,0,0,0,,ОХРАНОЙ. НО ЗА ГРОМКОЙ ФРАЗОЙ СТОИТ СЕРЬЁЗНАЯ
Dialogue: 0,0:09:22.47,0:09:25.75,Caption,,0,0,0,,ЗАЯВКА. ПОЛЬША ДОБИВАЕТСЯ ЦЕНТРАЛЬНОЙ РОЛИ В НОВОЙ
Dialogue: 0,0:09:25.75,0:09:28.55,Caption,,0,0,0,,СИСТЕМЕ БЕЗОПАСНОСТИ СЕВЕРО ВОСТОЧНОЙ ЕВРОПЫ.
Dialogue: 0,0:09:29.11,0:09:32.55,Caption,,0,0,0,,ВАРШАВА МНОГО ЛЕТ НАРАЩИВАЕТ ВООРУЖЁННЫЕ СИЛЫ. РЯДОМ
Dialogue: 0,0:09:32.55,0:09:34.55,Caption,,0,0,0,,НАХОДЯТСЯ КАЛИНИНГРАДСКАЯ ОБЛАСТЬ,
Dialogue: 0,0:09:34.67,0:09:38.71,Caption,,0,0,0,,ГЕРМАНИЯ, СТРАНЫ БАЛТИИ И РОССИЯ. КОГДА НАТО ПЕРЕНОСИТ
Dialogue: 0,0:09:38.71,0:09:40.95,Caption,,0,0,0,,ОСНОВНОЕ ВНИМАНИЕ НА ЕВРОПЕЙСКИЙ ВОСТОК,
Dialogue: 0,0:09:41.27,0:09:44.07,Caption,,0,0,0,,ЗНАЧЕНИЕ ПОЛЬШИ РАСТЁТ АВТОМАТИЧЕСКИ. ЧЕРЕЗ ЕЁ
Dialogue: 0,0:09:44.07,0:09:47.59,Caption,,0,0,0,,ТЕРРИТОРИЮ ПРОХОДЯТ МАРШРУТЫ, ТАМ РАЗМЕЩАЮТСЯ СИЛЫ,
Dialogue: 0,0:09:47.83,0:09:50.71,Caption,,0,0,0,,А ЕЁ АРМИЯ СТАНОВИТСЯ ОДНИМ ИЗ ГЛАВНЫХ ЭЛЕМЕНТОВ
Dialogue: 0,0:09:50.71,0:09:54.79,Caption,,0,0,0,,ВОСТОЧНОГО ФЛАНГА. ПОЭТОМУ СЛОВА О ПОЛЬСКОМ БАЛТИЙСКОМ МОРЕ
Dialogue: 0,0:09:54.79,0:09:57.51,Caption,,0,0,0,,ПРЕДНАЗНАЧЕНЫ НЕ ТОЛЬКО ДЛЯ МИТИНГА. ТУСК
Dialogue: 0,0:09:57.51,0:10:00.55,Caption,,0,0,0,,ОБОЗНАЧАЕТ, КТО ХОЧЕТ РАСПОРЯЖАТЬСЯ В РЕГИОНЕ,
Dialogue: 0,0:10:00.87,0:10:03.27,Caption,,0,0,0,,КОГДА ПРЕЖНИЙ ПОРЯДОК НАЧНУТ ОКОНЧАТЕЛЬНО
Dialogue: 0,0:10:03.27,0:10:08.34,Caption,,0,0,0,,ПЕРЕКРАИВАТЬ. ОДНОВРЕМЕННО РОССИЙСКАЯ СТОРОНА ОБЪЯВИЛА О
Dialogue: 0,0:10:08.42,0:10:10.90,Caption,,0,0,0,,ЛИКВИДАЦИИ СЕТИ В КАЛИНИНГРАДСКОЙ ОБЛАСТИ,
Dialogue: 0,0:10:11.14,0:10:13.38,Caption,,0,0,0,,КОТОРУЮ СВЯЗЫВАЮТ С ПОЛЬСКИМИ СПЕЦСЛУЖБАМИ.
Dialogue: 0,0:10:14.21,0:10:17.38,Caption,,0,0,0,,ВСЕ ЭЛЕМЕНТЫ СКЛАДЫВАЮТСЯ В ОДИН РИСУНОК. ВОЕННЫЕ
Dialogue: 0,0:10:17.38,0:10:20.34,Caption,,0,0,0,,МОЩНОСТИ СМЕЩАЮТСЯ НА ВОСТОК. РАЗВЕДЫВАТЕЛЬНАЯ
Dialogue: 0,0:10:20.34,0:10:23.95,Caption,,0,0,0,,РАБОТА УСИЛИВАЕТСЯ ТАМ ЖЕ. ЗА НЕЙ СЛЕДУЮТ ЗАЯВЛЕНИЯ
Dialogue: 0,0:10:23.95,0:10:28.50,Caption,,0,0,0,,ЛИДЕРОВ, БЮДЖЕТЫ И НОВЫЕ ПРЕТЕНЗИИ НА РЕГИОНАЛЬНОЕ ВЛИЯНИЕ. У
Dialogue: 0,0:10:28.58,0:10:32.83,Caption,,0,0,0,,ЭТОГО ДВИЖЕНИЯ ЕСТЬ ПРОШЛОЕ, КОТОРОЕ ИЗМЕРЯЕТСЯ УЖЕ НЕ СРОКАМИ ОТДЕЛЬНЫХ
Dialogue: 0,0:10:32.83,0:10:35.54,Caption,,0,0,0,,ПРАВИТЕЛЬСТВ. НЫНЕШНЕЕ СТОЛКНОВЕНИЕ МОЖНО
Dialogue: 0,0:10:35.54,0:10:37.78,Caption,,0,0,0,,РАССМАТРИВАТЬ КАК ПРОДОЛЖЕНИЕ ПРОЦЕССОВ,
Dialogue: 0,0:10:38.01,0:10:40.42,Caption,,0,0,0,,НАЧАВШИХСЯ ПРИ РАСПАДЕ РОССИЙСКОЙ ИМПЕРИИ,
Dialogue: 0,0:10:40.66,0:10:43.30,Caption,,0,0,0,,РЕВОЛЮЦИЯХ ТЫСЯЧА ДЕВЯТЬСОТ СЕМНАДЦАТОГО ГОДА И
Dialogue: 0,0:10:43.30,0:10:44.98,Caption,,0,0,0,,ПОСЛЕДУЮЩЕЙ ГРАЖДАНСКОЙ ВОЙНЕ.
Dialogue: 0,0:10:45.61,0:10:47.86,Caption,,0,0,0,,ПРЕДЛОЖИЛА ЗАГЛЯНУТЬ ЕЩЁ ДАЛЬШЕ,
Dialogue: 0,0:10:48.12,0:10:52.34,Caption,,0,0,0,,НЕ НА ОДНО СТОЛЕТИЕ, А СРАЗУ НА ТЫСЯЧУ ЛЕТ. ОСНОВАНИЕ У ТАКОЙ
Dialogue: 0,0:10:52.34,0:10:55.70,Caption,,0,0,0,,ВЕРСИИ СЛЕДУЮЩЕЕ. ЕВРОПЕ ИСТОРИЧЕСКИ НЕ ХВАТАЛО
Dialogue: 0,0:10:55.78,0:11:00.42,Caption,,0,0,0,,ЧАСТИ РЕСУРСОВ, ПРОСТРАНСТВА И РЫНКОВ. ВОСТОЧНЫЕ ЗЕМЛИ ОБЛАДАЛИ ТЕМ,
Dialogue: 0,0:11:00.58,0:11:04.10,Caption,,0,0,0,,ЗА ЧТО СТОИЛО БОРОТЬСЯ. ЦЕНТРЫ ВЛАСТИ МЕНЯЛИСЬ. ИМИ
Dialogue: 0,0:11:04.10,0:11:09.22,Caption,,0,0,0,,СТАНОВИЛИСЬ КИЕВ, НОВГОРОД, МОСКВА И ПЕТЕРБУРГ. ОДНИ ГОСУДАРСТВЕННЫЕ ФОРМЫ
Dialogue: 0,0:11:09.30,0:11:11.86,Caption,,0,0,0,,ИСЧЕЗАЛИ, ДРУГИЕ ВОЗНИКАЛИ НА ИХ МЕСТЕ,
Dialogue: 0,0:11:12.02,0:11:15.22,Caption,,0,0,0,,ТЕРРИТОРИИ РАСПАДАЛИСЬ И СНОВА СОБИРАЛИСЬ. ПРИ ВСЕХ
Dialogue: 0,0:11:15.22,0:11:18.18,Caption,,0,0,0,,ПЕРЕМЕНАХ НАПРАВЛЕНИЕ ДАВЛЕНИЯ УДИВИТЕЛЬНО ЧАСТО
Dialogue: 0,0:11:18.18,0:11:20.98,Caption,,0,0,0,,ОСТАВАЛОСЬ ПРЕЖНИМ. С ЗАПАДА НА ВОСТОК.
Dialogue: 0,0:11:23.27,0:11:26.39,Caption,,0,0,0,,НАПОЛЕОНОВСКАЯ ФРАНЦИЯ, КАЙЗЕРОВСКАЯ ГЕРМАНИЯ,
Dialogue: 0,0:11:26.47,0:11:30.71,Caption,,0,0,0,,ТРЕТИЙ РЕЙХ, НЫНЕШНИЙ ЕВРОПЕЙСКИЙ СОЮЗ И НАТО УСТРОЕНЫ СОВЕРШЕННО
Dialogue: 0,0:11:30.79,0:11:34.15,Caption,,0,0,0,,ПО РАЗНОМУ И ПРЕСЛЕДУЮТ РАЗНЫЕ ЦЕЛИ. ОДНОЙ СИЛОЙ
Dialogue: 0,0:11:34.23,0:11:36.63,Caption,,0,0,0,,С ЕДИНЫМ ПЛАНОМ ОНИ НИКОГДА НЕ БЫЛИ. НО
Dialogue: 0,0:11:36.63,0:11:41.59,Caption,,0,0,0,,ГЕОГРАФИЯ У ВСЕХ ОДНА, А ОНА УПРЯМЕЕ ЛОЗУНГОВ. КОГДА ЕВРОПЕЙСКИМ ДЕРЖАВАМ
Dialogue: 0,0:11:41.59,0:11:46.23,Caption,,0,0,0,,ТРЕБОВАЛИСЬ РЕСУРСЫ, РЫНКИ, ТЕРРИТОРИИ ИЛИ ДОПОЛНИТЕЛЬНОЕ ВЛИЯНИЕ,
Dialogue: 0,0:11:46.63,0:11:49.27,Caption,,0,0,0,,ВОСТОЧНОЕ НАПРАВЛЕНИЕ СНОВА ОКАЗЫВАЛОСЬ В ЦЕНТРЕ
Dialogue: 0,0:11:49.27,0:11:52.55,Caption,,0,0,0,,ВНИМАНИЯ. СЕЙЧАС ОГРОМНЫЙ ВОЕННЫЙ МЕХАНИЗМ ВНОВЬ
Dialogue: 0,0:11:52.55,0:11:55.27,Caption,,0,0,0,,ПОВОРАЧИВАЕТСЯ ТУДА ЖЕ. СНАРУЖИ ВСЁ ВЫГЛЯДИТ
Dialogue: 0,0:11:55.27,0:11:58.39,Caption,,0,0,0,,БЕЗУПРЕЧНО СОВРЕМЕННО. КОМПАС ПРИ ЭТОМ ПОКАЗЫВАЕТ
Dialogue: 0,0:11:58.39,0:12:02.23,Caption,,0,0,0,,ТУДА ЖЕ, КУДА ПОКАЗЫВАЛ ВЕКАМИ. ФРАНЦИЯ В ЭТОЙ ИСТОРИИ
Dialogue: 0,0:12:02.24,0:12:05.27,Caption,,0,0,0,,ОСОБЕННО ЗАНЯТНА. ЕЁ АРМИЯ ТОЖЕ ОТПРАВЛЯЛАСЬ НА
Dialogue: 0,0:12:05.27,0:12:07.91,Caption,,0,0,0,,ВОСТОК, А ВОЙСКА НАПОЛЕОНА ДОШЛИ ДО МОСКВЫ.
Dialogue: 0,0:12:08.47,0:12:11.19,Caption,,0,0,0,,ОДНОВРЕМЕННО САМА ФРАНЦИЯ СТОЛЕТИЯМИ СРАЖАЛАСЬ С
Dialogue: 0,0:12:11.19,0:12:13.99,Caption,,0,0,0,,ГЕРМАНСКИМИ ГОСУДАРСТВАМИ. СЕГОДНЯ ЭТИ ДВЕ ЛИНИИ
Dialogue: 0,0:12:13.99,0:12:16.47,Caption,,0,0,0,,СОШЛИСЬ В ОДНОЙ ТОЧКЕ. ПАРИЖ УЧАСТВУЕТ В
Dialogue: 0,0:12:16.47,0:12:20.95,Caption,,0,0,0,,ПРОТИВОСТОЯНИИ С РОССИЕЙ, НО ВСЯКИЙ НОВЫЙ НЕМЕЦКИЙ ПОЛК ЗАСТАВЛЯЕТ ФРАНЦУЗОВ
Dialogue: 0,0:12:20.95,0:12:23.67,Caption,,0,0,0,,ВНИМАТЕЛЬНЕЕ СЛЕДИТЬ УЖЕ ЗА БЕРЛИНОМ. РОССИЯ
Dialogue: 0,0:12:23.67,0:12:26.71,Caption,,0,0,0,,НАХОДИТСЯ ДАЛЕКО. ГЕРМАНИЯ НАЧИНАЕТСЯ СРАЗУ ЗА
Dialogue: 0,0:12:26.71,0:12:30.15,Caption,,0,0,0,,ГРАНИЦЕЙ. ТАКОЕ СОСЕДСТВО ПРЕКРАСНО ЛЕЧИТ ОТ
Dialogue: 0,0:12:30.15,0:12:33.27,Caption,,0,0,0,,ИЗБЫТОЧНОГО ДОВЕРИЯ. ПОЭТОМУ ПАРИЖ ОЦЕНИВАЕТ НЕ
Dialogue: 0,0:12:33.27,0:12:35.35,Caption,,0,0,0,,ТОЛЬКО СЕГОДНЯШНЕЕ ПРАВИТЕЛЬСТВО ГЕРМАНИИ.
Dialogue: 0,0:12:37.64,0:12:41.24,Caption,,0,0,0,,ЕГО ИНТЕРЕСУЕТ СТРАНА, КОТОРАЯ ПОЯВИТСЯ ЧЕРЕЗ ДЕСЯТЬ,
Dialogue: 0,0:12:41.37,0:12:46.36,Caption,,0,0,0,,ДВАДЦАТЬ ИЛИ ТРИДЦАТЬ ЛЕТ, ЕСЛИ БЕРЛИН СТАНЕТ ГЛАВНЫМ ВОЕННЫМ ЦЕНТРОМ ЕВРОПЫ.
Dialogue: 0,0:12:46.95,0:12:49.48,Caption,,0,0,0,,ФРАНЦУЗСКАЯ ТРЕВОГА ПЕРЕСТАЁТ КАЗАТЬСЯ СТРАННОЙ,
Dialogue: 0,0:12:49.75,0:12:52.44,Caption,,0,0,0,,КАК ТОЛЬКО РЯДОМ С НОВЫМИ КОНТРАКТАМИ КЛАДУТ СТАРУЮ
Dialogue: 0,0:12:52.44,0:12:55.48,Caption,,0,0,0,,КАРТУ ВОЙН. НА ТАКОМ СТОЛЕ ДАЖЕ САМЫЕ ДРУЖЕСКИЕ
Dialogue: 0,0:12:55.48,0:13:00.20,Caption,,0,0,0,,БУМАГИ ЧИТАЮТСЯ МЕДЛЕННЕЕ. РАСПАД РОССИЙСКОЙ ИМПЕРИИ ПРОШЁЛ ЧЕРЕЗ НЕСКОЛЬКО
Dialogue: 0,0:13:00.28,0:13:03.32,Caption,,0,0,0,,РАЗНЫХ ЭТАПОВ. ФЕВРАЛЬСКАЯ РЕВОЛЮЦИЯ УНИЧТОЖИЛА
Dialogue: 0,0:13:03.32,0:13:06.28,Caption,,0,0,0,,МОНАРХИЧЕСКУЮ КОНСТРУКЦИЮ. ОКТЯБРЬСКАЯ РЕВОЛЮЦИЯ
Dialogue: 0,0:13:06.28,0:13:09.32,Caption,,0,0,0,,ПЕРЕДАЛА ВЛАСТЬ БОЛЬШЕВИКАМ. ГРАЖДАНСКАЯ ВОЙНА
Dialogue: 0,0:13:09.32,0:13:12.04,Caption,,0,0,0,,ПРЕВРАТИЛА БОРЬБУ ВНУТРИ СТРАНЫ В МАСШТАБНОЕ
Dialogue: 0,0:13:12.04,0:13:14.92,Caption,,0,0,0,,ВООРУЖЁННОЕ СТОЛКНОВЕНИЕ С УЧАСТИЕМ ИНОСТРАННЫХ СИЛ.
Dialogue: 0,0:13:15.64,0:13:17.96,Caption,,0,0,0,,НА МЕСТЕ ПРЕЖНЕЙ ИМПЕРИИ ПОЯВИЛАСЬ НОВАЯ
Dialogue: 0,0:13:17.96,0:13:21.40,Caption,,0,0,0,,ГОСУДАРСТВЕННАЯ СИСТЕМА. СПУСТЯ ДЕСЯТИЛЕТИЯ РАСПАЛСЯ
Dialogue: 0,0:13:21.40,0:13:25.72,Caption,,0,0,0,,СОВЕТСКИЙ СОЮЗ, ВОЗНИКЛИ НОВЫЕ СТРАНЫ И НОВЫЕ ЛИНИИ НА КАРТЕ.
Dialogue: 0,0:13:26.03,0:13:28.60,Caption,,0,0,0,,ОТСЮДА И ВОПРОС ЧИТАТЕЛЯ. НАСКОЛЬКО
Dialogue: 0,0:13:28.60,0:13:31.32,Caption,,0,0,0,,НЫНЕШНЯЯ ВОЙНА ЯВЛЯЕТСЯ ОТДЕЛЬНЫМ КОНФЛИКТОМ,
Dialogue: 0,0:13:31.64,0:13:34.28,Caption,,0,0,0,,А НАСКОЛЬКО ПРОДОЛЖАЕТ СТАРЫЕ ЛИНИИ РАСКОЛА,
Dialogue: 0,0:13:34.45,0:13:37.08,Caption,,0,0,0,,КОТОРЫЕ НЕ БЫЛИ ЗАКРЫТЫ ПОСЛЕ ПРЕДЫДУЩИХ РАСПАДОВ?
Dialogue: 0,0:13:37.87,0:13:42.04,Caption,,0,0,0,,ЕСЛИ РАЗВИТЬ ЭТУ МЫСЛЬ, ВНЕШНЕЕ УЧАСТИЕ СЕГОДНЯ НАПОМИНАЕТ ИНТЕРВЕНЦИЮ
Dialogue: 0,0:13:42.04,0:13:44.68,Caption,,0,0,0,,ВРЕМЁН ГРАЖДАНСКОЙ ВОЙНЫ. В ПРОШЛОМ ИНОСТРАННЫЕ
Dialogue: 0,0:13:44.76,0:13:47.40,Caption,,0,0,0,,ДЕРЖАВЫ ОТПРАВЛЯЛИ АРМИИ И ЗАНИМАЛИ ТЕРРИТОРИИ
Dialogue: 0,0:13:47.40,0:13:53.13,Caption,,0,0,0,,СВОИМИ СОЛДАТАМИ. ТЕПЕРЬ ЗНАЧИТЕЛЬНАЯ ЧАСТЬ УЧАСТИЯ ПРОХОДИТ ЧЕРЕЗ
Dialogue: 0,0:13:53.13,0:13:55.45,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ, ПОСТАВКИ ОРУЖИЯ,
Dialogue: 0,0:13:55.69,0:13:59.05,Caption,,0,0,0,,РАЗВЕДЫВАТЕЛЬНЫЕ ДАННЫЕ, ТЕХНОЛОГИИ И ЛОГИСТИКУ.
Dialogue: 0,0:13:59.66,0:14:02.09,Caption,,0,0,0,,НА ЭТОМ ФОНЕ ОСОБЕННО ЛЮБОПЫТНО ЗАЯВЛЕНИЕ КАИ
Dialogue: 0,0:14:02.09,0:14:06.97,Caption,,0,0,0,,КАЛЛАС. ОНА НАСТАИВАЕТ, ЧТО ОТМЕНЯТЬ ЕВРОПЕЙСКИЕ САНКЦИИ И РАЗМОРАЖИВАТЬ
Dialogue: 0,0:14:06.97,0:14:09.45,Caption,,0,0,0,,РОССИЙСКИЕ АКТИВЫ ВПРАВЕ ТОЛЬКО САМА ЕВРОПА.
Dialogue: 0,0:14:09.97,0:14:13.05,Caption,,0,0,0,,ФОРМАЛЬНО ВСЁ ВЕРНО. ОГРАНИЧЕНИЯ ВВОДИЛИ ЕВРОПЕЙСКИЕ
Dialogue: 0,0:14:13.05,0:14:15.77,Caption,,0,0,0,,ИНСТИТУТЫ. СРЕДСТВА НАХОДЯТСЯ В ЕВРОПЕЙСКОЙ
Dialogue: 0,0:14:15.77,0:14:20.33,Caption,,0,0,0,,ЮРИСДИКЦИИ. ЗНАЧИТ, И ОКОНЧАТЕЛЬНОЕ РЕШЕНИЕ ПРИНАДЛЕЖИТ ИМ. НО
Dialogue: 0,0:14:20.33,0:14:22.81,Caption,,0,0,0,,ЕВРОПЕЙЦЕВ НЕ ОКАЗАЛОСЬ ЗА СТОЛОМ ТРЁХСТОРОННИХ
Dialogue: 0,0:14:22.81,0:14:27.29,Caption,,0,0,0,,ПЕРЕГОВОРОВ РОССИИ, СОЕДИНЁННЫХ ШТАТОВ И УКРАИНЫ В АБУ ДАБИ. ПОЭТОМУ
Dialogue: 0,0:14:27.29,0:14:32.33,Caption,,0,0,0,,КАЛЛАС НАПОМИНАЕТ О ТОМ, ЧТО ЛЕЖИТ В ЕВРОПЕЙСКИХ РУКАХ. ХОТИТЕ ДОГОВАРИВАТЬСЯ
Dialogue: 0,0:14:32.41,0:14:36.65,Caption,,0,0,0,,БЕЗ УЧАСТИЯ БРЮССЕЛЯ, ДОГОВАРИВАЙТЕСЬ. НО САНКЦИОННЫЕ РЕШЕНИЯ И
Dialogue: 0,0:14:36.65,0:14:39.53,Caption,,0,0,0,,ЗАМОРОЖЕННЫЕ СРЕДСТВА САМИ СОБОЙ ИЗ ЕВРОПЕЙСКИХ
Dialogue: 0,0:14:39.53,0:14:42.57,Caption,,0,0,0,,СЕЙФОВ НЕ ВЫЙДУТ. ТАК ЕВРОПА БОРЕТСЯ НЕ ТОЛЬКО
Dialogue: 0,0:14:42.57,0:14:45.53,Caption,,0,0,0,,С РОССИЕЙ, НО И ЗА СОБСТВЕННОЕ МЕСТО В УСТРОЙСТВЕ,
Dialogue: 0,0:14:45.72,0:14:47.21,Caption,,0,0,0,,КОТОРОЕ ВОЗНИКНЕТ ПОСЛЕ ВОЙНЫ.
Dialogue: 0,0:14:47.77,0:14:50.33,Caption,,0,0,0,,ВНУТРИ ЗАПАДА ИДЁТ ОТДЕЛЬНОЕ СОПЕРНИЧЕСТВО.
Dialogue: 0,0:14:50.68,0:14:53.05,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ ХОТЯТ СОКРАТИТЬ РАСХОДЫ,
Dialogue: 0,0:14:53.21,0:14:56.33,Caption,,0,0,0,,СОХРАНИВ ВЛИЯНИЕ НА РЕШЕНИЯ. БРИТАНИЯ СТАРАЕТСЯ
Dialogue: 0,0:14:56.41,0:14:58.97,Caption,,0,0,0,,ОСТАТЬСЯ ОДНИМ ИЗ ГЛАВНЫХ ОРГАНИЗАТОРОВ ДАВЛЕНИЯ.
Dialogue: 0,0:14:59.24,0:15:01.77,Caption,,0,0,0,,ПОЛЬША ПРЕТЕНДУЕТ НА ВЕДУЩУЮ РОЛЬ В БАЛТИЙСКОМ
Dialogue: 0,0:15:01.85,0:15:03.45,Caption,,0,0,0,,РЕГИОНЕ И НА ВОСТОЧНОМ ФЛАНГЕ.
Dialogue: 0,0:15:05.73,0:15:07.89,Caption,,0,0,0,,ГЕРМАНИЯ ПОЛУЧАЕТ ВОЕННЫЕ ИНСТРУМЕНТЫ,
Dialogue: 0,0:15:08.13,0:15:11.49,Caption,,0,0,0,,КОТОРЫХ НЕ ИМЕЛА ДЕСЯТИЛЕТИЯМИ. ФРАНЦИЯ ЗАЩИЩАЕТ
Dialogue: 0,0:15:11.49,0:15:13.73,Caption,,0,0,0,,СВОЁ СТРАТЕГИЧЕСКОЕ ПОЛОЖЕНИЕ И СЛЕДИТ,
Dialogue: 0,0:15:13.96,0:15:16.77,Caption,,0,0,0,,ЧТОБЫ НЕМЕЦКОЕ УСИЛЕНИЕ НЕ ПРЕВРАТИЛОСЬ В НЕМЕЦКУЮ
Dialogue: 0,0:15:16.77,0:15:19.89,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОСТЬ. ОФИЦИАЛЬНАЯ ВИТРИНА ПОКАЗЫВАЕТ
Dialogue: 0,0:15:19.91,0:15:25.01,Caption,,0,0,0,,ЕДИНУЮ ЕВРОПУ, СПЛОЧЁННОЕ НАТО И ОДНОГО ОБЩЕГО ПРОТИВНИКА. ЗА
Dialogue: 0,0:15:25.09,0:15:27.49,Caption,,0,0,0,,ВИТРИНОЙ КАЖДЫЙ ПЕРЕСЧИТЫВАЕТ ВЫГОДУ НА СВОЁМ
Dialogue: 0,0:15:27.49,0:15:31.09,Caption,,0,0,0,,КАЛЬКУЛЯТОРЕ. У ФРАНЦИИ РАСЧЁТ ОСОБЕННО СЛОЖНЫЙ.
Dialogue: 0,0:15:31.32,0:15:33.89,Caption,,0,0,0,,СНАЧАЛА ПАРИЖ ОЦЕНИВАЕТ ВОЗМОЖНОСТЬ РОССИЙСКОГО
Dialogue: 0,0:15:33.97,0:15:36.93,Caption,,0,0,0,,ОТВЕТА. ЗАТЕМ СМОТРИТ ЧЕРЕЗ ГРАНИЦУ И ПЫТАЕТСЯ
Dialogue: 0,0:15:36.93,0:15:40.05,Caption,,0,0,0,,ПОНЯТЬ, КАКОЙ БАЛАНС СЛОЖИТСЯ ПОСЛЕ НЕМЕЦКОГО
Dialogue: 0,0:15:40.05,0:15:43.65,Caption,,0,0,0,,ПЕРЕВООРУЖЕНИЯ. ЭТО НЕ ПРИСТУП БЕСПРИЧИННОЙ ПОДОЗРИТЕЛЬНОСТИ.
Dialogue: 0,0:15:44.06,0:15:48.85,Caption,,0,0,0,,ФРАНЦИЯ СЛИШКОМ ХОРОШО ЗНАЕТ, ЧТО ЕВРОПЕЙСКИЕ СОЮЗЫ СЛУЖАТ РОВНО ДО ТЕХ ПОР,
Dialogue: 0,0:15:49.09,0:15:52.29,Caption,,0,0,0,,ПОКА СОВПАДАЮТ ИНТЕРЕСЫ ИХ УЧАСТНИКОВ. ПОЭТОМУ СПОР
Dialogue: 0,0:15:52.29,0:15:54.77,Caption,,0,0,0,,О НЕМЕЦКИХ РАКЕТАХ ВЫХОДИТ ДАЛЕКО ЗА ПРЕДЕЛЫ
Dialogue: 0,0:15:54.77,0:15:57.65,Caption,,0,0,0,,ТЕХНИЧЕСКИХ ХАРАКТЕРИСТИК. ОН ПОКАЗЫВАЕТ СТАРУЮ
Dialogue: 0,0:15:57.73,0:16:00.37,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ ПРОБЛЕМУ. ДЛЯ ДВИЖЕНИЯ НА ВОСТОК
Dialogue: 0,0:16:00.38,0:16:03.33,Caption,,0,0,0,,ГОСУДАРСТВАМ ПРИХОДИТСЯ СОЕДИНЯТЬ СИЛЫ. НО КАЖДОЕ
Dialogue: 0,0:16:03.33,0:16:06.37,Caption,,0,0,0,,ТАКОЕ ОБЪЕДИНЕНИЕ МЕНЯЕТ СООТНОШЕНИЕ СИЛ МЕЖДУ НИМИ
Dialogue: 0,0:16:06.37,0:16:08.85,Caption,,0,0,0,,САМИМИ. ФРАНЦИИ НУЖНА ГЕРМАНИЯ,
Dialogue: 0,0:16:09.01,0:16:11.65,Caption,,0,0,0,,СПОСОБНАЯ ПРОТИВОСТОЯТЬ РОССИИ. ГЕРМАНИЯ,
Dialogue: 0,0:16:11.80,0:16:14.21,Caption,,0,0,0,,СПОСОБНАЯ ДИКТОВАТЬ УСЛОВИЯ ВСЕЙ ЕВРОПЕ,
Dialogue: 0,0:16:14.37,0:16:17.41,Caption,,0,0,0,,ФРАНЦИИ УЖЕ НЕ НУЖНА. БРИТАНИЯ ЗАИНТЕРЕСОВАНА В
Dialogue: 0,0:16:17.41,0:16:20.69,Caption,,0,0,0,,АКТИВНОМ БЕРЛИНЕ, ПОКА ТОТ СЛЕДУЕТ БРИТАНСКИМ СОВЕТАМ.
Dialogue: 0,0:16:22.98,0:16:25.54,Caption,,0,0,0,,ЕСЛИ НЕМЕЦКОЕ РУКОВОДСТВО ОДНАЖДЫ РЕШИТ ОБХОДИТЬСЯ
Dialogue: 0,0:16:25.62,0:16:29.94,Caption,,0,0,0,,БЕЗ ПОДСКАЗОК ЛОНДОНА, ВОСТОРГ БЫСТРО ЗАКОНЧИТСЯ. ПОЛЬШЕ ВЫГОДЕН СИЛЬНЫЙ
Dialogue: 0,0:16:30.02,0:16:32.50,Caption,,0,0,0,,СОЮЗНИК ПО НАТО. ПРИ ЭТОМ ПАМЯТЬ ВАРШАВЫ О
Dialogue: 0,0:16:32.50,0:16:35.38,Caption,,0,0,0,,ПРОШЛЫХ ОТНОШЕНИЯХ С ГЕРМАНИЕЙ ХРАНИТСЯ НЕ В ДАЛЬНЕМ
Dialogue: 0,0:16:35.38,0:16:38.42,Caption,,0,0,0,,ЯЩИКЕ. РАЗВОРОТ НАТО НА ВОСТОК ПЕРЕСТРАИВАЕТ НЕ
Dialogue: 0,0:16:38.42,0:16:41.22,Caption,,0,0,0,,ТОЛЬКО ОТНОШЕНИЯ С РОССИЕЙ. ОН МЕНЯЕТ УСТРОЙСТВО
Dialogue: 0,0:16:41.22,0:16:44.74,Caption,,0,0,0,,САМОЙ ЕВРОПЫ. ВОЕННЫЕ БЮДЖЕТЫ ПЕРЕРАСПРЕДЕЛЯЮТСЯ.
Dialogue: 0,0:16:45.13,0:16:47.38,Caption,,0,0,0,,АРМИИ РАСТУТ В ОДНИХ СТРАНАХ БЫСТРЕЕ,
Dialogue: 0,0:16:47.46,0:16:50.34,Caption,,0,0,0,,ЧЕМ В ДРУГИХ. ГЕРМАНИЯ ПОДНИМАЕТСЯ КАК СИЛОВОЙ
Dialogue: 0,0:16:50.34,0:16:53.94,Caption,,0,0,0,,ЦЕНТР. ПОЛЬША ПОЛУЧАЕТ ДОПОЛНИТЕЛЬНЫЙ ВЕС. ФРАНЦИЯ
Dialogue: 0,0:16:53.94,0:16:56.98,Caption,,0,0,0,,ЗАНОВО ОЦЕНИВАЕТ ЗНАЧЕНИЕ СВОЕГО ЯДЕРНОГО СТАТУСА.
Dialogue: 0,0:16:57.30,0:17:00.58,Caption,,0,0,0,,БРИТАНИЯ ВОЗВРАЩАЕТ СЕБЕ РОЛЬ ОТДЕЛЬНОГО ЦЕНТРА
Dialogue: 0,0:17:00.58,0:17:03.30,Caption,,0,0,0,,ПРИНЯТИЯ РЕШЕНИЙ. СОЕДИНЁННЫЕ ШТАТЫ ПЕРЕДАЮТ
Dialogue: 0,0:17:03.30,0:17:05.46,Caption,,0,0,0,,СОЮЗНИКАМ ВСЁ БОЛЬШУЮ ЧАСТЬ РАСХОДОВ,
Dialogue: 0,0:17:05.76,0:17:08.02,Caption,,0,0,0,,НЕ ТОРОПЯСЬ ПЕРЕДАВАТЬ ИМ ТАКОЕ ЖЕ КОЛИЧЕСТВО
Dialogue: 0,0:17:08.02,0:17:10.66,Caption,,0,0,0,,ВЛАСТИ. НАПРАВЛЕНИЕ И ПРАВДА ЗНАКОМО ПО МНОГИМ
Dialogue: 0,0:17:10.66,0:17:13.46,Caption,,0,0,0,,ВЕКАМ. МЕНЯЮТСЯ ГОСУДАРСТВА, СОЮЗЫ,
Dialogue: 0,0:17:13.70,0:17:17.70,Caption,,0,0,0,,ТЕХНОЛОГИИ И НАЗВАНИЯ ВОЕННЫХ ПРОГРАММ. ВОСТОК ВНОВЬ
Dialogue: 0,0:17:17.70,0:17:20.66,Caption,,0,0,0,,СТАНОВИТСЯ ЦЕЛЬЮ ОГРОМНОГО ЕВРОПЕЙСКОГО УСИЛИЯ.
Dialogue: 0,0:17:20.82,0:17:23.94,Caption,,0,0,0,,ФРАНЦИЯ ДВИЖЕТСЯ ТУДА ВМЕСТЕ С ОСТАЛЬНЫМИ. НО ИДЁТ
Dialogue: 0,0:17:24.02,0:17:26.66,Caption,,0,0,0,,НЕ ПЕРВОЙ И НЕ ПОСЛЕДНЕЙ. ТАК УДОБНЕЕ ВРЕМЯ
Dialogue: 0,0:17:26.66,0:17:28.90,Caption,,0,0,0,,ОТ ВРЕМЕНИ ПОВОРАЧИВАТЬ ГОЛОВУ И ПРОВЕРЯТЬ,
Dialogue: 0,0:17:28.98,0:17:30.34,Caption,,0,0,0,,ЧТО ДЕЛАЕТ ГЕРМАНИЯ.
