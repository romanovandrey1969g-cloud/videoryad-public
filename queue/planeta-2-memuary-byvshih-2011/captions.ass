Dialogue: 0,0:00:00.12,0:00:02.52,Caption,,0,0,0,,ДЖО БАЙДЕН РЕШИЛ ОСТАВИТЬ ПОТОМКАМ МЕМУАРЫ,
Dialogue: 0,0:00:02.84,0:00:05.32,Caption,,0,0,0,,НО ВМЕСТО БРОНЗОВОГО ПАМЯТНИКА ЭПОХЕ ПОЛУЧИЛСЯ
Dialogue: 0,0:00:05.40,0:00:08.28,Caption,,0,0,0,,ДОВОЛЬНО ЗАНЯТНЫЙ СЧЁТ ЗА ДРУЖБУ. ОКАЗЫВАЕТСЯ,
Dialogue: 0,0:00:08.60,0:00:11.32,Caption,,0,0,0,,ЗА ЗАКРЫТЫМИ ДВЕРЯМИ ЗЕЛЕНСКИЙ БЫЛ УПРЯМЫМ,
Dialogue: 0,0:00:11.48,0:00:13.96,Caption,,0,0,0,,КАПРИЗНЫМ И ДЕМОНСТРИРОВАЛ КУДА МЕНЬШЕ
Dialogue: 0,0:00:13.96,0:00:17.56,Caption,,0,0,0,,ПРИЗНАТЕЛЬНОСТИ, ЧЕМ ОЖИДАЛ ХОЗЯИН БЕЛОГО ДОМА. ВОТ ТАК И
Dialogue: 0,0:00:17.56,0:00:20.76,Caption,,0,0,0,,ВЫЯСНИЛОСЬ, ЧТО К АМЕРИКАНСКОЙ ПОМОЩИ ПРИЛАГАЛСЯ НЕВИДИМЫЙ
Dialogue: 0,0:00:20.76,0:00:23.88,Caption,,0,0,0,,КАССОВЫЙ АППАРАТ. ВАШИНГТОН ОТПРАВЛЯЛ ОРУЖИЕ,
Dialogue: 0,0:00:24.04,0:00:28.60,Caption,,0,0,0,,ВЫДЕЛЯЛ МИЛЛИАРДЫ, ПРИКРЫВАЛ КИЕВ НА МЕЖДУНАРОДНОЙ СЦЕНЕ И ЖДАЛ,
Dialogue: 0,0:00:28.72,0:00:31.40,Caption,,0,0,0,,КОГДА НА ТАБЛО ЗАГОРИТСЯ ПРАВИЛЬНОЕ КОЛИЧЕСТВО
Dialogue: 0,0:00:31.40,0:00:35.80,Caption,,0,0,0,,БЛАГОДАРНОСТИ. ТАБЛО, ВИДИМО, БАРАХЛИЛО. ПОДПИШИТЕСЬ,
Dialogue: 0,0:00:35.96,0:00:39.88,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ ИСТОРИИ, В КОТОРЫХ БЫВШИЕ ДРУЗЬЯ ВНЕЗАПНО НАЧИНАЮТ
Dialogue: 0,0:00:39.88,0:00:42.84,Caption,,0,0,0,,ПРЕДЪЯВЛЯТЬ ДРУГ ДРУГУ СТАРЫЕ КВИТАНЦИИ. ОСОБЕННО
Dialogue: 0,0:00:42.84,0:00:46.20,Caption,,0,0,0,,ЛЮБОПЫТНО, ЧТО БАЙДЕН ЗАГОВОРИЛ ОБ ЭТОМ УЖЕ ПОСЛЕ УХОДА.
Dialogue: 0,0:00:46.50,0:00:48.76,Caption,,0,0,0,,ПОКА ОТНОШЕНИЯ СЧИТАЛИСЬ ОБРАЗЦОВЫМИ,
Dialogue: 0,0:00:48.91,0:00:51.56,Caption,,0,0,0,,РАЗДРАЖЕНИЕ АККУРАТНО ДЕРЖАЛИ ПОД КРЫШКОЙ.
Dialogue: 0,0:00:51.86,0:00:54.04,Caption,,0,0,0,,ЗЕЛЕНСКИЙ, СУДЯ ПО РАССКАЗУ БАЙДЕНА,
Dialogue: 0,0:00:54.43,0:00:56.28,Caption,,0,0,0,,ВЁЛ СЕБЯ НЕ КАК МЛАДШИЙ ПАРТНЁР,
Dialogue: 0,0:00:56.44,0:01:00.52,Caption,,0,0,0,,А КАК КЛИЕНТ, УВЕРЕННЫЙ, ЧТО ОБСЛУЖИВАНИЕ ВКЛЮЧЕНО НАВСЕГДА.
Dialogue: 0,0:01:01.30,0:01:04.36,Caption,,0,0,0,,ОДНАКО МЕМУАРЫ РАСКРЫЛИ И БОЛЕЕ СЕРЬЁЗНЫЙ ЭПИЗОД.
Dialogue: 0,0:01:04.73,0:01:07.56,Caption,,0,0,0,,ПОСЛЕ ПОБЕДЫ ТРАМПА ЕГО ПРЕДСТАВИТЕЛИ ХОТЕЛИ НАЧАТЬ
Dialogue: 0,0:01:07.64,0:01:10.20,Caption,,0,0,0,,ПРЯМОЙ РАЗГОВОР С ПУТИНЫМ ЕЩЁ ДО ОФИЦИАЛЬНОГО
Dialogue: 0,0:01:10.20,0:01:13.56,Caption,,0,0,0,,ВСТУПЛЕНИЯ НОВОГО ПРЕЗИДЕНТА В ДОЛЖНОСТЬ. БАЙДЕН ЭТО
Dialogue: 0,0:01:13.56,0:01:17.04,Caption,,0,0,0,,ОСТАНОВИЛ. ОН СЧИТАЛ,
Dialogue: 0,0:01:17.20,0:01:20.24,Caption,,0,0,0,,ЧТО ТРАМП МОЖЕТ ДОГОВОРИТЬСЯ ЗА СЧЁТ УКРАИНЫ И
Dialogue: 0,0:01:20.24,0:01:23.28,Caption,,0,0,0,,НАЗВАТЬ ПОЛУЧИВШИЙСЯ РЕЗУЛЬТАТ МИРОМ. ПОЭТОМУ
Dialogue: 0,0:01:23.28,0:01:26.32,Caption,,0,0,0,,УХОДЯЩАЯ КОМАНДА НЕ ПРОСТО КРИТИКОВАЛА БУДУЩИЙ КУРС.
Dialogue: 0,0:01:26.64,0:01:28.96,Caption,,0,0,0,,ОНА НЕ ПОЗВОЛИЛА ЗАПУСТИТЬ ЕГО ЗАРАНЕЕ,
Dialogue: 0,0:01:29.20,0:01:31.44,Caption,,0,0,0,,ХОТЯ ЧАСЫ ПРЕЖНЕЙ АДМИНИСТРАЦИИ УЖЕ ПОЧТИ
Dialogue: 0,0:01:31.44,0:01:36.80,Caption,,0,0,0,,ОСТАНОВИЛИСЬ. ТРАМП ПРИШЁЛ, И ОТНОШЕНИЕ К КИЕВУ ИЗМЕНИЛОСЬ БЕЗ ДОЛГИХ ЦЕРЕМОНИЙ.
Dialogue: 0,0:01:37.11,0:01:40.08,Caption,,0,0,0,,ЖУРНАЛ THE ATLANTIC ОПИСАЛ НАСТРОЕНИЕ В ПЕНТАГОНЕ
Dialogue: 0,0:01:40.08,0:01:42.72,Caption,,0,0,0,,ПОСЛЕ ПЕРЕПАЛКИ ТРАМПА С ЗЕЛЕНСКИМ В БЕЛОМ ДОМЕ.
Dialogue: 0,0:01:42.96,0:01:44.56,Caption,,0,0,0,,УКРАИНСКИЙ ЧИНОВНИК РАССКАЗЫВАЛ,
Dialogue: 0,0:01:44.79,0:01:47.36,Caption,,0,0,0,,ЧТО ПИТ ХЕГСЕТ НЕ ЖЕЛАЛ ДАЖЕ СЛЫШАТЬ СЛОВО
Dialogue: 0,0:01:47.36,0:01:49.84,Caption,,0,0,0,,УКРАИНА. АМЕРИКАНСКИЙ ОФИЦЕР ВСПОМИНАЛ,
Dialogue: 0,0:01:50.08,0:01:53.20,Caption,,0,0,0,,ЧТО САМО УПОМИНАНИЕ ЭТОЙ ТЕМЫ ВЫЗЫВАЛО ПРЕЗРИТЕЛЬНУЮ
Dialogue: 0,0:01:53.20,0:01:56.32,Caption,,0,0,0,,УХМЫЛКУ. КИЕВ ПЕРЕСТАЛИ ВОСПРИНИМАТЬ КАК РАВНОГО
Dialogue: 0,0:01:56.32,0:02:00.08,Caption,,0,0,0,,УЧАСТНИКА ОБЩЕГО ДЕЛА. БАЙДЕН ХОТЕЛ БЛАГОДАРНОСТИ ЗА
Dialogue: 0,0:02:00.08,0:02:02.72,Caption,,0,0,0,,УЖЕ СДЕЛАННОЕ. ТРАМП ПОТРЕБОВАЛ ПРИЗНАТЬ,
Dialogue: 0,0:02:03.07,0:02:08.32,Caption,,0,0,0,,У КОГО НАХОДЯТСЯ ДЕНЬГИ, ОРУЖИЕ И ПРАВО ЗАКОНЧИТЬ РАЗГОВОР. РАЗНИЦА ВРОДЕ БЫ
Dialogue: 0,0:02:08.40,0:02:11.84,Caption,,0,0,0,,НЕБОЛЬШАЯ, ВСЕГО НЕСКОЛЬКО СЛОВ. НО В ПЕРВОМ СЛУЧАЕ ЗЕЛЕНСКОГО
Dialogue: 0,0:02:11.92,0:02:14.00,Caption,,0,0,0,,ЕЩЁ ОТЧИТЫВАЛИ КАК ТРУДНОГО СОЮЗНИКА,
Dialogue: 0,0:02:14.32,0:02:16.96,Caption,,0,0,0,,А ВО ВТОРОМ ЕМУ УЖЕ ОБЪЯСНЯЛИ ПРАВИЛА ПРИЁМНОЙ.
Dialogue: 0,0:02:17.26,0:02:20.08,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ЛИНИЯ ЗА ЭТИ ГОДЫ ТОЖЕ ПРОШЛА ЗАНЯТНЫЙ
Dialogue: 0,0:02:20.08,0:02:23.20,Caption,,0,0,0,,ПУТЬ. КАЯ КАЛЛАС РАССУЖДАЕТ О БЕЗОПАСНОСТИ ТАК,
Dialogue: 0,0:02:23.52,0:02:26.16,Caption,,0,0,0,,СЛОВНО ДО ФЕВРАЛЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА
Dialogue: 0,0:02:26.40,0:02:28.56,Caption,,0,0,0,,КОНТИНЕНТ ЖИЛ В БЕЗВОЗДУШНОЙ КАМЕРЕ,
Dialogue: 0,0:02:28.78,0:02:30.96,Caption,,0,0,0,,А ЗАТЕМ ВНЕЗАПНО ПРОСНУЛСЯ ПОД СИРЕНУ.
Dialogue: 0,0:02:33.25,0:02:35.33,Caption,,0,0,0,,МЕЖДУ ТЕМ В КОНЦЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО
Dialogue: 0,0:02:35.33,0:02:38.21,Caption,,0,0,0,,ГОДА МОСКВА ПРЕДЛОЖИЛА ПЕРЕСМОТРЕТЬ УСТРОЙСТВО
Dialogue: 0,0:02:38.21,0:02:40.61,Caption,,0,0,0,,БЕЗОПАСНОСТИ В ЕВРОПЕ. ПРЕДЛОЖЕНИЯ ОТВЕРГЛИ.
Dialogue: 0,0:02:41.25,0:02:44.45,Caption,,0,0,0,,ИРЛАНДСКИЙ ЖУРНАЛИСТ ЧЕЙ БОУЗ СРАВНИЛ ТОТ ПАКЕТ С
Dialogue: 0,0:02:44.45,0:02:47.73,Caption,,0,0,0,,НЫНЕШНИМИ ТРЕБОВАНИЯМИ РОССИИ И ПРИШЁЛ К НЕПРИЯТНОМУ
Dialogue: 0,0:02:47.81,0:02:50.45,Caption,,0,0,0,,ДЛЯ ЕВРОПЫ ВЫВОДУ. ТОГДА РАЗГОВОР МОГ ОБОЙТИСЬ
Dialogue: 0,0:02:50.45,0:02:53.65,Caption,,0,0,0,,ДЕШЕВЛЕ, А ТЕПЕРЬ ПРЕЖНЯЯ ЦЕНА УЖЕ СНЯТА С ВИТРИНЫ.
Dialogue: 0,0:02:53.97,0:02:56.77,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ НЕ ЖЕЛАЮТ ОБСУЖДАТЬ УСЛОВИЯ
Dialogue: 0,0:02:56.77,0:02:59.97,Caption,,0,0,0,,МОСКВЫ. ДОПУСТИМ. НО У ЛЮБОГО ОТКАЗА ДОЛЖЕН
Dialogue: 0,0:03:00.05,0:03:02.21,Caption,,0,0,0,,СУЩЕСТВОВАТЬ СЛЕДУЮЩИЙ ШАГ. ГДЕ ОН?
Dialogue: 0,0:03:02.68,0:03:05.97,Caption,,0,0,0,,НОВЫЙ ПАКЕТ ОГРАНИЧЕНИЙ, ЕЩЁ НЕСКОЛЬКО ЗАЯВЛЕНИЙ,
Dialogue: 0,0:03:06.18,0:03:09.17,Caption,,0,0,0,,ЕЩЁ ОДИН КРУГ ОБЕЩАНИЙ ДАВИТЬ ДО ПОБЕДНОГО КОНЦА?
Dialogue: 0,0:03:09.63,0:03:12.37,Caption,,0,0,0,,ЗА ПЯТЬ ЛЕТ СЧЁТ ВЫРОС. ВМЕСТО БОЛЕЕ МЯГКОГО
Dialogue: 0,0:03:12.37,0:03:17.49,Caption,,0,0,0,,ТОРГА ЕВРОПА ПОЛУЧИЛА ВОЙНУ, РАСШИРЕНИЕ АРМИЙ У СВОИХ ГРАНИЦ И ПРОТИВНИКА,
Dialogue: 0,0:03:17.67,0:03:20.21,Caption,,0,0,0,,КОТОРЫЙ ТЕПЕРЬ ТРЕБУЕТ БОЛЬШЕГО. ВРЕМЯ ЗДЕСЬ
Dialogue: 0,0:03:20.29,0:03:22.05,Caption,,0,0,0,,СРАБОТАЛО НЕ БЕСПЛАТНЫМ ОЖИДАНИЕМ,
Dialogue: 0,0:03:22.29,0:03:25.25,Caption,,0,0,0,,А КРЕДИТОМ С ТЯЖЁЛЫМИ ПРОЦЕНТАМИ. ЗАТЕМ В РАЗГОВОР
Dialogue: 0,0:03:25.33,0:03:28.21,Caption,,0,0,0,,ВОШЁЛ ИЛОН МАСК И ИСПОРТИЛ УДОБНУЮ РАССТАНОВКУ
Dialogue: 0,0:03:28.29,0:03:31.65,Caption,,0,0,0,,СТУЛЬЕВ. РОССИЮ ОН ПРЯМО НАЗВАЛ АГРЕССОРОМ. НО
Dialogue: 0,0:03:31.73,0:03:35.25,Caption,,0,0,0,,СЛЕДОМ ЗАЯВИЛ, ЧТО СОБЫТИЯ НА МАЙДАНЕ В ДВЕ ТЫСЯЧИ ЧЕТЫРНАДЦАТОМ
Dialogue: 0,0:03:35.33,0:03:37.73,Caption,,0,0,0,,ГОДУ БЫЛИ ГОСУДАРСТВЕННЫМ ПЕРЕВОРОТОМ,
Dialogue: 0,0:03:38.05,0:03:40.29,Caption,,0,0,0,,КОТОРЫЙ СОЕДИНЁННЫЕ ШТАТЫ ОРГАНИЗОВАЛИ РАДИ
Dialogue: 0,0:03:40.29,0:03:43.65,Caption,,0,0,0,,СВЕРЖЕНИЯ ДЕМОКРАТИЧЕСКИ ИЗБРАННОГО ПРОРОССИЙСКОГО
Dialogue: 0,0:03:43.65,0:03:49.29,Caption,,0,0,0,,ПРЕЗИДЕНТА. ТАКОЕ ОБВИНЕНИЕ ПРОЗВУЧАЛО НЕ ИЗ МОСКВЫ И НЕ
Dialogue: 0,0:03:49.37,0:03:52.97,Caption,,0,0,0,,ОТ ЧЕЛОВЕКА, КОТОРОГО ЛЕГКО СПИСАТЬ НА РОССИЙСКУЮ СЛУЖБУ. ЕГО
Dialogue: 0,0:03:52.97,0:03:55.85,Caption,,0,0,0,,ПРОИЗНЁС ОДИН ИЗ НАИБОЛЕЕ ИЗВЕСТНЫХ ПРЕДПРИНИМАТЕЛЕЙ
Dialogue: 0,0:03:55.85,0:03:59.37,Caption,,0,0,0,,АМЕРИКИ, ВЛАДЕЛЕЦ КОМПАНИЙ, ОТ КОТОРЫХ ЗАВИСЯТ СВЯЗЬ,
Dialogue: 0,0:03:59.53,0:04:04.33,Caption,,0,0,0,,КОСМОС И ВОЕННЫЕ ТЕХНОЛОГИИ. ЗАПАД ДЕСЯТИЛЕТИЯМИ ПОВТОРЯЕТ,
Dialogue: 0,0:04:04.57,0:04:07.77,Caption,,0,0,0,,ЧТО ЧУЖИМ ГОСУДАРСТВАМ НЕЛЬЗЯ ЛЕЗТЬ ВО ВНУТРЕННИЕ
Dialogue: 0,0:04:07.85,0:04:10.73,Caption,,0,0,0,,ДЕЛА СУВЕРЕННЫХ СТРАН. ОБЫЧНО ЭТО ПРАВИЛО ДОСТАЮТ,
Dialogue: 0,0:04:10.97,0:04:14.01,Caption,,0,0,0,,КОГДА В КАДРЕ ПОЯВЛЯЕТСЯ РОССИЯ. МАСК ПРЕДЛАГАЕТ
Dialogue: 0,0:04:14.01,0:04:17.53,Caption,,0,0,0,,ПРОВЕРИТЬ, РАБОТАЕТ ЛИ ОНО БЕЗ ЗАРАНЕЕ ВЫБРАННОЙ ФАМИЛИИ
Dialogue: 0,0:04:17.53,0:04:21.37,Caption,,0,0,0,,НАРУШИТЕЛЯ. В ДЕКАБРЕ ДВЕ ТЫСЯЧИ ТРИНАДЦАТОГО ГОДА ВИКТОРИЯ
Dialogue: 0,0:04:21.45,0:04:24.73,Caption,,0,0,0,,НУЛАНД, ЗАНИМАВШАЯ ПОСТ ПОМОЩНИКА ГОСУДАРСТВЕННОГО СЕКРЕТАРЯ
Dialogue: 0,0:04:24.73,0:04:26.73,Caption,,0,0,0,,США ПО ДЕЛАМ ЕВРОПЫ И ЕВРАЗИИ,
Dialogue: 0,0:04:26.98,0:04:30.49,Caption,,0,0,0,,ПРИЕХАЛА НА МАЙДАН И РАЗДАВАЛА УЧАСТНИКАМ ЕДУ. В
Dialogue: 0,0:04:30.57,0:04:34.81,Caption,,0,0,0,,ИСТОРИЮ ВОШЛИ ПЕЧЕНЬЯ, ХОТЯ ПОЗДНЕЕ НУЛАНД ГОВОРИЛА О БУТЕРБРОДАХ. НА
Dialogue: 0,0:04:34.89,0:04:38.09,Caption,,0,0,0,,ПЛОЩАДИ ПОЯВЛЯЛИСЬ И ДРУГИЕ ЗАПАДНЫЕ ГОСТИ. КЭТРИН
Dialogue: 0,0:04:38.17,0:04:40.25,Caption,,0,0,0,,ЭШТОН ПРЕДСТАВЛЯЛА ВНЕШНЕПОЛИТИЧЕСКУЮ СЛУЖБУ
Dialogue: 0,0:04:40.25,0:04:43.69,Caption,,0,0,0,,ЕВРОСОЮЗА. МИНИСТР ИНОСТРАННЫХ ДЕЛ ГЕРМАНИИ ГИДО
Dialogue: 0,0:04:43.69,0:04:46.25,Caption,,0,0,0,,ВЕСТЕРВЕЛЛЕ ШЁЛ РЯДОМ С ЛИДЕРАМИ УКРАИНСКОЙ
Dialogue: 0,0:04:46.33,0:04:49.37,Caption,,0,0,0,,ОППОЗИЦИИ. СЕНАТОРЫ ДЖОН МАККЕЙН И КРИС МЁРФИ
Dialogue: 0,0:04:49.37,0:04:52.49,Caption,,0,0,0,,ВЫСТУПАЛИ ПЕРЕД ПРОТЕСТУЮЩИМИ. ЗАПАДНЫЕ ДОЛЖНОСТНЫЕ
Dialogue: 0,0:04:52.49,0:04:55.77,Caption,,0,0,0,,ЛИЦА НЕ НАБЛЮДАЛИ ИЗ ОКОН ПОСОЛЬСТВ. ОНИ ВЫХОДИЛИ
Dialogue: 0,0:04:55.77,0:04:59.85,Caption,,0,0,0,,К ЛЮДЯМ, ВСТРЕЧАЛИСЬ С ОППОЗИЦИЕЙ И ПУБЛИЧНО ПОКАЗЫВАЛИ,
Dialogue: 0,0:04:59.93,0:05:06.30,Caption,,0,0,0,,НА ЧЬЕЙ СТОРОНЕ НАХОДЯТСЯ. ПРЕДСТАВЬТЕ ТУ ЖЕ СЦЕНУ ВО ФРАНЦИИ. В ПАРИЖ
Dialogue: 0,0:05:06.30,0:05:10.46,Caption,,0,0,0,,ПРИБЫВАЕТ СЕРГЕЙ РЯБКОВ, ГУЛЯЕТ СРЕДИ ДЕМОНСТРАНТОВ И УГОЩАЕТ ИХ
Dialogue: 0,0:05:10.46,0:05:13.34,Caption,,0,0,0,,БУТЕРБРОДАМИ. ЗАТЕМ РОССИЙСКИЙ ЧИНОВНИК ИДЁТ ПО
Dialogue: 0,0:05:13.34,0:05:15.42,Caption,,0,0,0,,ПЛОЩАДИ РЯДОМ С ПРОТИВНИКАМИ ФРАНЦУЗСКОГО
Dialogue: 0,0:05:15.50,0:05:18.38,Caption,,0,0,0,,ПРЕЗИДЕНТА. ПОСЛЕ НЕГО СЕНАТОРЫ ИЗ РОССИИ
Dialogue: 0,0:05:18.38,0:05:21.26,Caption,,0,0,0,,ПОДНИМАЮТСЯ НА СЦЕНУ И ОБЕЩАЮТ СОБРАВШИМСЯ
Dialogue: 0,0:05:21.26,0:05:25.02,Caption,,0,0,0,,ПОДДЕРЖКУ. ИМЕННО ПОЭТОМУ ЗАЯВЛЕНИЕ МАСКА ОКАЗАЛОСЬ
Dialogue: 0,0:05:25.10,0:05:27.74,Caption,,0,0,0,,ТАКИМ БОЛЕЗНЕННЫМ. ОН ВЫТАЩИЛ СТАРУЮ ИСТОРИЮ ИЗ
Dialogue: 0,0:05:27.74,0:05:30.14,Caption,,0,0,0,,ПРИВЫЧНОЙ УПАКОВКИ И ПРИМЕНИЛ К НЕЙ ЗАПАДНЫЙ ЖЕ
Dialogue: 0,0:05:30.14,0:05:33.34,Caption,,0,0,0,,КРИТЕРИЙ. ЕСЛИ ПРИСУТСТВИЕ ИНОСТРАННЫХ ЧИНОВНИКОВ
Dialogue: 0,0:05:33.42,0:05:35.58,Caption,,0,0,0,,СРЕДИ ПРОТЕСТУЮЩИХ ЯВЛЯЕТСЯ ВМЕШАТЕЛЬСТВОМ,
Dialogue: 0,0:05:35.90,0:05:38.06,Caption,,0,0,0,,ОЦЕНКА НЕ ДОЛЖНА ЗАВИСЕТЬ ОТ СТРАНЫ В ИХ
Dialogue: 0,0:05:38.06,0:05:41.58,Caption,,0,0,0,,ПАСПОРТЕ. МАСК ПРОДОЛЖИЛ И ЗАТРОНУЛ СПОР ЗЕЛЕНСКОГО
Dialogue: 0,0:05:41.66,0:05:44.14,Caption,,0,0,0,,С АМЕРИКАНСКОЙ СТОРОНОЙ ИЗ ЗА СПУТНИКОВОЙ СВЯЗИ.
Dialogue: 0,0:05:44.54,0:05:46.38,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ГОВОРИЛ ОБ ОГРАНИЧЕНИЯХ,
Dialogue: 0,0:05:46.61,0:05:50.46,Caption,,0,0,0,,А МАСК ОТВЕТИЛ, ЧТО УКРАИНСКИЙ ПРЕЗИДЕНТ НЕ ВСЕГДА ГОВОРИТ ПРАВДУ.
Dialogue: 0,0:05:51.10,0:05:52.86,Caption,,0,0,0,,ЗАТЕМ ОН РАЗДЕЛИЛ ДВЕ СИСТЕМЫ,
Dialogue: 0,0:05:53.18,0:05:56.46,Caption,,0,0,0,,КОТОРЫЕ ЧАСТО СВАЛИВАЮТ В ОДНУ КОРЗИНУ. STARLINK
Dialogue: 0,0:05:56.64,0:05:59.66,Caption,,0,0,0,,ЯВЛЯЕТСЯ КОММЕРЧЕСКИМ ПРОДУКТОМ КОМПАНИИ SPACEX.
Dialogue: 0,0:05:59.98,0:06:02.94,Caption,,0,0,0,,STARSHIELD ПРЕДСТАВЛЯЕТ СОБОЙ ВОЕННУЮ СИСТЕМУ,
Dialogue: 0,0:06:03.10,0:06:05.42,Caption,,0,0,0,,КОТОРОЙ РАСПОРЯЖАЕТСЯ ПРАВИТЕЛЬСТВО СОЕДИНЁННЫХ
Dialogue: 0,0:06:05.42,0:06:08.86,Caption,,0,0,0,,ШТАТОВ. ДЛЯ КИЕВА ЭТО КРАЙНЕ НЕУДОБНОЕ РАЗЛИЧИЕ.
Dialogue: 0,0:06:09.17,0:06:13.42,Caption,,0,0,0,,МАСК НАПОМИНАЕТ, ЧТО ЕГО КОМПАНИЯ ОБЕСПЕЧИЛА УКРАИНЕ СВЯЗЬ В МОМЕНТ,
Dialogue: 0,0:06:13.74,0:06:15.90,Caption,,0,0,0,,КОГДА ОНА БЫЛА ЖИЗНЕННО НЕОБХОДИМА.
Dialogue: 0,0:06:18.19,0:06:20.75,Caption,,0,0,0,,ОДНОВРЕМЕННО ОН ОТКАЗЫВАЕТСЯ ПРЕВРАЩАТЬ КОММЕРЧЕСКИЙ
Dialogue: 0,0:06:20.75,0:06:23.87,Caption,,0,0,0,,STARLINK В СРЕДСТВО ПОДДЕРЖКИ НАСТУПАТЕЛЬНЫХ УДАРОВ
Dialogue: 0,0:06:23.87,0:06:26.03,Caption,,0,0,0,,БЕСПИЛОТНИКАМИ. ПО ЕГО ОЦЕНКЕ,
Dialogue: 0,0:06:26.27,0:06:28.91,Caption,,0,0,0,,БЕЗ ЭТОЙ СЕТИ УКРАИНСКИЙ ФРОНТ ВООБЩЕ МОГ
Dialogue: 0,0:06:28.91,0:06:32.03,Caption,,0,0,0,,РАЗВАЛИТЬСЯ. СПОР ПОЛУЧАЕТСЯ НЕРАВНЫМ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:06:32.03,0:06:34.59,Caption,,0,0,0,,МОЖЕТ ВОЗМУЩАТЬСЯ ОГРАНИЧЕНИЯМИ СКОЛЬКО УГОДНО,
Dialogue: 0,0:06:34.91,0:06:37.39,Caption,,0,0,0,,НО СПУТНИКИ ОТ ЭТОГО НЕ ПЕРЕХОДЯТ ПОД УПРАВЛЕНИЕ
Dialogue: 0,0:06:37.47,0:06:39.95,Caption,,0,0,0,,КИЕВА. КРАСНУЮ ЧЕРТУ РИСУЕТ ТОТ,
Dialogue: 0,0:06:40.10,0:06:42.83,Caption,,0,0,0,,У КОГО НАХОДИТСЯ ВЫКЛЮЧАТЕЛЬ. БАЙДЕНУ НЕ ХВАТИЛО
Dialogue: 0,0:06:42.83,0:06:45.55,Caption,,0,0,0,,ПРИЗНАТЕЛЬНОСТИ. С ТРАМПОМ РАЗГОВОР ЗАКОНЧИЛСЯ
Dialogue: 0,0:06:45.55,0:06:48.27,Caption,,0,0,0,,ПУБЛИЧНОЙ ССОРОЙ. ТЕПЕРЬ МАСК НАПОМИНАЕТ,
Dialogue: 0,0:06:48.50,0:06:51.63,Caption,,0,0,0,,ЧТО КРИТИЧЕСКИ ВАЖНАЯ СВЯЗЬ ПОЯВИЛАСЬ НЕ ПО ЩЕЛЧКУ
Dialogue: 0,0:06:51.63,0:06:54.43,Caption,,0,0,0,,УКРАИНСКОГО РУКОВОДСТВА. КИЕВ СНОВА ТРЕБУЕТ
Dialogue: 0,0:06:54.43,0:06:56.83,Caption,,0,0,0,,ОТНОШЕНИЯ К СЕБЕ КАК К ЦЕНТРУ РЕШЕНИЯ,
Dialogue: 0,0:06:57.04,0:06:59.87,Caption,,0,0,0,,ХОТЯ РЫЧАГ ЛЕЖИТ В ЧУЖОЙ РУКЕ. ПОДПИШИТЕСЬ И
Dialogue: 0,0:06:59.87,0:07:04.11,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, КТО В ТАКОЙ СИСТЕМЕ ДЕЙСТВИТЕЛЬНО ПРИНИМАЕТ РЕШЕНИЯ.
Dialogue: 0,0:07:04.34,0:07:08.43,Caption,,0,0,0,,ДАЛЬШЕ БУДЕТ НЕМЕЦКИЙ БАНК, КОТОРЫЙ СУМЕЛ СОВМЕСТИТЬ БОРЬБУ С РОССИЙСКИМИ
Dialogue: 0,0:07:08.43,0:07:11.23,Caption,,0,0,0,,КАПИТАЛАМИ И ВЕСЬМА ВНИМАТЕЛЬНОЕ ОБСЛУЖИВАНИЕ ИХ
Dialogue: 0,0:07:11.23,0:07:14.03,Caption,,0,0,0,,ВЛАДЕЛЬЦЕВ. ЕВРОПЕЙСКИЕ ЧИНОВНИКИ МНОГО ЛЕТ
Dialogue: 0,0:07:14.03,0:07:17.55,Caption,,0,0,0,,РАССКАЗЫВАЛИ, КАК ПОСЛЕДОВАТЕЛЬНО ОНИ ПЕРЕКРЫВАЮТ ФИНАНСОВЫЕ
Dialogue: 0,0:07:17.63,0:07:20.51,Caption,,0,0,0,,КАНАЛЫ РОССИИ. НА ЭТОМ ФОНЕ РАССЛЕДОВАНИЕ ZDF О
Dialogue: 0,0:07:20.52,0:07:23.07,Caption,,0,0,0,,DEUTSCHE BANK ВЫГЛЯДИТ ОСОБЕННО ПИКАНТНО.
Dialogue: 0,0:07:25.35,0:07:28.95,Caption,,0,0,0,,ИЗ ДОКУМЕНТОВ СЛЕДУЕТ, ЧТО ОН ПРОДОЛЖАЛ РАБОТАТЬ С КЛИЕНТАМИ ВЫСОКОГО
Dialogue: 0,0:07:28.95,0:07:31.27,Caption,,0,0,0,,РИСКА, ВКЛЮЧАЯ РОССИЙСКИХ МИЛЛИАРДЕРОВ,
Dialogue: 0,0:07:31.43,0:07:33.43,Caption,,0,0,0,,ХОТЯ ВНУТРИ ЗВУЧАЛИ ПРЕДУПРЕЖДЕНИЯ,
Dialogue: 0,0:07:33.67,0:07:36.15,Caption,,0,0,0,,А САНКЦИОННЫЕ УГРОЗЫ БЫЛИ ПРЕКРАСНО ИЗВЕСТНЫ.
Dialogue: 0,0:07:36.80,0:07:38.95,Caption,,0,0,0,,НЕКОТОРЫХ КЛИЕНТОВ ПЕРЕВОДИЛИ В ПОДРАЗДЕЛЕНИЯ
Dialogue: 0,0:07:38.95,0:07:42.31,Caption,,0,0,0,,ШВЕЙЦАРИИ И ЛЮКСЕМБУРГА. В МАТЕРИАЛАХ УПОМИНАЮТСЯ
Dialogue: 0,0:07:42.39,0:07:47.27,Caption,,0,0,0,,ОЛЕГ ДЕРИПАСКА, ГЕННАДИЙ ТИМЧЕНКО И СУЛЕЙМАН КЕРИМОВ. СУММЫ ТАМ НЕ
Dialogue: 0,0:07:47.27,0:07:50.15,Caption,,0,0,0,,ДЕКОРАТИВНЫЕ. ОДИН ИЗ ЭПИЗОДОВ КАСАЕТСЯ ПЕРЕВОДА
Dialogue: 0,0:07:50.15,0:07:53.03,Caption,,0,0,0,,ПРИМЕРНО ОДНОГО МИЛЛИАРДА СТА МИЛЛИОНОВ ЕВРО,
Dialogue: 0,0:07:53.28,0:07:55.43,Caption,,0,0,0,,КОТОРЫЙ ПРЕДПОЛОЖИТЕЛЬНО ПРОВОДИЛСЯ В ИНТЕРЕСАХ
Dialogue: 0,0:07:55.43,0:07:58.79,Caption,,0,0,0,,КЕРИМОВА. ПОСЛЕ ЭТОГО РАЗГОВОРЫ О ДВАДЦАТЬ ПЯТОМ,
Dialogue: 0,0:07:59.10,0:08:01.83,Caption,,0,0,0,,ТРИДЦАТЬ ПЯТОМ ИЛИ ТРИСТА ДВАДЦАТЬ ПЯТОМ ПАКЕТЕ
Dialogue: 0,0:08:01.83,0:08:04.95,Caption,,0,0,0,,САНКЦИЙ ПРИОБРЕТАЮТ ОСОБУЮ МУЗЫКУ. ЧИНОВНИКИ
Dialogue: 0,0:08:05.03,0:08:07.91,Caption,,0,0,0,,ОБЪЯВЛЯЮТ ОЧЕРЕДНОЕ ПЕРЕКРЫТИЕ КАНАЛОВ. БАНКИРЫ
Dialogue: 0,0:08:07.99,0:08:12.79,Caption,,0,0,0,,ИЗУЧАЮТ КЛИЕНТА, РАЗМЕР ОПЕРАЦИИ И БУДУЩУЮ КОМИССИЮ. ЗАТЕМ ГДЕ НИБУДЬ
Dialogue: 0,0:08:12.87,0:08:14.79,Caption,,0,0,0,,В ЛЮКСЕМБУРГЕ ОБНАРУЖИВАЕТСЯ ПРОХОД,
Dialogue: 0,0:08:15.03,0:08:17.83,Caption,,0,0,0,,КОТОРОГО СЕКУНДУ НАЗАД ОФИЦИАЛЬНО НЕ СУЩЕСТВОВАЛО.
Dialogue: 0,0:08:18.44,0:08:20.63,Caption,,0,0,0,,САНКЦИОННЫЕ ВОЗМОЖНОСТИ ЕВРОПЫ ПОСТЕПЕННО
Dialogue: 0,0:08:20.63,0:08:24.47,Caption,,0,0,0,,СОКРАЩАЮТСЯ, ПОЭТОМУ ЗАМОРОЖЕННЫЕ РОССИЙСКИЕ АКТИВЫ ПРИОБРЕТАЮТ
Dialogue: 0,0:08:24.55,0:08:27.59,Caption,,0,0,0,,ВСЁ БОЛЬШУЮ ЦЕННОСТЬ. НО ИСТОРИЯ DEUTSCHE BANK
Dialogue: 0,0:08:27.67,0:08:31.19,Caption,,0,0,0,,ПОКАЗЫВАЕТ, НАСКОЛЬКО ДАЛЕКО ЛОЗУНГ МОЖЕТ НАХОДИТЬСЯ ОТ
Dialogue: 0,0:08:31.19,0:08:37.06,Caption,,0,0,0,,ДЕНЕЖНОГО ПЕРЕВОДА. ПОКА С ТРИБУН ОБЕЩАЮТ ФИНАНСОВУЮ ИЗОЛЯЦИЮ,
Dialogue: 0,0:08:37.21,0:08:40.10,Caption,,0,0,0,,КРУПНЫЕ СУММЫ СПОКОЙНО ПУТЕШЕСТВУЮТ ПО ЮРИСДИКЦИЯМ С
Dialogue: 0,0:08:40.10,0:08:43.70,Caption,,0,0,0,,ТАКИМ ВИДОМ, БУДТО ПРОСТО РЕШИЛИ ПРОВЕСТИ ВЫХОДНЫЕ В ШВЕЙЦАРИИ.
Dialogue: 0,0:08:44.37,0:08:47.06,Caption,,0,0,0,,В ВАШИНГТОНЕ ТЕМ ВРЕМЕНЕМ СОЗРЕВАЕТ ДРУГОЙ СЮЖЕТ.
Dialogue: 0,0:08:47.62,0:08:50.02,Caption,,0,0,0,,В ДВЕ ТЫСЯЧИ ШЕСТНАДЦАТОМ ГОДУ ДЖЕЙ ДИ ВЭНС
Dialogue: 0,0:08:50.10,0:08:54.34,Caption,,0,0,0,,НАЗЫВАЛ ТРАМПА МОШЕННИКОМ, ОБВИНЯЛ ЕГО В БЕЗРАЗЛИЧИИ К ПРОСТЫМ ЛЮДЯМ И
Dialogue: 0,0:08:54.34,0:08:57.54,Caption,,0,0,0,,ГОВОРИЛ, ЧТО ТОТ ВЕДЁТ БЕЛЫЙ РАБОЧИЙ КЛАСС В ОЧЕНЬ
Dialogue: 0,0:08:57.54,0:09:00.34,Caption,,0,0,0,,ТЁМНОЕ МЕСТО. ПОЗДНЕЕ ВЭНС СТАЛ СЕНАТОРОМ,
Dialogue: 0,0:09:00.58,0:09:04.82,Caption,,0,0,0,,ЗАТЕМ ВИЦЕ ПРЕЗИДЕНТОМ, А ПОСЛЕ ЭТОГО ОКАЗАЛСЯ СРЕДИ НАИБОЛЕЕ ВЕРОЯТНЫХ
Dialogue: 0,0:09:04.82,0:09:07.54,Caption,,0,0,0,,ПРОДОЛЖАТЕЛЕЙ ТРАМПИСТСКОГО КУРСА. КАРЬЕРА
Dialogue: 0,0:09:07.54,0:09:10.26,Caption,,0,0,0,,ПОЛУЧИЛАСЬ ГИБКАЯ. ПОЗВОНОЧНИК В НЕЙ ЯВНО
Dialogue: 0,0:09:10.26,0:09:14.50,Caption,,0,0,0,,ПРЕДУСМОТРЕН СКЛАДНОЙ. ПОСЛЕ ПОРАЖЕНИЯ РЕСПУБЛИКАНЦЕВ НА ПРОМЕЖУТОЧНЫХ
Dialogue: 0,0:09:14.50,0:09:17.78,Caption,,0,0,0,,ВЫБОРАХ ЭТА БИОГРАФИЯ СТАЛА ОСОБЕННО ПОЛЕЗНОЙ. ВЭНС
Dialogue: 0,0:09:17.78,0:09:20.02,Caption,,0,0,0,,ОБРАЩАЕТСЯ К ТОЙ ЧАСТИ ДВИЖЕНИЯ MAGA,
Dialogue: 0,0:09:20.31,0:09:22.42,Caption,,0,0,0,,КОТОРАЯ НЕДОВОЛЬНА ВНЕШНЕЙ ПОЛИТИКОЙ,
Dialogue: 0,0:09:22.56,0:09:25.46,Caption,,0,0,0,,ИРАНОМ, РАСХОДАМИ И БЕСКОНЕЧНЫМИ ВОЙНАМИ.
Dialogue: 0,0:09:26.01,0:09:28.18,Caption,,0,0,0,,ОН СПОСОБЕН НАПОМНИТЬ СТОРОННИКАМ ТРАМПА,
Dialogue: 0,0:09:28.35,0:09:30.02,Caption,,0,0,0,,ЧТО СЛУЖИЛ РЯДОМ С ИХ ЛИДЕРОМ,
Dialogue: 0,0:09:30.32,0:09:32.74,Caption,,0,0,0,,А ЕГО ПРОТИВНИКАМ ПОКАЗАТЬ СТАРЫЕ ВЫСКАЗЫВАНИЯ И
Dialogue: 0,0:09:32.74,0:09:36.74,Caption,,0,0,0,,СКАЗАТЬ, ЧТО КОГДА ТО ВИДЕЛ ВСЕ НЕДОСТАТКИ ПЕРВЫМ. УДОБНАЯ
Dialogue: 0,0:09:36.82,0:09:39.70,Caption,,0,0,0,,ПОЗИЦИЯ. В КАКУЮ СТОРОНУ НИ ПОВЕРНЁТСЯ ПАРТИЯ,
Dialogue: 0,0:09:40.06,0:09:42.74,Caption,,0,0,0,,У ВЭНСА УЖЕ ПРИГОТОВЛЕНА ФОТОГРАФИЯ ДЛЯ СЕМЕЙНОГО
Dialogue: 0,0:09:42.74,0:09:46.22,Caption,,0,0,0,,АЛЬБОМА. ВОЗМОЖНО,
Dialogue: 0,0:09:46.38,0:09:48.54,Caption,,0,0,0,,ЕГО ПРЕВРАЩЕНИЕ БЫЛО НЕ ЧЕРЕДОЙ СЛУЧАЙНЫХ
Dialogue: 0,0:09:48.54,0:09:52.22,Caption,,0,0,0,,ПЕРЕОБУВАНИЙ, А ВЫГОДНОЙ КОНСТРУКЦИЕЙ И ДЛЯ САМОГО ТРАМПА.
Dialogue: 0,0:09:52.78,0:09:56.22,Caption,,0,0,0,,БЫВШЕГО КРИТИКА ПРИБЛИЗИЛИ, СДЕЛАЛИ ВЕРНЫМ СОРАТНИКОМ,
Dialogue: 0,0:09:56.46,0:09:57.98,Caption,,0,0,0,,А ЗАТЕМ ВОЗМОЖНЫМ НАСЛЕДНИКОМ.
Dialogue: 0,0:09:58.63,0:10:01.26,Caption,,0,0,0,,КОГДА НАКОПИВШЕЕСЯ РАЗДРАЖЕНИЕ НАЧНЁТ МЕШАТЬ
Dialogue: 0,0:10:01.26,0:10:05.42,Caption,,0,0,0,,ДВИЖЕНИЮ, ПРЕЕМНИК СМОЖЕТ СДЕЛАТЬ ПОЛШАГА В СТОРОНУ. ТРАМП
Dialogue: 0,0:10:05.48,0:10:10.38,Caption,,0,0,0,,ПОКИНЕТ СЦЕНУ, НО СОЗДАННАЯ ИМ СИСТЕМА СОХРАНИТСЯ. СТАРЫЕ ВЫПАДЫ
Dialogue: 0,0:10:10.38,0:10:13.10,Caption,,0,0,0,,ВЭНСА ТОГДА ПЕРЕСТАНУТ БЫТЬ КОМПРОМАТОМ И СТАНУТ
Dialogue: 0,0:10:13.10,0:10:15.34,Caption,,0,0,0,,УДОСТОВЕРЕНИЕМ ДЛЯ РАЗГОВОРА С ТЕМИ,
Dialogue: 0,0:10:15.53,0:10:17.26,Caption,,0,0,0,,КТО САМОГО ТРАМПА НЕ ПЕРЕНОСИТ.
Dialogue: 0,0:10:17.82,0:10:20.86,Caption,,0,0,0,,БАЙДЕН ОФОРМЛЯЕТ СОБСТВЕННУЮ ПАМЯТЬ О ПРОШЛОМ И
Dialogue: 0,0:10:20.86,0:10:23.34,Caption,,0,0,0,,ПРЕДЪЯВЛЯЕТ ЗЕЛЕНСКОМУ СЧЁТ ЗА НЕБЛАГОДАРНОСТЬ.
Dialogue: 0,0:10:23.66,0:10:26.46,Caption,,0,0,0,,ТРАМП ОПРЕДЕЛЯЕТ УСЛОВИЯ НАСТОЯЩЕГО И ТРЕБУЕТ
Dialogue: 0,0:10:26.46,0:10:29.34,Caption,,0,0,0,,ПРИЗНАТЬ РЕАЛЬНОЕ СООТНОШЕНИЕ СИЛ. МАСК
Dialogue: 0,0:10:29.42,0:10:31.42,Caption,,0,0,0,,УСТАНАВЛИВАЕТ ПРЕДЕЛЫ ИСПОЛЬЗОВАНИЯ СВОЕЙ
Dialogue: 0,0:10:31.42,0:10:33.98,Caption,,0,0,0,,ТЕХНОЛОГИИ. ЕВРОПА ПРОДОЛЖАЕТ СПОРИТЬ О
Dialogue: 0,0:10:33.98,0:10:38.22,Caption,,0,0,0,,БЕЗОПАСНОСТИ, САНКЦИЯХ И ЧУЖИХ ДЕНЬГАХ. ВЭНС ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:10:38.22,0:10:42.62,Caption,,0,0,0,,ПРИМЕРЯЕТ РОЛЬ ЧЕЛОВЕКА, КОТОРОМУ ПРИДЁТСЯ УПРАВЛЯТЬ ВСЕМ ЭТИМ ПОСЛЕ УХОДА
Dialogue: 0,0:10:42.62,0:10:44.46,Caption,,0,0,0,,НЫНЕШНЕГО ХОЗЯИНА БЕЛОГО ДОМА.
Dialogue: 0,0:10:45.01,0:10:47.50,Caption,,0,0,0,,ДЛЯ УКРАИНЫ ЭТО ОПАСНЕЕ ОЧЕРЕДНОГО СПОРА О
Dialogue: 0,0:10:47.50,0:10:50.46,Caption,,0,0,0,,КОЛИЧЕСТВЕ ПОСТАВЛЕННЫХ РАКЕТ. КИЕВ ЗАВИСИТ ОТ
Dialogue: 0,0:10:50.46,0:10:54.62,Caption,,0,0,0,,ЛЮДЕЙ, ЧЬИ ДОЛЖНОСТИ, ИНТЕРЕСЫ И ПЛАНЫ МЕНЯЮТСЯ БЫСТРЕЕ,
Dialogue: 0,0:10:54.85,0:10:56.70,Caption,,0,0,0,,ЧЕМ ИСПОЛНЯЮТСЯ ПРЕЖНИЕ ОБЕЩАНИЯ.
Dialogue: 0,0:10:58.98,0:11:01.30,Caption,,0,0,0,,ОДИН ПРЕЗИДЕНТ ТРЕБУЕТ БЛАГОДАРНОСТИ,
Dialogue: 0,0:11:01.54,0:11:03.46,Caption,,0,0,0,,ДРУГОЙ ПРЕДЛАГАЕТ ПРОВЕРИТЬ КАРТЫ,
Dialogue: 0,0:11:03.71,0:11:06.10,Caption,,0,0,0,,ТРЕТИЙ ОГРАНИЧИВАЕТ ДОСТУП К ТЕХНОЛОГИИ,
Dialogue: 0,0:11:06.26,0:11:08.82,Caption,,0,0,0,,БЕЗ КОТОРОЙ МОЖЕТ ПОСЫПАТЬСЯ ФРОНТ. СЛЕДОМ
Dialogue: 0,0:11:08.82,0:11:13.54,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ НАСЛЕДНИК, КОГДА ТО НЕНАВИДЕВШИЙ СОБСТВЕННОГО ПОКРОВИТЕЛЯ И
Dialogue: 0,0:11:13.54,0:11:16.50,Caption,,0,0,0,,НАУЧИВШИЙСЯ ИЗВЛЕКАТЬ ПОЛЬЗУ ДАЖЕ ИЗ ЭТОЙ НЕНАВИСТИ.
Dialogue: 0,0:11:16.90,0:11:19.38,Caption,,0,0,0,,ЧЕМ БОЛЬШЕ СУДЬБА СТРАНЫ ВЫНЕСЕНА В КАБИНЕТЫ В
Dialogue: 0,0:11:19.38,0:11:21.94,Caption,,0,0,0,,ВАШИНГТОНЕ, БРЮССЕЛЕ И КАЛИФОРНИИ,
Dialogue: 0,0:11:22.26,0:11:25.38,Caption,,0,0,0,,ТЕМ МЕНЬШЕ ОНА ПРИНАДЛЕЖИТ САМОЙ СТРАНЕ. В КАКОЙ
Dialogue: 0,0:11:25.38,0:11:27.70,Caption,,0,0,0,,ТО МОМЕНТ КИЕВ МОЖЕТ ВОЙТИ В ПЕРЕГОВОРНУЮ И
Dialogue: 0,0:11:27.70,0:11:30.42,Caption,,0,0,0,,ОБНАРУЖИТЬ, ЧТО КРЕСЛО ДЛЯ НЕГО УЖЕ УБРАЛИ,
Dialogue: 0,0:11:30.74,0:11:33.86,Caption,,0,0,0,,А ОСТАЛЬНЫЕ УЧАСТНИКИ ДАВНО ОБСУЖДАЮТ НОВУЮ СХЕМУ.
