Dialogue: 0,0:00:00.12,0:00:03.80,Caption,,0,0,0,,ПОХОЖЕ, ЗЕЛЕНСКОМУ ПРИГОТОВИЛИ ОЧЕНЬ НЕПРИЯТНЫЙ СЮРПРИЗ.
Dialogue: 0,0:00:03.96,0:00:07.24,Caption,,0,0,0,,ПОШЛИ СЛУХИ, ЧТО В МОСКВЕ СНЯЛИ НЕГЛАСНЫЙ ЗАПРЕТ НА ЕГО
Dialogue: 0,0:00:07.24,0:00:09.96,Caption,,0,0,0,,ФИЗИЧЕСКОЕ УСТРАНЕНИЕ. И ЭТО УЖЕ СОВСЕМ ДРУГОЙ
Dialogue: 0,0:00:10.04,0:00:12.20,Caption,,0,0,0,,РАЗГОВОР. ПЯТЫЙ ГОД ИДЁТ ВОЙНА,
Dialogue: 0,0:00:12.44,0:00:15.00,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПРОДОЛЖАЕТ ВЫДВИГАТЬ СВОИ УСЛОВИЯ,
Dialogue: 0,0:00:15.24,0:00:19.80,Caption,,0,0,0,,А ТЕПЕРЬ, ПОХОЖЕ, ВОПРОС СТОИТ УЖЕ О ЕГО СОБСТВЕННОЙ БЕЗОПАСНОСТИ. НО
Dialogue: 0,0:00:19.80,0:00:22.92,Caption,,0,0,0,,ОДНИМ ЭТИМ ДЕЛО НЕ ОГРАНИЧИВАЕТСЯ. ПОТОМУ ЧТО ПОЧТИ
Dialogue: 0,0:00:22.92,0:00:25.56,Caption,,0,0,0,,ОДНОВРЕМЕННО ВНУТРИ САМОЙ УКРАИНЫ ЗАГОВОРИЛИ ОБ
Dialogue: 0,0:00:25.56,0:00:28.60,Caption,,0,0,0,,ОПЕРАЦИИ ПРОТИВ ВЫСШЕГО РУКОВОДСТВА СТРАНЫ. ПРИЧЁМ
Dialogue: 0,0:00:28.60,0:00:33.00,Caption,,0,0,0,,ОБВИНЕНИЯ ПРОЗВУЧАЛИ ОТТУДА, ОТКУДА ИХ МЕНЬШЕ ВСЕГО ОЖИДАЛИ. ТАК ЧТО ЖЕ
Dialogue: 0,0:00:33.00,0:00:37.24,Caption,,0,0,0,,ПРОИСХОДИТ ВОКРУГ ЗЕЛЕНСКОГО? ЕГО ДЕЙСТВИТЕЛЬНО РЕШИЛИ УБРАТЬ ИЛИ КТО ТО ОЧЕНЬ
Dialogue: 0,0:00:37.24,0:00:39.08,Caption,,0,0,0,,ХОЧЕТ, ЧТОБЫ ОН В ЭТО ПОВЕРИЛ?
Dialogue: 0,0:00:39.47,0:00:41.24,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:41.37,0:00:44.28,Caption,,0,0,0,,ПОДПИШИТЕСЬ. СЛУХ КАСАЕТСЯ НЕ ТОЛЬКО ЗЕЛЕНСКОГО,
Dialogue: 0,0:00:44.36,0:00:47.48,Caption,,0,0,0,,НО И ЧАСТИ ВЫСШЕГО УКРАИНСКОГО РУКОВОДСТВА. ПО ЭТОЙ
Dialogue: 0,0:00:47.48,0:00:50.68,Caption,,0,0,0,,ВЕРСИИ, ПРЕДПОЛАГАЕМОЕ РЕШЕНИЕ ПОЯВИЛОСЬ ПОСЛЕ ОБСУЖДЕНИЯ
Dialogue: 0,0:00:50.68,0:00:53.72,Caption,,0,0,0,,СИТУАЦИИ В МОСКВЕ. ПРЕДСТАВИТЕЛИ СИЛОВОГО БЛОКА
Dialogue: 0,0:00:53.72,0:00:56.60,Caption,,0,0,0,,ЯКОБЫ ПОТРЕБОВАЛИ ОТКАЗАТЬСЯ ОТ ПРЕЖНИХ ОГРАНИЧЕНИЙ.
Dialogue: 0,0:00:57.00,0:00:59.80,Caption,,0,0,0,,В КАЧЕСТВЕ ОДНОЙ ИЗ ПРИЧИН НАЗЫВАЮТСЯ ПРОДОЛЖАЮЩИЕСЯ
Dialogue: 0,0:00:59.80,0:01:02.04,Caption,,0,0,0,,УКРАИНСКИЕ АТАКИ НА РОССИЙСКУЮ ТЕРРИТОРИЮ,
Dialogue: 0,0:01:02.28,0:01:05.16,Caption,,0,0,0,,В ЧАСТНОСТИ НА ЛЕНИНГРАДСКУЮ ОБЛАСТЬ. ПОДТВЕРЖДЕНИЯ
Dialogue: 0,0:01:05.24,0:01:08.20,Caption,,0,0,0,,ЭТОМУ РЕШЕНИЮ НЕТ. НО ДЛЯ ПОЛИТИЧЕСКОГО ДАВЛЕНИЯ
Dialogue: 0,0:01:08.20,0:01:10.04,Caption,,0,0,0,,ИНОГДА ДОСТАТОЧНО САМОГО СЛУХА.
Dialogue: 0,0:01:12.32,0:01:14.80,Caption,,0,0,0,,ЗЕЛЕНСКИЙ МОЖЕТ НЕ ВЕРИТЬ В СУЩЕСТВОВАНИЕ ПРИКАЗА,
Dialogue: 0,0:01:15.18,0:01:18.00,Caption,,0,0,0,,НО ИГНОРИРОВАТЬ УГРОЗУ СОБСТВЕННОЙ БЕЗОПАСНОСТИ ЕМУ
Dialogue: 0,0:01:18.08,0:01:21.04,Caption,,0,0,0,,УЖЕ ГОРАЗДО ТРУДНЕЕ. И ЕСЛИ РАНЬШЕ ЗЕЛЕНСКИЙ МОГ
Dialogue: 0,0:01:21.04,0:01:24.32,Caption,,0,0,0,,ИСХОДИТЬ ИЗ ТОГО, ЧТО ЕГО ЛИЧНАЯ БЕЗОПАСНОСТЬ НАХОДИТСЯ ЗА
Dialogue: 0,0:01:24.32,0:01:27.76,Caption,,0,0,0,,ОПРЕДЕЛЁННОЙ ЧЕРТОЙ, ТО ТЕПЕРЬ ЕМУ ПРЕДЛАГАЮТ ЗАДУМАТЬСЯ,
Dialogue: 0,0:01:27.84,0:01:29.76,Caption,,0,0,0,,СУЩЕСТВУЕТ ЛИ ЭТА ЧЕРТА ВООБЩЕ.
Dialogue: 0,0:01:30.35,0:01:33.20,Caption,,0,0,0,,ПЯТЫЙ ГОД ПРОДОЛЖАЮТСЯ БОЕВЫЕ ДЕЙСТВИЯ. РОССИЯ
Dialogue: 0,0:01:33.20,0:01:35.36,Caption,,0,0,0,,НАНОСИТ УДАРЫ ПО УКРАИНСКИМ ВОЕННЫМ И
Dialogue: 0,0:01:35.36,0:01:39.92,Caption,,0,0,0,,ИНФРАСТРУКТУРНЫМ ОБЪЕКТАМ, УКРАИНА АТАКУЕТ ЦЕЛИ НА РОССИЙСКОЙ ТЕРРИТОРИИ. ПРИ
Dialogue: 0,0:01:39.92,0:01:42.48,Caption,,0,0,0,,ЭТОМ ВОПРОС О ФИЗИЧЕСКОМ УСТРАНЕНИИ ДЕЙСТВУЮЩЕГО
Dialogue: 0,0:01:42.48,0:01:44.72,Caption,,0,0,0,,УКРАИНСКОГО РУКОВОДСТВА ДОЛГОЕ ВРЕМЯ ОСТАВАЛСЯ
Dialogue: 0,0:01:44.80,0:01:47.36,Caption,,0,0,0,,ОТДЕЛЬНОЙ ТЕМОЙ. И ВОТ ЭТУ ТЕМУ ТЕПЕРЬ ВЫНОСЯТ
Dialogue: 0,0:01:47.44,0:01:50.08,Caption,,0,0,0,,НА ПОВЕРХНОСТЬ. ПРИЧЁМ НЕ ПОСЛЕ ПРЕКРАЩЕНИЯ БОЕВЫХ
Dialogue: 0,0:01:50.08,0:01:52.24,Caption,,0,0,0,,ДЕЙСТВИЙ, НЕ В СПОКОЙНОЙ ОБСТАНОВКЕ,
Dialogue: 0,0:01:52.47,0:01:54.64,Caption,,0,0,0,,КОГДА ПОЛИТИКИ МОГУТ МЕСЯЦАМИ ОБМЕНИВАТЬСЯ
Dialogue: 0,0:01:54.64,0:01:57.68,Caption,,0,0,0,,ЗАЯВЛЕНИЯМИ. ВСЁ ПРОИСХОДИТ НА ФОНЕ ПЕРЕГОВОРОВ,
Dialogue: 0,0:01:57.92,0:02:00.08,Caption,,0,0,0,,ГДЕ УЧАСТНИКИ ПЫТАЮТСЯ ОПРЕДЕЛИТЬ УСЛОВИЯ
Dialogue: 0,0:02:00.08,0:02:02.96,Caption,,0,0,0,,ДАЛЬНЕЙШЕГО УРЕГУЛИРОВАНИЯ. СОВПАДЕНИЕ ПО ВРЕМЕНИ
Dialogue: 0,0:02:02.96,0:02:05.92,Caption,,0,0,0,,ЗДЕСЬ ПРИНЦИПИАЛЬНО. КОГДА СТОРОНЫ ОБСУЖДАЮТ УСЛОВИЯ
Dialogue: 0,0:02:05.92,0:02:09.76,Caption,,0,0,0,,СОГЛАШЕНИЯ, ЛЮБАЯ ИНФОРМАЦИЯ О ПЕРЕСМОТРЕ ПРЕЖНИХ ОГРАНИЧЕНИЙ
Dialogue: 0,0:02:09.84,0:02:12.96,Caption,,0,0,0,,ПРИОБРЕТАЕТ ДОПОЛНИТЕЛЬНЫЙ ВЕС. НО ДАВАЙТЕ ПОСМОТРИМ
Dialogue: 0,0:02:13.04,0:02:17.76,Caption,,0,0,0,,НА ЭТУ ИСТОРИЮ НЕМНОГО ШИРЕ. ЕСЛИ МОСКВА ДЕЙСТВИТЕЛЬНО ПРИНЯЛА ТАКОЕ РЕШЕНИЕ,
Dialogue: 0,0:02:17.87,0:02:23.65,Caption,,0,0,0,,ЭТО ОДНО РАЗВИТИЕ СОБЫТИЙ. НО ЕСЛИ НИКАКОГО РЕШЕНИЯ НЕ БЫЛО,
Dialogue: 0,0:02:23.81,0:02:26.05,Caption,,0,0,0,,А ИНФОРМАЦИЯ ПОЯВИЛАСЬ ИМЕННО ДЛЯ ТОГО,
Dialogue: 0,0:02:26.29,0:02:28.61,Caption,,0,0,0,,ЧТОБЫ ЗЕЛЕНСКИЙ ПОВЕРИЛ В ИЗМЕНЕНИЕ ПРАВИЛ,
Dialogue: 0,0:02:28.91,0:02:31.25,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ЭФФЕКТ ВСЁ РАВНО СПОСОБЕН ОКАЗАТЬСЯ
Dialogue: 0,0:02:31.25,0:02:34.29,Caption,,0,0,0,,ВЕСЬМА СЕРЬЁЗНЫМ. ПОТОМУ ЧТО УГРОЗА И СООБЩЕНИЕ ОБ
Dialogue: 0,0:02:34.29,0:02:37.09,Caption,,0,0,0,,УГРОЗЕ ДЕЙСТВУЮТ ПО РАЗНОМУ. ПЕРВОЕ СВЯЗАНО С
Dialogue: 0,0:02:37.09,0:02:40.45,Caption,,0,0,0,,РЕАЛЬНЫМИ НАМЕРЕНИЯМИ И ВОЗМОЖНОСТЯМИ. ВТОРОЕ ПРЕЖДЕ
Dialogue: 0,0:02:40.45,0:02:43.25,Caption,,0,0,0,,ВСЕГО ЗАСТАВЛЯЕТ АДРЕСАТА ПЕРЕСМАТРИВАТЬ СОБСТВЕННЫЕ
Dialogue: 0,0:02:43.25,0:02:46.61,Caption,,0,0,0,,РАСЧЁТЫ. ВОТ ЗДЕСЬ И ВОЗНИКАЕТ ЛЮБОПЫТНЫЙ ВОПРОС. А
Dialogue: 0,0:02:46.61,0:02:48.93,Caption,,0,0,0,,КОМУ ВООБЩЕ ПРЕДНАЗНАЧЕНО ТАКОЕ СООБЩЕНИЕ?
Dialogue: 0,0:02:49.07,0:02:51.17,Caption,,0,0,0,,САМОМУ ЗЕЛЕНСКОМУ? ЕГО ОХРАНЕ?
Dialogue: 0,0:02:51.38,0:02:53.33,Caption,,0,0,0,,УКРАИНСКОМУ ВОЕННОМУ КОМАНДОВАНИЮ?
Dialogue: 0,0:02:53.65,0:02:57.25,Caption,,0,0,0,,ИЛИ ЛЮДЯМ, КОТОРЫЕ НАХОДЯТСЯ РЯДОМ С НИМ И ПРЕКРАСНО ПОНИМАЮТ,
Dialogue: 0,0:02:57.41,0:03:00.45,Caption,,0,0,0,,ЧТО ПОЛИТИЧЕСКАЯ КАРЬЕРА ОДНОГО РУКОВОДИТЕЛЯ НЕ
Dialogue: 0,0:03:00.53,0:03:02.85,Caption,,0,0,0,,ОБЯЗАНА СОВПАДАТЬ С ИХ СОБСТВЕННЫМ БУДУЩИМ?
Dialogue: 0,0:03:03.07,0:03:05.65,Caption,,0,0,0,,ВЕДЬ ОКРУЖЕНИЕ ЛЮБОГО ПРЕЗИДЕНТА СОСТОИТ НЕ ИЗ
Dialogue: 0,0:03:05.73,0:03:08.93,Caption,,0,0,0,,ЛЮДЕЙ, КОТОРЫЕ ПОДПИСАЛИ ПОЖИЗНЕННЫЙ ДОГОВОР ВМЕСТЕ С НИМ
Dialogue: 0,0:03:09.01,0:03:11.57,Caption,,0,0,0,,ИДТИ ДО КОНЦА. У КАЖДОГО СВОЯ ДОЛЖНОСТЬ,
Dialogue: 0,0:03:11.65,0:03:17.01,Caption,,0,0,0,,СВОИ СВЯЗИ, СВОЁ ИМУЩЕСТВО, СВОИ ОБЯЗАТЕЛЬСТВА И СВОИ ПЛАНЫ. ПОКА ПОЛОЖЕНИЕ
Dialogue: 0,0:03:17.01,0:03:21.41,Caption,,0,0,0,,РУКОВОДИТЕЛЯ УСТОЙЧИВО, ЭТИ ИНТЕРЕСЫ ОБЫЧНО НЕ ПРОТИВОРЕЧАТ ДРУГ ДРУГУ. НО
Dialogue: 0,0:03:21.41,0:03:23.49,Caption,,0,0,0,,СТОИТ ВОЗНИКНУТЬ СЕРЬЁЗНЫМ СОМНЕНИЯМ,
Dialogue: 0,0:03:23.73,0:03:26.05,Caption,,0,0,0,,КАК ДАЖЕ САМЫЕ ПРЕДАННЫЕ СОРАТНИКИ НАЧИНАЮТ
Dialogue: 0,0:03:26.05,0:03:28.61,Caption,,0,0,0,,ВНИМАТЕЛЬНЕЕ ИЗУЧАТЬ ОБСТАНОВКУ. И ДЛЯ ЭТОГО
Dialogue: 0,0:03:28.61,0:03:32.29,Caption,,0,0,0,,СОВЕРШЕННО НЕОБЯЗАТЕЛЬНО, ЧТОБЫ КТО ТО УЖЕ ГОТОВИЛ СМЕНУ ВЛАСТИ.
Dialogue: 0,0:03:34.56,0:03:37.68,Caption,,0,0,0,,ДОСТАТОЧНО ПОЯВЛЕНИЯ НОВОГО РИСКА. ЕСТЬ И ЕЩЁ ОДНА
Dialogue: 0,0:03:37.76,0:03:40.72,Caption,,0,0,0,,ДЕТАЛЬ. ИНФОРМАЦИЯ ОБ УГРОЗЕ ЗЕЛЕНСКОМУ ПОЯВИЛАСЬ В
Dialogue: 0,0:03:40.72,0:03:44.24,Caption,,0,0,0,,ТОТ МОМЕНТ, КОГДА ВАШИНГТОН И МОСКВА ПРОДОЛЖАЮТ ОБСУЖДАТЬ
Dialogue: 0,0:03:44.24,0:03:47.36,Caption,,0,0,0,,ПЕРСПЕКТИВЫ УРЕГУЛИРОВАНИЯ. ИМЕННО ПОЭТОМУ ВОЗНИКЛА
Dialogue: 0,0:03:47.36,0:03:50.96,Caption,,0,0,0,,ВЕРСИЯ, ЧТО ПОДОБНЫЙ СИГНАЛ ДОЛЖЕН ВЫГЛЯДЕТЬ СОГЛАСОВАННЫМ С
Dialogue: 0,0:03:50.96,0:03:54.16,Caption,,0,0,0,,АМЕРИКАНСКОЙ ПОЗИЦИЕЙ. ОБРАТИТЕ ВНИМАНИЕ НА РАЗНИЦУ.
Dialogue: 0,0:03:54.44,0:03:56.80,Caption,,0,0,0,,ВЫГЛЯДЕТЬ СОГЛАСОВАННЫМ И ДЕЙСТВИТЕЛЬНО БЫТЬ
Dialogue: 0,0:03:56.80,0:03:59.60,Caption,,0,0,0,,СОГЛАСОВАННЫМ НЕ ОДНО И ТО ЖЕ. ВАШИНГТОН МОГ
Dialogue: 0,0:03:59.68,0:04:01.68,Caption,,0,0,0,,ВООБЩЕ НЕ ИМЕТЬ ОТНОШЕНИЯ К ПОЯВЛЕНИЮ ЭТИХ
Dialogue: 0,0:04:01.68,0:04:04.56,Caption,,0,0,0,,СООБЩЕНИЙ. НО ЕСЛИ В КИЕВЕ НАЧИНАЮТ ВОСПРИНИМАТЬ
Dialogue: 0,0:04:04.56,0:04:07.04,Caption,,0,0,0,,АМЕРИКАНСКОЕ ПОЛИТИЧЕСКОЕ ДАВЛЕНИЕ И РОССИЙСКИЙ
Dialogue: 0,0:04:07.04,0:04:09.44,Caption,,0,0,0,,СИЛОВОЙ СИГНАЛ КАК ЧАСТИ ОДНОГО ПРОЦЕССА,
Dialogue: 0,0:04:09.76,0:04:12.88,Caption,,0,0,0,,ЭТО УЖЕ МЕНЯЕТ САМО ВОСПРИЯТИЕ СИТУАЦИИ. И ТЕПЕРЬ
Dialogue: 0,0:04:12.88,0:04:15.52,Caption,,0,0,0,,ВОЗНИКАЕТ ЕЩЁ БОЛЕЕ НЕПРИЯТНЫЙ ДЛЯ УКРАИНСКОГО
Dialogue: 0,0:04:15.52,0:04:18.24,Caption,,0,0,0,,РУКОВОДСТВА ВОПРОС. А НАСКОЛЬКО ТВЁРДЫ ПРЕЖНИЕ
Dialogue: 0,0:04:18.24,0:04:22.00,Caption,,0,0,0,,ГАРАНТИИ, ЕСЛИ ОДНОВРЕМЕННО РАСТЁТ ДАВЛЕНИЕ СО СТОРОНЫ ТЕХ,
Dialogue: 0,0:04:22.24,0:04:24.00,Caption,,0,0,0,,С КЕМ КИЕВ РАССЧИТЫВАЛ ДОГОВАРИВАТЬСЯ?
Dialogue: 0,0:04:24.24,0:04:28.08,Caption,,0,0,0,,ВПРОЧЕМ, НА ЭТОМ ИСТОРИЯ НЕ ЗАКАНЧИВАЕТСЯ. ПОЧТИ ОДНОВРЕМЕННО
Dialogue: 0,0:04:28.16,0:04:30.40,Caption,,0,0,0,,С РАЗГОВОРАМИ О ПРЕДПОЛАГАЕМОМ РЕШЕНИИ МОСКВЫ
Dialogue: 0,0:04:30.40,0:04:33.36,Caption,,0,0,0,,ВЫСТУПИЛ ГЕНЕРАЛ МАЙОР СБУ СЕРГЕЙ ДУКА. И ВОТ
Dialogue: 0,0:04:33.36,0:04:36.00,Caption,,0,0,0,,ЕГО ЗАЯВЛЕНИЕ ЗАСЛУЖИВАЕТ ОТДЕЛЬНОГО ВНИМАНИЯ.
Dialogue: 0,0:04:36.13,0:04:38.80,Caption,,0,0,0,,ПОТОМУ ЧТО ГЕНЕРАЛ ЗАГОВОРИЛ О СПЕЦОПЕРАЦИИ ПРОТИВ
Dialogue: 0,0:04:38.88,0:04:40.96,Caption,,0,0,0,,ВЫСШЕГО ПОЛИТИЧЕСКОГО РУКОВОДСТВА УКРАИНЫ.
Dialogue: 0,0:04:43.24,0:04:46.04,Caption,,0,0,0,,ПРИЧЁМ В КАЧЕСТВЕ УЧАСТНИКОВ ЭТОЙ ОПЕРАЦИИ ОН НАЗВАЛ
Dialogue: 0,0:04:46.12,0:04:48.60,Caption,,0,0,0,,НЕ РОССИЙСКИХ ВОЕННЫХ И НЕ КАКИЕ ТО НЕИЗВЕСТНЫЕ
Dialogue: 0,0:04:48.60,0:04:52.60,Caption,,0,0,0,,ГРУППЫ, ДЕЙСТВУЮЩИЕ ИЗ ЗА ГРАНИЦЫ. ОН ОБВИНИЛ УКРАИНСКИЕ
Dialogue: 0,0:04:52.60,0:04:56.92,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫЕ ОРГАНЫ, НАБУ И САП. ПО УТВЕРЖДЕНИЮ ДУКИ,
Dialogue: 0,0:04:57.15,0:04:59.56,Caption,,0,0,0,,В ИНФОРМАЦИОННОМ ПРОСТРАНСТВЕ СТРАНЫ ПРОВОДИТСЯ
Dialogue: 0,0:04:59.56,0:05:01.56,Caption,,0,0,0,,ЗАРАНЕЕ ОРГАНИЗОВАННАЯ КАМПАНИЯ,
Dialogue: 0,0:05:01.80,0:05:04.44,Caption,,0,0,0,,ЦЕЛЬЮ КОТОРОЙ ЯВЛЯЕТСЯ ДИСКРЕДИТАЦИЯ УКРАИНСКОГО
Dialogue: 0,0:05:04.44,0:05:06.52,Caption,,0,0,0,,РУКОВОДСТВА И ГОСУДАРСТВЕННЫХ СТРУКТУР,
Dialogue: 0,0:05:06.76,0:05:09.71,Caption,,0,0,0,,ОТВЕЧАЮЩИХ ЗА БЕЗОПАСНОСТЬ. ГЕНЕРАЛ СЧИТАЕТ,
Dialogue: 0,0:05:09.95,0:05:12.12,Caption,,0,0,0,,ЧТО ПОДОБНЫЕ ДЕЙСТВИЯ ПОДРЫВАЮТ ДОВЕРИЕ К
Dialogue: 0,0:05:12.20,0:05:13.96,Caption,,0,0,0,,ГОСУДАРСТВУ ИМЕННО В ТОТ МОМЕНТ,
Dialogue: 0,0:05:14.20,0:05:17.00,Caption,,0,0,0,,КОГДА УКРАИНА ВЕДЁТ БОЕВЫЕ ДЕЙСТВИЯ И УЧАСТВУЕТ В
Dialogue: 0,0:05:17.00,0:05:19.32,Caption,,0,0,0,,ПЕРЕГОВОРАХ. И ДАЛЬШЕ ОН ДЕЛАЕТ СОВЕРШЕННО
Dialogue: 0,0:05:19.40,0:05:20.83,Caption,,0,0,0,,ОПРЕДЕЛЁННЫЙ ПОЛИТИЧЕСКИЙ ХОД.
Dialogue: 0,0:05:21.47,0:05:25.88,Caption,,0,0,0,,ДУКА УТВЕРЖДАЕТ, ЧТО ДОЛЖНОСТНЫЕ ЛИЦА НАБУ И САП СОЗНАТЕЛЬНО ЛИБО
Dialogue: 0,0:05:25.96,0:05:28.20,Caption,,0,0,0,,ПО ПРИЧИНЕ ПРОФЕССИОНАЛЬНОЙ НЕСОСТОЯТЕЛЬНОСТИ
Dialogue: 0,0:05:28.28,0:05:30.04,Caption,,0,0,0,,ОКАЗАЛИСЬ ВОВЛЕЧЕНЫ В ДЕЯТЕЛЬНОСТЬ,
Dialogue: 0,0:05:30.27,0:05:33.40,Caption,,0,0,0,,ВЫГОДНУЮ РОССИИ. ВОТ ВАМ И ПОЛОЖЕНИЕ УКРАИНСКИХ
Dialogue: 0,0:05:33.48,0:05:36.20,Caption,,0,0,0,,СИЛОВЫХ СТРУКТУР. ОДНИ РАССЛЕДУЮТ КОРРУПЦИОННЫЕ
Dialogue: 0,0:05:36.20,0:05:40.52,Caption,,0,0,0,,ДЕЛА. ДРУГИЕ ЗАЯВЛЯЮТ, ЧТО САМИ РАССЛЕДОВАТЕЛИ РАБОТАЮТ В ИНТЕРЕСАХ
Dialogue: 0,0:05:40.52,0:05:43.32,Caption,,0,0,0,,ПРОТИВНИКА. И ВСЁ ЭТО ПРОИСХОДИТ НЕ В СПОКОЙНОЕ
Dialogue: 0,0:05:43.32,0:05:46.60,Caption,,0,0,0,,ВРЕМЯ, КОГДА ОЧЕРЕДНОЙ ВЕДОМСТВЕННЫЙ КОНФЛИКТ МОЖНО БЫЛО БЫ
Dialogue: 0,0:05:46.68,0:05:49.48,Caption,,0,0,0,,СПИСАТЬ НА БОРЬБУ ЗА КАБИНЕТЫ И ПОЛНОМОЧИЯ. ИДЁТ
Dialogue: 0,0:05:49.48,0:05:54.47,Caption,,0,0,0,,ВОЙНА. А ВНУТРИ УКРАИНСКОЙ ПРАВООХРАНИТЕЛЬНОЙ СИСТЕМЫ
Dialogue: 0,0:05:54.47,0:05:58.47,Caption,,0,0,0,,НАЧИНАЕТСЯ СПОР УЖЕ НЕ О ТОМ, КТО ДОПУСТИЛ НАРУШЕНИЕ ЗАКОНА,
Dialogue: 0,0:05:58.78,0:06:02.55,Caption,,0,0,0,,А О ТОМ, КТО ВООБЩЕ ДЕЙСТВУЕТ В ИНТЕРЕСАХ ГОСУДАРСТВА. ПРИЧЁМ
Dialogue: 0,0:06:02.55,0:06:05.43,Caption,,0,0,0,,ДУКА НЕ ОГРАНИЧИЛСЯ ОБВИНЕНИЯМИ. ОН ОБРАТИЛСЯ К
Dialogue: 0,0:06:05.43,0:06:09.43,Caption,,0,0,0,,ПРЕЗИДЕНТУ, ВЕРХОВНОЙ РАДЕ И РУКОВОДСТВУ СБУ С ТРЕБОВАНИЕМ ДАТЬ
Dialogue: 0,0:06:09.43,0:06:12.15,Caption,,0,0,0,,ПОЛИТИЧЕСКУЮ И ПРАВОВУЮ ОЦЕНКУ ПРОИСХОДЯЩЕМУ.
Dialogue: 0,0:06:12.38,0:06:14.55,Caption,,0,0,0,,ПРЕДЛОЖИЛ СОЗДАТЬ ПАРЛАМЕНТСКУЮ СЛЕДСТВЕННУЮ
Dialogue: 0,0:06:14.55,0:06:17.19,Caption,,0,0,0,,КОМИССИЮ ДЛЯ ПРОВЕРКИ ДЕЯТЕЛЬНОСТИ АНТИКОРРУПЦИОННЫХ
Dialogue: 0,0:06:17.19,0:06:20.15,Caption,,0,0,0,,ОРГАНОВ. И ЗАЯВИЛ О ГОТОВНОСТИ ПУБЛИЧНО ДАВАТЬ
Dialogue: 0,0:06:20.15,0:06:23.11,Caption,,0,0,0,,ПОКАЗАНИЯ. ТО ЕСТЬ ГЕНЕРАЛ ПРЕДЛАГАЕТ НЕ ПРОСТО
Dialogue: 0,0:06:23.11,0:06:25.91,Caption,,0,0,0,,ВОЗМУТИТЬСЯ ДЕЙСТВИЯМИ СЛЕДОВАТЕЛЕЙ. ОН ПРЕДЛАГАЕТ
Dialogue: 0,0:06:25.91,0:06:28.15,Caption,,0,0,0,,ЗАПУСТИТЬ ПРОТИВ НИХ ОТДЕЛЬНЫЙ МЕХАНИЗМ
Dialogue: 0,0:06:28.15,0:06:30.95,Caption,,0,0,0,,РАССЛЕДОВАНИЯ. В ОБЫЧНОЙ СИТУАЦИИ ТАКАЯ ИНИЦИАТИВА
Dialogue: 0,0:06:31.03,0:06:33.59,Caption,,0,0,0,,УЖЕ ВЫЗВАЛА БЫ НЕМАЛО ВОПРОСОВ. НО ЗДЕСЬ ЕСТЬ
Dialogue: 0,0:06:33.59,0:06:36.79,Caption,,0,0,0,,ОДНА ДЕТАЛЬ, КОТОРАЯ ДЕЛАЕТ ВСЮ КОНСТРУКЦИЮ ОСОБЕННО
Dialogue: 0,0:06:36.79,0:06:40.15,Caption,,0,0,0,,ВЫРАЗИТЕЛЬНОЙ. САМ СЕРГЕЙ ДУКА РАНЕЕ ОКАЗАЛСЯ
Dialogue: 0,0:06:40.15,0:06:42.71,Caption,,0,0,0,,ФИГУРАНТОМ ДЕЛА О ПРЕДПОЛАГАЕМОМ ПОКРОВИТЕЛЬСТВЕ
Dialogue: 0,0:06:42.71,0:06:45.83,Caption,,0,0,0,,МОШЕННИЧЕСКИМ КОЛЛ ЦЕНТРАМ. ПОСЛЕ ЗАДЕРЖАНИЯ ОН
Dialogue: 0,0:06:45.83,0:06:48.07,Caption,,0,0,0,,ВЫШЕЛ ПОД ЗАЛОГ. И ТЕПЕРЬ ЧЕЛОВЕК,
Dialogue: 0,0:06:48.16,0:06:51.27,Caption,,0,0,0,,ОКАЗАВШИЙСЯ ПОД ПОДОЗРЕНИЕМ, ТРЕБУЕТ ПРОВЕРИТЬ ТЕХ,
Dialogue: 0,0:06:51.58,0:06:54.31,Caption,,0,0,0,,КТО ЗАНИМАЕТСЯ АНТИКОРРУПЦИОННЫМИ РАССЛЕДОВАНИЯМИ.
Dialogue: 0,0:06:54.68,0:06:56.87,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ДОВОЛЬНО СВОЕОБРАЗНАЯ КАРТИНА.
Dialogue: 0,0:06:59.15,0:07:02.91,Caption,,0,0,0,,ПОКА ОДНИ ВЫЯСНЯЮТ, КТО ПОЛУЧАЛ ДЕНЬГИ ЗА ПОКРОВИТЕЛЬСТВО ПРЕСТУПНОМУ
Dialogue: 0,0:07:02.91,0:07:06.35,Caption,,0,0,0,,БИЗНЕСУ, ДРУГОЙ УЧАСТНИК ЭТОЙ ИСТОРИИ ПРЕДЛАГАЕТ ВЫЯСНИТЬ,
Dialogue: 0,0:07:06.67,0:07:09.95,Caption,,0,0,0,,НЕ РАБОТАЮТ ЛИ САМИ РАССЛЕДОВАТЕЛИ НА МОСКВУ. ПРИЧЁМ
Dialogue: 0,0:07:09.95,0:07:13.07,Caption,,0,0,0,,ОДНО ОБВИНЕНИЕ ВОВСЕ НЕ ОТМЕНЯЕТ ДРУГОЕ. ЕСЛИ
Dialogue: 0,0:07:13.15,0:07:15.07,Caption,,0,0,0,,ЧЕЛОВЕК ПРОХОДИТ ПО УГОЛОВНОМУ ДЕЛУ,
Dialogue: 0,0:07:15.31,0:07:19.15,Caption,,0,0,0,,ЭТО ЕЩЁ НЕ ОЗНАЧАЕТ, ЧТО ЛЮБЫЕ ЕГО ЗАЯВЛЕНИЯ ЛОЖНЫ. НО И ССЫЛКА
Dialogue: 0,0:07:19.23,0:07:21.95,Caption,,0,0,0,,НА УГРОЗУ ГОСУДАРСТВЕННОЙ БЕЗОПАСНОСТИ НЕ ПРЕВРАЩАЕТ
Dialogue: 0,0:07:22.03,0:07:24.99,Caption,,0,0,0,,ЕГО ОБВИНЕНИЯ В ДОКАЗАТЕЛЬСТВО. А ВОТ ПОЛИТИЧЕСКОЕ
Dialogue: 0,0:07:24.99,0:07:28.27,Caption,,0,0,0,,ЗНАЧЕНИЕ ТАКОГО ВЫСТУПЛЕНИЯ ОТРИЦАТЬ ТРУДНО. ПОТОМУ
Dialogue: 0,0:07:28.27,0:07:31.07,Caption,,0,0,0,,ЧТО ПОД СОМНЕНИЕ СТАВИТСЯ УЖЕ НЕ ОТДЕЛЬНОЕ УГОЛОВНОЕ
Dialogue: 0,0:07:31.07,0:07:34.27,Caption,,0,0,0,,ДЕЛО, А ДЕЯТЕЛЬНОСТЬ ЦЕЛЫХ ГОСУДАРСТВЕННЫХ ОРГАНОВ.
Dialogue: 0,0:07:34.42,0:07:37.79,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. А ТЕПЕРЬ ПОСМОТРИМ,
Dialogue: 0,0:07:37.94,0:07:40.83,Caption,,0,0,0,,ПОЧЕМУ ОБВИНЕНИЯ ДУКИ ВООБЩЕ МОГУТ СТАТЬ СЕРЬЁЗНОЙ
Dialogue: 0,0:07:40.83,0:07:44.75,Caption,,0,0,0,,ПРОБЛЕМОЙ ДЛЯ ЗЕЛЕНСКОГО. В ЭТОЙ ИСТОРИИ ПОЯВЛЯЕТСЯ ЧЕЛОВЕК ПО ПРОЗВИЩУ
Dialogue: 0,0:07:44.75,0:07:48.27,Caption,,0,0,0,,МЕКСИКАНЕЦ, КОТОРОГО СВЯЗЫВАЮТ С НАРКОСИНДИКАТОМ "ХИМПРОМ".
Dialogue: 0,0:07:48.67,0:07:50.75,Caption,,0,0,0,,СОГЛАСНО РАСПРОСТРАНИВШИМСЯ СООБЩЕНИЯМ,
Dialogue: 0,0:07:51.06,0:07:54.43,Caption,,0,0,0,,ОН ПОДТВЕРДИЛ ПОДЛИННОСТЬ ОПЕРАТИВНЫХ ЗАПИСЕЙ НАБУ И
Dialogue: 0,0:07:54.51,0:07:57.07,Caption,,0,0,0,,ЗАЯВИЛ О ПРЕДПОЛАГАЕМЫХ ЕЖЕМЕСЯЧНЫХ МИЛЛИОННЫХ
Dialogue: 0,0:07:57.07,0:08:01.63,Caption,,0,0,0,,ВЫПЛАТАХ ПРЕДСТАВИТЕЛЯМ СБУ, ПОЛИЦИИ И ПРОКУРАТУРЫ. ПО ЕГО УТВЕРЖДЕНИЮ,
Dialogue: 0,0:08:01.87,0:08:04.99,Caption,,0,0,0,,ДЕНЬГИ ДОХОДИЛИ ДО САМОГО ВЕРХА. ЭТО ПОКА ОБВИНЕНИЯ,
Dialogue: 0,0:08:05.15,0:08:07.23,Caption,,0,0,0,,А НЕ УСТАНОВЛЕННЫЕ РЕЗУЛЬТАТЫ РАССЛЕДОВАНИЯ.
Dialogue: 0,0:08:09.50,0:08:11.74,Caption,,0,0,0,,НО ЕСЛИ РЕЧЬ ДЕЙСТВИТЕЛЬНО ИДЁТ О РЕГУЛЯРНЫХ
Dialogue: 0,0:08:11.74,0:08:13.90,Caption,,0,0,0,,ВЫПЛАТАХ ПРЕДСТАВИТЕЛЯМ НЕСКОЛЬКИХ ВЕДОМСТВ,
Dialogue: 0,0:08:14.30,0:08:17.18,Caption,,0,0,0,,ВОПРОС УЖЕ НЕ В ОДНОМ ПРОДАЖНОМ СОТРУДНИКЕ. КТО
Dialogue: 0,0:08:17.18,0:08:19.02,Caption,,0,0,0,,ОБЕСПЕЧИВАЛ РАБОТУ ТАКОЙ СИСТЕМЫ?
Dialogue: 0,0:08:19.42,0:08:22.06,Caption,,0,0,0,,КТО ПРЕДУПРЕЖДАЛ О ПРОВЕРКАХ? КТО ПОЛУЧАЛ ДЕНЬГИ?
Dialogue: 0,0:08:22.75,0:08:25.34,Caption,,0,0,0,,И ЗДЕСЬ ВОЗНИКАЕТ ОЧЕНЬ НЕПРИЯТНОЕ ДЛЯ УКРАИНСКОЙ
Dialogue: 0,0:08:25.34,0:08:28.78,Caption,,0,0,0,,ВЛАСТИ ПРОТИВОРЕЧИЕ. НАБУ И САП ИЩУТ ВОЗМОЖНЫЕ
Dialogue: 0,0:08:28.78,0:08:31.82,Caption,,0,0,0,,КОРРУПЦИОННЫЕ СВЯЗИ В СИЛОВЫХ СТРУКТУРАХ. А ГЕНЕРАЛ
Dialogue: 0,0:08:31.82,0:08:34.30,Caption,,0,0,0,,СБУ ПРЕДЛАГАЕТ РАССЛЕДОВАТЬ ДЕЯТЕЛЬНОСТЬ САМИХ
Dialogue: 0,0:08:34.30,0:08:37.26,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫХ ОРГАНОВ, ОБВИНЯЯ ИХ В ДЕЙСТВИЯХ,
Dialogue: 0,0:08:37.34,0:08:41.50,Caption,,0,0,0,,ВЫГОДНЫХ РОССИИ. ПОЛУЧАЕТСЯ, ОДНИ ИЩУТ КОРРУПЦИОНЕРОВ,
Dialogue: 0,0:08:41.82,0:08:44.46,Caption,,0,0,0,,А ДРУГИЕ ИЩУТ РОССИЙСКИЙ СЛЕД В РАБОТЕ ТЕХ,
Dialogue: 0,0:08:44.58,0:08:47.90,Caption,,0,0,0,,КТО ИЩЕТ КОРРУПЦИОНЕРОВ. И ПОКА ВЕДОМСТВА ВЫЯСНЯЮТ
Dialogue: 0,0:08:47.90,0:08:51.50,Caption,,0,0,0,,ОТНОШЕНИЯ, ПОД УДАРОМ ОКАЗЫВАЕТСЯ УЖЕ СПОСОБНОСТЬ ЗЕЛЕНСКОГО
Dialogue: 0,0:08:51.50,0:08:54.62,Caption,,0,0,0,,КОНТРОЛИРОВАТЬ СОБСТВЕННУЮ СИСТЕМУ БЕЗОПАСНОСТИ. НО
Dialogue: 0,0:08:54.62,0:08:56.54,Caption,,0,0,0,,ЕСТЬ ЕЩЁ ОДНА НЕПРИЯТНАЯ ДЕТАЛЬ,
Dialogue: 0,0:08:56.78,0:08:59.58,Caption,,0,0,0,,ТЕПЕРЬ УЖЕ ИЗ ЭСТОНИИ. РУКОВОДИТЕЛЬ ЭСТОНСКОГО
Dialogue: 0,0:08:59.58,0:09:02.30,Caption,,0,0,0,,ЦЕНТРА БОРЬБЫ С МОШЕННИЧЕСТВОМ ЯАГУП ТООМПУУ
Dialogue: 0,0:09:02.38,0:09:05.58,Caption,,0,0,0,,РАССКАЗАЛ, ЧТО МЕСТНАЯ ПОЛИЦИЯ НЕОДНОКРАТНО ПЕРЕДАВАЛА
Dialogue: 0,0:09:05.58,0:09:08.06,Caption,,0,0,0,,УКРАИНСКИМ КОЛЛЕГАМ СВЕДЕНИЯ О ПОДОЗРЕВАЕМЫХ
Dialogue: 0,0:09:08.06,0:09:10.94,Caption,,0,0,0,,МОШЕННИЧЕСКИХ КОЛЛ ЦЕНТРАХ. А КОГДА СОТРУДНИКИ
Dialogue: 0,0:09:10.94,0:09:12.62,Caption,,0,0,0,,ПРИЕЗЖАЛИ ПО ИЗВЕСТНЫМ АДРЕСАМ,
Dialogue: 0,0:09:12.86,0:09:16.06,Caption,,0,0,0,,ПОМЕЩЕНИЯ ОКАЗЫВАЛИСЬ ПУСТЫМИ. ПРИ ЭТОМ ОН ОТМЕЧАЛ И
Dialogue: 0,0:09:16.06,0:09:19.26,Caption,,0,0,0,,УСПЕШНЫЕ СЛУЧАИ СОТРУДНИЧЕСТВА. ВОПРОС ВОЗНИКАЕТ САМ
Dialogue: 0,0:09:19.26,0:09:21.98,Caption,,0,0,0,,СОБОЙ КТО УСПЕВАЛ ПРЕДУПРЕЖДАТЬ ПОДОЗРЕВАЕМЫХ?
Dialogue: 0,0:09:24.26,0:09:26.66,Caption,,0,0,0,,ОБ АНАЛОГИЧНЫХ ПРОБЛЕМАХ СООБЩАЛОСЬ И В СВЯЗИ С
Dialogue: 0,0:09:26.66,0:09:29.30,Caption,,0,0,0,,МАТЕРИАЛАМИ АВСТРИЙСКОЙ ПОЛИЦИИ ПО ДЕЛУ "КАРФАГЕН".
Dialogue: 0,0:09:29.87,0:09:32.26,Caption,,0,0,0,,МАСШТАБ ЭТОЙ ИСТОРИИ ТОЖЕ НЕМАЛЕНЬКИЙ. ПО
Dialogue: 0,0:09:32.26,0:09:34.34,Caption,,0,0,0,,ПРИВЕДЁННЫМ ЭСТОНСКОЙ СТОРОНОЙ ДАННЫМ,
Dialogue: 0,0:09:34.62,0:09:37.22,Caption,,0,0,0,,УЩЕРБ СОСТАВИЛ ПЯТНАДЦАТЬ МИЛЛИОНОВ ЕВРО ЗА ДВЕ
Dialogue: 0,0:09:37.30,0:09:39.94,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТЫЙ ГОД И ТРИДЦАТЬ ЧЕТЫРЕ
Dialogue: 0,0:09:39.94,0:09:42.74,Caption,,0,0,0,,МИЛЛИОНА ЗА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТЫЙ. ПОЧТИ
Dialogue: 0,0:09:42.74,0:09:45.54,Caption,,0,0,0,,ПЯТЬДЕСЯТ МИЛЛИОНОВ ЕВРО ЗА ДВА ГОДА В СТРАНЕ,
Dialogue: 0,0:09:45.78,0:09:48.26,Caption,,0,0,0,,ГДЕ ЖИВЁТ ОКОЛО ОДНОГО МИЛЛИОНА ТРЁХСОТ ТЫСЯЧ
Dialogue: 0,0:09:48.26,0:09:51.94,Caption,,0,0,0,,ЧЕЛОВЕК. ПОСЛЕ МАСШТАБНЫХ РАССЛЕДОВАНИЙ ЗВОНКИ МОШЕННИКОВ
Dialogue: 0,0:09:51.94,0:09:54.58,Caption,,0,0,0,,ПРЕКРАТИЛИСЬ ПРИМЕРНО НА ШЕСТЬ НЕДЕЛЬ. НО ЗАТЕМ
Dialogue: 0,0:09:54.58,0:09:56.50,Caption,,0,0,0,,ВОЗОБНОВИЛИСЬ. К КОНЦУ ОКТЯБРЯ,
Dialogue: 0,0:09:56.74,0:10:01.30,Caption,,0,0,0,,ПО ОЦЕНКЕ ЭСТОНСКОЙ ПОЛИЦИИ, МАСШТАБЫ ДЕЯТЕЛЬНОСТИ ВЕРНУЛИСЬ К ПРЕЖНЕМУ УРОВНЮ.
Dialogue: 0,0:10:01.49,0:10:04.02,Caption,,0,0,0,,ТО ЕСТЬ МОЖНО ЗАКРЫТЬ ОФИСЫ И ПРОВЕСТИ ОБЫСКИ,
Dialogue: 0,0:10:04.41,0:10:06.50,Caption,,0,0,0,,НО ЕСЛИ СВЯЗИ ВНУТРИ СИСТЕМЫ ОСТАЛИСЬ,
Dialogue: 0,0:10:06.74,0:10:09.94,Caption,,0,0,0,,МОШЕННИЧЕСКАЯ СЕТЬ БЫСТРО ВОЗВРАЩАЕТСЯ. И ВОТ КАК
Dialogue: 0,0:10:10.02,0:10:12.34,Caption,,0,0,0,,ВЫГЛЯДИТ ВСЯ ЭТА ИСТОРИЯ ДЛЯ ЗЕЛЕНСКОГО ВНУТРИ
Dialogue: 0,0:10:12.34,0:10:15.30,Caption,,0,0,0,,СТРАНЫ СИЛОВИКИ ОБВИНЯЮТ АНТИКОРРУПЦИОННЫЕ ОРГАНЫ В
Dialogue: 0,0:10:15.38,0:10:18.90,Caption,,0,0,0,,РАБОТЕ НА МОСКВУ, А ЕВРОПЕЙСКИЕ ПАРТНЁРЫ ОДНОВРЕМЕННО ЗАДАЮТСЯ
Dialogue: 0,0:10:18.90,0:10:21.78,Caption,,0,0,0,,ВОПРОСАМИ ОБ УТЕЧКАХ ИНФОРМАЦИИ. И ПРЕЗИДЕНТУ
Dialogue: 0,0:10:21.78,0:10:23.78,Caption,,0,0,0,,ПРИХОДИТСЯ ДУМАТЬ УЖЕ НЕ ТОЛЬКО О ТОМ,
Dialogue: 0,0:10:23.88,0:10:26.02,Caption,,0,0,0,,КТО ПРАВ. ЕМУ ПРИХОДИТСЯ ПОНИМАТЬ,
Dialogue: 0,0:10:26.18,0:10:28.74,Caption,,0,0,0,,КОМУ ВООБЩЕ МОЖНО ДОВЕРЯТЬ В СОБСТВЕННОМ АППАРАТЕ.
Dialogue: 0,0:10:29.38,0:10:31.70,Caption,,0,0,0,,НА ФОНЕ ВСЕЙ ЭТОЙ ИСТОРИИ ВОЗНИК ЕЩЁ ОДИН
Dialogue: 0,0:10:31.70,0:10:36.15,Caption,,0,0,0,,ПЕРЕГОВОРНЫЙ ЭПИЗОД. ПО СЛОВАМ ЗЕЛЕНСКОГО,
Dialogue: 0,0:10:36.30,0:10:38.47,Caption,,0,0,0,,АМЕРИКАНСКИЕ ПРЕДСТАВИТЕЛИ ПОДНИМАЛИ ВОПРОС О
Dialogue: 0,0:10:38.55,0:10:41.19,Caption,,0,0,0,,ГОТОВНОСТИ УКРАИНЫ ВЫВЕСТИ ВОЙСКА ИЗ ДОНБАССА В
Dialogue: 0,0:10:41.27,0:10:43.19,Caption,,0,0,0,,ОБМЕН НА ПЕРСПЕКТИВУ ЧЛЕНСТВА В НАТО.
Dialogue: 0,0:10:43.75,0:10:47.19,Caption,,0,0,0,,НА ПЕРВЫЙ ВЗГЛЯД, ПРЕДЛОЖЕНИЕ ВЫГЛЯДИТ ДОВОЛЬНО СТРАННО. ВЕДЬ
Dialogue: 0,0:10:47.19,0:10:49.75,Caption,,0,0,0,,РОССИЙСКИЕ ТРЕБОВАНИЯ В ОТНОШЕНИИ УКРАИНЫ И НАТО
Dialogue: 0,0:10:49.83,0:10:52.79,Caption,,0,0,0,,ДАВНО ИЗВЕСТНЫ. МОСКВА НЕОДНОКРАТНО ВЫСТУПАЛА ПРОТИВ
Dialogue: 0,0:10:52.87,0:10:55.83,Caption,,0,0,0,,ВСТУПЛЕНИЯ УКРАИНЫ В АЛЬЯНС И РАССМАТРИВАЛА ВОПРОС
Dialogue: 0,0:10:55.91,0:10:57.83,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЫ НАТО КАК ОДИН ИЗ
Dialogue: 0,0:10:57.83,0:11:00.31,Caption,,0,0,0,,ПРИНЦИПИАЛЬНЫХ. ТОГДА ЗАЧЕМ АМЕРИКАНСКИМ
Dialogue: 0,0:11:00.31,0:11:02.71,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЯМ ВООБЩЕ ЗАДАВАТЬ ЗЕЛЕНСКОМУ ТАКОЙ
Dialogue: 0,0:11:02.71,0:11:06.39,Caption,,0,0,0,,ВОПРОС? А ЕСЛИ АМЕРИКАНЦАМ БЫЛ НУЖЕН НЕ ПОЛОЖИТЕЛЬНЫЙ ОТВЕТ,
Dialogue: 0,0:11:06.69,0:11:09.03,Caption,,0,0,0,,А ИМЕННО ОТКАЗ ЗЕЛЕНСКОГО? ДОПУСТИМ,
Dialogue: 0,0:11:09.26,0:11:12.71,Caption,,0,0,0,,ВАШИНГТОН ПРОВЕРЯЕТ, ГОТОВ ЛИ ЗЕЛЕНСКИЙ ОБСУЖДАТЬ ТЕРРИТОРИАЛЬНЫЙ
Dialogue: 0,0:11:12.71,0:11:15.27,Caption,,0,0,0,,КОМПРОМИСС ДАЖЕ ПРИ ОБЕЩАНИИ СТОЛЬ ЗНАЧИТЕЛЬНОЙ
Dialogue: 0,0:11:15.27,0:11:18.31,Caption,,0,0,0,,УСТУПКИ В СФЕРЕ БЕЗОПАСНОСТИ. ЗЕЛЕНСКИЙ ОТВЕЧАЕТ
Dialogue: 0,0:11:18.31,0:11:21.67,Caption,,0,0,0,,УСЛОВИЯМИ, БЕЗ КОТОРЫХ НЕ СОГЛАСЕН ДВИГАТЬСЯ ДАЛЬШЕ. И
Dialogue: 0,0:11:21.67,0:11:23.91,Caption,,0,0,0,,АМЕРИКАНСКАЯ СТОРОНА ПОЛУЧАЕТ УЖЕ НЕ ОБЩЕЕ
Dialogue: 0,0:11:23.91,0:11:25.83,Caption,,0,0,0,,ВПЕЧАТЛЕНИЕ О ЕГО ЖЁСТКОЙ ПОЗИЦИИ,
Dialogue: 0,0:11:26.07,0:11:29.19,Caption,,0,0,0,,А КОНКРЕТНЫЙ ОТВЕТ НА КОНКРЕТНОЕ ПРЕДЛОЖЕНИЕ. ДАЛЬШЕ
Dialogue: 0,0:11:29.19,0:11:31.19,Caption,,0,0,0,,ТАКОЙ ОТВЕТ МОЖНО ИСПОЛЬЗОВАТЬ В СОБСТВЕННЫХ
Dialogue: 0,0:11:31.19,0:11:34.07,Caption,,0,0,0,,ПОЛИТИЧЕСКИХ РАСЧЁТАХ. НЕ ОБЯЗАТЕЛЬНО ДЛЯ ТОГО,
Dialogue: 0,0:11:34.22,0:11:37.19,Caption,,0,0,0,,ЧТОБЫ ПУБЛИЧНО ОБВИНИТЬ ЗЕЛЕНСКОГО. ИНОГДА ГОРАЗДО
Dialogue: 0,0:11:37.19,0:11:40.95,Caption,,0,0,0,,ВАЖНЕЕ ПОНЯТЬ, КАКУЮ ПОЗИЦИЮ ОН ЗАНИМАЕТ НА САМОМ ДЕЛЕ И
Dialogue: 0,0:11:40.95,0:11:47.78,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО ГОТОВ ЗАЙТИ. НО ЕСЛИ ЦЕЛЬ СОСТОЯЛА ИМЕННО В ПОЛУЧЕНИИ ОТКАЗА,
Dialogue: 0,0:11:48.10,0:11:50.26,Caption,,0,0,0,,ТО РЕЗУЛЬТАТ ОКАЗАЛСЯ ВЕСЬМА ПОКАЗАТЕЛЬНЫМ.
Dialogue: 0,0:11:50.50,0:11:54.10,Caption,,0,0,0,,ЗЕЛЕНСКИЙ, СОГЛАСНО ОПУБЛИКОВАННОМУ ИЗЛОЖЕНИЮ ЕГО ПОЗИЦИИ,
Dialogue: 0,0:11:54.34,0:11:56.58,Caption,,0,0,0,,СВЯЗЫВАЕТ ПОДОБНОЕ РЕШЕНИЕ С ГАРАНТИЯМИ
Dialogue: 0,0:11:56.58,0:11:59.22,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ФИНАНСИРОВАНИЕМ АРМИИ,
Dialogue: 0,0:11:59.38,0:12:02.42,Caption,,0,0,0,,ВООРУЖЕНИЯМИ И СРЕДСТВАМИ НА ВОССТАНОВЛЕНИЕ СТРАНЫ.
Dialogue: 0,0:12:02.83,0:12:05.62,Caption,,0,0,0,,ПРИ ЭТОМ ВОПРОС НЕЙТРАЛЬНОГО СТАТУСА ОН НЕ СЧИТАЕТ
Dialogue: 0,0:12:05.62,0:12:08.98,Caption,,0,0,0,,ПРИЕМЛЕМЫМ, КАК И ПРИЗНАНИЕ УТРАЧЕННЫХ ТЕРРИТОРИЙ РОССИЙСКИМИ.
Dialogue: 0,0:12:09.20,0:12:10.98,Caption,,0,0,0,,ЭТО УЖЕ НЕ ПРОСТО РАЗГОВОР О ТОМ,
Dialogue: 0,0:12:11.14,0:12:14.18,Caption,,0,0,0,,СОГЛАСЕН ЧЕЛОВЕК ИЛИ НЕ СОГЛАСЕН. ЭТО ПЕРЕЧЕНЬ
Dialogue: 0,0:12:14.18,0:12:17.46,Caption,,0,0,0,,УСЛОВИЙ, БЕЗ КОТОРЫХ ОН НЕ ГОТОВ МЕНЯТЬ СВОЮ ПОЗИЦИЮ.
Dialogue: 0,0:12:17.78,0:12:22.58,Caption,,0,0,0,,И ТУТ НЕОБХОДИМО ВСПОМНИТЬ, ЧТО ПЕРЕГОВОРЫ ИДУТ НЕ В ПУСТОТЕ. МОСКВА ПРЕДЪЯВЛЯЕТ
Dialogue: 0,0:12:22.58,0:12:25.38,Caption,,0,0,0,,СОБСТВЕННЫЕ ТРЕБОВАНИЯ. ВАШИНГТОН ИЩЕТ ВАРИАНТ
Dialogue: 0,0:12:25.38,0:12:28.34,Caption,,0,0,0,,СОГЛАШЕНИЯ. ЕВРОПЕЙСКИЕ ГОСУДАРСТВА ИМЕЮТ СВОИ
Dialogue: 0,0:12:28.34,0:12:31.30,Caption,,0,0,0,,ИНТЕРЕСЫ. УКРАИНСКОЕ РУКОВОДСТВО ПЫТАЕТСЯ СОХРАНИТЬ
Dialogue: 0,0:12:31.30,0:12:33.86,Caption,,0,0,0,,СОБСТВЕННЫЕ УСЛОВИЯ. А ТЕПЕРЬ К ОБЫЧНОМУ
Dialogue: 0,0:12:33.86,0:12:36.18,Caption,,0,0,0,,ПОЛИТИЧЕСКОМУ ТОРГУ ДОБАВЛЯЮТСЯ СООБЩЕНИЯ О
Dialogue: 0,0:12:36.18,0:12:39.38,Caption,,0,0,0,,ВОЗМОЖНОЙ УГРОЗЕ ЛИЧНО ЗЕЛЕНСКОМУ И КОНФЛИКТ ВНУТРИ
Dialogue: 0,0:12:39.38,0:12:42.10,Caption,,0,0,0,,УКРАИНСКИХ ПРАВООХРАНИТЕЛЬНЫХ ОРГАНОВ. ВОТ ТАКАЯ
Dialogue: 0,0:12:42.10,0:12:45.06,Caption,,0,0,0,,КОМБИНАЦИЯ. И В ЭТОЙ КОМБИНАЦИИ САМАЯ ИНТЕРЕСНАЯ
Dialogue: 0,0:12:45.14,0:12:47.78,Caption,,0,0,0,,ФИГУРА ДАЖЕ НЕ ОБЯЗАТЕЛЬНО САМ ЗЕЛЕНСКИЙ. КУДА
Dialogue: 0,0:12:47.78,0:12:51.38,Caption,,0,0,0,,ИНТЕРЕСНЕЕ, КАК НА ПРОИСХОДЯЩЕЕ СМОТРЯТ ЛЮДИ ВОКРУГ НЕГО.
Dialogue: 0,0:12:53.66,0:12:55.66,Caption,,0,0,0,,ПОТОМУ ЧТО ПРЕЗИДЕНТ СПОСОБЕН ВЫСТУПАТЬ С
Dialogue: 0,0:12:55.66,0:12:59.26,Caption,,0,0,0,,ЗАЯВЛЕНИЯМИ, ОТКАЗЫВАТЬСЯ ОТ ПРЕДЛОЖЕНИЙ И ТРЕБОВАТЬ НОВЫХ
Dialogue: 0,0:12:59.26,0:13:02.54,Caption,,0,0,0,,ГАРАНТИЙ. НО УСТОЙЧИВОСТЬ ВСЕЙ СИСТЕМЫ ОПРЕДЕЛЯЕТСЯ
Dialogue: 0,0:13:02.54,0:13:06.30,Caption,,0,0,0,,НЕ ТОЛЬКО ЕГО ЛИЧНОЙ ПОЗИЦИЕЙ. ЕСТЬ СИЛОВИКИ. ЕСТЬ
Dialogue: 0,0:13:06.30,0:13:09.90,Caption,,0,0,0,,ЧИНОВНИКИ. ЕСТЬ РУКОВОДИТЕЛИ ВЕДОМСТВ. ЕСТЬ ЛЮДИ,
Dialogue: 0,0:13:10.12,0:13:11.90,Caption,,0,0,0,,КОТОРЫЕ ОТВЕЧАЮТ ЗА БЕЗОПАСНОСТЬ,
Dialogue: 0,0:13:12.04,0:13:15.10,Caption,,0,0,0,,ФИНАНСЫ И ВЫПОЛНЕНИЕ РЕШЕНИЙ. И У КАЖДОГО ИЗ
Dialogue: 0,0:13:15.10,0:13:17.18,Caption,,0,0,0,,НИХ СОБСТВЕННОЕ ПРЕДСТАВЛЕНИЕ О ТОМ,
Dialogue: 0,0:13:17.26,0:13:19.98,Caption,,0,0,0,,ЧТО ПРОИЗОЙДЁТ ДАЛЬШЕ. ПОКА ПОЛИТИЧЕСКИЙ КУРС
Dialogue: 0,0:13:19.98,0:13:24.22,Caption,,0,0,0,,КАЖЕТСЯ УСТОЙЧИВЫМ, ЭТИ ЛЮДИ МОГУТ ДЕЙСТВОВАТЬ СОГЛАСОВАННО. НО КОГДА
Dialogue: 0,0:13:24.22,0:13:26.46,Caption,,0,0,0,,ОДНОВРЕМЕННО ПОЯВЛЯЮТСЯ ВНЕШНИЕ УГРОЗЫ,
Dialogue: 0,0:13:26.70,0:13:29.42,Caption,,0,0,0,,УГОЛОВНЫЕ РАССЛЕДОВАНИЯ И ВЗАИМНЫЕ ОБВИНЕНИЯ В
Dialogue: 0,0:13:29.42,0:13:33.50,Caption,,0,0,0,,РАБОТЕ НА ПРОТИВНИКА, ЕДИНСТВО СИСТЕМЫ УЖЕ НЕЛЬЗЯ ОЦЕНИВАТЬ ТОЛЬКО ПО
Dialogue: 0,0:13:33.50,0:13:36.86,Caption,,0,0,0,,ВЫСТУПЛЕНИЯМ ЕЁ РУКОВОДИТЕЛЯ. И ВОТ ЗДЕСЬ ОБЕ ЛИНИИ
Dialogue: 0,0:13:36.86,0:13:40.14,Caption,,0,0,0,,ДАВЛЕНИЯ НА ЗЕЛЕНСКОГО СХОДЯТСЯ. СНАРУЖИ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:13:40.22,0:13:43.02,Caption,,0,0,0,,СЛУХ О СНЯТИИ ПРЕЖНИХ ОГРАНИЧЕНИЙ НА ЕГО ФИЗИЧЕСКОЕ
Dialogue: 0,0:13:43.02,0:13:46.38,Caption,,0,0,0,,УСТРАНЕНИЕ. ИЗНУТРИ ГЕНЕРАЛ СБУ ГОВОРИТ ОБ ОПЕРАЦИИ
Dialogue: 0,0:13:46.38,0:13:49.18,Caption,,0,0,0,,ПРОТИВ ВЫСШЕГО РУКОВОДСТВА СТРАНЫ И ОБВИНЯЕТ
Dialogue: 0,0:13:49.18,0:13:51.26,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫЕ ОРГАНЫ В ДЕЙСТВИЯХ,
Dialogue: 0,0:13:51.37,0:13:55.34,Caption,,0,0,0,,ВЫГОДНЫХ РОССИИ. ЭТО НЕ ДОКАЗАТЕЛЬСТВО ЕДИНОГО ПЛАНА. НО ДЛЯ
Dialogue: 0,0:13:55.34,0:13:57.66,Caption,,0,0,0,,ЗЕЛЕНСКОГО ПОСЛЕДСТВИЯ МОГУТ ОКАЗАТЬСЯ ВПОЛНЕ
Dialogue: 0,0:13:57.66,0:14:00.38,Caption,,0,0,0,,РЕАЛЬНЫМИ ДАЖЕ БЕЗ ТАКОГО ПЛАНА. ПАРАЛЛЕЛЬНО
Dialogue: 0,0:14:00.38,0:14:03.02,Caption,,0,0,0,,ВАШИНГТОН ПРОВЕРЯЕТ ЕГО ПЕРЕГОВОРНУЮ ПОЗИЦИЮ.
Dialogue: 0,0:14:03.40,0:14:06.14,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫЕ РАССЛЕДОВАНИЯ ЗАТРАГИВАЮТ СИЛОВЫЕ
Dialogue: 0,0:14:06.14,0:14:11.77,Caption,,0,0,0,,СТРУКТУРЫ. ЕВРОПЕЙСКИЕ ПРАВООХРАНИТЕЛИ ЗАДАЮТ ВОПРОСЫ О ТОМ,
Dialogue: 0,0:14:12.05,0:14:15.05,Caption,,0,0,0,,ПОЧЕМУ ПОДОЗРЕВАЕМЫЕ УСПЕВАЮТ ИСЧЕЗАТЬ ДО ПРОВЕРОК.
Dialogue: 0,0:14:15.37,0:14:17.77,Caption,,0,0,0,,И ВОТ ПОПРОБУЙТЕ УПРАВЛЯТЬ ВСЕЙ ЭТОЙ КОНСТРУКЦИЕЙ,
Dialogue: 0,0:14:18.09,0:14:20.41,Caption,,0,0,0,,КОГДА ЕЩЁ ВЧЕРА НАДЁЖНЫЕ ВЕДОМСТВА НАЧИНАЮТ
Dialogue: 0,0:14:20.41,0:14:22.81,Caption,,0,0,0,,ПОДОЗРЕВАТЬ ДРУГ ДРУГА. ОДИН ВОПРОС,
Dialogue: 0,0:14:23.13,0:14:26.01,Caption,,0,0,0,,КОГДА ОПАСНОСТЬ ПРИХОДИТ ИЗВНЕ. СОВСЕМ ДРУГОЙ,
Dialogue: 0,0:14:26.17,0:14:28.49,Caption,,0,0,0,,КОГДА ПРИХОДИТСЯ ОДНОВРЕМЕННО ВЫЯСНЯТЬ,
Dialogue: 0,0:14:28.60,0:14:31.45,Caption,,0,0,0,,КТО И НА ЧЬЕЙ СТОРОНЕ ВНУТРИ СОБСТВЕННОГО АППАРАТА.
Dialogue: 0,0:14:31.66,0:14:34.33,Caption,,0,0,0,,ГОРАЗДО СУЩЕСТВЕННЕЕ ДРУГОЕ ПОЛИТИЧЕСКАЯ СИСТЕМА
Dialogue: 0,0:14:34.33,0:14:37.29,Caption,,0,0,0,,СПОСОБНА ВЫДЕРЖИВАТЬ ОЧЕНЬ СИЛЬНОЕ ДАВЛЕНИЕ ИЗВНЕ,
Dialogue: 0,0:14:37.53,0:14:40.17,Caption,,0,0,0,,ПОКА ЕЁ СОБСТВЕННЫЕ УЧАСТНИКИ УВЕРЕНЫ ДРУГ В ДРУГЕ.
Dialogue: 0,0:14:40.57,0:14:42.73,Caption,,0,0,0,,НО КОГДА ДОВЕРИЕ МЕЖДУ СИЛОВЫМИ СТРУКТУРАМИ
Dialogue: 0,0:14:42.81,0:14:45.13,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ПРЕДМЕТ ВЗАИМНЫХ ОБВИНЕНИЙ,
Dialogue: 0,0:14:45.53,0:14:48.09,Caption,,0,0,0,,КАЖДОЕ НОВОЕ ВНЕШНЕЕ СООБЩЕНИЕ ПОЛУЧАЕТ
Dialogue: 0,0:14:48.09,0:14:50.97,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЙ ВЕС. И ТОГДА СУДЬБУ ДАЛЬНЕЙШИХ
Dialogue: 0,0:14:50.97,0:14:53.45,Caption,,0,0,0,,РЕШЕНИЙ НАЧИНАЕТ ОПРЕДЕЛЯТЬ НЕ ТОЛЬКО ТО,
Dialogue: 0,0:14:53.61,0:14:56.17,Caption,,0,0,0,,ЧЕГО ТРЕБУЮТ ПРОТИВНИКИ ЗА ПЕРЕГОВОРНЫМ СТОЛОМ,
Dialogue: 0,0:14:56.41,0:15:00.01,Caption,,0,0,0,,НО И ТО, НАСКОЛЬКО ТВЁРДО САМО РУКОВОДСТВО КОНТРОЛИРУЕТ
Dialogue: 0,0:15:00.01,0:15:02.81,Caption,,0,0,0,,ЛЮДЕЙ, КОТОРЫМ ПОРУЧЕНО ВЫПОЛНЯТЬ ЭТИ РЕШЕНИЯ.
