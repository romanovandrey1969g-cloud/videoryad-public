Dialogue: 0,0:00:00.12,0:00:02.11,Caption,,0,0,0,,НЕМЕЦКИЙ МИНИСТР ОБОРОНЫ ПРЕДЛАГАЕТ
Dialogue: 0,0:00:02.11,0:00:04.92,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ОТПРАВИТЬСЯ В МОСКВУ. НУ ТАК ЕЗЖАЙТЕ,
Dialogue: 0,0:00:05.00,0:00:07.26,Caption,,0,0,0,,ПОКА ЕСТЬ ОФИЦИАЛЬНОЕ ПРИГЛАШЕНИЕ. А
Dialogue: 0,0:00:07.26,0:00:10.44,Caption,,0,0,0,,ТО ИСТОРИЧЕСКИ, КОГДА НЕМЦЫ ПЫТАЮТСЯ ПРИЕХАТЬ В МОСКВУ
Dialogue: 0,0:00:10.44,0:00:13.53,Caption,,0,0,0,,БЕЗ ПРИГЛАШЕНИЯ, РУССКИЕ ПОЧЕМУ ТО ОКАЗЫВАЮТСЯ В
Dialogue: 0,0:00:13.53,0:00:16.44,Caption,,0,0,0,,БЕРЛИНЕ. ПРИЧЁМ ТОЖЕ БЕЗ ПРИГЛАШЕНИЯ. НО ТУТ,
Dialogue: 0,0:00:16.68,0:00:18.84,Caption,,0,0,0,,СУДЯ ПО ПОСЛЕДНИМ ЗАЯВЛЕНИЯМ ЕВРОПЕЙЦЕВ,
Dialogue: 0,0:00:19.16,0:00:21.88,Caption,,0,0,0,,ДАЖЕ С ПРИГЛАШЕНИЕМ ВОЗНИКЛИ ОПРЕДЕЛЁННЫЕ ТРУДНОСТИ.
Dialogue: 0,0:00:22.11,0:00:24.01,Caption,,0,0,0,,БОРИС ПИСТОРИУС ГОВОРИТ ВПОЛНЕ
Dialogue: 0,0:00:24.01,0:00:27.16,Caption,,0,0,0,,КОНКРЕТНО. РОССИЯ ПРИГЛАШАЕТ ЕВРОПЕЙЦЕВ К РАЗГОВОРУ,
Dialogue: 0,0:00:27.33,0:00:29.38,Caption,,0,0,0,,ЗНАЧИТ НАДО ЕХАТЬ И РАЗГОВАРИВАТЬ.
Dialogue: 0,0:00:29.38,0:00:32.44,Caption,,0,0,0,,БОЛЕЕ ТОГО, ОТКАЗ ОТ ПОЕЗДКИ В МОСКВУ ОН НАЗЫВАЕТ
Dialogue: 0,0:00:32.44,0:00:35.16,Caption,,0,0,0,,СОВЕРШЕННО НЕУМЕСТНЫМ СИГНАЛОМ СО СТОРОНЫ ТЕХ,
Dialogue: 0,0:00:35.40,0:00:37.33,Caption,,0,0,0,,КТО СОБИРАЕТСЯ ОТСТАИВАТЬ СОБСТВЕННЫЕ
Dialogue: 0,0:00:37.33,0:00:39.88,Caption,,0,0,0,,ИНТЕРЕСЫ. КАЗАЛОСЬ БЫ, ЧЕГО ТУТ СЛОЖНОГО?
Dialogue: 0,0:00:39.88,0:00:44.02,Caption,,0,0,0,,ВАС ПРИГЛАСИЛИ. ВЫ ГОВОРИТЕ, ЧТО ХОТИТЕ УЧАСТВОВАТЬ В РЕШЕНИИ
Dialogue: 0,0:00:44.02,0:00:46.12,Caption,,0,0,0,,ВОПРОСА. ВОТ БИЛЕТ, ВОТ САМОЛЁТ,
Dialogue: 0,0:00:46.28,0:00:48.40,Caption,,0,0,0,,ВОТ МОСКВА. НО ЕВРОКОМИССИЯ УЖЕ
Dialogue: 0,0:00:48.40,0:00:51.10,Caption,,0,0,0,,ОБЪЯСНИЛА, ЧТО К ДВУСТОРОННИМ КОНСУЛЬТАЦИЯМ С
Dialogue: 0,0:00:51.10,0:00:54.19,Caption,,0,0,0,,РОССИЕЙ НЕ ГОТОВА. ТОЛЬКО МНОГОСТОРОННИЙ ФОРМАТ.
Dialogue: 0,0:00:54.19,0:00:57.80,Caption,,0,0,0,,ТО ЕСТЬ ЕХАТЬ НАДО, НО ЕХАТЬ ПОКА НЕ ХОТИМ. ИНТЕРЕСЫ
Dialogue: 0,0:00:57.80,0:01:01.00,Caption,,0,0,0,,ОТСТАИВАТЬ НАДО, НО РАЗГОВАРИВАТЬ НАПРЯМУЮ ПОКА ТОЖЕ
Dialogue: 0,0:01:01.00,0:01:04.28,Caption,,0,0,0,,КАК ТО НЕУДОБНО. ЕСЛИ ВАМ ИНТЕРЕСНЕЕ РЕАЛЬНЫЕ ДЕЙСТВИЯ
Dialogue: 0,0:01:04.28,0:01:06.84,Caption,,0,0,0,,ПОЛИТИКОВ, А НЕ КОЛИЧЕСТВО КРАСИВЫХ ЗАЯВЛЕНИЙ,
Dialogue: 0,0:01:07.08,0:01:08.87,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО
Dialogue: 0,0:01:08.87,0:01:11.24,Caption,,0,0,0,,ДАЛЬШЕ С ГОТОВНОСТЬЮ ДЕЙСТВОВАТЬ СТАНОВИТСЯ ЕЩЁ
Dialogue: 0,0:01:11.24,0:01:16.34,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. АМЕРИКАНЦЫ ПРЕДЛОЖИЛИ УКРАИНЕ ГАРАНТИИ
Dialogue: 0,0:01:16.34,0:01:19.51,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ОСНОВАННЫЕ НА ПЯТОЙ СТАТЬЕ НАТО.
Dialogue: 0,0:01:19.51,0:01:22.07,Caption,,0,0,0,,ФОРМУЛИРОВКА КРАСИВАЯ. ПОЧТИ НАТО,
Dialogue: 0,0:01:22.31,0:01:26.33,Caption,,0,0,0,,ПОЧТИ ПЯТАЯ СТАТЬЯ, ПОЧТИ ВСЁ СЕРЬЁЗНО. И ТУТ ЕВРОПЕЙЦЫ
Dialogue: 0,0:01:26.33,0:01:29.61,Caption,,0,0,0,,НЕМНОГО ЗАВИСЛИ. ОДИН ИЗ ДИПЛОМАТОВ СТРАН АЛЬЯНСА
Dialogue: 0,0:01:29.61,0:01:32.70,Caption,,0,0,0,,СФОРМУЛИРОВАЛ ПРОБЛЕМУ ПРЕДЕЛЬНО ПРОСТО. ТЫ ЛИБО В
Dialogue: 0,0:01:32.70,0:01:35.48,Caption,,0,0,0,,НАТО, ЛИБО ВНЕ НАТО. СЕРЕДИНЫ НЕТ. ВОТ И
Dialogue: 0,0:01:35.48,0:01:38.39,Caption,,0,0,0,,ВСЁ. НЕСКОЛЬКО ЛЕТ ОБСУЖДАЛИ ГАРАНТИИ,
Dialogue: 0,0:01:38.56,0:01:42.71,Caption,,0,0,0,,КОНСТРУКЦИИ, ФОРМАТЫ, ОБЯЗАТЕЛЬСТВА. А КОГДА АМЕРИКАНЦЫ
Dialogue: 0,0:01:42.71,0:01:44.79,Caption,,0,0,0,,ПОЛОЖИЛИ НА СТОЛ КОНКРЕТНУЮ ФОРМУЛУ,
Dialogue: 0,0:01:45.05,0:01:48.13,Caption,,0,0,0,,ВНЕЗАПНО ВЫЯСНИЛОСЬ, ЧТО МЕЖДУ ЧЛЕНСТВОМ В НАТО И
Dialogue: 0,0:01:48.13,0:01:50.77,Caption,,0,0,0,,НЕЧЛЕНСТВОМ В НАТО КАКАЯ ТО ПОДОЗРИТЕЛЬНО УЗКАЯ
Dialogue: 0,0:01:50.77,0:01:53.67,Caption,,0,0,0,,ДВЕРЬ. ТЕМ БОЛЕЕ РЯДОМ ПРЕЗИДЕНТ РУМЫНИИ
Dialogue: 0,0:01:53.67,0:01:56.85,Caption,,0,0,0,,НИКУШОР ДАН ГОВОРИТ ЕЩЁ ОДНУ ОЧЕНЬ ПОЛЕЗНУЮ ВЕЩЬ.
Dialogue: 0,0:01:56.85,0:01:59.63,Caption,,0,0,0,,УЧАСТИЕ НАТО В СБИВАНИИ ЦЕЛЕЙ НАД ТЕРРИТОРИЕЙ
Dialogue: 0,0:01:59.63,0:02:02.74,Caption,,0,0,0,,УКРАИНЫ ОЗНАЧАЛО БЫ СОВМЕСТНОЕ УЧАСТИЕ В ВОЕННЫХ
Dialogue: 0,0:02:02.74,0:02:06.11,Caption,,0,0,0,,ДЕЙСТВИЯХ. ОН ЭТОТ ВОПРОС УЖЕ АНАЛИЗИРОВАЛ ПРИМЕРНО ГОД
Dialogue: 0,0:02:06.11,0:02:08.87,Caption,,0,0,0,,НАЗАД И ВЫВОД У НЕГО БЫЛ ИМЕННО ТАКОЙ. ПОЛЬША
Dialogue: 0,0:02:08.87,0:02:11.68,Caption,,0,0,0,,ПРЕДЛАГАЕТ ПЕРЕХВАТЫВАТЬ РОССИЙСКИЕ РАКЕТЫ НАД
Dialogue: 0,0:02:11.68,0:02:14.67,Caption,,0,0,0,,УКРАИНОЙ. НАТО ИНИЦИАТИВУ НЕ ПОДДЕРЖИВАЕТ. ТО ЕСТЬ
Dialogue: 0,0:02:14.67,0:02:18.69,Caption,,0,0,0,,ПОКА РЕЧЬ ИДЁТ О СЛОВАХ, ГАРАНТИЯХ МОЖНО ПРИДУМЫВАТЬ КРАСИВЫЕ
Dialogue: 0,0:02:18.69,0:02:21.59,Caption,,0,0,0,,НАЗВАНИЯ. КАК ТОЛЬКО ПОЯВЛЯЕТСЯ КОНКРЕТНОЕ ДЕЙСТВИЕ,
Dialogue: 0,0:02:21.75,0:02:24.07,Caption,,0,0,0,,СБИТЬ РАКЕТУ, ОТПРАВИТЬ ВОЕННЫХ,
Dialogue: 0,0:02:24.39,0:02:26.23,Caption,,0,0,0,,ВЗЯТЬ НА СЕБЯ ПРЯМУЮ ОТВЕТСТВЕННОСТЬ,
Dialogue: 0,0:02:26.47,0:02:28.47,Caption,,0,0,0,,СРАЗУ ВЫЯСНЯЕТСЯ ЦЕНА ВОПРОСА.
Dialogue: 0,0:02:30.74,0:02:34.32,Caption,,0,0,0,,И ЭТО НАДО ДЕРЖАТЬ В ГОЛОВЕ, КОГДА НАМ РАССКАЗЫВАЮТ О ГАРАНТИЯХ ПО
Dialogue: 0,0:02:34.32,0:02:38.21,Caption,,0,0,0,,ОБРАЗЦУ ПЯТОЙ СТАТЬИ. ЕСЛИ СУДИТЬ ПО ОТКРОВЕНИЯМ КУШНЕРА И
Dialogue: 0,0:02:38.21,0:02:40.34,Caption,,0,0,0,,ТОМУ, КАКИЕ ВЫВОДЫ ИЗ НИХ СЛЕДУЮТ,
Dialogue: 0,0:02:40.66,0:02:42.60,Caption,,0,0,0,,АМЕРИКАНЦЫ ПРЕКРАСНО ПОНИМАЮТ ВСЮ ЭТУ
Dialogue: 0,0:02:42.60,0:02:45.22,Caption,,0,0,0,,КОНСТРУКЦИЮ. ПУТИН, СОГЛАСНО ЭТОЙ ОЦЕНКЕ,
Dialogue: 0,0:02:45.46,0:02:47.42,Caption,,0,0,0,,ГОТОВ ИДТИ НА ОГРАНИЧЕННЫЕ УСТУПКИ
Dialogue: 0,0:02:47.42,0:02:50.86,Caption,,0,0,0,,РАДИ СОГЛАШЕНИЯ. ЗЕЛЕНСКИЙ ПРИ ПРИБЛИЖЕНИИ К КОНКРЕТНОЙ
Dialogue: 0,0:02:50.86,0:02:53.55,Caption,,0,0,0,,ТОЧКЕ НАЧИНАЕТ УХОДИТЬ ОТ РЕЗУЛЬТАТА. И ЕГО
Dialogue: 0,0:02:53.55,0:02:56.06,Caption,,0,0,0,,ЛИЧНОЕ ПОЛОЖЕНИЕ АМЕРИКАНЦАМ ТОЖЕ ДОЛЖНО БЫТЬ
Dialogue: 0,0:02:56.06,0:02:58.24,Caption,,0,0,0,,ПОНЯТНО. ЗЕЛЕНСКИЙ В ЭТОЙ КОНСТРУКЦИИ
Dialogue: 0,0:02:58.24,0:03:01.46,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО КАНАТОХОДЕЦ. ПОКА ОН ИДЁТ ПО КАНАТУ,
Dialogue: 0,0:03:01.53,0:03:05.77,Caption,,0,0,0,,ВСЁ ДЕРЖИТСЯ. ОСТАНОВИЛСЯ, НАЧИНАЮТСЯ ВОПРОСЫ. ПОТОМУ ЧТО ЛЮБОЕ
Dialogue: 0,0:03:05.77,0:03:08.68,Caption,,0,0,0,,СОГЛАШЕНИЕ, КОТОРОЕ НЕЛЬЗЯ ПРОДАТЬ КАК АБСОЛЮТНУЮ
Dialogue: 0,0:03:08.68,0:03:11.75,Caption,,0,0,0,,ПОБЕДУ, БЬЁТ УЖЕ НЕ ТОЛЬКО ПО ПОЗИЦИИ УКРАИНЫ.
Dialogue: 0,0:03:11.75,0:03:14.10,Caption,,0,0,0,,ОНО БЬЁТ ЛИЧНО ПО МИФУ ЗЕЛЕНСКОГО. ПО
Dialogue: 0,0:03:14.10,0:03:17.64,Caption,,0,0,0,,ОБРАЗУ ЧЕЛОВЕКА, КОТОРЫЙ ОБЕЩАЛ ПОБЕДУ И ПЯТЬ ЛЕТ ВЁЛ
Dialogue: 0,0:03:17.64,0:03:20.52,Caption,,0,0,0,,СТРАНУ К ЭТОЙ ПОБЕДЕ. ДЛЯ УКРАИНЫ ВОЙНА СТОИТ
Dialogue: 0,0:03:20.52,0:03:22.74,Caption,,0,0,0,,ЛЮДЕЙ, ГОРОДОВ, ИНФРАСТРУКТУРЫ,
Dialogue: 0,0:03:22.83,0:03:25.24,Caption,,0,0,0,,ЭКОНОМИКИ И БУДУЩЕГО. ДЛЯ ЗЕЛЕНСКОГО
Dialogue: 0,0:03:25.24,0:03:28.68,Caption,,0,0,0,,МИР ТОЖЕ ИМЕЕТ ЦЕНУ. ТОЛЬКО ЦЕНА ЭТА УЖЕ ПОЛИТИЧЕСКАЯ
Dialogue: 0,0:03:28.68,0:03:31.43,Caption,,0,0,0,,И ОЧЕНЬ ЛИЧНАЯ. ПОЭТОМУ ОГРАНИЧЕННОЕ ДАВЛЕНИЕ
Dialogue: 0,0:03:31.43,0:03:33.39,Caption,,0,0,0,,НА НЕГО РАБОТАЕТ ПРИМЕРНО КАК ЛЁГКОЕ
Dialogue: 0,0:03:33.39,0:03:35.46,Caption,,0,0,0,,ПОСТУКИВАНИЕ ПО ПЛЕЧУ. НЕПРИЯТНО,
Dialogue: 0,0:03:35.54,0:03:38.20,Caption,,0,0,0,,КОНЕЧНО. НО ЖИТЬ МОЖНО. КРЕМЛЬ ТОЖЕ
Dialogue: 0,0:03:38.20,0:03:40.49,Caption,,0,0,0,,ДАВИТ ОГРАНИЧЕННО. АМЕРИКАНЦЫ ДАВЯТ
Dialogue: 0,0:03:40.49,0:03:42.74,Caption,,0,0,0,,ОГРАНИЧЕННО. ЗЕЛЕНСКИЙ ИЗВИВАЕТСЯ,
Dialogue: 0,0:03:42.84,0:03:48.91,Caption,,0,0,0,,СПОРИТ, ТЯНЕТ ВРЕМЯ. ЗАТЕМ ПОЯВЛЯЕТСЯ ОЧЕРЕДНОЙ КОНКРЕТНЫЙ
Dialogue: 0,0:03:48.91,0:03:53.25,Caption,,0,0,0,,ШАГ. И ЧТО ПРОИСХОДИТ ДАЛЬШЕ? ЭСКАЛАЦИЯ. ПОТОМ СНОВА ПЕРЕГОВОРЫ.
Dialogue: 0,0:03:53.25,0:03:56.74,Caption,,0,0,0,,СНОВА ВСТРЕЧИ. СНОВА ПОСРЕДНИКИ. СНОВА ОБМЕНЫ
Dialogue: 0,0:03:56.74,0:04:01.35,Caption,,0,0,0,,ПЛЕННЫМИ, ОБМЕНЫ ТЕЛАМИ, ЛОКАЛЬНЫЕ ДОГОВОРЁННОСТИ ВРОДЕ АЛЁШЕК.
Dialogue: 0,0:04:01.35,0:04:03.58,Caption,,0,0,0,,ЗАТЕМ СНОВА ДОХОДИМ ДО РЕАЛЬНОЙ ТОЧКИ
Dialogue: 0,0:04:03.58,0:04:07.36,Caption,,0,0,0,,СОПРИКОСНОВЕНИЯ. И СНОВА ЭСКАЛАЦИЯ. НУ ХОРОШО. ВЫ ВСЁ ЭТО
Dialogue: 0,0:04:07.36,0:04:10.49,Caption,,0,0,0,,ПОНИМАЕТЕ. ВЫ ПРЕКРАСНО ПОНИМАЕТЕ ВЕСЬ МАРШРУТ ЭТОГО
Dialogue: 0,0:04:10.49,0:04:13.59,Caption,,0,0,0,,КАНАТОХОДЦА. ВЫ УЖЕ ЗНАЕТЕ, ГДЕ ОН ОСТАНОВИТСЯ,
Dialogue: 0,0:04:13.83,0:04:15.87,Caption,,0,0,0,,ГДЕ НАЧНЁТ РАСКАЧИВАТЬ КАНАТ И ГДЕ
Dialogue: 0,0:04:15.87,0:04:18.31,Caption,,0,0,0,,ОЧЕРЕДНОЙ КРУГ ЗАКОНЧИТСЯ. А ДАЛЬШЕ ЧТО?
Dialogue: 0,0:04:18.71,0:04:20.63,Caption,,0,0,0,,КАКИМ ОБРАЗОМ ВЫ НАМЕРЕНЫ ЭТО ИЗМЕНИТЬ?
Dialogue: 0,0:04:20.93,0:04:24.60,Caption,,0,0,0,,ВЫ БУДЕТЕ ЭТО МЕНЯТЬ ИЛИ НЕТ? ИЛИ БУДЕМ ДАЛЬШЕ ТОПТАТЬСЯ И ПРОХОДИТЬ
Dialogue: 0,0:04:24.60,0:04:26.55,Caption,,0,0,0,,ВСЕ ЭТИ ПУТИ С ОДИНАКОВЫМ РЕЗУЛЬТАТОМ?
Dialogue: 0,0:04:26.87,0:04:28.72,Caption,,0,0,0,,ТЕМ БОЛЕЕ ВРЕМЕНИ У АДМИНИСТРАЦИИ
Dialogue: 0,0:04:28.72,0:04:31.71,Caption,,0,0,0,,ТРАМПА ТОЖЕ НЕ БЕСКОНЕЧНО МНОГО. ОЧЕНЬ СКОРО ВНУТРИ
Dialogue: 0,0:04:31.71,0:04:34.28,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТОВ СОБСТВЕННАЯ ПОЛИТИКА НАЧНЁТ
Dialogue: 0,0:04:34.28,0:04:37.00,Caption,,0,0,0,,ОТЪЕДАТЬ ВСЁ БОЛЬШЕ ВНИМАНИЯ. И ТОГДА КРАСИВЫЙ
Dialogue: 0,0:04:37.00,0:04:40.17,Caption,,0,0,0,,ПЕРЕГОВОРНЫЙ ПРОЦЕСС ЛЕГКО ОСТАНЕТСЯ ПЕРЕГОВОРНЫМ
Dialogue: 0,0:04:40.17,0:04:43.28,Caption,,0,0,0,,ПРОЦЕССОМ. БЕЗ ВЫХОДА ИЗ ТУННЕЛЯ. ПОДДЕРЖИТЕ КАНАЛ
Dialogue: 0,0:04:43.28,0:04:46.40,Caption,,0,0,0,,ПОДПИСКОЙ. ПОТОМУ ЧТО ОДНО ДЕЛО ЗНАТЬ ОЧЕРЕДНУЮ
Dialogue: 0,0:04:46.40,0:04:48.39,Caption,,0,0,0,,НОВОСТЬ. СОВСЕМ ДРУГОЕ ДЕЛО ПОНИМАТЬ,
Dialogue: 0,0:04:48.52,0:04:50.35,Caption,,0,0,0,,ПОЧЕМУ ПЕРЕГОВОРЫ РАЗ ЗА РАЗОМ
Dialogue: 0,0:04:50.35,0:04:53.27,Caption,,0,0,0,,ПРИВОДЯТ В ОДНО И ТО ЖЕ МЕСТО. А ТЕПЕРЬ ЕЩЁ ОДНА
Dialogue: 0,0:04:53.27,0:04:55.39,Caption,,0,0,0,,ИСТОРИЯ ПРО ЭСКАЛАЦИЮ. ТОЛЬКО СМОТРИТЕ
Dialogue: 0,0:04:55.39,0:04:57.96,Caption,,0,0,0,,НЕ ПЕРЕПУТАЙТЕ. ЭТО РОССИЯ ЭСКАЛИРУЕТ НА
Dialogue: 0,0:04:57.96,0:05:00.71,Caption,,0,0,0,,БАЛТИЙСКОМ МОРЕ. НЕ УКРАИНА. НЕТ,
Dialogue: 0,0:05:00.80,0:05:05.47,Caption,,0,0,0,,НЕТ. ИМЕННО РОССИЯ. ВАМ ТУТ ГЛАВНОЕ НИЧЕГО
Dialogue: 0,0:05:05.47,0:05:08.18,Caption,,0,0,0,,НЕ СПУТАТЬ. ПОТОМУ ЧТО НА ДРУГОМ КОНЦЕ ЕВРОПЫ
Dialogue: 0,0:05:08.18,0:05:11.14,Caption,,0,0,0,,ПРОИЗОШЛА ЗАНЯТНАЯ ВЕЩЬ. В РАЙОНЕ БЕНГАЗИ АТАКОВАЛИ
Dialogue: 0,0:05:11.14,0:05:14.66,Caption,,0,0,0,,РОССИЙСКИЕ КОРАБЛИ. ПРИЧЁМ РЕЧЬ ШЛА СРАЗУ О ДВУХ СУДАХ,
Dialogue: 0,0:05:14.74,0:05:17.78,Caption,,0,0,0,,ГРАЖДАНСКОМ И ВОЕННОМ. И ЭТО ПРИНЦИПИАЛЬНАЯ ДЕТАЛЬ.
Dialogue: 0,0:05:18.10,0:05:21.39,Caption,,0,0,0,,ЕСТЬ ЖЁСТКАЯ ОЦЕНКА, ЧТО ЭТО ПЕРВАЯ УКРАИНСКАЯ АТАКА НА
Dialogue: 0,0:05:21.39,0:05:23.82,Caption,,0,0,0,,РОССИЙСКИЕ КОРАБЛИ НА ТЕРРИТОРИИ ТРЕТЬЕГО
Dialogue: 0,0:05:23.82,0:05:27.67,Caption,,0,0,0,,ГОСУДАРСТВА. НЕ ВОЗЛЕ ОДЕССЫ. НЕ В ЧЁРНОМ МОРЕ У УКРАИНСКОГО
Dialogue: 0,0:05:27.67,0:05:31.94,Caption,,0,0,0,,ПОБЕРЕЖЬЯ. НЕ ТАМ, ГДЕ ДВЕ СТОРОНЫ НЕПОСРЕДСТВЕННО ВОЮЮТ.
Dialogue: 0,0:05:31.94,0:05:34.51,Caption,,0,0,0,,ЛИВИЯ. И СТРАНА ВЫБРАНА ДАЛЕКО НЕ СЛУЧАЙНО.
Dialogue: 0,0:05:34.51,0:05:37.62,Caption,,0,0,0,,РАСЧЁТ ПОНЯТНЫЙ. ОТ ЛИВИИ ТРУДНО ОЖИДАТЬ ТАКОЙ ОТВЕТ,
Dialogue: 0,0:05:37.86,0:05:39.82,Caption,,0,0,0,,КОТОРЫЙ НЕМЕДЛЕННО ИЗМЕНИТ ХОД ВОЙНЫ
Dialogue: 0,0:05:39.82,0:05:42.63,Caption,,0,0,0,,НА УКРАИНЕ. ТОЛЬКО ВМЕСТЕ С РОССИЙСКИМИ КОРАБЛЯМИ
Dialogue: 0,0:05:42.63,0:05:45.14,Caption,,0,0,0,,ПОД УДАРОМ ОКАЗЫВАЕТСЯ УЖЕ ЧУЖАЯ ТЕРРИТОРИЯ,
Dialogue: 0,0:05:45.30,0:05:48.99,Caption,,0,0,0,,ЧУЖОЙ ПОРТ, ЧУЖАЯ ИНФРАСТРУКТУРА И ЧУЖИЕ ГРАЖДАНЕ.
Dialogue: 0,0:05:48.99,0:05:51.82,Caption,,0,0,0,,БЫЛО СЕМЬ БЕЗЭКИПАЖНЫХ КАТЕРОВ. КОРАБЛЬ СТОЯЛ У
Dialogue: 0,0:05:51.82,0:05:54.66,Caption,,0,0,0,,ПРИЧАЛЬНОЙ СТЕНКИ И ЗАПРАВЛЯЛСЯ. ТЕОРЕТИЧЕСКИ
Dialogue: 0,0:05:54.66,0:05:57.79,Caption,,0,0,0,,ОТБИТЬСЯ ОТ ТАКОЙ АТАКИ МОЖНО. ПРАКТИЧЕСКИ В ТАКИХ
Dialogue: 0,0:05:57.79,0:06:01.06,Caption,,0,0,0,,УСЛОВИЯХ ЗАДАЧА ВЫГЛЯДИТ СОВСЕМ ИНАЧЕ. ЕСТЬ И ВТОРОЙ
Dialogue: 0,0:06:01.06,0:06:03.81,Caption,,0,0,0,,ВОПРОС. ЭТИ КАТЕРА НЕ ПРИПЛЫЛИ В ЛИВИЮ ИЗ ОДЕССЫ
Dialogue: 0,0:06:03.81,0:06:07.79,Caption,,0,0,0,,СВОИМ ХОДОМ. ЗНАЧИТ, ИХ ТУДА КАКИМ ТО ОБРАЗОМ ДОСТАВИЛИ.
Dialogue: 0,0:06:07.79,0:06:10.57,Caption,,0,0,0,,ЗНАЧИТ, ПОЯВЛЯЕТСЯ МАРШРУТ. ТРАНСПОРТ.
Dialogue: 0,0:06:10.57,0:06:15.83,Caption,,0,0,0,,ТРАНЗИТ. ЛЮДИ. И УЖЕ СОВСЕМ ДРУГОЙ КРУГ ГОСУДАРСТВ,
Dialogue: 0,0:06:16.07,0:06:17.97,Caption,,0,0,0,,ЧЕРЕЗ ТЕРРИТОРИЮ ИЛИ ИНФРАСТРУКТУРУ
Dialogue: 0,0:06:17.97,0:06:22.04,Caption,,0,0,0,,КОТОРЫХ ВСЁ ЭТО МОГЛО ПРОЙТИ. А ДАЛЬШЕ ВОЗНИКАЕТ НЕПРИЯТНАЯ
Dialogue: 0,0:06:22.04,0:06:25.25,Caption,,0,0,0,,АСИММЕТРИЯ. У РОССИИ ЗА ПРЕДЕЛАМИ СОБСТВЕННОЙ ТЕРРИТОРИИ
Dialogue: 0,0:06:25.25,0:06:29.46,Caption,,0,0,0,,МНОГО ОБЪЕКТОВ, СУДОВ, КОМПАНИЙ И ИНТЕРЕСОВ. У УКРАИНЫ ТАКИХ
Dialogue: 0,0:06:29.46,0:06:32.16,Caption,,0,0,0,,ЦЕЛЕЙ ЗНАЧИТЕЛЬНО МЕНЬШЕ. ПОЭТОМУ ЗЕРКАЛЬНЫЙ
Dialogue: 0,0:06:32.16,0:06:34.70,Caption,,0,0,0,,ОТВЕТ СТАНОВИТСЯ ГОРАЗДО СЛОЖНЕЕ. ОТСЮДА И
Dialogue: 0,0:06:34.70,0:06:37.49,Caption,,0,0,0,,БОЛЕЕ ШИРОКИЙ ВОПРОС. ЕСЛИ ПОДОБНАЯ ПРАКТИКА
Dialogue: 0,0:06:37.49,0:06:41.02,Caption,,0,0,0,,СТАНОВИТСЯ НОРМАЛЬНОЙ, ГДЕ ПРОХОДИТ ГЕОГРАФИЧЕСКАЯ ГРАНИЦА
Dialogue: 0,0:06:41.02,0:06:43.03,Caption,,0,0,0,,КОНФЛИКТА? ПОКА ВСЕ ДЕЛАЮТ ВИД,
Dialogue: 0,0:06:43.26,0:06:47.09,Caption,,0,0,0,,ЧТО ГРАНИЦА СУЩЕСТВУЕТ, ОНА СУЩЕСТВУЕТ. КОГДА УДАРЫ НАЧИНАЮТ
Dialogue: 0,0:06:47.09,0:06:49.19,Caption,,0,0,0,,ПРИЛЕТАТЬ ПО ОБЪЕКТАМ В ТРЕТЬИХ СТРАНАХ,
Dialogue: 0,0:06:49.43,0:06:51.59,Caption,,0,0,0,,ЭТА ГРАНИЦА НАЧИНАЕТ ДВИГАТЬСЯ.
Dialogue: 0,0:06:51.59,0:06:56.03,Caption,,0,0,0,,ГЛАВНОЕ, НЕ ПЕРЕПУТАЙТЕ, КТО ИМЕННО ВСЁ ЭТО ЭСКАЛИРУЕТ. НА ЭТОМ
Dialogue: 0,0:06:56.03,0:06:58.13,Caption,,0,0,0,,ФОНЕ ОСОБЕННО КРАСИВО ВЫГЛЯДИТ ИСТОРИЯ С
Dialogue: 0,0:06:58.13,0:07:00.50,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ ПОМОЩЬЮ УКРАИНСКОЙ ПВО. ПЯТЬ
Dialogue: 0,0:07:00.50,0:07:03.73,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СТРАН ОТКАЗАЛИСЬ ПЕРЕДАТЬ УКРАИНЕ РАКЕТЫ ДЛЯ
Dialogue: 0,0:07:03.73,0:07:05.27,Caption,,0,0,0,,PATRIOT. ДАЖЕ НЕ БУДЕМ СПОРИТЬ,
Dialogue: 0,0:07:05.44,0:07:07.41,Caption,,0,0,0,,СКОЛЬКО ИМЕННО РАКЕТ МОГЛО ОКАЗАТЬСЯ
Dialogue: 0,0:07:07.41,0:07:12.11,Caption,,0,0,0,,НА СТОЛЕ. СОРОК, ПЯТЬДЕСЯТ, ШЕСТЬДЕСЯТ. ЗДЕСЬ САМА ЦИФРА УЖЕ ПОЧТИ
Dialogue: 0,0:07:12.11,0:07:15.10,Caption,,0,0,0,,ВТОРИЧНА. ДАЖЕ НЕСКОЛЬКО ДЕСЯТКОВ ПЕРЕХВАТЧИКОВ
Dialogue: 0,0:07:15.10,0:07:17.02,Caption,,0,0,0,,ПРИ ИНТЕНСИВНЫХ УДАРАХ МОГУТ УЙТИ ЗА
Dialogue: 0,0:07:17.02,0:07:20.59,Caption,,0,0,0,,НЕСКОЛЬКО ОТРАЖЕНИЙ АТАК. И ДАЖЕ ЭТОГО НЕ ДАЮТ. ПРИЧЁМ
Dialogue: 0,0:07:20.59,0:07:23.39,Caption,,0,0,0,,PATRIOT НА ЭТОМ ИСТОРИЯ НЕ ЗАКАНЧИВАЕТСЯ. ЕСТЬ
Dialogue: 0,0:07:23.39,0:07:25.75,Caption,,0,0,0,,ПРОБЛЕМЫ И С ЕВРОПЕЙСКИМИ РАКЕТАМИ ASTER.
Dialogue: 0,0:07:28.02,0:07:29.97,Caption,,0,0,0,,РАНЕЕ УКРАИНСКОЙ СТОРОНЕ РАССКАЗЫВАЛИ
Dialogue: 0,0:07:29.97,0:07:32.40,Caption,,0,0,0,,О ЛИЦЕНЗИИ НА ИХ ПРОИЗВОДСТВО. ТЕПЕРЬ ДМИТРИЙ
Dialogue: 0,0:07:32.40,0:07:34.82,Caption,,0,0,0,,СНЕГИРЁВ ГОВОРИТ БУКВАЛЬНО СЛЕДУЮЩЕЕ ДАЛИ,
Dialogue: 0,0:07:34.94,0:07:39.23,Caption,,0,0,0,,НО НЕТ НИ ЛИЦЕНЗИИ, НИ РАКЕТ. ПРЕКРАСНАЯ СХЕМА. ЛИЦЕНЗИЯ
Dialogue: 0,0:07:39.23,0:07:42.17,Caption,,0,0,0,,ЕСТЬ ГДЕ ТО В РАЗГОВОРАХ. РАКЕТЫ ТОЖЕ ГДЕ ТО В
Dialogue: 0,0:07:42.17,0:07:45.02,Caption,,0,0,0,,РАЗГОВОРАХ. А ПОЛЬЗОВАТЬСЯ СИСТЕМОЙ ПВО НАДО
Dialogue: 0,0:07:45.02,0:07:47.78,Caption,,0,0,0,,НАСТОЯЩИМИ РАКЕТАМИ. ОСОБЕННО НА ФОНЕ ТОГО,
Dialogue: 0,0:07:47.90,0:07:49.94,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ В ОДЕССКОЙ ОБЛАСТИ. ПО
Dialogue: 0,0:07:49.94,0:07:53.30,Caption,,0,0,0,,НЕПОДТВЕРЖДЁННЫМ СООБЩЕНИЯМ, РОССИЙСКИЕ АВИАБОМБЫ ТЕПЕРЬ
Dialogue: 0,0:07:53.30,0:07:55.70,Caption,,0,0,0,,ПРИМЕНЯЮТСЯ УЖЕ НЕ ТОЛЬКО ПО БЕРЕГОВОЙ ЛИНИИ,
Dialogue: 0,0:07:55.94,0:07:58.11,Caption,,0,0,0,,А ЗАЛЕТАЮТ ПРИМЕРНО НА РАССТОЯНИЕ ОТ
Dialogue: 0,0:07:58.11,0:08:00.77,Caption,,0,0,0,,ДЕСЯТИ ДО ДВАДЦАТИ КИЛОМЕТРОВ ВГЛУБЬ ОДЕССКОЙ
Dialogue: 0,0:08:00.77,0:08:04.17,Caption,,0,0,0,,ОБЛАСТИ. И ТАМ СРАЗУ НАЗЫВАЮТ СЛЕДУЮЩУЮ УГРОЗУ. МОСТ
Dialogue: 0,0:08:04.17,0:08:07.22,Caption,,0,0,0,,ЧЕРЕЗ ДНЕСТР В МАЯКАХ. МОСТ В ЗАТОКЕ И РАНЬШЕ
Dialogue: 0,0:08:07.22,0:08:10.40,Caption,,0,0,0,,СТАНОВИЛСЯ ЦЕЛЬЮ УДАРОВ. ТЕПЕРЬ ЕГО НАЗЫВАЮТ ОДНИМ ИЗ
Dialogue: 0,0:08:10.40,0:08:13.20,Caption,,0,0,0,,ОБЪЕКТОВ В КОРОТКОМ СПИСКЕ ПЕРВЫХ ЦЕЛЕЙ. С ЭТИМ
Dialogue: 0,0:08:13.20,0:08:15.95,Caption,,0,0,0,,ЖЕ СВЯЗЫВАЮТ ГРОМКИЕ ЗАЯВЛЕНИЯ О ПЕРЕДАЧЕ КИЕВУ
Dialogue: 0,0:08:15.95,0:08:19.90,Caption,,0,0,0,,РАКЕТ КЛАССА ВОЗДУХ, ВОЗДУХ. ЛОГИКА ПОНЯТНА. ЧЕМ ДАЛЬШЕ ОТ
Dialogue: 0,0:08:19.90,0:08:22.10,Caption,,0,0,0,,ЛИНИИ СОПРИКОСНОВЕНИЯ НАЧИНАЮТ РАБОТАТЬ
Dialogue: 0,0:08:22.10,0:08:24.02,Caption,,0,0,0,,АВИАБОМБЫ, ТЕМ БОЛЬШЕ ОБЪЕКТОВ,
Dialogue: 0,0:08:24.17,0:08:25.94,Caption,,0,0,0,,КОТОРЫЕ РАНЬШЕ СЧИТАЛИСЬ ГЛУБОКИМ
Dialogue: 0,0:08:25.94,0:08:28.66,Caption,,0,0,0,,ТЫЛОМ, ОКАЗЫВАЮТСЯ В ЗОНЕ РИСКА. А ЭТО УЖЕ НЕ
Dialogue: 0,0:08:28.66,0:08:30.76,Caption,,0,0,0,,НОВАЯ СТРАШИЛКА ПРО КАКОЕ ТО ЧУДО
Dialogue: 0,0:08:30.76,0:08:33.64,Caption,,0,0,0,,ОРУЖИЕ. ТРИ ГОДА УКРАИНСКАЯ АРМИЯ НЕСЁТ СЕРЬЁЗНЫЕ
Dialogue: 0,0:08:33.64,0:08:36.71,Caption,,0,0,0,,ПОТЕРИ ОТ ФАБОВ И КАБОВ. НОВЫМ ЗДЕСЬ СТАНОВИТСЯ
Dialogue: 0,0:08:36.71,0:08:42.59,Caption,,0,0,0,,ГЕОГРАФИЯ ИХ ПРИМЕНЕНИЯ. И ВОТ ПОСЛЕ ВСЕГО ЭТОГО ВОЗВРАЩАЕМСЯ В
Dialogue: 0,0:08:42.59,0:08:44.93,Caption,,0,0,0,,ЛИВИЮ. ПОТОМУ ЧТО ТАМ ИСТОРИЯ УЖЕ ПЕРЕСТАЛА
Dialogue: 0,0:08:44.93,0:08:46.69,Caption,,0,0,0,,БЫТЬ ТОЛЬКО РОССИЙСКО УКРАИНСКОЙ.
Dialogue: 0,0:08:47.25,0:08:49.81,Caption,,0,0,0,,ЗАМЕСТИТЕЛЬ ПРЕДСЕДАТЕЛЯ ПРЕЗИДЕНТСКОГО СОВЕТА ЛИВИИ
Dialogue: 0,0:08:49.81,0:08:52.45,Caption,,0,0,0,,МУСА АЛЬ КОНИ НАЗВАЛ АТАКУ НА РОССИЙСКОЕ СУДНО
Dialogue: 0,0:08:52.45,0:08:55.41,Caption,,0,0,0,,В РАЙОНЕ БЕНГАЗИ ФАКТИЧЕСКИ ОБЪЯВЛЕНИЕМ ВОЙНЫ ЛИВИИ.
Dialogue: 0,0:08:55.89,0:08:57.69,Caption,,0,0,0,,ОН ГОВОРИТ О МАТЕРИАЛЬНОМ УЩЕРБЕ И
Dialogue: 0,0:08:57.69,0:09:00.47,Caption,,0,0,0,,РАНЕНЫХ СРЕДИ ГРАЖДАНСКОГО НАСЕЛЕНИЯ. И ЛИВИЯ НЕ
Dialogue: 0,0:09:00.47,0:09:03.54,Caption,,0,0,0,,СОБИРАЕТСЯ ОГРАНИЧИВАТЬСЯ ВОЗМУЩЁННЫМ ЗАЯВЛЕНИЕМ.
Dialogue: 0,0:09:03.54,0:09:06.49,Caption,,0,0,0,,ЗАЯВЛЕНО ОБРАЩЕНИЕ В СОВЕТ БЕЗОПАСНОСТИ ООН И
Dialogue: 0,0:09:06.49,0:09:09.38,Caption,,0,0,0,,ИСК ПРОТИВ УКРАИНЫ В МЕЖДУНАРОДНЫЙ СУД. А СЛЕДОМ
Dialogue: 0,0:09:09.38,0:09:11.95,Caption,,0,0,0,,ВКЛЮЧИЛАСЬ ИТАЛИЯ. АНТОНИО ТАЯНИ НАЗВАЛ
Dialogue: 0,0:09:11.95,0:09:15.12,Caption,,0,0,0,,УКРАИНСКИЙ УДАР НАРУШЕНИЕМ СУВЕРЕНИТЕТА ЛИВИИ И
Dialogue: 0,0:09:15.12,0:09:17.89,Caption,,0,0,0,,ОШИБКОЙ. ПРИЧЁМ ОТДЕЛЬНО ПОДЧЕРКНУЛ ОДНУ ОЧЕНЬ
Dialogue: 0,0:09:17.89,0:09:21.22,Caption,,0,0,0,,НЕУДОБНУЮ ВЕЩЬ. ИТАЛИЯ НЕ ЗНАЛА О НАМЕРЕНИЯХ КИЕВА
Dialogue: 0,0:09:21.22,0:09:24.06,Caption,,0,0,0,,НАНЕСТИ УДАР В ТЕРРИТОРИАЛЬНЫХ ВОДАХ ЛИВИИ. ЭТО УЖЕ
Dialogue: 0,0:09:24.06,0:09:26.34,Caption,,0,0,0,,ИНТЕРЕСНО НЕ С ТОЧКИ ЗРЕНИЯ КРАСИВЫХ СЛОВ О
Dialogue: 0,0:09:26.34,0:09:30.03,Caption,,0,0,0,,ПОДДЕРЖКЕ УКРАИНЫ. ЭТО ВОПРОС ПРОСТОЙ. НАСКОЛЬКО ДАЛЕКО
Dialogue: 0,0:09:30.03,0:09:32.74,Caption,,0,0,0,,КИЕВ ГОТОВ ДЕЙСТВОВАТЬ САМОСТОЯТЕЛЬНО И КТО ПОТОМ
Dialogue: 0,0:09:32.74,0:09:36.69,Caption,,0,0,0,,БУДЕТ РАЗГРЕБАТЬ ПОСЛЕДСТВИЯ? ТАЯНИ ВОЗГЛАВЛЯЕТ FORZA ITALIA,
Dialogue: 0,0:09:36.81,0:09:39.15,Caption,,0,0,0,,ВХОДЯЩУЮ В ПРАВЯЩУЮ КОАЛИЦИЮ. ДРУГАЯ
Dialogue: 0,0:09:39.15,0:09:41.41,Caption,,0,0,0,,ПАРТИЯ ЭТОЙ ЖЕ КОАЛИЦИИ, "ЛИГА",
Dialogue: 0,0:09:41.72,0:09:43.59,Caption,,0,0,0,,ТОЖЕ ОСУДИЛА АТАКУ И НАЗВАЛА ЕЁ
Dialogue: 0,0:09:43.59,0:09:48.81,Caption,,0,0,0,,НЕПРИЕМЛЕМОЙ. ПАРАЛЛЕЛЬНО ЗАПАДНЫЕ СМИ СО ССЫЛКОЙ НА
Dialogue: 0,0:09:48.81,0:09:50.95,Caption,,0,0,0,,ЮРИСТОВ ОБСУЖДАЮТ ПРИЗНАКИ НАРУШЕНИЯ
Dialogue: 0,0:09:50.95,0:09:54.01,Caption,,0,0,0,,МЕЖДУНАРОДНОГО ПРАВА И УЖЕ ДРУГОЙ ВОЗМОЖНЫЙ МАРШРУТ,
Dialogue: 0,0:09:54.25,0:09:56.48,Caption,,0,0,0,,ОБРАЩЕНИЕ В МЕЖДУНАРОДНЫЙ УГОЛОВНЫЙ
Dialogue: 0,0:09:56.48,0:09:59.68,Caption,,0,0,0,,СУД. ТУТ ВАЖНО НЕ ПУТАТЬ ДВЕ ВЕЩИ. ЛИВИЙСКАЯ СТОРОНА
Dialogue: 0,0:09:59.68,0:10:02.30,Caption,,0,0,0,,ГОВОРИТ О МЕЖДУНАРОДНОМ СУДЕ. В ПУБЛИКАЦИЯХ
Dialogue: 0,0:10:02.30,0:10:05.26,Caption,,0,0,0,,ЗАПАДНЫХ СМИ ЗВУЧИТ МЕЖДУНАРОДНЫЙ УГОЛОВНЫЙ СУД. ТО
Dialogue: 0,0:10:05.26,0:10:08.10,Caption,,0,0,0,,ЕСТЬ ПОСЛЕ ОДНОЙ МОРСКОЙ ОПЕРАЦИИ У НАС УЖЕ СОВЕТ
Dialogue: 0,0:10:08.10,0:10:11.62,Caption,,0,0,0,,БЕЗОПАСНОСТИ ООН, ДВА РАЗНЫХ МЕЖДУНАРОДНЫХ СУДЕБНЫХ
Dialogue: 0,0:10:11.62,0:10:14.30,Caption,,0,0,0,,НАПРАВЛЕНИЯ, ПУБЛИЧНОЕ НЕДОВОЛЬСТВО ЛИВИИ И
Dialogue: 0,0:10:14.30,0:10:17.83,Caption,,0,0,0,,ПРЕТЕНЗИИ СО СТОРОНЫ СТРАНЫ НАТО. НЕ САМЫЙ ПЛОХОЙ РЕЗУЛЬТАТ
Dialogue: 0,0:10:17.83,0:10:21.19,Caption,,0,0,0,,ДЛЯ ТЕХ, КТО РАССКАЗЫВАЕТ, КАК АККУРАТНО НАДО УПРАВЛЯТЬ
Dialogue: 0,0:10:21.19,0:10:24.05,Caption,,0,0,0,,ЭСКАЛАЦИЕЙ. И НА ЭТОМ ФОНЕ БРИТАНИЯ РЕШИЛА ЗАНЯТЬСЯ
Dialogue: 0,0:10:24.05,0:10:27.46,Caption,,0,0,0,,СОБСТВЕННЫМИ ДЕЛАМИ. ЛОНДОН ВКЛАДЫВАЕТ ВОСЕМЬ МИЛЛИАРДОВ
Dialogue: 0,0:10:27.46,0:10:30.38,Caption,,0,0,0,,ФУНТОВ В ПОДГОТОВКУ АТОМНОГО ПОДВОДНОГО ФЛОТА.
Dialogue: 0,0:10:30.38,0:10:32.53,Caption,,0,0,0,,КОНТРАКТ С КОМПАНИЕЙ BABCOCK РАССЧИТАН
Dialogue: 0,0:10:32.53,0:10:36.49,Caption,,0,0,0,,ПЕРВОНАЧАЛЬНО НА ПЯТЬ ЛЕТ. ЗАДАЧА ПРОСТАЯ И ОЧЕНЬ ЗЕМНАЯ.
Dialogue: 0,0:10:36.49,0:10:38.89,Caption,,0,0,0,,БЫСТРЕЕ РЕМОНТИРОВАТЬ АТОМНЫЕ ПОДЛОДКИ,
Dialogue: 0,0:10:39.13,0:10:42.89,Caption,,0,0,0,,МЕНЬШЕ ДЕРЖАТЬ ИХ В ДОКАХ, ПОВЫШАТЬ БОЕГОТОВНОСТЬ. РЕЧЬ ИДЁТ О
Dialogue: 0,0:10:42.89,0:10:46.25,Caption,,0,0,0,,БАЗАХ ДЕВОНПОРТ И КЛАЙД, РАКЕТОНОСЦАХ КЛАССА VANGUARD,
Dialogue: 0,0:10:46.64,0:10:48.66,Caption,,0,0,0,,МНОГОЦЕЛЕВЫХ ПОДЛОДКАХ ASTUTE И
Dialogue: 0,0:10:48.66,0:10:51.37,Caption,,0,0,0,,ПОДГОТОВКЕ К ПЕРЕХОДУ НА НОВЫЙ КЛАСС DREADNOUGHT,
Dialogue: 0,0:10:51.60,0:10:54.09,Caption,,0,0,0,,КОТОРЫЙ ДОЛЖЕН СТАТЬ ЧАСТЬЮ БРИТАНСКОГО ЯДЕРНОГО
Dialogue: 0,0:10:54.09,0:10:56.43,Caption,,0,0,0,,АРСЕНАЛА. ПРИЧЁМ ВОСЕМЬ МИЛЛИАРДОВ ЭТО
Dialogue: 0,0:10:56.43,0:11:02.16,Caption,,0,0,0,,ЕЩЁ НЕ ВСЯ СУММА. САМА BABCOCK ОЦЕНИВАЕТ СДЕЛКУ В ВОСЕМЬ
Dialogue: 0,0:11:02.16,0:11:05.09,Caption,,0,0,0,,МИЛЛИАРДОВ СЕМЬСОТ МИЛЛИОНОВ ФУНТОВ. ЕЩЁ СЕМЬСОТ
Dialogue: 0,0:11:05.09,0:11:07.77,Caption,,0,0,0,,МИЛЛИОНОВ ПРИХОДЯТСЯ НА РАМОЧНЫЕ ОБЯЗАТЕЛЬСТВА.
Dialogue: 0,0:11:07.77,0:11:10.51,Caption,,0,0,0,,И КОНТРАКТ В ПЕРСПЕКТИВЕ СПОСОБЕН РАСТЯНУТЬСЯ НЕ НА
Dialogue: 0,0:11:10.51,0:11:13.28,Caption,,0,0,0,,ПЯТЬ, А НА ПЯТНАДЦАТЬ ЛЕТ. ЭТО КРУПНЕЙШАЯ
Dialogue: 0,0:11:13.28,0:11:15.81,Caption,,0,0,0,,СДЕЛКА В ИСТОРИИ КОМПАНИИ. ПРИЧИНА ТАКОЙ
Dialogue: 0,0:11:15.81,0:11:19.11,Caption,,0,0,0,,ЩЕДРОСТИ ТОЖЕ ВПОЛНЕ ПРОЗАИЧЕСКАЯ. НЕКОТОРЫЕ БРИТАНСКИЕ
Dialogue: 0,0:11:19.11,0:11:22.28,Caption,,0,0,0,,АТОМНЫЕ ПОДЛОДКИ ЖДАЛИ ОБСЛУЖИВАНИЯ БОЛЬШЕ ДВУХ ЛЕТ.
Dialogue: 0,0:11:22.28,0:11:26.38,Caption,,0,0,0,,ДВА ГОДА. ЯДЕРНАЯ ДЕРЖАВА, КОТОРАЯ РЕГУЛЯРНО РАССУЖДАЕТ О
Dialogue: 0,0:11:26.38,0:11:28.22,Caption,,0,0,0,,ГОТОВНОСТИ ПРОТИВОСТОЯТЬ РОССИИ,
Dialogue: 0,0:11:28.54,0:11:30.52,Caption,,0,0,0,,ДЕРЖИТ ЧАСТЬ ПОДЛОДОК В ОЧЕРЕДИ НА
Dialogue: 0,0:11:30.52,0:11:34.06,Caption,,0,0,0,,РЕМОНТ ДОЛЬШЕ, ЧЕМ НЕКОТОРЫЕ ЛЮДИ ЖДУТ НОВУЮ МАШИНУ.
Dialogue: 0,0:11:34.06,0:11:36.72,Caption,,0,0,0,,РАКЕТОНОСЦЫ С ЯДЕРНЫМ ОРУЖИЕМ ПРИ ЭТОМ ПОЛУЧАЛИ
Dialogue: 0,0:11:36.72,0:11:40.03,Caption,,0,0,0,,ПРИОРИТЕТ. МНОГОЦЕЛЕВЫЕ СУБМАРИНЫ ЖДАЛИ. УЭС
Dialogue: 0,0:11:40.03,0:11:42.95,Caption,,0,0,0,,СТРИТИНГ ЗАЯВИЛ, ЧТО БРИТАНИЯ БОЛЬШЕ НЕ ДОЛЖНА
Dialogue: 0,0:11:42.95,0:11:46.66,Caption,,0,0,0,,ПОВТОРЯТЬ ПРЕЖНЮЮ ОШИБКУ, КОГДА ИНВЕСТИЦИИ В ЯДЕРНЫЙ ПОТЕНЦИАЛ
Dialogue: 0,0:11:46.66,0:11:49.79,Caption,,0,0,0,,ОТКЛАДЫВАЛИ. РАДИ ЯДЕРНОГО СДЕРЖИВАНИЯ ЛОНДОН ГОТОВ
Dialogue: 0,0:11:49.79,0:11:52.37,Caption,,0,0,0,,ДАЖЕ ЗАБИРАТЬ СРЕДСТВА У ДРУГИХ ВЕДОМСТВ. И
Dialogue: 0,0:11:52.37,0:11:55.90,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ЗАМЕЧАТЕЛЬНАЯ ЦИФРА. ТЫСЯЧА ДНЕЙ.
Dialogue: 0,0:11:56.45,0:11:58.25,Caption,,0,0,0,,ИМЕННО ТАКОЙ ГОРИЗОНТ ПОДГОТОВКИ
Dialogue: 0,0:11:58.25,0:12:01.24,Caption,,0,0,0,,СТРАНЫ К БОЕВЫМ ДЕЙСТВИЯМ ИЛИ СДЕРЖИВАНИЮ ПРОТИВНИКА
Dialogue: 0,0:12:01.24,0:12:04.54,Caption,,0,0,0,,ОБОЗНАЧАЕТСЯ НА ФОНЕ РАСТУЩЕЙ РОССИЙСКОЙ УГРОЗЫ.
Dialogue: 0,0:12:04.54,0:12:06.62,Caption,,0,0,0,,МЕНЬШЕ ТРЁХ ЛЕТ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:12:06.86,0:12:09.74,Caption,,0,0,0,,ЕВРОПА ОБСУЖДАЕТ МИР, ГАРАНТИИ БЕЗОПАСНОСТИ,
Dialogue: 0,0:12:09.90,0:12:11.98,Caption,,0,0,0,,НОВЫЕ ФОРМАТЫ И ПОЕЗДКИ В МОСКВУ.
Dialogue: 0,0:12:14.26,0:12:17.65,Caption,,0,0,0,,С ДРУГОЙ СТОРОНЫ, БРИТАНИЯ СЧИТАЕТ МИЛЛИАРДЫ НА АТОМНЫЙ
Dialogue: 0,0:12:17.65,0:12:20.76,Caption,,0,0,0,,ФЛОТ И ДНИ ДО ГОТОВНОСТИ К БОЛЬШОЙ ВОЙНЕ. УКРАИНЕ
Dialogue: 0,0:12:20.76,0:12:23.86,Caption,,0,0,0,,ОБЕЩАЮТ ГАРАНТИИ ПО ОБРАЗЦУ ПЯТОЙ СТАТЬИ НАТО.
Dialogue: 0,0:12:23.86,0:12:27.09,Caption,,0,0,0,,РУМЫНИЯ ГОВОРИТ, ЧТО РЕАЛЬНОЕ ПРИМЕНЕНИЕ СИЛЫ НАД
Dialogue: 0,0:12:27.09,0:12:30.41,Caption,,0,0,0,,УКРАИНОЙ УЖЕ ОЗНАЧАЕТ УЧАСТИЕ В ВОЙНЕ. ПЯТЬ СТРАН
Dialogue: 0,0:12:30.41,0:12:33.39,Caption,,0,0,0,,НЕ ДАЮТ ДАЖЕ ОГРАНИЧЕННЫЙ ЗАПАС РАКЕТ PATRIOT.
Dialogue: 0,0:12:33.39,0:12:36.82,Caption,,0,0,0,,ИТАЛИЯ ЗАЯВЛЯЕТ, ЧТО КИЕВ НЕ СООБЩИЛ ЕЙ О ПЛАНАХ УДАРА
Dialogue: 0,0:12:36.82,0:12:39.37,Caption,,0,0,0,,У БЕРЕГОВ ЛИВИИ. ЛИВИЯ СОБИРАЕТСЯ ИДТИ
Dialogue: 0,0:12:39.37,0:12:42.10,Caption,,0,0,0,,В ООН И МЕЖДУНАРОДНЫЕ СУДЫ. А АМЕРИКАНЦЫ,
Dialogue: 0,0:12:42.19,0:12:44.26,Caption,,0,0,0,,КАК ВЫЯСНЯЕТСЯ, ПРЕКРАСНО ПОНИМАЮТ,
Dialogue: 0,0:12:44.51,0:12:46.34,Caption,,0,0,0,,ПОЧЕМУ ПЕРЕГОВОРЫ РАЗ ЗА РАЗОМ
Dialogue: 0,0:12:46.34,0:12:49.11,Caption,,0,0,0,,ВОЗВРАЩАЮТСЯ ПРАКТИЧЕСКИ В ОДНУ И ТУ ЖЕ ТОЧКУ.
Dialogue: 0,0:12:49.11,0:12:52.94,Caption,,0,0,0,,ПОЭТОМУ ВОПРОС УЖЕ НЕ В ТОМ, ПОНИМАЮТ ЛИ ОНИ ПРОИСХОДЯЩЕЕ.
Dialogue: 0,0:12:52.94,0:12:56.21,Caption,,0,0,0,,ПОНИМАЮТ. ВОПРОС ПРОЩЕ. ЧТО ОНИ СОБИРАЮТСЯ С ЭТИМ
Dialogue: 0,0:12:56.21,0:12:58.97,Caption,,0,0,0,,ДЕЛАТЬ? ПОТОМУ ЧТО ГАРАНТИРОВАТЬ БЕЗОПАСНОСТЬ
Dialogue: 0,0:12:58.97,0:13:01.70,Caption,,0,0,0,,УКРАИНЫ НА БУМАГЕ МОЖНО ОЧЕНЬ ШИРОКО. ГОРАЗДО
Dialogue: 0,0:13:01.70,0:13:05.12,Caption,,0,0,0,,СЛОЖНЕЕ ОТВЕТИТЬ, РАСПРОСТРАНЯЮТСЯ ЛИ ЭТИ ГАРАНТИИ ЕЩЁ И
Dialogue: 0,0:13:05.12,0:13:08.78,Caption,,0,0,0,,НА ПОСЛЕДСТВИЯ РЕШЕНИЙ, ПОСЛЕ КОТОРЫХ ПРЕТЕНЗИИ КИЕВУ НАЧИНАЮТ
Dialogue: 0,0:13:08.78,0:13:11.94,Caption,,0,0,0,,ПРЕДЪЯВЛЯТЬ УЖЕ ТРЕТЬИ СТРАНЫ. И ВОТ ЭТОТ ПУНКТ В
Dialogue: 0,0:13:11.94,0:13:14.01,Caption,,0,0,0,,БУДУЩИХ ГАРАНТИЯХ НАДО ЧИТАТЬ ОСОБЕННО
Dialogue: 0,0:13:14.01,0:13:14.66,Caption,,0,0,0,,ВНИМАТЕЛЬНО.
