Dialogue: 0,0:00:00.12,0:00:02.27,Caption,,0,0,0,,ИНОГДА ТАЙНУ ГУБИТ НЕ РАССЛЕДОВАТЕЛЬ И
Dialogue: 0,0:00:02.27,0:00:06.30,Caption,,0,0,0,,НЕ УТЕЧКА, А ЧЕЛОВЕК, КОТОРЫЙ РЕШИЛ ЛИЧНО ВЫЙТИ К МИКРОФОНУ
Dialogue: 0,0:00:06.30,0:00:09.29,Caption,,0,0,0,,И ДОБАВИТЬ ПОДРОБНОСТЕЙ. ИМЕННО ЭТО ПРОИЗОШЛО С
Dialogue: 0,0:00:09.29,0:00:12.20,Caption,,0,0,0,,ЗЕЛЕНСКИМ ПОСЛЕ АТАКИ НА РОССИЙСКИЕ КОРАБЛИ В ЛИВИИ.
Dialogue: 0,0:00:12.76,0:00:15.16,Caption,,0,0,0,,СНАЧАЛА ОН ВЫСТАВИЛ ПАРТНЁРОВ СОУЧАСТНИКАМИ,
Dialogue: 0,0:00:15.54,0:00:18.22,Caption,,0,0,0,,ЗАТЕМ ПОЛУЧИЛ ЖЁСТКИЙ ОТВЕТ ИЗ РИМА И
Dialogue: 0,0:00:18.22,0:00:21.70,Caption,,0,0,0,,ТУТ ЖЕ ПЕРЕОБУЛСЯ, БУДТО ПРЕЖНЕЕ ЗАЯВЛЕНИЕ ПРОИЗНЁС ЕГО
Dialogue: 0,0:00:21.70,0:00:24.01,Caption,,0,0,0,,ДАЛЬНИЙ РОДСТВЕННИК. ЕСЛИ ВАМ НРАВЯТСЯ
Dialogue: 0,0:00:24.01,0:00:26.51,Caption,,0,0,0,,ИСТОРИИ, ГДЕ ОДНО НЕОСТОРОЖНОЕ ПРИЗНАНИЕ
Dialogue: 0,0:00:26.51,0:00:28.52,Caption,,0,0,0,,РАСКРЫВАЕТ БОЛЬШЕ ОФИЦИАЛЬНЫХ ОТЧЁТОВ,
Dialogue: 0,0:00:28.84,0:00:31.12,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ПЕРВАЯ ВЕРСИЯ
Dialogue: 0,0:00:31.12,0:00:33.88,Caption,,0,0,0,,ЗЕЛЕНСКОГО ЗВУЧАЛА УВЕРЕННО. УКРАИНА,
Dialogue: 0,0:00:34.01,0:00:36.76,Caption,,0,0,0,,МОЛ, НИКОГДА НЕ ПРОВОДИТ ТАКИЕ ОПЕРАЦИИ БЕЗ
Dialogue: 0,0:00:36.76,0:00:38.69,Caption,,0,0,0,,ПРЕДВАРИТЕЛЬНОГО СОГЛАСОВАНИЯ С
Dialogue: 0,0:00:38.69,0:00:41.82,Caption,,0,0,0,,ПАРТНЁРАМИ. НЕ ИНОГДА СООБЩАЕТ И НЕ СОВЕТУЕТСЯ ПРИ
Dialogue: 0,0:00:41.82,0:00:44.76,Caption,,0,0,0,,ВОЗМОЖНОСТИ, А ИМЕННО НИКОГДА НЕ ДЕЙСТВУЕТ
Dialogue: 0,0:00:44.76,0:00:48.35,Caption,,0,0,0,,САМОСТОЯТЕЛЬНО. НО ТУТ В РАЗГОВОР ВОШЁЛ ГЛАВА ИТАЛЬЯНСКОГО
Dialogue: 0,0:00:48.35,0:00:53.03,Caption,,0,0,0,,МИД АНТОНИО ТАЯНИ И СООБЩИЛ, ЧТО ИТАЛИЯ НИЧЕГО ОБ АТАКЕ НЕ ЗНАЛА.
Dialogue: 0,0:00:53.03,0:00:56.41,Caption,,0,0,0,,РИМ НЕ ПРЕДУПРЕЖДАЛИ, ДЕЙСТВИЯ УКРАИНСКОЙ СТОРОНЫ В ЛИВИИ С
Dialogue: 0,0:00:56.41,0:00:59.56,Caption,,0,0,0,,ИТАЛЬЯНЦАМИ НЕ ОБСУЖДАЛИСЬ. ПОСЛЕ БЕСЕДЫ С ДЖОРДЖЕЙ
Dialogue: 0,0:00:59.56,0:01:02.17,Caption,,0,0,0,,МЕЛОНИ УКРАИНСКИЙ ПРЕЗИДЕНТ СМЕНИЛ ПЛАСТИНКУ.
Dialogue: 0,0:01:02.17,0:01:04.52,Caption,,0,0,0,,ТЕПЕРЬ ВЫЯСНИЛОСЬ, ЧТО ОПЕРАЦИЮ ПРОВЕЛИ БЕЗ
Dialogue: 0,0:01:04.52,0:01:08.17,Caption,,0,0,0,,ПРЕДВАРИТЕЛЬНОЙ КООРДИНАЦИИ С ЕВРОПЕЙЦАМИ. ЗЕЛЕНСКИЙ ПООБЕЩАЛ
Dialogue: 0,0:01:08.17,0:01:11.31,Caption,,0,0,0,,НАЛАДИТЬ ОБМЕН ИНФОРМАЦИЕЙ МЕЖДУ СООТВЕТСТВУЮЩИМИ
Dialogue: 0,0:01:11.31,0:01:13.48,Caption,,0,0,0,,ОРГАНАМИ И ПОДДЕРЖИВАТЬ ПРЯМУЮ СВЯЗЬ.
Dialogue: 0,0:01:15.77,0:01:17.97,Caption,,0,0,0,,ТО ЕСТЬ СНАЧАЛА ВСЁ ЯКОБЫ ОБСУДИЛИ.
Dialogue: 0,0:01:17.97,0:01:21.51,Caption,,0,0,0,,ПОТОМ ИТАЛИЯ ЗАЯВИЛА, ЧТО ОБСУЖДЕНИЯ НЕ БЫЛО. ЗАТЕМ
Dialogue: 0,0:01:21.51,0:01:25.03,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПООБЕЩАЛ ВПРЕДЬ ОБСУЖДАТЬ ЛУЧШЕ. ТОЛЬКО ПРЕДМЕТ
Dialogue: 0,0:01:25.03,0:01:26.89,Caption,,0,0,0,,ССОРЫ ЗДЕСЬ НЕ ГРЯЗНАЯ ПОСУДА,
Dialogue: 0,0:01:27.06,0:01:29.09,Caption,,0,0,0,,А УДАР НА ДРУГОМ БЕРЕГУ СРЕДИЗЕМНОГО
Dialogue: 0,0:01:29.09,0:01:32.14,Caption,,0,0,0,,МОРЯ. BLOOMBERG ОПИСЫВАЕТ РАЗГОВОР МЕЛОНИ С
Dialogue: 0,0:01:32.14,0:01:34.79,Caption,,0,0,0,,ЗЕЛЕНСКИМ КАК НАПРЯЖЁННЫЙ. ИТАЛЬЯНСКОГО ПРЕМЬЕРА
Dialogue: 0,0:01:34.79,0:01:38.36,Caption,,0,0,0,,ВЫВЕЛО ИЗ СЕБЯ ТО, ЧТО ЕЁ НЕ ПРЕДУПРЕДИЛИ. ДЛЯ НЕЁ ЭТА
Dialogue: 0,0:01:38.36,0:01:40.81,Caption,,0,0,0,,ИСТОРИЯ ПРЕВРАЩАЕТСЯ ВО ВНУТРЕННЮЮ ПРОБЛЕМУ,
Dialogue: 0,0:01:40.94,0:01:43.18,Caption,,0,0,0,,А ПРЕЖНЯЯ ТЕПЛОТА МЕЖДУ РИМОМ И КИЕВОМ
Dialogue: 0,0:01:43.18,0:01:47.54,Caption,,0,0,0,,БЫСТРО УХОДИТ. НО СПОР О ТОМ, КТО КОМУ ПОЗВОНИЛ И КТО ЗАБЫЛ
Dialogue: 0,0:01:47.54,0:01:49.29,Caption,,0,0,0,,ПОСТАВИТЬ ИТАЛИЮ В ИЗВЕСТНОСТЬ,
Dialogue: 0,0:01:49.52,0:01:51.54,Caption,,0,0,0,,ЛИШЬ ВЕРХНИЙ СЛОЙ. ПОД НИМ ЛЕЖИТ
Dialogue: 0,0:01:51.54,0:01:55.11,Caption,,0,0,0,,ВОПРОС ТЯЖЕЛЕЕ. КАК СЕМЬ УКРАИНСКИХ МОРСКИХ
Dialogue: 0,0:01:55.11,0:01:57.93,Caption,,0,0,0,,БЕСПИЛОТНИКОВ ВООБЩЕ ДОБРАЛИСЬ ДО РАЙОНА БЕНГАЗИ?
Dialogue: 0,0:01:58.32,0:02:00.35,Caption,,0,0,0,,ЗЕЛЕНСКИЙ НАЗВАЛ КОЛИЧЕСТВО АППАРАТОВ
Dialogue: 0,0:02:00.35,0:02:02.01,Caption,,0,0,0,,И ИХ УКРАИНСКОЕ ПРОИСХОЖДЕНИЕ,
Dialogue: 0,0:02:02.24,0:02:04.48,Caption,,0,0,0,,ОДНАКО ПРОМОЛЧАЛ О ТОЧКЕ СТАРТА.
Dialogue: 0,0:02:04.48,0:02:08.03,Caption,,0,0,0,,ОБСУЖДАЛИСЬ ДВА ВОЗМОЖНЫХ МАРШРУТА. ОДИН СВЯЗЫВАЛИ С
Dialogue: 0,0:02:08.03,0:02:10.73,Caption,,0,0,0,,АЛБАНИЕЙ, ДРУГОЙ С БАЗОЙ НА ЗАПАДЕ ЛИВИИ.
Dialogue: 0,0:02:11.29,0:02:15.29,Caption,,0,0,0,,ЕСЛИ ДРОНЫ ВЫШЛИ ИЗ ОДЕССЫ, ИМ ПРИШЛОСЬ БЫ ПЕРЕСЕЧЬ ЧЁРНОЕ МОРЕ,
Dialogue: 0,0:02:15.53,0:02:18.57,Caption,,0,0,0,,ПРОЙТИ БОСФОР, МРАМОРНОЕ МОРЕ И ДАРДАНЕЛЛЫ,
Dialogue: 0,0:02:18.81,0:02:21.11,Caption,,0,0,0,,ВЫЙТИ В ЭГЕЙСКОЕ МОРЕ И ТОЛЬКО ПОТОМ
Dialogue: 0,0:02:21.11,0:02:24.02,Caption,,0,0,0,,ДВИГАТЬСЯ К ЛИВИЙСКОМУ ПОБЕРЕЖЬЮ. ЭТО НЕ КАТАНИЕ
Dialogue: 0,0:02:24.02,0:02:26.17,Caption,,0,0,0,,ВДОЛЬ ПЛЯЖА, ГДЕ АППАРАТ МОЖНО ПОДОБРАТЬ,
Dialogue: 0,0:02:26.33,0:02:28.72,Caption,,0,0,0,,ЕСЛИ РАЗРЯДИТСЯ БАТАРЕЯ. У ТАКОЙ
Dialogue: 0,0:02:28.72,0:02:30.81,Caption,,0,0,0,,ОПЕРАЦИИ ЕСТЬ МАТЕРИАЛЬНАЯ ИЗНАНКА.
Dialogue: 0,0:02:33.09,0:02:35.49,Caption,,0,0,0,,ДРОНЫ НАДО ПРОИЗВЕСТИ, ПОДГОТОВИТЬ,
Dialogue: 0,0:02:35.59,0:02:40.00,Caption,,0,0,0,,ПЕРЕВЕЗТИ, СПРЯТАТЬ, ОБСЛУЖИТЬ И СПУСТИТЬ НА ВОДУ. НУЖНЫ
Dialogue: 0,0:02:40.00,0:02:43.32,Caption,,0,0,0,,ЛЮДИ, ТРАНСПОРТ, ЗАКРЫТАЯ ПЛОЩАДКА И ДОСТУП К
Dialogue: 0,0:02:43.32,0:02:46.75,Caption,,0,0,0,,ПОБЕРЕЖЬЮ. МОРСКОЙ БЕСПИЛОТНИК НЕ ВОЗНИКАЕТ ВОЗЛЕ БЕНГАЗИ
Dialogue: 0,0:02:46.75,0:02:49.10,Caption,,0,0,0,,ПО ЩЕЛЧКУ ПАЛЬЦЕВ. ИТАЛЬЯНСКОЕ ВОЗМУЩЕНИЕ
Dialogue: 0,0:02:49.10,0:02:52.45,Caption,,0,0,0,,ОТВЕЧАЕТ ЛИШЬ НА ЧАСТЬ ВОПРОСОВ. РИМ МОГ НЕ ЗНАТЬ,
Dialogue: 0,0:02:52.61,0:02:54.85,Caption,,0,0,0,,КАКОЙ КОРАБЛЬ ВЫБРАЛИ ЦЕЛЬЮ И КОГДА
Dialogue: 0,0:02:54.85,0:02:57.99,Caption,,0,0,0,,АППАРАТЫ ПОЙДУТ НА СБЛИЖЕНИЕ. НО НЕЗНАНИЕ ВРЕМЕНИ
Dialogue: 0,0:02:57.99,0:03:00.87,Caption,,0,0,0,,УДАРА НЕ ОБЪЯСНЯЕТ ПОЯВЛЕНИЕ УКРАИНСКОЙ ТЕХНИКИ В
Dialogue: 0,0:03:00.87,0:03:03.79,Caption,,0,0,0,,НЕСКОЛЬКИХ ТЫСЯЧАХ КИЛОМЕТРОВ ОТ РОДНОГО БЕРЕГА. НЕ
Dialogue: 0,0:03:03.79,0:03:06.76,Caption,,0,0,0,,ДАВАТЬ СОГЛАСИЕ НА АТАКУ И НЕ ИМЕТЬ ОТНОШЕНИЯ КО ВСЕЙ
Dialogue: 0,0:03:06.76,0:03:10.13,Caption,,0,0,0,,ПОДГОТОВИТЕЛЬНОЙ ЦЕПОЧКЕ НЕ ОДНО И ТО ЖЕ. КНОПКУ МОЖНО
Dialogue: 0,0:03:10.13,0:03:12.51,Caption,,0,0,0,,НАЖАТЬ БЕЗ РАЗРЕШЕНИЯ СОЮЗНИКА. НО
Dialogue: 0,0:03:12.51,0:03:14.93,Caption,,0,0,0,,СНАЧАЛА КТО ТО ДОЛЖЕН ДОСТАВИТЬ УСТРОЙСТВО,
Dialogue: 0,0:03:15.17,0:03:18.45,Caption,,0,0,0,,ОБЕСПЕЧИТЬ СТОЯНКУ, НАЙТИ ПОРТ ИЛИ УЧАСТОК БЕРЕГА,
Dialogue: 0,0:03:18.67,0:03:20.94,Caption,,0,0,0,,ПРОВЕСТИ АППАРАТЫ К ВОДЕ И СОХРАНИТЬ
Dialogue: 0,0:03:20.94,0:03:23.55,Caption,,0,0,0,,ВСЁ В ТАЙНЕ. БЕЗ ЭТИХ ЗВЕНЬЕВ НАЖИМАТЬ БУДЕТ
Dialogue: 0,0:03:23.55,0:03:27.65,Caption,,0,0,0,,НЕЧЕГО. ПОЭТОМУ ФРАЗА ТАЯНИ О НЕОСВЕДОМЛЁННОСТИ ЗАКРЫВАЕТ
Dialogue: 0,0:03:27.65,0:03:30.21,Caption,,0,0,0,,СПОР ВОКРУГ ПРЕДВАРИТЕЛЬНОГО УВЕДОМЛЕНИЯ ИТАЛИИ.
Dialogue: 0,0:03:30.69,0:03:32.85,Caption,,0,0,0,,ЛОГИСТИЧЕСКАЯ ЗАГАДКА ОСТАЁТСЯ НА
Dialogue: 0,0:03:32.85,0:03:36.15,Caption,,0,0,0,,СТОЛЕ И ЗАНИМАЕТ ПОЧТИ ВЕСЬ СТОЛ. АЛБАНИЯ ОКАЗАЛАСЬ
Dialogue: 0,0:03:36.15,0:03:38.71,Caption,,0,0,0,,СРЕДИ ВЕРСИЙ, ПОТОМУ ЧТО ГЕОГРАФИЯ ТРЕБУЕТ
Dialogue: 0,0:03:38.71,0:03:42.39,Caption,,0,0,0,,ПРОМЕЖУТОЧНОЙ ПЛОЩАДКИ. В ТИРАНЕ ЭТУ ВОЗМОЖНОСТЬ ОТВЕРГЛИ.
Dialogue: 0,0:03:42.39,0:03:45.07,Caption,,0,0,0,,ПОСТАВЛЯТЬ КИЕВУ ВООРУЖЕНИЕ В РАМКАХ ОБЪЯВЛЕННОЙ
Dialogue: 0,0:03:45.07,0:03:50.44,Caption,,0,0,0,,ПОДДЕРЖКИ ПРИВЫЧНО. УВИДЕТЬ НАЗВАНИЕ СВОЕЙ СТРАНЫ РЯДОМ С
Dialogue: 0,0:03:50.44,0:03:52.35,Caption,,0,0,0,,АТАКОЙ В ЛИВИИ СОВСЕМ ДРУГОЙ ВИД
Dialogue: 0,0:03:52.35,0:03:55.95,Caption,,0,0,0,,ГОСТЕПРИИМСТВА. ЗДЕСЬ ПРОЯВЛЯЕТСЯ ВАЖНЫЙ РАЗВОРОТ. ВОЕННЫЕ
Dialogue: 0,0:03:55.95,0:03:58.24,Caption,,0,0,0,,ГРУЗЫ МОГУТ ДВИГАТЬСЯ НЕ ТОЛЬКО К УКРАИНЕ,
Dialogue: 0,0:03:58.40,0:04:02.00,Caption,,0,0,0,,НО И ОТ НЕЁ. ЗНАЧИТ, СПОРИТЬ НАДО НЕ ТОЛЬКО О ТОМ,
Dialogue: 0,0:04:02.16,0:04:04.64,Caption,,0,0,0,,КТО ОДОБРИЛ КОНЕЧНУЮ ЦЕЛЬ. ИНТЕРЕСНЕЕ,
Dialogue: 0,0:04:04.93,0:04:08.00,Caption,,0,0,0,,КТО ПРЕДОСТАВИЛ ДОРОГУ, ТРАНСПОРТ И МЕСТО,
Dialogue: 0,0:04:08.16,0:04:10.43,Caption,,0,0,0,,ОТКУДА ОНА СТАЛА ДОСТИЖИМОЙ. КАРТИНА
Dialogue: 0,0:04:10.43,0:04:13.88,Caption,,0,0,0,,НЕПРИЯТНАЯ. КИЕВ РАЗДВИГАЕТ КАРТУ СВОИХ ОПЕРАЦИЙ.
Dialogue: 0,0:04:13.88,0:04:17.20,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОТХОДЯТ ОТ КРАЯ КАДРА. ЛОНДОН
Dialogue: 0,0:04:17.20,0:04:20.64,Caption,,0,0,0,,СОХРАНЯЕТ ТИШИНУ, КОТОРАЯ ЗВУЧИТ ГРОМЧЕ ПРИВЫЧНЫХ
Dialogue: 0,0:04:20.64,0:04:23.27,Caption,,0,0,0,,ЗАЯВЛЕНИЙ. ПОКА УЧАСТНИКИ ИЗОБРАЖАЮТ СЛУЧАЙНЫХ
Dialogue: 0,0:04:23.27,0:04:25.68,Caption,,0,0,0,,ПРОХОЖИХ, ВОПРОСАМИ ИНТЕРЕСУЮТСЯ ТЕ,
Dialogue: 0,0:04:25.84,0:04:27.60,Caption,,0,0,0,,КОГО ОПЕРАЦИЯ ЗАДЕЛА НАПРЯМУЮ.
Dialogue: 0,0:04:28.40,0:04:30.30,Caption,,0,0,0,,ЛИВИЙСКАЯ НАЦИОНАЛЬНАЯ АРМИЯ УЖЕ
Dialogue: 0,0:04:30.30,0:04:33.49,Caption,,0,0,0,,ПООБЕЩАЛА ОТВЕТИТЬ НА АТАКУ В БЕНГАЗИ. ПОГИБЛИ ДВОЕ ЕЁ
Dialogue: 0,0:04:33.49,0:04:36.08,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. ГЕНШТАБ ЛНА ЗАЯВИЛ,
Dialogue: 0,0:04:36.33,0:04:38.29,Caption,,0,0,0,,ЧТО ВЫБЕРЕТ ДЛЯ ОТВЕТА ПОДХОДЯЩЕЕ
Dialogue: 0,0:04:38.29,0:04:41.64,Caption,,0,0,0,,ВРЕМЯ, МЕСТО И СРЕДСТВА. АДРЕСАТА НЕ НАЗВАЛИ.
Dialogue: 0,0:04:41.64,0:04:44.08,Caption,,0,0,0,,ОТВЕТ МОЖЕТ БЫТЬ НАПРАВЛЕН ПРОТИВ УКРАИНЫ,
Dialogue: 0,0:04:44.31,0:04:46.22,Caption,,0,0,0,,А МОЖЕТ ЗАТРОНУТЬ ВЛАСТИ ЗАПАДНОЙ
Dialogue: 0,0:04:46.22,0:04:49.17,Caption,,0,0,0,,ЛИВИИ, КОТОРЫХ ПОДОЗРЕВАЮТ В ПОМОЩИ КИЕВУ. ТЕ
Dialogue: 0,0:04:49.17,0:04:52.05,Caption,,0,0,0,,ЗАЯВИЛИ, ЧТО НЕ УЧАСТВОВАЛИ В ОПЕРАЦИИ И НЕ
Dialogue: 0,0:04:52.05,0:04:54.78,Caption,,0,0,0,,СОТРУДНИЧАЛИ С УКРАИНСКОЙ СТОРОНОЙ ПРИ АТАКЕ. В
Dialogue: 0,0:04:54.78,0:04:57.44,Caption,,0,0,0,,РЕЗУЛЬТАТЕ ЗЕЛЕНСКИЙ ВТЯНУЛ В РАЗГОВОР ПАРТНЁРОВ,
Dialogue: 0,0:04:57.72,0:05:00.88,Caption,,0,0,0,,ИТАЛИЯ ОТОДВИНУЛА СТУЛ, АЛБАНИЯ ЗАКРЫЛА ДВЕРЬ,
Dialogue: 0,0:05:01.04,0:05:05.04,Caption,,0,0,0,,ЗАПАДНАЯ ЛИВИЯ ПОГАСИЛА СВЕТ, А ЛНА ПООБЕЩАЛА ВЕРНУТЬСЯ.
Dialogue: 0,0:05:07.32,0:05:09.72,Caption,,0,0,0,,ПРЕКРАСНАЯ КОМПАНИЯ, ГДЕ КАЖДЫЙ УВЕРЯЕТ,
Dialogue: 0,0:05:09.88,0:05:12.09,Caption,,0,0,0,,ЧТО ПРИШЁЛ НА ДРУГОЙ ПРАЗДНИК. ТАКОЙ
Dialogue: 0,0:05:12.09,0:05:15.55,Caption,,0,0,0,,ПОРЯДОК ДЕРЖИТСЯ, ПОКА НИКТО НЕ ПРОИЗНОСИТ ЛИШНЕГО. ВСЕ
Dialogue: 0,0:05:15.55,0:05:19.50,Caption,,0,0,0,,ДОГАДЫВАЮТСЯ О МЕХАНИЗМЕ, НО УЧАСТИЕ КАЖДОЙ СТОРОНЫ ОСТАЁТСЯ В
Dialogue: 0,0:05:19.50,0:05:22.60,Caption,,0,0,0,,ТЕНИ. ВОЗМОЖНОСТЬ ОТРИЦАТЬ ДЕТАЛИ ПОЗВОЛЯЕТ
Dialogue: 0,0:05:22.60,0:05:25.98,Caption,,0,0,0,,УЧАСТНИКАМ СОХРАНЯТЬ ЛИЦО. ЗЕЛЕНСКИЙ НЕ РАСКРЫЛ
Dialogue: 0,0:05:25.98,0:05:29.07,Caption,,0,0,0,,ТАЙНУ, КОТОРОЙ НИКТО НЕ ЗНАЛ. ОН СДЕЛАЛ ХУЖЕ
Dialogue: 0,0:05:29.07,0:05:32.51,Caption,,0,0,0,,ВСЛУХ ОБОЗНАЧИЛ ТО, ЧТО ВСЕ ПРЕДПОЧИТАЛИ ОСТАВЛЯТЬ БЕЗ
Dialogue: 0,0:05:32.51,0:05:35.52,Caption,,0,0,0,,ПОДПИСИ. НИКТО НЕ ПРЕДЪЯВИЛ НАКЛАДНУЮ НА ПЕРЕВОЗКУ И
Dialogue: 0,0:05:35.52,0:05:38.75,Caption,,0,0,0,,РАСПОРЯЖЕНИЕ О ПРЕДОСТАВЛЕНИИ БАЗЫ. НИ ОДНА СТОЛИЦА
Dialogue: 0,0:05:38.75,0:05:42.89,Caption,,0,0,0,,НЕ ВЗЯЛА НА СЕБЯ МАРШРУТ, ХРАНЕНИЕ И ЗАПУСК. ПОЭТОМУ КАЖДЫЙ МОГ
Dialogue: 0,0:05:42.89,0:05:45.48,Caption,,0,0,0,,ГОВОРИТЬ, ЧТО ЕГО ЛЮДЕЙ В ОПЕРАЦИИ НЕ БЫЛО.
Dialogue: 0,0:05:46.20,0:05:48.57,Caption,,0,0,0,,И ТУТ УКРАИНСКИЙ ПРЕЗИДЕНТ ОБЪЯВЛЯЕТ О
Dialogue: 0,0:05:48.57,0:05:51.89,Caption,,0,0,0,,СОГЛАСОВАНИИ С ПАРТНЁРАМИ. ПОСЛЕ РЕАКЦИИ МЕЛОНИ ОН
Dialogue: 0,0:05:51.89,0:05:54.11,Caption,,0,0,0,,ПРИЗНАЁТ ОТСУТСТВИЕ ПРЕДВАРИТЕЛЬНОЙ
Dialogue: 0,0:05:54.11,0:05:57.72,Caption,,0,0,0,,КООРДИНАЦИИ. ОДНОЙ ФРАЗОЙ РАЗДАЛ СОЮЗНИКАМ НЕУДОБНЫЕ РОЛИ,
Dialogue: 0,0:05:57.96,0:05:59.77,Caption,,0,0,0,,СЛЕДУЮЩЕЙ ПОПЫТАЛСЯ ЗАБРАТЬ ИХ
Dialogue: 0,0:05:59.77,0:06:02.68,Caption,,0,0,0,,ОБРАТНО. НО ЗРИТЕЛИ ВСЁ УСЛЫШАЛИ. ТАЯНИ ВЫБРАЛ
Dialogue: 0,0:06:02.68,0:06:05.93,Caption,,0,0,0,,ОПРОВЕРЖЕНИЕ. ЗЕЛЕНСКОМУ ПОСЛЕ РАЗГОВОРА С МЕЛОНИ
Dialogue: 0,0:06:05.93,0:06:07.96,Caption,,0,0,0,,ПРИШЛОСЬ СДАВАТЬ НАЗАД И ПРИЗНАВАТЬ,
Dialogue: 0,0:06:08.20,0:06:10.25,Caption,,0,0,0,,ЧТО ЕВРОПЕЙЦЕВ ЗАРАНЕЕ НЕ ПОСТАВИЛИ В
Dialogue: 0,0:06:10.25,0:06:13.24,Caption,,0,0,0,,ИЗВЕСТНОСТЬ. РАДИ ЧЕГО ПОНАДОБИЛСЯ ВЕСЬ ЭТОТ НОМЕР?
Dialogue: 0,0:06:13.56,0:06:15.61,Caption,,0,0,0,,КАКОЙ ВЫИГРЫШ ОПРАВДЫВАЛ ССОРУ С
Dialogue: 0,0:06:15.61,0:06:19.96,Caption,,0,0,0,,ИТАЛИЕЙ? ЧТО ПОТЕРЯЛ БЫ КИЕВ, ЕСЛИ БЫ ПРЕЗИДЕНТ НЕ СТАЛ РАССКАЗЫВАТЬ
Dialogue: 0,0:06:19.96,0:06:25.80,Caption,,0,0,0,,О ВНУТРЕННЕЙ КУХНЕ ОПЕРАЦИИ? ПОВРЕЖДЁННЫЕ КОРАБЛИ НЕ ВЕРНУЛИСЬ БЫ В
Dialogue: 0,0:06:25.80,0:06:28.53,Caption,,0,0,0,,ПРЕЖНЕЕ СОСТОЯНИЕ. ВОЕННЫЙ РЕЗУЛЬТАТ ОСТАЛСЯ
Dialogue: 0,0:06:28.53,0:06:31.64,Caption,,0,0,0,,БЫ ТЕМ ЖЕ. ВОЗМОЖНОСТИ УКРАИНЫ НЕ УМЕНЬШИЛИСЬ БЫ
Dialogue: 0,0:06:31.64,0:06:34.92,Caption,,0,0,0,,ОТ ПРЕЗИДЕНТСКОГО МОЛЧАНИЯ. ЗАТО МЕЛОНИ НЕ ПРИШЛОСЬ БЫ
Dialogue: 0,0:06:34.92,0:06:37.35,Caption,,0,0,0,,ОПРАВДЫВАТЬСЯ ПЕРЕД СВОЕЙ СТРАНОЙ И ВЫЯСНЯТЬ,
Dialogue: 0,0:06:37.60,0:06:39.65,Caption,,0,0,0,,КТО ИСПОЛЬЗОВАЛ СЛОВО "ПАРТНЁРЫ"
Dialogue: 0,0:06:39.65,0:06:42.87,Caption,,0,0,0,,СЛИШКОМ ЩЕДРО. ЭТА ПРИВЫЧКА УЖЕ ПОПАДАЛА В ПОЛЕ
Dialogue: 0,0:06:42.87,0:06:46.08,Caption,,0,0,0,,ЗРЕНИЯ ЛЮДЕЙ, ЗНАКОМЫХ С ЗАКРЫТЫМИ ПЕРЕГОВОРАМИ.
Dialogue: 0,0:06:46.08,0:06:49.74,Caption,,0,0,0,,ДЖАРЕД КУШНЕР ГОВОРИЛ, ЧТО УКРАИНСКАЯ СТОРОНА СЛИШКОМ ОХОТНО
Dialogue: 0,0:06:49.74,0:06:52.45,Caption,,0,0,0,,ВЫНОСИТ ДЕТАЛИ ПЕРЕГОВОРОВ НАРУЖУ И МЕШАЕТ
Dialogue: 0,0:06:52.45,0:06:55.03,Caption,,0,0,0,,ДОГОВОРЁННОСТЯМ. ВАЖЕН НЕ ПРЕДМЕТ СПОРА,
Dialogue: 0,0:06:55.27,0:06:57.46,Caption,,0,0,0,,А ОБРАЩЕНИЕ С КОНФИДЕНЦИАЛЬНОСТЬЮ.
Dialogue: 0,0:06:57.46,0:07:00.76,Caption,,0,0,0,,ЕСЛИ БЕСЕДА ЧЕРЕЗ ЧАС ПОЯВЛЯЕТСЯ ПЕРЕД КАМЕРАМИ В ВЕРСИИ
Dialogue: 0,0:07:00.76,0:07:03.55,Caption,,0,0,0,,ОДНОГО УЧАСТНИКА, ОСТАЛЬНЫЕ В СЛЕДУЮЩИЙ РАЗ БУДУТ
Dialogue: 0,0:07:03.55,0:07:06.79,Caption,,0,0,0,,ОБСУЖДАТЬ ТОЛЬКО ПОГОДУ. ДА И ТУ ОСТОРОЖНО. ПОХОЖИЙ
Dialogue: 0,0:07:06.79,0:07:09.82,Caption,,0,0,0,,СЛЕД ОСТАЛСЯ В ОТНОШЕНИЯХ С ЮЖНОЙ КОРЕЕЙ. ПОСЛЕ
Dialogue: 0,0:07:09.82,0:07:12.59,Caption,,0,0,0,,РАСКРЫТИЯ ДАННЫХ О СЕВЕРОКОРЕЙСКИХ ПЛЕННЫХ СЕУЛ НЕ
Dialogue: 0,0:07:12.59,0:07:15.66,Caption,,0,0,0,,УДОВЛЕТВОРИЛСЯ УКРАИНСКИМИ ИЗВИНЕНИЯМИ И РАССМАТРИВАЛ
Dialogue: 0,0:07:15.66,0:07:18.95,Caption,,0,0,0,,ОТЗЫВ ПОСЛА. ПОЗДНЕЕ ЮЖНОКОРЕЙСКАЯ ОБОРОННАЯ
Dialogue: 0,0:07:18.95,0:07:22.09,Caption,,0,0,0,,КОМПАНИЯ ПРЕКРАТИЛА ВЗАИМОДЕЙСТВИЕ С УКРАИНСКИМИ ВОЕННЫМИ
Dialogue: 0,0:07:22.09,0:07:23.83,Caption,,0,0,0,,НА ФОНЕ УХУДШИВШИХСЯ ОТНОШЕНИЙ.
Dialogue: 0,0:07:24.63,0:07:26.36,Caption,,0,0,0,,ПРАКТИЧЕСКОЙ НАГРАДЫ КИЕВ ОТ ТОЙ
Dialogue: 0,0:07:26.36,0:07:28.86,Caption,,0,0,0,,ПУБЛИЧНОСТИ НЕ ПОЛУЧИЛ. ЗАТО ПАРТНЁРУ ПРИШЛОСЬ
Dialogue: 0,0:07:28.86,0:07:31.25,Caption,,0,0,0,,РАЗБИРАТЬСЯ С ПОСЛЕДСТВИЯМИ. УДИВИТЕЛЬНАЯ
Dialogue: 0,0:07:31.25,0:07:34.31,Caption,,0,0,0,,БУХГАЛТЕРИЯ, ГДЕ ДОХОД ЗАПИСЫВАЮТ В ЗАГОЛОВКИ,
Dialogue: 0,0:07:34.47,0:07:36.31,Caption,,0,0,0,,А РАСХОДЫ ОТПРАВЛЯЮТ СОЮЗНИКАМ.
Dialogue: 0,0:07:38.59,0:07:40.39,Caption,,0,0,0,,ПОДПИШИТЕСЬ СЕЙЧАС ДАЛЬШЕ СТАВКИ
Dialogue: 0,0:07:40.39,0:07:43.80,Caption,,0,0,0,,СТАНОВЯТСЯ ЗАМЕТНО ВЫШЕ. МГНОВЕННАЯ ВЫГОДА ПОНЯТНА.
Dialogue: 0,0:07:43.80,0:07:48.19,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПОЛУЧАЕТ ВНИМАНИЕ, ОБРАЗ РЕШИТЕЛЬНОГО ЛИДЕРА И ПОВОД
Dialogue: 0,0:07:48.19,0:07:51.15,Caption,,0,0,0,,НАПОМНИТЬ О ВОЗМОЖНОСТЯХ УКРАИНЫ. ЧЕРЕЗ НЕСКОЛЬКО
Dialogue: 0,0:07:51.15,0:07:54.79,Caption,,0,0,0,,ЧАСОВ КАМЕРЫ УЕЗЖАЮТ, А ЗАРУБЕЖНЫЕ ПРАВИТЕЛЬСТВА ОСТАЮТСЯ С
Dialogue: 0,0:07:54.79,0:07:58.85,Caption,,0,0,0,,ВОПРОСАМИ ОТ ОППОЗИЦИИ, ВЕДОМСТВ И ГРАЖДАН. СТАРАЯ ФОРМУЛА
Dialogue: 0,0:07:58.85,0:08:01.96,Caption,,0,0,0,,СНОВА РАБОТАЕТ. СНАЧАЛА ЭФФЕКТНАЯ ПОДАЧА,
Dialogue: 0,0:08:02.19,0:08:04.84,Caption,,0,0,0,,ПОТОМ СОДЕРЖАНИЕ, ЕСЛИ ДО НЕГО ДОЙДУТ РУКИ.
Dialogue: 0,0:08:05.39,0:08:07.64,Caption,,0,0,0,,ПИАР ЗАНИМАЕТ ЛУЧШЕЕ КРЕСЛО И ТРЕБУЕТ,
Dialogue: 0,0:08:07.80,0:08:09.88,Caption,,0,0,0,,ЧТОБЫ ПОСЛЕДСТВИЯ ПОСТОЯЛИ В КОРИДОРЕ.
Dialogue: 0,0:08:10.51,0:08:12.36,Caption,,0,0,0,,В ЛИВИИ ЭТА ПРИВЫЧКА ПЕРЕСТАЁТ БЫТЬ
Dialogue: 0,0:08:12.36,0:08:15.04,Caption,,0,0,0,,ПРОСТО РАЗДРАЖАЮЩЕЙ. ТЕПЕРЬ ЕСТЬ ВООРУЖЁННАЯ
Dialogue: 0,0:08:15.04,0:08:17.88,Caption,,0,0,0,,СТОРОНА, КОТОРАЯ ПОТЕРЯЛА ДВОИХ ВОЕННЫХ И
Dialogue: 0,0:08:17.88,0:08:20.95,Caption,,0,0,0,,ЗАЯВИЛА О БУДУЩЕМ ОТВЕТЕ. ЭТО УЖЕ НЕ ИСПОРЧЕННОЕ
Dialogue: 0,0:08:20.95,0:08:24.01,Caption,,0,0,0,,НАСТРОЕНИЕ НА ПЕРЕГОВОРАХ И НЕ ХОЛОДНЫЙ ЗВОНОК МЕЖДУ
Dialogue: 0,0:08:24.01,0:08:26.74,Caption,,0,0,0,,СТОЛИЦАМИ. ПОКА УКРАИНСКИЙ КОНФЛИКТ ОСТАВАЛСЯ В
Dialogue: 0,0:08:26.74,0:08:30.50,Caption,,0,0,0,,ЗНАКОМЫХ ГРАНИЦАХ, ЕГО УЧАСТНИКИ ВЫРАБОТАЛИ РИТУАЛ. ОДНИ
Dialogue: 0,0:08:30.50,0:08:33.16,Caption,,0,0,0,,ДАЮТ ОРУЖИЕ, ДРУГИЕ ОПЛАЧИВАЮТ ПОСТАВКИ,
Dialogue: 0,0:08:33.32,0:08:36.97,Caption,,0,0,0,,ТРЕТЬИ ВСЁ ОТРИЦАЮТ, ЧЕТВЁРТЫЕ ВЫСТУПАЮТ ПЕРЕД ПРЕССОЙ.
Dialogue: 0,0:08:36.97,0:08:39.99,Caption,,0,0,0,,КАЖДЫЙ ЗНАЕТ СВОЮ РЕПЛИКУ И НЕ ЗАГЛЯДЫВАЕТ В ЧУЖОЙ
Dialogue: 0,0:08:39.99,0:08:43.63,Caption,,0,0,0,,СЦЕНАРИЙ. ПОЯВЛЕНИЕ УКРАИНСКИХ МОРСКИХ ДРОНОВ ВОЗЛЕ ЛИВИИ
Dialogue: 0,0:08:43.63,0:08:46.04,Caption,,0,0,0,,ЛОМАЕТ ПРИВЫЧНУЮ СЦЕНУ. ПРОСТРАНСТВО
Dialogue: 0,0:08:46.04,0:08:49.64,Caption,,0,0,0,,КОНФЛИКТА РАСШИРЯЕТСЯ, А С НИМ РАСТЁТ ЧИСЛО ГОСУДАРСТВ,
Dialogue: 0,0:08:49.79,0:08:51.88,Caption,,0,0,0,,КОТОРЫМ МОГУТ ПРИСЛАТЬ СЧЁТ ЗА ЧУЖУЮ
Dialogue: 0,0:08:51.88,0:08:56.59,Caption,,0,0,0,,ИНИЦИАТИВУ. НА ЭТОМ ФОНЕ ВОЗНИКАЕТ ИСТОРИЯ С
Dialogue: 0,0:08:56.59,0:08:59.32,Caption,,0,0,0,,КУВЕЙТОМ. ПОСЛЕ УДАРА БЕСПИЛОТНИКА ТАМ ПОГИБЛИ ДВОЕ
Dialogue: 0,0:08:59.32,0:09:02.83,Caption,,0,0,0,,ИТАЛЬЯНСКИХ СПЕЦИАЛИСТОВ. КУВЕЙТ И ИТАЛИЯ ОБВИНЯЮТ
Dialogue: 0,0:09:02.83,0:09:05.78,Caption,,0,0,0,,ИРАН. ТЕГЕРАН ОТВЕРГАЕТ ОТВЕТСТВЕННОСТЬ И ГОВОРИТ ОБ
Dialogue: 0,0:09:05.78,0:09:08.50,Caption,,0,0,0,,ОПЕРАЦИИ ПОД ЧУЖИМ ФЛАГОМ. ИРАНСКИЕ ИСТОЧНИКИ
Dialogue: 0,0:09:08.50,0:09:10.95,Caption,,0,0,0,,ВЫДВИНУЛИ ВЕРСИЮ ОБ УКРАИНСКОМ УЧАСТИИ,
Dialogue: 0,0:09:11.19,0:09:13.43,Caption,,0,0,0,,РАССЧИТАННОМ НА РАСШИРЕНИЕ ПРОТИВОСТОЯНИЯ В
Dialogue: 0,0:09:13.43,0:09:16.18,Caption,,0,0,0,,ПЕРСИДСКОМ ЗАЛИВЕ И ВТЯГИВАНИЕ ЕВРОПЫ.
Dialogue: 0,0:09:16.18,0:09:19.77,Caption,,0,0,0,,ДОКАЗАТЕЛЬСТВ ОНИ НЕ ПОКАЗАЛИ. ОДНАКО САМО ПОЯВЛЕНИЕ
Dialogue: 0,0:09:19.77,0:09:22.42,Caption,,0,0,0,,ОБВИНЕНИЯ ГОВОРИТ О МАСШТАБЕ ПОДОЗРЕНИЙ.
Dialogue: 0,0:09:22.42,0:09:25.48,Caption,,0,0,0,,УКРАИНСКИЙ СЛЕД ОБСУЖДАЮТ УЖЕ НЕ ТОЛЬКО РЯДОМ С ЧЁРНЫМ
Dialogue: 0,0:09:25.48,0:09:27.65,Caption,,0,0,0,,МОРЕМ И НЕ ТОЛЬКО В СВЯЗИ С РОССИЙСКИМИ
Dialogue: 0,0:09:27.65,0:09:30.29,Caption,,0,0,0,,ОБЪЕКТАМИ. ЕСЛИ ВЕРСИЯ ПО КУВЕЙТУ ПОЛУЧИТ
Dialogue: 0,0:09:30.29,0:09:33.63,Caption,,0,0,0,,ПОДТВЕРЖДЕНИЕ, СПОР ВОКРУГ ЛИВИИ ПОКАЖЕТСЯ ЗЕЛЕНСКОМУ
Dialogue: 0,0:09:33.63,0:09:36.59,Caption,,0,0,0,,РАЗМИНКОЙ. ОБЪЯСНЯТЬ ПРИШЛОСЬ БЫ НЕ ПОВРЕЖДЕНИЕ
Dialogue: 0,0:09:36.59,0:09:40.39,Caption,,0,0,0,,РОССИЙСКИХ КОРАБЛЕЙ, А ГИБЕЛЬ ИТАЛЬЯНЦЕВ ДАЛЕКО ОТ УКРАИНЫ.
Dialogue: 0,0:09:40.39,0:09:43.07,Caption,,0,0,0,,ТОГДА СЛОВА О ГОСУДАРСТВЕННОМ ТЕРРОРИЗМЕ ЗВУЧАЛИ
Dialogue: 0,0:09:43.07,0:09:46.60,Caption,,0,0,0,,БЫ НЕ ИЗ ОДНОЙ МОСКВЫ, А РАЗГОВОР О СОГЛАСОВАНИИ С СОЮЗНИКАМИ
Dialogue: 0,0:09:46.60,0:09:49.48,Caption,,0,0,0,,ПРИОБРЁЛ БЫ ДРУГОЙ ВЕС. ДЛЯ РИМА ОБЕ ИСТОРИИ
Dialogue: 0,0:09:49.48,0:09:52.33,Caption,,0,0,0,,СКЛАДЫВАЮТСЯ В ТЯЖЁЛУЮ КОМБИНАЦИЮ. В ЛИВИИ
Dialogue: 0,0:09:52.33,0:09:56.35,Caption,,0,0,0,,ИТАЛЬЯНСКОЕ РУКОВОДСТВО УЗНАЁТ ОБ АТАКЕ ПОСЛЕ СЛУЧИВШЕГОСЯ. В
Dialogue: 0,0:09:56.35,0:09:59.15,Caption,,0,0,0,,КУВЕЙТЕ ГИБНУТ ГРАЖДАНЕ ИТАЛИИ. ЗАРУБЕЖНАЯ
Dialogue: 0,0:09:59.15,0:10:01.91,Caption,,0,0,0,,АКТИВНОСТЬ, СВЯЗАННАЯ С УКРАИНСКИМ КОНФЛИКТОМ,
Dialogue: 0,0:10:02.14,0:10:06.42,Caption,,0,0,0,,ПЕРЕСТАЁТ БЫТЬ ДАЛЁКОЙ ТЕМОЙ, ОБСУЖДАЕМОЙ ОБЩИМИ СЛОВАМИ О ПОДДЕРЖКЕ
Dialogue: 0,0:10:06.42,0:10:10.65,Caption,,0,0,0,,КИЕВА. ТЕПЕРЬ ОНА ВХОДИТ В ИТАЛЬЯНСКУЮ
Dialogue: 0,0:10:10.65,0:10:12.66,Caption,,0,0,0,,ВНУТРЕННЮЮ ПОЛИТИКУ БЕЗ ПРИГЛАШЕНИЯ,
Dialogue: 0,0:10:12.90,0:10:15.31,Caption,,0,0,0,,САДИТСЯ ЗА СТОЛ И ПРОСИТ ОБЪЯСНЕНИЙ.
Dialogue: 0,0:10:15.31,0:10:17.84,Caption,,0,0,0,,ПОЭТОМУ РАЗДРАЖЕНИЕ МЕЛОНИ НЕЛЬЗЯ СВЕСТИ К
Dialogue: 0,0:10:17.84,0:10:20.95,Caption,,0,0,0,,ОБИДЕ ИЗ ЗА ПРОПУЩЕННОГО ЗВОНКА. СОЮЗНИКА ЛЕГКО
Dialogue: 0,0:10:20.95,0:10:24.07,Caption,,0,0,0,,ПОДДЕРЖИВАТЬ, ПОКА ИЗДЕРЖКИ НАХОДЯТСЯ ЗА МОРЕМ И
Dialogue: 0,0:10:24.07,0:10:26.66,Caption,,0,0,0,,ФИГУРИРУЮТ В ЧУЖИХ СВОДКАХ. ТРУДНЕЕ,
Dialogue: 0,0:10:26.90,0:10:30.58,Caption,,0,0,0,,КОГДА ИЗБИРАТЕЛИ СПРАШИВАЮТ, ПОЧЕМУ ПРАВИТЕЛЬСТВО НИЧЕГО НЕ ЗНАЛО,
Dialogue: 0,0:10:30.81,0:10:32.86,Caption,,0,0,0,,КТО РАСПОРЯЖАЕТСЯ ОПЕРАЦИЯМИ РЯДОМ С
Dialogue: 0,0:10:32.86,0:10:36.06,Caption,,0,0,0,,ИТАЛЬЯНСКИМИ ИНТЕРЕСАМИ И ПОЧЕМУ РИМ УЗНАЁТ ДЕТАЛИ
Dialogue: 0,0:10:36.06,0:10:39.83,Caption,,0,0,0,,ПОСЛЕДНИМ. ЗЕЛЕНСКИЙ ОСЛОЖНИЛ ПОЛОЖЕНИЕ НЕ ТОЛЬКО
Dialogue: 0,0:10:39.83,0:10:43.69,Caption,,0,0,0,,СЕБЕ. ОН ВЫСВЕТИЛ ПРАВИЛО, НА КОТОРОМ ДЕРЖИТСЯ ПОМОЩЬ КИЕВУ.
Dialogue: 0,0:10:43.69,0:10:45.94,Caption,,0,0,0,,ПАРТНЁРЫ ГОТОВЫ ПОСТАВЛЯТЬ ТЕХНИКУ,
Dialogue: 0,0:10:46.02,0:10:49.11,Caption,,0,0,0,,ДЕНЬГИ И СВЕДЕНИЯ, ИНОГДА НЕ ЗАМЕЧАТЬ ОТДЕЛЬНЫХ
Dialogue: 0,0:10:49.11,0:10:50.82,Caption,,0,0,0,,ПОДРОБНОСТЕЙ. НО ПРАВО РЕШАТЬ,
Dialogue: 0,0:10:50.96,0:10:53.38,Caption,,0,0,0,,КАКИЕ ПОДРОБНОСТИ РАСКРЫВАТЬ И КОГДА,
Dialogue: 0,0:10:53.69,0:10:56.66,Caption,,0,0,0,,ОНИ ОСТАВЛЯЮТ ЗА СОБОЙ. КОГДА УКРАИНСКИЙ ПРЕЗИДЕНТ
Dialogue: 0,0:10:56.66,0:10:58.98,Caption,,0,0,0,,НАЧИНАЕТ РАСПОРЯЖАТЬСЯ ЧУЖОЙ ПУБЛИЧНОСТЬЮ,
Dialogue: 0,0:10:59.41,0:11:01.14,Caption,,0,0,0,,ПОМОЩЬ ПРЕВРАЩАЕТСЯ В УСЛУГУ СО
Dialogue: 0,0:11:01.14,0:11:04.36,Caption,,0,0,0,,СТРАННЫМИ УСЛОВИЯМИ. ЛИВИЙСКАЯ АТАКА СТАЛА НЕ ТОЛЬКО
Dialogue: 0,0:11:04.36,0:11:07.33,Caption,,0,0,0,,ВОЕННЫМ ЭПИЗОДОМ. ОНА ПОКАЗАЛА ПРЕДЕЛ ТЕРПЕНИЯ
Dialogue: 0,0:11:07.33,0:11:10.00,Caption,,0,0,0,,ПАРТНЁРОВ, КОТОРЫМ ПРЕДЛАГАЮТ ОДНОВРЕМЕННО
Dialogue: 0,0:11:10.00,0:11:12.99,Caption,,0,0,0,,ПОМОГАТЬ, МОЛЧАТЬ И ПРИНИМАТЬ ПОСЛЕДСТВИЯ ЧУЖИХ
Dialogue: 0,0:11:12.99,0:11:16.37,Caption,,0,0,0,,ПРИЗНАНИЙ. ОПЕРАЦИЮ МОЖНО ЗАКОНЧИТЬ. ПОВРЕЖДЕНИЯ
Dialogue: 0,0:11:16.37,0:11:18.89,Caption,,0,0,0,,ОЦЕНИТЬ. ДИПЛОМАТИЧЕСКИЙ СКАНДАЛ ПРИГЛУШИТЬ
Dialogue: 0,0:11:18.89,0:11:22.04,Caption,,0,0,0,,НЕСКОЛЬКИМИ ЗВОНКАМИ. ДАЖЕ ПОСЛА ПОСЛЕ ССОРЫ МОЖНО
Dialogue: 0,0:11:22.04,0:11:26.71,Caption,,0,0,0,,ВЕРНУТЬ. НО ЕСЛИ ЧЕЛОВЕК ПОСТОЯННО ПУТАЕТ
Dialogue: 0,0:11:26.71,0:11:28.95,Caption,,0,0,0,,СОЮЗНИКОВ С МАССОВКОЙ ДЛЯ СВОЕГО ПИАРА,
Dialogue: 0,0:11:29.25,0:11:31.53,Caption,,0,0,0,,ОДНАЖДЫ МАССОВКА НЕ ВЫЙДЕТ НА СЦЕНУ. И
Dialogue: 0,0:11:31.53,0:11:34.58,Caption,,0,0,0,,ТОГДА ВЫЯСНИТСЯ, ЧТО САМЫМ ДОРОГИМ УКРАИНСКИМ
Dialogue: 0,0:11:34.58,0:11:36.55,Caption,,0,0,0,,БЕСПИЛОТНИКОМ ОКАЗАЛСЯ НЕ ТОТ,
Dialogue: 0,0:11:36.66,0:11:38.95,Caption,,0,0,0,,КОТОРЫЙ ДОПЛЫЛ ДО ЦЕЛИ, А ТОТ,
Dialogue: 0,0:11:39.19,0:11:41.15,Caption,,0,0,0,,О КОТОРОМ ЗЕЛЕНСКИЙ НЕ СУМЕЛ ВОВРЕМЯ
Dialogue: 0,0:11:41.15,0:11:41.75,Caption,,0,0,0,,ПРОМОЛЧАТЬ.
