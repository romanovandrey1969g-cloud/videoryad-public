Dialogue: 0,0:00:00.12,0:00:04.60,Caption,,0,0,0,,ТРАМП ОБРОНИЛ ФРАЗУ, БУДТО ОНА НИЧЕГО НЕ ЗНАЧИТ ПОСЛЕ СОГЛАШЕНИЯ УКРАИНА
Dialogue: 0,0:00:04.68,0:00:07.72,Caption,,0,0,0,,СТАНЕТ "НЕМНОГО ДРУГОЙ ФОРМЫ". А СЛЕДОМ СОСТАВ
Dialogue: 0,0:00:07.80,0:00:10.44,Caption,,0,0,0,,РОССИЙСКОЙ ДЕЛЕГАЦИИ НА ПЕРЕГОВОРАХ СТАЛ ПОХОЖ НЕ НА
Dialogue: 0,0:00:10.44,0:00:12.28,Caption,,0,0,0,,СПИСОК ДЛЯ ПРОТОКОЛЬНОЙ ФОТОГРАФИИ,
Dialogue: 0,0:00:12.60,0:00:15.24,Caption,,0,0,0,,А НА ОПИСЬ ИНСТРУМЕНТОВ ПЕРЕД КАПИТАЛЬНЫМ РЕМОНТОМ.
Dialogue: 0,0:00:15.69,0:00:18.20,Caption,,0,0,0,,К МЕДИНСКОМУ ДОБАВИЛИСЬ ЗАМЕСТИТЕЛИ ГЛАВЫ МИД,
Dialogue: 0,0:00:18.43,0:00:21.24,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ ВОЕННОЙ РАЗВЕДКИ И ГЕНЕРАЛЬНОГО ШТАБА.
Dialogue: 0,0:00:21.55,0:00:24.36,Caption,,0,0,0,,И ОСОБЕННО ЗАМЕТНА ОДНА ФАМИЛИЯ СЕРГЕЙ РЯБКОВ.
Dialogue: 0,0:00:24.84,0:00:28.68,Caption,,0,0,0,,РЯБКОВ НЕ ТОТ ЧЕЛОВЕК, КОТОРОГО БЕРУТ С СОБОЙ ДЛЯ СОЛИДНОСТИ. ОН
Dialogue: 0,0:00:28.76,0:00:30.92,Caption,,0,0,0,,ЗАМЕСТИТЕЛЬ МИНИСТРА ИНОСТРАННЫХ ДЕЛ РОССИИ,
Dialogue: 0,0:00:31.24,0:00:33.64,Caption,,0,0,0,,КУРИРУЕТ ОТНОШЕНИЯ С СОЕДИНЁННЫМИ ШТАТАМИ,
Dialogue: 0,0:00:33.80,0:00:36.04,Caption,,0,0,0,,СТРАТЕГИЧЕСКУЮ СТАБИЛЬНОСТЬ И КОНТРОЛЬ НАД
Dialogue: 0,0:00:36.04,0:00:39.56,Caption,,0,0,0,,ВООРУЖЕНИЯМИ. В ЕГО РАБОЧЕЙ ПАПКЕ АМЕРИКАНЦЫ,
Dialogue: 0,0:00:39.66,0:00:43.80,Caption,,0,0,0,,РАКЕТЫ, ЯДЕРНЫЕ ВОПРОСЫ И ПРАВИЛА БОЛЬШОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:00:44.08,0:00:46.60,Caption,,0,0,0,,МИРНЫЙ УЖИН С КОМПОТОМ ЯВНО НЕ ЕГО ПРОФИЛЬ.
Dialogue: 0,0:00:46.83,0:00:49.24,Caption,,0,0,0,,ИМЕННО РЯБКОВ В КОНЦЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО
Dialogue: 0,0:00:49.32,0:00:52.12,Caption,,0,0,0,,ГОДА ПУБЛИЧНО ПРЕДСТАВЛЯЛ РОССИЙСКИЕ ТРЕБОВАНИЯ К
Dialogue: 0,0:00:52.12,0:00:55.24,Caption,,0,0,0,,ЗАПАДУ ПО ГАРАНТИЯМ БЕЗОПАСНОСТИ. ТОТ ПАКЕТ ПОЛУЧИЛ
Dialogue: 0,0:00:55.24,0:00:59.56,Caption,,0,0,0,,НЕОФИЦИАЛЬНОЕ, НО ОЧЕНЬ ЦЕПКОЕ НАЗВАНИЕ УЛЬТИМАТУМ РЯБКОВА.
Dialogue: 0,0:01:00.12,0:01:03.08,Caption,,0,0,0,,ЗАПАД ТОГДА ОТВЕТИЛ ОТКАЗОМ. ПРОШЛО ПЯТЬ ЛЕТ,
Dialogue: 0,0:01:03.40,0:01:05.72,Caption,,0,0,0,,И ЧЕЛОВЕК, ПРЕДЪЯВЛЯВШИЙ ЭТИ ТРЕБОВАНИЯ,
Dialogue: 0,0:01:05.96,0:01:08.92,Caption,,0,0,0,,ВПЕРВЫЕ ВХОДИТ НЕПОСРЕДСТВЕННО В РОССИЙСКУЮ ГРУППУ
Dialogue: 0,0:01:09.01,0:01:11.96,Caption,,0,0,0,,НА ПЕРЕГОВОРАХ ПО УКРАИНЕ. УДОБНОЕ СОВПАДЕНИЕ.
Dialogue: 0,0:01:14.23,0:01:17.83,Caption,,0,0,0,,НАСТОЛЬКО УДОБНОЕ, ЧТО ЕГО ХОЧЕТСЯ ПОЛОЖИТЬ ПОД СТЕКЛО И НИКОМУ
Dialogue: 0,0:01:17.91,0:01:20.63,Caption,,0,0,0,,НЕ ДАВАТЬ ТРОГАТЬ. ЕСЛИ СТОРОНЫ СОБИРАЛИСЬ СПОРИТЬ
Dialogue: 0,0:01:20.63,0:01:24.31,Caption,,0,0,0,,ТОЛЬКО О ТЕРРИТОРИЯХ, РЯБКОВУ ТАМ ОСТАВАЛОСЬ БЫ ВЫБИРАТЬ КАРАНДАШ ДЛЯ
Dialogue: 0,0:01:24.31,0:01:27.91,Caption,,0,0,0,,КАРТЫ. ЕГО ПОЯВЛЕНИЕ УКАЗЫВАЕТ НА ДРУГОЙ МАСШТАБ. НА
Dialogue: 0,0:01:27.91,0:01:30.47,Caption,,0,0,0,,СТОЛЕ МОГУТ ЛЕЖАТЬ БУДУЩИЙ СТАТУС УКРАИНЫ,
Dialogue: 0,0:01:30.72,0:01:34.15,Caption,,0,0,0,,ОГРАНИЧЕНИЯ НА ВООРУЖЕНИЯ, ПРИСУТСТВИЕ ИНОСТРАННЫХ СИЛ,
Dialogue: 0,0:01:34.39,0:01:37.75,Caption,,0,0,0,,ОТНОШЕНИЯ РОССИИ И НАТО И ВСЯ СИСТЕМА ЕВРОПЕЙСКОЙ
Dialogue: 0,0:01:37.75,0:01:41.19,Caption,,0,0,0,,БЕЗОПАСНОСТИ. УКРАИНСКАЯ СТОРОНА ТОЖЕ РАСШИРЕНА. В
Dialogue: 0,0:01:41.27,0:01:44.07,Caption,,0,0,0,,НЕЙ УМЕРОВ, БУДАНОВ, АРАХАМИЯ,
Dialogue: 0,0:01:44.16,0:01:47.43,Caption,,0,0,0,,КИСЛИЦА И ВОЕННЫЕ. РАНГ ПОДНЯТ С ОБЕИХ СТОРОН
Dialogue: 0,0:01:47.43,0:01:49.99,Caption,,0,0,0,,ДО УРОВНЯ МИНИСТЕРСТВ ИНОСТРАННЫХ ДЕЛ И ШТАБОВ.
Dialogue: 0,0:01:50.45,0:01:54.87,Caption,,0,0,0,,ЗНАЧИТ, РАЗГОВОР УШЁЛ ТУДА, ГДЕ ОДНОЙ КРАСИВОЙ ФРАЗОЙ О МИРЕ УЖЕ НЕ
Dialogue: 0,0:01:54.87,0:01:57.75,Caption,,0,0,0,,ОТДЕЛАЕШЬСЯ. И ВОТ НА ЭТОМ ФОНЕ ТРАМП ОБЪЯСНИЛ,
Dialogue: 0,0:01:57.99,0:02:00.23,Caption,,0,0,0,,ЧТО ПОСЛЕ СОГЛАШЕНИЯ УКРАИНА ОСТАНЕТСЯ,
Dialogue: 0,0:02:00.47,0:02:03.35,Caption,,0,0,0,,НО БУДЕТ "НЕМНОГО ДРУГОЙ ФОРМЫ". БУДТО РЕЧЬ НЕ
Dialogue: 0,0:02:03.43,0:02:08.31,Caption,,0,0,0,,О ГОСУДАРСТВЕ, А О ПИДЖАКЕ, КОТОРЫЙ ОТДАЛИ В АТЕЛЬЕ И ПОПРОСИЛИ ЧУТЬ ПОДОГНАТЬ
Dialogue: 0,0:02:08.31,0:02:11.19,Caption,,0,0,0,,ПО ФИГУРЕ. ЗАБРАТЬ МОЖНО БУДЕТ ПОЗЖЕ. ПРАВДА,
Dialogue: 0,0:02:11.46,0:02:15.67,Caption,,0,0,0,,ПОРТНОЙ НЕ ГОВОРИТ, ГДЕ ИМЕННО СОБИРАЕТСЯ РЕЗАТЬ. ТРАМПА СПРАШИВАЛИ,
Dialogue: 0,0:02:15.83,0:02:18.63,Caption,,0,0,0,,СОХРАНИТСЯ ЛИ УКРАИНА СВОБОДНОЙ И НЕЗАВИСИМОЙ.
Dialogue: 0,0:02:18.79,0:02:21.91,Caption,,0,0,0,,НАПРАШИВАЛОСЬ КОРОТКОЕ И УДОБНОЕ "ДА". ВМЕСТО ЭТОГО
Dialogue: 0,0:02:21.99,0:02:24.95,Caption,,0,0,0,,ОН СООБЩИЛ, ЧТО СОГЛАШЕНИЕ БУДЕТ ЗАКЛЮЧЕНО,
Dialogue: 0,0:02:25.09,0:02:28.47,Caption,,0,0,0,,ВОЙНА ЗАКОНЧИТСЯ, А УКРАИНА СТАНЕТ НЕМНОГО ДРУГОЙ.
Dialogue: 0,0:02:30.74,0:02:33.06,Caption,,0,0,0,,ТЕПЕРЬ ПОПРОБУЙТЕ СПОКОЙНО ПРОЙТИ МИМО ТАКОЙ
Dialogue: 0,0:02:33.06,0:02:35.46,Caption,,0,0,0,,ФОРМУЛИРОВКИ. ДРУГАЯ ПО ТЕРРИТОРИИ?
Dialogue: 0,0:02:35.84,0:02:38.50,Caption,,0,0,0,,ПО УСТРОЙСТВУ ВЛАСТИ? ПО ВОЕННОМУ СТАТУСУ?
Dialogue: 0,0:02:38.98,0:02:41.62,Caption,,0,0,0,,ИЛИ ВАШИНГТОН РАССМАТРИВАЕТ ВЕСЬ КОМПЛЕКТ СРАЗУ,
Dialogue: 0,0:02:41.78,0:02:43.46,Caption,,0,0,0,,ПРОСТО ПОКА НЕ ПОКАЗЫВАЕТ ЦЕННИК?
Dialogue: 0,0:02:43.96,0:02:48.10,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ, В КОТОРЫХ ФАМИЛИИ И ФОРМУЛИРОВКИ ЗНАЧАТ БОЛЬШЕ
Dialogue: 0,0:02:48.10,0:02:52.10,Caption,,0,0,0,,БОДРЫХ ЗАГОЛОВКОВ, ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ ОДИН УЧАСТНИК ПЕРЕГОВОРОВ
Dialogue: 0,0:02:52.10,0:02:56.66,Caption,,0,0,0,,СПОСОБЕН РАССКАЗАТЬ БОЛЬШЕ, ЧЕМ ДЕСЯТЬ ЗАЯВЛЕНИЙ О ХОРОШЕМ НАСТРОЕ СТОРОН.
Dialogue: 0,0:02:57.30,0:02:59.30,Caption,,0,0,0,,БОЛЬШАЯ ДЕЛЕГАЦИЯ ЕЩЁ НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:02:59.46,0:03:03.06,Caption,,0,0,0,,ЧТО ИМЕННО ОНА ОПРЕДЕЛЯЕТ РАМКИ СДЕЛКИ. КИЕВ МОЖЕТ
Dialogue: 0,0:03:03.14,0:03:06.50,Caption,,0,0,0,,ПОЛУЧИТЬ КРЕСЛО, ТАБЛИЧКУ С ФАМИЛИЕЙ И ТОЛСТУЮ ПАПКУ,
Dialogue: 0,0:03:06.66,0:03:10.58,Caption,,0,0,0,,А ЗАТЕМ УЗНАТЬ, ЧТО ГЛАВНЫЕ УСЛОВИЯ КРУПНЫЕ ИГРОКИ СФОРМУЛИРОВАЛИ ДО
Dialogue: 0,0:03:10.58,0:03:12.74,Caption,,0,0,0,,ЕГО ПРИЕЗДА. ВРОДЕ СИДЕЛ ЗА СТОЛОМ,
Dialogue: 0,0:03:12.84,0:03:17.54,Caption,,0,0,0,,ПРОТОКОЛ ПОДПИСЫВАЛ, ТОЛЬКО ПРАВИЛА УЖЕ НАПЕЧАТАЛИ БЕЗ НЕГО. ОТСЮДА СТРАХ
Dialogue: 0,0:03:17.62,0:03:22.42,Caption,,0,0,0,,КИЕВА ПЕРЕД НОВОЙ ЯЛТОЙ, О КОТОРОМ ПИШЕТ ИТАЛЬЯНСКАЯ IL FATTO QUOTIDIANO.
Dialogue: 0,0:03:23.06,0:03:25.86,Caption,,0,0,0,,ЯЛТА ЗДЕСЬ НЕ ПРОСТО ГЕОГРАФИЧЕСКОЕ НАЗВАНИЕ И НЕ
Dialogue: 0,0:03:25.94,0:03:28.58,Caption,,0,0,0,,ЛЮБОВЬ К ИСТОРИЧЕСКИМ ПАРАЛЛЕЛЯМ. ЭТО ПРИНЦИП
Dialogue: 0,0:03:28.66,0:03:30.58,Caption,,0,0,0,,НЕСКОЛЬКО СИЛЬНЫХ ДЕРЖАВ РЕШАЮТ,
Dialogue: 0,0:03:30.81,0:03:33.14,Caption,,0,0,0,,КАК БУДЕТ УСТРОЕНО ПРОСТРАНСТВО ВОКРУГ НИХ,
Dialogue: 0,0:03:33.41,0:03:36.18,Caption,,0,0,0,,А ОСТАЛЬНЫЕ ПОЛУЧАЮТ ИТОГОВЫЙ ДОКУМЕНТ ДЛЯ
Dialogue: 0,0:03:36.18,0:03:40.82,Caption,,0,0,0,,ВНИМАТЕЛЬНОГО ОЗНАКОМЛЕНИЯ. УКРАИНА БОИТСЯ НЕ ТОЛЬКО ОТДЕЛЬНОГО СОГЛАШЕНИЯ
Dialogue: 0,0:03:40.82,0:03:45.59,Caption,,0,0,0,,ПУТИНА И ТРАМПА. ГОРАЗДО СТРАШНЕЕ ВАРИАНТ,
Dialogue: 0,0:03:45.98,0:03:48.55,Caption,,0,0,0,,ПРИ КОТОРОМ МОСКВА И ВАШИНГТОН ОПРЕДЕЛЯТ ОСНОВНЫЕ
Dialogue: 0,0:03:48.55,0:03:51.91,Caption,,0,0,0,,ПРАВИЛА, ЕВРОПЕЙЦЫ ПОПРОБУЮТ УСПЕТЬ К РАЗДАЧЕ МЕСТ,
Dialogue: 0,0:03:52.20,0:03:55.27,Caption,,0,0,0,,А КИЕВУ ОСТАВЯТ ОБСУЖДЕНИЕ ДЕТАЛЕЙ ВНУТРИ ГОТОВОЙ
Dialogue: 0,0:03:55.27,0:03:58.87,Caption,,0,0,0,,КОНСТРУКЦИИ. ФРАЗА ТРАМПА О ДРУГОЙ ФОРМЕ ВХОДИТ В ЭТУ
Dialogue: 0,0:03:58.87,0:04:03.75,Caption,,0,0,0,,КАРТИНУ СЛИШКОМ ХОРОШО. ТЕРРИТОРИАЛЬНЫЙ УРОВЕНЬ ПОНЯТЕН ВСЕМ. МЕНЯЕТСЯ ЛИНИЯ
Dialogue: 0,0:04:03.75,0:04:07.75,Caption,,0,0,0,,НА КАРТЕ, И СТРАНА БУКВАЛЬНО ПОЛУЧАЕТ ДРУГИЕ ОЧЕРТАНИЯ. НО
Dialogue: 0,0:04:07.75,0:04:09.91,Caption,,0,0,0,,РОССИЯ ВСЕ ЭТИ ГОДЫ ГОВОРИЛА НЕ ТОЛЬКО О
Dialogue: 0,0:04:09.91,0:04:13.11,Caption,,0,0,0,,ТЕРРИТОРИЯХ. МОСКВА ПОСТОЯННО ВОЗВРАЩАЛА РАЗГОВОР К
Dialogue: 0,0:04:13.11,0:04:15.59,Caption,,0,0,0,,НАТО, НЕЙТРАЛЬНОМУ СТАТУСУ УКРАИНЫ,
Dialogue: 0,0:04:15.83,0:04:18.71,Caption,,0,0,0,,РАКЕТАМ, ИНОСТРАННОЙ ВОЕННОЙ ИНФРАСТРУКТУРЕ,
Dialogue: 0,0:04:18.79,0:04:21.83,Caption,,0,0,0,,ПОТЕНЦИАЛУ УКРАИНСКОЙ АРМИИ И БЕЗОПАСНОСТИ ВОЗЛЕ
Dialogue: 0,0:04:21.83,0:04:26.71,Caption,,0,0,0,,РОССИЙСКИХ ГРАНИЦ. ОДНОЙ ГЕОГРАФИЕЙ ЗДЕСЬ НЕ ОБОЙТИСЬ. ЕСЛИ СОГЛАШЕНИЕ
Dialogue: 0,0:04:26.71,0:04:28.63,Caption,,0,0,0,,ЗАТРОНЕТ ВОЕННЫЙ КУРС УКРАИНЫ,
Dialogue: 0,0:04:28.83,0:04:31.35,Caption,,0,0,0,,ПРАВИЛА РАЗМЕЩЕНИЯ СИЛ И ОТНОШЕНИЯ С НАТО,
Dialogue: 0,0:04:31.67,0:04:34.39,Caption,,0,0,0,,СТРАНА ИЗМЕНИТСЯ БЕЗ ВСЯКОЙ НОВОЙ ЛИНИИ НА КАРТЕ.
Dialogue: 0,0:04:34.86,0:04:37.03,Caption,,0,0,0,,А ЕСЛИ КИЕВ ЕЩЁ И СМЕНИТ ПРЕЖНИЙ КУРС
Dialogue: 0,0:04:37.11,0:04:41.35,Caption,,0,0,0,,В ОТНОШЕНИИ РОССИИ, СЛОВО "ФОРМА" ВМЕСТИТ УЖЕ ВСЁ ГОСУДАРСТВЕННОЕ
Dialogue: 0,0:04:41.35,0:04:46.47,Caption,,0,0,0,,УСТРОЙСТВО. ТРАМП НЕ СКАЗАЛ, ЧТО УКРАИНА ПОТЕРЯЕТ КОНКРЕТНУЮ ОБЛАСТЬ. ОН ВЫБРАЛ
Dialogue: 0,0:04:46.47,0:04:49.59,Caption,,0,0,0,,ФОРМУЛИРОВКУ СРАЗУ ДЛЯ НЕСКОЛЬКИХ ПЕРЕМЕН. УДОБНО,
Dialogue: 0,0:04:49.63,0:04:51.75,Caption,,0,0,0,,КОНЕЧНО. ЗАРАНЕЕ ОПИСАЛ РЕЗУЛЬТАТ,
Dialogue: 0,0:04:52.07,0:04:55.67,Caption,,0,0,0,,НО НЕ ОБЪЯСНИЛ, ЧТО ИМЕННО ОТ ПРЕЖНЕГО ВАРИАНТА ОСТАНЕТСЯ.
Dialogue: 0,0:04:57.94,0:05:00.58,Caption,,0,0,0,,ПОЧТИ КАК МАСТЕР ПО РЕМОНТУ КВАРТИРА БУДЕТ НЕМНОГО
Dialogue: 0,0:05:00.58,0:05:04.50,Caption,,0,0,0,,ДРУГОЙ, А СТЕНУ, КУХНЮ И ПРОВОДКУ ОБСУДИМ ПОСЛЕ АВАНСА.
Dialogue: 0,0:05:05.28,0:05:07.86,Caption,,0,0,0,,ЕВРОПЕЙЦЫ НЕРВНИЧАЮТ НЕ ИЗ ЗА ОДНОЙ УКРАИНСКОЙ
Dialogue: 0,0:05:07.86,0:05:12.10,Caption,,0,0,0,,ГРАНИЦЫ. POLITICO СООБЩАЕТ, ЧТО ИДЕЯ АДМИНИСТРАЦИИ ТРАМПА О НОВОМ
Dialogue: 0,0:05:12.10,0:05:14.82,Caption,,0,0,0,,ОБЩЕЕВРОПЕЙСКОМ СОГЛАШЕНИИ С РОССИЕЙ ВЫЗВАЛА
Dialogue: 0,0:05:14.82,0:05:18.02,Caption,,0,0,0,,СКЕПТИЦИЗМ В ЕВРОПЕЙСКИХ СТОЛИЦАХ. КАЯ КАЛЛАС
Dialogue: 0,0:05:18.10,0:05:22.10,Caption,,0,0,0,,НАПОМИНАЕТ, ЧТО СИСТЕМА ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ УЖЕ СУЩЕСТВУЕТ.
Dialogue: 0,0:05:22.50,0:05:25.94,Caption,,0,0,0,,ЕСТЬ НАТО, ЕСТЬ ЕВРОСОЮЗ. ТОЛЬКО ВАШИНГТОН,
Dialogue: 0,0:05:26.10,0:05:29.14,Caption,,0,0,0,,ПОХОЖЕ, ГОТОВ ОБСУЖДАТЬ ЕЁ ПЕРЕУСТРОЙСТВО С МОСКВОЙ,
Dialogue: 0,0:05:29.54,0:05:33.70,Caption,,0,0,0,,НЕ ДОЖИДАЯСЬ, ПОКА ВСЕ ЕВРОПЕЙСКИЕ СТОЛИЦЫ ДРУЖНО ПОДНИМУТ РУКУ.
Dialogue: 0,0:05:34.06,0:05:37.22,Caption,,0,0,0,,КАРТИНА ПОЛУЧАЕТСЯ ЕДКАЯ. НЕСКОЛЬКО ЛЕТ ЕВРОПА
Dialogue: 0,0:05:37.22,0:05:41.54,Caption,,0,0,0,,ДОКАЗЫВАЛА, ЧТО СОДЕРЖАТЕЛЬНЫЙ РАЗГОВОР С РОССИЕЙ НЕВОЗМОЖЕН. НО
Dialogue: 0,0:05:41.62,0:05:44.02,Caption,,0,0,0,,СТОИЛО СОЕДИНЁННЫМ ШТАТАМ САМИМ ЕГО НАЧАТЬ,
Dialogue: 0,0:05:44.27,0:05:47.22,Caption,,0,0,0,,КАК ВЫЯСНИЛОСЬ ТЕМА ВАЖНАЯ, РАЗГОВОР НУЖНЫЙ,
Dialogue: 0,0:05:47.54,0:05:49.78,Caption,,0,0,0,,А ЕВРОПЕЙСКИЙ СТУЛ ПОЧЕМУ ТО СТОИТ В КОРИДОРЕ.
Dialogue: 0,0:05:50.27,0:05:52.74,Caption,,0,0,0,,ФРАНЦИЯ УЖЕ ХОЧЕТ НАПРАВИТЬ СВОЕГО ПРЕДСТАВИТЕЛЯ В
Dialogue: 0,0:05:52.82,0:05:55.22,Caption,,0,0,0,,АБУ ДАБИ. В ПАРИЖЕ БЫСТРО СООБРАЗИЛИ,
Dialogue: 0,0:05:55.54,0:05:58.34,Caption,,0,0,0,,ЧТО ОБСУЖДАТЬ ПРИНЦИПЫ НА РАССТОЯНИИ ПРИЯТНО ЛИШЬ ДО
Dialogue: 0,0:05:58.42,0:06:02.34,Caption,,0,0,0,,ТОЙ МИНУТЫ, ПОКА ДРУГИЕ НЕ НАЧИНАЮТ ПРИНИМАТЬ РЕШЕНИЯ. ЕСЛИ
Dialogue: 0,0:06:02.42,0:06:04.90,Caption,,0,0,0,,СОСЕДИ СОБРАЛИСЬ МЕНЯТЬ ПРАВИЛА ВАШЕГО ДОМА,
Dialogue: 0,0:06:05.22,0:06:10.26,Caption,,0,0,0,,ЛУЧШЕ ВОЙТИ ДО ГОЛОСОВАНИЯ, А НЕ ПОСЛЕ ЗАМЕНЫ ЗАМКОВ. ТОЛЬКО КОГО СЧИТАТЬ
Dialogue: 0,0:06:10.26,0:06:15.27,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЕМ ЕВРОПЫ? ДЖОРДЖА МЕЛОНИ ПРЯМО ГОВОРИТ,
Dialogue: 0,0:06:15.53,0:06:18.23,Caption,,0,0,0,,ЧТО ЕВРОСОЮЗ ПО УКРАИНСКОМУ ВОПРОСУ РАЗОБЩЁН.
Dialogue: 0,0:06:18.86,0:06:21.67,Caption,,0,0,0,,ОДНИ ЛИДЕРЫ ЗВОНЯТ ПУТИНУ. ДРУГИЕ ТРЕБУЮТ НЕ
Dialogue: 0,0:06:21.67,0:06:24.87,Caption,,0,0,0,,ЗВОНИТЬ. ОДНИ ХОТЯТ ПОПАСТЬ ЗА СТОЛ. ОСТАЛЬНЫЕ
Dialogue: 0,0:06:24.95,0:06:29.11,Caption,,0,0,0,,СПОРЯТ, КТО ДОСТОИН ТУДА ПОПАСТЬ. ФОРМАТЫ МНОЖАТСЯ БЫСТРЕЕ,
Dialogue: 0,0:06:29.28,0:06:32.71,Caption,,0,0,0,,ЧЕМ ПОЯВЛЯЕТСЯ ЕДИНАЯ ПОЗИЦИЯ. ЕВРОПА НАПОМИНАЕТ
Dialogue: 0,0:06:32.71,0:06:36.87,Caption,,0,0,0,,БОЛЬШУЮ СЕМЬЮ, КОТОРАЯ ПРИШЛА ДЕЛИТЬ НАСЛЕДСТВО И ЕЩЁ В ПРИХОЖЕЙ
Dialogue: 0,0:06:36.87,0:06:40.47,Caption,,0,0,0,,ПОССОРИЛАСЬ, КТО БУДЕТ ГОВОРИТЬ ОТ ВСЕХ. ЗАВЕЩАНИЕ ПОКА НЕ
Dialogue: 0,0:06:40.47,0:06:43.91,Caption,,0,0,0,,ОТКРЫЛИ, ЗАТО ПЯТЬ ЧЕЛОВЕК УЖЕ ОБЪЯВИЛИ СЕБЯ СТАРШИМ
Dialogue: 0,0:06:43.91,0:06:46.55,Caption,,0,0,0,,РОДСТВЕННИКОМ. ФРАНЦУЗСКОЕ ЖЕЛАНИЕ ПРИЕХАТЬ В АБУ
Dialogue: 0,0:06:46.63,0:06:49.59,Caption,,0,0,0,,ДАБИ РЕШАЕТ ЛИШЬ ПОЛОВИНУ ПРОБЛЕМЫ. ПРЕДСТАВИТЕЛЯ
Dialogue: 0,0:06:49.59,0:06:52.07,Caption,,0,0,0,,ОТПРАВИТЬ НЕТРУДНО. НАМНОГО СЛОЖНЕЕ ДОКАЗАТЬ,
Dialogue: 0,0:06:52.23,0:06:55.03,Caption,,0,0,0,,ЧТО ОН ПРЕДСТАВЛЯЕТ НЕ ТОЛЬКО СЕБЯ И СОБСТВЕННУЮ
Dialogue: 0,0:06:55.03,0:06:58.07,Caption,,0,0,0,,СТОЛИЦУ. НА ЭТОМ ФОНЕ АМЕРИКАНСКАЯ ИДЕЯ ВЕРНУТЬ
Dialogue: 0,0:06:58.07,0:07:01.35,Caption,,0,0,0,,СОВЕТ РОССИЯ НАТО ВЫГЛЯДИТ ОСОБЕННО ВЫРАЗИТЕЛЬНО.
Dialogue: 0,0:07:01.57,0:07:04.15,Caption,,0,0,0,,ДЖАРЕД КУШНЕР ПРЕДЛАГАЕТ СНОВА ИСПОЛЬЗОВАТЬ ЭТОТ
Dialogue: 0,0:07:04.15,0:07:06.95,Caption,,0,0,0,,МЕХАНИЗМ ДЛЯ ОБСУЖДЕНИЯ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:07:07.17,0:07:09.11,Caption,,0,0,0,,СОВЕТ СОЗДАВАЛСЯ КАК ПЛОЩАДКА,
Dialogue: 0,0:07:09.43,0:07:12.15,Caption,,0,0,0,,ГДЕ МОСКВА И СТРАНЫ АЛЬЯНСА ДОЛЖНЫ БЫЛИ СОВМЕСТНО
Dialogue: 0,0:07:12.15,0:07:13.75,Caption,,0,0,0,,РАЗБИРАТЬ ВОПРОСЫ БЕЗОПАСНОСТИ.
Dialogue: 0,0:07:14.31,0:07:16.95,Caption,,0,0,0,,ПОСЛЕДНЕЕ ЗАСЕДАНИЕ СОСТОЯЛОСЬ В ЯНВАРЕ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:07:16.95,0:07:19.51,Caption,,0,0,0,,ДВАДЦАТЬ ВТОРОГО ГОДА. ПОСЛЕ ЭТОГО МЕХАНИЗМ
Dialogue: 0,0:07:19.59,0:07:21.99,Caption,,0,0,0,,ПРАКТИЧЕСКИ ПЕРЕСТАЛ РАБОТАТЬ. ТЕПЕРЬ ЕГО ХОТЯТ
Dialogue: 0,0:07:22.07,0:07:28.50,Caption,,0,0,0,,ДОСТАТЬ ОБРАТНО. НЕ ПРИДУМЫВАТЬ НОВЫЙ ОРГАН И НЕ СОЗЫВАТЬ КОНФЕРЕНЦИЮ
Dialogue: 0,0:07:28.58,0:07:31.30,Caption,,0,0,0,,С ТОРЖЕСТВЕННЫМ НАЗВАНИЕМ, А ВЕРНУТЬСЯ ТУДА,
Dialogue: 0,0:07:31.59,0:07:34.42,Caption,,0,0,0,,ГДЕ УЖЕ ПЫТАЛИСЬ ОБСУЖДАТЬ ТОТ САМЫЙ СТАРЫЙ СПОР.
Dialogue: 0,0:07:35.40,0:07:37.62,Caption,,0,0,0,,РОССИЙСКИЕ ПРЕДЛОЖЕНИЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО
Dialogue: 0,0:07:37.62,0:07:40.58,Caption,,0,0,0,,ГОДА ТОЖЕ ПРЕДУСМАТРИВАЛИ КОНСУЛЬТАЦИИ ЧЕРЕЗ СОВЕТ
Dialogue: 0,0:07:40.58,0:07:43.78,Caption,,0,0,0,,РОССИЯ НАТО. ТОГДА ТРЕБОВАНИЯ ОТВЕРГЛИ. СЕЙЧАС НА
Dialogue: 0,0:07:43.78,0:07:45.46,Caption,,0,0,0,,ПЕРЕГОВОРАХ ПОЯВЛЯЕТСЯ ЧЕЛОВЕК,
Dialogue: 0,0:07:45.72,0:07:50.10,Caption,,0,0,0,,КОТОРЫЙ ИХ ПРЕДСТАВЛЯЛ, А АМЕРИКАНСКАЯ СТОРОНА ПРЕДЛАГАЕТ ОЖИВИТЬ ПЛОЩАДКУ,
Dialogue: 0,0:07:50.28,0:07:53.30,Caption,,0,0,0,,ГДЕ ОНИ МОГЛИ ОБСУЖДАТЬСЯ. ПЯТЬ ЛЕТ НАЗАД ДВЕРЬ
Dialogue: 0,0:07:53.30,0:07:55.94,Caption,,0,0,0,,ЗАКРЫЛИ ПЕРЕД РЯБКОВЫМ. ТЕПЕРЬ ЕГО ПРИГЛАШАЮТ К
Dialogue: 0,0:07:56.02,0:07:58.02,Caption,,0,0,0,,СТОЛУ И ИЩУТ КЛЮЧ ОТ ТОЙ ЖЕ ДВЕРИ.
Dialogue: 0,0:07:58.34,0:08:00.74,Caption,,0,0,0,,НЕЛОВКО ПОЛУЧИЛОСЬ. СТОЛЬКО СОБЫТИЙ,
Dialogue: 0,0:08:00.90,0:08:04.34,Caption,,0,0,0,,СТОЛЬКО РЕЧЕЙ, А СВЯЗКА КЛЮЧЕЙ ВСЁ ВРЕМЯ ЛЕЖАЛА В СТАРОМ
Dialogue: 0,0:08:04.42,0:08:07.30,Caption,,0,0,0,,ЯЩИКЕ. ЧТОБЫ ПОНЯТЬ, КУДА ВЕДЁТ РАЗГОВОР,
Dialogue: 0,0:08:07.70,0:08:10.66,Caption,,0,0,0,,ПРИДЁТСЯ ВЕРНУТЬСЯ К ДВАДЦАТЬ СЕДЬМОМУ МАЯ ТЫСЯЧА
Dialogue: 0,0:08:10.66,0:08:13.54,Caption,,0,0,0,,ДЕВЯТЬСОТ ДЕВЯНОСТО СЕДЬМОГО ГОДА. ТОГДА РОССИЯ И
Dialogue: 0,0:08:13.62,0:08:17.62,Caption,,0,0,0,,НАТО ПОДПИСАЛИ ОСНОВОПОЛАГАЮЩИЙ АКТ. НАЗВАНИЕ У
Dialogue: 0,0:08:17.70,0:08:20.02,Caption,,0,0,0,,ДОКУМЕНТА ТЯЖЁЛОЕ. ПОКА ЕГО ПРОИЗНЕСЁШЬ,
Dialogue: 0,0:08:20.41,0:08:23.06,Caption,,0,0,0,,МОЖНО СОГЛАСОВАТЬ НЕБОЛЬШОЙ ДОГОВОР ПОПРОЩЕ. НО
Dialogue: 0,0:08:23.06,0:08:27.86,Caption,,0,0,0,,СОДЕРЖАНИЕ ОБЪЯСНЯЕТ, ПОЧЕМУ ДЕВЯНОСТО СЕДЬМОЙ ГОД ПОСТОЯННО ВОЗВРАЩАЕТСЯ
Dialogue: 0,0:08:27.94,0:08:31.06,Caption,,0,0,0,,В РОССИЙСКИХ ТРЕБОВАНИЯХ. РОССИЯ И НАТО ЗАЯВИЛИ,
Dialogue: 0,0:08:31.30,0:08:33.54,Caption,,0,0,0,,ЧТО БОЛЬШЕ НЕ РАССМАТРИВАЮТ ДРУГ ДРУГА КАК
Dialogue: 0,0:08:33.54,0:08:37.42,Caption,,0,0,0,,ПРОТИВНИКОВ. АЛЬЯНС ГОВОРИЛ,
Dialogue: 0,0:08:37.62,0:08:40.22,Caption,,0,0,0,,ЧТО БУДЕТ ОБЕСПЕЧИВАТЬ КОЛЛЕКТИВНУЮ ОБОРОНУ НОВЫХ
Dialogue: 0,0:08:40.22,0:08:43.17,Caption,,0,0,0,,ЧЛЕНОВ БЕЗ ДОПОЛНИТЕЛЬНОГО ПОСТОЯННОГО РАЗМЕЩЕНИЯ
Dialogue: 0,0:08:43.17,0:08:45.26,Caption,,0,0,0,,СУЩЕСТВЕННЫХ БОЕВЫХ СИЛ НА ИХ ТЕРРИТОРИИ.
Dialogue: 0,0:08:45.97,0:08:48.54,Caption,,0,0,0,,ОТДЕЛЬНО УКАЗЫВАЛОСЬ ОТСУТСТВИЕ НАМЕРЕНИЙ РАЗМЕЩАТЬ
Dialogue: 0,0:08:48.62,0:08:52.86,Caption,,0,0,0,,ТАМ ЯДЕРНОЕ ОРУЖИЕ. МОСКВА НЕ ПРЕДЛАГАЛА ВЫГНАТЬ ИЗ НАТО ПОЛЬШУ,
Dialogue: 0,0:08:52.97,0:08:57.26,Caption,,0,0,0,,ЧЕХИЮ, ВЕНГРИЮ ИЛИ СТРАНЫ БАЛТИИ. ЧЛЕНСТВО САМО ПО СЕБЕ
Dialogue: 0,0:08:57.34,0:09:00.22,Caption,,0,0,0,,И РЕАЛЬНАЯ ВОЕННАЯ НАЧИНКА ВОЗЛЕ РОССИЙСКИХ ГРАНИЦ
Dialogue: 0,0:09:00.29,0:09:01.82,Caption,,0,0,0,,ДЛЯ НЕЁ БЫЛИ РАЗНЫМИ ВОПРОСАМИ.
Dialogue: 0,0:09:02.42,0:09:05.90,Caption,,0,0,0,,ХОТИТЕ СОСТОЯТЬ В СОЮЗЕ, ПОЖАЛУЙСТА. ПРОВОДИТЕ САММИТЫ,
Dialogue: 0,0:09:06.13,0:09:08.46,Caption,,0,0,0,,ГЛАДЬТЕ ФОРМУ, РЕПЕТИРУЙТЕ ПАРАД,
Dialogue: 0,0:09:08.69,0:09:11.82,Caption,,0,0,0,,ПОКАЗЫВАЙТЕ ТАНКИ ГОСТЯМ. ВОЕННЫЙ ОРКЕСТР ТОЖЕ
Dialogue: 0,0:09:11.82,0:09:15.82,Caption,,0,0,0,,ОСТАВЬТЕ, ОН ГРАНИЦУ НЕ ПРОБИВАЕТ. НО ПОСТОЯННЫЕ КОНТИНГЕНТЫ,
Dialogue: 0,0:09:15.97,0:09:20.05,Caption,,0,0,0,,РАКЕТЫ, ТЯЖЁЛЫЕ ВООРУЖЕНИЯ И ИНФРАСТРУКТУРА СОЕДИНЁННЫХ
Dialogue: 0,0:09:20.05,0:09:22.93,Caption,,0,0,0,,ШТАТОВ РЯДОМ С РОССИЕЙ, ЭТО УЖЕ ВОПРОС,
Dialogue: 0,0:09:23.17,0:09:25.82,Caption,,0,0,0,,НА КОТОРОМ МУЗЫКА ЗАКАНЧИВАЕТСЯ И НАЧИНАЕТСЯ
Dialogue: 0,0:09:25.90,0:09:28.70,Caption,,0,0,0,,РАЗГОВОР С РЯБКОВЫМ. В ДЕКАБРЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:09:28.70,0:09:31.17,Caption,,0,0,0,,ПЕРВОГО ГОДА МОСКВА ПРЕДЛОЖИЛА ОРИЕНТИРОВАТЬСЯ НА
Dialogue: 0,0:09:31.17,0:09:36.46,Caption,,0,0,0,,РАЗМЕЩЕНИЕ СИЛ И ВООРУЖЕНИЙ, СУЩЕСТВОВАВШЕЕ К МОМЕНТУ ПОДПИСАНИЯ АКТА. РОССИЯ НЕ
Dialogue: 0,0:09:36.46,0:09:39.10,Caption,,0,0,0,,ТРЕБОВАЛА ВЫДАТЬ ПОЗДНИМ ЧЛЕНАМ НАТО СПРАВКУ,
Dialogue: 0,0:09:39.24,0:09:42.05,Caption,,0,0,0,,ЧТО ОНИ БОЛЬШЕ НЕ ЧЛЕНЫ. ОНА ТРЕБОВАЛА ВЕРНУТЬ
Dialogue: 0,0:09:42.14,0:09:45.50,Caption,,0,0,0,,ВОЕННУЮ СОСТАВЛЯЮЩУЮ К ПРЕЖНЕЙ ТОЧКЕ ОТСЧЁТА. ЭТУ
Dialogue: 0,0:09:45.58,0:09:48.29,Caption,,0,0,0,,ПОЗИЦИЮ ЗАПАДУ РАЗЪЯСНЯЛ ВСЁ ТОТ ЖЕ СЕРГЕЙ РЯБКОВ.
Dialogue: 0,0:09:48.73,0:09:51.02,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ СКЛАДЫВАЕТСЯ ВЫРАЗИТЕЛЬНАЯ.
Dialogue: 0,0:09:53.28,0:09:55.76,Caption,,0,0,0,,СНАЧАЛА АКТ ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО СЕДЬМОГО
Dialogue: 0,0:09:55.84,0:09:59.20,Caption,,0,0,0,,ГОДА. ЗАТЕМ РАСШИРЕНИЕ НАТО И СПОР О РАЗМЕЩЕНИИ
Dialogue: 0,0:09:59.28,0:10:02.32,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЫ. ПОТОМ РОССИЙСКИЕ ПРЕДЛОЖЕНИЯ
Dialogue: 0,0:10:02.32,0:10:04.00,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА,
Dialogue: 0,0:10:04.24,0:10:08.64,Caption,,0,0,0,,ОТКАЗ ЗАПАДА, ПОСЛЕДНЕЕ ЗАСЕДАНИЕ СОВЕТА РОССИЯ НАТО И РАЗРЫВ.
Dialogue: 0,0:10:09.09,0:10:11.84,Caption,,0,0,0,,ЧЕРЕЗ ПЯТЬ ЛЕТ РЯБКОВ СНОВА УЧАСТВУЕТ В ПЕРЕГОВОРАХ,
Dialogue: 0,0:10:12.17,0:10:15.28,Caption,,0,0,0,,А ВАШИНГТОН ПРЕДЛАГАЕТ ГОВОРИТЬ ЧЕРЕЗ СОВЕТ. ТАКОЕ
Dialogue: 0,0:10:15.28,0:10:18.16,Caption,,0,0,0,,СОВПАДЕНИЕ УЖЕ НЕ МАШЕТ ВАМ РУКОЙ. ОНО БЕРЁТ
Dialogue: 0,0:10:18.24,0:10:20.96,Caption,,0,0,0,,ЗА ПЛЕЧО И ПРОСИТ НАКОНЕЦ ОБРАТИТЬ ВНИМАНИЕ.
Dialogue: 0,0:10:21.41,0:10:24.08,Caption,,0,0,0,,НЫНЕШНИЙ ТОРГ ПОЭТОМУ КАСАЕТСЯ НЕ ТОЛЬКО УКРАИНЫ.
Dialogue: 0,0:10:24.41,0:10:27.28,Caption,,0,0,0,,ОНА СТАЛА ЦЕНТРАЛЬНОЙ ЧАСТЬЮ ГОРАЗДО БОЛЕЕ КРУПНОГО
Dialogue: 0,0:10:27.28,0:10:31.92,Caption,,0,0,0,,СПОРА О ТОМ, ГДЕ ЗАКАНЧИВАЕТСЯ СВОБОДА АЛЬЯНСА РАЗМЕЩАТЬ ВОЕННУЮ
Dialogue: 0,0:10:31.92,0:10:35.04,Caption,,0,0,0,,ИНФРАСТРУКТУРУ И ГДЕ НАЧИНАЮТСЯ ТРЕБОВАНИЯ РОССИИ К
Dialogue: 0,0:10:35.04,0:10:38.88,Caption,,0,0,0,,СОБСТВЕННОЙ БЕЗОПАСНОСТИ. ЗАПАД МОЖЕТ СКОЛЬКО УГОДНО ПОВТОРЯТЬ,
Dialogue: 0,0:10:39.20,0:10:41.84,Caption,,0,0,0,,ЧТО КАЖДОЕ ГОСУДАРСТВО САМОСТОЯТЕЛЬНО ВЫБИРАЕТ
Dialogue: 0,0:10:41.92,0:10:44.88,Caption,,0,0,0,,СОЮЗЫ. МОСКВА ОТВЕЧАЕТ НЕ ПРО ЗНАЧОК НА ЛАЦКАНЕ
Dialogue: 0,0:10:44.96,0:10:47.52,Caption,,0,0,0,,И НЕ ПРО СПИСОК УЧАСТНИКОВ ЗАСЕДАНИЯ. ОНА
Dialogue: 0,0:10:47.52,0:10:52.72,Caption,,0,0,0,,СПРАШИВАЕТ, КАКИЕ ВОЙСКА, РАКЕТЫ И СИСТЕМЫ ПОЯВЯТСЯ РЯДОМ С ЕЁ ГРАНИЦАМИ.
Dialogue: 0,0:10:53.21,0:10:56.24,Caption,,0,0,0,,ОТСЮДА ВОЗНИКАЕТ ВОПРОС О ВОЕННОМ УСТРОЙСТВЕ БУДУЩЕЙ
Dialogue: 0,0:10:56.24,0:10:59.36,Caption,,0,0,0,,УКРАИНЫ. СОХРАНИТ ЛИ ОНА ПРЕЖНИЙ ОБЪЁМ ВООРУЖЕНИЙ?
Dialogue: 0,0:10:59.60,0:11:02.32,Caption,,0,0,0,,КАКИЕ ИНОСТРАННЫЕ СИЛЫ СМОГУТ НАХОДИТЬСЯ НА ЕЁ
Dialogue: 0,0:11:02.32,0:11:04.72,Caption,,0,0,0,,ТЕРРИТОРИИ? ПОЛУЧИТ ЛИ ОНА ПУТЬ В НАТО?
Dialogue: 0,0:11:04.97,0:11:07.12,Caption,,0,0,0,,КАКИЕ ОГРАНИЧЕНИЯ ЗАПИШУТ В СОГЛАШЕНИИ?
Dialogue: 0,0:11:07.35,0:11:09.44,Caption,,0,0,0,,КТО ПРОКОНТРОЛИРУЕТ ИХ ВЫПОЛНЕНИЕ?
Dialogue: 0,0:11:11.73,0:11:13.33,Caption,,0,0,0,,ЧТО БУДЕТ СЧИТАТЬСЯ НАРУШЕНИЕМ?
Dialogue: 0,0:11:13.67,0:11:15.57,Caption,,0,0,0,,ЭТО УЖЕ НЕ СПОР О ШИРИНЕ ПОЛОСЫ НА
Dialogue: 0,0:11:15.57,0:11:18.69,Caption,,0,0,0,,КАРТЕ. ЭТО ОПИСАНИЕ ГОСУДАРСТВА ПОСЛЕ ВОЙНЫ.
Dialogue: 0,0:11:19.40,0:11:22.69,Caption,,0,0,0,,КУРС КИЕВА ИМЕЕТ НЕ МЕНЬШЕЕ ЗНАЧЕНИЕ. ЕСЛИ УКРАИНА
Dialogue: 0,0:11:22.77,0:11:24.85,Caption,,0,0,0,,СОХРАНИТ ПРЕЖНЕЕ ОТНОШЕНИЕ К РОССИИ,
Dialogue: 0,0:11:25.12,0:11:27.65,Caption,,0,0,0,,ПРЕЖНИЙ ВОЕННЫЙ ВЕКТОР И ДВИЖЕНИЕ В НАТО,
Dialogue: 0,0:11:27.97,0:11:32.61,Caption,,0,0,0,,А ИЗМЕНЯТСЯ ТОЛЬКО ГРАНИЦЫ, МОСКВА ЕДВА ЛИ НАЗОВЁТ ЭТО УСТРАНЕНИЕМ ПЕРВОПРИЧИН
Dialogue: 0,0:11:32.61,0:11:36.93,Caption,,0,0,0,,КОНФЛИКТА. ЗНАЧИТ, РОССИЙСКИЕ ТРЕБОВАНИЯ ЛИБО СНОВА ОСТАНУТСЯ ЗА
Dialogue: 0,0:11:36.93,0:11:40.93,Caption,,0,0,0,,ПРЕДЕЛАМИ СОГЛАШЕНИЯ, ЛИБО ПЕРЕМЕНЫ ПОЙДУТ ГЛУБЖЕ ТЕРРИТОРИАЛЬНЫХ.
Dialogue: 0,0:11:41.84,0:11:45.41,Caption,,0,0,0,,В ОДНОЙ ФРАЗЕ ТРАМПА СКРЫТЫ ТРИ УРОВНЯ. ГЕОГРАФИЯ
Dialogue: 0,0:11:45.41,0:11:49.25,Caption,,0,0,0,,ОПРЕДЕЛЯЕТ ОЧЕРТАНИЯ СТРАНЫ. ВОЕННЫЕ ОГРАНИЧЕНИЯ ОПРЕДЕЛЯЮТ,
Dialogue: 0,0:11:49.47,0:11:52.61,Caption,,0,0,0,,ЧЕМ ОНА РАСПОЛАГАЕТ И С КЕМ СВЯЗЫВАЕТ БЕЗОПАСНОСТЬ.
Dialogue: 0,0:11:53.16,0:11:58.21,Caption,,0,0,0,,КУРС РУКОВОДСТВА ОПРЕДЕЛЯЕТ, КУДА ОНА ДВИЖЕТСЯ ПОСЛЕ СОГЛАШЕНИЯ. "НЕМНОГО ДРУГОЙ"
Dialogue: 0,0:11:58.21,0:12:01.17,Caption,,0,0,0,,НА ТАКОМ ФОНЕ ЗВУЧИТ ИЗДЕВАТЕЛЬСКИ СКРОМНО. ЕСЛИ
Dialogue: 0,0:12:01.17,0:12:04.13,Caption,,0,0,0,,МЕНЯЮТСЯ ВСЕ ТРИ УРОВНЯ, ЭТО НЕ ЛЁГКАЯ ПРАВКА,
Dialogue: 0,0:12:04.37,0:12:07.33,Caption,,0,0,0,,А КАПИТАЛЬНАЯ ПЕРЕСТРОЙКА. ПРОСТО ТРАМП ОПИСАЛ ЕЁ
Dialogue: 0,0:12:07.33,0:12:11.57,Caption,,0,0,0,,СЛОВАМИ ЧЕЛОВЕКА, КОТОРЫЙ НЕ ЛЮБИТ ПУГАТЬ КЛИЕНТА ДО ОКОНЧАНИЯ РАБОТ.
Dialogue: 0,0:12:12.24,0:12:14.61,Caption,,0,0,0,,ЕЩЁ ОДНА ВАЖНАЯ ТОЧКА НАХОДИТСЯ НЕ В АБУ
Dialogue: 0,0:12:14.61,0:12:18.37,Caption,,0,0,0,,ДАБИ, А В МАЙАМИ. АМЕРИКАНЦЫ ХОТЯТ ВИДЕТЬ ПУТИНА НА
Dialogue: 0,0:12:18.37,0:12:21.33,Caption,,0,0,0,,САММИТЕ БОЛЬШОЙ ДВАДЦАТКИ. МОСКВА ОТВЕЧАЕТ,
Dialogue: 0,0:12:21.57,0:12:24.29,Caption,,0,0,0,,ЧТО ОКОНЧАТЕЛЬНОЕ РЕШЕНИЕ БУДЕТ ПРИНЯТО БЛИЖЕ К
Dialogue: 0,0:12:24.29,0:12:30.07,Caption,,0,0,0,,МЕРОПРИЯТИЮ. ЕСЛИ ГРУППЫ УСПЕЮТ ПОДГОТОВИТЬ ОСНОВНЫЕ ПОЛОЖЕНИЯ,
Dialogue: 0,0:12:30.23,0:12:34.71,Caption,,0,0,0,,МАЙАМИ СПОСОБЕН СТАТЬ МЕСТОМ, ГДЕ ЛИДЕРЫ РЕШАТ СУДЬБУ СОБРАННОГО ПАКЕТА.
Dialogue: 0,0:12:35.27,0:12:38.79,Caption,,0,0,0,,ВОЕННЫЕ СЧИТАЮТ ПАРАМЕТРЫ. ПРЕДСТАВИТЕЛИ МИД СВОДЯТ
Dialogue: 0,0:12:38.79,0:12:41.43,Caption,,0,0,0,,ФОРМУЛИРОВКИ. СПЕЦИАЛИСТЫ СПОРЯТ О КОНТРОЛЕ.
Dialogue: 0,0:12:41.67,0:12:43.43,Caption,,0,0,0,,РУКОВОДИТЕЛЯМ ПРИНОСЯТ РЕЗУЛЬТАТ,
Dialogue: 0,0:12:43.74,0:12:47.19,Caption,,0,0,0,,И ОНИ ВЫБИРАЮТ, ЧТО ПРЕВРАТИТСЯ В СОГЛАШЕНИЕ. ПУТИН И ТРАМП НЕ
Dialogue: 0,0:12:47.19,0:12:49.67,Caption,,0,0,0,,СТАНУТ СИДЕТЬ НАД ПЕРВОЙ СТРАНИЦЕЙ И ВЫЯСНЯТЬ,
Dialogue: 0,0:12:49.83,0:12:52.55,Caption,,0,0,0,,КАКОЙ ШРИФТ ВЫБРАТЬ ДЛЯ ЗАГОЛОВКА. ОСНОВНЫЕ
Dialogue: 0,0:12:52.55,0:12:55.43,Caption,,0,0,0,,ПРОТИВОРЕЧИЯ ЗАРАНЕЕ РАЗБИРАЮТ ЛЮДИ СООТВЕТСТВУЮЩЕГО
Dialogue: 0,0:12:55.43,0:12:58.23,Caption,,0,0,0,,УРОВНЯ. ПОЭТОМУ РЯБКОВ МОЖЕТ ГОТОВИТЬ НЕ ЭФФЕКТНОЕ
Dialogue: 0,0:12:58.23,0:13:02.39,Caption,,0,0,0,,РУКОПОЖАТИЕ, А СОДЕРЖАНИЕ ОКОНЧАТЕЛЬНОГО РЕШЕНИЯ. BLOOMBERG
Dialogue: 0,0:13:02.47,0:13:05.83,Caption,,0,0,0,,ПИШЕТ, ЧТО РАСШИРЕННАЯ РОССИЙСКАЯ ГРУППА ПОКАЗЫВАЕТ
Dialogue: 0,0:13:05.83,0:13:08.63,Caption,,0,0,0,,СЕРЬЁЗНОСТЬ НАМЕРЕНИЙ КРЕМЛЯ. ПОЛЕЗНЕЕ,
Dialogue: 0,0:13:08.72,0:13:12.39,Caption,,0,0,0,,ОДНАКО, ПРОЧИТАТЬ СПИСОК УЧАСТНИКОВ. РЯБКОВ ОТВЕЧАЕТ ЗА
Dialogue: 0,0:13:12.39,0:13:14.31,Caption,,0,0,0,,ОТНОШЕНИЯ С СОЕДИНЁННЫМИ ШТАТАМИ,
Dialogue: 0,0:13:14.52,0:13:17.99,Caption,,0,0,0,,ВООРУЖЕНИЯ И СТРАТЕГИЧЕСКУЮ СТАБИЛЬНОСТЬ. ГАЛУЗИН
Dialogue: 0,0:13:17.99,0:13:21.27,Caption,,0,0,0,,ПРЕДСТАВЛЯЕТ ВЫСОКИЙ УРОВЕНЬ МИД. КОСТЮКОВ СВЯЗАН С
Dialogue: 0,0:13:21.27,0:13:24.95,Caption,,0,0,0,,ВОЕННОЙ РАЗВЕДКОЙ. РЯДОМ ГЕНЕРАЛЬНЫЙ ШТАБ. ЭТО НАБОР
Dialogue: 0,0:13:25.11,0:13:27.99,Caption,,0,0,0,,НЕ ДЛЯ ФОТОГРАФИИ У ПАЛЬМЫ. ЭТИМ ЛЮДЯМ ПРЕДСТОИТ
Dialogue: 0,0:13:27.99,0:13:32.07,Caption,,0,0,0,,СОГЛАСОВЫВАТЬ, ГДЕ БУДУТ СТОЯТЬ СИЛЫ И КАК СТАНУТ ИСПОЛНЯТЬСЯ
Dialogue: 0,0:13:32.07,0:13:35.27,Caption,,0,0,0,,ОГРАНИЧЕНИЯ. КИЕВ ТОЖЕ МОЖЕТ СПОРИТЬ О КУРСЕ СТРАНЫ,
Dialogue: 0,0:13:35.44,0:13:38.71,Caption,,0,0,0,,ПАРАМЕТРАХ АРМИИ И ОТДЕЛЬНЫХ ПУНКТАХ. НО УЧАСТИЕ В
Dialogue: 0,0:13:38.71,0:13:41.67,Caption,,0,0,0,,ОБСУЖДЕНИИ ЕЩЁ НЕ ДАЁТ ПРАВА ОПРЕДЕЛИТЬ ПРЕДЕЛЫ ВСЕЙ
Dialogue: 0,0:13:41.67,0:13:46.28,Caption,,0,0,0,,СДЕЛКИ. ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОПАСАЮТСЯ,
Dialogue: 0,0:13:46.44,0:13:49.00,Caption,,0,0,0,,ЧТО СОЕДИНЁННЫЕ ШТАТЫ ДОГОВОРЯТСЯ С РОССИЕЙ О
Dialogue: 0,0:13:49.00,0:13:52.84,Caption,,0,0,0,,ПРАВИЛАХ, ПО КОТОРЫМ САМОЙ ЕВРОПЕ ПРИДЁТСЯ ЖИТЬ. ГДЕ
Dialogue: 0,0:13:52.84,0:13:56.84,Caption,,0,0,0,,РАЗМЕЩАЮТСЯ ВОЙСКА. КАКИЕ ВООРУЖЕНИЯ РАЗРЕШЕНЫ. КАК
Dialogue: 0,0:13:56.84,0:13:59.88,Caption,,0,0,0,,ДАЛЕКО МОЖЕТ ДВИГАТЬСЯ ИНФРАСТРУКТУРА НАТО. КАКИЕ
Dialogue: 0,0:13:59.88,0:14:02.84,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА БЕРЁТ ВАШИНГТОН. КАКИЕ ГАРАНТИИ
Dialogue: 0,0:14:02.84,0:14:06.36,Caption,,0,0,0,,ПОЛУЧАЕТ МОСКВА. КАКОЕ МЕСТО ОСТАЁТСЯ ЕВРОПЕЙСКИМ
Dialogue: 0,0:14:06.36,0:14:09.24,Caption,,0,0,0,,СТРАНАМ И УКРАИНЕ. ВОТ СОДЕРЖАНИЕ ВОЗМОЖНОГО
Dialogue: 0,0:14:09.24,0:14:13.24,Caption,,0,0,0,,РАЗДЕЛА, А НЕ РИСОВАНИЕ КАРТЫ ЦВЕТНЫМИ КАРАНДАШАМИ. САМАЯ
Dialogue: 0,0:14:13.24,0:14:15.96,Caption,,0,0,0,,ЖЁСТКАЯ ВЕРСИЯ ПРОИСХОДЯЩЕГО ЗВУЧИТ ТАК ОСНОВНЫЕ
Dialogue: 0,0:14:15.96,0:14:17.72,Caption,,0,0,0,,ПРИНЦИПЫ УЖЕ МОГЛИ ОПРЕДЕЛИТЬ,
Dialogue: 0,0:14:17.96,0:14:20.68,Caption,,0,0,0,,А СЕЙЧАС СТОРОНЫ ТОРГУЮТСЯ ЗА КОНКРЕТНОЕ ОФОРМЛЕНИЕ.
Dialogue: 0,0:14:21.08,0:14:24.20,Caption,,0,0,0,,ЭТО НЕ ЗНАЧИТ, ЧТО ГДЕ ТО ЛЕЖИТ ГОТОВЫЙ ПЛАН С ПОДПИСЯМИ
Dialogue: 0,0:14:24.28,0:14:27.56,Caption,,0,0,0,,И ПЕЧАТЯМИ. РЕЧЬ О БАЗОВОЙ РАМКЕ. УКРАИНА ПОСЛЕ
Dialogue: 0,0:14:27.56,0:14:31.08,Caption,,0,0,0,,СОГЛАШЕНИЯ МЕНЯЕТСЯ. ВОПРОС НАТО СНОВА ВЫНОСИТСЯ НА
Dialogue: 0,0:14:31.08,0:14:34.04,Caption,,0,0,0,,УРОВЕНЬ РОССИИ И СОЕДИНЁННЫХ ШТАТОВ. ЕВРОПЕЙСКУЮ
Dialogue: 0,0:14:34.04,0:14:37.08,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ОБСУЖДАЮТ КАК ЕДИНОЕ ЦЕЛОЕ. СТАРЫЙ
Dialogue: 0,0:14:37.08,0:14:40.04,Caption,,0,0,0,,МЕХАНИЗМ СОВЕТА РОССИЯ НАТО ВОЗВРАЩАЮТ В РАЗГОВОР.
Dialogue: 0,0:14:40.36,0:14:43.64,Caption,,0,0,0,,РЯБКОВ СНОВА ПОЛУЧАЕТ РОЛЬ В ПРОЦЕССЕ. ЕСЛИ РАМКА
Dialogue: 0,0:14:43.64,0:14:46.92,Caption,,0,0,0,,ЗАДАНА, ПЕРЕГОВОРЫ ПРЕВРАЩАЮТСЯ В РАБОТУ НАД ТЕРРИТОРИЯМИ,
Dialogue: 0,0:14:47.08,0:14:52.36,Caption,,0,0,0,,ОГРАНИЧЕНИЯМИ, ГАРАНТИЯМИ, КОНТРОЛЕМ И СРОКАМИ. ТОГДА СТРАХ НОВОЙ ЯЛТЫ
Dialogue: 0,0:14:52.49,0:14:55.48,Caption,,0,0,0,,ПЕРЕСТАЁТ ВЫГЛЯДЕТЬ ИСТЕРИКОЙ. КИЕВ ПОНИМАЕТ,
Dialogue: 0,0:14:55.64,0:14:58.44,Caption,,0,0,0,,ЧТО ПРЕДМЕТ СДЕЛКИ ШИРЕ ЕГО СОБСТВЕННЫХ РЕШЕНИЙ.
Dialogue: 0,0:15:00.72,0:15:04.00,Caption,,0,0,0,,ЕВРОПА ВИДИТ, ЧТО ВАШИНГТОН СПОСОБЕН ОБСУЖДАТЬ УСТРОЙСТВО
Dialogue: 0,0:15:04.00,0:15:07.60,Caption,,0,0,0,,КОНТИНЕНТА НАПРЯМУЮ С МОСКВОЙ. ФРАНЦИЯ СПЕШИТ В АБУ
Dialogue: 0,0:15:07.60,0:15:11.28,Caption,,0,0,0,,ДАБИ. МЕЛОНИ ПРИЗНАЁТ ОТСУТСТВИЕ ЕДИНСТВА. КАЛЛАС
Dialogue: 0,0:15:11.28,0:15:14.48,Caption,,0,0,0,,НАПОМИНАЕТ О СУЩЕСТВУЮЩИХ ИНСТИТУТАХ. КАЖДЫЙ
Dialogue: 0,0:15:14.56,0:15:16.72,Caption,,0,0,0,,СТАРАЕТСЯ ПОПАСТЬ В КОМНАТУ ДО ТОГО,
Dialogue: 0,0:15:16.85,0:15:19.28,Caption,,0,0,0,,КАК ВЫНЕСУТ МЕБЕЛЬ. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:15:19.49,0:15:24.08,Caption,,0,0,0,,ЧТО, ПО ВАШЕМУ МНЕНИЮ, ТРАМП ВЛОЖИЛ В СЛОВА О ДРУГОЙ ФОРМЕ ТОЛЬКО
Dialogue: 0,0:15:24.08,0:15:27.68,Caption,,0,0,0,,НОВЫЕ ГРАНИЦЫ ИЛИ ЕЩЁ НОВЫЙ ВОЕННЫЙ СТАТУС УКРАИНЫ?
Dialogue: 0,0:15:28.39,0:15:31.92,Caption,,0,0,0,,РАЗНИЦА КОЛОССАЛЬНАЯ, ХОТЯ В ЕГО ФРАЗЕ ОНА УМЕСТИЛАСЬ В ОДНО
Dialogue: 0,0:15:31.92,0:15:34.64,Caption,,0,0,0,,СЛОВО. ОСОБЕННО ГОРЬКО ВЫГЛЯДИТ ПУТЬ,
Dialogue: 0,0:15:34.96,0:15:37.44,Caption,,0,0,0,,ПО КОТОРОМУ СТОРОНЫ ВЕРНУЛИСЬ К СТАРЫМ ВОПРОСАМ.
Dialogue: 0,0:15:37.67,0:15:39.84,Caption,,0,0,0,,ЧЕТЫРЕ С ЛИШНИМ ГОДА ОГРОМНОЙ БОЙНИ,
Dialogue: 0,0:15:40.08,0:15:43.04,Caption,,0,0,0,,РАЗРУШЕНИЙ И ПОЛНОСТЬЮ ИЗМЕНИВШИХСЯ ОТНОШЕНИЙ
Dialogue: 0,0:15:43.04,0:15:46.88,Caption,,0,0,0,,ПРИВЕЛИ ИХ К СПОРУ, ЛЕЖАВШЕМУ НА СТОЛЕ В КОНЦЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:15:46.88,0:15:50.48,Caption,,0,0,0,,ПЕРВОГО ГОДА. ПОДПИШИСЬ, ЕСЛИ ХОЧЕШЬ ВИДЕТЬ РАЗБОР ЦЕЛИКОМ,
Dialogue: 0,0:15:50.80,0:15:53.12,Caption,,0,0,0,,А НЕ В ПЕРЕСКАЗЕ ПРЕСС СЛУЖБЫ. ТОЛЬКО ТЕПЕРЬ
Dialogue: 0,0:15:53.20,0:15:56.32,Caption,,0,0,0,,ИСХОДНЫЕ УСЛОВИЯ ИСЧЕЗЛИ. ТЕРРИТОРИИ И СООТНОШЕНИЕ
Dialogue: 0,0:15:56.32,0:16:00.00,Caption,,0,0,0,,СИЛ ИЗМЕНИЛИСЬ. РОССИЯ И ЕВРОПА ЖИВУТ В ДРУГОЙ
Dialogue: 0,0:16:00.00,0:16:03.28,Caption,,0,0,0,,РЕАЛЬНОСТИ. ОТНОШЕНИЯ ЕВРОПЫ С СОЕДИНЁННЫМИ ШТАТАМИ
Dialogue: 0,0:16:03.28,0:16:06.48,Caption,,0,0,0,,ТОЖЕ СТАЛИ ДРУГИМИ. ДАЖЕ ПРЕЖНЕЕ ЕВРОПЕЙСКОЕ
Dialogue: 0,0:16:06.48,0:16:10.48,Caption,,0,0,0,,ЕДИНСТВО ОКАЗАЛОСЬ ВЕЩЬЮ, КОТОРУЮ УДОБНО ПОКАЗЫВАТЬ НА САММИТЕ,
Dialogue: 0,0:16:10.71,0:16:12.88,Caption,,0,0,0,,НО ТРУДНО ОБНАРУЖИТЬ ЗА ЗАКРЫТЫМИ ДВЕРЯМИ.
Dialogue: 0,0:16:13.54,0:16:16.56,Caption,,0,0,0,,ЦЕНА ОТКАЗА ОТ РАЗГОВОРА ВЫРОСЛА ЧУДОВИЩНО.
Dialogue: 0,0:16:18.74,0:16:21.70,Caption,,0,0,0,,И ТОТ ЖЕ РЯБКОВ ВОЗВРАЩАЕТСЯ ОБСУЖДАТЬ ВОПРОСЫ,
Dialogue: 0,0:16:22.02,0:16:24.34,Caption,,0,0,0,,ЗА КОТОРЫЕ ПЯТЬ ЛЕТ НАЗАД НИКТО НЕ ЗАХОТЕЛ
Dialogue: 0,0:16:24.42,0:16:28.74,Caption,,0,0,0,,БРАТЬСЯ ВСЕРЬЁЗ. ДЕВЯНОСТО СЕДЬМОЙ ГОД ВАЖЕН НЕ КАК МУЗЕЙНАЯ ДАТА.
Dialogue: 0,0:16:29.14,0:16:32.74,Caption,,0,0,0,,ЭТО СТАРАЯ ТОЧКА РАВНОВЕСИЯ, НА КОТОРУЮ МОСКВА ССЫЛАЕТСЯ,
Dialogue: 0,0:16:32.98,0:16:35.06,Caption,,0,0,0,,ГОВОРЯ О ВОЕННОЙ ИНФРАСТРУКТУРЕ НАТО.
Dialogue: 0,0:16:35.30,0:16:37.54,Caption,,0,0,0,,ОСНОВОПОЛАГАЮЩИЙ АКТ НЕ ЗАКРЫЛ СПОР,
Dialogue: 0,0:16:37.78,0:16:39.78,Caption,,0,0,0,,СОВЕТ РОССИЯ НАТО ЕГО НЕ РЕШИЛ,
Dialogue: 0,0:16:39.94,0:16:42.02,Caption,,0,0,0,,ПРЕДЛОЖЕНИЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА
Dialogue: 0,0:16:42.02,0:16:45.30,Caption,,0,0,0,,ОТВЕРГЛИ, А ВОПРОС НИКУДА НЕ ДЕЛСЯ. РОССИЙСКИЕ ТРЕБОВАНИЯ
Dialogue: 0,0:16:45.30,0:16:47.70,Caption,,0,0,0,,ИГНОРИРОВАЛИ, ОБЪЯВЛЯЛИ НЕПРИЕМЛЕМЫМИ,
Dialogue: 0,0:16:47.86,0:16:49.54,Caption,,0,0,0,,МЕХАНИЗМ КОНСУЛЬТАЦИЙ ЗАКРЫЛИ.
Dialogue: 0,0:16:50.12,0:16:52.82,Caption,,0,0,0,,НО ЧЕРЕЗ ПЯТЬ ЛЕТ ЗА СТОЛ СНОВА ПРИШЛОСЬ
Dialogue: 0,0:16:52.82,0:16:56.82,Caption,,0,0,0,,ПОСАДИТЬ ЧЕЛОВЕКА, КОТОРЫЙ ЭТИ ТРЕБОВАНИЯ ФОРМУЛИРОВАЛ. ИСТОРИЯ ИНОГДА
Dialogue: 0,0:16:56.82,0:17:01.78,Caption,,0,0,0,,ВОЗВРАЩАЕТСЯ НЕ КРУГОМ, А СЧЁТОМ. И СУММА ВНИЗУ ОКАЗЫВАЕТСЯ НАМНОГО БОЛЬШЕ
Dialogue: 0,0:17:01.78,0:17:05.06,Caption,,0,0,0,,ТОЙ, КОТОРУЮ ОТКАЗЫВАЛИСЬ ПЛАТИТЬ СНАЧАЛА. ТЕПЕРЬ У
Dialogue: 0,0:17:05.14,0:17:08.18,Caption,,0,0,0,,СТОРОН ИЗМЕНИВШАЯСЯ КАРТА, УНИЧТОЖЕННЫЕ ОТНОШЕНИЯ,
Dialogue: 0,0:17:08.42,0:17:10.90,Caption,,0,0,0,,ОГРОМНАЯ ЦЕНА ВОЙНЫ И ВСЁ ТОТ ЖЕ СПОР
Dialogue: 0,0:17:10.90,0:17:15.30,Caption,,0,0,0,,О НАТО, ВООРУЖЕНИЯХ И ГРАНИЦАХ ДОПУСТИМОГО. МИРНЫЕ ЗАЯВЛЕНИЯ
Dialogue: 0,0:17:15.30,0:17:20.26,Caption,,0,0,0,,СЕЙЧАС ЗНАЧАТ МЕНЬШЕ, ЧЕМ СОСТАВ ДЕЛЕГАЦИЙ. СЛОВО "МИР" ЛЕГКО ПОСТАВИТЬ В
Dialogue: 0,0:17:20.26,0:17:23.46,Caption,,0,0,0,,НАЧАЛО РЕЧИ, В КОНЕЦ РЕЧИ И ЕЩЁ КРУПНО НАПИСАТЬ НА
Dialogue: 0,0:17:23.46,0:17:25.78,Caption,,0,0,0,,СТЕНЕ. НАМНОГО ТРУДНЕЕ ДОГОВОРИТЬСЯ,
Dialogue: 0,0:17:25.99,0:17:28.98,Caption,,0,0,0,,КАКИЕ ВОЙСКА ОСТАНУТСЯ, ГДЕ ПРОЙДЁТ ЛИНИЯ,
Dialogue: 0,0:17:29.14,0:17:31.38,Caption,,0,0,0,,ЧТО БУДЕТ С НАТО И КТО ПОЛУЧИТ ПРАВО
Dialogue: 0,0:17:31.38,0:17:33.14,Caption,,0,0,0,,КОНТРОЛИРОВАТЬ ВЫПОЛНЕНИЕ УСЛОВИЙ.
Dialogue: 0,0:17:35.41,0:17:38.46,Caption,,0,0,0,,ПОДПИШИСЬ, ЕСЛИ ТЕБЕ ИНТЕРЕСНЕЕ РАЗБОР ПО СУЩЕСТВУ,
Dialogue: 0,0:17:38.65,0:17:43.10,Caption,,0,0,0,,ЧЕМ КРАСИВЫЕ СЛОВА ПРО МИР. РЯБКОВ В СПИСКЕ ОЗНАЧАЕТ ВОЗВРАЩЕНИЕ К
Dialogue: 0,0:17:43.10,0:17:46.30,Caption,,0,0,0,,СТРАТЕГИЧЕСКОМУ СПОРУ. СОВЕТ РОССИЯ НАТО ОЗНАЧАЕТ
Dialogue: 0,0:17:46.30,0:17:48.86,Caption,,0,0,0,,ПОИСК СТАРОГО КАНАЛА ДЛЯ НОВОГО РАЗГОВОРА.
Dialogue: 0,0:17:49.25,0:17:50.94,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ТРЕВОГА ПОКАЗЫВАЕТ,
Dialogue: 0,0:17:51.09,0:17:53.97,Caption,,0,0,0,,ЧТО НА КОНУ УСТРОЙСТВО ВСЕГО КОНТИНЕНТА. УКРАИНСКИЙ
Dialogue: 0,0:17:53.97,0:17:57.18,Caption,,0,0,0,,СТРАХ НОВОЙ ЯЛТЫ ВЫДАЁТ СОМНЕНИЕ КИЕВА В СВОЁМ
Dialogue: 0,0:17:57.18,0:18:00.14,Caption,,0,0,0,,ПРАВЕ ОПРЕДЕЛЯТЬ ИТОГОВУЮ РАМКУ. А СЛОВА ТРАМПА
Dialogue: 0,0:18:00.21,0:18:02.94,Caption,,0,0,0,,СВЯЗЫВАЮТ РЕЗУЛЬТАТ С ИЗМЕНЕНИЕМ САМОЙ УКРАИНЫ.
Dialogue: 0,0:18:03.40,0:18:05.18,Caption,,0,0,0,,КАКОЙ ОНА ВЫЙДЕТ ИЗ СОГЛАШЕНИЯ,
Dialogue: 0,0:18:05.30,0:18:10.14,Caption,,0,0,0,,ПОКА НЕ ОБЪЯСНЕНО. НОВЫЕ ГРАНИЦЫ СПОСОБНЫ ОСТАВИТЬ КИЕВУ ПРЕЖНИЙ КУРС,
Dialogue: 0,0:18:10.30,0:18:13.02,Caption,,0,0,0,,НО ИЗМЕНИТЬ ТЕРРИТОРИЮ. СОХРАНЕНИЕ ГОСУДАРСТВЕННОСТИ
Dialogue: 0,0:18:13.02,0:18:16.06,Caption,,0,0,0,,МОЖЕТ СОПРОВОЖДАТЬСЯ ОГРАНИЧЕНИЯМИ ДЛЯ АРМИИ И
Dialogue: 0,0:18:16.06,0:18:19.34,Caption,,0,0,0,,ИНОСТРАННОЙ ИНФРАСТРУКТУРЫ. ОТКАЗ ОТ ДВИЖЕНИЯ В НАТО
Dialogue: 0,0:18:19.57,0:18:22.62,Caption,,0,0,0,,ПЕРЕСТРОИТ ВСЮ СИСТЕМУ БЕЗОПАСНОСТИ СТРАНЫ. А
Dialogue: 0,0:18:22.62,0:18:25.66,Caption,,0,0,0,,СОЧЕТАНИЕ ЭТИХ УСЛОВИЙ ОСТАВИТ ПРЕЖНЕЕ НАЗВАНИЕ,
Dialogue: 0,0:18:25.89,0:18:28.70,Caption,,0,0,0,,НО СОЗДАСТ УЖЕ ДРУГОЕ ГОСУДАРСТВЕННОЕ УСТРОЙСТВО.
Dialogue: 0,0:18:29.31,0:18:32.46,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ФОРМУЛИРОВКА ТРАМПА НЕ ОТПУСКАЕТ. ОНА
Dialogue: 0,0:18:32.46,0:18:35.58,Caption,,0,0,0,,СЛИШКОМ ШИРОКАЯ ДЛЯ СЛУЧАЙНОЙ ОГОВОРКИ И СЛИШКОМ
Dialogue: 0,0:18:35.61,0:18:38.14,Caption,,0,0,0,,АККУРАТНАЯ ДЛЯ ПРЯМОГО ОБЪЯВЛЕНИЯ РЕЗУЛЬТАТА.
Dialogue: 0,0:18:38.77,0:18:40.70,Caption,,0,0,0,,КОГДА СОГЛАШЕНИЕ ПОЯВИТСЯ НА СТОЛЕ,
Dialogue: 0,0:18:41.01,0:18:43.34,Caption,,0,0,0,,ВСЕ МОГУТ ВСПОМНИТЬ ЭТУ ФРАЗУ И УВИДЕТЬ,
Dialogue: 0,0:18:43.56,0:18:46.30,Caption,,0,0,0,,ЧТО ПРЕЗИДЕНТ СОЕДИНЁННЫХ ШТАТОВ РАССКАЗАЛ ГЛАВНОЕ
Dialogue: 0,0:18:46.30,0:18:50.41,Caption,,0,0,0,,ЗАРАНЕЕ. ПРОСТО СКАЗАЛ ЭТО ТАК,
Dialogue: 0,0:18:50.53,0:18:52.81,Caption,,0,0,0,,БУДТО СОБИРАЛСЯ СЛЕГКА ПЕРЕДВИНУТЬ ГРАНИЦУ НА
Dialogue: 0,0:18:52.81,0:18:58.65,Caption,,0,0,0,,ЧЕРТЕЖЕ. ТОГДА И ВЫЯСНИТСЯ, ЧТО ОЗНАЧАЛО СЛОВО "ФОРМА". НОВАЯ ЛИНИЯ НА КАРТЕ.
Dialogue: 0,0:18:59.10,0:19:02.89,Caption,,0,0,0,,НОВЫЙ ВОЕННЫЙ СТАТУС. НОВЫЙ КУРС. ИЛИ УКРАИНА,
Dialogue: 0,0:19:03.14,0:19:04.97,Caption,,0,0,0,,КОТОРУЮ РЕШИЛИ ПЕРЕКРОИТЬ ЦЕЛИКОМ,
Dialogue: 0,0:19:05.29,0:19:07.37,Caption,,0,0,0,,НО ПОКА НАЗЫВАЮТ ЭТО НЕБОЛЬШОЙ ПОПРАВКОЙ,
Dialogue: 0,0:19:07.61,0:19:09.61,Caption,,0,0,0,,ЧТОБЫ НИКТО РАНЬШЕ ВРЕМЕНИ НЕ СПРОСИЛ,
Dialogue: 0,0:19:09.77,0:19:11.45,Caption,,0,0,0,,ГДЕ ЛЕЖАТ ОТРЕЗАННЫЕ КУСКИ.
